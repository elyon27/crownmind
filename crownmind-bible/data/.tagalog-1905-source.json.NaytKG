            {
              "chapter": 49,
              "verse": 19,
              "name": "Genesis 49:19",
              "text": "Si Gad, ay hahabulin ng isang pulutong: Nguni't siya ang hahabol sa kanila."
            },
            {
              "chapter": 49,
              "verse": 20,
              "name": "Genesis 49:20",
              "text": "Hinggil kay Aser, ay lulusog ang tinapay niya, At gagawa ng masasarap na pagkain."
            },
            {
              "chapter": 49,
              "verse": 21,
              "name": "Genesis 49:21",
              "text": "Si Nephtali ay isang usang babaing kawala: Siya'y nagbabadya ng maririkit na pananalita."
            },
            {
              "chapter": 49,
              "verse": 22,
              "name": "Genesis 49:22",
              "text": "Si Jose ay sangang mabunga, Sangang mabunga na nasa tabi ng bukal; Ang kaniyang mga sanga'y gumagapang sa pader."
            },
            {
              "chapter": 49,
              "verse": 23,
              "name": "Genesis 49:23",
              "text": "Pinamanglaw siya ng mga mamamana, At pinana siya, at inusig siya:"
            },
            {
              "chapter": 49,
              "verse": 24,
              "name": "Genesis 49:24",
              "text": "Nguni't ang kaniyang busog ay nanahan sa kalakasan, At pinalakas ang mga bisig ng kaniyang mga kamay, Sa pamamagitan ng mga kamay ng Makapangyarihan ni Jacob, (Na siyang pinagmulan ng pastor, ang bato ng Israel),"
            },
            {
              "chapter": 49,
              "verse": 25,
              "name": "Genesis 49:25",
              "text": "Sa pamamagitan nga ng Dios ng iyong ama, na siyang tutulong sa iyo, At sa pamamagitan ng Makapangyarihan sa lahat, na siyang magpapala sa iyo, Ng pagpapala ng langit sa itaas, Pagpapala ng mga kalaliman na nalalagay sa ibaba, Pagpapala ng mga dibdib at ng bahay-bata."
            },
            {
              "chapter": 49,
              "verse": 26,
              "name": "Genesis 49:26",
              "text": "Ang mga basbas ng iyong ama na humigit sa basbas ng aking mga kanunuan Hanggang sa wakas ng mga burol na walang hanggan: Mangapapasa ulo ni Jose, At sa tuktok ng ulo niya na bukod tangi sa kaniyang mga kapatid."
            },
            {
              "chapter": 49,
              "verse": 27,
              "name": "Genesis 49:27",
              "text": "Si Benjamin ay isang lobo na mangaagaw: Sa kinaumagaha'y kaniyang kakanin ang huli, At sa kinahapunan ay kaniyang babahagihin ang samsam."
            },
            {
              "chapter": 49,
              "verse": 28,
              "name": "Genesis 49:28",
              "text": "Ang lahat ng ito ang labing dalawang angkan ng Israel: at ito ang sinalita ng ama nila sa kanila, at sila'y binasbasan; bawa't isa'y binasbasan ng ayon sa basbas sa kanikaniya,"
            },
            {
              "chapter": 49,
              "verse": 29,
              "name": "Genesis 49:29",
              "text": "At kaniyang ipinagbilin sa kanila, at sinabi sa kanila: Ako'y malalakip sa aking bayan: ilibing ninyo ako sa kasamahan ng aking mga magulang sa yungib na nasa parang ni Ephron na Hetheo,"
            },
            {
              "chapter": 49,
              "verse": 30,
              "name": "Genesis 49:30",
              "text": "Sa yungib na nasa parang ng Machpela, na nasa tapat ng Mamre, sa lupain ng Canaan, na binili ni Abraham, na kalakip ng parang kay Ephron na Hetheo, na pinakaaring libingan:"
            },
            {
              "chapter": 49,
              "verse": 31,
              "name": "Genesis 49:31",
              "text": "Na doon nila inilibing si Abraham at si Sara na kaniyang asawa; na doon nila inilibing si Isaac at si Rebeca na kaniyang asawa; at doon ko inilibing si Lea:"
            },
            {
              "chapter": 49,
              "verse": 32,
              "name": "Genesis 49:32",
              "text": "Sa parang at sa yungib na nandoon na binili sa mga anak ni Heth."
            },
            {
              "chapter": 49,
              "verse": 33,
              "name": "Genesis 49:33",
              "text": "At nang matapos si Jacob na makapagbilin sa kaniyang mga anak, ay kaniyang itinaas at itinikom ang kaniyang mga paa sa higaan, at nalagot ang hininga, at nalakip sa kaniyang bayan."
            }
          ]
        },
        {
          "chapter": 50,
          "name": "Genesis 50",
          "verses": [
            {
              "chapter": 50,
              "verse": 1,
              "name": "Genesis 50:1",
              "text": "At yumakap si Jose sa mukha ng kaniyang ama, at umiyak sa ibabaw niya, at hinalikan niya siya."
            },
            {
              "chapter": 50,
              "verse": 2,
              "name": "Genesis 50:2",
              "text": "At iniutos ni Jose sa kaniyang mga lingkod na manggagamot, na embalsamahin ang kaniyang ama: at inembalsama ng mga manggagamot si Israel."
            },
            {
              "chapter": 50,
              "verse": 3,
              "name": "Genesis 50:3",
              "text": "At apat na pung araw ang ginanap sa kaniya; sapagka't gayon ginaganap ang mga araw ng pagembalsama; at tinangisan siya ng mga Egipcio ng pitong pung araw."
            },
            {
              "chapter": 50,
              "verse": 4,
              "name": "Genesis 50:4",
              "text": "At nang makaraan ang mga araw ng pagiyak sa kaniya ay nagsalita si Jose sa sangbahayan ni Faraon, na sinasabi, Kung ngayo'y nakasumpong ako ng biyaya sa inyong mga mata ay salitain ninyo, isinasamo ko sa inyo, sa mga pakinig ni Faraon, na inyong sabihin,"
            },
            {
              "chapter": 50,
              "verse": 5,
              "name": "Genesis 50:5",
              "text": "Pinanumpa ako ng ama ko, na sinasabi, Narito, ako'y namamatay: sa libingan na aking hinukay sa akin sa lupain ng Canaan, ay doon mo ako ililibing. Ngayon nga'y pahintulutan ninyo akong umahon, isinasamo ko sa inyo, at aking ilibing ang aking ama, at babalik uli ako."
            },
            {
              "chapter": 50,
              "verse": 6,
              "name": "Genesis 50:6",
              "text": "At sinabi ni Faraon, Umahon ka, at ilibing mo ang iyong ama, ayon sa kaniyang ipinasumpa sa iyo."
            },
            {
              "chapter": 50,
              "verse": 7,
              "name": "Genesis 50:7",
              "text": "At umahon si Jose upang ilibing ang kaniyang ama: at kasama niyang umahon ang lahat ng lingkod ni Faraon, ang mga matanda sa kaniyang sangbahayan, at ang lahat na matanda sa lupain ng Egipto;"
            },
            {
              "chapter": 50,
              "verse": 8,
              "name": "Genesis 50:8",
              "text": "At ang buong sangbahayan ni Jose, at ang kaniyang mga kapatid, at ang sangbahayan ng kaniyang ama: ang kanila lamang mga bata, at ang kanilang mga kawan, at ang kanilang bakahan, ang iniwan nila sa lupain ng Gosen."
            },
            {
              "chapter": 50,
              "verse": 9,
              "name": "Genesis 50:9",
              "text": "At umahong kasama niya ang mga karro at mga nangangabayo: at yao'y naging totoong malaking pulutong."
            },
            {
              "chapter": 50,
              "verse": 10,
              "name": "Genesis 50:10",
              "text": "At sila'y dumating sa giikan ni Atad, na nasa dako pa roon ng Jordan, at doo'y nanaghoy sila ng malakas at kapaitpait na panaghoy: at kaniyang pinanangisan ang kaniyang ama na pitong araw."
            },
            {
              "chapter": 50,
              "verse": 11,
              "name": "Genesis 50:11",
              "text": "At nang makita ng mga nananahan sa lupaing yaon, ng mga Cananeo, ang panaghoy sa giikan ni Atad, ay kanilang sinabi, Ito'y isang kahambalhambal na panaghoy ng mga Egipcio kaya't ang pangalang itinawag ay Abel-mizraim, nasa dako pa roon ng Jordan."
            },
            {
              "chapter": 50,
              "verse": 12,
              "name": "Genesis 50:12",
              "text": "At ginawa sa kaniya ng kaniyang mga anak ang ayon sa iniutos sa kanila."
            },
