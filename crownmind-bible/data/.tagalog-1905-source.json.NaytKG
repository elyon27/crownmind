            {
              "chapter": 34,
              "verse": 19,
              "name": "Genesis 34:19",
              "text": "At hindi iniliban ng binata ang paggawa niyaon, sapagka't nalugod siya sa anak na babae ni Jacob: at siya ang pinarangalang higit sa buong sangbahayan ng kaniyang ama."
            },
            {
              "chapter": 34,
              "verse": 20,
              "name": "Genesis 34:20",
              "text": "At si Hamor at si Sichem na kaniyang anak ay napasa pintuang-bayan ng kanilang bayan, at sila'y nakiusap sa mga tao sa kanilang bayan, na sinasabi."
