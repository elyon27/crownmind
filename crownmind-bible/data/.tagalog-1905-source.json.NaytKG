            },
            {
              "chapter": 8,
              "verse": 28,
              "name": "1 Mga Cronica 8:28",
              "text": "Ang mga ito ang mga pangulo sa mga sangbahayan ng mga magulang ayon sa kanilang lahi, na mga pinunong lalake: ang mga ito'y nagsitahan sa Jerusalem."
            },
            {
              "chapter": 8,
              "verse": 29,
              "name": "1 Mga Cronica 8:29",
              "text": "At sa Gabaon ay tumahan ang ama ni Gabaon, si Jeiel, na ang pangalan ng asawa ay Maacha:"
            },
            {
              "chapter": 8,
              "verse": 30,
              "name": "1 Mga Cronica 8:30",
              "text": "At ang kaniyang anak na panganay si Abdon, at si Sur, at si Cis, at si Baal, at si Nadab;"
            },
            {
              "chapter": 8,
              "verse": 31,
              "name": "1 Mga Cronica 8:31",
              "text": "At si Gedor, at si Ahio, at si Zecher."
            },
            {
              "chapter": 8,
              "verse": 32,
              "name": "1 Mga Cronica 8:32",
              "text": "At naging anak ni Micloth si Simea. At sila nama'y nagsitahang kasama ng kanilang mga kapatid sa Jerusalem, sa tapat ng kanilang mga kapatid."
            },
            {
              "chapter": 8,
              "verse": 33,
              "name": "1 Mga Cronica 8:33",
              "text": "At naging anak ni Ner si Cis; at naging anak ni Cis si Saul; at naging anak ni Saul si Jonathan, at si Malchi-sua, at si Abinadab, at si Esbaal."
            },
            {
              "chapter": 8,
              "verse": 34,
              "name": "1 Mga Cronica 8:34",
              "text": "At ang anak ni Jonathan ay si Merib-baal; at naging anak ni Merib-baal si Micha."
