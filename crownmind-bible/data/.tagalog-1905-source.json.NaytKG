            {
              "chapter": 47,
              "verse": 31,
              "name": "Genesis 47:31",
              "text": "At kaniyang sinabi, Sumumpa ka sa akin: at sumumpa siya sa kaniya. At yumukod si Israel sa ulunan ng higaan."
