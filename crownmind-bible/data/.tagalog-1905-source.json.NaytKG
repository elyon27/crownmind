            {
              "chapter": 8,
              "verse": 14,
              "name": "1 Samuel 8:14",
              "text": "At kaniyang kukunin ang inyong mga bukid, at ang inyong mga ubasan, at ang inyong mga olibohan, sa makatuwid baga'y ang pinakamabuti sa mga yaon, upang mga ibigay sa kaniyang mga lingkod."
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "1 Samuel 8:15",
              "text": "At kaniyang kukunin ang ika-sangpung bahagi ng inyong binhi, at ng inyong mga ubasan, at ibibigay sa kaniyang mga punong kawal, at sa kaniyang mga lingkod."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "1 Samuel 8:16",
              "text": "At kaniyang kukunin ang inyong mga aliping lalake at babae, at ang inyong pinakamabuting bataan, at ang inyong mga asno, at mga ilalagay sa kaniyang mga gawain."
            },
            {
