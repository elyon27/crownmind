            {
              "chapter": 19,
              "verse": 18,
              "name": "1 Samuel 19:18",
              "text": "Si David nga ay tumakas, at tumanan, at naparoon kay Samuel sa Rama, at isinaysay sa kaniya ang lahat ng ginawa ni Saul sa kaniya. At siya at si Samuel ay yumaon at tumahan sa Najoth."
            },
            {
              "chapter": 19,
              "verse": 19,
              "name": "1 Samuel 19:19",
              "text": "At nasaysay kay Saul na sinasabi, Narito si David ay nasa Najoth sa Rama."
