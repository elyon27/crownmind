            {
              "chapter": 1,
              "verse": 47,
              "name": "Mga Bilang 1:47",
              "text": "Datapuwa't ang mga Levita ayon sa lipi ng kanilang mga magulang ay hindi ibinilang sa kanila."
            },
            {
              "chapter": 1,
              "verse": 48,
              "name": "Mga Bilang 1:48",
              "text": "Sapagka't sinalita ng Panginoon kay Moises, na sinasabi,"
