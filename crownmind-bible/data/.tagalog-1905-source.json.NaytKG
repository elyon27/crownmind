            {
              "chapter": 34,
              "verse": 11,
              "name": "Genesis 34:11",
              "text": "At sinabi ni Sichem sa ama ni Dina, at sa mga kapatid niya, Makasundo nawa ako ng biyaya sa inyong mga mata at ang sabihin ninyo sa akin ay aking ibibigay."
            },
            {
              "chapter": 34,
              "verse": 12,
              "name": "Genesis 34:12",
              "text": "Hingin ninyo sa akin ang walang bilang na bigay-kaya at kaloob, at aking ibibigay ayon sa sabihin ninyo sa akin; ipagkaloob lamang ninyo sa akin ang dalaga na maging asawa ko."
            },
            {
              "chapter": 34,
              "verse": 13,
              "name": "Genesis 34:13",
              "text": "At nagsisagot na may pagdaraya ang mga anak ni Jacob kay Sichem at kay Hamor na kaniyang ama, at sila'y nagsalitaan, sapagka't kaniyang dinahas si Dina na kanilang kapatid."
            },
            {
              "chapter": 34,
              "verse": 14,
              "name": "Genesis 34:14",
              "text": "At sinabi niya sa kanila, Hindi namin magagawa ito, na ibigay ang aming kapatid sa isang hindi tuli; sapagka't isang kasiraan ng puri namin."
            },
            {
              "chapter": 34,
              "verse": 15,
              "name": "Genesis 34:15",
              "text": "Sa ganitong paraan lamang papayag kami sa inyo: kung kayo'y magiging gaya namin, na mangatuli ang lahat ng lalake sa inyo;"
            },
            {
              "chapter": 34,
              "verse": 16,
              "name": "Genesis 34:16",
              "text": "Ay ibibigay nga namin sa inyo ang aming mga anak na babae, at makikisama kami sa inyong mga anak na babae, at tatahan kami sa inyo, at tayo'y magiging isa lamang bayan."
