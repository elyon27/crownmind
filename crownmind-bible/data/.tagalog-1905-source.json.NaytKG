            {
              "chapter": 27,
              "verse": 34,
              "name": "Genesis 27:34",
              "text": "Nang marinig ni Esau ang mga salita ng kaniyang ama ay humiyaw ng malakas at ng di kawasang kapanglawan: at sinabi sa kaniyang ama. Basbasan mo ako, ako naman, Oh ama ko."
            },
