            },
            {
              "chapter": 20,
              "verse": 42,
              "name": "1 Mga Hari 20:42",
              "text": "At sinabi niya sa kaniya, Ganito ang sabi ng Panginoon, Sapagka't iyong pinabayaang makatanan sa iyong kamay ang lalake na aking itinalaga sa kamatayan, ang iyo ngang buhay ay papanaw na kapalit ng kaniyang buhay, at ang iyong bayan ng kaniyang bayan."
            },
            {
              "chapter": 20,
              "verse": 43,
