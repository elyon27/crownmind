            {
              "chapter": 31,
              "verse": 39,
              "name": "Genesis 31:39",
              "text": "Ang nilapa ng mga ganid ay hindi ko dinala sa iyo; ako ang nagbata ng kawalan; sa aking kamay mo hiningi, maging nanakaw sa araw, o nanakaw sa gabi."
