            {
              "chapter": 36,
              "verse": 23,
              "name": "Genesis 36:23",
              "text": "At ito ang mga anak ni Sobal; si Alvan, at si Manahath, at si Ebal, si Zepho, at si Onam."
            },
            {
              "chapter": 36,
              "verse": 24,
              "name": "Genesis 36:24",
              "text": "At ito ang mga anak ni Zibeon; si Aja at si Ana: ito rin ang si Ana na nakasumpong ng maiinit na bukal sa ilang, nang pinapanginginain ang mga asno ni Zibeon na kaniyang ama."
            },
            {
              "chapter": 36,
              "verse": 25,
              "name": "Genesis 36:25",
              "text": "At ito ang mga anak ni Ana; si Dison at si Aholibama, na anak na babae ni Ana."
            },
            {
              "chapter": 36,
              "verse": 26,
              "name": "Genesis 36:26",
              "text": "At ito ang mga anak ni Dizon: si Hemdan, at si Eshban, at si Ithram, at si Cheran."
            },
            {
              "chapter": 36,
              "verse": 27,
              "name": "Genesis 36:27",
              "text": "Ito ang mga anak ni Ezer: si Bilhan, at si Zaavan at si Acan."
            },
            {
              "chapter": 36,
              "verse": 28,
              "name": "Genesis 36:28",
              "text": "Ito ang mga anak ni Disan: si Huz at si Aran."
            },
            {
              "chapter": 36,
              "verse": 29,
              "name": "Genesis 36:29",
              "text": "Ito ang mga pangulong nagmula sa mga Horeo; ang pangulong Lotan, ang pangulong Sobal, ang pangulong Zibeon, ang pangulong Ana,"
            },
            {
              "chapter": 36,
              "verse": 30,
              "name": "Genesis 36:30",
              "text": "Ang pangulong Dison, ang pangulong Ezer, ang pangulong Disan: ito ang mga pangulong nagmula sa mga Horeo ayon sa kanilang mga pangulo, sa lupain ng Seir."
            },
            {
              "chapter": 36,
              "verse": 31,
              "name": "Genesis 36:31",
              "text": "At ito ang mga hari na nagsipaghari sa lupain ng Edom bago maghari ang sinomang hari sa angkan ni Israel."
            },
            {
              "chapter": 36,
              "verse": 32,
              "name": "Genesis 36:32",
              "text": "At si Bela na anak ni Beor ay naghari sa Edom; at ang pangalan ng kaniyang bayan ay Dinaba."
            },
            {
              "chapter": 36,
              "verse": 33,
              "name": "Genesis 36:33",
              "text": "At namatay si Bela, at naghari na kahalili niya si Jobab na anak ni Zera, na taga Bozra."
            },
            {
              "chapter": 36,
              "verse": 34,
              "name": "Genesis 36:34",
              "text": "At namatay si Jobab at naghari na kahalili niya si Husam, na taga lupain ng mga Temaneo."
            },
            {
              "chapter": 36,
              "verse": 35,
              "name": "Genesis 36:35",
              "text": "At namatay si Husam, at naghari na kahalili niya si Adad, na anak ni Badad, na siya ring sumakit kay Midian sa parang ni Moab: at ang pangalan ng kaniyang bayan ay Avita."
            },
            {
              "chapter": 36,
              "verse": 36,
              "name": "Genesis 36:36",
              "text": "At namatay si Adad at naghari na kahalili niya si Samla na taga Masreca."
            },
            {
              "chapter": 36,
              "verse": 37,
              "name": "Genesis 36:37",
              "text": "At namatay si Samla at naghari na kahalili niya si Saul, na taga Rehoboth na tabi ng Ilog."
            },
            {
              "chapter": 36,
              "verse": 38,
              "name": "Genesis 36:38",
              "text": "At namatay si Saul, at naghari na kahalili niya si Baalanan na anak ni Achbor."
            },
            {
              "chapter": 36,
              "verse": 39,
              "name": "Genesis 36:39",
              "text": "At namatay si Baalanan na anak ni Achbor, at naghari na kahalili niya si Adar; at ang pangalan ng kaniyang bayan ay Pau; at ang pangalan ng kaniyang asawa ay Meetabel na anak ni Matred, na anak na babae ni Mezaab."
            },
            {
              "chapter": 36,
              "verse": 40,
              "name": "Genesis 36:40",
              "text": "At ito ang mga pangalan ng mga pangulong nagmula kay Esau, ayon sa kanikaniyang angkan, ayon sa kanikaniyang dako, alinsunod sa kanikaniyang pangalan; ang pangulong Timma, ang pangulong Alva, ang pangulong Jetheth;"
            },
            {
              "chapter": 36,
              "verse": 41,
              "name": "Genesis 36:41",
              "text": "Ang pangulong Aholibama, ang pangulong Ela, ang pangulong Pinon."
            },
            {
              "chapter": 36,
              "verse": 42,
              "name": "Genesis 36:42",
              "text": "Ang pangulong Cenaz, ang pangulong Teman, ang pangulong Mibzar."
            },
            {
              "chapter": 36,
              "verse": 43,
              "name": "Genesis 36:43",
              "text": "Ang pangulong Magdiel, ang pangulong Hiram: ito ang mga pangulo ni Edom, ayon sa kanikaniyang tahanan sa lupain na kanilang pag-aari. Ito'y si Esau na ama ng mga Edomita."
            }
          ]
        },
        {
          "chapter": 37,
          "name": "Genesis 37",
          "verses": [
            {
              "chapter": 37,
              "verse": 1,
              "name": "Genesis 37:1",
              "text": "At tumahan si Jacob sa lupaing pinangibahang lupain ng kaniyang ama, sa lupain ng Canaan."
            },
            {
              "chapter": 37,
              "verse": 2,
              "name": "Genesis 37:2",
              "text": "Ito ang lahi ni Jacob. Si Jose, na may labing pitong taon, ay nagpapastol ng kawan na kasama ng kaniyang mga kapatid; at siya'y batang kasamahan ng mga anak ni Bilha at ng mga anak ni Zilpa, na mga asawa ng kaniyang ama; at ibinalita ni Jose sa kanilang ama ang kasamaan nila."
            },
            {
              "chapter": 37,
              "verse": 3,
              "name": "Genesis 37:3",
              "text": "Minamahal nga ni Israel si Jose ng higit kay sa lahat niyang anak, sapagka't siya ang anak ng kaniyang katandaan: at siya'y iginawa ng isang tunika na may sarisaring kulay."
            },
            {
              "chapter": 37,
              "verse": 4,
              "name": "Genesis 37:4",
              "text": "At nakita ng kaniyang mga kapatid na siya'y minamahal ng kanilang ama ng higit kay sa lahat niyang kapatid; at siya'y kinapootan, at hindi nila mapagsalitaan siya ng payapa."
            },
            {
              "chapter": 37,
              "verse": 5,
              "name": "Genesis 37:5",
              "text": "At nanaginip si Jose ng isang panaginip, at isinaysay sa kaniyang mga kapatid: at lalo pa nilang kinapootan siya."
            },
            {
              "chapter": 37,
              "verse": 6,
              "name": "Genesis 37:6",
              "text": "At sinabi niya sa kanila. Pakinggan ninyo, ipinamamanhik ko sa inyo, itong panaginip na aking napanaginip:"
            },
            {
              "chapter": 37,
              "verse": 7,
              "name": "Genesis 37:7",
              "text": "Sapagka't, narito, tayo'y nagtatali ng mga bigkis ng trigo sa bukid, at, narito, na tumindig ang aking bigkis, at tumuwid din naman at, narito, ang inyong mga bigkis ay napasa palibot at yumukod sa aking bigkis."
            },
            {
              "chapter": 37,
              "verse": 8,
              "name": "Genesis 37:8",
              "text": "At sa kaniya'y sinabi ng kaniyang mga kapatid, Maghahari ka ba sa amin? o papapanginoon ka sa amin? At lalo pa siyang kinapootan nila dahil sa kaniyang mga panaginip at sa kaniyang mga salita."
            },
            {
              "chapter": 37,
              "verse": 9,
              "name": "Genesis 37:9",
              "text": "At siya'y nanaginip pa ng ibang panaginip, at isinaysay sa kaniyang mga kapatid, at sinabi, Narito, ako'y nanaginip pa ng isang panaginip; at narito, na ang araw, at ang buwan at ang labing isang bituin ay yumukod sa akin."
            },
            {
              "chapter": 37,
              "verse": 10,
              "name": "Genesis 37:10",
              "text": "At kaniyang isinaysay sa kaniyang ama at sa kaniyang mga kapatid; at sinaway siya ng kaniyang ama, at sa kaniya'y sinabi, Anong panaginip itong iyong napanaginip? Tunay bang ako at ang iyong ina at ang iyong mga kapatid ay yuyukod sa lupa sa harap mo?"
            },
            {
              "chapter": 37,
              "verse": 11,
              "name": "Genesis 37:11",
              "text": "At ang kaniyang mga kapatid ay nainggit sa kaniya: datapuwa't iningatan ng kaniyang ama ang salita sa pagiisip."
            },
            {
              "chapter": 37,
              "verse": 12,
              "name": "Genesis 37:12",
              "text": "At yumaon ang kaniyang mga kapatid upang magpastol ng kawan ng kanilang ama, sa Sichem."
            },
            {
              "chapter": 37,
              "verse": 13,
              "name": "Genesis 37:13",
              "text": "At sinabi ni Israel kay Jose, Di ba nagpapastol ng kawan sa Sichem ang iyong mga kapatid? Halika, at uutusan kita sa kanila. At sinabi niya sa kaniya, Narito ako."
            },
            {
              "chapter": 37,
              "verse": 14,
              "name": "Genesis 37:14",
              "text": "At kaniyang sinabi sa kaniya, Yumaon ka, tingnan mo kung mabuti ang lagay ng iyong mga kapatid, at kung mabuti ang lagay ng kawan; at balitaan mo ako. Gayon sinugo siya mula sa libis ng Hebron, at siya'y naparoon sa Sichem."
            },
            {
              "chapter": 37,
              "verse": 15,
              "name": "Genesis 37:15",
              "text": "At nasumpungan siya ng isang tao, at, narito, na siya'y naggagala sa parang; at siya'y tinanong ng taong yaon, na sinasabi, Anong hinahanap mo?"
            },
            {
              "chapter": 37,
              "verse": 16,
              "name": "Genesis 37:16",
              "text": "At kaniyang sinabi, Hinahanap ko ang aking mga kapatid; ipinamamanhik ko sa iyo na sabihin mo sa akin kung saan sila nagpapastol."
            },
            {
              "chapter": 37,
              "verse": 17,
              "name": "Genesis 37:17",
              "text": "At sinabi ng tao, Nagsialis na sila: sapagka't narinig kong kanilang sinabi, Tayo na sa Dotan. At sinundan ni Jose ang kaniyang mga kapatid, at nasumpungan niya sila sa Dotan."
            },
            {
              "chapter": 37,
              "verse": 18,
              "name": "Genesis 37:18",
              "text": "At kanilang natanawan siya sa malayo, at bago nakalapit sa kanila ay nagbanta sila laban sa kaniya na siya'y patayin."
            },
            {
              "chapter": 37,
              "verse": 19,
              "name": "Genesis 37:19",
              "text": "At nagsangusapan, Narito, dumarating itong mapanaginipin."
            },
            {
              "chapter": 37,
              "verse": 20,
              "name": "Genesis 37:20",
              "text": "Halikayo ngayon, siya'y ating patayin, at siya'y ating itapon sa isa sa mga balon, at ating sasabihin, Sinakmal siya ng isang masamang hayop: at ating makikita kung anong mangyayari sa kaniyang mga panaginip."
            },
            {
              "chapter": 37,
              "verse": 21,
              "name": "Genesis 37:21",
              "text": "At narinig ni Ruben, at iniligtas siya sa kanilang kamay; at sinabi, Huwag nating kitlin ang kaniyang buhay."
            },
            {
              "chapter": 37,
              "verse": 22,
              "name": "Genesis 37:22",
              "text": "At sinabi ni Ruben sa kanila, Huwag kayong magbubo ng dugo; itapon ninyo sa balong ito na nasa ilang, datapuwa't huwag ninyong pagbuhatan ng kamay; upang iligtas sa kanilang kamay ng mapabalik sa kaniyang ama."
            },
            {
              "chapter": 37,
              "verse": 23,
              "name": "Genesis 37:23",
              "text": "At nangyari, nang dumating si Jose sa kaniyang mga kapatid, na hinubdan siya ng kaniyang tunika, ng tunikang may sarisaring kulay na kaniyang suot;"
            },
            {
              "chapter": 37,
              "verse": 24,
              "name": "Genesis 37:24",
              "text": "At kanilang sinunggaban, at kanilang itinapon sa balon: at ang balon ay tuyo, walang tubig."
            },
            {
              "chapter": 37,
              "verse": 25,
              "name": "Genesis 37:25",
              "text": "At nagsiupo upang kumain ng tinapay, at kanilang itiningin ang kanilang mga mata at tumingin sila, at, narito, ang isang pulutong na mga Ismaelita na nagsisipanggaling sa Gilead sangpu ng kanilang mga kamelyo at may dalang mga pabango, at mga balsamo, at mga mirra, na kanilang dadalhin sa Egipto."
            },
            {
              "chapter": 37,
              "verse": 26,
              "name": "Genesis 37:26",
              "text": "At sinabi ni Juda sa kaniyang mga kapatid. Anong ating mapapakinabang kung ating patayin ang ating kapatid, at ilihim ang kaniyang dugo?"
            },
            {
              "chapter": 37,
              "verse": 27,
              "name": "Genesis 37:27",
              "text": "Halikayo, at atin siyang ipagbili sa mga Ismaelita, at huwag natin siyang pagbuhatan ng kamay; sapagka't siya'y ating kapatid, atin din laman. At dininig siya ng kaniyang mga kapatid."
            },
            {
              "chapter": 37,
              "verse": 28,
              "name": "Genesis 37:28",
              "text": "At nagsisipagdaan ang mga mangangalakal na mga Midianita; at kanilang isinampa si Jose sa balon, at ipinagbili nila si Jose sa mga Ismaelita ng dalawang pung putol na pilak. At dinala si Jose sa Egipto."
            },
            {
              "chapter": 37,
              "verse": 29,
              "name": "Genesis 37:29",
              "text": "At nagbalik si Ruben sa balon; at, narito, na si Jose ay wala sa balon; at kaniyang hinapak ang kaniyang mga suot."
            },
            {
              "chapter": 37,
              "verse": 30,
              "name": "Genesis 37:30",
              "text": "At siya'y nagbalik sa kaniyang mga kapatid, at kaniyang sinabi, Wala ang bata; at ako, saan ako paroroon?"
            },
            {
              "chapter": 37,
              "verse": 31,
              "name": "Genesis 37:31",
              "text": "At kanilang kinuha ang tunika ni Jose, at sila'y pumatay ng isang lalaking kambing, at kanilang inilubog ang tunika sa dugo:"
            },
            {
              "chapter": 37,
              "verse": 32,
              "name": "Genesis 37:32",
              "text": "At kanilang ipinadala ang tunikang may sarisaring kulay, at dinala sa kanilang ama; at kanilang sinabi, Ito'y aming nasumpungan: kilalanin mo ngayon, kung tunika ng iyong anak o hindi."
            },
            {
              "chapter": 37,
              "verse": 33,
              "name": "Genesis 37:33",
              "text": "At kaniyang kinilala, at sinabi, Siya ngang tunika ng aking anak; sinakmal siya ng isang masamang hayop; si Jose ay walang pagsalang nilapa."
            },
            {
              "chapter": 37,
              "verse": 34,
              "name": "Genesis 37:34",
              "text": "At hinapak ni Jacob ang kaniyang mga suot, at kaniyang nilagyan ng magaspang na damit ang kaniyang mga balakang, at tinangisang maraming araw ang kaniyang anak."
            },
            {
              "chapter": 37,
              "verse": 35,
              "name": "Genesis 37:35",
              "text": "At nagsitindig ang lahat niyang mga anak na lalake at babae upang siya'y aliwin; datapuwa't tumanggi siyang maaliw; at kaniyang sinabi, Sapagka't lulusong akong tumatangis sa aking anak hanggang sa Sheol. At tinangisan siya ng kaniyang ama."
            },
            {
              "chapter": 37,
              "verse": 36,
              "name": "Genesis 37:36",
              "text": "At ipinagbili siya ng mga Midianita sa Egipto kay Potiphar, puno ni Faraon, na kapitan ng bantay."
            }
          ]
        },
        {
          "chapter": 38,
          "name": "Genesis 38",
          "verses": [
            {
              "chapter": 38,
              "verse": 1,
              "name": "Genesis 38:1",
              "text": "At nangyari nang panahong yaon, na humiwalay si Juda sa kaniyang mga kapatid, at nagdaan sa isang Adullamita na ang pangalan ay Hira."
            },
            {
              "chapter": 38,
              "verse": 2,
              "name": "Genesis 38:2",
              "text": "At nakita roon ni Juda ang anak na babae ng isang Cananeo, na tinatawag na Sua; at kinuha niya at kaniyang sinipingan."
            },
            {
              "chapter": 38,
              "verse": 3,
              "name": "Genesis 38:3",
              "text": "At naglihi, at nanganak ng lalake; at tinawag niya ang kaniyang pangalang Er."
            },
            {
              "chapter": 38,
              "verse": 4,
              "name": "Genesis 38:4",
              "text": "At naglihi uli, at nanganak ng lalake; at tinawag niya ang kaniyang pangalang Onan."
            },
            {
              "chapter": 38,
              "verse": 5,
              "name": "Genesis 38:5",
              "text": "At muling naglihi at nanganak ng lalake; at tinawag niya ang kaniyang pangalang Selah: at si Juda ay nasa sa Chezib nang siya'y manganak."
            },
            {
              "chapter": 38,
              "verse": 6,
              "name": "Genesis 38:6",
              "text": "At pinapag-asawa ni Juda si Er na kaniyang panganay, at ang pangalan niyao'y Thamar."
            },
            {
              "chapter": 38,
              "verse": 7,
              "name": "Genesis 38:7",
              "text": "At si Er, na panganay ni Juda, ay naging masama sa paningin ng Panginoon; at siya'y pinatay ng Panginoon."
            },
            {
              "chapter": 38,
              "verse": 8,
              "name": "Genesis 38:8",
              "text": "At sinabi ni Juda kay Onan, Sumiping ka sa asawa ng iyong kapatid, at tuparin mo sa kaniya ang tungkulin ng kapatid ng asawa, at ipagbangon mo ng binhi ang iyong kapatid."
            },
            {
              "chapter": 38,
              "verse": 9,
              "name": "Genesis 38:9",
              "text": "At nalalaman ni Onan na hindi magiging kaniya ang binhi; at nangyari, na pagka sisiping siya sa asawa ng kaniyang kapatid, ay pinatutulo niya sa lupa, nang huwag lamang niyang bigyan ng binhi ang kaniyang kapatid."
            },
            {
              "chapter": 38,
              "verse": 10,
              "name": "Genesis 38:10",
              "text": "At ang bagay na ginawa niya ay masama sa paningin ng Panginoon, at siya'y pinatay rin naman."
            },
            {
              "chapter": 38,
              "verse": 11,
              "name": "Genesis 38:11",
              "text": "Nang magkagayo'y sinabi ni Juda kay Thamar na kaniyang manugang na babae: Manatili kang bao sa bahay ng iyong ama, hanggang sa lumaki si Selah na aking anak: sapagka't sinabi niya, Marahil ay hindi siya mamamatay ng gaya ng kaniyang mga kapatid. At yumaon si Thamar at tumahan sa bahay ng kaniyang ama."
            },
            {
              "chapter": 38,
              "verse": 12,
              "name": "Genesis 38:12",
              "text": "At nagdaan ang maraming araw; at namatay ang anak na babae ni Sua, na asawa ni Juda; at nagaliw si Juda, at umahon sa Timnath sa mga manggugupit sa kaniyang mga tupa, siya at ang kaniyang kaibigang si Hira na Adullamita."
            },
            {
              "chapter": 38,
              "verse": 13,
              "name": "Genesis 38:13",
              "text": "At naibalita kay Thamar, na sinasabi, Narito, ang iyong biyanang lalake ay umaahon sa Timnath upang pagupitan ang kaniyang mga tupa."
            },
            {
              "chapter": 38,
              "verse": 14,
              "name": "Genesis 38:14",
              "text": "At siya'y nagalis ng suot pagkabao, at nagtakip ng kaniyang lambong, at pagkapagtakip ay naupo sa pasukan ng Enaim, na nasa daan ng Timnath; sapagka't kaniyang nakikita, na si Selah ay malaki na, at hindi pa siya ibinibigay na asawa."
            },
            {
              "chapter": 38,
              "verse": 15,
              "name": "Genesis 38:15",
              "text": "Nang makita siya ni Juda ay ipinalagay siyang patutot, sapagka't siya'y nagtakip ng kaniyang mukha."
