            {
              "chapter": 36,
              "verse": 21,
              "name": "Genesis 36:21",
              "text": "At si Dison, at si Ezer, at si Disan: ito ang mga pangulong nagmula sa mga Horeo, na mga angkan ni Seir sa lupain ng Edom."
            },
            {
              "chapter": 36,
              "verse": 22,
              "name": "Genesis 36:22",
              "text": "At ang mga anak ni Lotan, ay si Hori at si Heman; at ang kapatid na babae ni Lotan ay si Timna."
