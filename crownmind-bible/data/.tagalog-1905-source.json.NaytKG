            {
              "chapter": 26,
              "verse": 11,
              "name": "Genesis 26:11",
              "text": "At ibinilin ni Abimelech sa buong bayan, na sinabi, Ang gumalaw sa lalaking ito o sa kaniyang asawa ay tunay na papatayin."
