            {
              "chapter": 45,
              "verse": 7,
              "name": "Genesis 45:7",
              "text": "At sinugo ako ng Dios sa unahan ninyo upang papanatilihin kayong pinakalahi sa lupa, at upang iligtas kayong buhay sa pamamagitan ng dakilang pagliligtas."
