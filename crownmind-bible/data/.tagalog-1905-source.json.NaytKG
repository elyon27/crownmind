            {
              "chapter": 44,
              "verse": 30,
              "name": "Genesis 44:30",
              "text": "Ngayon nga'y kung ako'y dumating sa iyong lingkod na aking ama, at ang bata ay hindi namin kasama; sapagka't ang kaniyang buhay ay natatali sa buhay ng batang iyan;"
