            {
              "chapter": 39,
              "verse": 21,
              "name": "Genesis 39:21",
              "text": "Datapuwa't ang Panginoon ay suma kay Jose, at iginawad sa kaniya ang awa, at pinagkalooban ng biyaya sa paningin ng katiwala sa bilangguan."
