            {
              "chapter": 18,
              "verse": 5,
              "name": "1 Mga Hari 18:5",
              "text": "At sinabi ni Achab kay Abdias, Lakarin mo ang lupain, hanggang sa lahat ng mga bukal ng tubig, at hanggang sa lahat ng mga batis: marahil tayo'y makakasumpong ng damo, at maililigtas nating buhay ang mga kabayo at mga mula upang huwag tayong mawalan ng lahat na hayop."
            },
            {
              "chapter": 18,
              "verse": 6,
              "name": "1 Mga Hari 18:6",
              "text": "Sa gayo'y pinaghati nila ang lupain sa gitna nila upang lakarin: si Achab ay lumakad ng kaniyang sarili sa isang daan, at si Abdias ay lumakad ng kaniyang sarili sa isang daan."
            },
            {
              "chapter": 18,
              "verse": 7,
              "name": "1 Mga Hari 18:7",
              "text": "At samantalang si Abdias ay nasa daan, narito, nasalubong siya ni Elias: at nakilala niya siya, at nagpatirapa, at nagsabi, Di ba ikaw, ang panginoon kong si Elias?"
            },
            {
              "chapter": 18,
              "verse": 8,
              "name": "1 Mga Hari 18:8",
              "text": "At siya'y sumagot sa kaniya, Ako nga: ikaw ay yumaon, saysayin mo sa iyong panginoon, Narito, si Elias ay nandito."
            },
            {
              "chapter": 18,
              "verse": 9,
              "name": "1 Mga Hari 18:9",
              "text": "At kaniyang sinabi, Sa ano ako nagkasala na iyong ibibigay ang iyong lingkod sa kamay ni Achab, upang patayin ako?"
            },
            {
              "chapter": 18,
              "verse": 10,
              "name": "1 Mga Hari 18:10",
              "text": "Buhay ang Panginoon mong Dios, walang bansa o kaharian man na hindi pinagpahanapan sa iyo ng aking panginoon: at pagka kanilang sinasabi, Siya'y wala rito, kaniyang pinasusumpa ang kaharian at bansa, na hindi kinasusumpungan sa iyo."
            },
            {
              "chapter": 18,
              "verse": 11,
              "name": "1 Mga Hari 18:11",
              "text": "At ngayo'y iyong sinasabi, Ikaw ay yumaon, saysayin mo sa iyong panginoon, Narito, si Elias ay nandito."
            },
            {
              "chapter": 18,
              "verse": 12,
              "name": "1 Mga Hari 18:12",
              "text": "At mangyayari, pagkahiwalay ko sa iyo na dadalhin ka ng Espiritu ng Panginoon sa hindi ko nalalaman; na anopa't pagka ako'y pumaroon at isinaysay ko kay Achab, at ikaw ay hindi niya nasumpungan, papatayin niya ako: nguni't akong iyong lingkod ay natatakot sa Panginoon mula sa aking pagkabinata."
            },
            {
              "chapter": 18,
              "verse": 13,
              "name": "1 Mga Hari 18:13",
              "text": "Hindi ba nasaysay sa aking panginoon, kung ano ang aking ginawa nang patayin ni Jezabel ang mga propeta ng Panginoon, kung paanong nagkubli ako ng isang daan sa mga propeta ng Panginoon, na limalimangpu sa isang yungib, at pinakain ko sila ng tinapay at tubig?"
            },
            {
              "chapter": 18,
              "verse": 14,
              "name": "1 Mga Hari 18:14",
              "text": "At ngayo'y iyong sinasabi, Ikaw ay yumaon, saysayin mo sa iyong panginoon. Narito, si Elias ay nandito; at papatayin niya ako."
            },
            {
              "chapter": 18,
              "verse": 15,
              "name": "1 Mga Hari 18:15",
              "text": "At sinabi ni Elias, Buhay ang Panginoon ng mga hukbo, na sa harap niya'y nakatayo ako, ako'y walang salang pakikita sa kaniya ngayon."
            },
            {
              "chapter": 18,
              "verse": 16,
              "name": "1 Mga Hari 18:16",
              "text": "Sa gayo'y yumaon si Abdias upang salubungin si Achab, at sinaysay sa kaniya: at si Achab ay yumaon upang salubungin si Elias."
            },
            {
              "chapter": 18,
              "verse": 17,
              "name": "1 Mga Hari 18:17",
              "text": "At nangyari, nang makita ni Achab si Elias, na sinabi ni Achab sa kaniya, Di ba ikaw, ang mangbabagabag sa Israel?"
            },
            {
              "chapter": 18,
              "verse": 18,
              "name": "1 Mga Hari 18:18",
              "text": "At siya'y sumagot, Hindi ko binagabag ang Israel; kundi ikaw, at ang sangbahayan ng iyong ama, sa inyong pagkapabaya ng mga utos ng Panginoon, at ikaw ay sumunod kay Baal."
            },
            {
              "chapter": 18,
              "verse": 19,
              "name": "1 Mga Hari 18:19",
              "text": "Ngayon nga'y magsugo ka, at pisanin mo sa akin ang buong Israel sa bundok ng Carmelo, at ang mga propeta ni Baal na apat na raan at limangpu, at ang mga propeta ni Asera na apat na raan, na nagsikain sa dulang ni Jezabel."
            },
            {
              "chapter": 18,
              "verse": 20,
              "name": "1 Mga Hari 18:20",
              "text": "Sa gayo'y nagsugo si Achab sa lahat ng mga anak ni Israel, at pinisan ang mga propeta sa bundok ng Carmelo."
            },
            {
              "chapter": 18,
              "verse": 21,
              "name": "1 Mga Hari 18:21",
              "text": "At si Elias ay lumapit sa buong bayan, at nagsabi, Hanggang kaylan kayo mangagaalinlangan sa dalawang isipan? kung ang Panginoon ay Dios, sumunod kayo sa kaniya: nguni't kung si Baal, sumunod nga kayo sa kaniya. At ang bayan ay hindi sumagot sa kaniya kahit isang salita."
            },
            {
              "chapter": 18,
              "verse": 22,
              "name": "1 Mga Hari 18:22",
              "text": "Nang magkagayo'y sinabi ni Elias sa bayan, Ako, ako lamang, ang naiwang propeta ng Panginoon; nguni't ang mga propeta ni Baal ay apat na raan at limang pung lalake."
            },
            {
              "chapter": 18,
              "verse": 23,
              "name": "1 Mga Hari 18:23",
              "text": "Bigyan nga nila tayo ng dalawang baka; at pumili sila sa ganang kanila ng isang baka, at katayin, at ilagay sa ibabaw ng kahoy, at huwag lagyan ng apoy sa ilalim: at ihahanda ko ang isang baka at ilalagay ko sa kahoy, at hindi ko lalagyan ng apoy sa ilalim."
            },
            {
              "chapter": 18,
              "verse": 24,
              "name": "1 Mga Hari 18:24",
              "text": "At tawagan ninyo ang pangalan ng inyong dios, at tatawagan ko ang pangalan ng Panginoon: at ang Dios na sumagot sa pamamagitan ng apoy, ay siyang maging Dios. At ang buong bayan ay sumagot, at nagsabi, Mabuti ang pagkasabi."
            },
            {
              "chapter": 18,
              "verse": 25,
              "name": "1 Mga Hari 18:25",
              "text": "At sinabi ni Elias sa mga propeta ni Baal, Magsipili kayo ng isang baka sa ganang inyo, at inyong ihandang una, sapagka't kayo'y marami; at tawagan ninyo ang pangalan ng inyong dios, nguni't huwag ninyong lagyan ng apoy sa ilalim."
            },
            {
              "chapter": 18,
              "verse": 26,
              "name": "1 Mga Hari 18:26",
              "text": "At kanilang kinuha ang baka na ibinigay sa kanila, at kanilang inihanda, at tinawagan ang pangalan ni Baal mula sa kinaumagahan hanggang sa kinatanghaliang tapat, na nagsisipagsabi, Oh Baal dinggin mo kami. Nguni't walang tinig, o sinomang sumagot. At sila'y nagsisilukso sa siping ng dambana na ginawa."
            },
            {
              "chapter": 18,
              "verse": 27,
              "name": "1 Mga Hari 18:27",
              "text": "At nangyari, nang kinatanghaliang tapat, na biniro sila ni Elias, at sinabi, Sumigaw kayo ng malakas: sapagka't siya'y dios; siya nga'y nagmumunimuni, o nasa tabi, o nasa paglalakbay, o marahil siya'y natutulog, at marapat gisingin."
            },
            {
              "chapter": 18,
              "verse": 28,
              "name": "1 Mga Hari 18:28",
              "text": "At sila'y nagsisigaw ng malakas, at sila'y nagsipagkudlit ayon sa kanilang kaugalian ng sundang at mga sibat, hanggang sa bumuluwak ang dugo sa kanila."
            },
            {
              "chapter": 18,
              "verse": 29,
              "name": "1 Mga Hari 18:29",
              "text": "At nangyari nang makaraan ang kinatanghaliang tapat, na sila'y nanghula hanggang sa oras ng paghahandog ng alay na ukol sa hapon: nguni't wala kahit tinig, ni sinomang sumagot, ni sinomang makinig."
            },
            {
              "chapter": 18,
              "verse": 30,
              "name": "1 Mga Hari 18:30",
              "text": "At sinabi ni Elias sa buong bayan, Lumapit kayo sa akin; at ang buong bayan ay lumapit sa kaniya. At kaniyang inayos ang dambana ng Panginoon na nabagsak."
            },
            {
              "chapter": 18,
              "verse": 31,
              "name": "1 Mga Hari 18:31",
              "text": "At kumuha si Elias ng labing dalawang bato, ayon sa bilang ng mga lipi ng mga anak ni Jacob, na sa kaniya ang salita ng Panginoon ay dumating, na sinasabi, Israel ang magiging iyong pangalan."
            },
            {
              "chapter": 18,
              "verse": 32,
              "name": "1 Mga Hari 18:32",
              "text": "At sa pamamagitan ng mga bato ay kaniyang itinayo ang dambana sa pangalan ng Panginoon; at kaniyang nilagyan ng hukay sa palibot ng dambana, na ang laki ay kasisidlan ng dalawang takal na binhi."
            },
            {
              "chapter": 18,
              "verse": 33,
              "name": "1 Mga Hari 18:33",
              "text": "At kaniyang inilagay ang kahoy na maayos, at kinatay ang baka at ipinatong sa kahoy. At kaniyang sinabi, Punuin ninyo ang apat na tapayan ng tubig, at ibuhos ninyo sa handog na susunugin, at sa kahoy."
            },
            {
              "chapter": 18,
              "verse": 34,
              "name": "1 Mga Hari 18:34",
              "text": "At kaniyang sinabi, Gawin ninyong ikalawa; at kanilang ginawang ikalawa. At kaniyang sinabi, Gawin ninyong ikaitlo; at kanilang ginawang ikaitlo."
            },
            {
              "chapter": 18,
              "verse": 35,
              "name": "1 Mga Hari 18:35",
              "text": "At ang tubig ay umagos sa palibot ng dambana; at kaniyang pinuno naman ng tubig ang hukay."
            },
            {
              "chapter": 18,
              "verse": 36,
              "name": "1 Mga Hari 18:36",
              "text": "At nangyari, sa oras ng paghahandog ng alay sa hapon, na si Elias, na propeta ay lumapit, at nagsabi, Oh Panginoon, na Dios ni Abraham, ni Isaac, at ni Israel, pakilala ka sa araw na ito, na ikaw ay Dios sa Israel, at ako ang iyong lingkod, at aking ginawa ang lahat na bagay na ito sa iyong salita."
            },
            {
              "chapter": 18,
              "verse": 37,
              "name": "1 Mga Hari 18:37",
              "text": "Dinggin mo ako, Oh Panginoon, dinggin mo ako, upang matalastas ng bayang ito, na ikaw, na Panginoon, ay Dios, at iyong pinapanumbalik ang kanilang puso."
            },
            {
              "chapter": 18,
              "verse": 38,
              "name": "1 Mga Hari 18:38",
              "text": "Nang magkagayo'y ang apoy ng Panginoon ay nalaglag, at sinupok ang handog na susunugin at ang kahoy, at ang mga bato, at ang alabok, at hinimuran ang tubig na nasa hukay."
            },
            {
              "chapter": 18,
              "verse": 39,
              "name": "1 Mga Hari 18:39",
              "text": "At nang makita ng buong bayan, sila'y nagpatirapa: at kanilang sinabi, Ang Panginoon ay siyang Dios; ang Panginoon ay siyang Dios."
            },
            {
              "chapter": 18,
              "verse": 40,
              "name": "1 Mga Hari 18:40",
              "text": "At sinabi ni Elias sa kanila, Dakpin ninyo ang mga propeta ni Baal; huwag makatanan ang sinoman sa kanila. At kanilang dinakip sila: at sila'y ibinaba ni Elias sa batis ng Cison, at pinatay roon."
            },
            {
              "chapter": 18,
              "verse": 41,
              "name": "1 Mga Hari 18:41",
              "text": "At sinabi ni Elias kay Achab, Ikaw ay umahon, kumain ka at uminom ka; sapagka't may hugong ng kasaganaan ng ulan."
            },
            {
              "chapter": 18,
              "verse": 42,
              "name": "1 Mga Hari 18:42",
              "text": "Sa gayo'y umahon si Achab upang kumain at uminom. At si Elias ay umahon sa taluktok ng Carmelo; at siya'y yumukod sa lupa, at inilagay ang kaniyang mukha sa pagitan ng kaniyang mga tuhod."
            },
            {
              "chapter": 18,
              "verse": 43,
              "name": "1 Mga Hari 18:43",
              "text": "At kaniyang sinabi sa kaniyang lingkod, Umahon ka ngayon, tumingin ka sa dakong dagat. At siya'y umahon at tumingin, at nagsabi, Walang anomang bagay. At kaniyang sinabi, Yumaon ka uling makapito."
            },
            {
              "chapter": 18,
              "verse": 44,
              "name": "1 Mga Hari 18:44",
              "text": "At nangyari, sa ikapito, na kaniyang sinabi, Narito, may bumangong isang ulap sa dagat, na kasingliit ng kamay ng isang lalake. At kaniyang sinabi, Ikaw ay yumaon, sabihin mo kay Achab, Ihanda mo ang iyong karo, at ikaw ay lumusong baka ka mapigil ng ulan."
            },
            {
              "chapter": 18,
              "verse": 45,
              "name": "1 Mga Hari 18:45",
              "text": "At nangyari, pagkaraan ng sangdali, na ang langit ay nagdilim sa alapaap at hangin, at nagkaroon ng malakas na ulan. At si Achab ay sumakay, at naparoon sa Jezreel."
            },
            {
              "chapter": 18,
              "verse": 46,
              "name": "1 Mga Hari 18:46",
              "text": "At ang kamay ng Panginoon ay nasa kay Elias; at kaniyang binigkisan ang kaniyang mga balakang, at tumakbong nagpauna kay Achab sa pasukan ng Jezreel."
            }
          ]
        },
        {
          "chapter": 19,
          "name": "1 Mga Hari 19",
          "verses": [
            {
              "chapter": 19,
              "verse": 1,
              "name": "1 Mga Hari 19:1",
              "text": "At sinaysay ni Achab kay Jezabel ang lahat na ginawa ni Elias, at kung paanong kaniyang pinatay ng tabak ang lahat ng mga propeta."
            },
            {
              "chapter": 19,
              "verse": 2,
              "name": "1 Mga Hari 19:2",
              "text": "Nang magkagayo'y nagsugo si Jezabel ng sugo kay Elias, na nagsasabi, Ganito ang gawin sa akin ng mga dios, at lalo na, kung hindi ko gawin ang buhay mo na gaya ng buhay ng isa sa kanila kinabukasan sa may ganitong panahon."
            },
            {
              "chapter": 19,
              "verse": 3,
              "name": "1 Mga Hari 19:3",
              "text": "At nang makita niya ay bumangon siya, at yumaon dahil sa kaniyang buhay, at naparoon sa Beerseba, na nauukol sa Juda, at iniwan ang kaniyang lingkod doon."
            },
            {
              "chapter": 19,
              "verse": 4,
              "name": "1 Mga Hari 19:4",
              "text": "Nguni't siya'y lumakad ng paglalakbay na isang araw sa ilang at naparoon, at umupo sa ilalim ng isang punong kahoy na enebro: at siya'y humiling sa ganang kaniya na siya'y mamatay sana, at nagsabi, Sukat na; ngayon, Oh Panginoon kunin mo ang aking buhay; sapagka't hindi ako mabuti kay sa aking mga magulang."
            },
            {
              "chapter": 19,
              "verse": 5,
              "name": "1 Mga Hari 19:5",
              "text": "At siya'y nahiga at natulog sa ilalim ng punong kahoy na enebro; at, narito, kinalabit siya ng isang anghel, at sinabi sa kaniya, Ikaw ay gumising at kumain."
            },
            {
