            {
              "chapter": 30,
              "verse": 15,
              "name": "Deuteronomio 30:15",
              "text": "Tingnan mo, na inilagay ko sa harap mo sa araw na ito ang buhay at ang kabutihan, at ang kamatayan at ang kasamaan;"
