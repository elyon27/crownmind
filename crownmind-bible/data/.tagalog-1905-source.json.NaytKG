            {
              "chapter": 10,
              "verse": 14,
              "name": "2 Samuel 10:14",
              "text": "At nang makita ng mga anak ni Ammon na ang mga taga Siria ay nagsitakas, sila naman ay nagsitakas sa harap ni Abisai, at nagsipasok sa bayan. Ngayo'y bumalik si Joab na mula sa mga anak ni Ammon, at naparoon sa Jerusalem."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "2 Samuel 10:15",
