            {
              "chapter": 4,
              "verse": 21,
              "name": "2 Mga Hari 4:21",
              "text": "At siya'y pumanhik at inihiga siya sa higaan ng lalake ng Dios, at pinagsarhan niya ng pintuan siya, at lumabas."
