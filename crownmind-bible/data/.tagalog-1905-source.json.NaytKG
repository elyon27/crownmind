            {
              "chapter": 44,
              "verse": 24,
              "name": "Genesis 44:24",
              "text": "At nangyari nang panhikin namin ang inyong lingkod na aking ama, ay aming isinaysay sa kaniya ang mga salita ng aking panginoon."
            },
            {
              "chapter": 44,
              "verse": 25,
              "name": "Genesis 44:25",
              "text": "At sinabi ng aming ama, Pumaroon kayo uli, ibili ninyo tayo ng kaunting pagkain."
