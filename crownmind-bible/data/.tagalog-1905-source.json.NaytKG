            },
            {
              "chapter": 26,
              "verse": 17,
              "name": "Genesis 26:17",
              "text": "At umalis si Isaac doon, at humantong sa libis ng Gerar, at tumahan doon."
            },
            {
              "chapter": 26,
              "verse": 18,
              "name": "Genesis 26:18",
              "text": "At muling hinukay ni Isaac ang mga balon ng tubig na kanilang hinukay nang mga kaarawan ni Abraham na kaniyang ama; sapagka't pinagtabunan ng mga Filisteo, pagkamatay ni Abraham: at kaniyang mga pinanganlan ng ayon sa mga pangalang inilagay ng kaniyang ama."
            },
            {
              "chapter": 26,
              "verse": 19,
              "name": "Genesis 26:19",
              "text": "At humukay sa libis ang mga bataan ni Isaac, at nangakasumpong doon ng isang balon ng tubig na bumubukal."
            },
            {
              "chapter": 26,
              "verse": 20,
              "name": "Genesis 26:20",
              "text": "At nakipagtalo ang mga pastor ni Gerar sa mga pastor ni Isaac, na sinasabi, Amin ang tubig; at kaniyang tinawag ang pangalan ng balon, na Esec; sapagka't ipinakipagkaalit sa kaniya."
            },
            {
              "chapter": 26,
              "verse": 21,
              "name": "Genesis 26:21",
              "text": "At sila'y humukay ng ibang balon; at kanilang pinagtalunan din: at kaniyang tinawag ang pangalan na Sitnah."
            },
            {
              "chapter": 26,
              "verse": 22,
              "name": "Genesis 26:22",
              "text": "At bumunot siya roon, at humukay ng ibang balon; at hindi nila pinagtalunan: at kaniyang tinawag ang pangalan na Rehoboth; at kaniyang sinabi, Sapagka't ngayo'y binigyan tayo ng Panginoon ng kaluwagan, at lalago tayo sa lupain."
            },
            {
              "chapter": 26,
              "verse": 23,
              "name": "Genesis 26:23",
              "text": "At mula roon ay umahon siya sa Beerseba."
            },
            {
              "chapter": 26,
              "verse": 24,
              "name": "Genesis 26:24",
              "text": "At napakita sa kaniya ang Panginoon ng gabi ring yaon, at nagsabi, Ako ang Dios ni Abraham na iyong ama: huwag kang matakot, sapagka't ako'y sumasaiyo, at ikaw ay aking pagpapalain, at aking pararamihin ang iyong binhi, alangalang kay Abraham na aking lingkod."
            },
            {
              "chapter": 26,
              "verse": 25,
              "name": "Genesis 26:25",
              "text": "At si Isaac ay nagtayo roon ng isang dambana, at kaniyang sinambitla ang pangalan ng Panginoon, at itinindig niya roon ang kaniyang tolda: at humukay roon ang mga bataan ni Isaac ng isang balon."
            },
            {
              "chapter": 26,
              "verse": 26,
              "name": "Genesis 26:26",
              "text": "Nang magkagayo'y si Abimelech ay naparoon sa kaniya mula sa Gerar, at si Ahuzath na kaniyang kaibigan, at si Phicol na kapitan ng kaniyang hukbo."
            },
            {
              "chapter": 26,
              "verse": 27,
              "name": "Genesis 26:27",
              "text": "At sinabi sa kanila ni Isaac, Bakit kayo naparirito sa akin, dangang kayo'y nangapopoot sa akin at pinalayas ninyo ako sa inyo?"
            },
            {
              "chapter": 26,
              "verse": 28,
              "name": "Genesis 26:28",
              "text": "At sinabi nila, Malinaw na aming nakita, na ang Panginoon ay sumasaiyo: at aming sinabi, Magkaroon ng pagsusumpaan tayo, kami at ikaw at makipagtipan kami sa iyo:"
            },
            {
              "chapter": 26,
              "verse": 29,
              "name": "Genesis 26:29",
              "text": "Na hindi ka gagawa sa amin ng masama, gaya naman namin na hindi ka namin ginalaw, at wala kaming ginawa sa iyong di mabuti, at pinayaon ka naming payapa: ikaw ngayon ang pinagpala ng Panginoon."
            },
            {
              "chapter": 26,
              "verse": 30,
              "name": "Genesis 26:30",
              "text": "At pinaghandaan niya sila, at sila'y nagkainan at naginuman."
            },
            {
              "chapter": 26,
              "verse": 31,
              "name": "Genesis 26:31",
              "text": "At sila'y gumising ng madaling araw, at sila'y nagpanumpaan: at sila'y pinagpaalam ni Isaac, at nagsialis na payapa sa kaniya."
            },
            {
              "chapter": 26,
              "verse": 32,
              "name": "Genesis 26:32",
              "text": "At nangyari, nang araw ding yaon, na nagsidating ang mga bataan ni Isaac, at siya'y binalitaan tungkol sa balon nilang hinukay, at sinabi sa kaniya, Nakasumpong kami ng tubig."
            },
            {
              "chapter": 26,
              "verse": 33,
              "name": "Genesis 26:33",
              "text": "At tinawag niyang Seba: kaya't ang pangalan ng bayang yaon ay Beerseba hanggang ngayon."
