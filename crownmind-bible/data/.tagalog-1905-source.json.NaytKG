            {
              "chapter": 1,
              "verse": 44,
              "name": "1 Mga Cronica 1:44",
              "text": "At namatay si Belah, at si Jobab na anak ni Zera na taga Bosra ay naghari na kahalili niya."
            },
            {
              "chapter": 1,
              "verse": 45,
              "name": "1 Mga Cronica 1:45",
              "text": "At namatay si Jobab, at si Husam sa lupain ng mga Themaneo ay naghari na kahalili niya."
