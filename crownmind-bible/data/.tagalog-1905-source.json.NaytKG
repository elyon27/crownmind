            {
              "chapter": 25,
              "verse": 3,
              "name": "2 Mga Hari 25:3",
              "text": "Nang ikasiyam na araw ng ikaapat na buwan, ang kagutom ay lumala sa bayan, na anopa't walang tinapay sa bayan ng lupain."
