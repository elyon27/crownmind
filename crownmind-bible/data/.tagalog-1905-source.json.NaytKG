    {
      "nr": 9,
      "name": "1 Samuel",
      "chapters": [
        {
          "chapter": 1,
          "name": "1 Samuel 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "1 Samuel 1:1",
              "text": "May isa ngang lalake na taga Ramathaim-sophim, sa lupaing maburol ng Ephraim, at ang pangalan niya'y Elcana, na anak ni Jeroham, na anak ni Eliu, na anak ni Thohu, na anak ni Suph na Ephraimita:"
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "1 Samuel 1:2",
              "text": "At siya'y may dalawang asawa; ang pangalan ng isa'y Ana, at ang pangalan ng isa'y Peninna: at si Peninna ay may mga anak nguni't si Ana ay walang anak."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "1 Samuel 1:3",
              "text": "At ang lalaking ito ay umaahon sa taon-taon mula sa kaniyang bayan upang sumamba at maghain sa Panginoon ng mga hukbo sa Silo. At ang dalawang anak ni Eli, na si Ophni at si Phinees, na mga saserdote sa Panginoon, ay nangandoon."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "1 Samuel 1:4",
              "text": "At pagka dumarating ang araw na si Elcana ay naghahain, ay kaniyang binibigyan ng mga bahagi si Peninna na kaniyang asawa, at ang lahat ng kaniyang mga anak na lalake at babae:"
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "1 Samuel 1:5",
              "text": "Nguni't si Ana ay binibigyan niya ng ibayong bahagi: sapagka't minamahal niya si Ana, bagaman sinarhan ng Panginoon ang kaniyang bahay-bata."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "1 Samuel 1:6",
              "text": "At minumungkahi siyang mainam ng kaniyang kaagaw upang yamutin siya, sapagka't sinarhan ng Panginoon ang kaniyang bahay-bata."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "1 Samuel 1:7",
              "text": "At gayon ang ginagawa niya sa taon-taon, na pagka inaahon niya ang bahay ng Panginoon ay minumungkahi niyang gayon ang isa; kaya't siya'y umiiyak, at hindi kumakain."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "1 Samuel 1:8",
              "text": "At sinabi ni Elcana na kaniyang asawa sa kaniya, Ana, bakit ka umiiyak? at bakit hindi ka kumakain? at bakit nagdadalamhati ang iyong puso? hindi ba ako mabuti sa iyo kay sa sangpung anak?"
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "1 Samuel 1:9",
              "text": "Sa gayo'y bumangon si Ana pagkatapos na makakain sila sa Silo at pagkatapos na sila'y makainom. Ngayo'y si Eli na saserdote ay nakaupo sa upuan niya sa siping ng haligi ng pintuan ng templo ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "1 Samuel 1:10",
              "text": "At siya'y nanalangin sa Panginoon ng buong paghihinagpis ng kaluluwa, at tumangis na mainam."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "1 Samuel 1:11",
              "text": "At siya'y nanata ng isang panata, at nagsabi, Oh Panginoon ng mga hukbo, kung tunay na iyong lilingunin ang pagkapighati ng iyong lingkod, at aalalahanin mo at hindi mo kalilimutan ang iyong lingkod, kundi iyong pagkakalooban ang iyong lingkod ng anak na lalake, ay akin ngang ibibigay sa Panginoon sa lahat ng kaarawan ng kaniyang buhay, at walang pangahit na daraan sa kaniyang ulo."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "1 Samuel 1:12",
              "text": "At nangyari, habang siya'y nananatili ng pananalangin sa harap ng Panginoon, ay pinagmamasdan ni Eli ang kaniyang bibig."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "1 Samuel 1:13",
              "text": "Si Ana nga'y nagsasalita sa kaniyang puso; ang kaniya lamang mga labi ang gumagalaw, nguni't ang kaniyang tinig ay hindi naririnig: kaya't inakala ni Eli na siya'y lasing."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "1 Samuel 1:14",
              "text": "At sinabi ni Eli sa kaniya, Hanggang kailan magiging lasing ka? ihiwalay mo ang iyong alak sa iyo."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "1 Samuel 1:15",
              "text": "At sumagot si Ana, at nagsabi, Hindi, panginoon ko, ako'y isang babae na may diwang mapanglaw: hindi ako nakainom ng alak o inuming nakalalasing, kundi aking inihayag ang aking kaluluwa sa harap ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "1 Samuel 1:16",
              "text": "Huwag mong ibilang na babaing hamak ang iyong lingkod: sapagka't sa kasaganaan ng aking daing at ng aking pagkaduwahagi ay nagsalita ako hanggang ngayon."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "1 Samuel 1:17",
              "text": "Nang magkagayo'y sumagot si Eli, at nagsabi, Yumaon kang payapa: at ipagkaloob nawa sa iyo ng Dios ng Israel ang iyong hiling na hinihingi mo sa kaniya."
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "1 Samuel 1:18",
              "text": "At sinabi niya, Makasumpong nawa ang iyong lingkod ng biyaya sa iyong paningin. Sa gayo'y nagpatuloy ng kaniyang lakad ang babae at kumain, at ang kaniyang mukha'y hindi na malumbay."
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "1 Samuel 1:19",
              "text": "At sila'y bumangong maaga ng kinaumagahan, at sumamba sa Panginoon, at bumalik, at umuwi sa kanilang bahay sa Ramatha; at nakilala ni Elcana si Ana na kaniyang asawa; at inalaala siya ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "1 Samuel 1:20",
              "text": "At nangyari, nang sumapit ang panahon, na si Ana ay naglihi, at nanganak ng isang lalake; at tinawag ang pangalan niya na Samuel, na sinasabi, Sapagka't aking hiningi siya sa Panginoon."
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "1 Samuel 1:21",
              "text": "At ang lalaking si Elcana, at ang buong sangbahayan niya, ay nagsiahon upang maghandog sa Panginoon ng hain sa taon-taon, at ganapin ang kaniyang panata."
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "1 Samuel 1:22",
              "text": "Nguni't si Ana ay hindi umahon; sapagka't sinabi niya sa kaniyang asawa, Hindi ako aahon hanggang sa ang bata'y mahiwalay sa suso; at kung magkagayo'y aking dadalhin siya, upang siya'y pakita sa harap ng Panginoon, at tumahan doon magpakailan man."
            },
            {
              "chapter": 1,
              "verse": 23,
              "name": "1 Samuel 1:23",
              "text": "At sinabi ni Elcana na kaniyang asawa sa kaniya, Gawin mo ang inaakala mong mabuti; maghintay ka hanggang sa maihiwalay mo siya sa suso; pagtibayin lamang ng Panginoon ang kaniyang salita. Sa gayo'y naghintay ang babae, at pinasuso ang kaniyang anak, hanggang sa naihiwalay niya sa suso."
            },
            {
              "chapter": 1,
              "verse": 24,
              "name": "1 Samuel 1:24",
              "text": "At nang kaniyang maihiwalay na sa suso, ay kaniyang iniahon, na may dala siyang tatlong guyang lalake, at isang epang harina, at isang sisidlang balat ng alak, at dinala niya siya sa bahay ng Panginoon sa Silo: at ang anak ay sanggol."
            },
            {
              "chapter": 1,
              "verse": 25,
              "name": "1 Samuel 1:25",
              "text": "At kanilang pinatay ang guyang lalake, at dinala ang bata kay Eli."
            },
            {
              "chapter": 1,
              "verse": 26,
              "name": "1 Samuel 1:26",
              "text": "At sinabi niya, Oh panginoon ko, alangalang sa buhay ng iyong kaluluwa, panginoon ko, ako ang babaing tumayo sa siping mo rito, na nanalangin sa Panginoon."
            },
            {
              "chapter": 1,
              "verse": 27,
              "name": "1 Samuel 1:27",
              "text": "Dahil sa batang ito ako nanalangin; at ipinagkaloob sa akin ng Panginoon ang aking hiling na aking hiningi sa kaniya:"
            },
            {
              "chapter": 1,
              "verse": 28,
              "name": "1 Samuel 1:28",
              "text": "Kaya't aking ipinagkakaloob naman sa Panginoon habang siya'y nabubuhay ay ipinagkakaloob ko siya sa Panginoon. At siya ay sumamba sa Panginoon doon."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "1 Samuel 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "1 Samuel 2:1",
              "text": "At si Ana ay nanalangin, at nagsabi: Nagagalak ang aking puso sa Panginoon; Ang aking sungay ay pinalaki ng Panginoon; Binigyan ako ng bibig sa aking mga kaaway; Sapagka't ako'y nagagalak sa iyong pagliligtas."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "1 Samuel 2:2",
              "text": "Walang banal na gaya ng Panginoon; Sapagka't walang iba liban sa iyo, Ni may bato mang gaya ng aming Dios."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "1 Samuel 2:3",
              "text": "Huwag na kayong magsalita ng totoong kapalaluan; Huwag mabuka ang kahambugan sa inyong bibig; Sapagka't ang Panginoon ay Dios ng kaalaman, At sa pamamagitan niya'y sinusukat ang mga kilos."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "1 Samuel 2:4",
              "text": "Ang mga busog ng mga makapangyarihang tao ay nasisira; At yaong nangatisod ay nabibigkisan ng kalakasan."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "1 Samuel 2:5",
              "text": "Yaong mga busog ay nagpaupa dahil sa tinapay; At yaong mga gutom ay hindi na gutom: Oo, ang baog ay nanganak ng pito; At yaong may maraming anak ay nanghihina."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "1 Samuel 2:6",
              "text": "Ang Panginoo'y pumapatay, at bumubuhay: Siya ang nagbababa sa Sheol, at nagsasampa."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "1 Samuel 2:7",
              "text": "Ang Panginoo'y nagpapadukha at nagpapayaman: Siya ang nagpapababa, at siya rin naman ang nagpapataas."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "1 Samuel 2:8",
              "text": "Kaniyang ibinabangon ang dukha mula sa alabok, Kaniyang itinataas ang mapagkailangan mula sa dumihan, Upang sila'y palukluking kasama ng mga prinsipe, At magmana ng luklukan ng kaluwalhatian: Sapagka't ang mga haligi ng lupa ay sa Panginoon, At kaniyang ipinatong ang sanglibutan sa kanila."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "1 Samuel 2:9",
              "text": "Kaniyang iingatan ang mga paa ng kaniyang mga banal; Nguni't ang masama ay patatahimikin sa mga kadiliman; Sapagka't sa pamamagitan ng kalakasan ay walang lalaking mananaig."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "1 Samuel 2:10",
              "text": "Yaong makipagkaalit sa Panginoon ay malalansag; Laban sa kanila'y kukulog siya mula sa langit: Ang Panginoon ang huhukom sa mga wakas ng lupa; At bibigyan niya ng kalakasan ang kaniyang hari, At palalakihin ang sungay ng kaniyang pinahiran ng langis."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "1 Samuel 2:11",
              "text": "At si Elcana ay umuwi sa Ramatha sa kaniyang bahay. At ang bata'y nangangasiwa sa Panginoon sa harap ni Eli na saserdote."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "1 Samuel 2:12",
              "text": "Ngayo'y ang mga anak ni Eli ay mga hamak na lalake; hindi nila nakikilala ang Panginoon."
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "1 Samuel 2:13",
              "text": "At ang kaugalian ng mga saserdote sa bayan, ay, na pagka ang sinoma'y naghahandog ng hain, lumalapit ang bataan ng saserdote, samantalang ang laman ay niluluto, na may hawak sa kamay na pang-ipit na may tatlong ngipin;"
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "1 Samuel 2:14",
              "text": "At kaniyang dinuduro sa kawali, o sa kaldera, o sa kaldero, o sa palyok; at lahat ng nadadala ng pang-ipit ay kinukuha ng saserdote para sa kaniya. Gayon ang ginagawa nila sa Silo sa lahat ng mga Israelita na naparoroon."
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "1 Samuel 2:15",
              "text": "Oo, bago nila sunugin ang taba, ay lumalapit ang bataan ng saserdote, at sinasabi sa lalake na naghahain, Magbigay ka ng lamang maiihaw para sa saserdote, sapagka't hindi siya tatanggap sa iyo ng lamang luto, kundi hilaw."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "1 Samuel 2:16",
              "text": "At kung sabihin ng lalake sa kaniya, Walang pagsalang kanila munang susunugin ang taba, at saka mo kunin kung gaano ang nasain ng iyong kaluluwa; kaniya ngang sinasabi, Hindi, kundi ibibigay mo sa akin ngayon: at kung hindi ay aking kukuning sapilitan."
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "1 Samuel 2:17",
              "text": "At ang kasalanan ng mga binatang yaon ay totoong malaki sa harap ng Panginoon; sapagka't niwawalan ng kabuluhan ng mga tao ang handog sa Panginoon."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "1 Samuel 2:18",
              "text": "Nguni't si Samuel ay nangangasiwa sa harap ng Panginoon, sa bagay ay bata pa, na may bigkis na isang kayong linong epod."
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "1 Samuel 2:19",
              "text": "Bukod sa rito'y iginagawa siya ng kaniyang ina ng isang munting balabal, at dinadala sa kaniya taon-taon, pagka siya'y umaahon na kasama ng kaniyang asawa upang maghandog ng hain sa taon-taon."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "1 Samuel 2:20",
              "text": "At binasbasan ni Eli si Elcana at ang kaniyang asawa, at sinabi, Bigyan ka nawa ng Panginoon ng binhi sa babaing ito sa lugar ng hingi na kaniyang hiningi sa Panginoon. At sila'y umuwi sa kanilang sariling bahay."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "1 Samuel 2:21",
              "text": "At dinalaw ng Panginoon si Ana, at siya'y naglihi, at nagkaanak ng tatlong lalake at dalawang babae. At ang batang si Samuel ay lumalaki sa harap ng Panginoon."
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "1 Samuel 2:22",
              "text": "Si Eli nga ay totoong matanda na; at kaniyang nababalitaan ang lahat ng ginagawa ng kaniyang mga anak sa buong Israel, at kung paanong sila'y sumisiping sa mga babae na naglilingkod sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 2,
              "verse": 23,
              "name": "1 Samuel 2:23",
              "text": "At sinabi niya sa kanila, Bakit ginagawa ninyo ang mga ganiyang bagay? sapagka't aking nababalitaan sa buong bayang ito ang inyong mga masamang kilos."
            },
            {
              "chapter": 2,
              "verse": 24,
              "name": "1 Samuel 2:24",
              "text": "Huwag, mga anak ko; sapagka't hindi mabuting balita ang aking naririnig: inyong pinasasalangsang ang bayan ng Panginoon."
            },
            {
              "chapter": 2,
              "verse": 25,
              "name": "1 Samuel 2:25",
              "text": "Kung ang isang tao ay magkasala laban sa iba, ay hahatulan siya ng Dios; nguni't kung ang isang tao ay magkasala laban sa Panginoon, sino ang mamamagitan sa kaniya? Gayon ma'y hindi nila dininig ang tinig ng kanilang ama, sapagka't inakalang patayin sila ng Panginoon."
            },
            {
              "chapter": 2,
              "verse": 26,
              "name": "1 Samuel 2:26",
              "text": "At ang batang si Samuel ay lumalaki, at kinalulugdan ng Panginoon at ng mga tao rin naman."
            },
            {
              "chapter": 2,
              "verse": 27,
              "name": "1 Samuel 2:27",
              "text": "At naparoon ang isang lalake ng Dios kay Eli, at sinabi sa kaniya, Ganito ang sabi ng Panginoon, Napakita ba ako ng hayag sa sangbahayan ng iyong ama, nang sila'y nasa Egipto sa pagkaalipin sa sangbahayan ni Faraon?"
            },
            {
              "chapter": 2,
              "verse": 28,
              "name": "1 Samuel 2:28",
              "text": "At pinili ko ba siya sa lahat ng mga lipi ng Israel upang maging saserdote ko, upang maghandog sa aking dambana, upang magsunog ng kamangyan, at upang magsuot ng epod sa harap ko? at ibinigay ko ba sa sangbahayan ng iyong ama ang lahat ng mga handog ng mga anak ni Israel na pinaraan sa apoy?"
            },
            {
              "chapter": 2,
              "verse": 29,
              "name": "1 Samuel 2:29",
              "text": "Bakit nga kayo'y tumututol sa aking hain at sa aking handog, na aking iniutos sa aking tahanan, at iyong pinararangalan ang iyong mga anak ng higit kaysa akin, upang kayo'y magpakataba sa mga pinakamainam sa lahat ng mga handog ng Israel na aking bayan?"
            },
            {
              "chapter": 2,
              "verse": 30,
              "name": "1 Samuel 2:30",
              "text": "Kaya't sinasabi ng Panginoon, ng Dios ng Israel, Aking sinabi nga na ang iyong sangbahayan, at ang sangbahayan ng iyong ama, ay lalakad sa harap ko magpakailan man: nguni't sinasabi ngayon ng Panginoon, Malayo sa akin; sapagka't yaong mga nagpaparangal sa akin ay aking pararangalin, at yaong mga humahamak sa akin ay mawawalan ng kabuluhan."
            },
            {
              "chapter": 2,
              "verse": 31,
              "name": "1 Samuel 2:31",
              "text": "Narito, ang mga araw ay dumarating, na aking ihihiwalay ang iyong bisig, at ang bisig ng sangbahayan ng iyong ama, upang huwag magkaroon ng matanda sa iyong sangbahayan."
            },
            {
              "chapter": 2,
              "verse": 32,
              "name": "1 Samuel 2:32",
              "text": "At iyong mamasdan ang kadalamhatian sa aking tahanan, sa buong kayamanan na ibibigay ng Dios sa Israel; at mawawalan ng matanda sa iyong sangbahayan magpakailan man."
            },
            {
              "chapter": 2,
              "verse": 33,
              "name": "1 Samuel 2:33",
