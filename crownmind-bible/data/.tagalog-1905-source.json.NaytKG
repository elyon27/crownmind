            {
              "chapter": 1,
              "verse": 12,
              "name": "2 Mga Cronica 1:12",
              "text": "Karunungan at kaalaman ay nabigay sa iyo; at bibigyan kita ng kayamanan, at pag-aari, at karangalan na walang hari na una sa iyo na nagkaroon ng ganyan, o sinoman ay magkakaroon ng gayong pagkamatay mo."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "2 Mga Cronica 1:13",
