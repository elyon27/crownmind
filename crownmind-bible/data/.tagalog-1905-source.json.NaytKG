            {
              "chapter": 48,
              "verse": 22,
              "name": "Genesis 48:22",
              "text": "Bukod dito'y binigyan kita ng isang bahaging higit kay sa iyong mga kapatid, na aking kinuha ng aking tabak at ng aking busog sa kamay ng Amorrheo."
