            {
              "chapter": 34,
              "verse": 27,
              "name": "Genesis 34:27",
              "text": "Nagsiparoon ang mga anak ni Jacob sa mga patay, at kanilang sinamsaman ang bayan, sapagka't kanilang dinahas ang kapatid nila."
