            {
              "chapter": 7,
              "verse": 20,
              "name": "Genesis 7:20",
              "text": "Labing limang siko ang lalim na idinagsa ng tubig; at inapawan ang mga bundok."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Genesis 7:21",
              "text": "At namatay ang lahat ng lamang gumagalaw sa ibabaw ng lupa, ang mga ibon at gayon din ang hayop, at ang hayop gubat, at ang bawa't nagsisiusad na umuusad sa ibabaw ng lupa, at ang bawa't tao."
            },
            {
              "chapter": 7,
              "verse": 22,
