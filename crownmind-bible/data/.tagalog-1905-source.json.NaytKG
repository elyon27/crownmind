            {
              "chapter": 31,
              "verse": 40,
              "name": "Genesis 31:40",
              "text": "Ganito nakaraan ako; sa araw ay pinupugnaw ako ng init, at ng lamig sa gabi; at ang pagaantok ay tumatakas sa aking mga mata."
