            {
              "chapter": 48,
              "verse": 6,
              "name": "Genesis 48:6",
              "text": "At ang iyong mga anak, na iyong mga naging anak na sumunod sa kanila ay magiging iyo; sila'y tatawagin ayon sa pangalan ng kanilang mga kapatid sa kanilang mana."
            },
            {
              "chapter": 48,
              "verse": 7,
              "name": "Genesis 48:7",
              "text": "At tungkol sa akin, nang ako'y dumating mula sa Padan, si Raquel ay namatay sa akin sa lupain ng Canaan sa daan, nang kulang pa ng kaunti upang dumating sa Ephrata: at aking inilibing siya roon sa daan ng Ephrata (na siya ring Bethlehem)."
            },
            {
              "chapter": 48,
              "verse": 8,
              "name": "Genesis 48:8",
              "text": "At nakita ni Israel ang mga anak ni Jose, at sinabi, Sino sino ito?"
            },
