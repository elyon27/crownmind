{
  "translation": "Ang Dating Biblia (1905)",
  "abbreviation": "tagalog",
  "description": "Philippine Bible Society (1905)",
  "lang": "tl",
  "language": "Tagalog",
  "direction": "LTR",
  "encoding": "UTF-8",
  "books": [
    {
      "nr": 1,
      "name": "Genesis",
      "chapters": [
        {
          "chapter": 1,
          "name": "Genesis 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Genesis 1:1",
              "text": "Nang pasimula ay nilikha ng Dios ang langit at ang lupa."
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Genesis 1:2",
              "text": "At ang lupa ay walang anyo at walang laman; at ang kadiliman ay sumasa ibabaw ng kalaliman; at ang Espiritu ng Dios ay sumasa ibabaw ng tubig."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Genesis 1:3",
              "text": "At sinabi ng Dios Magkaroon ng liwanag; at nagkaroon ng liwanag."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Genesis 1:4",
              "text": "At nakita ng Dios ang liwanag na mabuti, at inihiwalay ng Dios ang liwanag sa kadiliman."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Genesis 1:5",
              "text": "At tinawag ng Dios ang liwanag na Araw, at tinawag niya ang kadiliman na Gabi. At nagkahapon at nagkaumaga ang unang araw."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Genesis 1:6",
              "text": "At sinabi ng Dios, Magkaroon ng isang kalawakan sa gitna ng tubig, at mahiwalay ang tubig sa kapuwa tubig."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Genesis 1:7",
              "text": "At ginawa ng Dios ang kalawakan, at inihiwalay ang tubig na nasa ilalim ng kalawakan, sa tubig na nasa itaas ng kalawakan: at nagkagayon."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Genesis 1:8",
              "text": "At tinawag ng Dios ang kalawakan na Langit. At nagkahapon at nagkaumaga ang ikalawang araw."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Genesis 1:9",
              "text": "At sinabi ng Dios, Mapisan ang tubig na nasa silong ng langit sa isang dako, at lumitaw ang katuyuan, at nagkagayon."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Genesis 1:10",
              "text": "At tinawag ng Dios ang katuyuan na Lupa, at ang kapisanan ng tubig ay tinawag niyang mga Dagat: at nakita ng Dios na mabuti."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Genesis 1:11",
              "text": "At sinabi ng Dios, Sibulan ang lupa ng damo, pananim na nagkakabinhi, at punong kahoy na namumunga ayon sa kaniyang pagkakahoy, na taglay ang kaniyang binhi sa ibabaw ng lupa, at nagkagayon."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Genesis 1:12",
              "text": "At ang lupa ay sinibulan ng damo, pananim na nagkakabinhi, ayon sa kaniyang pagkapananim, at ng punong kahoy na namumunga, na taglay ang kaniyang binhi, ayon sa kaniyang pagkakahoy, at nakita ng Dios na mabuti."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Genesis 1:13",
              "text": "At nagkahapon at nagkaumaga ang ikatlong araw."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Genesis 1:14",
              "text": "At sinabi ng Dios, Magkaroon ng mga tanglaw sa kalawakan ng langit upang maghiwalay ng araw sa gabi; at maging pinakatanda, at pinakabahagi ng panahon, ng mga araw at ng mga taon:"
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Genesis 1:15",
              "text": "At maging pinakatanglaw sa kalawakan ng langit, upang tumanglaw sa ibabaw ng lupa: at nagkagayon."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Genesis 1:16",
              "text": "At nilikha ng Dios ang dalawang malaking tanglaw; ang malaking tanglaw ay upang magpuno sa araw, at ang maliit na tanglaw ay upang magpuno sa gabi: nilikha rin niya ang mga bituin."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Genesis 1:17",
              "text": "At mga inilagay ng Dios sa kalawakan ng langit, upang tumanglaw sa ibabaw ng lupa,"
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Genesis 1:18",
              "text": "At upang magpuno sa araw at sa gabi, at upang maghiwalay ng liwanag sa kadiliman: at nakita ng Dios na mabuti."
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "Genesis 1:19",
              "text": "At nagkahapon at nagkaumaga ang ikaapat na araw."
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "Genesis 1:20",
              "text": "At sinabi ng Dios, Bukalan ng sagana ang tubig ng mga gumagalaw na kinapal na may buhay, at magsilipad ang mga ibon sa itaas ng lupa sa luwal na kalawakan ng himpapawid."
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "Genesis 1:21",
              "text": "At nilikha ng Dios ang malalaking hayop sa dagat, at ang bawa't may buhay na kinapal na gumagalaw, na ibinukal na sagana ng tubig, ayon sa kanikaniyang uri at ang lahat na may pakpak na ibon, ayon sa kanikaniyang uri: at nakita ng Dios na mabuti."
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "Genesis 1:22",
              "text": "At mga binasbasan ng Dios, na sinabi, Kayo'y magpalaanakin, at magpakarami, at inyong punuin ang tubig sa mga dagat, at magpakarami ang mga ibon sa lupa."
            },
            {
              "chapter": 1,
              "verse": 23,
              "name": "Genesis 1:23",
              "text": "At nagkahapon at nagkaumaga ang ikalimang araw."
            },
            {
              "chapter": 1,
              "verse": 24,
              "name": "Genesis 1:24",
              "text": "At sinabi ng Dios, Bukalan ang lupa ng mga may buhay na kinapal, ayon sa kanikaniyang uri ng hayop at ng mga kinapal na umuusad, at ng mga ganid sa lupa, ayon sa kanikaniyang uri: at nagkagayon."
            },
            {
              "chapter": 1,
              "verse": 25,
              "name": "Genesis 1:25",
              "text": "At nilikha ng Dios ang ganid sa lupa ayon sa kaniyang uri, at ang hayop ayon sa kaniyang uri, at ang bawa't umuusad sa ibabaw ng lupa ayon sa kanikaniyang uri: at nakita ng Dios na mabuti."
            },
            {
              "chapter": 1,
              "verse": 26,
              "name": "Genesis 1:26",
              "text": "At sinabi ng Dios, Lalangin natin ang tao sa ating larawan, ayon sa ating wangis: at magkaroon sila ng kapangyarihan sa mga isda sa dagat, at sa mga ibon sa himpapawid, at sa mga hayop, at sa buong lupa, at sa bawa't umuusad, na nagsisiusad sa ibabaw ng lupa."
            },
            {
              "chapter": 1,
              "verse": 27,
              "name": "Genesis 1:27",
              "text": "At nilalang ng Dios ang tao ayon sa kaniyang sariling larawan, ayon sa larawan ng Dios siya nilalang; nilalang niya sila na lalake at babae."
            },
            {
              "chapter": 1,
              "verse": 28,
              "name": "Genesis 1:28",
              "text": "At sila'y binasbasan ng Dios, at sa kanila'y sinabi ng Dios, Kayo'y magpalaanakin, at magpakarami, at kalatan ninyo ang lupa, at inyong supilin; at magkaroon kayo ng kapangyarihan sa mga isda sa dagat, at sa mga ibon sa himpapawid, at sa bawa't hayop na gumagalaw sa ibabaw ng lupa."
            },
            {
              "chapter": 1,
              "verse": 29,
              "name": "Genesis 1:29",
              "text": "At sinabi ng Dios, Narito, ibinigay ko sa inyo ang bawa't pananim na nagkakabinhi, na nasa ibabaw ng balat ng lupa, at ang bawa't punong kahoy na may bunga ng punong kahoy na nagkakabinhi; sa inyo'y magiging pagkain:"
            },
            {
              "chapter": 1,
              "verse": 30,
              "name": "Genesis 1:30",
              "text": "At sa bawa't hayop sa lupa, at sa bawa't ibon sa himpapawid; at sa bawa't nagsisiusad sa ibabaw ng lupa na may buhay ay ibinigay ko ang lahat na pananim na sariwa na pinakapagkain; at nagkagayon."
            },
            {
              "chapter": 1,
              "verse": 31,
              "name": "Genesis 1:31",
              "text": "At nakita ng Dios ang lahat ng kaniyang nilikha, at, narito, napakabuti. At nagkahapon at nagkaumaga ang ikaanim na araw."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Genesis 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Genesis 2:1",
              "text": "At nayari ang langit at ang lupa, at ang lahat na natatanaw sa mga iyon."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Genesis 2:2",
              "text": "At nang ikapitong araw ay nayari ng Dios ang kaniyang gawang ginawa; at nagpahinga ng ikapitong araw sa madlang gawa niyang ginawa."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Genesis 2:3",
              "text": "At binasbasan ng Dios ang ikapitong araw at kaniyang ipinangilin, sapagka't siyang ipinagpahinga ng Dios sa madlang gawang kaniyang nilikha at ginawa."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Genesis 2:4",
              "text": "Ito ang pinangyarihan ng langit at ng lupa, nang likhain noong araw, na gawin ng Panginoong Dios ang lupa't langit."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Genesis 2:5",
              "text": "At wala pa sa lupang kahoy sa parang, at wala pang anomang pananim na tumutubo sa parang: (sapagka't hindi pa pinauulanan ng Panginoong Dios ang lupa) at wala pang taong magbukid ng lupa,"
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Genesis 2:6",
              "text": "Nguni't may isang ulap na napaitaas buhat sa lupa at dinilig ang buong ibabaw ng lupa."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Genesis 2:7",
              "text": "At nilalang ng Panginoong Dios ang tao sa alabok ng lupa, at hiningahan ang kaniyang mga butas ng ilong ng hininga ng buhay; at ang tao ay naging kaluluwang may buhay."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Genesis 2:8",
              "text": "At naglagay ang Panginoong Dios ng isang halamanan sa Eden, sa dakong silanganan: at inilagay niya roon ang taong kaniyang nilalang."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Genesis 2:9",
              "text": "At pinatubo ng Panginoong Dios sa lupa ang lahat na punong kahoy na nakalulugod sa paningin, at mabubuting kanin; gayon din ang punong kahoy ng buhay sa gitna ng halamanan, at ang punong kahoy ng pagkakilala ng mabuti at masama."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Genesis 2:10",
              "text": "At may isang ilog na lumabas sa Eden na dumilig sa halamanan; at mula roo'y nabahagi at nagapat na sanga."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Genesis 2:11",
              "text": "Ang pangalan ng una ay Pison: na siyang lumiligid sa buong lupain ng Havilah, na doo'y may ginto;"
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Genesis 2:12",
              "text": "At ang ginto sa lupang yao'y mabuti; mayroon din naman doong bedelio at batong onix."
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Genesis 2:13",
              "text": "At ang pangalan ng ikalawang ilog ay Gihon; na siyang lumiligid sa buong lupain ng Cush."
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Genesis 2:14",
              "text": "At ang pangalan ng ikatlong ilog ay Hiddecel, na siyang umaagos sa tapat ng Asiria. At ang ikaapat na ilog ay ang Eufrates."
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Genesis 2:15",
              "text": "At kinuha ng Panginoong Dios ang lalake at inilagay sa halamanan ng Eden, upang kaniyang alagaan at ingatan."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Genesis 2:16",
              "text": "At iniutos ng Panginoong Dios sa lalake, na sinabi, Sa lahat ng punong kahoy sa halamanan ay makakakain ka na may kalayaan:"
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Genesis 2:17",
              "text": "Datapuwa't sa kahoy ng pagkakilala ng mabuti at masama ay huwag kang kakain; sapagka't sa araw na ikaw ay kumain niyaon ay walang pagsalang mamamatay ka."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "Genesis 2:18",
              "text": "At sinabi ng Panginoong Dios, Hindi mabuti na ang lalake ay magisa; siya'y ilalalang ko ng isang katulong niya."
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "Genesis 2:19",
              "text": "At nilalang ng Panginoong Dios sa lupa ang lahat ng hayop sa parang at ang lahat ng ibon sa himpapawid; at pinagdadala sa lalake upang maalaman kung anong itatawag niya sa mga iyon: at ang bawa't itinawag ng lalake sa bawa't kinapal na may buhay ay yaon ang naging pangalan niyaon."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "Genesis 2:20",
              "text": "At pinanganlan ng lalake ang lahat ng mga hayop, at ang mga ibon sa himpapawid, at ang bawa't ganid sa parang; datapuwa't sa lalake ay walang nasumpungang maging katulong niya."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "Genesis 2:21",
              "text": "At hinulugan ng Panginoong Dios ng di kawasang himbing ang lalake, at siya'y natulog: at kinuha ang isa sa kaniyang mga tadyang at pinapaghilom ang laman sa dakong yaon:"
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "Genesis 2:22",
              "text": "At ang tadyang na kinuha ng Panginoong Dios sa lalake ay ginawang isang babae, at ito'y dinala niya sa lalake."
            },
            {
              "chapter": 2,
              "verse": 23,
              "name": "Genesis 2:23",
              "text": "At sinabi ng lalake, Ito nga'y buto ng aking mga buto at laman ng aking laman: siya'y tatawaging Babae, sapagka't sa Lalake siya kinuha."
            },
            {
              "chapter": 2,
              "verse": 24,
              "name": "Genesis 2:24",
              "text": "Kaya't iiwan ng lalake ang kaniyang ama at ang kaniyang ina, at makikipisan sa kaniyang asawa: at sila'y magiging isang laman."
            },
            {
              "chapter": 2,
              "verse": 25,
              "name": "Genesis 2:25",
              "text": "At sila'y kapuwa hubad, ang lalake at ang kaniyang asawa, at sila'y hindi nagkakahiyaan."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Genesis 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Genesis 3:1",
              "text": "Ang ahas nga ay lalong tuso kay sa alin man sa mga hayop sa parang na nilikha ng Panginoong Dios. At sinabi niya sa babae, Tunay bang sinabi ng Dios, Huwag kayong kakain sa alin mang punong kahoy sa halamanan?"
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Genesis 3:2",
              "text": "At sinabi ng babae sa ahas, Sa bunga ng mga punong kahoy sa halamanan ay makakakain kami:"
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Genesis 3:3",
              "text": "Datapuwa't sa bunga ng punong kahoy na nasa gitna ng halamanan ay sinabi ng Dios, Huwag kayong kakain niyaon, ni huwag ninyong hihipuin, baka kayo'y mamatay."
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Genesis 3:4",
              "text": "At sinabi ng ahas sa babae, Tunay na hindi kayo mamamatay:"
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Genesis 3:5",
              "text": "Sapagka't talastas ng Dios na sa araw na kayo'y kumain niyaon ay madidilat nga ang inyong mga mata, at kayo'y magiging parang Dios, na nakakakilala ng mabuti at masama."
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Genesis 3:6",
              "text": "At nang makita ng babae, na ang bunga ng punong kahoy ay mabuting kanin, at nakalulugod sa mga mata, at kahoy na mananasa upang magpapantas sa tao, ay pumitas siya ng bunga niyaon at kinain; at binigyan din niya ang kaniyang asawang kasama niya, at ito'y kumain."
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Genesis 3:7",
              "text": "At nadilat kapuwa ang kanilang mga mata, at kanilang nakilalang sila'y mga hubad; at sila'y tumahi ng mga dahon ng puno ng igos, at kanilang ginawang panapi."
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Genesis 3:8",
              "text": "At narinig nila ang tinig ng Panginoong Dios na lumalakad sa halamanan sa kulimlim ng araw: at nagtago ang lalake at ang kaniyang asawa sa harapan ng Panginoong Dios sa pagitan ng mga punong kahoy sa halamanan."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Genesis 3:9",
              "text": "At tinawag ng Panginoong Dios ang lalake at sa kaniya'y sinabi, Saan ka naroon?"
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Genesis 3:10",
              "text": "At sinabi niya, Narinig ko ang iyong tinig sa halamanan, at ako'y natakot, sapagka't ako'y hubad; at ako'y nagtago."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Genesis 3:11",
              "text": "At sinabi niya, Sinong nagsabi sa iyong ikaw ay hubad? nakakain ka ba ng bunga ng punong kahoy, na iniutos ko sa iyong huwag mong kanin?"
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Genesis 3:12",
              "text": "At sinabi ng lalake, Ang babaing ibinigay mong aking kasamahin, ay siyang nagbigay sa akin ng bunga ng punong kahoy at aking kinain."
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Genesis 3:13",
              "text": "At sinabi ng Panginoong Dios sa babae, Ano itong iyong ginawa? At sinabi ng babae, Dinaya ako ng ahas, at ako'y kumain."
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Genesis 3:14",
              "text": "At sinabi ng Panginoong Dios sa ahas, Sapagka't ginawa mo ito, ay sumpain ka ng higit sa lahat ng hayop, at ng higit sa bawa't ganid sa parang; ang iyong tiyan ang ilalakad mo, at alabok ang iyong kakanin sa lahat ng mga araw ng iyong buhay:"
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Genesis 3:15",
              "text": "At papagaalitin ko ikaw at ang babae, at ang iyong binhi at ang kaniyang binhi: ito ang dudurog ng iyong ulo, at ikaw ang dudurog ng kaniyang sakong."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Genesis 3:16",
              "text": "Sinabi niya sa babae, Pararamihin kong lubha ang iyong kalumbayan at ang iyong paglilihi; manganganak kang may kahirapan; at sa iyong asawa ay pahihinuhod ang iyong kalooban, at siya'y papapanginoon sa iyo."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Genesis 3:17",
              "text": "At kay Adam ay sinabi, Sapagka't iyong dininig ang tinig ng iyong asawa, at kumain ka ng bunga ng punong kahoy na aking iniutos sa iyo na sinabi, Huwag kang kakain niyaon; sumpain ang lupa dahil sa iyo; kakain ka sa kaniya sa pamamagitan ng iyong pagpapagal sa lahat ng mga araw ng iyong buhay;"
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "Genesis 3:18",
              "text": "Ang isisibol niyaon sa iyo ay mga tinik at mga dawag; at kakain ka ng pananim sa parang;"
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "Genesis 3:19",
              "text": "Sa pawis ng iyong mukha ay kakain ka ng tinapay, hanggang sa ikaw ay mauwi sa lupa; sapagka't diyan ka kinuha: sapagka't ikaw ay alabok at sa alabok ka uuwi."
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "Genesis 3:20",
              "text": "At tinawag na Eva ng lalake ang kaniyang asawa, sapagka't siya ang naging ina ng lahat ng mga nabubuhay."
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Genesis 3:21",
              "text": "At iginawa ng Panginoong Dios si Adam at ang kaniyang asawa ng mga kasuutang balat at sila'y dinamitan."
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Genesis 3:22",
              "text": "At sinabi ng Panginoong Dios, Narito't ang tao'y naging parang isa sa atin, na nakakakilala ng mabuti at ng masama; at baka ngayo'y iunat ang kaniyang kamay at pumitas naman ng bunga ng punong kahoy ng buhay, at kumain at mabuhay magpakailan man:"
            },
            {
              "chapter": 3,
              "verse": 23,
              "name": "Genesis 3:23",
              "text": "Kaya pinalayas siya ng Panginoong Dios sa halamanan ng Eden, upang kaniyang bukirin ang lupaing pinagkunan sa kaniya."
            },
            {
              "chapter": 3,
              "verse": 24,
              "name": "Genesis 3:24",
              "text": "Ano pa't itinaboy ang lalake; at inilagay sa silanganan ng halamanan ng Eden ang mga Querubin at ang isang nagniningas na tabak na umiikot, upang ingatan ang daang patungo sa kahoy ng buhay."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Genesis 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Genesis 4:1",
              "text": "At nakilala ng lalake si Eva na kaniyang asawa; at siya'y naglihi at ipinanganak si Cain, at sinabi, Nagkaanak ako ng lalake sa tulong ng Panginoon."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Genesis 4:2",
              "text": "At sa muli ay ipinanganak ang kaniyang kapatid na si Abel. At si Abel ay tagapagalaga ng mga tupa; datapuwa't si Cain ay mangbubukid ng lupa."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Genesis 4:3",
              "text": "At nangyari nang lumalakad ang panahon ay nagdala si Cain ng isang handog na mga bunga ng lupa sa Panginoon."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Genesis 4:4",
              "text": "At nagdala rin naman si Abel ng mga panganay ng kaniyang kawan at ng mga taba ng mga yaon. At nilingap ng Panginoon si Abel at ang kaniyang handog:"
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Genesis 4:5",
              "text": "Datapuwa't hindi nilingap si Cain at ang kaniyang handog. At naginit na mainam si Cain, at namanglaw ang kaniyang mukha."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Genesis 4:6",
              "text": "At sinabi ng Panginoon kay Cain, Bakit ka naginit? at bakit namanglaw ang iyong mukha?"
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Genesis 4:7",
              "text": "Kung ikaw ay gumawa ng mabuti, di ba ikaw mamarapatin? at kung hindi ka gumawa ng mabuti, ay nahahandusay ang kasalanan sa pintuan: at sa iyo'y pahihinuhod ang kaniyang nasa, at ikaw ang papanginoonin niya."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Genesis 4:8",
              "text": "At yao'y sinabi ni Cain sa kaniyang kapatid na kay Abel. At nangyari, nang sila'y nasa parang ay nagtindig si Cain laban kay Abel na kaniyang kapatid, at siya'y kaniyang pinatay."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Genesis 4:9",
              "text": "At sinabi ng Panginoon kay Cain, Saan naroon si Abel na iyong kapatid? At sinabi niya, Aywan ko: ako ba'y tagapagbantay sa aking kapatid?"
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Genesis 4:10",
              "text": "At sinabi niya, Anong iyong ginawa? ang tinig ng dugo ng iyong kapatid ay dumadaing sa akin mula sa lupa."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Genesis 4:11",
              "text": "At ngayo'y sinumpa ka sa lupa na siyang nagbuka ng bibig na tumanggap sa iyong kamay ng dugo ng iyong kapatid;"
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Genesis 4:12",
              "text": "Pagbubukid mo ng lupa, ay di na ibibigay mula ngayon sa iyo ang kaniyang lakas; ikaw ay magiging palaboy at hampas-lupa sa lupa."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Genesis 4:13",
              "text": "At sinabi ni Cain sa Panginoon, Ang aking kaparusahan ay higit kaysa mababata ko."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Genesis 4:14",
              "text": "Narito, ako'y iyong itinataboy ngayon mula sa ibabaw ng lupa, at sa iyong harapan ay magtatago ako; at ako'y magiging palaboy at hampaslupa; at mangyayari, na sinomang makasumpong sa akin ay papatayin ako."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Genesis 4:15",
              "text": "At sinabi sa kaniya ng Panginoon, Dahil dito'y sinomang pumatay kay Cain ay makapitong gagantihan. At nilagyan ng Panginoon ng isang tanda si Cain, baka siya'y sugatan ng sinomang makakasumpong sa kaniya."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Genesis 4:16",
              "text": "At umalis si Cain sa harapan ng Panginoon at tumahan sa lupain ng Nod, sa silanganan ng Eden."
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Genesis 4:17",
              "text": "At nakilala ni Cain ang kaniyang asawa, at siya'y naglihi at ipinanganak si Enoc: at siya'y nagtayo ng isang bayan at tinawag ang bayan ayon sa pangalan ng kaniyang anak, Enoc."
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Genesis 4:18",
              "text": "At naging anak ni Enoc si Irad; at naging anak ni Irad si Mehujael; at naging anak ni Mehujael si Metusael; at naging anak ni Metusael si Lamec."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Genesis 4:19",
              "text": "At si Lamec ay nagasawa ng dalawa; ang pangalan ng isa'y Ada, at ang pangalan ng ikalawa ay Zilla."
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Genesis 4:20",
              "text": "At naging anak ni Ada si Jabal: na siyang naging magulang ng nangagsisitahan sa mga tolda at may mga hayop."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Genesis 4:21",
              "text": "At ang pangalan ng kaniyang kapatid ay Jubal: na siyang naging magulang ng lahat na tumutugtog ng alpa at ng flauta."
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "Genesis 4:22",
              "text": "At tungkol kay Zilla, ay ipinanganak naman niya si Tubal-Cain na mamamanday ng lahat na kagamitang patalim na tanso at bakal: at ang kapatid na babae ni Tubal-Cain ay si Naama."
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "Genesis 4:23",
              "text": "At sinabi ni Lamec sa kaniyang mga asawa: Ada at Zilla pakinggan ninyo ang aking tinig: Kayong mga asawa ni Lamec ay makinig ng aking salaysay: Sapagka't pumatay ako ng isang tao, dahil sa ako'y sinugatan, At ng isang binata, dahil sa ako'y hinampas."
            },
            {
              "chapter": 4,
              "verse": 24,
              "name": "Genesis 4:24",
              "text": "Kung makapitong gagantihan si Cain, tunay na si Lamec ay makapitong pung pito."
            },
            {
              "chapter": 4,
              "verse": 25,
              "name": "Genesis 4:25",
              "text": "At nakilalang muli ni Adam ang kaniyang asawa; at nanganak ng isang lalake, at tinawag ang kaniyang pangalan na Set; sapagka't aniya'y binigyan ako ng Dios ng ibang anak na kahalili ni Abel; sapagka't siya'y pinatay ni Cain."
            },
            {
              "chapter": 4,
              "verse": 26,
              "name": "Genesis 4:26",
              "text": "At nagkaanak naman si Set ng isang lalake; at tinawag ang kaniyang pangalan na Enos. Noon ay pinasimulan ng mga tao ang pagtawag sa pangalan ng Panginoon."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Genesis 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Genesis 5:1",
              "text": "Ito ang aklat ng mga lahi ni Adam. Nang araw na lalangin ng Dios ang tao, sa wangis ng Dios siya nilalang;"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Genesis 5:2",
              "text": "Lalake at babae silang nilalang; at sila'y binasbasan, at tinawag na Adam ang kanilang pangalan, nang araw na sila'y lalangin."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Genesis 5:3",
              "text": "At nabuhay si Adam ng isang daan at tatlong pung taon, at nagkaanak ng isang lalaking kaniyang wangis na hawig sa kaniyang larawan; at tinawag ang kaniyang pangalan na Set:"
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Genesis 5:4",
              "text": "At ang mga naging araw ni Adam, pagkatapos na maipanganak si Set, ay walong daang taon: at nagkaanak ng mga lalake at mga babae."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Genesis 5:5",
              "text": "At ang lahat na araw na ikinabuhay ni Adam ay siyam na raan at tatlong pung taon; at siya'y namatay."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Genesis 5:6",
              "text": "At nabuhay si Set ng isang daan at limang taon at naging anak niya si Enos."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Genesis 5:7",
              "text": "At nabuhay si Set pagkatapos na maipanganak si Enos ng walong daan at pitong taon; at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Genesis 5:8",
              "text": "At ang lahat na naging araw ni Set ay siyam na raan at labing dalawang taon: at siya'y namatay."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Genesis 5:9",
              "text": "At nabuhay si Enos ng siyam na pung taon, at naging anak si Cainan:"
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Genesis 5:10",
              "text": "At nabuhay si Enos, pagkatapos na maipanganak si Cainan, ng walong daan at labing limang taon; at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Genesis 5:11",
              "text": "At ang lahat na naging araw ni Enos ay siyam na raan at limang taon, at siya'y namatay."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Genesis 5:12",
              "text": "At nabuhay si Cainan ng pitong pung taon, at naging anak si Mahalaleel:"
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Genesis 5:13",
              "text": "At nabuhay si Cainan, pagkatapos na maipanganak si Mahalaleel, ng walong daan at apat na pung taon, at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Genesis 5:14",
              "text": "At ang lahat na naging araw ni Cainan, siyam na raan at sangpung taon, at namatay."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Genesis 5:15",
              "text": "At nabuhay si Mahalaleel ng anim na pu't limang taon, at naging anak si Jared:"
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Genesis 5:16",
              "text": "At nabuhay si Mahalaleel, pagkatapos na maipanganak si Jared, ng walong daan at tatlong pung taon, at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Genesis 5:17",
              "text": "At ang lahat na naging araw ni Mahalaleel ay walong daan at siyam na pu't limang taon: at namatay."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Genesis 5:18",
              "text": "At nabuhay si Jared ng isang daan at anim na pu't dalawang taon, at naging anak si Enoc:"
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Genesis 5:19",
              "text": "At nabuhay si Jared, pagkatapos na maipanganak si Enoc, ng walong daang taon, at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Genesis 5:20",
              "text": "At ang lahat na naging araw ni Jared ay siyam na raan at anim na pu't dalawang taon: at namatay."
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Genesis 5:21",
              "text": "At nabuhay si Enoc na anim na pu't limang taon, at naging anak si Matusalem:"
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Genesis 5:22",
              "text": "At lumakad si Enoc na kasama ng Dios, pagkatapos na maipanganak si Matusalem na tatlong daang taon, at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Genesis 5:23",
              "text": "At ang lahat na naging araw ni Enoc ay tatlong daan at anim na pu't limang taon:"
            },
            {
              "chapter": 5,
              "verse": 24,
              "name": "Genesis 5:24",
              "text": "At lumakad si Enoc na kasama ng Dios: at di siya nasumpungan, sapagka't kinuha ng Dios."
            },
            {
              "chapter": 5,
              "verse": 25,
              "name": "Genesis 5:25",
              "text": "At nabuhay si Matusalem ng isang daan at walong pu't pitong taon; at naging anak si Lamec:"
            },
            {
              "chapter": 5,
              "verse": 26,
              "name": "Genesis 5:26",
              "text": "At nabuhay si Matusalem pagkatapos na maipanganak si Lamec, ng pitong daan at walong pu't dalawang taon; at nagkaanak ng mga lalake at mga babae;"
            },
            {
              "chapter": 5,
              "verse": 27,
              "name": "Genesis 5:27",
              "text": "At ang lahat na naging araw ni Matusalem ay siyam na raan at anim na pu't siyam na taon: at siya'y namatay."
            },
            {
              "chapter": 5,
              "verse": 28,
              "name": "Genesis 5:28",
              "text": "At nabuhay si Lamec ng isang daan at walong pu't dalawang taon, at nagkaanak ng isang lalake:"
            },
            {
              "chapter": 5,
              "verse": 29,
              "name": "Genesis 5:29",
              "text": "At tinawag ang kaniyang pangalan na Noe, na sinabi, Ito nga ang aaliw sa atin tungkol sa ating gawa at sa pinagpagalan ng ating mga kamay, dahil sa lupang sinumpa ng Panginoon."
            },
            {
              "chapter": 5,
              "verse": 30,
              "name": "Genesis 5:30",
              "text": "At nabuhay si Lamec, pagkatapos na maipanganak si Noe, ng limang daan at siyam na pu't limang taon, at nagkaanak ng mga lalake at mga babae:"
            },
            {
              "chapter": 5,
              "verse": 31,
              "name": "Genesis 5:31",
              "text": "At ang lahat na naging araw ni Lamec ay pitong daan at pitong pu't pitong taon: at namatay."
            },
            {
              "chapter": 5,
              "verse": 32,
              "name": "Genesis 5:32",
              "text": "At si Noe ay may limang daang taon: at naging anak ni Noe si Sem, si Cham, at si Japhet."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Genesis 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Genesis 6:1",
              "text": "At nangyari, nang magpasimula na dumami ang mga tao sa balat ng lupa, at mangagkaanak ng mga babae,"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Genesis 6:2",
              "text": "Na nakita ng mga anak ng Dios, na magaganda ang mga anak na babae ng mga tao; at sila'y nangagsikuha ng kanikaniyang asawa sa lahat ng kanilang pinili."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Genesis 6:3",
              "text": "At sinabi ng Panginoon, Ang aking Espiritu ay hindi makikipagpunyagi sa tao magpakailan man, sapagka't siya ma'y laman: gayon ma'y magiging isang daan at dalawang pung taon ang kaniyang mga araw."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Genesis 6:4",
              "text": "Ang mga higante ay nasa lupa ng mga araw na yaon, at pagkatapos din naman na makasiping ang mga anak ng Dios sa mga anak na babae ng tao, at mangagkaanak sila sa kanila: ang mga ito rin ang naging makapangyarihan nang unang panahon na mga lalaking bantog."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Genesis 6:5",
              "text": "At nakita ng Panginoon na mabigat ang kasamaan ng tao sa lupa, at ang buong haka ng mga pagiisip ng kaniyang puso ay pawang masama lamang na parati."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Genesis 6:6",
              "text": "At nagsisi ang Panginoon na kaniyang nilalang ang tao sa lupa, at nalumbay sa kaniyang puso."
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Genesis 6:7",
              "text": "At sinabi ng Panginoon, Lilipulin ko ang tao na aking nilalang sa ibabaw ng lupa; ang tao at gayon din ang hayop, at ang mga umuusad at ang mga ibon sa himpapawid; sapagka't pinagsisisihan ko na aking nilalang sila."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Genesis 6:8",
              "text": "Datapuwa't si Noe ay nakasumpong ng biyaya sa mga mata ng Panginoon."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Genesis 6:9",
              "text": "Ito ang mga lahi ni Noe. Si Noe ay lalaking matuwid at sakdal noong kapanahunan niya: si Noe ay lumalakad na kasama ng Dios."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Genesis 6:10",
              "text": "At nagkaanak si Noe ng tatlong lalake: si Sem, si Cham, at si Japhet."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Genesis 6:11",
              "text": "At sumama ang lupa sa harap ng Dios, at ang lupa ay napuno ng karahasan."
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Genesis 6:12",
              "text": "At tiningnan ng Dios ang lupa, at, narito sumama; sapagka't pinasama ng lahat ng tao ang kanilang paglakad sa ibabaw ng lupa."
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Genesis 6:13",
              "text": "At sinabi ng Dios kay Noe, Ang wakas ng lahat ng tao ay dumating sa harap ko; sapagka't ang lupa ay napuno ng karahasan dahil sa kanila; at, narito, sila'y aking lilipuling kalakip ng lupa."
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Genesis 6:14",
              "text": "Gumawa ka ng isang sasakyang kahoy na gofer; gagawa ka ng mga silid sa sasakyan, at iyong sisiksikan sa loob at sa labas ng sahing."
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Genesis 6:15",
              "text": "At ganitong paraan gagawin mo: tatlong daang siko ang haba ng sasakyan, limang pung siko ang luwang, at tatlong pung siko ang taas."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Genesis 6:16",
              "text": "Gagawa ka ng isang durungawan sa sasakyan; at wawakasan mo ng isang siko sa dakong itaas; at ang pintuan ng sasakyan ay ilalagay mo sa tagiliran; gagawin mong may lapag na lalong mababa, pangalawa at pangatlo."
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Genesis 6:17",
              "text": "At ako, narito, ako'y magpapadagsa ng isang baha ng tubig sa ibabaw ng lupa, upang lipulin sa silong ng langit ang lahat ng laman na may hininga ng buhay; ang lahat na nasa lupa ay mangamamatay."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Genesis 6:18",
              "text": "Datapuwa't pagtitibayin ko ang aking tipan sa iyo; at ikaw ay lululan sa sasakyan, ikaw, at ang iyong mga anak na lalake, at ang iyong asawa, at ang mga asawa ng iyong mga anak na kasama mo."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Genesis 6:19",
              "text": "At sa bawa't nangabubuhay, sa lahat ng laman ay maglululan ka sa loob ng sasakyan ng dalawa sa bawa't uri upang maingatan silang buhay, na kasama mo; lalake at babae ang kinakailangan."
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "Genesis 6:20",
              "text": "Sa mga ibon ayon sa kanikanilang uri, at sa mga hayop ayon sa kanikanilang uri, sa bawa't nagsisiusad, ayon sa kanikanilang uri, dalawa sa bawa't uri, ay isasama mo sa iyo, upang maingatan silang buhay."
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "Genesis 6:21",
              "text": "At magbaon ka ng lahat na pagkain na kinakain, at imbakin mo sa iyo; at magiging pagkain mo at nila."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "Genesis 6:22",
              "text": "Gayon ginawa ni Noe; ayon sa lahat na iniutos sa kaniya ng Dios, ay gayon ang ginawa niya."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Genesis 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Genesis 7:1",
              "text": "At sinabi ng Panginoon kay Noe, Lumulan ka at ang iyong buong sangbahayan sa sasakyan; sapagka't ikaw ay aking nakitang matuwid sa harap ko sa panahong ito."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Genesis 7:2",
              "text": "Sa bawa't malinis na hayop ay kukuha ka ng tigpipito, ng lalake at ng kaniyang babae; at sa mga hayop na hindi malinis ay dalawa, ng lalake at ng kaniyang babae;"
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Genesis 7:3",
              "text": "Gayon din naman sa mga ibon sa himpapawid tigpipito, ng lalake at ng babae; upang ingatang binhing buhay sa ibabaw ng buong lupa."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Genesis 7:4",
              "text": "Sapagka't pitong araw pa, at pauulanan ko na ang ibabaw ng lupa ng apat na pung araw at apat na pung gabi, at aking lilipulin ang lahat ng may buhay na aking nilikha sa balat ng lupa."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Genesis 7:5",
              "text": "At ginawa ni Noe ayon sa lahat na iniutos sa kaniya ng Panginoon."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Genesis 7:6",
              "text": "At may anim na raang taon si Noe nang ang baha ng tubig ay dumagsa sa ibabaw ng lupa."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Genesis 7:7",
              "text": "At lumulan sa sasakyan si Noe at ang kaniyang mga anak, at ang kaniyang asawa, at ang mga asawa ng kaniyang mga anak, dahil sa tubig ng baha."
