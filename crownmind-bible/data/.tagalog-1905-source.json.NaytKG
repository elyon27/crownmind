            },
            {
              "chapter": 29,
              "verse": 32,
              "name": "Mga Bilang 29:32",
              "text": "At sa ikapitong araw ay pitong toro, dalawang tupang lalake, labing apat na korderong lalake ng unang taon na walang kapintasan:"
            },
            {
              "chapter": 29,
              "verse": 33,
              "name": "Mga Bilang 29:33",
              "text": "At ang handog na harina ng mga yaon, at ang mga inuming handog para sa mga toro, sa mga tupang lalake, at sa mga kordero, ayon sa kanilang bilang, alinsunod sa palatuntunan:"
            },
            {
              "chapter": 29,
              "verse": 34,
              "name": "Mga Bilang 29:34",
              "text": "At isang kambing na lalake na pinakahandog dahil sa kasalanan; bukod pa sa palaging handog na susunugin, sa handog na harina niyaon, at sa inuming handog niyaon."
            },
            {
              "chapter": 29,
              "verse": 35,
              "name": "Mga Bilang 29:35",
              "text": "Sa ikawalong araw, ay magkakaroon kayo ng isang takdang pagpupulong; huwag kayong gagawa ng anomang gawang paglilingkod;"
            },
            {
              "chapter": 29,
              "verse": 36,
              "name": "Mga Bilang 29:36",
              "text": "Kundi kayo'y maghahandog ng isang handog na susunugin, na isang handog na pinaraan sa apoy na pinakamasarap na amoy sa Panginoon: isang toro, isang tupang lalake, pitong korderong lalake ng unang taon, na walang kapintasan:"
            },
            {
              "chapter": 29,
              "verse": 37,
              "name": "Mga Bilang 29:37",
              "text": "Ang handog na harina ng mga yaon at ang mga inuming handog para sa toro, sa lalaking tupa, at sa mga kordero, ayon sa kanilang bilang alinsunod sa palatuntunan:"
            },
            {
              "chapter": 29,
              "verse": 38,
              "name": "Mga Bilang 29:38",
              "text": "At isang kambing na lalake na pinakahandog dahil sa kasalanan; bukod pa sa palaging handog na susunugin, at sa handog na harina niyaon, at sa inuming handog niyaon."
            },
            {
              "chapter": 29,
              "verse": 39,
              "name": "Mga Bilang 29:39",
              "text": "Ang mga ito ay inyong ihahandog sa Panginoon sa inyong mga takdang kapistahan, bukod pa sa inyong mga panata, at sa inyong mga kusang handog, na mga pinakahandog ninyong susunugin, at ang inyong mga pinakahandog na harina, at ang inyong mga pinakainuming handog, at ang inyong mga pinakahandog tungkol sa kapayapaan."
            },
            {
              "chapter": 29,
              "verse": 40,
              "name": "Mga Bilang 29:40",
              "text": "At isinaysay ni Moises sa mga anak ni Israel, ayon sa lahat ng iniutos ng Panginoon kay Moises."
            }
          ]
        },
        {
          "chapter": 30,
          "name": "Mga Bilang 30",
          "verses": [
            {
              "chapter": 30,
              "verse": 1,
              "name": "Mga Bilang 30:1",
              "text": "At sinalita ni Moises sa mga pangulo ng mga lipi ng mga anak ni Israel, na sinasabi, Ito ang bagay na iniutos ng Panginoon."
            },
            {
              "chapter": 30,
              "verse": 2,
              "name": "Mga Bilang 30:2",
              "text": "Pagka ang isang lalake ay nagpanata ng isang panata sa Panginoon, o sumumpa ng isang sumpa, na itinali ang kaniyang kaluluwa sa isang gampanin, ay huwag niyang sisirain ang kaniyang salita, kaniyang gaganapin ayon sa lahat ng binuka ng kaniyang bibig."
            },
            {
              "chapter": 30,
              "verse": 3,
              "name": "Mga Bilang 30:3",
              "text": "Pagka ang isang babae naman ay nagpanata ng isang panata sa Panginoon, at itinali ang kaniyang sarili sa isang gampanin, sa bahay ng kaniyang ama, sa kaniyang kadalagahan;"
            },
            {
              "chapter": 30,
              "verse": 4,
              "name": "Mga Bilang 30:4",
              "text": "At narinig ng kaniyang ama ang kaniyang panata, at ang kaniyang gampanin na kaniyang itinali sa kaniyang kaluluwa, at ang kaniyang ama ay hindi umimik sa kaniya: ay lahat nga niyang panata ay magkakabisa, at ang bawa't tali na kaniyang itinali sa kaniyang kaluluwa ay magkakabisa."
            },
            {
              "chapter": 30,
              "verse": 5,
              "name": "Mga Bilang 30:5",
              "text": "Nguni't kung sawayin siya ng kaniyang ama sa araw na marinig; alin man sa kaniyang panata, o sa kaniyang gampanin na kaniyang itinali sa kaniyang kaluluwa ay hindi magkabisa: at patatawarin siya ng Panginoon, sapagka't sinaway siya ng kaniyang ama."
            },
            {
              "chapter": 30,
              "verse": 6,
              "name": "Mga Bilang 30:6",
              "text": "At kung siya'y may asawa at magpanata o magbitiw na walang dilidili sa kaniyang labi ng anomang gampanin na kaniyang itinali sa kaniyang kaluluwa;"
            },
            {
              "chapter": 30,
              "verse": 7,
              "name": "Mga Bilang 30:7",
              "text": "At marinig ng kaniyang asawa, at hindi umimik sa kaniya sa araw na marinig yaon: ay magkakabisa nga ang kaniyang mga panata, at ang kaniyang mga gampanin na kaniyang itinali sa kaniyang kaluluwa ay magkakabisa."
            },
            {
              "chapter": 30,
              "verse": 8,
              "name": "Mga Bilang 30:8",
              "text": "Nguni't kung sawayin siya ng kaniyang asawa sa araw na marinig yaon; ay mawawalan ng kabuluhan ang kaniyang panata na itinali niya sa kaniya at ang nabitawang pangako ng kaniyang mga labi na ipinanali niya sa kaniyang kaluluwa: at patatawarin siya ng Panginoon."
            },
            {
              "chapter": 30,
              "verse": 9,
              "name": "Mga Bilang 30:9",
              "text": "Nguni't ang panata ng isang babaing bao, o ng isang hiniwalayan ng asawa, ay magkakabisa sa bawa't bagay na kaniyang itinali sa kaniyang kaluluwa."
            },
            {
              "chapter": 30,
              "verse": 10,
              "name": "Mga Bilang 30:10",
              "text": "At kung siya'y nagpanata sa bahay ng kaniyang asawa, o kaniyang tinalian ang kaniyang kaluluwa ng isang gampanin na kaakbay ng isang sumpa,"
            },
            {
              "chapter": 30,
              "verse": 11,
              "name": "Mga Bilang 30:11",
              "text": "At narinig ng kaniyang asawa, at hindi umimik sa kaniya, at hindi sinaway siya; ay magkakabisa ang lahat niyang panata, at bawa't gampanin na kaniyang itinali sa kaniyang kaluluwa ay magkakabisa."
            },
            {
              "chapter": 30,
              "verse": 12,
              "name": "Mga Bilang 30:12",
              "text": "Nguni't kung niwalan ng kabuluhan ng kaniyang asawa sa araw na marinig, ay hindi magkakabisa ang anomang bagay na binitiwan ng kaniyang mga labi tungkol sa kaniyang mga panata o tungkol sa tali ng kaniyang kaluluwa: niwalan ng kabuluhan ng kaniyang asawa; at patatawarin siya ng Panginoon."
            },
            {
              "chapter": 30,
              "verse": 13,
              "name": "Mga Bilang 30:13",
              "text": "Bawa't panata o bawa't gampaning inakbayan ng sumpa, na makapagpapadalamhati ng kaluluwa, ay mabibigyang bisa ng kaniyang asawa, o mapawawalan ng kabuluhan ng kaniyang asawa."
            },
            {
              "chapter": 30,
              "verse": 14,
              "name": "Mga Bilang 30:14",
              "text": "Nguni't kung ang kaniyang asawa ay hindi umimik sa kaniya sa araw-araw; ay binigyan nga ng bisa ang lahat niyang panata, o ang lahat niyang gampaning taglay niya: kaniyang binigyan bisa, sapagka't hindi umimik nang araw na kaniyang marinig."
            },
            {
              "chapter": 30,
              "verse": 15,
              "name": "Mga Bilang 30:15",
              "text": "Nguni't kung kaniyang pawawalan ng kabuluhan pagkatapos na kaniyang marinig, ay tataglayin nga niya ang kasamaan ng kaniyang asawa."
            },
            {
              "chapter": 30,
              "verse": 16,
              "name": "Mga Bilang 30:16",
              "text": "Ito ang mga palatuntunan na iniutos ng Panginoon kay Moises, sa magasawa at sa magama samantalang ang anak na dalaga ay nasa bahay ng kaniyang ama."
            }
          ]
        },
        {
          "chapter": 31,
          "name": "Mga Bilang 31",
          "verses": [
            {
              "chapter": 31,
              "verse": 1,
              "name": "Mga Bilang 31:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 31,
              "verse": 2,
              "name": "Mga Bilang 31:2",
              "text": "Ipanghiganti mo ang mga anak ni Israel sa mga Madianita; pagkatapos nito'y malalakip ka sa iyong bayan."
            },
            {
              "chapter": 31,
              "verse": 3,
              "name": "Mga Bilang 31:3",
              "text": "At sinalita ni Moises sa bayan, na sinasabi, Magsipagsakbat kayong mga lalake na humanda sa pakikibaka, upang magsiyaon sila laban sa Madian, upang isagawa ang panghihiganti ng Panginoon sa Madian."
            },
            {
              "chapter": 31,
              "verse": 4,
              "name": "Mga Bilang 31:4",
              "text": "Sa bawa't lipi ay isang libo, sa lahat ng mga lipi ng Israel, ang susuguin ninyo sa pakikibaka."
            },
            {
              "chapter": 31,
              "verse": 5,
              "name": "Mga Bilang 31:5",
              "text": "Sa gayo'y sinugo sa libolibong Israelita, ang isang libo sa bawa't lipi, na labing dalawang libo ngang nasasakbatan sa pakikibaka."
            },
            {
              "chapter": 31,
              "verse": 6,
              "name": "Mga Bilang 31:6",
              "text": "At sinugo sila ni Moises, sa pakikibaka, isang libo sa bawa't lipi, sila at si Phinees na anak ni Eleazar na saserdote, sa pakikibaka, na may mga kasangkapan ng santuario, at may mga pakakak na panghudyat sa kaniyang kamay."
            },
            {
              "chapter": 31,
              "verse": 7,
              "name": "Mga Bilang 31:7",
              "text": "At binaka nila ang Madian, gaya ng iniutos ng Panginoon kay Moises; at kanilang pinatay ang bawa't lalake."
            },
            {
              "chapter": 31,
              "verse": 8,
              "name": "Mga Bilang 31:8",
              "text": "At pinatay nila ang mga hari sa Madian na kasama ng mga napatay: si Evi at si Recem, at si Zur, at si Hur, at si Reba, limang hari sa Madian: si Balaam man na anak ni Beor ay kanilang pinatay ng tabak."
            },
            {
              "chapter": 31,
              "verse": 9,
              "name": "Mga Bilang 31:9",
              "text": "At binihag ng mga anak ng Israel ang mga babae sa Madian at ang kanilang mga bata; at ang lahat nilang mga hayop at ang lahat nilang mga kawan, at ang lahat nilang pag-aari ay kanilang sinamsam."
            },
            {
              "chapter": 31,
              "verse": 10,
              "name": "Mga Bilang 31:10",
              "text": "At ang lahat nilang mga bayan sa mga dakong kanilang tinatahanan at ang lahat nilang mga tolda ay kanilang sinunog sa apoy."
            },
            {
              "chapter": 31,
              "verse": 11,
              "name": "Mga Bilang 31:11",
              "text": "At kanilang dinala ang lahat ng kanilang nakuha, at ang lahat ng kanilang nasamsam, maging sa tao at maging sa hayop."
            },
            {
              "chapter": 31,
              "verse": 12,
              "name": "Mga Bilang 31:12",
              "text": "At kanilang dinala ang mga bihag, ang nasamsam at ang nahuli, kay Moises, at kay Eleazar na saserdote, at sa kapisanan ng mga anak ni Israel, na nasa kampamento sa mga kapatagan ng Moab, na nasa tabi ng Jordan sa Jerico."
            },
            {
              "chapter": 31,
              "verse": 13,
              "name": "Mga Bilang 31:13",
              "text": "At si Moises at si Eleazar na saserdote, at ang lahat ng mga prinsipe sa kapisanan, ay nagsilabas na sinalubong sila sa labas ng kampamento."
            },
            {
              "chapter": 31,
              "verse": 14,
              "name": "Mga Bilang 31:14",
              "text": "At si Moises ay nag-init sa mga pinuno ng hukbo, sa mga kapitan ng libolibo at sa mga kapitan ng daandaan, na nagsipanggaling sa pakikipagbaka."
            },
            {
              "chapter": 31,
              "verse": 15,
              "name": "Mga Bilang 31:15",
              "text": "At sinabi ni Moises sa kanila, Iniligtas ba ninyo na buhay ang lahat ng mga babae?"
            },
            {
              "chapter": 31,
              "verse": 16,
              "name": "Mga Bilang 31:16",
              "text": "Narito, sila'y naging sanhi, sa payo ni Balaam, upang ang mga anak ni Israel ay sumalangsang laban sa Panginoon sa bagay ng Peor, at kaya't nagkasalot sa kapisanan ng Panginoon."
            },
            {
              "chapter": 31,
              "verse": 17,
              "name": "Mga Bilang 31:17",
              "text": "Ngayon nga ay patayin ninyo ang lahat ng mga batang lalake at patayin ninyo ang bawa't babae na nasipingan ng lalake."
            },
            {
              "chapter": 31,
              "verse": 18,
              "name": "Mga Bilang 31:18",
              "text": "Nguni't ang lahat ng batang babae na hindi pa nasisipingan ng lalake ay buhayin ninyo upang mapasa inyo."
            },
            {
              "chapter": 31,
              "verse": 19,
              "name": "Mga Bilang 31:19",
              "text": "At matira kayo sa labas ng kampamento na pitong araw: sinoman sa inyo na nakamatay ng sinomang tao, at sinoman sa inyo na nakahipo ng anomang pinatay, ay maglilinis kayo sa ikatlong araw at sa ikapitong araw, kayo at ang inyong mga bihag."
            },
            {
              "chapter": 31,
              "verse": 20,
              "name": "Mga Bilang 31:20",
              "text": "At tungkol sa bawa't kasuutan, at sa lahat ng yari sa balat, at sa lahat ng yari sa balahibo ng kambing, at sa lahat ng bagay na yari sa kahoy, ay pakalinisin ninyo."
            },
            {
              "chapter": 31,
              "verse": 21,
              "name": "Mga Bilang 31:21",
              "text": "At sinabi ni Eleazar na saserdote sa mga lalake ng hukbo na nagsiparoon sa pakikipagbaka, Ito ang palatuntunan ng kautusan na iniutos ng Panginoon kay Moises:"
            },
            {
              "chapter": 31,
              "verse": 22,
              "name": "Mga Bilang 31:22",
              "text": "Gayon ma'y ang ginto at ang pilak, ang tanso, ang bakal, ang lata, at ang tingga,"
            },
            {
              "chapter": 31,
              "verse": 23,
              "name": "Mga Bilang 31:23",
              "text": "Bawa't bagay na hindi naaano sa apoy, ay inyong pararaanin sa apoy, at magiging malinis; gayon ma'y inyong lilinisin ng tubig para sa karumihan: at ang lahat na hindi nakatatagal sa apoy, ay inyong pararaanin sa tubig."
            },
            {
              "chapter": 31,
              "verse": 24,
              "name": "Mga Bilang 31:24",
              "text": "At inyong lalabhan ang inyong mga damit sa ikapitong araw, at kayo'y magiging malinis, at pagkatapos nito'y makapapasok kayo sa kampamento."
            },
            {
              "chapter": 31,
              "verse": 25,
              "name": "Mga Bilang 31:25",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 31,
              "verse": 26,
              "name": "Mga Bilang 31:26",
              "text": "Bilangin mo ang samsam na nakuha sa tao at gayon din sa hayop, ninyo at ni Eleazar na saserdote, at ng mga pangulo ng mga sangbahayan ng mga magulang ng kapisanan:"
            },
            {
              "chapter": 31,
              "verse": 27,
              "name": "Mga Bilang 31:27",
              "text": "At hatiin mo ang samsam ng dalawa; sa mga lalaking mangbabaka na nagsilabas sa pakikipagbaka, at sa buong kapisanan:"
            },
            {
              "chapter": 31,
              "verse": 28,
              "name": "Mga Bilang 31:28",
              "text": "Bigyan mo ng buwis ang Panginoon sa mga lalaking mangdidigma na nagsilabas sa pakikipagbaka: isang tao sa bawa't limang daan, sa mga tao at gayon din sa mga hayop, at sa mga asno at sa mga kawan:"
            },
            {
              "chapter": 31,
              "verse": 29,
              "name": "Mga Bilang 31:29",
              "text": "Sa kalahating nauukol sa kanila, ay kukunin mo at ibibigay mo kay Eleazar na saserdote na pinakahandog na itinaas sa Panginoon."
            },
            {
              "chapter": 31,
              "verse": 30,
              "name": "Mga Bilang 31:30",
              "text": "At sa kalahati na nauukol sa mga anak ni Israel, ay kunin mo ang isang nakuha sa bawa't limang pu, sa mga tao, sa mga bata, sa mga asno, at sa mga kawan, sa lahat ng hayop at ibigay mo sa mga Levita, na namamahala sa tabernakulo ng Panginoon."
            },
            {
              "chapter": 31,
              "verse": 31,
              "name": "Mga Bilang 31:31",
              "text": "At ginawa ni Moises at ni Eleazar na saserdote, gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 31,
              "verse": 32,
              "name": "Mga Bilang 31:32",
              "text": "Ang nabihag nga bukod pa sa nasamsam ng mga taong nakipagbaka, ay anim na raan at pitong pu't limang libong tupa,"
            },
            {
              "chapter": 31,
              "verse": 33,
              "name": "Mga Bilang 31:33",
              "text": "At pitong pu't dalawang libong baka,"
            },
            {
              "chapter": 31,
              "verse": 34,
              "name": "Mga Bilang 31:34",
              "text": "Anim na pu't isang libong asno,"
            },
            {
              "chapter": 31,
              "verse": 35,
              "name": "Mga Bilang 31:35",
              "text": "At tatlong pu't dalawang libong tao sa lahat, sa mga babae na hindi pa nasisipingan ng lalake."
            },
            {
              "chapter": 31,
              "verse": 36,
              "name": "Mga Bilang 31:36",
              "text": "At ang kalahati, na siyang bahagi niyaong mga nagsilabas sa pakikipagbaka ay umaabot sa bilang na tatlong daan at tatlong pu't pitong libo at limang daang tupa:"
            },
            {
              "chapter": 31,
              "verse": 37,
              "name": "Mga Bilang 31:37",
              "text": "At ang buwis na tupa sa Panginoon, ay anim na raan at pitong pu't lima."
            },
            {
              "chapter": 31,
              "verse": 38,
              "name": "Mga Bilang 31:38",
              "text": "At ang mga baka ay tatlong pu't anim na libo; na ang buwis sa Panginoon ay pitong pu't dalawa."
            },
            {
              "chapter": 31,
              "verse": 39,
              "name": "Mga Bilang 31:39",
              "text": "At ang mga asno ay tatlong pung libo at limang daan; na ang buwis sa Panginoon ay anim na pu't isa."
            },
            {
              "chapter": 31,
              "verse": 40,
              "name": "Mga Bilang 31:40",
              "text": "At ang mga asno ay labing anim na libo; na ang buwis sa Panginoon ay tatlong pu't dalawang tao."
            },
            {
              "chapter": 31,
              "verse": 41,
              "name": "Mga Bilang 31:41",
              "text": "At ibinigay ni Moises ang buwis, na ukol sa handog na itinaas sa Panginoon, kay Eleazar na saserdote, gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 31,
              "verse": 42,
              "name": "Mga Bilang 31:42",
              "text": "At ang kalahati ay sa mga anak ni Israel, na inihiwalay ni Moises sa mga taong nakipagbaka"
            },
            {
              "chapter": 31,
              "verse": 43,
              "name": "Mga Bilang 31:43",
              "text": "(Siya ngang kalahati na nauukol sa kapisanan ay tatlong daan at tatlong pu't pitong libo at limang daang tupa,"
            },
            {
              "chapter": 31,
              "verse": 44,
              "name": "Mga Bilang 31:44",
              "text": "At tatlong pu't anim na libong baka,"
            },
            {
              "chapter": 31,
              "verse": 45,
              "name": "Mga Bilang 31:45",
              "text": "At tatlong pung libo't limang daang asno,"
            },
            {
              "chapter": 31,
              "verse": 46,
              "name": "Mga Bilang 31:46",
              "text": "At labing anim na libong tao),"
            },
            {
              "chapter": 31,
              "verse": 47,
              "name": "Mga Bilang 31:47",
              "text": "At sa kalahati nga na nauukol sa mga anak ni Israel, ay kinuha ni Moises ang isa sa bawa't limang pu, sa tao at gayon din sa hayop, at ibinigay sa mga Levita, na namamahala sa tabernakulo ng Panginoon; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 31,
              "verse": 48,
              "name": "Mga Bilang 31:48",
              "text": "At ang mga pinuno na namamahala sa libolibo ng hukbo, ang mga kapitan ng libolibo, at ang mga kapitan ng daandaan ay nangagsilapit kay Moises:"
            },
            {
              "chapter": 31,
              "verse": 49,
              "name": "Mga Bilang 31:49",
              "text": "At sinabi nila kay Moises, Binilang ng iyong mga lingkod ang mga lalaking mangdidigma na nasa aming kapangyarihan, at walang kulang kahit isa man sa amin."
            },
            {
              "chapter": 31,
              "verse": 50,
              "name": "Mga Bilang 31:50",
              "text": "At aming dinala na pinakaalay sa Panginoon, ang nakuha ng bawa't lalake, na mga hiyas na ginto, mga tanikala sa bukongbukong, at mga pulsera, mga singsing na pinaka tanda, mga hikaw, at mga kuwintas sa leeg upang itubos sa aming mga kaluluwa sa harap ng Panginoon."
            },
            {
              "chapter": 31,
              "verse": 51,
              "name": "Mga Bilang 31:51",
              "text": "At kinuha ni Moises at ni Eleazar na saserdote ang ginto nila, lahat ng hiyas na dalisay."
            },
            {
              "chapter": 31,
              "verse": 52,
              "name": "Mga Bilang 31:52",
              "text": "At ang buong gintong handog na itinaas, na kanilang inihandog sa Panginoon, ng mga kapitan ng libolibo, at ng mga kapitan ng daandaan, ay labing anim na libo at pitong daan at limang pung siklo."
            },
            {
              "chapter": 31,
              "verse": 53,
              "name": "Mga Bilang 31:53",
              "text": "(Sapagka't ang mga lalake na nakipagbaka ay naguwi ng samsam, na bawa't isa ay may sariling dala.)"
            },
            {
              "chapter": 31,
              "verse": 54,
              "name": "Mga Bilang 31:54",
              "text": "At kinuha ni Moises at ni Eleazar na saserdote ang ginto ng mga kapitan ng libolibo at ng daandaan, at isinilid sa tabernakulo ng kapisanan, pinakaalaala sa mga anak ni Israel sa harap ng Panginoon."
            }
          ]
        },
        {
          "chapter": 32,
          "name": "Mga Bilang 32",
          "verses": [
            {
              "chapter": 32,
              "verse": 1,
              "name": "Mga Bilang 32:1",
              "text": "Ang mga anak nga ni Ruben, at ang mga anak ni Gad ay mayroong napakaraming hayop: at nang kanilang makita ang lupain ng Jazer, at ang lupain ng Galaad, na, narito, ang dako ay minagaling nilang dako sa hayop,"
            },
            {
              "chapter": 32,
              "verse": 2,
              "name": "Mga Bilang 32:2",
              "text": "Ay lumapit at nagsalita ang mga anak ni Gad at ang mga anak ni Ruben kay Moises, at kay Eleazar na saserdote, at sa mga prinsipe ng kapisanan na sinasabi,"
            },
            {
              "chapter": 32,
              "verse": 3,
              "name": "Mga Bilang 32:3",
              "text": "Ang Ataroth, at ang Dibon, at ang Jazer, at ang Nimra, at ang Hesbon, at ang Eleale, at ang Saban, at ang Nebo, at ang Beon,"
            },
            {
              "chapter": 32,
              "verse": 4,
              "name": "Mga Bilang 32:4",
              "text": "Na lupaing sinaktan ng Panginoon sa harap ng kapisanan ng Israel, ay lupaing mabuti sa hayop, at ang iyong mga lingkod ay may mga hayop."
            },
            {
              "chapter": 32,
              "verse": 5,
              "name": "Mga Bilang 32:5",
              "text": "At sinabi nila, Kung kami ay nakasumpong ng biyaya sa iyong paningin, ay ibigay mong pinakaari ang lupaing ito sa iyong mga lingkod; at huwag mo kaming paraanin sa Jordan."
            },
            {
              "chapter": 32,
              "verse": 6,
              "name": "Mga Bilang 32:6",
              "text": "At sinabi ni Moises sa mga anak ni Gad, at sa mga anak ni Ruben, Paroroon ba ang inyong mga kapatid sa pakikipagbaka, at kayo'y mauupo rito?"
            },
            {
              "chapter": 32,
              "verse": 7,
              "name": "Mga Bilang 32:7",
              "text": "At bakit pinapanghihina ninyo ang loob ng mga anak ni Israel, na huwag magpatuloy sa lupain na ibinigay ng Panginoon sa kanila?"
            },
            {
              "chapter": 32,
              "verse": 8,
              "name": "Mga Bilang 32:8",
              "text": "Ganyan ang ginawa ng inyong mga magulang nang sila'y aking suguin, mula sa Cades-barnea upang tiktikan ang lupain."
            },
            {
              "chapter": 32,
              "verse": 9,
              "name": "Mga Bilang 32:9",
              "text": "Sapagka't nang sila'y makasampa sa libis ng Eskol at matiktikan ang lupain, ay kanilang pinapanghina ang loob ng mga anak ni Israel upang huwag pumasok sa lupain na ibinigay ng Panginoon sa kanila."
            },
            {
              "chapter": 32,
              "verse": 10,
              "name": "Mga Bilang 32:10",
              "text": "At ang galit ng Panginoon ay nagningas nang araw na yaon, at siya'y sumumpa na sinasabi,"
            },
            {
              "chapter": 32,
              "verse": 11,
              "name": "Mga Bilang 32:11",
              "text": "Tunay na walang taong lumabas sa Egipto, mula sa dalawang pung taong gulang na patanda, ay makakakita ng lupain na aking isinumpa kay Abraham, kay Isaac, at kay Jacob; sapagka't sila'y hindi lubos na sumunod sa akin:"
            },
            {
              "chapter": 32,
              "verse": 12,
              "name": "Mga Bilang 32:12",
              "text": "Liban si Caleb na anak ni Jephone na Cenezeo, at si Josue na anak ni Nun: sapagka't sila'y sumunod na lubos sa Panginoon."
            },
            {
              "chapter": 32,
              "verse": 13,
              "name": "Mga Bilang 32:13",
              "text": "At ang galit ng Panginoon ay nagningas laban sa Israel, at kaniyang pinagala sila sa ilang, na apat na pung taon hanggang sa ang buong lahing yaon na gumawa ng masama sa paningin ng Panginoon, ay nalipol."
            },
            {
              "chapter": 32,
              "verse": 14,
              "name": "Mga Bilang 32:14",
              "text": "At, narito, kayo'y nagsipagtindig na kahalili ng inyong mga magulang, supling ng mga taong makasalanan, upang dagdagan pa ninyo ang mabangis na galit ng Panginoon sa Israel."
            },
            {
              "chapter": 32,
              "verse": 15,
              "name": "Mga Bilang 32:15",
              "text": "Sapagka't kung kayo'y lumihis ng pagsunod sa kaniya ay kaniyang iiwang muli sila sa ilang; at inyong lilipulin ang buong bayang ito."
            },
            {
              "chapter": 32,
              "verse": 16,
              "name": "Mga Bilang 32:16",
              "text": "At sila'y nagsilapit sa kaniya, at nagsabi, Gagawa kami rito ng mga kulungan sa aming mga hayop, at ng mga bayan sa aming mga bata:"
            },
            {
              "chapter": 32,
              "verse": 17,
              "name": "Mga Bilang 32:17",
              "text": "Nguni't kami ay magsisipagalmas upang magpauna sa mga anak ni Israel hanggang sa aming maipasok sa kanilang dakong karoroonan: at ang aming mga bata ay magsisitahan sa mga bayang nakukutaan dahil sa mga nagsisitahan sa lupain."
            },
            {
              "chapter": 32,
              "verse": 18,
              "name": "Mga Bilang 32:18",
              "text": "Kami ay hindi magsisibalik sa aming mga bahay, hanggang sa ang mga anak ni Israel ay magari bawa't isa ng kaniyang sariling pag-aari."
            },
            {
              "chapter": 32,
              "verse": 19,
              "name": "Mga Bilang 32:19",
              "text": "Sapagka't hindi kami makikimana sa kanila sa kabilang ibayo ng Jordan, at sa dako pa roon; sapagka't tinaglay na namin ang aming mana rito sa dakong silanganan ng Jordan."
            },
            {
              "chapter": 32,
              "verse": 20,
              "name": "Mga Bilang 32:20",
              "text": "At sinabi ni Moises sa kanila, Kung gagawin ninyo ang bagay na ito; kung kayo'y magsisipagalmas upang pumaroon sa harap ng Panginoon sa pakikipagbaka,"
            },
            {
              "chapter": 32,
              "verse": 21,
              "name": "Mga Bilang 32:21",
              "text": "At bawa't may almas sa inyo ay daraan sa Jordan sa harap ng Panginoon, hanggang sa kaniyang mapalayas ang kaniyang mga kaaway sa harap niya."
            },
            {
              "chapter": 32,
              "verse": 22,
              "name": "Mga Bilang 32:22",
              "text": "At ang lupain ay mapasuko sa harap ng Panginoon: ay makababalik nga kayo pagkatapos, at hindi kayo magiging salarin sa Panginoon, at sa Israel; at ang lupaing ito ay magiging inyong pag-aari sa harap ng Panginoon."
            },
            {
              "chapter": 32,
              "verse": 23,
              "name": "Mga Bilang 32:23",
              "text": "Nguni't kung hindi ninyo gagawing ganito ay, narito, kayo'y nagkasala laban sa Panginoon: at talastasin ninyo na aabutin kayo ng inyong kasalanan."
            },
            {
              "chapter": 32,
              "verse": 24,
              "name": "Mga Bilang 32:24",
              "text": "Igawa ninyo ng mga siyudad ang inyong mga bata, at ng mga kulungan ang inyong mga tupa; at isagawa ninyo ang nabuka sa inyong bibig."
            },
            {
              "chapter": 32,
              "verse": 25,
              "name": "Mga Bilang 32:25",
              "text": "At sinalita ng mga anak ni Gad at ng mga anak ni Ruben kay Moises, na sinasabi, Isasagawa ng iyong mga lingkod ang gaya ng iniutos ng aking panginoon."
            },
            {
              "chapter": 32,
              "verse": 26,
              "name": "Mga Bilang 32:26",
              "text": "Ang aming mga bata, ang aming mga asawa, ang aming kawan at ang aming buong bakahan ay matitira riyan sa mga bayan ng Galaad:"
            },
            {
              "chapter": 32,
              "verse": 27,
              "name": "Mga Bilang 32:27",
              "text": "Nguni't ang iyong mga lingkod ay magsisitawid, bawa't lalake na may almas sa pakikipagbaka, sa harap ng Panginoon upang makipagbaka, gaya ng sinabi ng aking panginoon."
            },
            {
              "chapter": 32,
              "verse": 28,
              "name": "Mga Bilang 32:28",
              "text": "Sa gayo'y ipinagbilin sila ni Moises kay Eleazar na saserdote, at kay Josue na anak ni Nun, at sa mga pangulo sa mga sangbahayan ng mga magulang ng mga lipi ng mga anak ni Israel."
            },
            {
              "chapter": 32,
              "verse": 29,
              "name": "Mga Bilang 32:29",
              "text": "At sinabi sa kanila ni Moises, Kung ang mga anak ni Gad at ang mga anak ni Ruben ay magsisitawid na kasama ninyo sa Jordan, ang lahat ng lalake na may almas sa pakikipagbaka, sa harap ng Panginoon, at kung ang lupain ay mapasuko sa harap ninyo: ay ibibigay nga ninyo sa kanila na pinakaari ang lupain ng Galaad."
            },
            {
              "chapter": 32,
              "verse": 30,
              "name": "Mga Bilang 32:30",
              "text": "Nguni't kung sila'y hindi tatawid na kasama ninyo na may almas, ay magkakaroon sila ng pag-aari na kasama ninyo sa lupain ng Canaan."
            },
            {
              "chapter": 32,
              "verse": 31,
              "name": "Mga Bilang 32:31",
              "text": "At ang mga anak ni Gad at ang mga anak ni Ruben ay nagsisagot, na nangagsasabi, Kung paano ang sinabi ng Panginoon sa iyong mga lingkod ay gayon ang gagawin namin,"
            },
            {
              "chapter": 32,
              "verse": 32,
              "name": "Mga Bilang 32:32",
              "text": "Kami ay tatawid na may almas sa harap ng Panginoon sa lupain ng Canaan, at ang magiging pag-aari naming mana ay sa dakong ito ng Jordan."
            },
            {
              "chapter": 32,
              "verse": 33,
              "name": "Mga Bilang 32:33",
              "text": "At ibinigay ni Moises sa kanila, sa mga anak ni Gad, at sa mga anak ni Ruben, at sa kalahati ng lipi ni Manases na anak ni Jose, ang kaharian ni Sehon na hari ng mga Amorrheo, at ang kaharian ni Og na hari sa Basan, ang lupain ayon sa mga bayan niyaon, sa loob ng mga hangganan niyaon, sa makatuwid baga'y ang mga bayan sa palibot ng lupain."
            },
            {
              "chapter": 32,
              "verse": 34,
              "name": "Mga Bilang 32:34",
              "text": "At itinayo ng mga anak ni Gad ang Dibon, at ang Ataroth, at ang Aroer,"
            },
            {
              "chapter": 32,
              "verse": 35,
              "name": "Mga Bilang 32:35",
              "text": "At ang Ataroth-sophan, at ang Jazer, at ang Jogbaa,"
            },
            {
              "chapter": 32,
              "verse": 36,
              "name": "Mga Bilang 32:36",
              "text": "At ang Beth-nimra at ang Bet-haran: na mga bayang nakukutaan, at kulungan din naman ng mga tupa."
            },
            {
              "chapter": 32,
              "verse": 37,
              "name": "Mga Bilang 32:37",
              "text": "At itinayo naman ng mga anak ni Ruben ang Hesbon, at ang Eleale, at ang Ciriathaim,"
            },
            {
              "chapter": 32,
              "verse": 38,
              "name": "Mga Bilang 32:38",
              "text": "At ang Nebo, at ang Baal-meon, (na ang pangalan ng mga yaon ay binago,) at ang Sibma: at nilagyan ng ibang mga pangalan ang mga bayan na kanilang itinayo."
            },
            {
              "chapter": 32,
              "verse": 39,
              "name": "Mga Bilang 32:39",
              "text": "At ang mga anak ni Machir na anak ni Manases ay nagsiparoon sa Galaad, at kanilang sinakop, at pinalayas ang mga Amorrheo na nandoon."
            },
            {
              "chapter": 32,
              "verse": 40,
              "name": "Mga Bilang 32:40",
              "text": "At ibinigay ni Moises ang Galaad kay Machir na anak ni Manases; at kaniyang tinahanan."
            },
            {
              "chapter": 32,
              "verse": 41,
              "name": "Mga Bilang 32:41",
              "text": "At si Jair na anak ni Manases ay naparoon at sinakop ang mga bayan niyaon at tinawag na Havoth-jair."
            },
            {
              "chapter": 32,
              "verse": 42,
              "name": "Mga Bilang 32:42",
              "text": "At si Noba ay naparoon at sinakop ang Kenath, at ang mga nayon niyaon, at tinawag na Noba, ayon sa kaniyang sariling pangalan."
            }
          ]
        },
        {
          "chapter": 33,
          "name": "Mga Bilang 33",
          "verses": [
            {
              "chapter": 33,
              "verse": 1,
              "name": "Mga Bilang 33:1",
              "text": "Ito ang mga paglalakbay ng mga anak ni Israel, nang sila'y magsilabas sa lupain ng Egipto, ayon sa kanilang mga hukbo sa ilalim ng kapangyarihan ni Moises at ni Aaron."
            },
            {
              "chapter": 33,
              "verse": 2,
              "name": "Mga Bilang 33:2",
              "text": "At isinulat ni Moises ang kanilang mga pagyao ayon sa kanilang mga paglalakbay alinsunod sa utos ng Panginoon: at ito ang kanilang mga paglalakbay ayon sa kanilang mga pagyao."
            },
            {
              "chapter": 33,
              "verse": 3,
              "name": "Mga Bilang 33:3",
              "text": "At sila'y nagsipaglakbay mula sa Rameses nang unang buwan, nang ikalabing limang araw ng unang buwan; nang kinabukasan pagkatapos ng paskua ay nagsialis ang mga anak ni Israel na may kamay na nakataas sa paningin ng lahat ng mga taga Egipto,"
            },
            {
              "chapter": 33,
              "verse": 4,
              "name": "Mga Bilang 33:4",
              "text": "Samantalang inililibing ng mga taga Egipto ang lahat ng kanilang panganay, na nilipol ng Panginoon sa gitna nila: na pati ng kanilang mga dios ay hinatulan ng Panginoon."
            },
            {
              "chapter": 33,
              "verse": 5,
              "name": "Mga Bilang 33:5",
              "text": "At ang mga anak ni Israel ay naglakbay mula sa Rameses at humantong sa Succoth."
            },
            {
              "chapter": 33,
              "verse": 6,
              "name": "Mga Bilang 33:6",
              "text": "At sila'y naglakbay mula sa Succoth at humantong sa Etham na nasa gilid ng ilang."
            },
            {
              "chapter": 33,
              "verse": 7,
              "name": "Mga Bilang 33:7",
              "text": "At sila'y naglakbay mula sa Etham, at lumiko sa Pi-hahiroth, na nasa tapat ng Baal-sephon: at humantong sa tapat ng Migdol."
            },
            {
              "chapter": 33,
              "verse": 8,
              "name": "Mga Bilang 33:8",
              "text": "At sila'y naglakbay mula sa tapat ng Hahiroth, at nagsipagdaan sa gitna ng dagat hanggang sa ilang: at sila'y naglakbay na tatlong araw sa ilang ng Etham at humantong sa Mara."
            },
            {
              "chapter": 33,
              "verse": 9,
              "name": "Mga Bilang 33:9",
              "text": "At sila'y naglakbay mula sa Mara, at dumating sa Elim: at sa Elim ay may labing dalawang bukal ng tubig at pitong pung puno ng palma; at sila'y humantong doon."
            },
            {
              "chapter": 33,
              "verse": 10,
              "name": "Mga Bilang 33:10",
              "text": "At sila'y naglakbay mula sa Elim, at humantong sa tabi ng Dagat na Mapula."
            },
            {
              "chapter": 33,
              "verse": 11,
              "name": "Mga Bilang 33:11",
              "text": "At sila'y naglakbay mula sa Dagat na Mapula, at humantong sa ilang ng Zin."
            },
            {
              "chapter": 33,
              "verse": 12,
              "name": "Mga Bilang 33:12",
              "text": "At sila'y naglakbay mula sa ilang ng Zin, at humantong sa Dophca."
            },
            {
              "chapter": 33,
              "verse": 13,
              "name": "Mga Bilang 33:13",
              "text": "At sila'y naglakbay mula sa Dophca, at humantong sa Alus."
            },
            {
              "chapter": 33,
              "verse": 14,
              "name": "Mga Bilang 33:14",
              "text": "At sila'y naglakbay mula sa Alus, at humantong sa Rephidim, na doon, nga walang tubig na mainom ang bayan."
            },
            {
              "chapter": 33,
              "verse": 15,
              "name": "Mga Bilang 33:15",
              "text": "At sila'y naglakbay mula sa Rephidim, at humantong sa ilang ng Sinai."
            },
            {
              "chapter": 33,
              "verse": 16,
              "name": "Mga Bilang 33:16",
              "text": "At sila'y naglakbay mula sa ilang ng Sinai, at humantong sa Kibroth-hataava."
            },
            {
              "chapter": 33,
              "verse": 17,
              "name": "Mga Bilang 33:17",
              "text": "At sila'y naglakbay mula sa Kibroth-hataava, at humantong sa Haseroth."
            },
            {
              "chapter": 33,
              "verse": 18,
              "name": "Mga Bilang 33:18",
              "text": "At sila'y naglakbay mula sa Haseroth, at humantong sa Ritma."
            },
            {
              "chapter": 33,
              "verse": 19,
              "name": "Mga Bilang 33:19",
              "text": "At sila'y naglakbay mula sa Ritma, at humantong sa Rimmon-peres."
            },
            {
              "chapter": 33,
              "verse": 20,
              "name": "Mga Bilang 33:20",
              "text": "At sila'y naglakbay mula sa Rimmon-peres, at humantong sa Libna."
            },
            {
              "chapter": 33,
              "verse": 21,
              "name": "Mga Bilang 33:21",
              "text": "At sila'y naglakbay mula sa Libna, at humantong sa Rissa."
            },
            {
              "chapter": 33,
              "verse": 22,
              "name": "Mga Bilang 33:22",
              "text": "At sila'y naglakbay mula sa Rissa, at humantong sa Ceelatha."
            },
            {
              "chapter": 33,
              "verse": 23,
              "name": "Mga Bilang 33:23",
              "text": "At sila'y naglakbay mula sa Ceelatha at humantong sa bundok ng Sepher."
            },
            {
              "chapter": 33,
              "verse": 24,
              "name": "Mga Bilang 33:24",
              "text": "At sila'y naglakbay mula sa bundok ng Sepher, at humantong sa Harada."
            },
            {
              "chapter": 33,
              "verse": 25,
              "name": "Mga Bilang 33:25",
              "text": "At sila'y naglakbay mula sa Harada, at humantong sa Maceloth."
            },
            {
              "chapter": 33,
              "verse": 26,
              "name": "Mga Bilang 33:26",
              "text": "At sila'y naglakbay mula sa Maceloth, at humantong sa Tahath."
            },
            {
              "chapter": 33,
              "verse": 27,
              "name": "Mga Bilang 33:27",
              "text": "At sila'y naglakbay mula sa Tahath at humantong sa Tara."
            },
            {
              "chapter": 33,
              "verse": 28,
              "name": "Mga Bilang 33:28",
              "text": "At sila'y naglakbay mula sa Tara, at humantong sa Mithca."
            },
            {
              "chapter": 33,
              "verse": 29,
              "name": "Mga Bilang 33:29",
              "text": "At sila'y naglakbay mula sa Mithca, at humantong sa Hasmona."
            },
            {
              "chapter": 33,
              "verse": 30,
              "name": "Mga Bilang 33:30",
              "text": "At sila'y naglakbay mula sa Hasmona, at humantong sa Moseroth."
            },
            {
              "chapter": 33,
              "verse": 31,
              "name": "Mga Bilang 33:31",
              "text": "At sila'y naglakbay mula sa Moseroth, at humantong sa Bene-jaacan."
            },
            {
              "chapter": 33,
              "verse": 32,
              "name": "Mga Bilang 33:32",
              "text": "At sila'y naglakbay mula sa Bene-jaacan, at humantong sa Horhagidgad."
            },
            {
              "chapter": 33,
              "verse": 33,
              "name": "Mga Bilang 33:33",
              "text": "At sila'y naglakbay mula sa Horhagidgad at humantong sa Jotbatha."
            },
            {
              "chapter": 33,
              "verse": 34,
              "name": "Mga Bilang 33:34",
              "text": "At sila'y naglakbay mula sa Jotbatha, at humantong sa Abrona."
            },
            {
              "chapter": 33,
              "verse": 35,
              "name": "Mga Bilang 33:35",
              "text": "At sila'y naglakbay mula sa Abrona, at humantong sa Esion-geber."
            },
            {
              "chapter": 33,
              "verse": 36,
              "name": "Mga Bilang 33:36",
              "text": "At sila'y naglakbay mula sa Esion-geber, at humantong sa ilang ng Zin (na siya ring Cades)."
            },
            {
              "chapter": 33,
              "verse": 37,
              "name": "Mga Bilang 33:37",
              "text": "At sila'y naglakbay mula sa Cades, at humantong sa bundok ng Hor, sa gilid ng lupain ng Edom."
            },
            {
              "chapter": 33,
              "verse": 38,
              "name": "Mga Bilang 33:38",
              "text": "At si Aaron na saserdote ay sumampa sa bundok ng Hor sa utos ng Panginoon, at namatay roon, sa ikaapat na pung taon, pagkaalis ng mga anak ni Israel sa lupain ng Egipto, sa ikalimang buwan, nang unang araw ng buwan."
            },
            {
              "chapter": 33,
              "verse": 39,
              "name": "Mga Bilang 33:39",
              "text": "At si Aaron ay may isang daan at dalawang pu't tatlong taon nang siya'y mamatay sa bundok ng Hor."
            },
            {
              "chapter": 33,
              "verse": 40,
              "name": "Mga Bilang 33:40",
              "text": "At ang Cananeo na hari sa Arad, na tumatahan sa Timugan, sa lupain ng Canaan, ay nakarinig ng pagdating ng mga anak ni Israel."
            },
            {
              "chapter": 33,
              "verse": 41,
              "name": "Mga Bilang 33:41",
              "text": "At sila'y naglakbay mula sa bundok ng Hor, at humantong sa Salmona."
            },
            {
              "chapter": 33,
              "verse": 42,
              "name": "Mga Bilang 33:42",
              "text": "At sila'y naglakbay mula sa Salmona, at humantong sa Phunon."
            },
            {
              "chapter": 33,
              "verse": 43,
              "name": "Mga Bilang 33:43",
              "text": "At sila'y naglakbay mula sa Phunon, at humantong sa Oboth."
            },
            {
              "chapter": 33,
              "verse": 44,
              "name": "Mga Bilang 33:44",
              "text": "At sila'y naglakbay mula sa Oboth, at humantong sa Igeabarim, sa hangganan ng Moab."
            },
            {
              "chapter": 33,
              "verse": 45,
              "name": "Mga Bilang 33:45",
              "text": "At sila'y naglakbay mula sa Igeabarim, at humantong sa Dibon-gad."
            },
            {
              "chapter": 33,
              "verse": 46,
              "name": "Mga Bilang 33:46",
              "text": "At sila'y naglakbay mula sa Dibon-gad, at humantong sa Almon-diblathaim."
            },
            {
              "chapter": 33,
              "verse": 47,
              "name": "Mga Bilang 33:47",
              "text": "At sila'y naglakbay mula sa Almon-diblathaim, at humantong sa mga bundok ng Abarim, sa harap ng Nebo."
            },
            {
              "chapter": 33,
              "verse": 48,
              "name": "Mga Bilang 33:48",
              "text": "At sila'y naglakbay mula sa mga bundok ng Abarim, at humantong sa mga kapatagan ng Moab, sa tabi ng Jordan, sa tapat ng Jerico."
            },
            {
              "chapter": 33,
              "verse": 49,
              "name": "Mga Bilang 33:49",
              "text": "At sila'y humantong sa tabi ng Jordan, mula sa Beth-jesimoth hanggang sa Abel-sitim, sa mga kapatagan ng Moab."
            },
            {
              "chapter": 33,
              "verse": 50,
              "name": "Mga Bilang 33:50",
              "text": "At sinalita ng Panginoon kay Moises sa mga kapatagan ng Moab sa tabi ng Jordan, sa tapat ng Jerico, na sinasabi,"
            },
            {
              "chapter": 33,
              "verse": 51,
              "name": "Mga Bilang 33:51",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagtawid ninyo sa Jordan sa lupain ng Canaan,"
            },
            {
              "chapter": 33,
              "verse": 52,
              "name": "Mga Bilang 33:52",
              "text": "Ay inyo ngang palalayasin ang lahat ng nananahan sa lupain sa harap ninyo, at inyong sisirain ang lahat ng kanilang mga batong tinapyasan, at inyong sisirain ang lahat ng kanilang mga larawang binubo, at inyong gigibain ang lahat ng kanilang mga mataas na dako:"
            },
            {
              "chapter": 33,
              "verse": 53,
              "name": "Mga Bilang 33:53",
              "text": "At inyong ariin ang lupain, at tatahan kayo roon: sapagka't sa inyo ibinigay ko ang lupain upang ariin."
            },
            {
              "chapter": 33,
              "verse": 54,
              "name": "Mga Bilang 33:54",
              "text": "At inyong aariin ang lupain sa sapalaran ayon sa inyong mga angkan; sa marami ay magbibigay kayo ng maraming mana, at sa kaunti ay magbibigay kayo ng kaunting mana: kung kanino mahulog ang palad sa bawa't isa, ay yaon ang magiging kaniya; ayon sa mga lipi ng inyong mga magulang ay inyong mamanahin."
            },
            {
              "chapter": 33,
              "verse": 55,
              "name": "Mga Bilang 33:55",
              "text": "Nguni't kung hindi ninyo palalayasin ang mga nananahanan sa lupain sa harap ninyo; ay magiging parang mga tibo nga sa inyong mga mata, at parang mga tinik sa inyong mga tagiliran ang mga ititira ninyo sa kanila, at kanilang babagabagin kayo sa lupain na inyong tinatahanan."
            },
            {
              "chapter": 33,
              "verse": 56,
              "name": "Mga Bilang 33:56",
              "text": "At mangyayari, na kung ano ang iniisip kong gawin sa kanila, ay gayon ang gagawin ko sa inyo."
            }
          ]
        },
        {
          "chapter": 34,
          "name": "Mga Bilang 34",
          "verses": [
            {
              "chapter": 34,
              "verse": 1,
              "name": "Mga Bilang 34:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 34,
              "verse": 2,
              "name": "Mga Bilang 34:2",
              "text": "Iutos mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagpasok ninyo sa lupain ng Canaan, (na ito ang lupaing mahuhulog sa inyo na pinakamana, ang lupain ng Canaan ayon sa mga hangganan niyaon),"
            },
            {
              "chapter": 34,
              "verse": 3,
              "name": "Mga Bilang 34:3",
              "text": "At inyong hahantungan ang dakong timugan mula sa ilang ng Zin hanggang sa gilid ng Edom, at ang inyong hangganang timugan ay magiging mula sa dulo ng Dagat na Alat sa dakong silanganan:"
            },
            {
              "chapter": 34,
              "verse": 4,
              "name": "Mga Bilang 34:4",
              "text": "At ang inyong hangganan ay paliko sa dakong timugan sa sampahan ng Acrabbim, at patuloy hanggang sa Zin: at ang mga labasan niyaon ay magiging sa dakong timugan ng Cades-barnea; at mula rito ay pasampa sa Hasar-addar, at patuloy sa Asmon:"
            },
            {
              "chapter": 34,
              "verse": 5,
              "name": "Mga Bilang 34:5",
              "text": "At ang hangganan ay paliko mula sa Asmon hanggang sa batis ng Egipto, at ang magiging mga labasan niyaon ay sa dagat."
            },
            {
              "chapter": 34,
              "verse": 6,
              "name": "Mga Bilang 34:6",
              "text": "At ang magiging inyong hangganang kalunuran ay ang malaking dagat at ang baybayin niyaon: ito ang magiging inyong hangganang kalunuran."
            },
            {
              "chapter": 34,
              "verse": 7,
              "name": "Mga Bilang 34:7",
              "text": "At ito ang magiging inyong hangganang hilagaan mula sa malaking dagat ay inyong gagawing palatandaan ang bundok ng Hor:"
            },
            {
              "chapter": 34,
              "verse": 8,
              "name": "Mga Bilang 34:8",
              "text": "Mula sa bundok ng Hor ay inyong gagawing palatandaan ang pasukan ng Hamath; at ang magiging mga labasan ng hangganan ay sa Sedad;"
            },
            {
              "chapter": 34,
              "verse": 9,
              "name": "Mga Bilang 34:9",
              "text": "At ang magiging hangganan ay palabas sa Ziphron, at ang magiging mga labasan niyaon, ay ang Hasar-enan: ito ang magiging inyong hangganang hilagaan."
            },
            {
              "chapter": 34,
              "verse": 10,
              "name": "Mga Bilang 34:10",
              "text": "At inyong gagawing palatandaan ang inyong hangganang silanganan mula sa Hasar-enan hanggang Sepham:"
            },
            {
              "chapter": 34,
              "verse": 11,
              "name": "Mga Bilang 34:11",
              "text": "At ang hangganan ay pababa mula sa Sepham hanggang sa Ribla, sa dakong silanganan ng Ain; at ang hangganan ay pababa at abot hanggang sa gilid ng dagat ng Cinnereth sa dakong silanganan:"
            },
            {
              "chapter": 34,
              "verse": 12,
              "name": "Mga Bilang 34:12",
              "text": "At ang hangganan ay pababa sa Jordan, at ang magiging mga labasan niyaon ay abot sa Dagat na Alat: ito ang magiging inyong lupain, ayon sa mga hangganan niyaon sa palibot."
            },
            {
              "chapter": 34,
              "verse": 13,
              "name": "Mga Bilang 34:13",
              "text": "At iniutos ni Moises sa mga anak ni Israel, na sinasabi, Ito ang lupain na inyong mamanahin sa pamamagitan ng sapalaran, na iniutos ng Panginoon na ibigay sa siyam na lipi, at sa kalahating lipi;"
            },
            {
              "chapter": 34,
              "verse": 14,
              "name": "Mga Bilang 34:14",
              "text": "Sapagka't ang lipi ng mga anak ni Ruben ayon sa mga sangbahayan ng kanilang mga magulang, at ang lipi ng mga anak ni Gad ayon sa mga sangbahayan ng kanilang mga magulang, ay nagsitanggap na, at gayon din naman ang kalahating lipi ni Manases ay nagsitanggap na ng kanilang mana:"
            },
            {
              "chapter": 34,
              "verse": 15,
              "name": "Mga Bilang 34:15",
              "text": "Ang dalawang lipi na ito, at ang kalahating lipi ay nagsitanggap na ng kanilang mana sa dako roon ng Jordan sa dakong silanganan ng Jerico, sa dakong sinisikatan ng araw."
            },
            {
              "chapter": 34,
              "verse": 16,
              "name": "Mga Bilang 34:16",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 34,
              "verse": 17,
              "name": "Mga Bilang 34:17",
              "text": "Ito ang mga pangalan ng mga lalake na magbabahagi ng lupain sa inyo na pinakamana: si Eleazar na saserdote, at si Josue na anak ni Nun."
            },
            {
              "chapter": 34,
              "verse": 18,
              "name": "Mga Bilang 34:18",
              "text": "At maglalagay kayo ng isang prinsipe sa bawa't lipi, upang magbahagi ng lupain na pinakamana."
            },
            {
              "chapter": 34,
              "verse": 19,
              "name": "Mga Bilang 34:19",
              "text": "At ito ang mga pangalan ng mga lalake: sa lipi ni Juda, ay si Caleb na anak ni Jephone."
            },
            {
              "chapter": 34,
              "verse": 20,
              "name": "Mga Bilang 34:20",
              "text": "At sa lipi ng mga anak ni Simeon, ay si Samuel na anak ni Ammiud."
            },
            {
              "chapter": 34,
              "verse": 21,
              "name": "Mga Bilang 34:21",
              "text": "Sa lipi ni Benjamin, ay si Elidad na anak ni Chislon."
            },
            {
              "chapter": 34,
              "verse": 22,
              "name": "Mga Bilang 34:22",
              "text": "At sa lipi ng mga anak ni Dan, ay ang prinsipe Bucci na anak ni Jogli."
            },
            {
              "chapter": 34,
              "verse": 23,
              "name": "Mga Bilang 34:23",
              "text": "Sa mga anak ni Jose: sa lipi ng mga anak ni Manases, ay ang prinsipe Haniel na anak ni Ephod:"
            },
            {
              "chapter": 34,
              "verse": 24,
              "name": "Mga Bilang 34:24",
              "text": "At sa lipi ng mga anak ni Ephraim, ay ang prinsipe Chemuel na anak ni Siphtan."
            },
            {
              "chapter": 34,
              "verse": 25,
              "name": "Mga Bilang 34:25",
              "text": "At sa lipi ng mga anak ni Zabulon, ay ang prinsipe Elisaphan na anak ni Pharnach."
            },
            {
              "chapter": 34,
              "verse": 26,
              "name": "Mga Bilang 34:26",
              "text": "At sa lipi ng mga anak ni Issachar, ay ang prinsipe Paltiel na anak ni Azan."
            },
            {
              "chapter": 34,
              "verse": 27,
              "name": "Mga Bilang 34:27",
              "text": "At sa lipi ng mga anak ni Aser, ay ang prinsipe Ahiud na anak ni Selomi."
            },
            {
              "chapter": 34,
              "verse": 28,
              "name": "Mga Bilang 34:28",
              "text": "At sa lipi ng mga anak ni Nephtali, ay ang prinsipe Pedael na anak ni Ammiud."
            },
            {
              "chapter": 34,
              "verse": 29,
              "name": "Mga Bilang 34:29",
              "text": "Ito yaong mga inutusan ng Panginoon na bumahagi ng mana sa mga anak ni Israel sa lupain ng Canaan."
            }
          ]
        },
        {
          "chapter": 35,
          "name": "Mga Bilang 35",
          "verses": [
            {
              "chapter": 35,
              "verse": 1,
              "name": "Mga Bilang 35:1",
              "text": "At sinalita ng Panginoon kay Moises sa mga kapatagan ng Moab sa tabi ng Jordan sa Jerico, na sinasabi,"
            },
            {
              "chapter": 35,
              "verse": 2,
              "name": "Mga Bilang 35:2",
              "text": "Iutos mo sa mga anak ni Israel, na kanilang bigyan ang mga Levita sa mana na kanilang pag-aari, ng mga bayan na matahanan; at ang mga pastulan sa palibot ng mga bayang yaon ay ibibigay ninyo sa mga Levita,"
            },
            {
              "chapter": 35,
              "verse": 3,
              "name": "Mga Bilang 35:3",
              "text": "At mapapasa kanila ang mga bayan upang tahanan; at ang kanilang mga pastulan ay sa kanilang mga kawan, at sa kanilang mga pag-aari, at sa lahat nilang mga hayop."
            },
            {
              "chapter": 35,
              "verse": 4,
              "name": "Mga Bilang 35:4",
              "text": "At ang mga pastulan sa mga bayan, na inyong ibibigay sa mga Levita, ay isang libong siko sa palibot mula sa kuta ng bayan hanggang sa dakong labas."
            },
            {
              "chapter": 35,
              "verse": 5,
              "name": "Mga Bilang 35:5",
              "text": "At ang inyong susukatin sa labas ng bayan sa dakong silanganan ay dalawang libong siko, at sa dakong timugan ay dalawang libong siko, at sa dakong kalunuran ay dalawang libong siko, at sa dakong hilagaan ay dalawang libong siko, na ang bayan ay sa gitna. Ito ang magiging sa kanila'y mga pastulan sa mga bayan."
            },
            {
              "chapter": 35,
              "verse": 6,
              "name": "Mga Bilang 35:6",
              "text": "At ang mga bayan na inyong ibibigay sa mga Levita ay ang anim na bayan na ampunan, na siya ninyong ibibigay na matatakasan ng nakamatay ng tao: at bukod sa rito ay magbibigay kayo ng apat na pu't dalawang bayan."
            },
            {
              "chapter": 35,
              "verse": 7,
              "name": "Mga Bilang 35:7",
              "text": "Lahat ng mga bayan na inyong ibibigay sa mga Levita ay apat na pu't walong bayan: inyong ibibigay sangpu ng kanilang mga pastulan."
            },
            {
              "chapter": 35,
              "verse": 8,
              "name": "Mga Bilang 35:8",
              "text": "At tungkol sa mga bayan na pag-aari ng mga anak ni Israel na inyong ibibigay ay kukuha kayo ng marami sa marami; at sa kaunti ay kukuha kayo ng kaunti: bawa't isa ayon sa kaniyang mana na kaniyang minamana ay magbibigay sa kaniyang mga bayan sa mga Levita."
            },
            {
              "chapter": 35,
              "verse": 9,
              "name": "Mga Bilang 35:9",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 35,
              "verse": 10,
              "name": "Mga Bilang 35:10",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagkaraan ninyo ng Jordan sa lupain ng Canaan,"
            },
            {
              "chapter": 35,
              "verse": 11,
              "name": "Mga Bilang 35:11",
              "text": "Ay pipili nga kayo ng mga bayan na maging mga bayang ampunan sa inyo, upang ang nakamatay ng tao na pumatay ng sinomang tao na hindi sinasadya, ay makatakas doon."
            },
            {
              "chapter": 35,
              "verse": 12,
              "name": "Mga Bilang 35:12",
              "text": "At ang mga bayang yaong ay magiging sa inyo'y pinaka ampunan laban sa manghihiganti; upang ang nakamatay ay huwag mamatay, hanggang sa maitayo sa kapisanan na hatulan."
            },
            {
              "chapter": 35,
              "verse": 13,
              "name": "Mga Bilang 35:13",
              "text": "At ang mga bayan na inyong ibibigay ay anim na bayang ampunan sa inyo."
            },
            {
              "chapter": 35,
              "verse": 14,
              "name": "Mga Bilang 35:14",
              "text": "Magbibigay kayo ng tatlong bayan sa dako roon ng Jordan, at tatlong bayan ang ibibigay ninyo sa lupain ng Canaan; siyang magiging mga bayang ampunan."
            },
            {
              "chapter": 35,
              "verse": 15,
              "name": "Mga Bilang 35:15",
              "text": "Sa mga anak ni Israel, at sa taga ibang lupa, at sa makikipamayan sa kanila ay magiging ampunan ang anim na bayang ito: upang ang bawa't nakamatay ng sinomang tao, na hindi sinasadya, ay makatakas doon."
            },
            {
              "chapter": 35,
              "verse": 16,
              "name": "Mga Bilang 35:16",
              "text": "Nguni't kung kaniyang saktan ang kaniyang kapuwa ng isang kasangkapang bakal, na ano pa't namatay, siya nga'y mamamatay tao; ang mamamatay tao ay walang pagsalang papatayin."
            },
            {
              "chapter": 35,
              "verse": 17,
              "name": "Mga Bilang 35:17",
              "text": "At kung kaniyang saktan ng isang batong tangan niya sa kamay na ikamamatay ng isang tao, at namatay nga, mamamatay tao siya: ang mamamatay tao ay walang pagsalang papatayin."
            },
            {
              "chapter": 35,
              "verse": 18,
              "name": "Mga Bilang 35:18",
              "text": "O kung kaniyang saktan ng isang almas na kahoy na tangan niya sa kamay na ikamamatay ng tao, at namatay nga, ay mamamatay tao siya: ang mamamatay tao ay walang pagsalang papatayin."
            },
            {
              "chapter": 35,
              "verse": 19,
              "name": "Mga Bilang 35:19",
              "text": "Ang manghihiganti sa dugo ay siyang papatay sa pumatay: pagka nasumpungan niya ay kaniyang papatayin."
            },
            {
              "chapter": 35,
              "verse": 20,
              "name": "Mga Bilang 35:20",
              "text": "At kung kaniyang itinulak sa kapootan, o kaniyang hinagis na binanta, ano pa't siya'y namatay;"
            },
            {
              "chapter": 35,
              "verse": 21,
              "name": "Mga Bilang 35:21",
              "text": "O sa pakikipagkaalit ay sinaktan niya ng kaniyang kamay, na ano pa't siya'y namatay: siya na sumakit ay walang pagsalang papatayin; siya'y mamamatay tao: ang manghihiganti sa dugo ay siyang papatay sa pumatay, pagka nasumpungan niya."
            },
            {
              "chapter": 35,
              "verse": 22,
              "name": "Mga Bilang 35:22",
              "text": "Nguni't kung sa kabiglaanan ay kaniyang maitulak na walang pakikipagkaalit, o mahagisan niya ng anomang bagay na hindi binanta,"
            },
            {
              "chapter": 35,
              "verse": 23,
              "name": "Mga Bilang 35:23",
              "text": "O ng anomang bato na ikamamatay ng tao, na hindi niya nakikita at kaniyang maihagis sa kaniya, na ano pa't namatay at hindi niya kaaway, at hindi niya pinagaakalaan ng masama:"
            },
            {
              "chapter": 35,
              "verse": 24,
              "name": "Mga Bilang 35:24",
              "text": "Kung gayo'y ang kapisanan ang siyang hahatol sa sumakit at sa manghihiganti sa dugo, ayon sa mga kahatulang ito:"
            },
            {
              "chapter": 35,
              "verse": 25,
              "name": "Mga Bilang 35:25",
              "text": "At ililigtas ng kapisanan ang nakamatay sa kamay ng manghihiganti sa dugo, at siya'y pababalikin ng kapisanan sa kaniyang bayang ampunan, na kaniyang tinakasan: at siya'y tatahan doon hanggang sa pagkamatay ng pangulong saserdote, na pinahiran ng banal na langis."
            },
            {
              "chapter": 35,
              "verse": 26,
              "name": "Mga Bilang 35:26",
              "text": "Nguni't kung ang nakamatay ay lumabas sa anomang dahilan, sa hangganan ng kaniyang bayang ampunan, na kaniyang tinakasan;"
            },
            {
              "chapter": 35,
              "verse": 27,
              "name": "Mga Bilang 35:27",
              "text": "At masumpungan siya ng manghihiganti sa dugo sa labas ng hangganan ng kaniyang bayang ampunan, at patayin ng manghihiganti sa dugo ang nakamatay, ay hindi siya magiging salarin sa dugo,"
            },
            {
              "chapter": 35,
              "verse": 28,
              "name": "Mga Bilang 35:28",
              "text": "Sapagka't siya'y nararapat na tumira sa kaniyang bayang ampunan, hanggang sa pagkamatay ng dakilang saserdote: nguni't pagkamatay ng dakilang saserdote ang nakamatay ay makababalik sa lupain ng kaniyang pag-aari."
            },
            {
              "chapter": 35,
              "verse": 29,
              "name": "Mga Bilang 35:29",
              "text": "At ang mga bagay na ito ay magiging isang palatuntunan sa kahatulan sa inyo, sa buong panahon ng inyong mga lahi sa lahat ng inyong mga tahanan."
            },
            {
              "chapter": 35,
              "verse": 30,
              "name": "Mga Bilang 35:30",
              "text": "Sinomang pumatay sa kaninoman, ay papatayin ang pumatay sa patotoo ng mga saksi: nguni't ang isang saksi ay hindi makapagpapatotoo laban sa kaninomang tao upang patayin."
            },
            {
              "chapter": 35,
              "verse": 31,
              "name": "Mga Bilang 35:31",
              "text": "Bukod sa rito, huwag kayong tatanggap ng suhol sa buhay ng pumatay na nagiging salarin sa pagpapatay: kundi siya'y walang pagsalang papatayin."
            },
            {
              "chapter": 35,
              "verse": 32,
              "name": "Mga Bilang 35:32",
              "text": "At huwag kayong tatanggap ng suhol sa kaninomang tumakas sa kaniyang bayang ampunan, upang bumalik na manahan sa kaniyang lupain, hanggang sa pagkamatay ng dakilang saserdote."
            },
            {
              "chapter": 35,
              "verse": 33,
              "name": "Mga Bilang 35:33",
              "text": "Kaya't huwag ninyong dudumhan ang lupain na inyong kinaroroonan; sapagka't ang dugo ay nagpaparumi ng lupain: at walang paglilinis na magagawa sa lupa dahil sa dugo na nabubo doon, kundi sa pamamagitan ng dugo niyaong nagbubo."
            },
            {
              "chapter": 35,
              "verse": 34,
              "name": "Mga Bilang 35:34",
              "text": "At huwag ninyong dudumhan ang lupain na inyong tinatahanan, na ako'y tumahan sa gitna niyan: sapagka't akong Panginoon ay tumatahan sa gitna ng mga anak ni Israel."
            }
          ]
        },
        {
          "chapter": 36,
          "name": "Mga Bilang 36",
          "verses": [
            {
              "chapter": 36,
              "verse": 1,
              "name": "Mga Bilang 36:1",
              "text": "At ang mga pangulo ng mga sangbahayan ng mga magulang ng mga anak ni Galaad, na anak ni Machir, na anak ni Manases, sa mga angkan ng mga anak ni Jose, ay nagsilapit, at nagsalita sa harap ni Moises at sa harap ng mga prinsipe, na mga pangulo sa mga sangbahayan ng mga magulang ng mga anak ni Israel:"
            },
            {
              "chapter": 36,
              "verse": 2,
              "name": "Mga Bilang 36:2",
              "text": "At sinabi nila, Ang Panginoon ay nagutos sa aking panginoon na ibigay sa sapalaran ang lupain na pinakamana sa mga anak ni Israel: at inutusan din naman ng Panginoon ang aking panginoon na ibigay ang mana ni Salphaad na aming kapatid sa kaniyang mga anak na babae."
            },
            {
              "chapter": 36,
              "verse": 3,
              "name": "Mga Bilang 36:3",
              "text": "At kung sila'y magasawa sa kaninoman sa mga anak ng ibang mga lipi ng mga anak ni Israel ay aalisin nga ang mana nila na mula sa mana ng aming mga magulang, at sa idaragdag sa mana ng lipi na kinauukulan nila: sa gayo'y aalisin sa manang naukol sa amin."
            },
            {
              "chapter": 36,
              "verse": 4,
              "name": "Mga Bilang 36:4",
              "text": "At pagjujubileo ng mga anak ni Israel, ay idaragdag nga ang kanilang mana sa mana ng lipi na kanilang kinaukulan: sa gayo'y ang kanilang mana ay aalisin sa mana ng lipi ng aming mga magulang."
            },
            {
              "chapter": 36,
              "verse": 5,
              "name": "Mga Bilang 36:5",
              "text": "At iniutos ni Moises sa mga anak ni Israel ayon sa salita ng Panginoon na sinasabi, Ang lipi ng mga anak ni Jose ay nagsasalita ng matuwid."
            },
            {
              "chapter": 36,
              "verse": 6,
              "name": "Mga Bilang 36:6",
              "text": "Ito ang bagay na iniutos ng Panginoon tungkol sa mga anak na babae ni Salphaad, na sinasabi, Magasawa sila sa kaninomang kanilang magalingin; nguni't sa angkan ng lipi lamang ng kanilang ama magasawa sila."
            },
            {
              "chapter": 36,
              "verse": 7,
              "name": "Mga Bilang 36:7",
              "text": "Sa gayon ay hindi magkakalipatlipat ang mana ng mga anak ni Israel sa iba't ibang lipi: sapagka't ang mga anak ni Israel ay masasanib bawa't isa sa mana ng lipi ng kaniyang mga magulang."
            },
            {
              "chapter": 36,
              "verse": 8,
              "name": "Mga Bilang 36:8",
              "text": "At bawa't anak na babae na nagaari sa anomang lipi ng mga anak ni Israel ay magasawa sa isa ng angkan ng lipi ng kaniyang ama, upang ang mga anak ni Israel ay magmana bawa't isa ng mana ng kaniyang mga magulang."
            },
            {
              "chapter": 36,
              "verse": 9,
              "name": "Mga Bilang 36:9",
              "text": "Sa gayon ay hindi magkakalipatlipat ang mana sa ibang lipi; sapagka't ang mga lipi ng mga anak ni Israel ay masasanib bawa't isa sa kaniyang sariling mana."
            },
            {
              "chapter": 36,
              "verse": 10,
              "name": "Mga Bilang 36:10",
              "text": "Kung paanong iniutos ng Panginoon kay Moises, ay gayong ginawa ng mga anak na babae ni Salphaad:"
            },
            {
              "chapter": 36,
              "verse": 11,
              "name": "Mga Bilang 36:11",
              "text": "Sapagka't si Maala, si Tirsa, si Holga, at si Milca, at si Noa, na mga anak na babae ni Salphaad ay nagsipagasawa sa mga anak ng mga kapatid ng kanilang ama."
            },
            {
              "chapter": 36,
              "verse": 12,
              "name": "Mga Bilang 36:12",
              "text": "Sila'y nag-asawa sa mga angkan ng mga anak ni Manases na anak ni Jose; at ang kanilang mana ay naiwan sa lipi ng angkan ng ama nila."
            },
            {
              "chapter": 36,
              "verse": 13,
              "name": "Mga Bilang 36:13",
              "text": "Ito ang mga utos at ang mga kahatulan, na iniutos ng Panginoon sa pamamagitan ni Moises sa mga anak ni Israel sa mga kapatagan ng Moab sa tabi ng Jordan sa Jerico."
            }
          ]
        }
      ]
    },
    {
      "nr": 5,
      "name": "Deuteronomio",
      "chapters": [
        {
          "chapter": 1,
          "name": "Deuteronomio 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Deuteronomio 1:1",
              "text": "Ito ang mga salita na sinalita ni Moises sa buong Israel sa dako roon ng Jordan sa ilang, sa Araba na katapat ng Suph, sa pagitan ng Paran, at ng Thopel, at ng Laban, at ng Haseroth, at ng Di-zahab."
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Deuteronomio 1:2",
              "text": "Labing isang araw na lakbayin mula sa Horeb kung dadaan ng bundok ng Seir hanggang sa Cades-barnea."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Deuteronomio 1:3",
              "text": "At nangyari nang ikaapat na pung taon, nang ikalabing isang buwan, nang unang araw ng buwan, na nagsalita si Moises sa mga anak ni Israel, tungkol sa lahat na ibinigay sa kaniyang utos ng Panginoon sa kanila;"
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Deuteronomio 1:4",
              "text": "Pagkatapos na kaniyang masaktan si Sehon na hari ng mga Amorrheo, na tumatahan sa Hesbon, at si Og na hari sa Basan, na tumatahan sa Astarot sa Edrei:"
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Deuteronomio 1:5",
              "text": "Sa dako roon ng Jordan, sa lupain ng Moab, pinasimulan ni Moises na ipinahayag ang kautusang ito, na sinasabi,"
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Deuteronomio 1:6",
              "text": "Ang Panginoon nating Dios ay nagsalita sa atin sa Horeb, na nagsasabi, Kayo'y nakatahan ng malaon sa bundok na ito:"
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Deuteronomio 1:7",
              "text": "Pumihit kayo, at kayo'y maglakbay, at kayo'y pumaroon sa lupaing maburol ng mga Amorrheo, at sa lahat ng mga dakong malapit, sa Araba, sa lupaing maburol, at sa mababang lupain, at sa Timugan, at sa baybayin ng dagat, sa lupain ng mga Cananeo at sa Lebano, hanggang sa malaking ilog, na ilog Eufrates."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Deuteronomio 1:8",
              "text": "Narito, aking inilagay ang lupain sa harap ninyo: inyong pasukin at ariin ang lupain na isinumpa ng Panginoon sa inyong mga magulang, kay Abraham, kay Isaac, at kay Jacob, na ibibigay sa kanila at sa kanilang binhi pagkamatay nila."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Deuteronomio 1:9",
              "text": "At ako'y nagsalita sa inyo nang panahong yaon na sinasabi, Hindi ko madadalang magisa kayo:"
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Deuteronomio 1:10",
              "text": "Pinarami kayo ng Panginoon ninyong Dios, at, narito, kayo sa araw na ito ay gaya ng mga bituin sa langit sa karamihan."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Deuteronomio 1:11",
              "text": "Kayo nawa'y dagdagan ng Panginoon, ng Dios ng inyong mga magulang, ng makalibo pa sa dami ninyo ngayon, at kayo nawa'y pagpalain, na gaya ng ipinangako niya sa inyo!"
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Deuteronomio 1:12",
              "text": "Paanong madadala kong magisa ang inyong ligalig, at ang inyong pasan, at ang inyong pagkakaalitan?"
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Deuteronomio 1:13",
              "text": "Kumuha kayo sa inyo ng mga lalaking pantas, at nakakaalam, at kilala, ayon sa inyong mga lipi, at sila'y aking gagawing pangulo sa inyo."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Deuteronomio 1:14",
              "text": "At kayo'y sumagot sa akin at nagsabi, Ang bagay na iyong sinalita ay mabuting gawin namin."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Deuteronomio 1:15",
              "text": "Sa gayo'y kinuha ko sa inyo ang mga pangulo ng inyong mga lipi, na mga taong pantas, at kilala, at akin silang ginawang pangulo sa inyo, na mga punong kawal ng libolibo, at mga punong kawal ng mga daandaan, at mga punong kawal ng mga limangpu-limangpu, at mga punong kawal ng mga sangpu-sangpu, at mga pinuno ayon sa inyong mga lipi."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Deuteronomio 1:16",
              "text": "At aking pinagbilinan ang inyong mga hukom nang panahong yaon na sinasabi, Inyong dinggin ang mga usap ng inyong mga kapatid, at inyong hatulan ng matuwid ang tao at ang kaniyang kapatid, at ang taga ibang lupa na kasama niya."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Deuteronomio 1:17",
              "text": "Huwag kayong magtatangi ng tao sa kahatulan; inyong didinggin ang maliliit, na gaya ng malaki: huwag kayong matatakot sa mukha ng tao; sapagka't ang kahatulan ay sa Dios: at ang usap na napakahirap sa inyo, ay inyong dadalhin sa akin, at aking didinggin."
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Deuteronomio 1:18",
              "text": "At aking iniutos sa inyo nang panahong yaon ang lahat ng mga bagay na inyong dapat gagawin."
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "Deuteronomio 1:19",
              "text": "At tayo ay naglakbay mula sa Horeb at ating tinahak yaong buong malawak at kakilakilabot na ilang na inyong nakita, sa daang patungo sa lupaing maburol ng mga Amorrheo, na gaya ng iniutos ng Panginoon nating Dios sa atin, at tayo'y dumating sa Cades-barnea."
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "Deuteronomio 1:20",
              "text": "At aking sinabi sa inyo, Inyong narating ang lupaing maburol ng mga Amorrheo na ibinibigay sa atin ng Panginoon nating Dios."
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "Deuteronomio 1:21",
              "text": "Narito, inilalagay ng Panginoon ninyong Dios ang lupain sa harap mo: sampahin mo, ariin mo, na gaya ng sinalita sa iyo ng Panginoon, ng Dios ng iyong mga magulang; huwag kang matakot, ni manglupaypay."
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "Deuteronomio 1:22",
              "text": "At kayo'y lumapit sa akin, bawa't isa sa inyo, at nagsabi, Tayo'y magsugo ng mga lalake sa unahan natin, upang kanilang kilalanin ang lupain para sa atin, at magbigay alam sa atin ng daang ating marapat sampahan, at ng mga bayang ating daratnin."
            },
            {
              "chapter": 1,
              "verse": 23,
              "name": "Deuteronomio 1:23",
              "text": "At ang bagay na yaon ay inakala kong magaling: at ako'y kumuha ng labing dalawang lalake sa inyo, na isang lalake sa bawa't lipi."
            },
            {
              "chapter": 1,
              "verse": 24,
              "name": "Deuteronomio 1:24",
              "text": "At sila'y pumihit at sumampa sa bundok, at dumating hanggang sa libis ng Escol, at kanilang tiniktikan."
            },
            {
              "chapter": 1,
              "verse": 25,
              "name": "Deuteronomio 1:25",
              "text": "At sila'y nagbitbit ng bunga ng lupain sa kanilang mga kamay, at kanilang ipinanaog sa atin, at sila'y nagdala ng kasagutan at nagsabi, Mabuting lupain ang ibinibigay sa atin ng Panginoon nating Dios."
            },
            {
              "chapter": 1,
              "verse": 26,
              "name": "Deuteronomio 1:26",
              "text": "Gayon ma'y hindi kayo umakyat, kundi nanghimagsik kayo laban sa utos ng Panginoon ninyong Dios."
            },
            {
              "chapter": 1,
              "verse": 27,
              "name": "Deuteronomio 1:27",
              "text": "At kayo'y dumaing sa inyong mga tolda, at inyong sinabi, Sapagka't kinapootan tayo ng Panginoon, ay inilabas tayo sa lupain ng Egipto, upang tayo'y ibigay sa kamay ng mga Amorrheo, upang tayo'y lipulin."
            },
            {
              "chapter": 1,
              "verse": 28,
              "name": "Deuteronomio 1:28",
              "text": "Saan tayo sasampa? pinapanglupaypay ng ating mga kapatid ang ating puso, na sinasabi, Ang mga tao ay malalaki at matataas kay sa atin; ang mga bayan ay malalaki at nakukutaan ng hanggang sa himpapawid; at bukod dito'y aming nakita roon ang mga anak ng mga Anaceo."
            },
            {
              "chapter": 1,
              "verse": 29,
              "name": "Deuteronomio 1:29",
              "text": "Nang magkagayo'y sinabi ko sa inyo, Huwag kayong mangilabot ni matakot sa kanila."
            },
            {
              "chapter": 1,
              "verse": 30,
              "name": "Deuteronomio 1:30",
              "text": "Ang Panginoon ninyong Dios, na nangunguna sa inyo, ay kaniyang ipakikipaglaban kayo, ayon sa lahat ng kaniyang ginawa sa Egipto dahil sa inyo sa harap ng inyong mga mata;"
            },
            {
              "chapter": 1,
              "verse": 31,
              "name": "Deuteronomio 1:31",
              "text": "At sa ilang, na inyong kinakitaan kung paanong dinala ka ng Panginoon ninyong Dios, na gaya ng pagdadala ng tao sa kaniyang anak, sa buong daang inyong nilakaran hanggang sa dumating kayo sa dakong ito."
            },
            {
              "chapter": 1,
              "verse": 32,
              "name": "Deuteronomio 1:32",
              "text": "Gayon ma'y sa bagay na ito, ay hindi kayo sumampalataya sa Panginoon ninyong Dios,"
            },
            {
              "chapter": 1,
              "verse": 33,
              "name": "Deuteronomio 1:33",
              "text": "Na nagpauna sa inyo sa daan, upang ihanap kayo ng dakong mapagtatayuan ng inyong mga tolda, na nasa apoy pagka gabi, upang ituro sa inyo kung saang daan kayo dadaan, at nasa ulap pagka araw."
            },
            {
              "chapter": 1,
              "verse": 34,
              "name": "Deuteronomio 1:34",
              "text": "At narinig ng Panginoon ang tinig ng inyong mga salita, at nag-init, at sumumpa, na nagsasabi,"
            },
            {
              "chapter": 1,
              "verse": 35,
              "name": "Deuteronomio 1:35",
              "text": "Tunay na hindi makikita ng isa man nitong mga taong masamang lahi ang mabuting lupain na aking isinumpang ibigay sa inyong mga magulang,"
            },
            {
              "chapter": 1,
              "verse": 36,
              "name": "Deuteronomio 1:36",
              "text": "Liban si Caleb na anak ni Jephone; at siya ang makakakita; at sa kaniya ko ibibigay ang lupain na kaniyang tinuntungan, at sa kaniyang mga anak: sapagka't siya'y lubos na sumunod sa Panginoon."
            },
            {
              "chapter": 1,
              "verse": 37,
              "name": "Deuteronomio 1:37",
              "text": "Ang Panginoon ay nagalit din sa akin, dahil sa inyo, na nagsasabi, Ikaw man ay hindi papasok doon:"
            },
            {
              "chapter": 1,
              "verse": 38,
              "name": "Deuteronomio 1:38",
              "text": "Si Josue na anak ni Nun, na nakatayo sa harap mo, ay siyang papasok doon: palakasin mo ang kaniyang loob; sapagka't kaniyang ipamamana sa Israel."
            },
            {
              "chapter": 1,
              "verse": 39,
              "name": "Deuteronomio 1:39",
              "text": "Bukod dito'y ang inyong mga bata, na inyong sinasabing magiging bihag, at ang inyong mga anak na sa araw na ito ay hindi nakakaalam ng mabuti o ng masama, ay sila ang papasok doon, at sa kanila'y aking ibibigay, at kanilang aariin."
            },
            {
              "chapter": 1,
              "verse": 40,
              "name": "Deuteronomio 1:40",
              "text": "Nguni't tungkol sa inyo, ay bumalik kayo, at maglakbay kayo sa ilang sa daang patungo sa Dagat na Mapula."
            },
            {
              "chapter": 1,
              "verse": 41,
              "name": "Deuteronomio 1:41",
              "text": "Nang magkagayo'y sumagot kayo at sinabi ninyo sa akin, Kami ay nagkasala laban sa Panginoon, kami ay sasampa at lalaban, ayon sa buong iniutos sa amin ng Panginoon naming Dios. At nagsipagsakbat bawa't isa sa inyo ng kanikaniyang sandata na pangdigma, at kayo'y nagmadaling sumampa sa bundok."
            },
            {
              "chapter": 1,
              "verse": 42,
              "name": "Deuteronomio 1:42",
              "text": "At sinabi sa akin ng Panginoon, Sabihin mo sa kanila, Huwag kayong sumampa, ni lumaban; sapagka't ako'y wala sa inyo; baka kayo'y masugatan sa harap ng inyong mga kaaway."
            },
            {
              "chapter": 1,
              "verse": 43,
              "name": "Deuteronomio 1:43",
              "text": "Gayon sinalita ko sa inyo, at hindi ninyo dininig; kundi kayo'y nanghimagsik laban sa utos ng Panginoon, at naghambog at umakyat sa bundok."
            },
            {
              "chapter": 1,
              "verse": 44,
              "name": "Deuteronomio 1:44",
              "text": "At ang mga Amorrheo na tumatahan sa bundok na yaon, ay nagsilabas na laban sa inyo, at kayo'y hinabol, na gaya ng ginagawa ng mga pukyutan, at kayo'y tinalo sa Seir, hanggang sa Horma."
            },
            {
              "chapter": 1,
              "verse": 45,
              "name": "Deuteronomio 1:45",
              "text": "At kayo'y bumalik at umiyak sa harap ng Panginoon; nguni't hindi dininig ng Panginoon ang inyong tinig, ni pinakinggan kayo."
            },
            {
              "chapter": 1,
              "verse": 46,
              "name": "Deuteronomio 1:46",
              "text": "Sa gayon, ay natira kayong malaon sa Cades, ayon sa mga araw na inyong itinira roon."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Deuteronomio 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Deuteronomio 2:1",
              "text": "Nang magkagayo'y pumihit tayo, at lumakad tayo sa ilang na daang patungo sa Dagat na Mapula, gaya ng sinalita sa akin ng Panginoon; at tayo'y malaong lumigid sa bundok ng Seir."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Deuteronomio 2:2",
              "text": "At ang Panginoon ay nagsalita sa akin, na sinasabi,"
