            {
              "chapter": 15,
              "verse": 15,
              "name": "Mga Hukom 15:15",
              "text": "At siya'y nakasumpong ng isang bagong panga ng asno, at iniunat ang kaniyang kamay, at kinuha, at ipinanakit sa isang libong lalake."
