        {
          "chapter": 2,
          "name": "1 Mga Cronica 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "1 Mga Cronica 2:1",
              "text": "Ito ang mga anak ni Israel: si Ruben, si Simeon, si Levi, at si Juda, at si Issachar, at si Zabulon;"
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "1 Mga Cronica 2:2",
              "text": "Si Dan, si Jose, at si Benjamin, si Neftali, si Gad at si Aser."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "1 Mga Cronica 2:3",
              "text": "Ang mga anak ni Juda: si Er, at si Onan, at si Sela: na siyang tatlong ipinanganak sa kaniya ng anak na babae ni Sua, na Cananea. At si Er, na panganay ni Juda, ay masama sa paningin ng Panginoon; at pinatay niya siya."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "1 Mga Cronica 2:4",
              "text": "At ipinanganak sa kaniya ni Thamar na kaniyang manugang na babae si Phares at si Zara. Lahat na anak ni Juda ay lima."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "1 Mga Cronica 2:5",
              "text": "Ang mga anak ni Phares: si Hesron at si Hamul."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "1 Mga Cronica 2:6",
              "text": "At ang mga anak ni Zara: si Zimri, at si Ethan, at si Heman, at si Calcol, at si Darda: lima silang lahat."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "1 Mga Cronica 2:7",
              "text": "At ang mga anak ni Carmi: si Achar, na mangbabagabag ng Israel, na gumawa ng pagsalangsang sa itinalagang bagay."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "1 Mga Cronica 2:8",
              "text": "At ang mga anak ni Ethan: si Azaria."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "1 Mga Cronica 2:9",
              "text": "Ang mga anak naman ni Hesron, na mga ipinanganak sa kaniya: si Jerameel, at si Ram, at si Chelubai."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "1 Mga Cronica 2:10",
              "text": "At naging anak ni Ram si Aminadab; at naging anak ni Aminadab si Nahason, na prinsipe ng mga anak ng Juda;"
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "1 Mga Cronica 2:11",
              "text": "At naging anak ni Nahason si Salma, at naging anak ni Salma si Booz;"
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "1 Mga Cronica 2:12",
              "text": "At naging anak ni Booz si Obed, at naging anak ni Obed si Isai;"
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "1 Mga Cronica 2:13",
              "text": "At naging anak ni Isai ang kaniyang panganay na si Eliab, at si Abinadab ang ikalawa, at si Sima ang ikatlo;"
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "1 Mga Cronica 2:14",
              "text": "Si Nathanael ang ikaapat, si Radai ang ikalima;"
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "1 Mga Cronica 2:15",
              "text": "Si Osem ang ikaanim, si David ang ikapito:"
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "1 Mga Cronica 2:16",
              "text": "At ang kanilang mga kapatid na babae si Sarvia at si Abigail. At ang mga naging anak ni Sarvia; si Abisai, at si Joab, at si Asael, tatlo."
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "1 Mga Cronica 2:17",
              "text": "At ipinanganak ni Abigail si Amasa: at ang ama ni Amasa ay si Jether na Ismaelita."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "1 Mga Cronica 2:18",
              "text": "At nagkaanak si Caleb na anak ni Hesron kay Azuba na asawa niya, at kay Jerioth: at ang mga ito ang kaniyang mga anak: si Jeser, at si Sobad, at si Ardon."
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "1 Mga Cronica 2:19",
              "text": "At namatay si Azuba, at nagasawa si Caleb kay Ephrata, na siyang nanganak kay Hur sa kaniya."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "1 Mga Cronica 2:20",
              "text": "At naging anak ni Hur si Uri, at naging anak ni Uri si Bezaleel."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "1 Mga Cronica 2:21",
              "text": "At pagkatapos ay sumiping si Hesron sa anak na babae ni Machir na ama ni Galaad; na siya niyang naging asawa, nang siya'y may anim na pung taong gulang; at ipinanganak niya si Segub sa kaniya."
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "1 Mga Cronica 2:22",
              "text": "At naging anak ni Segub si Jair, na nagkaroon ng dalawang pu't tatlong bayan sa lupain ng Galaad."
            },
            {
              "chapter": 2,
              "verse": 23,
              "name": "1 Mga Cronica 2:23",
              "text": "At sinakop ni Gesur at ni Aram ang mga bayan ni Jair sa kanila, pati ng Cenath, at ang mga nayon niyaon, sa makatuwid baga'y anim na pung bayan. Lahat ng ito'y mga anak ni Machir na ama ni Galaad."
            },
            {
              "chapter": 2,
              "verse": 24,
              "name": "1 Mga Cronica 2:24",
              "text": "At pagkamatay ni Hesron sa Caleb-ephrata ay ipinanganak nga ni Abia na asawa ni Hesron sa kaniya si Ashur na ama ni Tecoa."
            },
            {
              "chapter": 2,
              "verse": 25,
              "name": "1 Mga Cronica 2:25",
              "text": "At ang mga anak ni Jerameel na panganay ni Hesron ay si Ram ang panganay, at si Buna, at si Orem, at si Osem, si Achia."
            },
            {
              "chapter": 2,
              "verse": 26,
              "name": "1 Mga Cronica 2:26",
              "text": "At si Jerameel ay nagasawa ng iba, na ang pangalan ay Atara; siya ang ina ni Onam."
            },
            {
              "chapter": 2,
              "verse": 27,
              "name": "1 Mga Cronica 2:27",
              "text": "At ang mga anak ni Ram na panganay ni Jerameel ay si Maas, at si Jamin, at si Acar."
            },
            {
              "chapter": 2,
              "verse": 28,
              "name": "1 Mga Cronica 2:28",
              "text": "At ang mga anak ni Onam ay si Sammai, at si Jada. At ang mga anak ni Sammai: si Nadab, at si Abisur."
            },
            {
              "chapter": 2,
              "verse": 29,
              "name": "1 Mga Cronica 2:29",
              "text": "At ang pangalan ng asawa ni Abisur ay Abihail; at ipinanganak niya sa kaniya si Aban, at si Molib."
            },
            {
              "chapter": 2,
              "verse": 30,
              "name": "1 Mga Cronica 2:30",
              "text": "At ang mga anak ni Nadab: si Seled, at si Aphaim: nguni't si Seled ay namatay na walang anak."
            },
            {
              "chapter": 2,
              "verse": 31,
              "name": "1 Mga Cronica 2:31",
              "text": "At ang mga anak ni Aphaim: si Isi. At ang mga anak ni Isi; si Sesan. At ang mga anak ni Sesan: si Alai."
            },
            {
              "chapter": 2,
              "verse": 32,
              "name": "1 Mga Cronica 2:32",
              "text": "At ang mga anak ni Jada, na kapatid ni Sammai: si Jether, at si Jonathan: at si Jether ay namatay na walang anak."
            },
            {
              "chapter": 2,
              "verse": 33,
              "name": "1 Mga Cronica 2:33",
              "text": "At ang mga anak ni Jonathan: si Peleth, at si Zaza. Ito ang mga anak ni Jerameel."
            },
            {
              "chapter": 2,
              "verse": 34,
              "name": "1 Mga Cronica 2:34",
              "text": "Si Sesan nga ay hindi nagkaanak ng mga lalake, kundi mga babae. At si Sesan ay may isang alipin na taga Egipto, na ang pangalan ay Jarha."
            },
            {
              "chapter": 2,
              "verse": 35,
              "name": "1 Mga Cronica 2:35",
              "text": "At pinapagasawa ni Sesan ang kaniyang anak na babae kay Jarha na kaniyang alipin at ipinanganak niya si Athai sa kaniya."
            },
            {
              "chapter": 2,
              "verse": 36,
              "name": "1 Mga Cronica 2:36",
              "text": "At naging anak ni Athai si Nathan, at naging anak ni Nathan si Zabad;"
            },
            {
              "chapter": 2,
              "verse": 37,
              "name": "1 Mga Cronica 2:37",
              "text": "At naging anak ni Zabad si Ephlal, at naging anak ni Ephlal, si Obed."
            },
            {
              "chapter": 2,
              "verse": 38,
              "name": "1 Mga Cronica 2:38",
              "text": "At naging anak ni Obed si Jehu, at naging anak ni Jehu si Azarias;"
            },
            {
              "chapter": 2,
              "verse": 39,
              "name": "1 Mga Cronica 2:39",
              "text": "At naging anak ni Azarias si Heles, at naging anak ni Heles si Elasa;"
            },
            {
              "chapter": 2,
              "verse": 40,
              "name": "1 Mga Cronica 2:40",
              "text": "At naging anak ni Elasa si Sismai, at naging anak ni Sismai si Sallum;"
            },
            {
              "chapter": 2,
              "verse": 41,
              "name": "1 Mga Cronica 2:41",
              "text": "At naging anak ni Sallum si Jecamia, at naging anak ni Jecamia si Elisama."
            },
            {
              "chapter": 2,
              "verse": 42,
              "name": "1 Mga Cronica 2:42",
              "text": "At ang mga anak ni Caleb na kapatid ni Jerameel ay si Mesa na kaniyang panganay, na siyang ama ni Ziph; at ang mga anak ni Maresa na ama ni Hebron."
            },
            {
              "chapter": 2,
              "verse": 43,
              "name": "1 Mga Cronica 2:43",
              "text": "At ang mga anak ni Hebron: si Core, at si Thaphua, at si Recem, at si Sema."
            },
            {
              "chapter": 2,
              "verse": 44,
              "name": "1 Mga Cronica 2:44",
              "text": "At naging anak ni Sema si Raham, na ama ni Jorcaam; at naging anak ni Recem si Sammai."
            },
            {
              "chapter": 2,
              "verse": 45,
              "name": "1 Mga Cronica 2:45",
              "text": "At ang anak ni Sammai ay si Maon; at si Maon ay ama ni Beth-zur."
            },
            {
              "chapter": 2,
              "verse": 46,
              "name": "1 Mga Cronica 2:46",
              "text": "At ipinanganak ni Epha, na babae ni Caleb, si Haran, at si Mosa, at si Gazez: at naging anak ni Haran si Gazez."
            },
            {
              "chapter": 2,
              "verse": 47,
              "name": "1 Mga Cronica 2:47",
              "text": "At ang mga anak ni Joddai: si Regem, at si Jotham, at si Gesan, at si Pelet, at si Epha, at si Saaph."
            },
            {
              "chapter": 2,
              "verse": 48,
              "name": "1 Mga Cronica 2:48",
              "text": "Ipinanganak ni Maacha, na babae ni Caleb, si Sebet, at si Thirana."
            },
            {
              "chapter": 2,
              "verse": 49,
              "name": "1 Mga Cronica 2:49",
              "text": "Ipinanganak din niya si Saaph na ama ni Madmannah, si Seva na ama ni Macbena, at ang ama ni Ghiba; at ang anak na babae ni Caleb ay si Acha."
            },
            {
              "chapter": 2,
              "verse": 50,
              "name": "1 Mga Cronica 2:50",
              "text": "Ito ang mga naging anak ni Caleb, na anak ni Hur, na panganay ni Ephrata: si Sobal na ama ni Chiriath-jearim;"
            },
            {
              "chapter": 2,
              "verse": 51,
              "name": "1 Mga Cronica 2:51",
              "text": "Si Salma na ama ni Bethlehem, si Hareph na ama ni Beth-gader."
            },
            {
              "chapter": 2,
              "verse": 52,
              "name": "1 Mga Cronica 2:52",
              "text": "At si Sobal na ama ni Chiriath-jearim ay nagkaanak; si Haroeh, na kalahati ng mga Manahethita."
            },
            {
              "chapter": 2,
              "verse": 53,
              "name": "1 Mga Cronica 2:53",
              "text": "At ang mga angkan ni Chiriath-jearim: ang mga Ithreo, at ang mga Phuteo, at ang mga Samateo, at ang mga Misraiteo; na mula sa kanila ang mga Soratita at ang mga Estaolita."
            },
            {
              "chapter": 2,
              "verse": 54,
              "name": "1 Mga Cronica 2:54",
              "text": "Ang mga anak ni Salma: ang Bethlehem, at ang mga Netophatita, ang Atroth-beth-joab, at ang kalahati ng mga Manahethita, ang mga Soraita."
            },
            {
              "chapter": 2,
              "verse": 55,
              "name": "1 Mga Cronica 2:55",
              "text": "At ang mga angkan ng mga kalihim na nagsisitahan sa Jabes: ang mga Thiratheo, ang mga Simatheo, at ang mga Sucatheo. Ito ang mga Cineo, na nagsipagmula kay Hamath, na ama ng sangbahayan ni Rechab."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "1 Mga Cronica 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "1 Mga Cronica 3:1",
              "text": "Ang mga ito nga ang mga anak ni David, na mga ipinanganak sa kaniya sa Hebron: ang panganay ay si Amnon, ni Achinoam na Jezreelita; ang ikalawa'y si Daniel, ni Abigail na Carmelita;"
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "1 Mga Cronica 3:2",
              "text": "Ang ikatlo'y si Absalom, na anak ni Maacha na anak na babae ni Talmai na hari sa Gesur; ang ikaapat ay si Adonias na anak ni Aggith;"
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "1 Mga Cronica 3:3",
              "text": "Ang ikalima'y si Sephatias, ni Abithal; ang ikaanim ay si Itream, ni Egla na asawa niya."
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "1 Mga Cronica 3:4",
              "text": "Anim ang ipinanganak sa kaniya sa Hebron; at doo'y naghari siyang pitong taon at anim na buwan: At sa Jerusalem ay naghari siyang tatlong pu't tatlong taon."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "1 Mga Cronica 3:5",
              "text": "At ito ang mga ipinanganak sa kaniya sa Jerusalem: si Simma, at si Sobab, at si Nathan, at si Solomon, apat, ni Beth-sua na anak na babae ni Ammiel:"
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "1 Mga Cronica 3:6",
              "text": "At si Ibaar, at si Elisama, at si Eliphelet;"
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "1 Mga Cronica 3:7",
              "text": "At si Noga, at si Nepheg, at si Japhia;"
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "1 Mga Cronica 3:8",
              "text": "At si Elisama, at si Eliada, at si Eliphelet, siyam;"
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "1 Mga Cronica 3:9",
              "text": "Lahat ng ito'y mga anak ni David, bukod pa ang mga anak ng mga babae; at si Thamar ay kanilang kapatid na babae."
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "1 Mga Cronica 3:10",
              "text": "At ang anak ni Solomon ay si Roboam, si Abia na kaniyang anak, si Asa na kaniyang anak, si Josaphat na kaniyang anak;"
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "1 Mga Cronica 3:11",
              "text": "Si Joram na kaniyang anak, si Ochozias na kaniyang anak, si Joas na kaniyang anak;"
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "1 Mga Cronica 3:12",
              "text": "Si Amasias na kaniyang anak, si Azarias na kaniyang anak, si Jotham na kaniyang anak;"
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "1 Mga Cronica 3:13",
              "text": "Si Achaz na kaniyang anak, si Ezechias na kaniyang anak, si Manases na kaniyang anak;"
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "1 Mga Cronica 3:14",
              "text": "Si Amon na kaniyang anak, si Josias na kaniyang anak."
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "1 Mga Cronica 3:15",
              "text": "At ang mga anak ni Josias: ang panganay ay si Johanan, ang ikalawa'y si Joacim, ang ikatlo'y si Sedecias, ang ikaapat ay si Sallum."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "1 Mga Cronica 3:16",
              "text": "At ang mga anak ni Joacim: si Jechonias na kaniyang anak, si Sedecias na kaniyang anak."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "1 Mga Cronica 3:17",
              "text": "At ang mga anak ni Jechonias, na bihag: si Salathiel na kaniyang anak,"
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "1 Mga Cronica 3:18",
              "text": "At si Mechiram, at si Pedaia at si Seneaser, si Jecamia, si Hosama, at si Nedabia."
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "1 Mga Cronica 3:19",
              "text": "At ang mga anak, ni Pedaia: si Zorobabel, at si Simi. At ang mga anak ni Zorobabel; si Mesullam, at si Hananias; at si Selomith, na kanilang kapatid na babae:"
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "1 Mga Cronica 3:20",
              "text": "At si Hasuba, at si Ohel, at si Berechias, at si Hasadia, at si Jusabhesed, lima."
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "1 Mga Cronica 3:21",
              "text": "At ang mga anak ni Hananias: si Pelatias, at si Jesaias; ang mga anak ni Rephaias, ang mga anak ni Arnan, ang mga anak ni Obdias, ang mga anak ni Sechanias."
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "1 Mga Cronica 3:22",
              "text": "At ang mga anak ni Sechanias: si Semaias; at ang mga anak ni Semaias: si Hattus, at si Igheal, at si Barias, at si Nearias, at si Saphat, anim."
            },
            {
              "chapter": 3,
              "verse": 23,
              "name": "1 Mga Cronica 3:23",
              "text": "At ang mga anak ni Nearias: si Elioenai, at si Ezechias, at si Azricam, tatlo."
            },
            {
              "chapter": 3,
              "verse": 24,
              "name": "1 Mga Cronica 3:24",
              "text": "At ang mga anak ni Elioenai: si Odavias, at si Eliasib, at si Pelaias, at si Accub, at si Johanan at si Delaias, at si Anani, pito."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "1 Mga Cronica 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "1 Mga Cronica 4:1",
              "text": "Ang mga anak ni Juda: si Phares, si Hesron, at si Carmi, at si Hur, at si Sobal."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "1 Mga Cronica 4:2",
              "text": "At naging anak ni Reaias na anak ni Sobal si Jahath: at naging anak ni Jahath si Ahumai; at si Laad. Ito ang mga angkan ng mga Sorathita."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "1 Mga Cronica 4:3",
              "text": "At ito ang mga anak ng ama ni Etham: si Jezreel, at si Isma, at si Idbas: at ang pangalan ng kanilang kapatid na babae ay Haslelponi:"
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "1 Mga Cronica 4:4",
              "text": "At si Penuel na ama ni Gedor, at si Ezer na ama ni Husa. Ito ang mga anak ni Hur, na panganay ni Ephrata, na ama ni Bethlehem."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "1 Mga Cronica 4:5",
              "text": "At si Asur na ama ni Tecoa ay nagasawa ng dalawa: si Helea, at si Naara."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "1 Mga Cronica 4:6",
              "text": "At ipinanganak sa kaniya ni Naara si Auzam, at si Hepher, at si Themeni, at si Ahastari. Ito ang mga anak ni Naara."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "1 Mga Cronica 4:7",
              "text": "At ang mga anak ni Helea ay si Sereth, at si Jesohar, at si Ethnan."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "1 Mga Cronica 4:8",
              "text": "At naging anak ni Coz si Anob, at si Sobeba, at ang mga angkan ni Aharhel na anak ni Arum."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "1 Mga Cronica 4:9",
              "text": "At si Jabes ay bantog kay sa kaniyang mga kapatid: at tinawag ng kaniyang ina ang kaniyang pangalan na Jabes, na sinasabi, Sapagka't ipinanganak kong may kahirapan siya."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "1 Mga Cronica 4:10",
              "text": "At si Jabes ay dumalangin sa Dios ng Israel, na nagsasabi, Oh ako nawa'y iyong pagpalain, at palakihin ang aking hangganan, at ang iyong kamay ay suma akin, at ingatan mo ako sa kasamaan, na huwag akong maghirap! At ipinagkaloob ng Dios sa kaniya ang kaniyang hiniling."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "1 Mga Cronica 4:11",
              "text": "At naging anak ni Celub na kapatid ni Sua si Machir, na siyang ama ni Esthon."
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "1 Mga Cronica 4:12",
              "text": "At naging anak ni Esthon si Beth-rapha, at si Phasea, at si Tehinna, na ama ni Ir-naas. Ito ang mga lalake ni Recha."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "1 Mga Cronica 4:13",
              "text": "At ang mga anak ni Cenez: si Othniel, at si Seraiah; at ang anak ni Othniel; si Hathath."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "1 Mga Cronica 4:14",
              "text": "At naging anak ni Maonathi si Ophra: at naging anak ni Seraiah si Joab, na ama ng Geharasim; sapagka't sila'y mga manggagawa."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "1 Mga Cronica 4:15",
              "text": "At ang mga anak ni Caleb na anak ni Jephone; si Iru, si Ela, at si Naham; at ang anak ni Ela; at si Cenez."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "1 Mga Cronica 4:16",
              "text": "At ang mga anak ni Jaleleel: si Ziph, at si Zipha, si Tirias, at si Asareel."
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "1 Mga Cronica 4:17",
              "text": "At ang mga anak ni Ezra: si Jeter, at si Mered, at si Epher, at si Jalon; at ipinanganak niya si Mariam, at si Sammai, at si Isba, na ama ni Esthemoa."
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "1 Mga Cronica 4:18",
              "text": "At ipinanganak ng kaniyang asawang Judia si Jered, na ama ni Gedor, at si Heber na ama ni Socho, at si Icuthiel na ama ni Zanoa. At ito ang mga anak ni Bethia na anak na babae ni Faraon, na naging asawa ni Mered."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "1 Mga Cronica 4:19",
              "text": "At ang mga anak ng asawa ni Odias, na kapatid na babae ni Naham, ay ang ama ni Keila na Garmita, at ni Esthemoa na Maachateo."
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "1 Mga Cronica 4:20",
              "text": "At ang mga anak ni Simon: si Amnon, at si Rinna, si Benhanan, at si Tilon. At ang mga anak ni Isi: si Zoheth, at si Benzoheth."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "1 Mga Cronica 4:21",
              "text": "Ang mga anak ni Sela na anak ni Juda: si Er na ama ni Lecha, at si Laada na ama ni Maresa, at ang mga angkan ng sangbahayan ng nagsisigawa ng mainam na kayong lino, sa sangbahayan ni Asbea;"
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "1 Mga Cronica 4:22",
              "text": "At si Jaocim, at ang mga lalake ni Chozeba, at si Joas, at si Saraph, na siyang mga nagpasuko sa Moab, at si Jasubi-lehem. At ang alaalang ito'y matanda na."
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "1 Mga Cronica 4:23",
              "text": "Ang mga ito'y mga magpapalyok, at mga taga Netaim at Gedera: doo'y nagsisitahan sila na kasama ng hari para sa kaniyang gawain."
            },
            {
              "chapter": 4,
              "verse": 24,
              "name": "1 Mga Cronica 4:24",
              "text": "Ang mga anak ni Simeon: si Nemuel, at si Jamin, si Jarib, si Zera, si Saul:"
            },
            {
              "chapter": 4,
              "verse": 25,
              "name": "1 Mga Cronica 4:25",
              "text": "Si Sallum na kaniyang anak, si Mibsam na kaniyang anak, si Misma na kaniyang anak."
            },
            {
              "chapter": 4,
              "verse": 26,
              "name": "1 Mga Cronica 4:26",
              "text": "At ang mga anak ni Misma: si Hamuel na kaniyang anak, si Sachur na kaniyang anak, si Simi na kaniyang anak."
            },
            {
              "chapter": 4,
              "verse": 27,
              "name": "1 Mga Cronica 4:27",
              "text": "At si Simi ay nagkaanak ng labing anim na lalake at anim na anak na babae; nguni't ang kaniyang mga kapatid ay di nagkaanak ng marami, o dumami man ang buong angkan nila na gaya ng mga anak ni Juda."
            },
            {
              "chapter": 4,
              "verse": 28,
              "name": "1 Mga Cronica 4:28",
              "text": "At sila'y nagsitahan sa Beer-seba, at sa Molada, at sa Hasar-sual;"
            },
            {
              "chapter": 4,
              "verse": 29,
              "name": "1 Mga Cronica 4:29",
              "text": "At sa Bala, at sa Esem, at sa Tholad;"
            },
            {
              "chapter": 4,
              "verse": 30,
              "name": "1 Mga Cronica 4:30",
              "text": "At sa Bethuel, at sa Horma, at sa Siclag;"
            },
            {
              "chapter": 4,
              "verse": 31,
              "name": "1 Mga Cronica 4:31",
              "text": "At sa Beth-marchaboth, at sa Hasa-susim, at sa Beth-birai, at sa Saaraim. Ito ang kanilang mga bayan hanggang sa paghahari ni David."
            },
            {
              "chapter": 4,
              "verse": 32,
              "name": "1 Mga Cronica 4:32",
              "text": "At ang kanilang mga nayon ay Etam, at Ain, Rimmon, at Tochen, at Asan, limang bayan:"
            },
            {
              "chapter": 4,
              "verse": 33,
              "name": "1 Mga Cronica 4:33",
              "text": "At ang lahat ng kanilang mga nayon ay nangasa palibot ng mga bayang yaon, hanggang sa Baal. Ang mga ito ang naging kanilang mga tahanan, at sila'y mayroong kanilang talaan ng lahi."
            },
            {
              "chapter": 4,
              "verse": 34,
              "name": "1 Mga Cronica 4:34",
              "text": "At si Mesobab, at si Jamlech, at si Josias na anak ni Amasias;"
            },
            {
              "chapter": 4,
              "verse": 35,
              "name": "1 Mga Cronica 4:35",
              "text": "At si Joel, at si Jehu na anak ni Josibias, na anak ni Seraiah, na anak ni Aziel;"
            },
            {
              "chapter": 4,
              "verse": 36,
              "name": "1 Mga Cronica 4:36",
              "text": "At si Elioenai, at si Jacoba, at si Jesohaia, at si Asaias, at si Adiel, at si Jesimiel, at si Benaias;"
            },
            {
              "chapter": 4,
              "verse": 37,
              "name": "1 Mga Cronica 4:37",
              "text": "At si Ziza, na anak ni Siphi, na anak ni Allon, na anak ni Jedaia, na anak ni Simri, na anak ni Semaias."
            },
            {
              "chapter": 4,
              "verse": 38,
              "name": "1 Mga Cronica 4:38",
              "text": "Ang mga itong nangabanggit sa pangalan ay mga prinsipe sa kanilang mga angkan: at ang mga sangbahayan ng kanilang mga magulang ay lumaking mainam."
            },
            {
              "chapter": 4,
              "verse": 39,
              "name": "1 Mga Cronica 4:39",
              "text": "At sila'y nagsiparoon sa pasukan ng Gador, hanggang sa dakong silanganan ng libis, upang ihanap ng pastulan ang kanilang mga kawan."
            },
            {
              "chapter": 4,
              "verse": 40,
              "name": "1 Mga Cronica 4:40",
              "text": "At sila'y nakasumpong ng mainam na pastulan at mabuti, at ang lupain ay maluwang, at tahimik, at payapa; sapagka't ang nagsisitahan nang una roon ay kay Cham."
            },
            {
              "chapter": 4,
              "verse": 41,
              "name": "1 Mga Cronica 4:41",
              "text": "At ang mga itong nangasusulat sa pangalan ay nagsiparoon sa mga kaarawan ni Ezechias na hari sa Juda, at iniwasak ang kanilang mga tolda, at ang mga Meunim na nangasumpungan doon, at nilipol na lubos, hanggang sa araw na ito, at sila'y nagsitahan na kahalili nila: sapagka't may pastulan doon sa kanilang mga kawan."
            },
            {
              "chapter": 4,
              "verse": 42,
              "name": "1 Mga Cronica 4:42",
              "text": "At ang iba sa kanila, sa makatuwid baga'y sa mga anak ni Simeon, na limang daang lalake, ay nagsiparoon sa bundok ng Seir, na ang kanilang mga punong kawal ay si Pelatia, at si Nearias, at si Rephaias, at si Uzziel, na mga anak ni Isi."
            },
            {
              "chapter": 4,
              "verse": 43,
              "name": "1 Mga Cronica 4:43",
              "text": "At kanilang sinaktan ang nalabi sa mga Amalecita na nakatanan, at tumahan doon hanggang sa araw na ito."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "1 Mga Cronica 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "1 Mga Cronica 5:1",
              "text": "At ang mga anak ni Ruben na panganay ni Israel (sapagka't siya ang panganay; nguni't sa paraang kaniyang dinumhan ang higaan ng kaniyang ama, ang kaniyang pagkapanganay ay ibinigay sa mga anak ni Jose na anak ni Israel; at sa talaan ng lahi ay hindi marapat ibilang ayon sa pagkapanganay."
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "1 Mga Cronica 5:2",
              "text": "Sapagka't si Juda'y nanaig sa kaniyang mga kapatid, at sa kaniya nanggaling ang pangulo; nguni't ang pagkapanganay ay kay Jose:)"
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "1 Mga Cronica 5:3",
              "text": "Ang mga anak ni Ruben na panganay ni Israel: si Enoch, at si Phallu, at si Esron, at si Charmi."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "1 Mga Cronica 5:4",
              "text": "Ang mga anak ni Joel: si Semaias na kaniyang anak, si Gog na kaniyang anak, si Simi na kaniyang anak,"
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "1 Mga Cronica 5:5",
              "text": "Si Micha na kaniyang anak, si Recaia na kaniyang anak, si Baal na kaniyang anak,"
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "1 Mga Cronica 5:6",
              "text": "Si Beera na kaniyang anak, na dinalang bihag ni Tilgath-pilneser na hari sa Asiria: siya'y prinsipe ng mga Rubenita."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "1 Mga Cronica 5:7",
              "text": "At ang kaniyang mga kapatid ayon sa kanilang mga angkan nang bilangin sa talaan ng kanilang mga lahi; ang pinuno'y si Jeiel, at si Zacharias,"
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "1 Mga Cronica 5:8",
              "text": "At si Bela, na anak ni Azaz, na anak ni Sema, na anak ni Joel, na tumatahan sa Aroer, hanggang sa Nebo at Baal-meon:"
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "1 Mga Cronica 5:9",
              "text": "At sa dakong silanganan ay tumahan hanggang sa pasukan sa ilang na mula sa ilog Eufrates, sapagka't ang kanilang mga hayop ay dumami sa lupain ng Galaad."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "1 Mga Cronica 5:10",
              "text": "At sa mga kaarawan ni Saul ay nakipagdigma sila sa mga Hagreo, na nangahulog sa kanilang kamay; at sila'y nagsitahan sa kanilang mga tolda sa buong lupaing silanganan ng Galaad."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "1 Mga Cronica 5:11",
              "text": "At ang mga anak ni Gad ay nagsitahan sa tapat nila, sa lupain ng Basan hanggang sa Salca:"
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "1 Mga Cronica 5:12",
              "text": "Si Joel ang pinuno, at si Sepham ang ikalawa, at si Janai, at si Saphat sa Basan:"
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "1 Mga Cronica 5:13",
              "text": "At ang kanilang mga kapatid sa mga sangbahayan ng kanilang mga magulang: si Michael, at si Mesullam, at si Seba, at si Jorai, si Jachan, at si Zia, at si Heber, pito."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "1 Mga Cronica 5:14",
              "text": "Ang mga ito ang mga anak ni Abihail na anak ni Huri, na anak ni Jaroa, na anak ni Galaad, na anak ni Michael, na anak ni Jesiai, na anak ni Jaddo, na anak ni Buz;"
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "1 Mga Cronica 5:15",
              "text": "Si Ahi na anak ni Abdiel, na anak ni Guni, na pinuno sa mga sangbahayan ng kanilang mga magulang."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "1 Mga Cronica 5:16",
              "text": "At sila'y nagsitahan sa Galaad sa Basan, at sa kaniyang mga bayan, at sa lahat ng palibot ng Saron, na kasinglayo ng kanilang mga hangganan."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "1 Mga Cronica 5:17",
              "text": "Ang lahat ng mga ito'y nangasulat sa pamamagitan ng mga talaan ng lahi sa mga kaarawan ni Jotham na hari sa Juda, at sa mga kaarawan ni Jeroboam na hari sa Israel."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "1 Mga Cronica 5:18",
              "text": "Ang mga anak ni Ruben, at ang mga Gadita, at ang kalahating lipi ni Manases, na mga matapang na lalake na mga lalaking makadadala ng kalasag at tabak, at makapagpapahilagpos ng busog, at bihasa sa pakikipagdigma, ay apat na pu't apat na libo, at pitong daan at anim na pu na makalalabas sa pakikipagdigma."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "1 Mga Cronica 5:19",
              "text": "At sila'y nakipagdigma sa mga Hagreo, kay Jethur, at kay Naphis, at kay Nodab."
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "1 Mga Cronica 5:20",
              "text": "At sila'y tinulungan sa pakikilaban sa kanila, at ang mga Hagreo ay ibinigay sa kanilang kamay, at ang lahat sa nangasa kanila: sapagka't sila'y nagsidalangin sa Dios sa pagbabaka, at kaniyang inayunan sila; sapagka't sila'y naglagak ng kanilang tiwala sa kaniya."
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "1 Mga Cronica 5:21",
              "text": "At kanilang dinala ang kanilang mga hayop; sa kanilang mga kamelyo ay limangpung libo, at sa mga tupa ay dalawang daan at limangpung libo, at sa mga asno ay dalawang libo, at sa mga lalake ay isang daang libo."
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "1 Mga Cronica 5:22",
              "text": "Sapagka't maraming nangapatay na nangabuwal, sapagka't ang pagdidigma ay sa Dios. At sila'y nagsitahan na kahalili nila hanggang sa pagkabihag."
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "1 Mga Cronica 5:23",
              "text": "At ang mga anak ng kalahating lipi ni Manases ay tumahan sa lupain: sila'y nagsidami mula sa Basan hanggang sa Baal-hermon at sa Senir at sa bundok ng Hermon."
            },
            {
              "chapter": 5,
              "verse": 24,
              "name": "1 Mga Cronica 5:24",
              "text": "At ang mga ito ang mga pangulo ng mga sangbahayan ng kanilang mga magulang: sa makatuwid baga'y si Epher, at si Isi, at si Eliel, at si Azriel, at si Jeremias, at si Odavia, at si Jadiel, na mga makapangyarihang lalaking may tapang, na mga bantog na lalake, na mga pangulo sa mga sangbahayan ng kanilang mga magulang."
            },
            {
              "chapter": 5,
              "verse": 25,
              "name": "1 Mga Cronica 5:25",
              "text": "At sila'y nagsisuway laban sa Dios ng kanilang mga magulang, at yumaong sumamba sa mga dios ng mga bayan ng lupain, na nilipol ng Dios sa harap nila."
            },
            {
              "chapter": 5,
              "verse": 26,
              "name": "1 Mga Cronica 5:26",
              "text": "At hinikayat ng Dios ng Israel ang diwa ni Phul na hari sa Asiria, at ang diwa ni Tilgath-pilneser na hari sa Asiria, at dinalang bihag sila, sa makatuwid baga'y ang mga Rubenita, at ang mga Gadita, at ang kalahati ng lipi ni Manases, at dinala hanggang sa Hala, at sa Habor, at sa Hara, at sa ilog ng Gozan, hanggang sa araw na ito."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "1 Mga Cronica 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "1 Mga Cronica 6:1",
              "text": "Ang mga anak ni Levi: si Gerson, si Coath, at si Merari."
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "1 Mga Cronica 6:2",
              "text": "At ang mga anak ni Coath: si Amram, si Ishar, at si Hebron, at si Uzziel."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "1 Mga Cronica 6:3",
              "text": "At ang mga anak ni Amram: si Aaron, at si Moises, at si Mariam. At ang mga anak ni Aaron: si Nadab, at si Abiu, si Eleazar, at si Ithamar."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "1 Mga Cronica 6:4",
              "text": "Naging anak ni Eleazar si Phinees, naging anak ni Phinees si Abisua;"
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "1 Mga Cronica 6:5",
              "text": "At naging anak ni Abisua si Bucci, at naging anak ni Bucci si Uzzi;"
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "1 Mga Cronica 6:6",
              "text": "At naging anak ni Uzzi si Zeraias, at naging anak ni Zeraias si Meraioth;"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "1 Mga Cronica 6:7",
              "text": "Naging anak ni Meraioth si Amarias, at naging anak ni Amarias si Achitob;"
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "1 Mga Cronica 6:8",
              "text": "At naging anak ni Achitob si Sadoc, at naging anak ni Sadoc si Achimaas;"
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "1 Mga Cronica 6:9",
              "text": "At naging anak ni Achimaas si Azarias, at naging anak ni Azarias si Johanan;"
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "1 Mga Cronica 6:10",
              "text": "At naging anak ni Johanan si Azarias (na siyang pangulong saserdote sa bahay na itinayo ni Salomon sa Jerusalem:)"
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "1 Mga Cronica 6:11",
              "text": "At naging anak ni Azarias si Amarias, at naging anak ni Amarias si Achitob;"
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "1 Mga Cronica 6:12",
              "text": "At naging anak ni Achitob si Sadoc, at naging anak ni Sadoc si Sallum;"
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "1 Mga Cronica 6:13",
              "text": "At naging anak ni Sallum si Hilcias, at naging anak ni Hilcias si Azarias;"
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "1 Mga Cronica 6:14",
              "text": "At naging anak ni Azarias si Seraiah, at naging anak ni Seraiah si Josadec;"
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "1 Mga Cronica 6:15",
              "text": "At si Josadec ay nabihag nang dalhing bihag ng Panginoon ang Juda at ang Jerusalem sa pamamagitan ng kamay ni Nabucodonosor."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "1 Mga Cronica 6:16",
              "text": "Ang mga anak ni Levi: si Gersom, si Coath, at si Merari."
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "1 Mga Cronica 6:17",
              "text": "At ang mga ito ang mga pangalan ng mga anak ni Gersom: si Libni at si Simi."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "1 Mga Cronica 6:18",
              "text": "At ang mga anak ni Coath ay si Amram, at si Ishar at si Hebron, at si Uzziel."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "1 Mga Cronica 6:19",
              "text": "Ang mga anak ni Merari: si Mahali at si Musi. At ang mga ito ang mga angkan ng mga Levita ayon sa mga sangbahayan ng kanilang mga magulang."
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "1 Mga Cronica 6:20",
              "text": "Kay Gerson: si Libni na kaniyang anak, si Joath na kaniyang anak, si Zimma na kaniyang anak;"
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "1 Mga Cronica 6:21",
              "text": "Si Joab na kaniyang anak, si Iddo na kaniyang anak, si Zera na kaniyang anak, si Jeothrai na kaniyang anak."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "1 Mga Cronica 6:22",
              "text": "Ang mga anak ni Coath: si Aminadab na kaniyang anak, si Core na kaniyang anak, si Asir na kaniyang anak;"
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "1 Mga Cronica 6:23",
              "text": "Si Elcana na kaniyang anak, at si Abiasaph na kaniyang anak, at si Asir na kaniyang anak;"
            },
            {
              "chapter": 6,
              "verse": 24,
              "name": "1 Mga Cronica 6:24",
              "text": "Si Thahath na kaniyang anak, si Uriel na kaniyang anak, si Uzzia na kaniyang anak, at si Saul na kaniyang anak."
            },
            {
              "chapter": 6,
              "verse": 25,
              "name": "1 Mga Cronica 6:25",
              "text": "At ang mga anak ni Elcana: si Amasai at si Achimoth."
            },
            {
              "chapter": 6,
              "verse": 26,
              "name": "1 Mga Cronica 6:26",
              "text": "Tungkol kay Elcana, ang mga anak ni Elcana: si Sophai na kaniyang anak, at si Nahath na kaniyang anak;"
            },
            {
              "chapter": 6,
              "verse": 27,
              "name": "1 Mga Cronica 6:27",
              "text": "Si Eliab na kaniyang anak, si Jeroham na kaniyang anak, si Elcana na kaniyang anak."
            },
            {
              "chapter": 6,
              "verse": 28,
              "name": "1 Mga Cronica 6:28",
              "text": "At ang mga anak ni Samuel: ang panganay ay si Joel, at ang ikalawa'y si Abias."
            },
            {
              "chapter": 6,
              "verse": 29,
              "name": "1 Mga Cronica 6:29",
              "text": "Ang mga anak ni Merari: si Mahali, si Libni na kaniyang anak, si Simi na kaniyang anak, si Uzza na kaniyang anak;"
            },
            {
              "chapter": 6,
              "verse": 30,
              "name": "1 Mga Cronica 6:30",
              "text": "Si Sima na kaniyang anak, si Haggia na kaniyang anak, si Assia na kaniyang anak."
            },
            {
              "chapter": 6,
              "verse": 31,
              "name": "1 Mga Cronica 6:31",
              "text": "At ang mga ito ang mga inilagay ni David sa pag-awit sa bahay ng Panginoon, pagkatapos na maipagpahinga ang kaban."
            },
            {
              "chapter": 6,
              "verse": 32,
              "name": "1 Mga Cronica 6:32",
              "text": "At sila'y nagsipangasiwa sa pamamagitan ng awit sa harap ng tolda ng tabernakulo ng kapisanan hanggang sa itinayo ni Salomon ang bahay ng Panginoon sa Jerusalem: at sila'y nagsipaglingkod sa kanilang katungkulan ayon sa kanilang pagkakahalihalili."
            },
            {
              "chapter": 6,
              "verse": 33,
              "name": "1 Mga Cronica 6:33",
              "text": "At ang mga ito ang nagsipaglingkod at ang kanilang mga anak. Sa mga anak ng mga Coathita: si Heman, na mangaawit, na anak ni Joel, na anak ni Samuel;"
            },
            {
              "chapter": 6,
              "verse": 34,
              "name": "1 Mga Cronica 6:34",
              "text": "Na anak ni Elcana, na anak ni Jeroham, na anak ni Eliel, na anak ni Thoa;"
            },
            {
              "chapter": 6,
              "verse": 35,
              "name": "1 Mga Cronica 6:35",
              "text": "Na anak ni Suph, na anak ni Elcana, na anak ni Mahath, na anak ni Amasai;"
            },
            {
              "chapter": 6,
              "verse": 36,
              "name": "1 Mga Cronica 6:36",
              "text": "Na anak ni Elcana, na anak ni Joel, na anak ni Azarias, na anak ni Sophonias;"
            },
            {
              "chapter": 6,
              "verse": 37,
              "name": "1 Mga Cronica 6:37",
              "text": "Na anak ni Thahat, na anak ni Asir, na anak ni Ahiasaph, na anak ni Core;"
            },
            {
              "chapter": 6,
              "verse": 38,
              "name": "1 Mga Cronica 6:38",
              "text": "Na anak ni Ishar, na anak ni Coath, na anak ni Levi, na anak ni Israel."
            },
            {
              "chapter": 6,
              "verse": 39,
              "name": "1 Mga Cronica 6:39",
              "text": "At ang kaniyang kapatid na si Asaph, na siyang nakatayo sa kaniyang kanan, sa makatuwid baga'y si Asaph na anak ni Berachias, na anak ni Sima;"
            },
            {
              "chapter": 6,
              "verse": 40,
              "name": "1 Mga Cronica 6:40",
              "text": "Na anak ni Michael, na anak ni Baasias, na anak ni Malchias;"
            },
            {
              "chapter": 6,
              "verse": 41,
              "name": "1 Mga Cronica 6:41",
              "text": "Na anak ni Athanai, na anak ni Zera, na anak ni Adaia;"
            },
            {
              "chapter": 6,
              "verse": 42,
              "name": "1 Mga Cronica 6:42",
              "text": "Na anak ni Ethan, na anak ni Zimma, na anak ni Simi;"
            },
            {
              "chapter": 6,
              "verse": 43,
              "name": "1 Mga Cronica 6:43",
              "text": "Na anak ni Jahat, na anak ni Gersom, na anak ni Levi."
            },
            {
              "chapter": 6,
              "verse": 44,
              "name": "1 Mga Cronica 6:44",
              "text": "At sa kaliwa ay ang kanilang mga kapatid na mga anak ni Merari: si Ethan na anak ni Chisi, na anak ni Abdi, na anak ni Maluch;"
            },
            {
              "chapter": 6,
              "verse": 45,
              "name": "1 Mga Cronica 6:45",
              "text": "Na anak ni Hasabias, na anak ni Amasias, na anak ni Hilcias;"
            },
            {
              "chapter": 6,
              "verse": 46,
              "name": "1 Mga Cronica 6:46",
              "text": "Na anak ni Amasias, na anak ni Bani, na anak ni Semer;"
            },
            {
              "chapter": 6,
              "verse": 47,
              "name": "1 Mga Cronica 6:47",
              "text": "Na anak ni Mahali, na anak ni Musi, na anak ni Merari, na anak ni Levi."
            },
            {
              "chapter": 6,
              "verse": 48,
              "name": "1 Mga Cronica 6:48",
              "text": "At ang kanilang mga kapatid na mga Levita ay nangahalal sa buong paglilingkod sa tabernakulo ng bahay ng Dios."
            },
            {
              "chapter": 6,
              "verse": 49,
              "name": "1 Mga Cronica 6:49",
              "text": "Nguni't si Aaron at ang kaniyang mga anak ay nagsipaghandog sa ibabaw ng dambana ng handog na susunugin, at sa ibabaw ng dambana ng kamangyan, para sa buong gawain sa kabanalbanalang dako, at upang tubusin sa sala ang Israel, ayon sa lahat na iniutos ni Moises na lingkod ng Dios."
            },
            {
              "chapter": 6,
              "verse": 50,
              "name": "1 Mga Cronica 6:50",
              "text": "At ang mga ito ang mga anak ni Aaron: si Eleazar na kaniyang anak, si Phinees na kaniyang anak, si Abisua na kaniyang anak,"
            },
            {
              "chapter": 6,
              "verse": 51,
              "name": "1 Mga Cronica 6:51",
              "text": "Si Bucci na kaniyang anak, si Uzzi na kaniyang anak, si Zeraias na kaniyang anak,"
            },
            {
              "chapter": 6,
              "verse": 52,
              "name": "1 Mga Cronica 6:52",
              "text": "Si Meraioth na kaniyang anak, si Amarias na kaniyang anak, si Achitob na kaniyang anak,"
            },
            {
              "chapter": 6,
              "verse": 53,
              "name": "1 Mga Cronica 6:53",
              "text": "Si Sadoc na kaniyang anak, si Achimaas na kaniyang anak."
            },
            {
              "chapter": 6,
              "verse": 54,
              "name": "1 Mga Cronica 6:54",
              "text": "Ang mga ito nga ang kanilang mga tahanang dako ayon sa kanilang mga kampamento sa kanilang mga hangganan; sa mga anak ni Aaron, na sa mga angkan ng mga Coathita, (sapagka't sa kanila ang unang palad.)"
            },
            {
              "chapter": 6,
              "verse": 55,
              "name": "1 Mga Cronica 6:55",
              "text": "Sa kanila ibinigay nila ang Hebron sa lupain ng Juda, at ang mga nayon niyaon sa palibot,"
            },
            {
              "chapter": 6,
              "verse": 56,
              "name": "1 Mga Cronica 6:56",
              "text": "Nguni't ang mga bukid ng bayan, at ang mga nayon niyaon, ay kanilang ibinigay kay Caleb na anak ni Jephone."
            },
            {
              "chapter": 6,
              "verse": 57,
              "name": "1 Mga Cronica 6:57",
              "text": "At sa mga anak ni Aaron ay kanilang ibinigay ang mga bayang ampunan, ang Hebron; gayon din ang Libna pati ng mga nayon niyaon, at ang Jathir, at ang Esthemoa pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 58,
              "name": "1 Mga Cronica 6:58",
              "text": "At ang Hilem pati ng mga nayon niyaon, ang Debir pati ng mga nayon niyaon;"
            },
            {
              "chapter": 6,
              "verse": 59,
              "name": "1 Mga Cronica 6:59",
              "text": "At ang Asan pati ng mga nayon niyaon, at ang Beth-semes pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 60,
              "name": "1 Mga Cronica 6:60",
              "text": "At mula sa lipi ni Benjamin; ang Geba pati ng mga nayon niyaon, at ang Alemeth pati ng mga nayon niyaon, at ang Anathoth pati ng mga nayon niyaon. Ang lahat na kanilang bayan sa lahat na kanilang angkan ay labing tatlong bayan."
            },
            {
              "chapter": 6,
              "verse": 61,
              "name": "1 Mga Cronica 6:61",
              "text": "At sa nalabi sa mga anak ni Coath ay nabigay sa pamamagitan ng sapalaran, sa angkan ng lipi, sa kalahating lipi, na kalahati ng Manases, sangpung bayan."
            },
            {
              "chapter": 6,
              "verse": 62,
              "name": "1 Mga Cronica 6:62",
              "text": "At sa mga anak ni Gerson, ayon sa kanilang mga angkan, sa lipi ni Issachar, at sa lipi ni Aser, at sa lipi ni Nephtali, at sa lipi ni Manases sa Basan, labing tatlong bayan."
            },
            {
              "chapter": 6,
              "verse": 63,
              "name": "1 Mga Cronica 6:63",
              "text": "Sa mga anak ni Merari ay nabigay sa pamamagitan ng sapalaran, ayon sa kanilang mga angkan sa lipi ni Ruben, at sa lipi ni Gad, at sa lipi ni Zabulon, labing dalawang bayan."
            },
            {
              "chapter": 6,
              "verse": 64,
              "name": "1 Mga Cronica 6:64",
              "text": "At ibinigay ng mga anak ni Israel sa mga Levita ang mga bayan pati ng mga nayon niyaon."
            },
            {
              "chapter": 6,
              "verse": 65,
              "name": "1 Mga Cronica 6:65",
              "text": "At kanilang ibinigay sa pamamagitan ng sapalaran sa lipi ng mga anak ni Juda, at sa lipi ng mga anak ni Simeon, at sa lipi ng mga anak ni Benjamin, ang mga bayang ito na binanggit sa pangalan."
            },
            {
              "chapter": 6,
              "verse": 66,
              "name": "1 Mga Cronica 6:66",
              "text": "At ang ilan sa mga angkan ng mga anak ni Coath ay may mga bayan sa kanilang mga hangganan na mula sa lipi ni Ephraim."
            },
            {
              "chapter": 6,
              "verse": 67,
              "name": "1 Mga Cronica 6:67",
              "text": "At ibinigay nila sa kanila ang mga bayang ampunan: ang Sichem sa lupaing maburol ng Ephraim pati ng mga nayon niyaon; gayon din ang Gezer pati ng mga nayon niyaon."
            },
            {
              "chapter": 6,
              "verse": 68,
              "name": "1 Mga Cronica 6:68",
              "text": "At ang Jocmeam pati ng mga nayon niyaon, at ang Bet-horon pati ng mga nayon niyaon;"
            },
            {
              "chapter": 6,
              "verse": 69,
              "name": "1 Mga Cronica 6:69",
              "text": "At ang Ajalon pati ng mga nayon niyaon; at ang Gath-rimmon pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 70,
              "name": "1 Mga Cronica 6:70",
              "text": "At mula sa kalahating lipi ni Manases; ang Aner pati ng mga nayon niyaon, at ang Bilam pati ng mga nayon niyaon, sa ganang nangalabi sa angkan ng mga anak ng Coath."
            },
            {
              "chapter": 6,
              "verse": 71,
              "name": "1 Mga Cronica 6:71",
              "text": "Sa mga anak ng Gerson ay nabigay, mula sa angkan ng kalahating lipi ni Manases, ang Golan sa Basan pati ng mga nayon niyaon, at ang Astharoth pati ng mga nayon niyaon;"
            },
            {
              "chapter": 6,
              "verse": 72,
              "name": "1 Mga Cronica 6:72",
              "text": "At mula sa lipi ni Issachar, ang Cedes pati ng mga nayon niyaon, ang Dobrath pati ng mga nayon niyaon;"
            },
            {
              "chapter": 6,
              "verse": 73,
              "name": "1 Mga Cronica 6:73",
              "text": "At ang Ramoth pati ng mga nayon niyaon, at ang Anem pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 74,
              "name": "1 Mga Cronica 6:74",
              "text": "At mula sa lipi ni Aser; ang Masal pati ng mga nayon niyaon, at ang Abdon pati ng mga nayon niyaon;"
            },
            {
              "chapter": 6,
              "verse": 75,
              "name": "1 Mga Cronica 6:75",
              "text": "At ang Ucoc pati ng mga nayon niyaon, at ang Rehob pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 76,
              "name": "1 Mga Cronica 6:76",
              "text": "At mula sa lipi ni Nephtali; ang Cedes sa Galilea pati ng mga nayon niyaon, at ang Ammon pati ng mga nayon niyaon, at ang Chiriat-haim pati ng mga nayon niyaon."
            },
            {
              "chapter": 6,
              "verse": 77,
              "name": "1 Mga Cronica 6:77",
              "text": "Sa nangalabi sa mga Levita, na mga anak ni Merari, ay nabigay mula sa lipi ni Zabulon, ang Rimmono pati ng mga nayon niyaon, ang Thabor pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 78,
              "name": "1 Mga Cronica 6:78",
              "text": "At sa dako roon ng Jordan sa Jerico sa dakong silanganan ng Jordan nabigay sa kanila, mula sa lipi ni Ruben, ang Beser sa ilang pati ng mga nayon niyaon, at ang Jasa pati ng mga nayon niyaon,"
            },
            {
              "chapter": 6,
              "verse": 79,
              "name": "1 Mga Cronica 6:79",
              "text": "At ang Chedemoth pati ng mga nayon niyaon, at ang Mephaath pati ng mga nayon niyaon:"
            },
            {
              "chapter": 6,
              "verse": 80,
              "name": "1 Mga Cronica 6:80",
              "text": "At mula sa lipi ni Gad; ang Ramot sa Galaad pati ng mga nayon niyaon, at ang Mahanaim pati ng mga nayon niyaon,"
            },
            {
              "chapter": 6,
              "verse": 81,
              "name": "1 Mga Cronica 6:81",
              "text": "At ang Hesbon pati ng mga nayon niyaon, at ang Jacer pati ng mga nayon niyaon."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "1 Mga Cronica 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "1 Mga Cronica 7:1",
              "text": "At sa mga anak ni Issachar; si Thola, at si Phua, si Jabsub, at si Simron, apat."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "1 Mga Cronica 7:2",
              "text": "At sa mga anak ni Thola: si Uzzi, at si Rephaias, at si Jeriel, at si Jamai, at si Jibsam, at si Samuel, mga pangulo sa mga sangbahayan ng kanilang mga magulang, sa makatuwid baga'y ni Thola; mga makapangyarihang lalaking may tapang sa kanilang mga lahi: ang kanilang bilang sa mga kaarawan ni David ay dalawang pu't dalawang libo at anim na raan."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "1 Mga Cronica 7:3",
              "text": "At ang mga anak ni Uzzi: si Izrahias: at ang mga anak ni Izrahias: si Michael, at si Obadias, at si Joel, si Isias, lima: silang lahat ay mga pinuno."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "1 Mga Cronica 7:4",
              "text": "At sa kasamahan nila, ayon sa kanilang mga lahi, ayon sa mga sangbahayan ng kanilang mga magulang, may mga pulutong ng hukbo sa pakikipagdigma, tatlong pu't anim na libo: sapagka't sila'y nagkaroon ng maraming asawa at mga anak."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "1 Mga Cronica 7:5",
              "text": "At ang kanilang mga kapatid sa lahat na angkan ni Issachar, na mga makapangyarihang lalaking may tapang, na nangabilang silang lahat, ayon sa talaan ng lahi, ay walong pu't pitong libo."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "1 Mga Cronica 7:6",
              "text": "Ang mga anak ni Benjamin: si Bela, at si Becher, at si Jediael, tatlo."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "1 Mga Cronica 7:7",
              "text": "At ang mga anak ni Bela: si Esbon, at si Uzzi, at si Uzziel, at si Jerimoth, at si Iri, lima; mga pangulo sa mga sangbahayan ng mga magulang, mga makapangyarihang lalaking may tapang; at sila'y nangabilang ayon sa talaan ng lahi, ay dalawang pu't dalawang libo at tatlong pu't apat."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "1 Mga Cronica 7:8",
              "text": "At ang mga anak ni Becher: si Zemira, at si Joas, at si Eliezer, at si Elioenai, at si Omri, at si Jerimoth, at si Abias, at si Anathoth, at si Alemeth. Lahat ng ito'y mga anak ni Becher."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "1 Mga Cronica 7:9",
              "text": "At sila'y nangabilang ayon sa talaan ng lahi, ayon sa kanilang lahi, na mga pangulo sa mga sangbahayan ng kanilang mga magulang, na mga makapangyarihang lalaking may tapang, dalawang pung libo at dalawang daan."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "1 Mga Cronica 7:10",
              "text": "At ang mga anak ni Jediael: si Bilhan: at ang mga anak ni Bilhan: si Jebus, at si Benjamin, at si Aod, at si Chenaana, at si Zethan, at si Tharsis, at si Ahisahar."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "1 Mga Cronica 7:11",
              "text": "Lahat ng ito'y mga anak ni Jediael, ayon sa mga pangulo ng mga sangbahayan ng kanilang mga magulang, na mga makapangyarihang lalaking may tapang labing pitong libo at dalawang daan na nakalalabas sa hukbo upang makidigma."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "1 Mga Cronica 7:12",
              "text": "Si Suppim rin naman, at si Huppim na mga anak ni Hir, si Husim na mga anak ni Aher."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "1 Mga Cronica 7:13",
              "text": "Ang mga anak ni Nephtali: si Jaoel, at si Guni, at si Jezer, at si Sallum, na mga anak ni Bilha."
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "1 Mga Cronica 7:14",
              "text": "Ang mga anak ni Manases: si Asriel, na siyang ipinanganak ng kaniyang babae na Aramita; ipinanganak niya si Machir na ama ni Galaad."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "1 Mga Cronica 7:15",
              "text": "At si Machir ay nagasawa kay Huppim at kay Suppim, na ang pangalan ng kapatid na babae nila ay Maacha; at ang pangalan ng ikalawa ay Salphaad: at si Salphaad ay nagkaanak ng mga babae."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "1 Mga Cronica 7:16",
              "text": "At si Maacha na asawa ni Machir ay nanganak ng isang lalake, at tinawag niya ang kaniyang pangalan na Peres; at ang pangalan ng kaniyang kapatid ay Seres; at ang kaniyang mga anak ay si Ulam at si Recem."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "1 Mga Cronica 7:17",
              "text": "At ang mga anak ni Ulam; si Bedan. Ito ang mga anak ni Galaad na anak ni Machir, na anak ni Manases."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "1 Mga Cronica 7:18",
              "text": "At ipinanganak ng kaniyang kapatid na babae na si Molechet si Ichod, at si Abiezer, at si Mahala."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "1 Mga Cronica 7:19",
              "text": "At ang mga anak ni Semida ay si Ahian, at si Sechem at si Licci, at si Aniam."
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "1 Mga Cronica 7:20",
              "text": "At ang mga anak ni Ephraim: si Suthela, at si Bered na kaniyang anak, at si Thahath na kaniyang anak, at si Elada na kaniyang anak, at si Thahath na kaniyang anak."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "1 Mga Cronica 7:21",
              "text": "At si Zabad na kaniyang anak, at si Suthela na kaniyang anak, at si Ezer, at si Elad, na siyang mga pinatay ng mga lalake ng Gath na mga ipinanganak sa lupain, sapagka't sila'y nagsilusong upang kunin ang kanilang mga hayop."
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "1 Mga Cronica 7:22",
              "text": "At si Ephraim na kanilang ama ay tumangis na maraming araw, at ang kaniyang mga kapatid ay nagsiparoon upang aliwin siya."
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "1 Mga Cronica 7:23",
              "text": "At siya'y sumiping sa kaniyang asawa, at siya'y naglihi, at nagkaanak ng isang lalake, at tinawag niya ang kaniyang pangalan na Beria, sapagka't sumakaniyang bahay ang kasamaan."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "1 Mga Cronica 7:24",
              "text": "At ang kaniyang anak na babae ay si Seera, na siyang nagtayo ng Bet-horon sa ibaba at sa itaas, at ng Uzzen-seera."
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "1 Mga Cronica 7:25",
              "text": "At naging anak niya si Repha, at si Reseph, at si Thela na kaniyang anak, at si Taan na kaniyang anak;"
            },
            {
              "chapter": 7,
              "verse": 26,
              "name": "1 Mga Cronica 7:26",
              "text": "Si Laadan na kaniyang anak, si Ammiud na kaniyang anak, si Elisama na kaniyang anak;"
            },
            {
              "chapter": 7,
              "verse": 27,
              "name": "1 Mga Cronica 7:27",
              "text": "Si Nun na kaniyang anak, si Josue na kaniyang anak."
            },
            {
              "chapter": 7,
              "verse": 28,
              "name": "1 Mga Cronica 7:28",
              "text": "At ang kanilang mga pag-aari at mga tahanan ay ang Beth-el at ang mga nayon niyaon, at ang dakong silanganan ng Naaran, at ang dakong kalunuran ng Gezer pati ng mga nayon niyaon; ang Sichem rin naman at ang mga nayon niyaon, hanggang sa Asa at ang mga nayon niyaon:"
            },
            {
              "chapter": 7,
              "verse": 29,
              "name": "1 Mga Cronica 7:29",
              "text": "At sa siping ng mga hangganan ng mga anak ni Manases, ang Beth-sean at ang mga nayon niyaon, ang Thanach at ang mga nayon niyaon, ang Megiddo at ang mga nayon niyaon, ang Dor at ang mga nayon niyaon. Sa mga ito nagsitahan ang mga anak ni Jose na anak ni Israel."
            },
            {
              "chapter": 7,
              "verse": 30,
              "name": "1 Mga Cronica 7:30",
              "text": "Ang mga anak ni Aser: si Imna, at si Isua, at si Isui, at si Beria, at si Sera na kanilang kapatid na babae."
            },
            {
              "chapter": 7,
              "verse": 31,
              "name": "1 Mga Cronica 7:31",
              "text": "At ang mga anak ni Beria: si Heber, at si Machiel na siyang ama ni Birzabith."
            },
            {
              "chapter": 7,
              "verse": 32,
              "name": "1 Mga Cronica 7:32",
              "text": "At naging anak ni Heber si Japhlet, at si Semer, at si Hotham, at si Sua na kapatid na babae nila."
            },
            {
              "chapter": 7,
              "verse": 33,
              "name": "1 Mga Cronica 7:33",
              "text": "At ang mga anak ni Japhlet si Pasac, at si Bimhal, at si Asvath. Ang mga ito ang mga anak ni Japhlet."
            },
            {
              "chapter": 7,
              "verse": 34,
              "name": "1 Mga Cronica 7:34",
              "text": "At ang mga anak ni Semer, si Ahi, at si Roga, si Jehubba, at si Aram."
            },
            {
              "chapter": 7,
              "verse": 35,
              "name": "1 Mga Cronica 7:35",
              "text": "At ang mga anak ni Helem na kaniyang kapatid: si Sopha, at si Imna, at si Selles, at si Amal."
            },
            {
              "chapter": 7,
              "verse": 36,
              "name": "1 Mga Cronica 7:36",
              "text": "Ang mga anak ni Sopha: si Sua, at si Harnapher, at si Sual, at si Beri; at si Imra:"
            },
            {
              "chapter": 7,
              "verse": 37,
              "name": "1 Mga Cronica 7:37",
              "text": "Si Beser, at si Hod, at si Samma, at si Silsa, at si Ithram, at si Beera."
            },
            {
              "chapter": 7,
              "verse": 38,
              "name": "1 Mga Cronica 7:38",
              "text": "At ang mga anak ni Jether: si Jephone, at si Pispa, at si Ara."
            },
            {
              "chapter": 7,
              "verse": 39,
              "name": "1 Mga Cronica 7:39",
              "text": "At ang mga anak ni Ulla: si Ara, at si Haniel, at si Resia."
            },
            {
              "chapter": 7,
              "verse": 40,
              "name": "1 Mga Cronica 7:40",
              "text": "Ang lahat na ito ay mga anak ni Aser, mga pangulo sa mga sangbahayan ng mga magulang, mga pili at makapangyarihang lalake na may tapang, mga pinuno ng mga prinsipe. At ang bilang nilang nangabilang ayon sa talaan ng lahi sa paglilingkod sa pagdidigma ay dalawang pu't anim na libong lalake."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "1 Mga Cronica 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "1 Mga Cronica 8:1",
              "text": "At naging anak ni Benjamin si Bela na kaniyang panganay, si Asbel ang ikalawa, at si Ara ang ikatlo;"
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "1 Mga Cronica 8:2",
              "text": "Si Noha ang ikaapat, at si Rapha ang ikalima."
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "1 Mga Cronica 8:3",
              "text": "At ang mga naging anak ni Bela: si Addar, at si Gera, at si Abiud;"
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "1 Mga Cronica 8:4",
              "text": "At si Abisua, at si Naaman, at si Ahoa,"
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "1 Mga Cronica 8:5",
              "text": "At si Gera, at si Sephuphim, at si Huram."
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "1 Mga Cronica 8:6",
              "text": "At ang mga ito ang mga anak ni Ehud; ang mga ito ang mga pangulo sa mga sangbahayan ng mga magulang ng mga taga Gabaa, at dinala nila silang bihag sa Manahath."
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "1 Mga Cronica 8:7",
              "text": "At si Naaman, at si Achias, at si Gera, ay kaniyang dinalang bihag; at kaniyang ipinanganak si Uzza at si Ahihud."
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "1 Mga Cronica 8:8",
              "text": "At si Saharaim ay nagkaanak sa parang ng Moab, pagkatapos na kaniyang mapagpaalam sila; si Husim, at si Baara ay ang kaniyang mga asawa."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "1 Mga Cronica 8:9",
              "text": "At ipinanganak sa kaniya ni Chodes na kaniyang asawa, si Jobab, at si Sibias, at si Mesa, at si Malcham,"
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "1 Mga Cronica 8:10",
              "text": "At si Jeus, at si Sochias, at si Mirma. Ang mga ito ang kaniyang mga anak na mga pangulo sa mga sangbahayan ng mga magulang."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "1 Mga Cronica 8:11",
              "text": "At ipinanganak sa kaniya ni Husim si Abitob, at si Elphaal."
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "1 Mga Cronica 8:12",
              "text": "At ang mga anak ni Elphaal: si Heber, at si Misam, at si Semeb, na siyang nagsipagtayo ng Ono at ng Loth, pati ng mga nayon niyaon:"
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "1 Mga Cronica 8:13",
              "text": "At si Berias, at si Sema na mga pangulo sa mga sangbahayan ng mga magulang ng mga taga Ajalon na siyang nangagpatakas sa mga taga Gath;"
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "1 Mga Cronica 8:14",
              "text": "At si Ahio, si Sasac, at si Jeremoth;"
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "1 Mga Cronica 8:15",
              "text": "At si Zebadias, at si Arad, at si Heder;"
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "1 Mga Cronica 8:16",
              "text": "At si Michael, at si Ispha, at si Joa, na mga anak ni Berias;"
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "1 Mga Cronica 8:17",
              "text": "At si Zebadias, at si Mesullam, at si Hizchi, at si Heber."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "1 Mga Cronica 8:18",
              "text": "At si Ismari, at si Izlia, at si Jobab, na mga anak ni Elphaal;"
            },
            {
              "chapter": 8,
              "verse": 19,
              "name": "1 Mga Cronica 8:19",
              "text": "At si Jacim, at si Zichri, at si Zabdi;"
            },
            {
              "chapter": 8,
              "verse": 20,
              "name": "1 Mga Cronica 8:20",
              "text": "At si Elioenai, at si Silithai, at si Eliel;"
            },
            {
              "chapter": 8,
              "verse": 21,
              "name": "1 Mga Cronica 8:21",
              "text": "At si Adaias, at si Baraias, at si Simrath, na mga anak ni Simi;"
            },
            {
              "chapter": 8,
              "verse": 22,
              "name": "1 Mga Cronica 8:22",
              "text": "At si Isphan, at si Heber, at si Eliel;"
            },
            {
              "chapter": 8,
              "verse": 23,
              "name": "1 Mga Cronica 8:23",
