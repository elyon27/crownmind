        },
        {
          "chapter": 32,
          "name": "Deuteronomio 32",
          "verses": [
            {
              "chapter": 32,
              "verse": 1,
              "name": "Deuteronomio 32:1",
              "text": "Makinig kayo, mga langit, at ako'y magsasalita, At pakinggan ng lupa ang mga salita ng aking bibig."
            },
            {
              "chapter": 32,
              "verse": 2,
              "name": "Deuteronomio 32:2",
              "text": "Ang aking aral ay papatak na parang ulan; Ang aking salita ay bababa na parang hamog; Gaya ng ambon sa malambot na damo, At gaya ng mahinang ambon sa gugulayin:"
            },
            {
              "chapter": 32,
              "verse": 3,
              "name": "Deuteronomio 32:3",
              "text": "Sapagka't aking ihahayag ang pangalan ng Panginoon: Dakilain ninyo ang ating Dios."
            },
            {
              "chapter": 32,
              "verse": 4,
              "name": "Deuteronomio 32:4",
              "text": "Siya ang Bato, ang kaniyang gawa ay sakdal; Sapagka't lahat niyang daan ay kahatulan: Isang Dios na tapat at walang kasamaan, Matuwid at banal siya."
            },
            {
              "chapter": 32,
              "verse": 5,
              "name": "Deuteronomio 32:5",
              "text": "Sila'y nagpakasama, sila'y hindi kaniyang mga anak, itong kanilang kapintasan; Mga tampalasan at likong lahi."
            },
            {
              "chapter": 32,
              "verse": 6,
              "name": "Deuteronomio 32:6",
              "text": "Ganyan ba ninyo ginaganti ang Panginoon, O mangmang na bayan at hindi pantas? Hindi ba siya ang iyong ama na tumangkilik sa iyo? Kaniyang nilalang ka, at itinatag ka."
            },
            {
              "chapter": 32,
              "verse": 7,
              "name": "Deuteronomio 32:7",
              "text": "Alalahanin mo ang mga araw ng una, Isipin mo ang mga taon ng lahi't lahi: Itanong mo sa iyong ama at kaniyang ibabalita sa iyo; Sa iyong mga matanda, at kanilang sasaysayin sa iyo."
            },
            {
              "chapter": 32,
              "verse": 8,
              "name": "Deuteronomio 32:8",
              "text": "Nang ibigay ng Kataastaasan sa mga bansa ang kanilang mana, Nang kaniyang ihiwalay ang mga anak ng tao, Kaniyang inilagay ang mga hangganan ng mga bayan Ayon sa bilang ng mga anak ni Israel."
            },
            {
              "chapter": 32,
              "verse": 9,
              "name": "Deuteronomio 32:9",
              "text": "Sapagka't ang bahagi ng Panginoon ay ang kaniyang bayan; Si Jacob ang bahaging mana niya."
            },
            {
              "chapter": 32,
              "verse": 10,
              "name": "Deuteronomio 32:10",
              "text": "Kaniyang nasumpungan sa isang ilang sa lupain, At sa kapanglawan ng isang umuungal na ilang; Kaniyang kinanlungan sa palibot, kaniyang nilingap, Kaniyang iningatang parang salamin ng kaniyang mata:"
            },
            {
              "chapter": 32,
              "verse": 11,
              "name": "Deuteronomio 32:11",
              "text": "Parang aguila na kumikilos ng kaniyang pugad, Na yumuyungyong sa kaniyang mga inakay, Kaniyang ibinubuka ang kaniyang mga pakpak, kaniyang kinukuha, Kaniyang dinadala sa ibabaw ng kaniyang mga pakpak:"
            },
            {
              "chapter": 32,
              "verse": 12,
              "name": "Deuteronomio 32:12",
              "text": "Ang Panginoon na magisa ang pumatnubay sa kaniya, At walang ibang dios na kasama siya."
            },
            {
              "chapter": 32,
              "verse": 13,
              "name": "Deuteronomio 32:13",
              "text": "Ipinaari sa kaniya ang matataas na dako ng lupa, At siya'y kumain ng tubo sa bukid; At kaniyang pinahitit ng pulot na mula sa bato, At ng langis na mula sa batong pinkian;"
            },
            {
              "chapter": 32,
              "verse": 14,
              "name": "Deuteronomio 32:14",
              "text": "Ng mantika ng baka, at gatas ng tupa, Na may taba ng mga kordero, At ng mga tupang lalake sa Basan, at mga kambing, Na may taba ng mga butil ng trigo; At sa katas ng ubas ay uminom ka ng alak."
            },
            {
              "chapter": 32,
              "verse": 15,
              "name": "Deuteronomio 32:15",
              "text": "Nguni't tumaba si Jeshurun, at tumutol: Ikaw ay tumataba, ikaw ay lumalapad, ikaw ay naging makinis: Nang magkagayo'y kaniyang pinabayaan ang Dios na lumalang sa kaniya, At niwalang kabuluhan ang Bato na kaniyang kaligtasan."
            },
            {
              "chapter": 32,
              "verse": 16,
              "name": "Deuteronomio 32:16",
              "text": "Siya'y kinilos nila sa paninibugho sa ibang mga dios, Sa pamamagitan ng mga karumaldumal, minungkahi nila siya sa kagalitan."
            },
            {
              "chapter": 32,
              "verse": 17,
              "name": "Deuteronomio 32:17",
              "text": "Kanilang inihain sa mga demonio, na hindi Dios, Sa mga dios na hindi nila nakilala, Sa mga bagong dios, na kalilitaw pa lamang, Na hindi kinatakutan ng inyong mga magulang."
            },
            {
              "chapter": 32,
              "verse": 18,
              "name": "Deuteronomio 32:18",
              "text": "Sa Batong nanganak sa iyo, ay nagwalang bahala ka, At iyong kinalimutan ang Dios na lumalang sa iyo."
            },
            {
              "chapter": 32,
              "verse": 19,
              "name": "Deuteronomio 32:19",
              "text": "At nakita ng Panginoon, at kinayamutan sila, Dahil sa pamumungkahi ng kaniyang mga anak na lalake at babae."
            },
            {
              "chapter": 32,
              "verse": 20,
              "name": "Deuteronomio 32:20",
              "text": "At kaniyang sinabi, Aking ikukubli ang aking mukha sa kanila, Aking titingnan kung anong mangyayari sa kanilang wakas; Sapagka't sila'y isang napakasamang lahi, Na mga anak na walang pagtatapat."
            },
            {
              "chapter": 32,
              "verse": 21,
              "name": "Deuteronomio 32:21",
              "text": "Kinilos nila ako sa paninibugho doon sa hindi Dios; Kanilang minungkahi ako sa galit sa kanilang mga walang kabuluhan: At akin silang kikilusin sa paninibugho sa mga hindi bayan: Aking ipamumungkahi sila sa galit, sa pamamagitan ng isang mangmang na bansa."
            },
            {
              "chapter": 32,
              "verse": 22,
              "name": "Deuteronomio 32:22",
              "text": "Sapagka't may apoy na nagalab sa aking galit, At nagniningas hanggang sa Sheol, At lalamunin ang lupa sangpu ng tubo nito, At paniningasan ng apoy ang mga tungtungan ng mga bundok."
            },
            {
              "chapter": 32,
              "verse": 23,
              "name": "Deuteronomio 32:23",
              "text": "Aking dadaganan sila ng mga kasamaan; Aking gugugulin ang aking busog sa kanila:"
            },
            {
              "chapter": 32,
              "verse": 24,
              "name": "Deuteronomio 32:24",
              "text": "Sila'y mangapupugnaw sa gutom, at lalamunin ng maningas na init, At ng mapait na pagkalipol; At ang mga ngipin ng mga hayop ay susunugin ko sa kanila, Sangpu ng kamandag ng nangagsisiusad sa alabok."
            },
            {
              "chapter": 32,
              "verse": 25,
              "name": "Deuteronomio 32:25",
              "text": "Sa labas ay pipighatiin ng tabak. At sa mga silid ay kakilabutan; Malilipol kapuwa ang binata at dalaga, Ang sanggol sangpu ng lalaking may uban."
            },
            {
              "chapter": 32,
              "verse": 26,
              "name": "Deuteronomio 32:26",
              "text": "Aking sinabi, Aking pangangalatin sila sa malayo, Aking papaglilikatin sa mga tao ang alaala sa kanila;"
            },
            {
              "chapter": 32,
              "verse": 27,
              "name": "Deuteronomio 32:27",
              "text": "Kundi aking kinatatakutan ang mungkahi ng kaaway; Baka ang kanilang mga kalaban ay humatol ng mali, Baka kanilang sabihin, Ang aming kamay ay tanghal, At hindi ginawa ng Panginoon ang lahat ng ito."
            },
            {
              "chapter": 32,
              "verse": 28,
              "name": "Deuteronomio 32:28",
              "text": "Sapagka't sila'y bansang salat sa payo, At walang kaalaman sa kanila."
            },
            {
              "chapter": 32,
              "verse": 29,
              "name": "Deuteronomio 32:29",
              "text": "Oh kung sila'y mga pantas, na kanilang tinalastas ito, Kung nababatid nila ang kanilang wakas!"
            },
            {
              "chapter": 32,
              "verse": 30,
              "name": "Deuteronomio 32:30",
              "text": "Kung paanong hahabulin ng isa ang isang libo, At ang dalawa'y magpapatakas sa sangpung libo, Malibang ipagbili sila ng kanilang Bato, At ibigay sila ng Panginoon?"
            },
            {
              "chapter": 32,
              "verse": 31,
              "name": "Deuteronomio 32:31",
              "text": "Sapagka't ang kanilang bato ay hindi gaya ng ating Bato, Kahit ang ating mga kaaway man ang maging mga hukom."
            },
            {
              "chapter": 32,
              "verse": 32,
              "name": "Deuteronomio 32:32",
              "text": "Sapagka't ang kanilang puno ng ubas ay mga puno ng ubas sa Sodoma, At sa mga parang ng Gomorra: Ang kanilang ubas ay ubas ng apdo, Ang kanilang mga buwig ay mapait:"
            },
            {
              "chapter": 32,
              "verse": 33,
              "name": "Deuteronomio 32:33",
              "text": "Ang kanilang alak ay kamandag ng mga dragon, At mabagsik na kamandag ng mga ahas."
            },
            {
              "chapter": 32,
              "verse": 34,
              "name": "Deuteronomio 32:34",
              "text": "Di ba ito'y natatago sa akin, Na natatatakan sa aking mga kayamanan?"
            },
            {
              "chapter": 32,
              "verse": 35,
              "name": "Deuteronomio 32:35",
              "text": "Ang panghihiganti ay akin, at gayon din ang gantingpala, Sa panahon na madudulas ang kanilang mga paa: Sapagka't ang araw ng kanilang pagdadalita ay nalalapit, At ang mga bagay na darating sa kanila ay mangagmamadali."
            },
            {
              "chapter": 32,
              "verse": 36,
              "name": "Deuteronomio 32:36",
              "text": "Sapagka't hahatulan ng Panginoon ang kaniyang bayan, At magsisisi dahil sa kaniyang mga lingkod; Pagka kaniyang nakitang ang kanilang kapangyarihan ay nawala, At wala ng natitira na natatakpan o naiwan."
            },
            {
              "chapter": 32,
              "verse": 37,
              "name": "Deuteronomio 32:37",
              "text": "At kaniyang sasabihin, Saan nandoon ang kanilang mga dios, Ang bato na siya nilang pinanganlungan;"
            },
            {
              "chapter": 32,
              "verse": 38,
              "name": "Deuteronomio 32:38",
              "text": "Yaong mga kumakain ng taba ng kanilang mga hain, At umiinom ng alak ng kanilang inuming handog? Bumangon sila at tumulong sa inyo, At sila'y maging pagkupkop sa inyo."
            },
            {
              "chapter": 32,
              "verse": 39,
              "name": "Deuteronomio 32:39",
              "text": "Tingnan ninyo ngayon, na ako, sa makatuwid baga'y ako nga, At walang dios sa akin: Ako'y pumapatay, at ako'y bumubuhay; Ako'y ang sumusugat, at ako'y ang nagpapagaling: At walang makaliligtas sa aking kamay."
            },
            {
              "chapter": 32,
              "verse": 40,
              "name": "Deuteronomio 32:40",
              "text": "Sapagka't aking itinataas ang aking kamay sa langit, At aking sinasabi, Buhay ako magpakailan man,"
            },
            {
              "chapter": 32,
              "verse": 41,
              "name": "Deuteronomio 32:41",
              "text": "Kung aking ihahasa ang aking makintab na tabak, At ang aking kamay ay hahawak ng kahatulan; Aking ibibigay ang aking panghihiganti sa aking mga kaaway, At aking gagantihan yaong nangapopoot sa akin."
            },
            {
              "chapter": 32,
              "verse": 42,
              "name": "Deuteronomio 32:42",
              "text": "At aking lalanguin ng dugo ang aking tunod, At ang aking tabak ay sasakmal ng laman; Sa dugo ng patay at ng mga bihag, Mula sa ulo ng mga pangulo ng kaaway."
            },
            {
              "chapter": 32,
              "verse": 43,
              "name": "Deuteronomio 32:43",
              "text": "Mangagalak kayo, O mga bansa, na kasama ng kaniyang bayan; Sapagka't ipanghihiganti ang dugo ng kaniyang mga lingkod, At manghihiganti sa kaniyang mga kaalit, At patatawarin ang kaniyang lupain, ang kaniyang bayan."
            },
            {
              "chapter": 32,
              "verse": 44,
              "name": "Deuteronomio 32:44",
              "text": "At si Moises ay naparoon at sinalita ang lahat ng mga salita ng awit na ito sa pakinig ng bayan, siya, at si Josue na anak ni Nun."
            },
            {
              "chapter": 32,
              "verse": 45,
              "name": "Deuteronomio 32:45",
              "text": "At tinapos ni Moises na salitain ang lahat ng mga salitang ito sa buong Israel:"
            },
            {
              "chapter": 32,
              "verse": 46,
              "name": "Deuteronomio 32:46",
              "text": "At kaniyang sinabi sa kanila, Ilagak ninyo ang inyong puso sa lahat ng mga salita na aking pinatototohanan sa inyo sa araw na ito, na inyong iuutos sa inyong mga anak upang isagawa ang lahat ng mga salita ng kautusang ito."
            },
            {
              "chapter": 32,
              "verse": 47,
              "name": "Deuteronomio 32:47",
              "text": "Sapagka't ito'y hindi hamak na bagay sa inyo; sapagka't inyong kabuhayan, at sa bagay na ito ay inyong palalaunin ang inyong ipinagtatawid ng Jordan upang ariin."
            },
            {
              "chapter": 32,
              "verse": 48,
              "name": "Deuteronomio 32:48",
              "text": "At sinalita ng Panginoon kay Moises nang araw ding yaon, na sinasabi,"
            },
            {
              "chapter": 32,
              "verse": 49,
              "name": "Deuteronomio 32:49",
              "text": "Sumampa ka sa bundok na ito ng Abarim, sa bundok ng Nebo na nasa lupain ng Moab, na nasa tapat ng Jerico; at masdan mo ang lupain ng Canaan, na aking ibinibigay sa mga anak ni Israel, na pinakaari:"
            },
            {
              "chapter": 32,
              "verse": 50,
              "name": "Deuteronomio 32:50",
              "text": "At mamatay ka sa bundok na iyong sinasampa, at malakip ka sa iyong bayan, gaya ni Aaron na iyong kapatid na namatay sa bundok ng Hor, at nalakip sa kaniyang bayan:"
            },
            {
              "chapter": 32,
              "verse": 51,
              "name": "Deuteronomio 32:51",
              "text": "Sapagka't kayo'y sumalansang laban sa akin sa gitna ng mga anak ni Israel sa tubig ng Meriba ng Cades, sa ilang ng Zin; sapagka't hindi ninyo ako inaring banal sa gitna ng mga anak ni Israel."
            },
            {
              "chapter": 32,
              "verse": 52,
              "name": "Deuteronomio 32:52",
              "text": "Sapagka't iyong matatanaw ang lupain sa harap mo; nguni't doo'y hindi ka makapapasok, sa lupain na aking ibinibigay sa mga anak ni Israel."
            }
          ]
        },
        {
          "chapter": 33,
          "name": "Deuteronomio 33",
          "verses": [
            {
              "chapter": 33,
              "verse": 1,
              "name": "Deuteronomio 33:1",
              "text": "At ito ang basbas na ibinasbas ni Moises, tao ng Dios, sa mga anak ni Israel bago siya namatay."
            },
            {
              "chapter": 33,
              "verse": 2,
              "name": "Deuteronomio 33:2",
              "text": "At kaniyang sinabi, Ang Panginoo'y nanggaling sa Sinai, At bumangon mula sa Seir na patungo sa kanila; Siya'y lumiwanag mula sa bundok ng Paran, At siya'y nanggaling sa laksa-laksa ng mga banal: Sa kaniyang kanan, ay may hawak na isang mahigpit na kautusan sa kanila."
            },
            {
              "chapter": 33,
              "verse": 3,
              "name": "Deuteronomio 33:3",
              "text": "Oo't kaniyang iniibig ang bayan: Lahat ng kaniyang mga banal ay nasa iyong kamay: At sila'y umupo sa iyong paanan; Na bawa't isa'y tatanggap ng iyong mga salita."
            },
            {
              "chapter": 33,
              "verse": 4,
              "name": "Deuteronomio 33:4",
              "text": "Si Moises ay nagutos sa atin ng isang kautusan, Na mana sa kapisanan ng Jacob."
            },
            {
              "chapter": 33,
              "verse": 5,
              "name": "Deuteronomio 33:5",
              "text": "At siya'y hari sa Jeshurun, Nang magkatipon ang mga pangulo ng bayan, Sangpu ng lahat ng mga lipi ni Israel."
            },
            {
              "chapter": 33,
              "verse": 6,
              "name": "Deuteronomio 33:6",
              "text": "Mabuhay nawa ang Ruben, at huwag mamatay; Gayon ma'y kumaunti nawa ang kaniyang mga tao."
            },
            {
              "chapter": 33,
              "verse": 7,
              "name": "Deuteronomio 33:7",
              "text": "At ito ang basbas sa Juda; at kaniyang sinabi, Dinggin mo, Panginoon, ang tinig ng Juda, At padatnin mo sa kaniyang bayan: Sukat na sa kaniya ang kaniyang mga kamay; At ikaw ay maging tulong laban sa kaniyang mga kaalit."
            },
            {
              "chapter": 33,
              "verse": 8,
              "name": "Deuteronomio 33:8",
              "text": "At tungkol sa Levi ay kaniyang sinabi, Ang iyong Thummim at ang iyong Urim ay sumaiyong banal, Na siyang iyong sinubok sa Massa, Na siya mong kinatunggali sa tubig ng Meriba;"
            },
            {
              "chapter": 33,
              "verse": 9,
              "name": "Deuteronomio 33:9",
              "text": "Na siyang nagsabi tungkol sa kaniyang ama, at tungkol sa kaniyang ina, Hindi ko siya nakita; Ni kinilala niya ang kaniyang mga kapatid, Ni kinilala niya ang kaniyang sariling mga anak; Sapagka't kanilang sinunod ang iyong salita, At ginaganap ang iyong tipan."
            },
            {
              "chapter": 33,
              "verse": 10,
              "name": "Deuteronomio 33:10",
              "text": "Sila'y magtuturo sa Jacob ng iyong mga kahatulan, At ng iyong mga kautusan, sa Israel; Sila'y maglalagay ng kamangyan sa harap mo, At ng buong handog na susunugin sa ibabaw ng iyong dambana."
            },
            {
              "chapter": 33,
              "verse": 11,
              "name": "Deuteronomio 33:11",
              "text": "Basbasan mo, Panginoon, ang kaniyang tinatangkilik, At tanggapin mo ang gawa ng kaniyang mga kamay; Saktan mo ang mga balakang niyaong nagsisibangon laban sa kaniya, At niyaong nangapopoot sa kaniya, upang sila'y huwag bumangon uli."
            },
            {
              "chapter": 33,
              "verse": 12,
              "name": "Deuteronomio 33:12",
              "text": "Tungkol sa Benjamin, ay kaniyang sinabi, Ang minamahal ng Panginoon ay tatahang ligtas sa siping niya; Siya'y kakanlungan niya buong araw, At siya'y mananahan sa pagitan ng kaniyang mga balikat."
            },
            {
              "chapter": 33,
              "verse": 13,
              "name": "Deuteronomio 33:13",
              "text": "At tungkol sa Jose ay kaniyang sinabi, Pagpalain nawa ng Panginoon ang kaniyang lupain, Sa mga mahalagang bagay ng langit, sa hamog, At sa kalaliman na nasa ilalim niya,"
            },
            {
              "chapter": 33,
              "verse": 14,
              "name": "Deuteronomio 33:14",
              "text": "At sa mga mahalagang bagay na pinatubo ng araw, At sa mga mahalagang bagay na pinatubo ng buwan,"
            },
            {
              "chapter": 33,
              "verse": 15,
              "name": "Deuteronomio 33:15",
              "text": "At sa pinakamarikit na mga bagay ng matandang bundok, At sa mga mahalagang bagay ng mga burol na walang hanggan,"
            },
            {
              "chapter": 33,
              "verse": 16,
              "name": "Deuteronomio 33:16",
              "text": "At sa mga mahalagang bagay ng lupa at ng kapunuan niyaon, At ang mabuting kalooban niyaong tumahan sa mababang punong kahoy: Sumaulo nawa ni Jose ang kapalaran, At sa tuktok ng ulo niya na hiwalay sa kaniyang mga kapatid."
            },
            {
              "chapter": 33,
              "verse": 17,
              "name": "Deuteronomio 33:17",
              "text": "Ang panganay ng kaniyang baka, na may kamahalan; At ang mga sungay niyaon ay parang mga sungay ng mabangis na toro: Siya niyang ipantutulak sa mga bayan, lahat sa kanila, kahit na nasa mga hangganan ng lupa: At sila ang laksa-laksa ng Ephraim, At sila ang libolibo ng Manases."
            },
            {
              "chapter": 33,
              "verse": 18,
              "name": "Deuteronomio 33:18",
              "text": "At tungkol sa Zabulon ay kaniyang sinabi, Magalak ka, Zabulon, sa iyong paglabas; At ikaw, Issachar, sa iyong mga tolda."
            },
            {
              "chapter": 33,
              "verse": 19,
              "name": "Deuteronomio 33:19",
              "text": "Kanilang tatawagin ang mga bayan sa bundok; Doo'y maghahandog sila ng mga hain ng katuwiran: Sapagka't kanilang hihititin ang mga kasaganaan ng mga dagat, At ang natatagong kayamanan sa buhanginan."
            },
            {
              "chapter": 33,
              "verse": 20,
              "name": "Deuteronomio 33:20",
              "text": "At tungkol sa Gad, ay kaniyang sinabi, Pagpalain yaong magpalaki sa Gad: Siya'y tumatahan parang isang leona, At dudurog ng bisig, sangpu ng bao ng ulo."
            },
            {
              "chapter": 33,
              "verse": 21,
              "name": "Deuteronomio 33:21",
              "text": "At kaniyang inagap ang unang bahagi para sa kaniya, Sapagka't doon natago ang bahagi ng gumagawa ng kautusan; At siya'y pumaroong kasama ng mga pangulo ng bayan, Kaniyang isinagawa ang katuwiran ng Panginoon, At ang kaniyang mga kahatulan sa Israel."
            },
            {
              "chapter": 33,
              "verse": 22,
              "name": "Deuteronomio 33:22",
              "text": "At tungkol sa Dan ay kaniyang sinabi, Ang Dan ay anak ng leon, Na lumukso mula sa Basan."
            },
            {
              "chapter": 33,
              "verse": 23,
              "name": "Deuteronomio 33:23",
              "text": "At tungkol sa Nephtali ay kaniyang sinabi, Oh Nephtali, busog ng lingap, At puspos ng pagpapala ng Panginoon: Ariin mo ang kalunuran at ang timugan."
            },
            {
              "chapter": 33,
              "verse": 24,
              "name": "Deuteronomio 33:24",
              "text": "At tungkol sa Aser ay kaniyang sinabi, Pagpalain nawa sa mga anak ang Aser, Mahalin nawa siya ng kaniyang mga kapatid, At ilubog ang kaniyang paa sa langis."
            },
            {
              "chapter": 33,
              "verse": 25,
              "name": "Deuteronomio 33:25",
              "text": "Ang iyong mga halang ay magiging bakal at tanso; At kung paano ang iyong mga kaarawan ay magkagayon nawa ang iyong lakas."
            },
            {
              "chapter": 33,
              "verse": 26,
              "name": "Deuteronomio 33:26",
              "text": "Walang gaya ng Dios, Oh Jeshurun, Na sumasakay sa langit dahil sa pagtulong sa iyo, At sa himpapawid dahil sa kaniyang karangalan."
            },
            {
              "chapter": 33,
              "verse": 27,
              "name": "Deuteronomio 33:27",
              "text": "Ang walang hanggang Dios ay iyong dakong tahanan, At sa ibaba'y ang walang hanggang mga bisig: At kaniyang itinutulak sa harap mo ang kaaway, At sinabi, Lansagin mo."
            },
            {
