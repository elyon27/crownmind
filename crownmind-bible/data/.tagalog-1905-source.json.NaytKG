            {
              "chapter": 21,
              "verse": 26,
              "name": "Genesis 21:26",
              "text": "At sinabi ni Abimelech, Aywan, kung sinong gumawa ng bagay na ito: na di mo man sinabi sa akin, at hindi ko man nabalitaan kundi ngayon."
            },
            {
              "chapter": 21,
              "verse": 27,
              "name": "Genesis 21:27",
              "text": "At kumuha si Abraham ng mga tupa, at mga baka, at ibinigay kay Abimelech; at gumawa silang dalawa ng isang tipan."
