            {
              "chapter": 17,
              "verse": 5,
              "name": "2 Samuel 17:5",
              "text": "Nang magkagayo'y sinabi ni Absalom, Tawagin mo naman ngayon si Husai na Arachita, at atin ding dinggin ang kaniyang sasabihin."
