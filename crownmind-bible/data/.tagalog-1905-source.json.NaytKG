            },
            {
              "chapter": 30,
              "verse": 31,
              "name": "Genesis 30:31",
              "text": "At sa kaniya'y sinabi, Anong ibibigay ko sa iyo? At sinabi ni Jacob, Huwag mo akong bigyan ng anoman: kung ito'y iyong gawin sa akin, ay muli kong papastulin at aalagaan ang iyong kawan."
            },
            {
              "chapter": 30,
              "verse": 32,
              "name": "Genesis 30:32",
              "text": "Dadaanan ko ang lahat mong kawan ngayon, na aking ihihiwalay doon ang lahat ng batikbatik at may dungis, at ang lahat na maitim sa mga tupa, at ang may dungis at batikbatik sa mga kambing: at siyang magiging aking kaupahan."
            },
            {
              "chapter": 30,
              "verse": 33,
              "name": "Genesis 30:33",
              "text": "Gayon ako sasagutan ng aking katuwiran sa haharapin, pagparito mo, tungkol sa aking kaupahan, na nasa harap mo; yaong lahat na walang batik at walang dungis sa mga kambing, at hindi maitim sa mga tupa, na masusumpungan sa akin, ay maibibilang mong nakaw."
            },
            {
              "chapter": 30,
              "verse": 34,
              "name": "Genesis 30:34",
              "text": "At sinabi ni Laban, Narito, mangyari nawa ayon sa iyong sabi."
            },
            {
              "chapter": 30,
              "verse": 35,
              "name": "Genesis 30:35",
              "text": "At inihiwalay ni Laban ng araw ding yaon ang mga lalaking kambing na may batik at may dungis, at ang lahat ng babaing kambing na may batik at may dungis, lahat ng mayroong kaunting puti, at lahat ng maitim sa mga tupa, at ibinigay sa mga kamay ng kaniyang mga anak;"
            },
            {
              "chapter": 30,
              "verse": 36,
              "name": "Genesis 30:36",
              "text": "At siya'y naglakad ng tatlong araw ang pagitan kay Jacob; at pinakain ni Jacob ang nalabi sa mga kawan ni Laban."
            },
            {
              "chapter": 30,
              "verse": 37,
              "name": "Genesis 30:37",
              "text": "At kumuha si Jacob ng mga sanga ng alamo, at almendro at kastano; at pinagbabakbakan ng mga batik na mapuputi, at kaniyang pinalitaw na gayon ang puti na nasa mga sanga."
            },
            {
              "chapter": 30,
              "verse": 38,
              "name": "Genesis 30:38",
              "text": "At kaniyang inilagay ang mga sangang kaniyang binakbakan sa mga bangbang, sa harap ng kawan, sa mga pinagpapainuman; na pinaparoonan ng mga kawan upang uminom; at nangaglilihi pagka nagsisiparoon upang uminom."
            },
            {
              "chapter": 30,
              "verse": 39,
              "name": "Genesis 30:39",
              "text": "At nangaglilihi ang mga kawan sa harap ng mga sanga at nanganganak ang mga kawan ng mga may guhit, may batik at may dungis."
            },
            {
              "chapter": 30,
              "verse": 40,
              "name": "Genesis 30:40",
              "text": "At ang mga korderong ito ay inihihiwalay ni Jacob, at inihaharap ang kawan sa dakong may batik, at ang lahat ng maitim sa kawan ni Laban; sa kaniyang ibinukod ang mga kawan niya rin, at hindi isinama sa kawan ni Laban."
            },
            {
              "chapter": 30,
              "verse": 41,
              "name": "Genesis 30:41",
              "text": "At nangyari, na kailan ma't maglilihi ang mga malakas sa kawan, ay inilalagay ni Jacob ang mga sanga sa harap ng mga mata ng kawan sa mga bangbang, upang sila'y papaglihihin sa gitna ng mga sanga."
            },
            {
              "chapter": 30,
              "verse": 42,
              "name": "Genesis 30:42",
              "text": "Datapuwa't pagka ang kawan ay mahina ay hindi niya inilalagay, kaya't ang mahina ay nagiging kay Laban at ang malakas ay kay Jacob."
            },
            {
              "chapter": 30,
              "verse": 43,
              "name": "Genesis 30:43",
              "text": "At ang lalake ay lumagong mainam; at nagkaroon ng malalaking kawan, at ng mga aliping babae at lalake, at ng mga kamelyo at ng mga asno."
            }
          ]
        },
        {
          "chapter": 31,
          "name": "Genesis 31",
          "verses": [
            {
              "chapter": 31,
              "verse": 1,
              "name": "Genesis 31:1",
              "text": "At narinig ni Jacob ang mga salita ng mga anak ni Laban, na nagsisipagsabi, Kinuha ni Jacob ang lahat ng sa ating ama; at doon sa mga sa ating ama ay tinamo niya ang buong karangalang ito."
            },
            {
              "chapter": 31,
              "verse": 2,
              "name": "Genesis 31:2",
              "text": "At minasdan ni Jacob ang mukha ni Laban, at narito't hindi sumasa kaniyang gaya ng dati."
            },
            {
              "chapter": 31,
              "verse": 3,
              "name": "Genesis 31:3",
              "text": "At sinabi ng Panginoon kay Jacob, Magbalik ka sa lupain ng iyong mga magulang, at sa iyong kamaganakan; at ako'y sasaiyo."
            },
            {
              "chapter": 31,
              "verse": 4,
              "name": "Genesis 31:4",
              "text": "At si Jacob ay nagsugo at tinawag si Raquel at si Lea sa bukid, sa kaniyang kawan,"
            },
            {
              "chapter": 31,
              "verse": 5,
              "name": "Genesis 31:5",
              "text": "At sinabi sa kanila, Nakikita ko ang mukha ng inyong ama, na hindi sumasaakin na gaya ng dati; datapuwa't ang Dios ng aking ama ay sumaakin."
            },
            {
              "chapter": 31,
              "verse": 6,
              "name": "Genesis 31:6",
              "text": "At nalalaman ninyo, na ang aking buong lakas ay ipinaglingkod ko sa inyong ama."
            },
            {
              "chapter": 31,
              "verse": 7,
              "name": "Genesis 31:7",
              "text": "At dinaya ako ng inyong ama, at binagong makasangpu ang aking kaupahan; datapuwa't hindi pinahintulutan siya ng Dios, na gawan ako ng masama."
            },
            {
              "chapter": 31,
              "verse": 8,
              "name": "Genesis 31:8",
              "text": "Kung kaniyang sinabing ganito, Ang mga may batik ang magiging kaupahan mo; kung magkagayo'y nanganganak ang lahat ng kawan ng mga may batik: at kung kaniyang sinabing ganito, Ang mga may guhit ang magiging kaupahan mo; kung magkagayo'y ang lahat ng kawan ay manganganak ng mga may guhit."
            },
            {
              "chapter": 31,
              "verse": 9,
              "name": "Genesis 31:9",
              "text": "Ganito inalis ng Dios ang mga hayop ng inyong ama, at ibinigay sa akin."
            },
            {
              "chapter": 31,
              "verse": 10,
              "name": "Genesis 31:10",
              "text": "At nangyari, na sa panahong ang kawan ay naglilihi, ay itiningin ko ang aking mga mata, at nakita ko sa panaginip, at narito, ang mga kambing na lalake na nakatakip sa kawan ay mga may guhit, may batik at may dungis."
            },
            {
              "chapter": 31,
              "verse": 11,
              "name": "Genesis 31:11",
              "text": "At sinabi sa akin ng anghel ng Dios, sa panaginip, Jacob: at sinabi ko, Narito ako."
            },
            {
              "chapter": 31,
              "verse": 12,
              "name": "Genesis 31:12",
              "text": "At kaniyang sinabi, Itingin mo ngayon ang iyong mga mata, tingnan mo na ang lahat ng kambing na natatakip sa kawan ay may guhit, may batik at may dungis: sapagka't aking nakita ang lahat na ginagawa sa iyo ni Laban."
            },
            {
              "chapter": 31,
              "verse": 13,
              "name": "Genesis 31:13",
              "text": "Ako ang Dios ng Betel, na doon mo pinahiran ng langis ang batong pinakaalaala, at doon ka gumawa ng panata sa akin: ngayo'y tumindig ka, umalis ka sa lupaing ito, at bumalik ka sa lupaing pinanganakan sa iyo."
            },
            {
              "chapter": 31,
              "verse": 14,
              "name": "Genesis 31:14",
              "text": "At nagsisagot si Raquel at si Lea, at sa kaniya'y sinabi, Mayroon pa ba kaming natitirang bahagi o mana sa bahay ng aming ama?"
            },
            {
              "chapter": 31,
              "verse": 15,
              "name": "Genesis 31:15",
              "text": "Hindi ba inaari niya kaming taga ibang bayan? sapagka't ipinagbili niya kami at kaniyang lubos nang kinain ang aming halaga."
            },
            {
              "chapter": 31,
              "verse": 16,
              "name": "Genesis 31:16",
              "text": "Sapagka't ang buong kayamanang inalis ng Dios sa aming ama, ay amin yaon at sa aming mga anak: ngayon nga, gawin mo ang lahat ng sinabi sa iyo ng Dios."
            },
            {
              "chapter": 31,
              "verse": 17,
              "name": "Genesis 31:17",
              "text": "Nang magkagayo'y tumindig si Jacob, at pinasakay sa mga kamello ang kaniyang mga anak at ang kaniyang mga asawa;"
            },
            {
              "chapter": 31,
              "verse": 18,
              "name": "Genesis 31:18",
              "text": "At dinala ang kaniyang lahat na hayop, at ang kaniyang buong pag-aaring tinipon, ang hayop na kaniyang napakinabang, na kaniyang tinipon, sa Padan-aram, upang pumaroon kay Isaac na kaniyang ama, sa lupain ng Canaan."
            },
            {
              "chapter": 31,
              "verse": 19,
              "name": "Genesis 31:19",
              "text": "Si Laban nga ay yumaon upang gupitan ang kaniyang mga tupa: at ninakaw ni Raquel ang mga larawang tinatangkilik ng kaniyang ama."
