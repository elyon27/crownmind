    {
      "nr": 2,
      "name": "Exodo",
      "chapters": [
        {
          "chapter": 1,
          "name": "Exodo 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Exodo 1:1",
              "text": "Ito nga ang mga pangalan ng mga anak ni Israel, na nagsipasok sa Egipto: (bawa't lalake at ang kani-kaniyang sangbahayan ay sumama kay Jacob.)"
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Exodo 1:2",
              "text": "Si Ruben, si Simeon, si Levi, at si Juda;"
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Exodo 1:3",
              "text": "Si Issachar, si Zabulon at si Benjamin;"
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Exodo 1:4",
              "text": "Si Dan at si Nephtali, si Gad at si Aser."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Exodo 1:5",
              "text": "At lahat ng tao na lumabas sa balakang ni Jacob ay pitong pung tao: at si Jose ay nasa Egipto na."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Exodo 1:6",
              "text": "At namatay si Jose, at ang lahat niyang kapatid at ang buong lahing yaon."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Exodo 1:7",
              "text": "At ang mga anak ni Israel ay lumago, at kumapal na maigi at dumami, at naging totoong makapangyarihan; at ang lupain ay napuno nila."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Exodo 1:8",
              "text": "May bumangon ngang isang bagong hari sa Egipto, na hindi kilala si Jose."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Exodo 1:9",
              "text": "At sinabi niya sa kaniyang bayan, Narito, ang bayan ng mga anak ni Israel ay higit at lalong malakas kay sa atin:"
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Exodo 1:10",
              "text": "Hayo't tayo'y magpakadunong sa kanila; baka sila'y dumami, at mangyari, na, pagka nagkadigma, ay makisanib pati sila sa ating mga kaaway, at lumaban sa atin, at magsilayas sa lupain."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Exodo 1:11",
              "text": "Kaya't nangaglagay sila ng mga tagapagpaatag, upang dalamhatiin sila sa atang sa kanila. At kanilang ipinagtayo si Faraon ng mga bayan na kamaligan, na dili iba't ang Phithom at Raamses."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Exodo 1:12",
              "text": "Datapuwa't habang dinadalamhati nila sila, ay lalong dumadami at lalong kumakapal. At kinapootan nila ang mga anak ni Israel."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Exodo 1:13",
              "text": "At pinapaglingkod na may kabagsikan ng mga Egipcio ang mga anak ni Israel:"
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Exodo 1:14",
              "text": "At kanilang pinapamuhay sila ng masaklap sa pamamagitan ng mahirap na paglilingkod, sa argamasa at sa laryo, at sa lahat ng sarisaring paglilingkod sa bukid, at sa lahat ng paglilingkod nila na ipinapaglingkod sa kanila, na may kabagsikan."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Exodo 1:15",
              "text": "At ang hari sa Egipto ay nagsalita sa mga hilot na Hebrea, na ang pangalan ng isa ay Siphra, at ang pangalan ng isa ay Phua:"
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Exodo 1:16",
              "text": "At kaniyang sinabi, Paghilot ninyo sa mga babaing Hebrea, at pagtingin ninyo sa kanila sa dakong panganganakan; kung lalake, ay papatayin nga ninyo: datapuwa't kung babae ay inyong bubuhayin."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Exodo 1:17",
              "text": "Datapuwa't ang mga hilot ay nangatakot sa Dios at hindi ginawa ang gaya ng iniutos sa kanila ng hari sa Egipto, kundi iniligtas na buhay ang mga batang lalake."
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Exodo 1:18",
              "text": "At ipinatawag ng hari sa Egipto ang mga hilot, at sinabi sa kanila, Bakit ninyo ginawa ang bagay na ito, at inyong iniligtas na buhay ang mga batang lalake?"
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "Exodo 1:19",
              "text": "At sinabi ng mga hilot kay Faraon, Sapagka't ang mga babaing Hebrea ay hindi gaya ng mga babaing Egipcia; sapagka't sila'y maliliksi, at nakapanganak na, bago dumating ang hilot sa kanila."
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "Exodo 1:20",
              "text": "At ang Dios ay gumawa ng mabuti sa mga hilot: at ang bayan ay kumapal, at naging totoong makapangyarihan."
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "Exodo 1:21",
              "text": "At nangyari, na sapagka't ang mga hilot ay natakot sa Dios, ay iginawa niya sila ng mga sangbahayan."
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "Exodo 1:22",
              "text": "At iniutos ni Faraon sa kaniyang buong bayan, na sinasabi, Itatapon ninyo sa ilog bawa't lalake na ipanganak, at bawa't babae ay ililigtas ninyong buhay."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Exodo 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Exodo 2:1",
              "text": "At isang lalake sa lipi ni Levi ay yumaon, at nagasawa sa isang anak na babae ng lipi ni Levi."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Exodo 2:2",
              "text": "At ang babae ay naglihi, at nanganak ng isang lalake: at nang kaniyang makita na maganda, ay kaniyang itinagong tatlong buwan."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Exodo 2:3",
              "text": "At nang hindi na niya maitatagong malaon ay ikinuha niya ng isang takbang yantok, at pinahiran niya ng betun at ng sahing; at kaniyang isinilid ang bata roon, at inilagay sa katalahiban sa tabi ng ilog."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Exodo 2:4",
              "text": "At tumayo sa malayo ang kaniyang kapatid na babae, upang maalaman ang mangyayari sa bata."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Exodo 2:5",
              "text": "At ang anak na babae ni Faraon ay lumusong upang maligo sa ilog; at nagsipaglakad ang kaniyang mga abay sa tabi ng ilog; at kaniyang nakita ang takba sa katalahiban, at ipinakuha sa kaniyang abay."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Exodo 2:6",
              "text": "At kaniyang binuksan, at nakita niya ang bata: at narito, ang sanggol ay umiyak. At kaniyang kinaawaan at sinabi, Ito'y isa sa mga anak ng mga Hebreo."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Exodo 2:7",
              "text": "Nang magkagayo'y sinabi ng kaniyang kapatid na babae sa anak ni Faraon, Yayaon ba ako at itatawag kita ng isang sisiwa sa mga babaing Hebrea, na makapagalaga sa iyo ng batang ito?"
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Exodo 2:8",
              "text": "At sinabi sa kaniya ng anak ni Faraon, Yumaon ka. At ang dalaga ay yumaon, at tinawag ang ina ng bata."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Exodo 2:9",
              "text": "At sinabi ng anak ni Faraon, sa kaniya, Dalhin mo ang batang ito, at alagaan mo sa akin, at bibigyan kita ng iyong kaupahan. At kinuha ng babae ang bata, at inalagaan."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Exodo 2:10",
              "text": "At ang bata ay lumaki, at kaniyang dinala sa anak ni Faraon, at siya'y kaniyang inaring anak. At kaniyang pinanganlang Moises, at sinabi, Sapagka't aking sinagip siya sa tubig."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Exodo 2:11",
              "text": "At nangyari nang mga araw na yaon, ng malaki na si Moises, na kaniyang nilabas ang kaniyang mga kapatid, at minasdan ang atang sa kanila: at kaniyang nakita ang isang Egipcio, na nananakit ng isang Hebreo, na isa sa kaniyang mga kapatid."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Exodo 2:12",
              "text": "At siya'y nagmasid sa magkabikabilang dako, at nang siya'y walang makitang tao, ay kaniyang pinatay ang Egipcio at kaniyang tinabunan sa buhanginan."
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Exodo 2:13",
              "text": "At siya'y lumabas ng ikalawang araw, at, narito, na may dalawang lalaking Hebreo, na nagbababag: at kaniyang sinabi roon sa umaapi, Bakit mo sinasaktan ang iyong kasama?"
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Exodo 2:14",
              "text": "At sinabi niya, Sinong naglagay sa iyong pangulo at hukom sa amin? Iniisip mo bang patayin ako, na gaya ng pagpatay mo sa Egipcio? At natakot si Moises, at nagsabi, Tunay na ang bagay na yaon ay nahayag."
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Exodo 2:15",
              "text": "Nang mabalitaan nga ni Faraon ang bagay na ito, ay minithi niyang patayin si Moises. Datapuwa't si Moises ay tumakas sa harapan ni Faraon, at tumahan sa lupain ng Madian: at siya'y umupo sa tabi ng isang balon."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Exodo 2:16",
              "text": "Ang saserdote nga sa Madian ay may pitong anak na babae: at sila'y naparoon at umigib ng tubig, at kanilang pinuno ang mga inuman upang painumin ang kawan ng kanilang ama."
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Exodo 2:17",
              "text": "At ang mga pastor ay dumating, at sila'y pinalayas: datapuwa't si Moises ay tumayo, at sila'y tinulungan, at pinainom ang kanilang kawan."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "Exodo 2:18",
              "text": "At nang sila'y dumating kay Raquel na kanilang ama, ay sinabi niya, Bakit kayo tumindig na madali ngayon?"
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "Exodo 2:19",
              "text": "At kanilang sinabi, Ipinagsanggalang kami ng isang Egipcio sa kamay ng mga pastor, at saka iniigib pa niya kami ng tubig, at pinainom ang kawan."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "Exodo 2:20",
              "text": "At kaniyang sinabi sa mga anak niya, At saan naroon siya? bakit ninyo iniwan ang lalaking yaon? tawagin ninyo siya upang makakain ng tinapay."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "Exodo 2:21",
              "text": "At si Moises ay natuwa na makisuno sa lalaking yaon: at kaniyang pinapag-asawa kay Moises si Zephora na kaniyang anak."
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "Exodo 2:22",
              "text": "At nanganak ng isang lalake, at kaniyang pinanganlan ng Gersom; sapagka't kaniyang sinabi, Ako'y nakipamayan sa ibang bayan."
            },
            {
              "chapter": 2,
              "verse": 23,
              "name": "Exodo 2:23",
              "text": "At nangyari pagkaraan ng maraming araw na ang hari sa Egipto ay namatay; at ang mga anak ni Israel ay nagbuntong hininga dahil sa pagkaalipin, at sila'y dumaing at ang kanilang daing ay umabot sa Dios dahil sa pagkaalipin."
            },
            {
              "chapter": 2,
              "verse": 24,
              "name": "Exodo 2:24",
              "text": "At dininig ng Dios ang kanilang hibik, at naalaala ng Dios ang kaniyang tipan kay Abraham, kay Isaac, at kay Jacob,"
            },
            {
              "chapter": 2,
              "verse": 25,
              "name": "Exodo 2:25",
              "text": "At nilingap ng Dios ang mga anak ni Israel, at sila'y kinilala ng Dios."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Exodo 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Exodo 3:1",
              "text": "Inalagaan nga ni Moises ang kawan ni Jethro na kaniyang biyanan, na saserdote sa Madian: at kaniyang pinatnubayan ang kawan sa likuran ng ilang, at napasa bundok ng Dios, sa Horeb."
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Exodo 3:2",
              "text": "At ang anghel ng Panginoon ay napakita sa kaniya, sa isang ningas ng apoy na mula sa gitna ng isang mababang punong kahoy; at siya'y nagmasid, at, narito, ang kahoy ay nagniningas sa apoy, at ang kahoy ay hindi natutupok."
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Exodo 3:3",
              "text": "At sinabi ni Moises, Ako'y liliko ngayon, at titingnan ko itong dakilang panoorin, kung bakit ang kahoy ay hindi natutupok."
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Exodo 3:4",
              "text": "At nang makita ng Panginoon na panonoorin niya, ay tinawag siya ng Dios mula sa gitna ng mababang punong kahoy, at sinabi, Moises, Moises. At kaniyang sinabi, Narito ako."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Exodo 3:5",
              "text": "At sinabi, Huwag kang lumapit dito, hubarin mo ang iyong panyapak sa iyong mga paa, sapagka't ang dakong iyong kinatatayuan ay banal na lupa."
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Exodo 3:6",
              "text": "Bukod dito ay sinabi, Ako ang Dios ng iyong ama ang Dios ni Abraham, ang Dios ni Isaac, at ang Dios ni Jacob. At si Moises nga ay nagtakip ng kaniyang mukha; sapagka't siya'y natakot na tumingin sa Dios."
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Exodo 3:7",
              "text": "At sinabi ng Panginoon, Akin ngang nakita ang kadalamhatian ng aking bayan na nasa Egipto, at aking dininig ang kanilang daing dahil sa mga tagapagpaatag sa kanila; sapagka't talastas ko ang kanilang kapanglawan."
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Exodo 3:8",
              "text": "At ako'y bumaba upang iligtas sila sa kamay ng mga Egipcio at upang sila'y isampa sa isang mabuting lupain at malawak, mula sa lupaing yaon, sa isang lupaing binubukalan ng gatas at pulot sa dako ng Cananeo, at ng Hetheo, at ng Amorrheo, at ng Pherezeo, at ng Heveo at ng Jebuseo."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Exodo 3:9",
              "text": "At ngayon narito, ang daing ng mga anak ni Israel ay umabot sa akin; saka aking nakita ang kapighatian na ipinipighati sa kanila ng mga Egipcio."
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Exodo 3:10",
              "text": "Halika nga ngayon, at ikaw ay aking susuguin kay Faraon, upang iyong ilabas sa Egipto ang aking bayan na mga anak ni Israel."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Exodo 3:11",
              "text": "At sinabi ni Moises sa Dios, Sino ako, upang pumaroon kay Faraon, at upang ilabas sa Egipto ang mga anak ni Israel?"
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Exodo 3:12",
              "text": "At kaniyang sinabi, Tunay na ako'y sasaiyo; at ito'y magiging tanda sa iyo, na ikaw ay aking sinugo: pagka iyong nailabas na sa Egipto ang bayan ay maglilingkod kayo sa Dios sa bundok na ito."
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Exodo 3:13",
              "text": "At sinabi ni Moises sa Dios, Narito, pagdating ko sa mga anak ni Israel, at sasabihin ko sa kanila, Sinugo ako sa inyo ng Dios ng inyong mga magulang; at sasabihin nila sa akin: Ano ang kaniyang pangalan? anong sasabihin ko sa kanila?"
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Exodo 3:14",
              "text": "At sinabi ng Dios kay Moises, AKO YAONG AKO NGA; at kaniyang sinabi, Ganito ang sasabihin mo sa mga anak ni Israel, Sinugo ako sa inyo ni AKO NGA."
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Exodo 3:15",
              "text": "At sinabi pa ng Dios kay Moises, Ganito ang sasabihin mo sa mga anak ni Israel, Sinugo ako sa inyo ng Panginoon, ng Dios ng inyong mga magulang, ng Dios ni Abraham, ng Dios ni Isaac, at ng Dios ni Jacob: ito ang aking pangalan magpakailan man, at ito ang aking pinakaalaala sa lahat ng mga lahi."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Exodo 3:16",
              "text": "Yumaon ka at tipunin mo ang mga matanda sa Israel, at sabihin mo sa kanila, Ang Panginoon, ang Dios ng inyong mga magulang, ang Dios ni Abraham, ni Isaac, at ni Jacob; ay napakita sa akin, na nagsasabi, tunay na kayo'y aking dinalaw, at aking nakita ang ginagawa sa inyo sa Egipto."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Exodo 3:17",
              "text": "At aking sinabi, Aking aalisin kayo sa kapighatian sa Egipto at dadalhin ko kayo, sa lupain ng Cananeo, at ng Hetheo, at ng Amorrheo, at ng Pherezeo, at ng Heveo, at ng Jebuseo, sa isang lupaing binubukalan ng gatas at pulot."
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "Exodo 3:18",
              "text": "At kanilang didinggin ang iyong tinig: at ikaw ay paroroon, ikaw at ang mga matanda sa Israel, sa hari sa Egipto, at inyong sasabihin sa kaniya, Ang Panginoon, ang Dios ng mga Hebreo, ay nakipagtagpo sa amin: at ngayo'y pahintulutan mo kami na maglakbay, na tatlong araw sa ilang, upang kami ay makapaghain sa Panginoon naming Dios."
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "Exodo 3:19",
              "text": "At talastas ko, na hindi kayo pababayaang yumaon ng hari sa Egipto, kung hindi sa pamamagitan ng isang makapangyarihang kamay."
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "Exodo 3:20",
              "text": "At aking iuunat ang aking kamay, at sasaktan ko ang Egipto ng aking buong kababalaghan na aking gagawin sa gitna niyaon at pagkatapos niyaon ay pahihintulutan niya kayong yumaon."
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Exodo 3:21",
              "text": "At pagkakalooban ko ang bayang ito ng biyaya sa paningin ng mga Egipcio: ay mangyayari, na pagyaon ninyo, ay hindi kayo yayaong walang dala:"
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Exodo 3:22",
              "text": "Kundi bawa't babae ay hihingi sa kaniyang kapuwa, at sa tumatahan sa kaniyang bahay, ng mga hiyas na pilak, at mga hiyas na ginto at mga damit: at inyong ipagsusuot sa inyong mga anak na lalake at babae; at inyong sasamsaman ang mga Egipcio."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Exodo 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Exodo 4:1",
              "text": "At si Moises ay sumagot at nagsabi, Datapuwa't, narito, hindi nila paniniwalaan ako, ni didinggin ang aking tinig sapagka't kanilang sasabihin, Ang Panginoon ay hindi napakita sa iyo."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Exodo 4:2",
              "text": "At sinabi sa kaniya ng Panginoon, Ano iyang nasa iyong kamay? At kaniyang sinabi, Isang tungkod."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Exodo 4:3",
              "text": "At kaniyang sinabi, Ihagis mo sa lupa. At kaniyang inihagis sa lupa, at naging isang ahas; at si Moises ay tumakas sa harap ng ahas."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Exodo 4:4",
              "text": "At sinabi ng Panginoon kay Moises, Iunat mo ang iyong kamay, at sunggaban mo sa buntot: (at kaniyang iniunat ang kaniyang kamay, at kaniyang hinawakan, at naging isang tungkod sa kaniyang kamay)."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Exodo 4:5",
              "text": "Upang sila'y maniwala, na ang Dios ng iyong mga magulang, ang Dios ni Abraham, ang Dios ni Isaac, at ang Dios ni Jacob ay napakita sa iyo."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Exodo 4:6",
              "text": "At sinabi pa sa kaniya ng Panginoon, Ipasok mo ang iyong kamay, sa iyong sinapupunan. At kaniyang ipinasok ang kamay niya sa kaniyang sinapupunan: at nang kaniyang ilabas, ay narito, ang kaniyang kamay ay may ketong, na maputing parang niebe."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Exodo 4:7",
              "text": "At kaniyang sinabi, Ipasok mo uli ang iyong kamay sa iyong sinapupunan. (At kaniyang ipinasok uli ang kamay niya sa kaniyang sinapupunan, at nang kaniyang ilabas sa kaniyang sinapupunan, ay narito, nagsauling gaya ng kaniyang dating laman)."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Exodo 4:8",
              "text": "At mangyayari, na kung sila'y hindi maniniwala sa iyo, ni makikinig sa tinig ng unang tanda, ay kanilang paniniwalaan ang tinig ng huling tanda."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Exodo 4:9",
              "text": "At mangyayari na kung sila'y hindi maniniwala sa dalawang tandang ito, ni hindi makikinig sa iyong tinig, ay kukuha ka ng tubig sa ilog, at iyong ibubuhos sa tuyong lupa, at ang tubig na iyong kukunin sa ilog ay magiging dugo sa tuyong lupa."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Exodo 4:10",
              "text": "At sinabi ni Moises sa Panginoon, Oh Panginoon, ako'y hindi marikit mangusap, kahit ng panahong nakaraan, kahit mula ng magsalita ka sa iyong lingkod: sapagka't ako'y kimi sa pangungusap at umid sa dila."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Exodo 4:11",
              "text": "At sinabi sa kaniya ng Panginoon, Sinong gumawa ng bibig ng tao? o sinong gumawa ng pipi, o bingi, o may paningin, o bulag sa tao? Hindi ba akong Panginoon?"
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Exodo 4:12",
              "text": "Ngayon nga'y yumaon ka, at ako'y sasaiyong bibig, at ituturo ko sa iyo kung ano ang iyong sasalitain."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Exodo 4:13",
              "text": "At kaniyang sinabi, Oh Panginoon, magsugo ka, isinasamo ko sa iyo, sa pamamagitan ng kamay niyaong iyong susuguin."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Exodo 4:14",
              "text": "At ang galit ng Panginoon ay nagningas laban kay Moises, at kaniyang sinabi, Wala ba si Aarong kapatid mo na Levita? Nalalaman kong siya'y makapagsasalitang mabuti. At saka, narito, siya'y lumalabas upang salubungin ka; at pagkakita niya sa iyo, ay matutuwa sa kaniyang puso."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Exodo 4:15",
              "text": "At ikaw ay magsasalita sa kaniya, at iyong isasabibig niya ang mga salita; at ako'y sasaiyong bibig at sasakaniyang bibig, at aking ituturo sa inyo, kung ano ang inyong gagawin."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Exodo 4:16",
              "text": "At siya ang makikipagusap sa lagay mo sa bayan: at mangyayari na siya'y magiging sa iyo'y bibig, at ikaw ay magiging sa kaniya'y parang Dios."
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Exodo 4:17",
              "text": "At tatangnan mo sa iyong kamay ang tungkod na ito, na iyong ipaggagawa ng mga tanda."
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Exodo 4:18",
              "text": "At si Moises ay yumaon, at bumalik kay Jethro na kaniyang biyanan, at nagsabi sa kaniya, Pahintulutan mo akong yumaon, isinasamo ko sa iyo, at bumalik sa aking mga kapatid na nasa Egipto, at titingnan ko, kung sila'y nabubuhay pa. At sinabi ni Jethro kay Moises, Yumaon kang payapa."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Exodo 4:19",
              "text": "At sinabi ng Panginoon kay Moises sa Madian, Yumaon ka, bumalik ka sa Egipto: sapagka't namatay na ang lahat ng tao, na nagmimithi ng iyong buhay."
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Exodo 4:20",
              "text": "At ipinagsama ni Moises ang kaniyang asawa at ang kaniyang mga anak, at kaniyang ipinagsasakay sa isang asno, at siya'y bumalik sa lupain ng Egipto: at tinangnan ni Moises ang tungkod ng Dios sa kaniyang kamay."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Exodo 4:21",
              "text": "At sinabi ng Panginoon kay Moises, Pagkabalik mo sa Egipto, iyong gawin nga sa harap ni Faraon ang lahat ng kababalaghan na aking itiniwala sa iyong kamay: datapuwa't aking papagmamatigasin ang kaniyang puso, at hindi niya tutulutang yumaon ang bayan."
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "Exodo 4:22",
              "text": "At iyong sasabihin kay Faraon, Ganito ang sabi ng Panginoon, Ang Israel ay aking anak, aking panganay:"
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "Exodo 4:23",
              "text": "At aking sinabi sa iyo, Pahintulutan mong ang aking anak ay yumaon, upang siya'y makapaglingkod sa akin; at ayaw mo siyang payaunin, narito, aking papatayin ang iyong anak, ang iyong panganay."
            },
            {
              "chapter": 4,
              "verse": 24,
              "name": "Exodo 4:24",
              "text": "At nangyari sa daan, sa dakong panuluyanan, na sinalubong ng Panginoon siya, at pinagsikapang patayin siya."
            },
            {
              "chapter": 4,
              "verse": 25,
              "name": "Exodo 4:25",
              "text": "Nang magkagayo'y sumunggab si Sephora ng isang batong matalim, at pinutol ang balat ng masama ng kaniyang anak, at inihagis sa kaniyang paanan; at kaniyang sinabi, Tunay na ikaw sa akin ay isang asawang mabagsik."
            },
            {
              "chapter": 4,
              "verse": 26,
              "name": "Exodo 4:26",
              "text": "Sa gayo'y kaniyang binitiwan siya. Nang magkagayo'y kaniyang sinabi, Isang asawa kang mabagsik, dahil sa pagtutuli."
            },
            {
              "chapter": 4,
              "verse": 27,
              "name": "Exodo 4:27",
              "text": "At sinabi ng Panginoon kay Aaron, Pumaroon ka sa ilang na salubungin mo si Moises. At siya'y pumaroon, at nasalubong niya sa bundok ng Dios, at kaniyang hinagkan."
            },
            {
              "chapter": 4,
              "verse": 28,
              "name": "Exodo 4:28",
              "text": "At isinaysay ni Moises kay Aaron ang lahat ng salita ng Panginoon, na ipinagbilin sa kaniyang sabihin, at ang lahat ng tandang ipinagbilin sa kaniyang gawin."
            },
            {
              "chapter": 4,
              "verse": 29,
              "name": "Exodo 4:29",
              "text": "At si Moises at si Aaron ay naparoon at tinipon ang lahat ng matanda sa mga anak ni Israel:"
            },
            {
              "chapter": 4,
              "verse": 30,
              "name": "Exodo 4:30",
              "text": "At sinalita ni Aaron ang lahat ng salita na sinalita ng Panginoon kay Moises, at ginawa ang mga tanda sa paningin ng bayan."
            },
            {
              "chapter": 4,
              "verse": 31,
              "name": "Exodo 4:31",
              "text": "At ang bayan ay naniwala: at nang kanilang marinig na dinalaw ng Panginoon ang mga anak ni Israel, at kaniyang nakita ang kanilang kapighatian, ay iniyukod nga nila ang kanilang mga ulo at sumamba."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Exodo 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Exodo 5:1",
              "text": "At pagkatapos nito, si Moises at si Aaron ay nagsipasok, at sinabi kay Faraon, Ganito ang sabi ng Panginoon, ng Dios ng Israel, Bayaan mong ang aking bayan ay yumaon upang ipagdiwang nila ako ng isang kapistahan sa ilang."
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Exodo 5:2",
              "text": "At sinabi ni Faraon, Sino ang Panginoon na aking pakikinggan ang kaniyang tinig, upang pahintulutan kong yumaon ang Israel? Hindi ko nakikilala ang Panginoon at saka hindi ko pahihintulutang yumaon ang Israel."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Exodo 5:3",
              "text": "At kanilang sinabi, Ang Dios ng mga Hebreo ay nakipagtagpo sa amin; pahintulutan mo nga kaming maglakbay na tatlong araw sa ilang, at maghain sa Panginoon naming Dios, baka hulugan niya kami ng salot o ng tabak."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Exodo 5:4",
              "text": "At sinabi sa kanila ng hari sa Egipto, Bakit kinakalagan ninyo, Moises at Aaron, ang bayan sa kanilang mga gawain? pumaroon kayo sa mga atang sa inyo."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Exodo 5:5",
              "text": "At sinabi ni Faraon, Narito, ang mga tao sa lupain ay marami na ngayon, at inyong pinapagpapahinga sila sa mga atang sa kanila."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Exodo 5:6",
              "text": "At ng araw ring yaon ay nagutos si Faraon sa mga tagapagpaatag sa bayan at sa kanilang mga puno, na sinasabi,"
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Exodo 5:7",
              "text": "Huwag na ninyong bibigyan ang bayan, ng dayami sa paggawa ng laryo, na gaya ng dati: sila ang pumaroon at magtipon ng dayami sa ganang kanilang sarili."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Exodo 5:8",
              "text": "At ang bilang ng mga laryo, na kanilang ginagawang dati ay siya rin ninyong iaatang sa kanila; wala kayong babawasin: sapagka't sila'y mga pagayongayon; kaya't sila'y dumadaing, na nagsasabi, Bayaan mo kaming yumaon at maghain sa aming Dios."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Exodo 5:9",
              "text": "Pabigatin ninyo ang gawain ng mga lalake upang kanilang pagpagalan at huwag nilang pakitunguhan ang mga kabulaanang salita."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Exodo 5:10",
              "text": "At ang mga tagapagpaatag sa bayan, ay nagsilabas, at kanilang sinalita sa bayan, na sinasabi, Ganito ang sabi ni Faraon, Hindi ko kayo bibigyan ng dayami."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Exodo 5:11",
              "text": "Yumaon kayo ng inyong sarili, kumuha kayo ng dayami kung saan kayo makakakuha: sapagka't walang babawasin kaunti man sa inyong gawain."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Exodo 5:12",
              "text": "Kaya't ang bayan ay nangalat sa buong lupain ng Egipto, na humahanap ng pinagputulan ng trigo na panghalili sa dayami."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Exodo 5:13",
              "text": "At hinihigpitan sila ng mga tagapagpaatag, na sinasabi, Tapusin ninyo ang inyong mga gawa, ang inyong gawain sa araw-araw, na gaya nang mayroong kayong dayami."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Exodo 5:14",
              "text": "At ang mga pinuno sa mga anak ni Israel na ipinaglalagay sa kanila ng mga tagapagpaatag ni Faraon, ay nangapalo, at sa kanila'y sinabi, Bakit hindi ninyo tinapos ang inyong gawain kahapon at ngayon, sa paggawa ng laryo, na gaya ng dati?"
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Exodo 5:15",
              "text": "Nang magkagayo'y ang mga pinuno sa mga anak ni Israel ay naparoon at dumaing kay Faraon, na nagsasabi, Bakit mo ginaganyan ang iyong mga alipin?"
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Exodo 5:16",
              "text": "Walang anomang dayami, na ibinibigay sa iyong mga alipin, at kanilang sinasabi sa amin, Gumawa kayo ng laryo: at, narito, ang iyong mga alipin ay nangapapalo; nguni't ang sala'y nasa iyong sariling bayan."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Exodo 5:17",
              "text": "Datapuwa't kaniyang sinabi, Kayo'y mga pagayongayon, kayo'y mga pagayongayon: kaya't inyong sinasabi, Bayaan mo kaming yumaon at maghain sa Panginoon."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Exodo 5:18",
              "text": "Kayo nga'y yumaon ngayon at gumawa; sapagka't walang anomang dayaming ibibigay sa inyo, at gayon ma'y inyong ibibigay ang bilang ng mga laryo."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Exodo 5:19",
              "text": "At nakita ng mga pinuno ng mga anak ni Israel, na sila'y nasa masamang kalagayan, nang sabihin, Walang mababawas na anoman sa inyong mga laryo sa inyong gawain sa araw-araw."
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Exodo 5:20",
              "text": "At kanilang nasalubong si Moises at si Aaron na nagsitayo sa daan, pagkapanggaling kay Faraon:"
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Exodo 5:21",
              "text": "At sinabi nila sa kanila, Kayo nawa'y tunghan ng Panginoon, at hatulan; sapagka't ang aming katayuan ay ginawa mong nakamumuhi sa mga mata ni Faraon, at sa mga mata ng kaniyang mga lingkod, na naglagay ng tabak sa kanilang kamay upang kami ay patayin."
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Exodo 5:22",
              "text": "At si Moises ay bumalik sa Panginoon, at nagsabi, Panginoon, bakit mo ginawan ng kasamaan ang bayang ito? bakit mo sinugo ako?"
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Exodo 5:23",
              "text": "Sapagka't mula nang ako'y pumaroon kay Faraon na magsalita sa iyong pangalan, ay kaniyang ginawan ng kasamaan ang bayang ito: at ni hindi mo man iniligtas ang iyong bayan."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Exodo 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Exodo 6:1",
              "text": "At sinabi ng Panginoon kay Moises, Ngayo'y iyong makikita kung ano ang gagawin ko kay Faraon, sapagka't sa pamamagitan ng isang malakas na kamay ay payayaunin niya sila, at sa pamamagitan ng isang malakas na kamay ay palalayasin niya sila sa kaniyang lupain."
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Exodo 6:2",
              "text": "At ang Dios ay nagsalita kay Moises, at nagsabi sa kaniya, Ako'y si Jehova."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Exodo 6:3",
              "text": "At ako'y napakita kay Abraham, kay Isaac, at kay Jacob na Dios na Makapangyarihan sa lahat; nguni't sa pamamagitan ng aking pangalang Jehova, noon ay hindi ako napakilala sa kanila."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Exodo 6:4",
              "text": "At akin ding pinapagtibay ang aking tipan sa kanila na ibibigay ko sa kanila ang lupain ng Canaan, ang lupain ng kanilang pakikipamayan, na kanilang pinakipamayanan."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Exodo 6:5",
              "text": "At bukod dito'y aking narinig ang hibik ng mga anak ni Israel na mga binibinbin ng mga Egipcio sa pagkaalipin; at aking naalaala ang aking tipan."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Exodo 6:6",
              "text": "Kaya't sabihin mo sa mga anak ni Israel, Ako'y si Jehova at aking ilalabas kayo sa ilalim ng mga atang sa mga Egipcio, at aking hahanguin kayo sa pagkaalipin sa kanila, at aking tutubusin kayo na may unat na kamay at may mga dakilang kahatulan:"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Exodo 6:7",
              "text": "At kayo'y aking aariin na pinakabayan ko at ako'y magiging sa inyo'y Dios, at inyong makikilala na ako'y si Jehova ninyong Dios, na naglalabas sa inyo sa ilalim ng mga atang sa mga Egipcio."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Exodo 6:8",
              "text": "At aking dadalhin kayo sa lupain, na siyang pinagtaasan ko ng aking kamay na aking ibibigay kay Abraham, kay Isaac, at kay Jacob; at aking ibibigay sa inyo na pinakamana: ako'y si Jehova."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Exodo 6:9",
              "text": "At sinalitang gayon ni Moises sa mga anak ni Israel; datapuwa't hindi sila nakinig kay Moises, dahil sa yamot, at dahil sa mabagsik na pagkaalipin."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Exodo 6:10",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Exodo 6:11",
              "text": "Pumasok ka, salitain mo kay Faraon na hari sa Egipto, na kaniyang pahintulutang umalis sa lupain niya ang mga anak ni Israel."
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Exodo 6:12",
              "text": "At si Moises ay nagsalita sa harap ng Panginoon, na sinasabi, Narito ang mga anak ni Israel ay hindi nakinig sa akin; paano ngang si Faraon ay makikinig sa akin, na ako'y may mga labing di tuli?"
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Exodo 6:13",
              "text": "At ang Panginoon ay nagsalita kay Moises at kay Aaron, at pinagbilinan sila hinggil sa mga anak ni Israel, at kay Faraon, na hari sa Egipto, upang ilabas ang mga anak ni Israel sa lupain ng Egipto."
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Exodo 6:14",
              "text": "Ito ang mga pangulo sa mga angkan ng kanilang mga magulang; ang mga anak ni Ruben na panganay ni Israel; si Hanoch, at si Phallu, at si Hezron, at si Carmi: ito ang mga angkan ni Ruben."
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Exodo 6:15",
              "text": "At ang mga anak ni Simeon; si Jemuel, at si Jamin, at si Ohad, at si Jachin, at si Zoar, at si Saul na anak sa isang babaing taga Canaan: ito ang mga angkan ni Simeon."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Exodo 6:16",
              "text": "At ito ang mga pangalan ng mga anak ni Levi ayon sa kanilang lahi; si Gerson, at si Coath, at si Merari; at ang mga naging taon ng buhay ni Levi ay isang daan at tatlong pu't pitong taon."
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Exodo 6:17",
              "text": "Ang mga anak ni Gerson; si Libni at si Shimi, ayon sa kanikanilang angkan."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Exodo 6:18",
              "text": "At ang mga anak ni Coath; si Amram, at si Izhar, at si Hebron, at si Uzziel; at ang mga naging taon ng buhay ni Coath ay isang daan at tatlong pu't tatlong taon."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Exodo 6:19",
              "text": "At ang mga anak ni Merari; si Mahali at si Musi. Ito ang mga angkan ng mga Levita ayon sa kanilang lahi."
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "Exodo 6:20",
              "text": "At nagasawa si Amram kay Jochebed na kapatid na babae ng kaniyang ama, at ipinanganak nito sa kaniya si Aaron at si Moises: at ang mga naging taon ng buhay ni Amram ay isang daan at tatlong pu't pitong taon."
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "Exodo 6:21",
              "text": "At ang mga anak ni Izhar; si Cora, at si Nepheg, at si Zithri."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "Exodo 6:22",
              "text": "At ang mga anak ni Uzziel; si Misael, at si Elzaphan, at si Zithri."
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "Exodo 6:23",
              "text": "At nagasawa si Aaron kay Elisabeth, na anak ni Aminadab, na kapatid ni Naason; at ipinanganak nito sa kaniya si Nadab at si Abiu, si Eleazar at si Ithamar."
            },
            {
              "chapter": 6,
              "verse": 24,
              "name": "Exodo 6:24",
              "text": "At ang mga anak ni Cora; si Assir, at si Elcana, at si Abiasaph; ito ang mga angkan ng mga Corita."
            },
            {
              "chapter": 6,
              "verse": 25,
              "name": "Exodo 6:25",
              "text": "At si Eleazar na anak ni Aaron, ay nagasawa sa isa sa mga anak ni Phutiel; at ipinanganak niya si Phinees. Ito ang mga pangulo sa mga sangbahayan ng mga magulang ng mga Levita ayon sa kanilang mga angkan."
            },
            {
              "chapter": 6,
              "verse": 26,
              "name": "Exodo 6:26",
              "text": "Ito'y yaong si Aaron at si Moises, na siyang pinagsabihan ng Panginoon. Ilabas ninyo ang mga anak ni Israel sa lupaing Egipto ayon sa kanilang mga hukbo."
            },
            {
              "chapter": 6,
              "verse": 27,
              "name": "Exodo 6:27",
              "text": "Ito ang mga nagsalita kay Faraon na hari sa Egipto, upang ilabas ang mga anak ni Israel sa Egipto: ang mga ito'y si Moises at si Aaron."
            },
            {
              "chapter": 6,
              "verse": 28,
              "name": "Exodo 6:28",
              "text": "At nangyari ng araw na magsalita ang Panginoon kay Moises sa lupain ng Egipto,"
            },
            {
              "chapter": 6,
              "verse": 29,
              "name": "Exodo 6:29",
              "text": "Na sinalita ng Panginoon kay Moises, na sinasabi, Ako nga ang Panginoon; salitain mo kay Faraon na hari sa Egipto, ang lahat ng aking sinasalita sa iyo."
            },
            {
              "chapter": 6,
              "verse": 30,
              "name": "Exodo 6:30",
              "text": "At sinabi ni Moises sa harap ng Panginoon, Narito ako'y may mga labing di tuli, at paanong si Faraon ay makikinig sa akin?"
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Exodo 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Exodo 7:1",
              "text": "At sinabi ng Panginoon kay Moises, Tingnan mo, ginawa kitang dios kay Faraon: at si Aaron na iyong kapatid ay magiging iyong propeta."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Exodo 7:2",
              "text": "Iyong sasalitaing lahat ang aking iniuutos sa iyo: at sasalitain kay Faraon ni Aaron na iyong kapatid upang kaniyang pahintulutan ang mga anak ni Israel ay lumabas sa kaniyang lupain."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Exodo 7:3",
              "text": "At aking papagmamatigasin ang puso ni Faraon, at aking pararamihin ang aking mga tanda at ang aking mga kababalaghan sa lupain ng Egipto."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Exodo 7:4",
              "text": "Nguni't si Faraon ay hindi makikinig sa inyo, at aking ipapatong sa Egipto ang aking kamay at ilalabas ko ang aking mga hukbo, ang aking bayan, na mga anak ni Israel, sa lupaing Egipto sa pamamagitan ng mga dakilang kahatulan."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Exodo 7:5",
              "text": "At malalaman ng mga taga Egipto na ako ang Panginoon, pagka iniunat ko sa Egipto ang aking kamay, at pagka inilabas ko ang mga anak ni Israel sa gitna nila."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Exodo 7:6",
              "text": "At ginawang gayon ni Moises at ni Aaron: kung paanong iniutos ng Panginoon sa kanila, ay gayon ginawa nila."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Exodo 7:7",
              "text": "At si Moises ay may walong pung taon gulang, at si Aaron ay may walong pu't tatlong taong gulang nang sila'y magsalita kay Faraon."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Exodo 7:8",
              "text": "At nagsalita ang Panginoon kay Moises at kay Aaron, na sinasabi,"
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Exodo 7:9",
              "text": "Pagsasalita ni Faraon sa inyo, na sasabihin, Magpakita kayo ng isang kababalaghan sa ganang inyo; ay iyo ngang sasabihin kay Aaron: Kunin mo ang iyong tungkod, at ihagis mo sa harap ni Faraon, na magiging isang ahas."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Exodo 7:10",
              "text": "At si Moises at si Aaron ay naparoon kay Faraon, at kanilang ginawang gayon gaya ng iniutos ng Panginoon, at inihagis ni Aaron ang kaniyang tungkod sa harap ni Faraon at sa harap ng kaniyang mga lingkod at naging ahas."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Exodo 7:11",
              "text": "Nang magkagayo'y tinawag naman ni Faraon ang mga marunong at ang mga manghuhula, at sila naman na mga mahiko sa Egipto, ay gumawa sa gayon ding paraan ng kanilang mga pag-enkanto."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Exodo 7:12",
              "text": "Sapagka't inihagis ng bawa't isa ang kanikaniyang tungkod, at nangaging ahas: nguni't nilamon ng tungkod ni Aaron ang mga tungkod nila."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Exodo 7:13",
              "text": "At ang puso ni Faraon ay nagmatigas, at hindi niya dininig sila; gaya ng sinalita ng Panginoon."
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Exodo 7:14",
              "text": "At sinabi ng Panginoon kay Moises, Ang puso ni Farao'y nagmatigas, ayaw niyang paalisin ang bayan."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Exodo 7:15",
              "text": "Pumaroon ka kay Faraon kinaumagahan; narito, siya'y pasasa tubig; at ikaw ay tatayo sa tabi ng ilog upang matagpuan mo siya; at ang tungkod na naging ahas ay iyong tatangnan sa iyong kamay."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Exodo 7:16",
              "text": "At iyong sasabihin sa kaniya, Sinugo ako sa iyo ng Panginoon, ng Dios ng mga Hebreo, na sinasabi, Pahintulutan mong ang aking bayan ay yumaon, upang sila'y makapaglingkod sa akin sa ilang at, narito, hanggang ngayo'y hindi mo dininig."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Exodo 7:17",
              "text": "Ganito ang sabi ng Panginoon, Dito mo makikilala, na ako ang Panginoon: narito, aking papaluin ng tungkod, na nasa aking kamay, ang tubig, na nasa ilog at magiging dugo."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Exodo 7:18",
              "text": "At ang mga isda, na nasa ilog ay mamamatay, at ang ilog ay babaho; at ang mga Egipcio ay masusuklam na uminom ng tubig sa ilog."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Exodo 7:19",
              "text": "At sinabi ng Panginoon kay Moises, Sabihin mo kay Aaron, Kunin mo ang iyong tungkod, at iunat mo ang iyong kamay sa tubig sa Egipto, sa kanilang mga ilog, sa kanilang mga bangbang, at sa kanilang mga lawa at sa lahat nilang tipunan ng tubig, upang mga maging dugo; at magkakadugo sa buong lupain ng Egipto, maging sa mga sisidlang kahoy at maging sa mga sisidlang bato."
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Exodo 7:20",
              "text": "At ginawang gayon ni Moises at ni Aaron, gaya ng iniutos ng Panginoon; at kaniyang itinaas ang tungkod, at pinalo ang tubig, na nasa ilog, sa paningin ni Faraon, at sa paningin ng kaniyang mga lingkod; at ang lahat ng tubig, na nasa ilog ay naging dugo."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Exodo 7:21",
              "text": "At ang isda, na nasa tubig ay namatay; at ang ilog ay bumaho at ang mga Egipcio ay hindi makainom ng tubig sa ilog; at nagkadugo sa buong lupain ng Egipto."
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Exodo 7:22",
              "text": "At ang mga mahiko sa Egipto ay gumawa ng gayon din, sa pamamagitan ng kanilang mga enkanto; at ang puso ni Faraon ay nagmatigas, at hindi niya dininig sila; gaya ng sinalita ng Panginoon."
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Exodo 7:23",
              "text": "At si Faraon ay pumihit at umuwi sa kaniyang bahay, na hindi man lamang nabagbag ang kaniyang puso."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Exodo 7:24",
              "text": "At lahat ng mga Egipcio ay humukay sa palibot ng ilog, upang makasumpong ng tubig na mainom; sapagka't sila'y hindi makainom ng tubig sa ilog."
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "Exodo 7:25",
              "text": "At naganap ang pitong araw, pagkatapos na masalot ng Panginoon ang ilog."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Exodo 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Exodo 8:1",
              "text": "At sinalita ng Panginoon kay Moises, Pasukin mo si Faraon at sabihin mo sa kaniya, Ganito ang sabi ng Panginoon, Tulutan mong yumaon ang aking bayan, upang ako'y mapaglingkuran nila."
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Exodo 8:2",
              "text": "At kung ayaw mo silang payaunin, ay narito, aking sasalutin ng mga palaka ang inyong buong lupain:"
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Exodo 8:3",
              "text": "At ang ilog ay mapupuno ng mga palaka, na magsisiahon at magsisipasok sa iyong bahay, at sa iyong tulugan, at sa iyong higaan, at sa bahay ng iyong mga lingkod, at sa iyong bayan, at sa iyong mga hurno, at sa iyong mga masa ng tinapay."
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Exodo 8:4",
              "text": "At kapuwa aakyatin ng mga palaka ikaw at ang iyong bayan, at lahat ng iyong mga lingkod."
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Exodo 8:5",
              "text": "At sinabi ng Panginoon kay Moises, Sabihin mo kay Aaron, Iunat mo ang iyong kamay pati ng iyong tungkod sa mga ilog, sa mga bangbang, at sa mga lawa, at magpaahon ka ng mga palaka sa lupain ng Egipto."
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Exodo 8:6",
              "text": "At iniunat ni Aaron ang kaniyang kamay sa tubig sa Egipto; at ang mga palaka ay nagsiahon, at tinakpan ang lupain ng Egipto."
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Exodo 8:7",
              "text": "At ang mga mahiko ay gumawa ng gayon din sa pamamagitan ng kanilang mga enkanto, at nagpaahon ng mga palaka sa lupain ng Egipto."
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Exodo 8:8",
              "text": "Nang magkagayo'y tinawag ni Faraon si Moises at si Aaron, at sinabi, Manalangin kayo sa Panginoon, na alisin ang mga palaka sa akin, at sa aking bayan; at aking tutulutang yumaon, ang bayan upang sila'y makapaghain sa Panginoon."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Exodo 8:9",
              "text": "At sinabi ni Moises kay Faraon, Magkaroon ka ng kaluwalhatiang ito sa akin: anong oras isasamo kita, at ang iyong mga lingkod, at ang iyong bayan, upang ang mga palaka ay malipol sa iyo at sa iyong mga bahay, at mangatira na lamang sa ilog?"
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Exodo 8:10",
              "text": "At kaniyang sinabi, Sa kinabukasan. At sinabi ni Moises, Mangyayari ayon sa iyong salita: upang iyong maalaman na walang gaya ng Panginoon naming Dios."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Exodo 8:11",
              "text": "At ang mga palaka ay magsisialis sa iyo, at sa iyong bahay, at sa iyong mga lingkod, at sa iyong bayan; mangatitira na lamang sa ilog."
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Exodo 8:12",
              "text": "At si Moises at si Aaron ay umalis sa harap ni Faraon: at si Moises ay dumaing sa Panginoon tungkol sa mga palaka na kaniyang dinala kay Faraon."
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Exodo 8:13",
              "text": "At ginawa ng Panginoon ayon sa salita ni Moises, at ang mga palaka ay namatay sa mga bahay, sa mga looban at sa mga parang."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Exodo 8:14",
              "text": "At kanilang pinagpisan sa buntonbunton: at ang lupa ay bumaho."
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Exodo 8:15",
              "text": "Nguni't nang makita ni Faraon na may pahinga ay pinapagmatigas ang kaniyang puso, at hindi niya dininig sila; gaya ng sinalita ng Panginoon."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Exodo 8:16",
              "text": "At sinabi ng Panginoon kay Moises, Sabihin mo kay Aaron: Iunat mo ang iyong tungkod, at paluin mo ang alabok ng lupa, upang maging mga kuto sa lupaing Egipto."
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Exodo 8:17",
              "text": "At kaniyang ginawang gayon; at iniunat ni Aaron ang kaniyang kamay pati ng kaniyang tungkod, at pinalo ang alabok ng lupa, at nagkakuto sa tao at sa hayop; lahat ng alabok ng lupa ay naging mga kuto sa buong lupain ng Egipto."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "Exodo 8:18",
              "text": "At ang mga mahiko ay gumawa ng gayon sa pamamagitan ng kanilang mga enkanto, upang maglabas ng mga kuto, nguni't hindi nila nagawa: at nagkakuto sa tao at sa hayop."
            },
            {
              "chapter": 8,
              "verse": 19,
              "name": "Exodo 8:19",
              "text": "Nang magkagayo'y sinabi ng mga mahiko kay Faraon, Ito'y daliri ng Dios: at ang puso ni Faraon ay nagmatigas, at hindi niya dininig sila; gaya ng sinalita ng Panginoon."
            },
            {
              "chapter": 8,
              "verse": 20,
              "name": "Exodo 8:20",
              "text": "At sinabi ng Panginoon kay Moises, Bumangon kang maaga sa kinaumagahan, at tumayo ka sa harap ni Faraon; narito, siya'y pasasa tubig, at sabihin mo sa kaniya, Ganito ang sabi ng Panginoon: Payaunin mo ang aking bayan upang sila'y makapaglingkod sa akin."
            },
            {
              "chapter": 8,
              "verse": 21,
              "name": "Exodo 8:21",
              "text": "Saka kung hindi mo payayaunin ang aking bayan ay magsusugo ako ng pulupulutong na langaw sa iyo, at sa iyong mga lingkod, at sa iyong bayan, at sa loob ng iyong mga bahay: at ang mga bahay ng mga Egipcio ay mapupuno ng pulupulutong na langaw, at gayon din ang lupa na kinaroroonan nila."
            },
            {
              "chapter": 8,
              "verse": 22,
              "name": "Exodo 8:22",
              "text": "At aking ihihiwalay sa araw na yaon ang lupain ng Gosen, na kinatatahanan ng aking bayan, upang huwag magkaroon doon ng pulupulutong na langaw: ng iyong maalaman na ako ang Panginoon sa gitna ng lupa."
            },
            {
              "chapter": 8,
              "verse": 23,
              "name": "Exodo 8:23",
              "text": "At aking paghihiwalayin ang aking bayan at ang iyong bayan: sa kinabukasan mangyayari ang tandang ito."
            },
            {
              "chapter": 8,
              "verse": 24,
              "name": "Exodo 8:24",
              "text": "At ginawang gayon ng Panginoon, at nagsipasok ang mga makapal na pulupulutong na langaw sa bahay ni Faraon, at sa bahay ng kaniyang mga lingkod: at sa buong lupain ng Egipto ay nasisira ang lupa dahil sa mga pulupulutong na langaw."
            },
            {
              "chapter": 8,
              "verse": 25,
              "name": "Exodo 8:25",
              "text": "At tinawag ni Faraon si Moises at si Aaron, at sinabi, Yumaon kayo, maghain kayo sa inyong Dios sa lupain."
            },
            {
              "chapter": 8,
              "verse": 26,
              "name": "Exodo 8:26",
              "text": "At sinabi ni Moises, Hindi marapat na aming gawing ganyan; sapagka't aming ihahain ang mga kasuklamsuklam ng mga Egipcio, sa Panginoon naming Dios: narito, ihahain ba namin ang kasuklamsuklam ng mga Egipcio sa harap ng kanilang mga mata at di ba nila kami babatuhin?"
            },
            {
              "chapter": 8,
              "verse": 27,
              "name": "Exodo 8:27",
              "text": "Kami ay yayaong tatlong araw na maglalakbay sa ilang, at maghahain sa Panginoon naming Dios, ayon sa kaniyang iniutos sa amin."
            },
            {
              "chapter": 8,
              "verse": 28,
              "name": "Exodo 8:28",
              "text": "At sinabi ni Faraon, Aking payayaunin kayo upang kayo'y makapaghain sa Panginoon ninyong Dios sa ilang; huwag lamang kayong pakakalayo: tuloy idaing ninyo ako."
            },
            {
              "chapter": 8,
              "verse": 29,
              "name": "Exodo 8:29",
              "text": "At sinabi ni Moises, Narito iiwan kita, at aking idadalangin sa Panginoon, na ang mga pulupulutong na langaw ay magsialis bukas kay Faraon, sa kaniyang mga lingkod, at sa kaniyang bayan: nguni't huwag nang magdaya pa si Faraon, na huwag na di payaunin ang bayan, upang maghain sa Panginoon."
            },
            {
              "chapter": 8,
              "verse": 30,
              "name": "Exodo 8:30",
              "text": "At iniwan ni Moises si Faraon, at nanalangin sa Panginoon."
            },
            {
              "chapter": 8,
              "verse": 31,
              "name": "Exodo 8:31",
              "text": "At ginawa ng Panginoon ang ayon sa salita ni Moises; at inialis niya ang mga pulupulutong na langaw kay Faraon, sa kaniyang mga lingkod, at sa kaniyang bayan; na walang natira kahit isa."
            },
            {
              "chapter": 8,
              "verse": 32,
              "name": "Exodo 8:32",
              "text": "At pinapagmatigas ding muli ni Faraon ang kaniyang puso at hindi pinayaon ang bayan."
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Exodo 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Exodo 9:1",
              "text": "Nang magkagayon ay sinabi ng Panginoon kay Moises, Pasukin mo si Faraon, at saysayin mo sa kaniya. Ganito ang sabi ng Panginoon, ng Dios ng mga Hebreo: Payaunin mo ang aking bayan, upang ako'y mapaglingkuran nila."
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Exodo 9:2",
              "text": "Sapagka't kung tatanggihan mong payaunin sila, at sila'y pipigilin mo pa,"
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Exodo 9:3",
              "text": "Ay narito, ang kamay ng Panginoon ay nakapatong sa iyong hayop na nasa parang, nakapatong sa mga kabayo, nakapatong sa mga asno, nakapatong sa mga kamello, nakapatong sa mga bakahan, at nakapatong sa mga kawan; na magkakaroon ng malaking pagkakasalot."
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Exodo 9:4",
              "text": "At gagawan ng katangian ng Panginoon ang hayop ng Israel at ang hayop ng Egipto: at walang mamamatay sa lahat ng ukol sa mga anak ni Israel."
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Exodo 9:5",
              "text": "At ang Panginoon ay nagtakda ng panahon, na sinasabi, Bukas ay gagawin ng Panginoon ang bagay na ito sa lupain."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Exodo 9:6",
              "text": "At ginawa ng Panginoon ang bagay na yaon ng kinabukasan, at ang lahat ng hayop sa Egipto ay namatay: nguni't sa hayop ng mga anak ni Israel ay walang namatay kahit isa."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Exodo 9:7",
              "text": "At si Faraon ay nagsugo, at narito, walang namatay kahit isa sa kawan ng mga Israelita. Nguni't ang puso ni Faraon ay nagmatigas, at hindi niya pinayaon ang bayan."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Exodo 9:8",
              "text": "At sinabi ng Panginoon kay Moises at kay Aaron, Dumakot kayo ng isang dakot na abo sa hurno, at isaboy ni Moises sa himpapawid sa paningin ni Faraon."
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Exodo 9:9",
              "text": "At magiging durog na alabok sa buong lupain ng Egipto, at magiging bukol na naknakin sa tao, at sa hayop, sa buong lupain ng Egipto."
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Exodo 9:10",
              "text": "At sila'y kumuha ng abo sa hurno, at tumayo sa harap ni Faraon, at isinaboy ni Moises sa himpapawid; at naging bukol na naknakin sa tao at sa hayop."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Exodo 9:11",
              "text": "At ang mga mahiko ay hindi makatayo sa harap ni Moises dahil sa mga bukol; sapagka't nagkabukol ang mga mahiko at ang mga Egipcio."
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Exodo 9:12",
              "text": "At pinapagmatigas ng Panginoon ang puso ni Faraon, at hindi niya dininig sila gaya ng sinalita ng Panginoon kay Moises."
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Exodo 9:13",
              "text": "At sinabi ng Panginoon kay Moises, Bumangon kang maaga sa kinaumagahan, at tumayo ka sa harap ni Faraon, at sabihin mo sa kaniya: Ganito ang sabi ng Panginoon, ng Dios ng mga Hebreo: Payaunin mo ang aking bayan, upang ako'y mapaglingkuran nila."
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Exodo 9:14",
              "text": "Sapagka't ngayo'y ibubugso ko na ang lahat ng aking salot sa iyong puso, at sa iyong mga lingkod, at sa iyong bayan upang iyong maalaman na walang gaya ko sa buong lupa."
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Exodo 9:15",
              "text": "Sapagka't ngayo'y iniunat ko na ang aking kamay, upang salutin kita, at ang iyong bayan, at nawala ka na sa lupa:"
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Exodo 9:16",
              "text": "Datapuwa't totoong totoo, na dahil dito ay pinatayo kita, upang maipakilala sa iyo ang aking kapangyarihan, at upang ang aking pangalan ay mahayag sa buong lupa."
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Exodo 9:17",
              "text": "Nagmamalaki ka pa ba laban sa aking bayan, na ayaw mo silang payaunin?"
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Exodo 9:18",
              "text": "Narito, bukas, sa ganitong oras, ay magpapaulan ako ng malakas na granizo, na kailan ma'y hindi nagkaroon sa Egipto mula nang araw na itayo hanggang ngayon."
            },
            {
              "chapter": 9,
              "verse": 19,
              "name": "Exodo 9:19",
              "text": "Ngayon nga'y magsugo ka, ipasilong mo ang iyong mga hayop at lahat ng iyong tinatangkilik sa parang; sapagka't bawa't tao at hayop na maabutan sa parang, at hindi masisilong, ay lalakpakan ng granizo at mamamatay."
            },
            {
              "chapter": 9,
              "verse": 20,
              "name": "Exodo 9:20",
              "text": "Yaong natakot sa salita ng Panginoon, sa mga lingkod ni Faraon ay nagpauwing madali ng kaniyang mga bataan at ng kaniyang hayop sa mga bahay:"
            },
            {
              "chapter": 9,
              "verse": 21,
              "name": "Exodo 9:21",
              "text": "At yaong nagwalang bahala sa salita ng Panginoon ay nagpabaya ng kaniyang mga bataan at ng kaniyang kawan sa parang."
            },
            {
              "chapter": 9,
              "verse": 22,
              "name": "Exodo 9:22",
              "text": "At sinabi ng Panginoon kay Moises, Iunat mo ang iyong kamay sa dakong langit, upang magkaroon ng granizo sa buong lupain ng Egipto, na lumagpak sa tao, at sa hayop, at sa bawa't halaman sa parang sa buong lupain ng Egipto."
            },
            {
              "chapter": 9,
              "verse": 23,
              "name": "Exodo 9:23",
              "text": "At iniunat ni Moises ang kaniyang tungkod sa dakong langit; at ang Panginoo'y nagsugo ng kulog at granizo, at may apoy na lumagpak sa lupa; at ang Panginoo'y nagpaulan ng granizo sa lupain ng Egipto."
            },
            {
              "chapter": 9,
              "verse": 24,
              "name": "Exodo 9:24",
              "text": "Sa gayo'y nagkaroon ng granizo at apoy, na nagniningning sa granizo, at napakalakas, na kailan ma'y hindi nagkaroon sa buong lupain ng Egipto mula nang maging bansa."
            },
            {
              "chapter": 9,
              "verse": 25,
              "name": "Exodo 9:25",
              "text": "At sinalot ng granizo ang buong lupain ng Egipto, ang lahat na nasa parang, maging tao at maging hayop, at sinalot ng granizo ang lahat ng halaman sa parang, at binali ang lahat ng punong kahoy sa parang."
            },
            {
              "chapter": 9,
              "verse": 26,
              "name": "Exodo 9:26",
              "text": "Sa lupain lamang ng Gosen, na kinaroroonan ng mga anak ni Israel, hindi nagkaroon ng granizo."
            },
            {
              "chapter": 9,
              "verse": 27,
              "name": "Exodo 9:27",
              "text": "At si Faraon ay nagsugo, at ipinatawag si Moises at si Aaron, at sinabi sa kanila, Ako'y nagkasala ngayon: ang Panginoo'y matuwid; at ako at ang aking bayan ay masama."
            },
            {
              "chapter": 9,
              "verse": 28,
              "name": "Exodo 9:28",
              "text": "Dalanginan ninyo ang Panginoon; sapagka't nagkaroon na ng sukat na malalakas na kulog at granizo; at kayo'y aking payayaunin, at di ko na kayo bibinbinin."
            },
            {
              "chapter": 9,
              "verse": 29,
              "name": "Exodo 9:29",
              "text": "At sinabi ni Moises sa kaniya, Pagkalabas ko sa bayan, ay aking ilalahad ang aking mga kamay sa Panginoon; at ang mga kulog ay titigil, at hindi na magkakaroon pa ng anomang granizo; upang iyong maalaman na ang lupa'y sa Panginoon."
            },
            {
              "chapter": 9,
              "verse": 30,
              "name": "Exodo 9:30",
              "text": "Nguni't tungkol sa iyo at sa iyong mga lingkod, ay nalalaman ko, na di pa kayo matatakot sa Panginoong Dios."
            },
            {
              "chapter": 9,
              "verse": 31,
              "name": "Exodo 9:31",
              "text": "At ang lino at ang cebada ay nasaktan; sapagka't ang cebada ay naguuhay na at ang lino ay namumulaklak na."
            },
            {
              "chapter": 9,
              "verse": 32,
              "name": "Exodo 9:32",
              "text": "Datapuwa't ang trigo at ang espelta ay hindi nasaktan: sapagka't hindi pa tumutubo."
            },
            {
              "chapter": 9,
              "verse": 33,
              "name": "Exodo 9:33",
              "text": "At si Moises ay lumabas sa bayan na galing kay Faraon, at inilahad ang kaniyang mga kamay sa Panginoon: at ang mga kulog at ang granizo ay tumigil, at ang ulan ay di na lumagpak sa lupa."
            },
            {
              "chapter": 9,
              "verse": 34,
              "name": "Exodo 9:34",
              "text": "At nang makita ni Faraon, na ang ulan, at ang granizo, at ang mga kulog ay tumigil, ay lalong nagkasala pa, at nagmatigas ang kaniyang puso, siya at ang kaniyang mga lingkod."
            },
            {
              "chapter": 9,
              "verse": 35,
              "name": "Exodo 9:35",
              "text": "At ang puso ni Farao'y nagmatigas, at hindi niya pinayaon ang mga anak ni Israel; gaya ng sinalita ng Panginoon sa pamamagitan ni Moises."
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Exodo 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Exodo 10:1",
              "text": "At sinabi ng Panginoon kay Moises: Pasukin mo si Faraon, sapagka't aking pinapagmatigas ang kaniyang puso, at ang puso ng kaniyang mga lingkod; upang aking maipakilala itong aking mga tanda sa gitna nila:"
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Exodo 10:2",
              "text": "At upang iyong maisaysay sa mga pakinig ng iyong anak, at sa anak ng iyong anak, kung anong mga bagay ang ginawa ko sa Egipto, at ang aking mga tandang ginawa sa gitna nila; upang inyong maalaman, na ako ang Panginoon."
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Exodo 10:3",
              "text": "At pinasok ni Moises at ni Aaron si Faraon at sinabi sa kaniya, Ganito ang sabi ng Panginoon, ng Dios ng mga Hebreo, Hanggang kailan tatanggi kang mangayupapa sa harap ko? payaunin mo ang aking bayan, upang ako'y mapaglingkuran nila."
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Exodo 10:4",
              "text": "O kung tatanggihan mong payaunin ang aking bayan, ay narito, bukas ay magdadala ako ng mga balang sa iyong hangganan:"
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Exodo 10:5",
              "text": "At kanilang tatakpan ang ibabaw ng lupa, na walang makakakita ng ibabaw ng lupa: at kanilang kakanin ang naiwan sa nangaligtas, na itinira sa inyo ng granizo, at kanilang kakanin ang bawa't kahoy na itinutubo sa inyo ng parang:"
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Exodo 10:6",
              "text": "At ang inyong mga bahay ay mapupuno, at ang mga bahay ng lahat mong lingkod, at ang mga bahay ng mga Egipcio: na hindi nakita ng inyong mga magulang, mula nang araw na sila'y mapasa lupa hanggang sa araw na ito. At siya'y pumihit at nilisan si Faraon."
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Exodo 10:7",
              "text": "At sinabi sa kaniya ng mga lingkod ni Faraon, Hanggang kailan magiging isang silo sa atin ang taong ito? payaunin mo ang mga taong iyan upang sila'y makapaglingkod sa Panginoon nilang Dios: hindi mo pa ba natatalastas, na ang Egipto'y giba na?"
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Exodo 10:8",
              "text": "At si Moises at si Aaron ay pinapagbalik kay Faraon, at kaniyang sinabi sa kanila, Kayo'y yumaon, maglingkod kayo sa Panginoon ninyong Dios: datapuwa't sino sino yaong magsisiyaon?"
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Exodo 10:9",
              "text": "At sinabi ni Moises: Kami ay yayaon sangpu ng aming mga bata at sangpu ng mga matanda, sangpu ng aming mga anak na lalake at babae, sangpu ng aming mga kawan at sangpu ng aming mga bakahan, kami ay yayaon; sapagka't kami ay nararapat magdiwang ng isang pista sa Panginoon."
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Exodo 10:10",
              "text": "At kaniyang sinabi sa kanila, Sumainyo nawa ang Panginoon, na gaya ng aking pagpapayaon sa inyo, at sa inyong mga bata: magingat kayo; sapagka't ang kasamaan ay nasa harap ninyo."
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Exodo 10:11",
              "text": "Huwag ganyan: yumaon kayong mga lalake, at maglingkod sa Panginoon; sapagka't iyan ang inyong ninanasa. At sila'y pinaalis sa harap ni Faraon."
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Exodo 10:12",
              "text": "At sinabi ng Panginoon kay Moises, Iunat mo ang iyong kamay sa lupain ng Egipto, upang magdala ng mga balang, at bumaba sa lupain ng Egipto, at kumain ng lahat na halaman sa lupain, yaong lahat na iniwan ng granizo."
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Exodo 10:13",
              "text": "At iniunat ni Moises ang kaniyang tungkod sa lupain ng Egipto, at ang Panginoo'y nagpahihip ng hanging silanganan sa lupain ng buong araw na yaon, at ng buong gabi; at nang maumaga, ang hanging silanganan ay nagdala ng mga balang."
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Exodo 10:14",
              "text": "At ang mga balang ay bumaba sa buong lupain ng Egipto, at nagsipagpahinga sa lahat ng hangganan ng Egipto; totoong napakakapal; bago noon ay hindi nagkaroon ng gayong balang, at hindi na magkakaroon pa, pagkatapos noon, ng gayon."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Exodo 10:15",
              "text": "Sapagka't tinakpan ng mga yaon ang balat ng buong lupa, na ano pa't ang lupain ay nagdilim; at kinain ang lahat na halaman sa lupain, at ang lahat na bunga ng mga kahoy na iniwan ng granizo; at walang natirang anomang sariwang bagay, maging sa punong kahoy o sa halaman sa parang, sa buong lupain ng Egipto."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Exodo 10:16",
              "text": "Nang magkagayo'y tinawag na madali ni Faraon si Moises at si Aaron, at kaniyang sinabi, Ako'y nagkasala laban sa Panginoon ninyong Dios, at laban sa inyo."
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Exodo 10:17",
              "text": "Ngayon nga'y ipatawad mo, isinasamo ko sa iyo, ang aking kasalanan, na ngayon na lamang at idalangin ninyo sa Panginoon ninyong Dios, na kaniya lamang ilayo sa akin ang kamatayang ito."
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Exodo 10:18",
              "text": "At nilisan niya si Faraon, at nanalangin sa Panginoon."
            },
            {
              "chapter": 10,
              "verse": 19,
              "name": "Exodo 10:19",
              "text": "At pinapagbalik ng Panginoon ang isang napakalakas na hanging kalunuran, na siyang nagpaitaas sa mga balang, at tumangay ng mga yaon sa Dagat na Mapula; walang natira kahit isang balang sa buong hangganan ng Egipto."
            },
            {
              "chapter": 10,
              "verse": 20,
              "name": "Exodo 10:20",
              "text": "Datapuwa't pinapagmatigas ng Panginoon ang puso ni Faraon, at hindi niya pinayaon ang mga anak ni Israel."
            },
            {
              "chapter": 10,
              "verse": 21,
              "name": "Exodo 10:21",
              "text": "At sinabi ng Panginoon kay Moises, Iunat mo ang iyong kamay sa dakong langit, upang magdilim sa lupain ng Egipto, ng kadiliman na mahihipo."
            },
            {
              "chapter": 10,
              "verse": 22,
              "name": "Exodo 10:22",
              "text": "At iniunat ni Moises ang kaniyang kamay sa dakong langit; at nagsalimuutan ang dilim sa buong lupain ng Egipto, na tatlong araw;"
            },
            {
              "chapter": 10,
              "verse": 23,
              "name": "Exodo 10:23",
              "text": "Sila'y hindi nagkikita, at walang tumindig na sinoman sa kinaroroonan sa loob ng tatlong araw; kundi lahat ng mga anak ni Israel ay nagilaw sa kanikaniyang tahanan."
            },
            {
              "chapter": 10,
              "verse": 24,
              "name": "Exodo 10:24",
              "text": "At tinawag ni Faraon si Moises, at sinabi, Yumaon kayo, maglingkod kayo sa Panginoon; inyo lamang iwan ang inyong mga kawan at ang inyong mga bakahan; isama rin naman ninyo ang inyong mga bata."
            },
            {
              "chapter": 10,
              "verse": 25,
              "name": "Exodo 10:25",
              "text": "At sinabi ni Moises, ikaw ay nararapat ding magbigay sa aming kamay ng mga hain at mga handog na susunugin, upang aming maihain sa Panginoon naming Dios."
            },
            {
              "chapter": 10,
              "verse": 26,
              "name": "Exodo 10:26",
              "text": "Ang aming hayop man ay yayaong kasama namin; wala kahit isang paa na maiiwan; sapagka't sa kanila kami nararapat kumuha ng aming ipaglilingkod sa Panginoon naming Dios; at hindi namin nalalaman kung ano ang aming nararapat ipaglingkod sa Panginoon, hanggang sa kami ay dumating doon."
            },
            {
              "chapter": 10,
              "verse": 27,
              "name": "Exodo 10:27",
              "text": "Datapuwa't pinapagmatigas ng Panginoon ang puso ni Faraon, at hindi niya pinayaon sila."
            },
            {
              "chapter": 10,
              "verse": 28,
              "name": "Exodo 10:28",
              "text": "At sinabi ni Faraon sa kaniya, Umalis ka sa harap ko, iyong pagingatang huwag mo nang makitang muli ang aking mukha; sapagka't sa araw na iyong makita ang aking mukha ay mamamatay ka."
            },
            {
              "chapter": 10,
              "verse": 29,
              "name": "Exodo 10:29",
              "text": "At sinabi ni Moises, Mabuti ang sabi mo, hindi ko na muling makikita ang iyong mukha."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Exodo 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Exodo 11:1",
              "text": "At sinabi ng Panginoon kay Moises, May isang salot pa akong dadalhin kay Faraon at sa Egipto; pagkatapos niyaon ay pahihintulutan niyang kayo'y umalis dito: pagpapahintulot niya sa inyong yumaon, ay tunay na kayo'y samasamang palalayasin niya rito."
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Exodo 11:2",
              "text": "Magsalita ka ngayon sa pakinig ng bayan, at humingi ang bawa't lalake sa kaniyang kapuwa, at bawa't babae sa kaniyang kapuwa, ng mga hiyas na pilak, at ng mga hiyas na ginto."
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Exodo 11:3",
              "text": "At pinagbiyayaan ng Panginoon ang bayan, sa paningin ng mga Egipcio. Saka si Moises ay lalaking naging dakila sa lupain ng Egipto, sa paningin ng mga lingkod ni Faraon, at sa paningin ng bayan."
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Exodo 11:4",
              "text": "At sinabi ni Moises, Ganito ang sinasabi ng Panginoon, Sa may hating gabi ay lalabas ako sa gitna ng Egipto:"
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Exodo 11:5",
              "text": "At lahat ng mga panganay sa lupain ng Egipto ay mamamatay, mula sa panganay ni Faraon, na nakaluklok sa kaniyang luklukan, hanggang sa panganay ng aliping babaing nasa likuran ng gilingan; at ang lahat ng mga panganay sa mga hayop."
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Exodo 11:6",
              "text": "At magkakaroon ng malakas na hiyawan sa buong lupain ng Egipto, na hindi nagkaroon ng kaparis, at hindi na magkakaroon pa ng kaparis."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Exodo 11:7",
              "text": "Datapuwa't sa lahat ng anak ng Israel mula sa tao hanggang sa hayop, ay walang maggagalaw kahit isang aso ng kaniyang dila laban sa tao o sa hayop: upang inyong makilala kung paano ang pagkakalagay ng pagkakaiba ng Panginoon sa mga Egipcio at sa Israel."
            },
            {
              "chapter": 11,
              "verse": 8,
              "name": "Exodo 11:8",
              "text": "At bababain ako nitong lahat na iyong lingkod, at magsisiyukod sa akin, na magsasabi, Umalis ka, at ang buong bayan na sumusunod sa iyo: at pagkatapos niyaon ay aalis ako. At siya'y umalis sa harap ni Faraon na may maalab na galit."
            },
            {
              "chapter": 11,
              "verse": 9,
              "name": "Exodo 11:9",
              "text": "At sinabi ng Panginoon kay Moises, Hindi kayo didinggin ni Faraon: upang ang aking mga kababalaghan ay dumami sa lupain ng Egipto."
            },
            {
              "chapter": 11,
              "verse": 10,
              "name": "Exodo 11:10",
              "text": "At ginawa ni Moises at ni Aaron ang lahat ng mga kababalaghang ito sa harap ni Faraon: at pinapagmatigas ng Panginoon ang puso ni Faraon, at hindi niya pinahintulutan ang mga anak ni Israel ay umalis sa kaniyang lupain."
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Exodo 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Exodo 12:1",
              "text": "At ang Panginoon ay nagsalita kay Moises at kay Aaron sa lupain ng Egipto, na sinasabi,"
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Exodo 12:2",
              "text": "Ang buwang ito'y magiging sa inyo'y pasimula ng mga buwan: siyang magiging unang buwan ng taon sa inyo."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Exodo 12:3",
              "text": "Salitain ninyo sa buong kapisanan ng Israel na inyong sabihin: Sa ikasangpung araw ng buwang ito ay magsisikuha sila sa ganang kanila, bawa't lalake, ng isang kordero, ayon sa mga sangbahayan ng kanikanilang mga magulang, isang kordero sa bawa't sangbahayan:"
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Exodo 12:4",
              "text": "At kung ang sangbahayan ay napakakaunti upang kumain ng isang kordero, ay siya nga at ang kaniyang malapit na kapitbahay ay magsasalosalo sa isa ayon sa bilang ng mga tao; ayon sa bawa't tao na kumakain gagawin ninyo ang pagbilang, sa kordero."
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Exodo 12:5",
              "text": "Ang inyong korderong pipiliin ay yaong walang kapintasan, isang lalake, na iisahing taon: inyong kukunin sa mga tupa, o sa mga kambing:"
            },
            {
              "chapter": 12,
              "verse": 6,
              "name": "Exodo 12:6",
              "text": "At inyong aalagaan hanggang sa ikalabing apat na araw ng buwang ito, at papatayin ng buong kapulungan ng kapisanan ng Israel, sa paglubog ng araw."
            },
            {
              "chapter": 12,
              "verse": 7,
              "name": "Exodo 12:7",
              "text": "At kukuha sila ng dugo niyan, at ilalagay sa dalawang haligi ng pinto at sa itaas ng pintuan, sa mga bahay na kanilang kakainan."
            },
            {
              "chapter": 12,
              "verse": 8,
              "name": "Exodo 12:8",
              "text": "At kanilang kakanin ang laman sa gabing yaon, na inihaw sa apoy, at tinapay na walang lebadura, kakanin nilang kaulam ng mapapait na gulay."
            },
            {
              "chapter": 12,
              "verse": 9,
              "name": "Exodo 12:9",
              "text": "Huwag ninyong kaning hilaw, o luto man sa tubig, kundi inihaw sa apoy; ang kaniyang ulo pati ng kaniyang mga paa at pati ng kaniyang mga lamang loob."
            },
            {
              "chapter": 12,
              "verse": 10,
              "name": "Exodo 12:10",
              "text": "At huwag kayong magtitira ng anoman niyaon hanggang sa kinaumagahan; kundi yaong matitira niyaon sa kinaumagahan ay inyong susunugin sa apoy."
            },
            {
              "chapter": 12,
              "verse": 11,
              "name": "Exodo 12:11",
              "text": "At ganito ninyo kakanin; may bigkis ang inyong baywang, ang inyong mga pangyapak ay nakasuot sa inyong mga paa, at ang inyong tungkod ay tangnan ninyo sa inyong kamay; at inyong kakaning dalidali; siyang paskua ng Panginoon."
            },
            {
              "chapter": 12,
              "verse": 12,
              "name": "Exodo 12:12",
              "text": "Sapagka't ako'y dadaan sa lupain ng Egipto sa gabing yaon, at aking lilipulin ang lahat ng mga panganay sa lupain ng Egipto, maging tao at maging hayop; at gagawa ako ng kahatulan laban sa lahat ng mga dios sa Egipto, ako ang Panginoon."
            },
            {
              "chapter": 12,
              "verse": 13,
              "name": "Exodo 12:13",
              "text": "At ang dugo ay magiging sa inyo'y isang tanda sa mga bahay na inyong kinaroroonan: at pagka aking nakita ang dugo, ay lalampasan ko kayo, at walang salot na sasainyo, na papatay sa inyo, pananakit ko sa lupaing Egipto."
            },
            {
              "chapter": 12,
              "verse": 14,
              "name": "Exodo 12:14",
              "text": "At ang araw na ito'y magiging sa inyo'y isang alaala, at inyong ipagdidiwang na pinakapista sa Panginoon; sa buong panahon ng inyong lahi ay inyong ipagdidiwang na pinakapista na bilang tuntunin magpakailan man."
            },
            {
              "chapter": 12,
              "verse": 15,
              "name": "Exodo 12:15",
              "text": "Pitong araw na kakain kayo ng tinapay na walang lebadura; sa unang araw ay inyong ihihiwalay sa inyong mga bahay ang lebadura; sapagka't sinomang kumain ng tinapay na may lebadura mula sa unang araw hanggang sa ikapitong araw ay ihihiwalay sa Israel, ang taong yaon."
            },
            {
              "chapter": 12,
              "verse": 16,
              "name": "Exodo 12:16",
              "text": "At sa unang araw ay magkakaroon kayo ng isang banal na pagkakatipon at sa ikapitong araw man ay magkakaroon ding kayo ng isang banal na pagkakatipon; walang anomang gawa na gagawin sa mga araw na iyan, liban na yaong nararapat kanin ng bawa't tao, na siya lamang maaaring gawin ninyo."
            },
            {
              "chapter": 12,
              "verse": 17,
              "name": "Exodo 12:17",
              "text": "At iyong ipangingilin ang pista ng tinapay na walang lebadura; sapagka't sa araw ring ito kinuha ko ang inyong mga hukbo sa lupain ng Egipto: kaya't inyong ipangingilin ang araw na ito sa buong panahon ng inyong lahi, na bilang tuntunin magpakailan man."
            },
            {
              "chapter": 12,
              "verse": 18,
              "name": "Exodo 12:18",
              "text": "Sa unang buwan ng ikalabing apat na araw ng buwan sa paglubog ng araw ay kakain kayo ng tinapay na walang lebadura, hanggang sa ikadalawang pu't isang araw ng buwan, sa paglubog ng araw."
            },
            {
              "chapter": 12,
              "verse": 19,
              "name": "Exodo 12:19",
              "text": "Pitong araw, na walang masusumpungang lebadura sa inyong mga bahay: sapagka't sinomang kumain niyaong may lebadura, ay ihihiwalay sa kapisanan ng Israel, ang taong yaon, maging taga ibang lupa, o maging ipinanganak sa lupain."
            },
            {
              "chapter": 12,
              "verse": 20,
              "name": "Exodo 12:20",
              "text": "Huwag kayong kakain ng anomang bagay na may lebadura; sa lahat ng inyong mga tahanan ay kakain kayo ng tinapay na walang lebadura."
            },
            {
              "chapter": 12,
              "verse": 21,
              "name": "Exodo 12:21",
              "text": "Nang magkagayo'y ipinatawag ni Moises ang lahat ng matanda sa Israel, at sinabi sa kanila, Kayo'y lumabas at kumuha kayo ng mga kordero ayon sa inyo-inyong sangbahayan, at magpatay kayo ng kordero ng paskua."
            },
            {
              "chapter": 12,
              "verse": 22,
              "name": "Exodo 12:22",
              "text": "At kayo'y kukuha ng isang bigkis na hisopo, at inyong babasain sa dugo, na nasa palanggana, at inyong papahiran ng dugo na nasa palanggana, ang itaas ng pinto at ang dalawang haligi ng pinto: at sinoman sa inyo ay huwag lalabas sa pinto ng kaniyang bahay hanggang sa kinaumagahan."
            },
            {
              "chapter": 12,
              "verse": 23,
              "name": "Exodo 12:23",
              "text": "Sapagka't ang Panginoon ay daraan upang sugatan ang mga Egipcio; at pagkakita niya ng dugo sa itaas ng pinto at sa dalawang haligi ng pinto, ay lalampasan ng Panginoon ang pintong yaon, at hindi niya papayagan ang manunugat ay pumasok sa inyong mga bahay na sugatan kayo."
            },
            {
              "chapter": 12,
              "verse": 24,
              "name": "Exodo 12:24",
              "text": "At inyong ipangingilin ang bagay na ito, na pinakatuntunin sa iyo at sa iyong mga anak magpakailan man."
            },
            {
              "chapter": 12,
              "verse": 25,
              "name": "Exodo 12:25",
              "text": "At mangyayaring pagdating ninyo sa lupain na ibibigay sa inyo ng Panginoon, gaya ng kaniyang ipinangako, ay inyong tutuparin ang paglilingkod na ito."
            },
            {
              "chapter": 12,
              "verse": 26,
              "name": "Exodo 12:26",
              "text": "At mangyayaring pagsasabi sa inyo ng inyong mga anak: Anong ibig ninyong sabihin sa paglilingkod na ito?"
            },
            {
              "chapter": 12,
              "verse": 27,
              "name": "Exodo 12:27",
              "text": "Na inyong sasabihin: Siyang paghahain sa paskua ng Panginoon, na kaniyang nilampasan ang mga bahay ng mga anak ni Israel sa Egipto, nang kaniyang sugatan ang mga Egipcio, at iniligtas ang aming mga sangbahayan. At ang bayan ay nagyukod ng ulo at sumamba."
            },
            {
              "chapter": 12,
              "verse": 28,
              "name": "Exodo 12:28",
              "text": "At ang mga anak ni Israel ay yumaon at ginawang gayon; kung paanong iniutos ng Panginoon kay Moises at kay Aaron, ay gayong ginawa nila."
            },
            {
              "chapter": 12,
              "verse": 29,
              "name": "Exodo 12:29",
              "text": "At nangyari sa hating gabi, na nilipol ng Panginoon ang lahat ng mga panganay sa lupain ng Egipto, mula sa panganay ni Faraon na nakaluklok sa kaniyang luklukan, hanggang sa panganay ng bilanggo na nasa bilangguan; at lahat ng panganay sa mga hayop."
            },
            {
              "chapter": 12,
              "verse": 30,
              "name": "Exodo 12:30",
              "text": "At si Faraon ay bumangon sa kinagabihan, siya at lahat ng kaniyang mga lingkod, at lahat ng mga Egipcio, at nagkaroon ng isang malakas na hiyawan sa Egipto; sapagka't walang bahay na di mayroong isang patay."
            },
            {
              "chapter": 12,
              "verse": 31,
              "name": "Exodo 12:31",
              "text": "At kaniyang tinawag si Moises at si Aaron sa kinagabihan, at sinabi, Kayo'y bumangon, umalis kayo sa gitna ng aking bayan kayo at sangpu ng mga anak ni Israel; at kayo'y yumaong maglingkod sa Panginoon, gaya ng inyong sinabi."
            },
            {
              "chapter": 12,
              "verse": 32,
              "name": "Exodo 12:32",
              "text": "Dalhin ninyo kapuwa ang inyong mga kawan at ang inyong mga bakahan, gaya ng inyong sinabi, at kayo'y yumaon: at pagpalain din naman ninyo ako."
            },
            {
              "chapter": 12,
              "verse": 33,
              "name": "Exodo 12:33",
              "text": "At pinapagmadali ng mga Egipcio, ang bayan, na madaliang pinaalis sila sa lupain; sapagka't kanilang sinabi, Kaming lahat ay patay na."
            },
            {
              "chapter": 12,
              "verse": 34,
              "name": "Exodo 12:34",
              "text": "At dinala ng bayan ang kanilang masa bago humilab, na nababalot ang kanilang mga masa sa kanikanilang damit sa ibabaw ng kanikanilang balikat."
            },
            {
              "chapter": 12,
              "verse": 35,
              "name": "Exodo 12:35",
              "text": "At ginawa ng mga anak ni Israel ayon sa salita ni Moises; at sila'y humingi sa mga Egipcio ng mga hiyas na pilak, at mga hiyas na ginto, at mga damit:"
            },
            {
              "chapter": 12,
              "verse": 36,
              "name": "Exodo 12:36",
              "text": "At pinagbiyayaan ng Panginoon ang bayan sa paningin ng mga Egipcio, ano pa't ibinigay sa kanila anomang hingin nila. At kanilang hinubaran ang mga Egipcio."
            },
            {
              "chapter": 12,
              "verse": 37,
              "name": "Exodo 12:37",
              "text": "At ang angkan ni Israel ay naglakbay mula sa Rameses hanggang sa Succoth, na may anim na raang libong lalake na naglakad, bukod pa ang mga bata."
            },
            {
              "chapter": 12,
              "verse": 38,
              "name": "Exodo 12:38",
              "text": "At isang karamihang samasama ang sumampa rin namang kasabay nila; at mga kawan, at mga bakahan, na napakaraming hayop."
            },
            {
              "chapter": 12,
              "verse": 39,
              "name": "Exodo 12:39",
              "text": "At kanilang nilutong mga munting tinapay na walang lebadura ang masa na kanilang kinuha sa Egipto, sapagka't hindi pa humihilab, sapagka't sila'y itinaboy sa Egipto, at hindi sila nakatigil o nakapaghanda man ng anomang pagkain."
            },
            {
              "chapter": 12,
              "verse": 40,
              "name": "Exodo 12:40",
              "text": "Ang pakikipamayan nga ng mga anak ni Israel, na ipinakipamayan nila sa Egipto, ay apat na raan at tatlong pung taon."
            },
            {
              "chapter": 12,
              "verse": 41,
              "name": "Exodo 12:41",
              "text": "At nangyari sa katapusan ng apat na raan at tatlong pung taon, ng araw ding yaon ay nangyari, na ang lahat ng mga hukbo ng Panginoon ay umalis sa lupain ng Egipto."
            },
            {
              "chapter": 12,
              "verse": 42,
              "name": "Exodo 12:42",
              "text": "Ito ay isang gabing pangingilin sa Panginoon dahil sa paglalabas niya sa kanila sa lupain ng Egipto: ito ay yaong gabi ng Panginoon na ipangingilin ng lahat ng mga anak ni Israel sa buong panahon ng kanilang lahi."
            },
            {
              "chapter": 12,
              "verse": 43,
              "name": "Exodo 12:43",
              "text": "At sinabi ng Panginoon kay Moises at kay Aaron, Ito ang tuntunin sa paskua: walang sinomang taga ibang lupa na kakain niyaon:"
            },
            {
              "chapter": 12,
              "verse": 44,
              "name": "Exodo 12:44",
              "text": "Datapuwa't ang alipin ng bawa't lalake na nabili ng salapi, pagkatuli sa kaniya'y makakakain nga niyaon."
            },
            {
              "chapter": 12,
              "verse": 45,
              "name": "Exodo 12:45",
              "text": "Ang nakikipamayan at ang alilang binabayaran ay hindi kakain niyaon."
            },
            {
              "chapter": 12,
              "verse": 46,
              "name": "Exodo 12:46",
              "text": "Sa isang bahay kakanin; huwag kang magdadala ng laman sa labas ng bahay, ni sisira kayo ng kahit isang buto niyaon."
            },
            {
              "chapter": 12,
              "verse": 47,
              "name": "Exodo 12:47",
              "text": "Ipangingilin ng buong kapisanan ng Israel."
            },
            {
              "chapter": 12,
              "verse": 48,
              "name": "Exodo 12:48",
              "text": "At pagka ang isang taga ibang lupa ay makikipamayan kasama mo, at mangingilin ng paskua sa Panginoon, ay tuliin lahat ang kaniyang mga lalake at saka siya lumapit at ipangilin: at siya'y magiging parang ipinanganak sa lupain ninyo; datapuwa't sinomang di tuli ay hindi makakakain niyaon."
            },
            {
              "chapter": 12,
              "verse": 49,
              "name": "Exodo 12:49",
              "text": "Isang kautusan magkakaroon sa ipinanganak sa lupain, at sa taga ibang bayan na nakikipamayang kasama ninyo."
            },
            {
              "chapter": 12,
              "verse": 50,
              "name": "Exodo 12:50",
              "text": "Gayon ginawa ng lahat ng mga anak ni Israel; kung paanong iniutos ng Panginoon kay Moises at kay Aaron, gayon nila ginawa."
            },
            {
              "chapter": 12,
              "verse": 51,
              "name": "Exodo 12:51",
              "text": "At nangyari nang araw ding yaon, na kinuha ng Panginoon ang mga anak ni Israel sa lupain ng Egipto, ayon sa kanilang mga hukbo."
            }
          ]
        },
        {
          "chapter": 13,
          "name": "Exodo 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "Exodo 13:1",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "Exodo 13:2",
              "text": "Pakabanalin mo sa akin ang lahat ng mga panganay, anomang nagbubukas ng bahay-bata sa mga anak ni Israel: maging sa tao at maging sa hayop ay akin."
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "Exodo 13:3",
              "text": "At sinabi ni Moises sa bayan, Alalahanin ninyo ang araw na ito na inialis ninyo sa Egipto, sa bahay ng pagkaalipin; sapagka't sa pamamagitan ng lakas ng kamay ay hinango kayo ng Panginoon sa dakong ito, wala sinomang kakain ng tinapay na may lebadura."
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "Exodo 13:4",
              "text": "Sa araw na ito ay umaalis kayo ng buwan ng Abib."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "Exodo 13:5",
              "text": "At mangyayari, na pagkadala sa iyo ng Panginoon sa lupain ng Cananeo, at ng Hetheo, at ng Amorrheo, at ng Hebreo, at ng Jebuseo, na kaniyang isinumpa sa iyong mga magulang, na ibibigay sa iyo, na lupang binubukalan ng gatas at pulot ay iyong ipangingilin ang paglilingkod na ito sa buwang ito."
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "Exodo 13:6",
              "text": "Pitong araw na kakain ka ng tinapay na walang lebadura, at sa ikapitong araw ay magiging isang kapistahan sa Panginoon."
            },
            {
              "chapter": 13,
              "verse": 7,
              "name": "Exodo 13:7",
              "text": "Tinapay na walang lebadura ang kakanin sa loob ng pitong araw, at huwag makakakita sa iyo, ng tinapay na may lebadura, ni makakakita ng lebadura sa iyo, sa lahat ng iyong mga hangganan."
            },
            {
              "chapter": 13,
              "verse": 8,
              "name": "Exodo 13:8",
              "text": "At sasaysayin mo sa iyong anak sa araw na yaon, na iyong sasabihin: Dahil sa ginawa ng Panginoon sa akin nang ako'y umalis sa Egipto."
            },
            {
              "chapter": 13,
              "verse": 9,
              "name": "Exodo 13:9",
              "text": "At sa iyo'y magiging pinakatanda sa ibabaw ng iyong kamay, at pinakaalaala sa pagitan ng iyong mga mata, upang ang kautusan ng Panginoon ay sumaiyong bibig: sapagka't sa pamamagitan ng malakas na kamay, ay inalis ka ng Panginoon sa Egipto."
            },
            {
              "chapter": 13,
              "verse": 10,
              "name": "Exodo 13:10",
              "text": "Isasagawa mo nga ang palatuntunang ito sa kapanahunan nito taon taon."
            },
            {
              "chapter": 13,
              "verse": 11,
              "name": "Exodo 13:11",
              "text": "At mangyayari, pagkadala sa iyo ng Panginoon sa lupain ng Cananeo, gaya ng isinumpa sa iyo at sa iyong mga magulang, at pagkabigay niyaon sa iyo,"
            },
            {
              "chapter": 13,
              "verse": 12,
              "name": "Exodo 13:12",
              "text": "Ay ihihiwalay mo para sa Panginoon yaong lahat na nagbubukas ng bahay-bata, at bawa't panganay na mayroon ka na mula sa hayop; ang mga lalake, ay sa Panginoon."
            },
            {
              "chapter": 13,
              "verse": 13,
              "name": "Exodo 13:13",
              "text": "At bawa't panganay sa asno ay tutubusin mo ng isang kordero; at kung hindi mo tutubusin, ay iyo ngang babaliin ang kaniyang leeg: at lahat ng mga panganay na lalake sa iyong mga anak ay iyong tutubusin."
            },
            {
              "chapter": 13,
              "verse": 14,
              "name": "Exodo 13:14",
              "text": "At mangyayari, na pagtatanong sa iyo ng iyong anak sa panahong darating, na sasabihin, Ano ito? na iyong sasabihin sa kaniya: Sa pamamagitan ng lakas ng kamay ay inilabas tayo ng Panginoon sa Egipto, sa bahay ng pagkaalipin."
            },
            {
              "chapter": 13,
              "verse": 15,
              "name": "Exodo 13:15",
              "text": "At nangyari, nang magmatigas si Faraon na hindi kami tulutang yumaon, ay pinatay ng Panginoon ang lahat ng mga panganay sa lupain ng Egipto, ang panganay ng tao at gayon din ang panganay ng hayop: kaya't aking inihahain sa Panginoon ang lahat ng nagbubukas ng bahay-bata na mga lalake; nguni't lahat ng panganay ng aking anak ay aking tinutubos."
            },
            {
              "chapter": 13,
              "verse": 16,
              "name": "Exodo 13:16",
              "text": "At magiging pinakatanda sa iyong kamay, at pinakaalaala sa pagitan ng iyong mga mata: sapagka't sa pamamagitan ng lakas ng kamay ay inilabas tayo ng Panginoon sa Egipto."
            },
            {
              "chapter": 13,
              "verse": 17,
              "name": "Exodo 13:17",
              "text": "At nangyari, nang tulutan ni Faraon na ang bayan ay yumaon, na hindi sila pinatnubayan ng Dios sa daang patungo sa lupain ng mga Filisteo, bagaman malapit; sapagka't sinabi ng Dios, Baka sakaling ang bayan ay magsisi pagkakita ng pagbabaka, at magsipagbalik sa Egipto:"
            },
            {
              "chapter": 13,
              "verse": 18,
              "name": "Exodo 13:18",
              "text": "Kundi pinatnubayan ng Dios ang bayan sa palibot, sa daang patungo sa ilang sa tabi ng Dagat na Mapula: at ang mga anak ni Israel ay sumampang nangakasakbat mula sa lupain ng Egipto."
            },
            {
              "chapter": 13,
              "verse": 19,
              "name": "Exodo 13:19",
              "text": "At dinala ni Moises ang mga buto ni Jose: sapagka't kaniyang ipinanumpang mahigpit sa mga anak ni Israel, na sinasabi, Tunay na dadalawin kayo ng Dios; at inyong isasampa ang aking mga buto mula rito na kasama ninyo."
            },
            {
              "chapter": 13,
              "verse": 20,
              "name": "Exodo 13:20",
              "text": "At sila'y naglakbay mula sa Succoth, at humantong sa Etham, sa hangganan ng ilang."
            },
            {
              "chapter": 13,
              "verse": 21,
              "name": "Exodo 13:21",
              "text": "At ang Panginoon ay nangunguna sa kanila sa araw, sa isang haliging ulap, upang patnubayan sila sa daan; at sa gabi, ay sa isang haliging apoy, upang tanglawan sila; upang sila'y makapaglakad sa araw at sa gabi."
            },
            {
              "chapter": 13,
              "verse": 22,
              "name": "Exodo 13:22",
              "text": "Ang haliging ulap sa araw at ang haliging apoy sa gabi ay hindi humihiwalay sa harapan ng bayan."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "Exodo 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Exodo 14:1",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Exodo 14:2",
              "text": "Salitain mo sa mga anak ni Israel, na sila'y bumalik at humantong sa tapat ng Pi-hahiroth, sa pagitan ng Migdol at ng dagat, sa tapat ng Baalzephon: sa tapat niyaon hahantong kayo, sa tabi ng dagat."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Exodo 14:3",
              "text": "At sasabihin ni Faraon tungkol sa mga anak ni Israel: Nangasisilo sila sa lupain, sila'y naliligid ng ilang."
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Exodo 14:4",
              "text": "At aking papagmamatigasin ang puso ni Faraon, at kaniyang hahabulin sila at kayo'y magiimbot ng karangalan kay Faraon, at sa lahat niyang hukbo; at malalaman ng mga Egipcio, na ako ang Panginoon. At kanilang ginawang gayon."
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Exodo 14:5",
              "text": "At nasabi sa hari sa Egipto, na ang bayan ay tumakas: at ang puso ni Faraon at ng kaniyang mga lingkod ay nagbago tungkol sa bayan, at kanilang sinabi, Ano itong ating ginawa, na ating pinayaon ang Israel, upang huwag na tayong mapaglingkuran?"
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Exodo 14:6",
              "text": "At inihanda ni Faraon ang kaniyang karro, at kaniyang ipinagsama ang kaniyang bayan:"
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Exodo 14:7",
              "text": "At siya'y nagdala ng anim na raang piling karro, at lahat ng mga karro sa Egipto, at ng mga kapitan na namumuno sa lahat ng mga yaon."
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "Exodo 14:8",
              "text": "At pinapagmatigas ng Panginoon ang puso ni Faraon na hari sa Egipto, at hinabol niya ang mga anak ni Israel, sapagka't ang mga anak ni Israel ay nagsialis na may lubos na pagkakatiwala."
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "Exodo 14:9",
              "text": "At hinabol sila ng mga Egipcio, ng lahat ng mga kabayo at ng karro ni Faraon, at ng kaniyang mga taong mangangabayo, at ng kaniyang hukbo, at inabutan sila noong nakahantong sa tabi ng dagat, na nasa siping ng Pi-hahirot, sa tapat ng Baal-zefon."
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "Exodo 14:10",
              "text": "At nang si Faraon ay nalalapit, ay itiningin ng mga anak ni Israel ang kanilang mga mata, at, narito, ang mga Egipcio ay sumusunod sa kanila; at sila'y natakot na mainam: at ang mga anak ni Israel ay humibik sa Panginoon."
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "Exodo 14:11",
              "text": "At kanilang sinabi kay Moises, Dahil ba sa walang libingan sa Egipto, kung kaya dinala mo kami rito upang mamatay sa ilang? bakit ka gumawa ng ganito sa amin, na inilabas mo kami sa Egipto?"
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "Exodo 14:12",
              "text": "Di ba ito ang sinalita namin sa iyo sa Egipto, na sinasabi, Pabayaan mo kami na makapaglingkod sa mga Egipcio? Sapagka't lalong mabuti sa amin ang maglingkod sa mga Egipcio kay sa kami ay mamatay sa ilang."
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "Exodo 14:13",
              "text": "At sinabi ni Moises sa bayan, Huwag kayong matakot, tumigil kayo, at tingnan ninyo ang pagliligtas ng Panginoon na gagawin sa inyo ngayon: sapagka't ang mga Egipcio na inyong nakikita ngayon, ay hindi na ninyo uli makikita magpakailan man."
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "Exodo 14:14",
              "text": "Ipakikipaglaban kayo ng Panginoon, at kayo'y tatahimik."
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "Exodo 14:15",
              "text": "At sinabi ng Panginoon kay Moises, Bakit humihibik ka sa akin? salitain mo sa mga anak ni Israel na sila'y magpatuloy na yumaon."
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "Exodo 14:16",
              "text": "At itaas mo ang iyong tungkod, at iunat mo ang iyong kamay sa ibabaw ng dagat, at hawiin mo; at ang mga anak ni Israel ay dadaan sa gitna ng dagat sa ibabaw ng lupang tuyo."
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "Exodo 14:17",
              "text": "At ako, narito, aking papagmamatigasin ang puso ng mga Egipcio at susundan nila sila: at ako'y magiimbot ng karangalan kay Faraon, at sa buo niyang hukbo, sa kaniyang mga karro, at sa kaniyang mga nangangabayo."
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "Exodo 14:18",
              "text": "At malalaman ng mga Egipcio, na ako ang Panginoon, pagka ako ay nakapagimbot ng karangalan kay Faraon, sa kaniyang mga karro, at sa kaniyang mga nangangabayo."
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "Exodo 14:19",
              "text": "At ang anghel ng Dios na nasa unahan ng kampamento ng Israel, ay humiwalay at napasa hulihan nila; at ang haliging ulap ay humiwalay sa harap nila at lumagay sa likod nila:"
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "Exodo 14:20",
              "text": "At lumagay sa pagitan ng kampamento ng Egipto at ng kampamento ng Israel; at mayroong ulap at kadiliman, gayon ma'y binigyan sila ng liwanag sa gabi at ang isa't isa ay hindi nagkalapit sa buong magdamag."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "Exodo 14:21",
              "text": "At iniunat ni Moises ang kaniyang kamay sa ibabaw ng dagat; at pinaghiwalay ng Panginoon ang dagat sa pamamagitan ng isang malakas na hanging silanganan ng buong magdamag, at ang dagat ay pinapaging tuyong lupa at ang tubig ay nahawi."
            },
            {
              "chapter": 14,
              "verse": 22,
              "name": "Exodo 14:22",
              "text": "At ang mga anak ni Israel ay pumasok sa gitna ng dagat sa ibabaw ng tuyong lupa: at ang tubig ay naging isang kuta sa kanila, sa kanilang kanan at sa kanilang kaliwa."
            },
            {
              "chapter": 14,
              "verse": 23,
              "name": "Exodo 14:23",
              "text": "At hinabol sila ng mga Egipcio, at nagsipasok na kasunod nila sa gitna ng dagat, lahat ng mga kabayo ni Faraon, ang kaniyang mga karro, at ang kaniyang mga nangangabayo."
            },
            {
              "chapter": 14,
              "verse": 24,
              "name": "Exodo 14:24",
              "text": "At nangyari, sa pagbabantay sa kinaumagahan, na minasdan ng Panginoon ang hukbo ng mga Egipcio sa gitna ng haliging apoy at ulap, at niligalig ang hukbo ng mga Egipcio."
            },
            {
              "chapter": 14,
              "verse": 25,
              "name": "Exodo 14:25",
              "text": "At inalisan ng gulong ang kanilang mga karro, na kanilang hinila ng buong hirap: na ano pa't sinabi ng mga Egipcio, Tumakas tayo sa harap ng Israel: sapagka't ipinakikipaglaban sila ng Panginoon sa mga Egipcio."
            },
            {
              "chapter": 14,
              "verse": 26,
              "name": "Exodo 14:26",
              "text": "At sinabi ng Panginoon kay Moises, Iunat mo ang iyong kamay sa dagat, upang ang tubig ay tumabon sa mga Egipcio, sa kanilang mga karro, at sa kanilang mga nangangabayo."
            },
            {
              "chapter": 14,
              "verse": 27,
              "name": "Exodo 14:27",
              "text": "At iniunat ni Moises ang kaniyang kamay sa dagat, at ang dagat ay nagsauli sa kaniyang dating lakas, nang umumaga; at ang mga Egipcio ay nagsitakas, at nilaginlin ng Panginoon ang mga Egipcio sa gitna ng dagat."
            },
            {
              "chapter": 14,
              "verse": 28,
              "name": "Exodo 14:28",
              "text": "At ang tubig ay nagsauli, at tinakpan ang mga karro, at ang mga nangangabayo, sa makatuwid baga'y ang buong hukbo ni Faraon na pumasok na sumunod sa kanila sa dagat; walang natira kahit isa sa kanila."
            },
            {
              "chapter": 14,
              "verse": 29,
              "name": "Exodo 14:29",
              "text": "Datapuwa't ang mga anak ni Israel ay lumakad sa tuyong lupa sa gitna ng dagat; at ang tubig sa kanila ay naging isang kuta sa kanilang kanan at sa kanilang kaliwa."
            },
            {
              "chapter": 14,
              "verse": 30,
              "name": "Exodo 14:30",
              "text": "Gayon iniligtas ng Panginoon ang Israel ng araw na yaon sa kamay ng mga Egipcio; at nakita ng Israel ang mga Egipcio na mga patay sa tabi ng dagat."
            },
            {
              "chapter": 14,
              "verse": 31,
              "name": "Exodo 14:31",
              "text": "At nakita ng Israel ang dakilang gawa, na ginawa ng Panginoon sa mga Egipcio, at ang bayan ay natakot sa Panginoon: at sila'y sumampalataya sa Panginoon at sa kaniyang lingkod na kay Moises."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "Exodo 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "Exodo 15:1",
              "text": "Nang magkagayo'y inawit ni Moises at ng mga anak ni Israel ang awit na ito sa Panginoon, at sinalita, na sinasabi, Ako'y aawit sa Panginoon, sapagka't siya'y nagtagumpay ng kaluwaluwalhati: Ang kabayo at ang sakay niyaon ay kaniyang ibinulusok sa dagat."
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "Exodo 15:2",
              "text": "Ang Panginoon ay aking lakas at awit, At siya'y naging aking kaligtasan: Ito'y aking Dios, at siya'y aking pupurihin. Dios ng aking ama, at siya'y aking tatanghalin."
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "Exodo 15:3",
              "text": "Ang Panginoo'y isang mangdidigma: Panginoon ang kaniyang pangalan."
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "Exodo 15:4",
              "text": "Ang mga karro ni Faraon at ang kaniyang hukbo ay ibinulusok niya sa dagat; At ang kaniyang mga piling kapitan ay ipinaglulubog sa Dagat na Mapula."
            },
            {
              "chapter": 15,
              "verse": 5,
              "name": "Exodo 15:5",
              "text": "Ang mga kalaliman ang tumatabon sa kanila: Sila'y lumubog sa mga kalaliman, na parang isang bato."
            },
            {
              "chapter": 15,
              "verse": 6,
              "name": "Exodo 15:6",
              "text": "Ang iyong kanan, Oh Panginoon, ay maluwalhati sa kapangyarihan. Ang iyong kanan, Oh Panginoon, ay dumudurog ng kaaway."
            },
            {
              "chapter": 15,
              "verse": 7,
              "name": "Exodo 15:7",
              "text": "At sa kalakhan ng iyong karilagan ay ibinubuwal mo yaong bumabangon laban sa iyo: Iyong ipinakikita ang iyong pagiinit, at nililipol silang parang dayami."
            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "Exodo 15:8",
              "text": "At sa hihip ng iyong ilong ay natitipon ang tubig, Ang mga agos ay nagsilagay na parang isang bunton; Ang mga kalaliman ay namuo sa gitna ng dagat."
            },
            {
              "chapter": 15,
              "verse": 9,
              "name": "Exodo 15:9",
              "text": "Sinabi ng kaaway, Aking hahabulin, aking aabutan, magbabahagi ako ng samsam, Ang aking nasa ay masisiyahan sa kanila; Aking bubunutin ang aking tabak, lilipulin sila ng aking kamay."
            },
            {
              "chapter": 15,
              "verse": 10,
              "name": "Exodo 15:10",
              "text": "Ikaw ay nagpahihip ng iyong hangin, at tinabunan sila ng dagat. Sila'y lumubog na parang tingga sa makapangyarihang tubig."
            },
            {
              "chapter": 15,
              "verse": 11,
              "name": "Exodo 15:11",
              "text": "Sinong gaya mo, Oh Panginoon, sa mga dios? Sinong gaya mo, maluwalhati sa kabanalan, Nakasisindak sa pagpuri, na gumagawa ng mga kababalaghan?"
            },
            {
              "chapter": 15,
              "verse": 12,
              "name": "Exodo 15:12",
              "text": "Iyong iniunat ang iyong kanang kamay, Nilamon sila ng lupa."
            },
            {
              "chapter": 15,
              "verse": 13,
              "name": "Exodo 15:13",
              "text": "Iyong pinapatnubayan sa iyong awa ang bayan na iyong tinubos: Sa iyong kalakasan ay iyong inihahatid sila sa banal mong tahanan."
            },
            {
              "chapter": 15,
              "verse": 14,
              "name": "Exodo 15:14",
              "text": "Narinig ng mga bayan; at sila'y nanginig: Mga sakit ang kumapit sa mga taga Filistia."
            },
            {
              "chapter": 15,
              "verse": 15,
              "name": "Exodo 15:15",
              "text": "Nang magkagayo'y natulig ang mga pangulo sa Edom; Sa matatapang sa Moab, ay panginginig ang sumasakanila: Lahat ng taga Canaan ay nauubos."
            },
            {
              "chapter": 15,
              "verse": 16,
              "name": "Exodo 15:16",
              "text": "Sindak at gulat ang suma-sakanila; Sa kadakilaan ng iyong bisig ay nagiging walang kibo sila na parang bato; Hanggang sa ang iyong bayan ay makaraan, Oh Panginoon, Hanggang sa makaraan ang bayang ito na iyong kinamtan."
            },
            {
              "chapter": 15,
              "verse": 17,
              "name": "Exodo 15:17",
              "text": "Sila'y iyong papapasukin, at sila'y iyong itatayo sa bundok na iyong pamana, Sa dako, Oh Panginoon, na iyong ginawa sa iyo, upang iyong tahanan, Sa santuario, Oh Panginoon, na itinatag ng iyong mga kamay."
            },
            {
              "chapter": 15,
              "verse": 18,
              "name": "Exodo 15:18",
              "text": "Ang Panginoon ay maghahari magpakailan man."
            },
            {
              "chapter": 15,
              "verse": 19,
              "name": "Exodo 15:19",
              "text": "Sapagka't ang mga kabayo ni Faraon, ay nagsipasok pati ng kaniyang mga karro at pati ng kaniyang mga nangangabayo sa dagat, at pinapanumbalik ng Panginoon ang tubig ng dagat sa kanila; datapuwa't lumakad ang mga anak ni Israel sa tuyong lupa sa gitna ng dagat."
            },
            {
              "chapter": 15,
              "verse": 20,
              "name": "Exodo 15:20",
              "text": "At si Miriam na propetisa na kapatid ni Aaron, ay tumangan ng isang pandereta sa kaniyang kamay; at sumunod ang lahat ng mga babae sa kaniya, na may mga pandereta at nagsayawan."
            },
            {
              "chapter": 15,
              "verse": 21,
              "name": "Exodo 15:21",
              "text": "At sila'y sinagot ni Miriam, Umawit kayo sa Panginoon, sapagka't siya'y nagtagumpay ng kaluwaluwalhati; Ang kabayo at ang sakay niyaon ay ibinulusok niya sa dagat."
            },
            {
              "chapter": 15,
              "verse": 22,
              "name": "Exodo 15:22",
              "text": "At pinatnubayan ni Moises ang Israel mula sa Dagat na Mapula, at sila'y lumabas sa ilang ng Shur; at sila'y lumakad na tatlong araw sa ilang, at hindi nakasumpong ng tubig."
            },
            {
              "chapter": 15,
              "verse": 23,
              "name": "Exodo 15:23",
              "text": "At nang sila'y dumating sa Mara, ay hindi sila makainom ng tubig sa Mara, sapagka't mapait: kaya't ang pangalang itinawag ay Mara."
            },
            {
              "chapter": 15,
              "verse": 24,
              "name": "Exodo 15:24",
              "text": "At inupasala ng bayan si Moises, na sinasabi, Anong aming iinumin?"
            },
            {
              "chapter": 15,
              "verse": 25,
              "name": "Exodo 15:25",
              "text": "At siya'y dumaing sa Panginoon; at pinapagkitaan siya ng Panginoon ng isang puno ng kahoy, at inihagis niya sa tubig, at ang tubig ay tumabang. Doon inatangan niya ng palatuntunan, at ng tagubilin at doon sila sinubok niya;"
            },
            {
              "chapter": 15,
              "verse": 26,
              "name": "Exodo 15:26",
              "text": "At sinabi, Kung iyong didinggin ng buong sikap ang tinig ng Panginoon mong Dios, at iyong gagawin ang matuwid sa kaniyang mga mata, at iyong didinggin ang kaniyang mga utos, at iyong gaganapin ang lahat niyang mga palatuntunan ay wala akong ilalagay na karamdaman sa iyo, na gaya ng inilagay ko sa mga Egipcio: sapagka't ako ang Panginoon na nagpapagaling sa iyo."
            },
            {
              "chapter": 15,
              "verse": 27,
              "name": "Exodo 15:27",
              "text": "At sila'y dumating sa Elim, na doo'y mayroong labingdalawang bukal ng tubig, at pitongpung puno ng palma; at sila'y humantong doon sa tabi ng mga tubig."
            }
          ]
        },
        {
          "chapter": 16,
          "name": "Exodo 16",
          "verses": [
            {
              "chapter": 16,
              "verse": 1,
              "name": "Exodo 16:1",
              "text": "At sila'y naglakbay mula sa Elim, at ang buong kapisanan ng mga anak ni Israel ay dumating sa ilang ng Sin, na nasa pagitan ng Elim at Sinai, nang ikalabing limang araw ng ikalawang buwan, pagkatapos na sila'y makaalis sa lupain ng Egipto."
            },
            {
              "chapter": 16,
              "verse": 2,
              "name": "Exodo 16:2",
              "text": "At inupasala ng buong kapisanan ng mga anak ni Israel si Moises at si Aaron sa ilang:"
            },
            {
              "chapter": 16,
              "verse": 3,
              "name": "Exodo 16:3",
              "text": "At sinabi sa kanila ng mga anak ni Israel, Namatay na sana kami sa pamamagitan ng kamay ng Panginoon sa lupain ng Egipto, nang kami ay nauupo sa tabi ng mga palyok ng karne, nang kami ay kumakain ng tinapay hanggang sa mabusog; sapagka't kami ay inyong dinala sa ilang na ito, upang patayin ng gutom ang buong kapisanang ito."
            },
            {
              "chapter": 16,
              "verse": 4,
              "name": "Exodo 16:4",
              "text": "Nang magkagayo'y sinabi ng Panginoon kay Moises, Narito, kayo'y aking pauulanan ng pagkain mula sa langit; at lalabasin at pupulutin ng bayan araw-araw ang bahagi sa bawa't araw; upang aking masubok sila, kung sila'y lalakad ng ayon sa aking kautusan, o hindi."
            },
            {
              "chapter": 16,
              "verse": 5,
              "name": "Exodo 16:5",
              "text": "At mangyayari sa ikaanim na araw, na sila'y maghahanda ng kanilang dala, na ibayo ng kanilang pinupulot sa araw-araw."
            },
            {
              "chapter": 16,
              "verse": 6,
              "name": "Exodo 16:6",
              "text": "At sinabi ni Moises at ni Aaron sa lahat ng mga anak ni Israel, Sa kinahapunan, ay inyong malalaman, na ang Panginoon ay siyang naglabas sa inyo sa lupain ng Egipto."
            },
            {
              "chapter": 16,
              "verse": 7,
              "name": "Exodo 16:7",
              "text": "At sa kinaumagahan, ay inyo ngang makikita ang kaluwalhatian ng Panginoon; sapagka't kaniyang naririnig ang inyong mga pagupasala laban sa Panginoon: at ano kami, na inyo kaming inuupasala?"
            },
            {
              "chapter": 16,
              "verse": 8,
              "name": "Exodo 16:8",
              "text": "At sinabi ni Moises, Ito'y mangyayari, pagbibigay ng Panginoon sa inyo sa kinahapunan ng karne na makakain, at sa kinaumagahan ng pagkain, na makabubusog; sapagka't naririnig ng Panginoon ang inyong mga pagupasala na inyong iniuupasala laban sa kaniya: at ano kami? ang inyong mga pagupasala ay hindi laban sa amin, kundi laban sa Panginoon."
            },
            {
              "chapter": 16,
              "verse": 9,
              "name": "Exodo 16:9",
              "text": "At sinabi ni Moises kay Aaron, Sabihin mo sa buong kapisanan ng mga anak ni Israel, Lumapit kayo sa harap ng Panginoon; sapagka't kaniyang narinig ang inyong mga pagupasala."
            },
            {
              "chapter": 16,
              "verse": 10,
              "name": "Exodo 16:10",
              "text": "At nangyari, pagkapagsalita ni Aaron sa buong kapisanan ng mga anak ni Israel, na sila'y tumingin sa dakong ilang, at, narito, ang kaluwalhatian ng Panginoon ay lumitaw sa ulap."
            },
            {
              "chapter": 16,
              "verse": 11,
              "name": "Exodo 16:11",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 16,
              "verse": 12,
              "name": "Exodo 16:12",
              "text": "Aking narinig ang mga pagupasala ng mga anak ni Israel: salitain mo sa kanila, na iyong sasabihin, Sa kinahapunan ay kakain kayo ng karne, at sa kinaumagahan, ay magpapakabusog kayo ng tinapay; at inyong makikilala na ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 16,
              "verse": 13,
              "name": "Exodo 16:13",
              "text": "At nangyari sa kinahapunan na ang mga pugo ay nagsiahon at tinakpan ang kampamento at sa kinaumagahan, ay nalalatag sa palibot ng kampamento ang hamog."
            },
            {
              "chapter": 16,
              "verse": 14,
              "name": "Exodo 16:14",
              "text": "At nang paitaas na ang hamog na nalalatag na, narito, sa balat ng ilang ay may munting bagay na mabilog at munti na gaya ng namuong hamog sa ibabaw ng lupa."
            },
            {
              "chapter": 16,
              "verse": 15,
              "name": "Exodo 16:15",
              "text": "At nang makita ng mga anak ni Israel, ay nagsangusapan, Ano ito? sapagka't hindi nila nalalaman kung ano yaon. At sinabi ni Moises sa kanila, Ito ang pagkain na ibinigay ng Panginoon sa inyo upang kanin."
            },
            {
              "chapter": 16,
              "verse": 16,
              "name": "Exodo 16:16",
              "text": "Ito ang bagay na iniutos ng Panginoon, Pumulot ang bawa't tao ayon sa kaniyang kain; isang omer sa bawa't ulo, ayon sa bilang ng inyong mga tao, ang kukunin ng bawa't tao para sa mga nasa kaniyang tolda."
            },
            {
              "chapter": 16,
              "verse": 17,
              "name": "Exodo 16:17",
              "text": "At gayon ginawa ng mga anak ni Israel, at may namulot ng marami, at may kaunti."
            },
            {
              "chapter": 16,
              "verse": 18,
              "name": "Exodo 16:18",
              "text": "At nang timbangin sa omer, ang namulot ng marami ay walang higit, at ang namulot ng kaunti ay hindi nagkulang; bawa't tao ay pumulot ng ayon sa kaniyang kain."
            },
            {
              "chapter": 16,
              "verse": 19,
              "name": "Exodo 16:19",
              "text": "At sinabi ni Moises sa kanila, Huwag magtira niyaon ang sinoman ng hanggang sa umaga."
            },
            {
              "chapter": 16,
              "verse": 20,
              "name": "Exodo 16:20",
              "text": "Gayon ma'y hindi sila nakinig kay Moises; kungdi ang iba sa kanila ay nagtira niyaon hanggang sa umaga, at inuod at bumaho; at naginit sa kanila si Moises."
            },
            {
              "chapter": 16,
              "verse": 21,
              "name": "Exodo 16:21",
              "text": "At sila'y namumulot tuwing umaga, bawa't tao ayon sa kaniyang kain: at pagka ang araw ay umiinit na, ay natutunaw."
            },
            {
              "chapter": 16,
              "verse": 22,
              "name": "Exodo 16:22",
              "text": "At nangyari, na nang ikaanim na araw, ay pumulot sila ng pagkain na ibayo ang dami, dalawang omer sa bawa't isa: at lahat ng puno sa kapisanan ay naparoon at nagsaysay kay Moises."
            },
            {
              "chapter": 16,
              "verse": 23,
              "name": "Exodo 16:23",
              "text": "At kaniyang sinabi sa kanila, Ito ang sinalita ng Panginoon, Bukas ay takdang kapahingahan, banal na sabbath sa Panginoon: ihawin ninyo ang inyong iihawin, at lutuin ninyo ang inyong lulutuin; at lahat na lalabis ay itago ninyo sa ganang inyo, na inyong itira hanggang sa kinabukasan."
            },
            {
              "chapter": 16,
              "verse": 24,
              "name": "Exodo 16:24",
              "text": "At kanilang itinago hanggang sa kinaumagahan, gaya ng iniutos ni Moises: at hindi bumaho, ni nagkaroon ng anomang uod."
            },
            {
              "chapter": 16,
              "verse": 25,
              "name": "Exodo 16:25",
              "text": "At sinabi ni Moises, Kanin ninyo yaon ngayon; sapagka't ngayo'y sabbath na ipinangingilin sa Panginoon: ngayo'y hindi kayo makakasumpong sa parang."
            },
            {
              "chapter": 16,
              "verse": 26,
              "name": "Exodo 16:26",
              "text": "Anim na araw na inyong pupulutin; datapuwa't sa ikapitong araw ay sabbath, hindi magkakaroon."
            },
            {
              "chapter": 16,
              "verse": 27,
              "name": "Exodo 16:27",
              "text": "At nangyari sa ikapitong araw, na lumabas ang iba sa bayan upang mamulot, at walang nasumpungan."
            },
            {
              "chapter": 16,
              "verse": 28,
              "name": "Exodo 16:28",
              "text": "At sinabi ng Panginoon kay Moises, Hanggang kailan tatanggihan ninyo ganapin ang aking mga utos at ang aking mga kautusan?"
            },
            {
              "chapter": 16,
              "verse": 29,
              "name": "Exodo 16:29",
              "text": "Tingnan ninyo, na sapagka't ibinigay ng Panginoon sa inyo ang sabbath, kung kaya't kaniyang ibinibigay sa inyo sa ikaanim na araw ang pagkain ng sa dalawang araw; matira ang bawa't tao sa kaniyang kinaroroonan, huwag umalis ang sinoman sa kaniyang kinaroroonan, sa ikapitong araw."
            },
            {
              "chapter": 16,
              "verse": 30,
              "name": "Exodo 16:30",
              "text": "Kaya ang bayan ay nagpahinga sa ikapitong araw."
            },
            {
              "chapter": 16,
              "verse": 31,
              "name": "Exodo 16:31",
              "text": "At yao'y pinanganlan ng sangbahayan ng Israel na Mana: at kaparis ng buto ng kulantro, maputi; at ang lasa niyaon ay kasinglasa ng manipis na tinapay na may pulot."
            },
            {
              "chapter": 16,
              "verse": 32,
              "name": "Exodo 16:32",
              "text": "At sinabi ni Moises, Ito ang bagay na iniutos ng Panginoon, Punuin ninyo ang isang omer ng mana, na inyong ingatan sa buong panahon ng inyong mga lahi; upang kanilang makita ang pagkain, na aking ipinakain sa inyo sa ilang nang kayo'y aking ilabas sa lupain ng Egipto."
            },
            {
              "chapter": 16,
              "verse": 33,
              "name": "Exodo 16:33",
              "text": "At sinabi ni Moises kay Aaron, Kumuha ka ng isang palyok at sidlan mo ng isang omer na puno ng mana, at ilagay mo sa harap ng Panginoon, upang maingatan sa buong panahon ng inyong mga lahi."
            },
            {
              "chapter": 16,
              "verse": 34,
              "name": "Exodo 16:34",
              "text": "Kung paanong iniutos ng Panginoon kay Moises, ay gayon inilagay ni Aaron sa harap ng Patotoo upang ingatan."
            },
            {
              "chapter": 16,
              "verse": 35,
              "name": "Exodo 16:35",
              "text": "At ang mga anak ni Israel ay kumain ng mana na apat na pung taon, hanggang sa sila'y dumating sa lupaing tinatahanan; sila'y kumain ng mana hanggang sa sila'y dumating sa mga hangganan ng lupain ng Canaan."
            },
            {
              "chapter": 16,
              "verse": 36,
              "name": "Exodo 16:36",
              "text": "Ang isang omer nga ay ikasangpung bahagi ng isang efa."
            }
          ]
        },
        {
          "chapter": 17,
          "name": "Exodo 17",
          "verses": [
            {
              "chapter": 17,
              "verse": 1,
              "name": "Exodo 17:1",
              "text": "At ang buong kapisanan ng mga anak ni Israel ay naglakbay mula sa ilang ng Sin, sa kanilang paglalakbay ayon sa utos ng Panginoon, at humantong sa Rephidim: at walang tubig na mainom ang bayan."
            },
            {
              "chapter": 17,
              "verse": 2,
              "name": "Exodo 17:2",
              "text": "Kaya't ang bayan ay nakipagtalo kay Moises, at nagsabi, Bigyan mo kami ng tubig na aming mainom. At sinabi ni Moises sa kanila, Bakit kayo nakikipagtalo sa akin? bakit ninyo tinutukso ang Panginoon?"
            },
            {
              "chapter": 17,
              "verse": 3,
              "name": "Exodo 17:3",
              "text": "At ang bayan ay nauhaw at inupasala ng bayan si Moises, at sinabi, Bakit mo kami isinampa rito mula sa Egipto, upang patayin mo kami sa uhaw, at ang aming mga anak, at ang aming kawan?"
            },
            {
              "chapter": 17,
              "verse": 4,
              "name": "Exodo 17:4",
              "text": "At si Moises ay dumaing sa Panginoon, na nagsasabi, Anong aking gagawin sa bayang ito? kulang na lamang batuhin nila ako."
            },
            {
              "chapter": 17,
              "verse": 5,
              "name": "Exodo 17:5",
              "text": "At sinabi ng Panginoon kay Moises, Dumaan ka sa harap ng bayan, at ipagsama mo ang mga matanda sa Israel; at ang iyong tungkod na iyong ipinalo sa ilog, ay tangnan mo sa iyong kamay, at yumaon ka."
            },
            {
              "chapter": 17,
              "verse": 6,
              "name": "Exodo 17:6",
              "text": "Narito, ako'y tatayo sa harap mo roon sa ibabaw ng bato sa Horeb; at iyong papaluin ang bato, at lalabasan ng tubig, upang ang bayan ay makainom. At gayon ginawa ni Moises sa paningin ng mga matanda sa Israel."
            },
            {
              "chapter": 17,
              "verse": 7,
              "name": "Exodo 17:7",
              "text": "At tinawag nila ang pangalan ng dakong yaon, na Massah at Meribah, dahil sa pakikipagtalo ng mga anak ni Israel, at dahil sa kanilang tinukso ang Panginoon, na kanilang sinasabi, Ang Panginoon ba'y nasa gitna natin o wala?"
            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "Exodo 17:8",
              "text": "Nang magkagayo'y dumating si Amalec, at nakipaglaban sa Israel sa Rephidim."
            },
            {
              "chapter": 17,
              "verse": 9,
              "name": "Exodo 17:9",
              "text": "At sinabi ni Moises kay Josue, Ipili mo tayo ng mga lalake, at ikaw ay lumabas, lumaban ka kay Amalec; bukas ay tatayo ako sa taluktok ng burol, na aking tangan ang tungkod ng Dios sa aking kamay."
            },
            {
              "chapter": 17,
              "verse": 10,
              "name": "Exodo 17:10",
              "text": "Gayon ginawa ni Josue, gaya ng sinabi ni Moises sa kaniya, at lumaban kay Amalec: at si Moises, si Aaron at si Hur ay sumampa sa taluktok ng burol."
            },
            {
              "chapter": 17,
              "verse": 11,
              "name": "Exodo 17:11",
              "text": "At nangyari, pagka itinataas ni Moises ang kaniyang kamay, ay nananaig ang Israel: at pagka kaniyang ibinababa ang kaniyang kamay, ay nananaig si Amalec."
            },
            {
              "chapter": 17,
              "verse": 12,
              "name": "Exodo 17:12",
              "text": "Datapuwa't ang mga kamay ni Moises ay nangalay; at sila'y kumuha ng isang bato, at inilagay sa ibaba, at kaniyang inupuan; at inalalayan ni Aaron at ni Hur ang kaniyang mga kamay, ang isa'y sa isang dako, at ang isa'y sa kabilang dako; at ang kaniyang mga kamay ay nalagi sa itaas hanggang sa paglubog ng araw."
            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "Exodo 17:13",
              "text": "At nilito ni Josue si Amalec, at ang kaniyang bayan, sa pamamagitan ng talim ng tabak."
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "Exodo 17:14",
              "text": "At sinabi ng Panginoon kay Moises, Isulat mo ito na pinakaalaala sa isang aklat, at ipagbigay alam mo kay Josue na aking ipalilimot ang pagalaala kay Amalec sa silong ng langit."
            },
            {
              "chapter": 17,
              "verse": 15,
              "name": "Exodo 17:15",
              "text": "At nagtayo si Moises ng isang dambana, at pinanganlang Jehovanissi."
            },
            {
              "chapter": 17,
              "verse": 16,
              "name": "Exodo 17:16",
              "text": "At kaniyang sinabi, Isinumpa ng Panginoon: ang Panginoon ay makikipagdigma kay Amalec sa buong panahon ng lahi nito."
            }
          ]
        },
        {
          "chapter": 18,
          "name": "Exodo 18",
          "verses": [
            {
              "chapter": 18,
              "verse": 1,
              "name": "Exodo 18:1",
              "text": "Si Jethro nga, saserdote sa Madian, biyanan ni Moises, ay nakabalita ng lahat na ginawa ng Dios kay Moises, at sa Israel na kaniyang bayan, kung paanong inilabas ng Panginoon ang Israel sa Egipto."
            },
            {
              "chapter": 18,
              "verse": 2,
              "name": "Exodo 18:2",
              "text": "At ipinagsama ni Jethro, na biyanan ni Moises, si Sephora na asawa ni Moises, pagkatapos na kaniyang maipadala sa kanilang ama,"
            },
            {
              "chapter": 18,
              "verse": 3,
              "name": "Exodo 18:3",
              "text": "At ang dalawa niyang anak na lalake: na ang pangalan ng isa'y Gersom; sapagka't sinabi ni Moises, Ako'y nakipamayan sa ibang bayan."
            },
            {
              "chapter": 18,
              "verse": 4,
              "name": "Exodo 18:4",
              "text": "At ang pangalan ng isa'y Elieser; sapagka't kaniyang sinabi, Ang Dios ng aking ama'y naging aking saklolo, at ako'y iniligtas sa tabak ni Faraon;"
            },
            {
              "chapter": 18,
              "verse": 5,
              "name": "Exodo 18:5",
              "text": "At si Jethro, na biyanan ni Moises, ay dumating, na kasama ang kaniyang mga anak at ang kaniyang asawa, kay Moises sa ilang na kaniyang hinantungan sa tabi ng bundok ng Dios:"
            },
            {
              "chapter": 18,
              "verse": 6,
              "name": "Exodo 18:6",
              "text": "At kaniyang ipinasabi kay Moises, Akong iyong biyanang si Jethro ay naparito sa iyo, at ang iyong asawa, at ang kaniyang dalawang anak na kasama niya."
            },
            {
              "chapter": 18,
              "verse": 7,
              "name": "Exodo 18:7",
              "text": "At si Moises ay lumabas na sinalubong ang kaniyang biyanan, at kaniyang niyukuran at hinalikan. At sila'y nagtanungang isa't isa ng kanilang kalagayan; at sila'y pumasok sa tolda."
            },
            {
              "chapter": 18,
              "verse": 8,
              "name": "Exodo 18:8",
              "text": "At isinaysay ni Moises sa kaniyang biyanan ang lahat ng ginawa ng Panginoon kay Faraon at sa mga Egipcio dahil sa Israel, ang buong hirap na kanilang naranasan sa daan, at kung paanong iniligtas ng Panginoon sila."
            },
            {
              "chapter": 18,
              "verse": 9,
              "name": "Exodo 18:9",
              "text": "At ikinagalak ni Jethro ang buong kabutihang ginawa ng Panginoon sa Israel, na iniligtas sila sa kamay ng mga Egipcio."
            },
            {
              "chapter": 18,
              "verse": 10,
              "name": "Exodo 18:10",
              "text": "At sinabi ni Jethro, Purihin ang Panginoon, na nagligtas sa inyo, sa kamay ng mga Egipcio, at sa kamay ni Faraon; na siyang nagligtas sa bayan sa kamay ng mga Egipcio."
            },
            {
              "chapter": 18,
              "verse": 11,
              "name": "Exodo 18:11",
              "text": "Ngayo'y aking natatalastas na ang Panginoon ay lalong dakila kay sa lahat ng mga dios: oo, sa bagay na ipinagpalalo ng mga Egipcio laban sa mga Hebreo."
            },
            {
              "chapter": 18,
              "verse": 12,
              "name": "Exodo 18:12",
              "text": "At si Jethro, na biyanan ni Moises, ay kumuha ng handog na susunugin at mga hain para sa Dios: at si Aaron ay naparoon, at ang lahat ng mga matanda sa Israel, upang kumain ng tinapay na kasalo ng biyanan ni Moises sa harap ng Dios."
            },
            {
              "chapter": 18,
              "verse": 13,
              "name": "Exodo 18:13",
              "text": "At nangyari kinabukasan, na lumuklok si Moises upang hatulan ang bayan: at ang bayan ay tumayo sa palibot ni Moises mula sa umaga hanggang sa hapon."
            },
            {
              "chapter": 18,
              "verse": 14,
              "name": "Exodo 18:14",
              "text": "At nang makita ng biyanan ni Moises ang lahat ng kaniyang ginagawa sa bayan, ay nagsabi, Anong bagay itong ginagawa mo sa bayan? bakit nauupo kang magisa, at ang buong bayan ay nakatayo sa palibot mo mula sa umaga hanggang sa hapon?"
            },
            {
              "chapter": 18,
              "verse": 15,
              "name": "Exodo 18:15",
              "text": "At sinabi ni Moises sa kaniyang biyanan, Sapagka't ang bayan ay lumalapit sa akin, upang sumangguni sa Dios."
            },
            {
              "chapter": 18,
              "verse": 16,
              "name": "Exodo 18:16",
              "text": "Pagka sila'y may usap ay lumapit sa akin; at aking hinahatulang isa't isa, at aking ipinakikilala sa kanila ang mga palatuntunan ng Dios, at ang kaniyang mga kautusan."
            },
            {
              "chapter": 18,
              "verse": 17,
              "name": "Exodo 18:17",
              "text": "At sinabi ng biyanan ni Moises sa kaniya, Ang bagay na iyong ginagawa ay hindi mabuti."
            },
            {
              "chapter": 18,
              "verse": 18,
              "name": "Exodo 18:18",
              "text": "Tunay na ikaw ay manghihina, ikaw at ang bayang ito, na nasa iyo: sapagka't ang bagay ay totoong mabigat sa iyo; hindi mo makakayang magisa."
            },
            {
              "chapter": 18,
              "verse": 19,
              "name": "Exodo 18:19",
              "text": "Dinggin mo ngayon ang aking tinig; papayuhan kita, at sumaiyo nawa ang Dios: ikaw ang maging tagapagakay sa bayan sa harap ng Dios, at dalhin mo ang mga usap sa Dios:"
            },
            {
              "chapter": 18,
              "verse": 20,
              "name": "Exodo 18:20",
              "text": "At ituturo mo sa kanila ang mga palatuntunan, at ang mga kautusan, at ipakikilala mo sa kanila ang daang nararapat lakaran, at ang gawang kanilang nararapat gawin."
            },
            {
              "chapter": 18,
              "verse": 21,
              "name": "Exodo 18:21",
              "text": "Bukod dito'y hahanap ka sa buong bayan ng mga taong bihasa, gaya ng matatakutin sa Dios, na mga taong mapagpatotoo, na mga napopoot sa kasakiman; at siyang mga ilagay mo sa kanila, na magpuno sa mga lilibuhin, magpuno sa mga dadaanin, magpuno sa mga lilimangpuin, at magpuno sa mga sasangpuin:"
            },
            {
              "chapter": 18,
              "verse": 22,
              "name": "Exodo 18:22",
              "text": "At pahatulan mo sa kanila ang bayan sa buong panahon: at mangyayari, na bawa't malaking usap ay dadalhin nila sa iyo, datapuwa't bawa't munting usap, ay silasila ang maghahatulan: sa ganyan ay magiging magaan sa iyo, at magpapasan silang katulong mo."
            },
            {
              "chapter": 18,
              "verse": 23,
              "name": "Exodo 18:23",
              "text": "Kung gagawin mo ang bagay na ito, at iuutos sa iyong ganyan ng Dios ay iyo ngang mababata, at ang buong bayan namang ito ay uuwing payapa."
            },
            {
              "chapter": 18,
              "verse": 24,
              "name": "Exodo 18:24",
              "text": "Sa gayon, ay dininig ni Moises ang kaniyang biyanan, at ginawang lahat yaong sinabi."
            },
            {
              "chapter": 18,
              "verse": 25,
              "name": "Exodo 18:25",
              "text": "At pumili si Moises ng mga lalaking bihasa sa buong Israel, at ginawa niyang pangulo sa bayan, na mga puno ng lilibuhin, mga puno ng dadaanin, mga puno ng lilimangpuin, at mga puno ng sasangpuin."
            },
            {
              "chapter": 18,
              "verse": 26,
              "name": "Exodo 18:26",
              "text": "At kanilang hinatulan ang bayan sa buong panahon: ang mabibigat na usap ay kanilang dinadala kay Moises, datapuwa't bawa't munting usap ay silasila ang naghahatulan."
            },
            {
              "chapter": 18,
              "verse": 27,
              "name": "Exodo 18:27",
              "text": "At tinulutan ni Moises ang kaniyang biyanan na magpaalam at siya'y umuwi sa sariling lupain."
            }
          ]
        },
        {
          "chapter": 19,
          "name": "Exodo 19",
          "verses": [
            {
              "chapter": 19,
              "verse": 1,
              "name": "Exodo 19:1",
              "text": "Sa ikatlong buwan, pagkatapos na ang mga anak ni Israel ay makaalis sa lupain ng Egipto, ay dumating sila ng araw ding yaon sa ilang ng Sinai."
            },
            {
              "chapter": 19,
              "verse": 2,
              "name": "Exodo 19:2",
              "text": "At nang sila'y umalis sa Rephidim, at dumating sa ilang ng Sinai, ay humantong sila sa ilang; at doo'y humantong ang Israel sa harap ng bundok."
            },
            {
              "chapter": 19,
              "verse": 3,
              "name": "Exodo 19:3",
              "text": "At si Moises ay lumapit sa Dios, at tinawag ng Panginoon siya mula sa bundok, na sinasabi, Ganito mo sasabihin sa sangbahayan ni Jacob, at sasaysayin sa mga anak ni Israel."
            },
            {
              "chapter": 19,
              "verse": 4,
              "name": "Exodo 19:4",
              "text": "Inyong nakita ang aking ginawa sa mga Egipcio, at kung paanong dinala ko kayo sa mga pakpak ng agila, at kayo'y inilapit ko sa akin din."
            },
            {
              "chapter": 19,
              "verse": 5,
              "name": "Exodo 19:5",
              "text": "Kaya't ngayon, kung tunay na inyong susundin ang aking tinig, at iingatan ang aking tipan, ay magiging isang tanging kayamanan nga kayo sa akin, na higit sa lahat ng bayan: sapagka't ang buong lupa ay akin;"
            },
            {
              "chapter": 19,
              "verse": 6,
              "name": "Exodo 19:6",
              "text": "At kayo'y magiging isang kaharian ng mga saserdote sa akin, at isang banal na bansa. Ito ang mga salita na inyong sasalitaan sa mga anak ni Israel."
            },
            {
              "chapter": 19,
              "verse": 7,
              "name": "Exodo 19:7",
              "text": "At dumating si Moises at tinawag ang mga matanda sa bayan, at ipinahayag sa harap nila ang lahat ng salitang ito na iniutos ng Panginoon sa kaniya."
            },
            {
              "chapter": 19,
              "verse": 8,
              "name": "Exodo 19:8",
              "text": "At ang buong bayan ay sumagot na magkakaisa, at nagsabi, Yaong lahat na sinalita ng Panginoon ay aming gagawin. At ipinagbigay alam ni Moises ang mga salita ng bayan sa Panginoon."
            },
            {
              "chapter": 19,
              "verse": 9,
              "name": "Exodo 19:9",
              "text": "At sinabi ng Panginoon kay Moises, Narito ako'y naparirito sa iyo sa isang salimuot na ulap upang marinig ng bayan pagka ako'y magsasalita sa iyo, at paniwalaan ka rin naman nila magpakailan man. At sinalita ni Moises ang mga salita ng bayan sa Panginoon."
            },
            {
              "chapter": 19,
              "verse": 10,
              "name": "Exodo 19:10",
              "text": "At sinabi ng Panginoon kay Moises, Pumaroon ka sa bayan at papagbanalin mo sila ngayon at bukas at labhan nila ang kanilang mga damit,"
            },
            {
              "chapter": 19,
              "verse": 11,
              "name": "Exodo 19:11",
              "text": "At humanda sa ikatlong araw: sapagka't sa ikatlong araw ay bababa ang Panginoon sa paningin ng buong bayan sa ibabaw ng bundok ng Sinai."
            },
            {
              "chapter": 19,
              "verse": 12,
              "name": "Exodo 19:12",
              "text": "At lalagyan mo ng mga hangganan ang bayan sa palibot, na iyong sasabihin, Magingat kayo, na kayo'y huwag sumampa sa bundok, o sumalang sa hangganan: sinomang sumalang sa bundok ay papatayin na walang pagsala:"
            },
            {
              "chapter": 19,
              "verse": 13,
              "name": "Exodo 19:13",
              "text": "Walang kamay na hihipo sa kaniya, kundi, siya'y tunay na babatuhin, o papanain; maging hayop o tao ay hindi mabubuhay: pagka ang pakakak ay tumunog ng maluwat ay sasampa sila sa bundok."
            },
            {
              "chapter": 19,
              "verse": 14,
              "name": "Exodo 19:14",
              "text": "At bumaba si Moises sa bayan mula sa bundok, at pinakabanal ang bayan, at sila'y naglaba ng kanilang mga damit."
            },
            {
              "chapter": 19,
              "verse": 15,
              "name": "Exodo 19:15",
              "text": "At kaniyang sinabi sa bayan, humanda kayo sa ikatlong araw; huwag kayong sumiping sa babae."
            },
            {
              "chapter": 19,
              "verse": 16,
              "name": "Exodo 19:16",
              "text": "At nangyari ng ikatlong araw, ng umaga, na kumulog at kumidlat, at may isang salimuot na ulap sa ibabaw ng bundok, at ang tunog ng pakakak ay napakalakas; at ang buong bayan na nasa kampamento ay nanginig."
            },
            {
              "chapter": 19,
              "verse": 17,
              "name": "Exodo 19:17",
              "text": "At inilabas ni Moises ang bayan sa kampamento upang salubungin ang Dios; at sila'y tumayo sa paanan ng bundok."
            },
            {
              "chapter": 19,
              "verse": 18,
              "name": "Exodo 19:18",
              "text": "At ang buong bundok ng Sinai ay umuusok, sapagka't ang Panginoon ay bumaba sa ibabaw niyaon na nasa apoy: at ang usok niyaon ay napaiilanglang na parang usok ng isang hurno, at ang buong bundok ay umuugang mainam."
            },
            {
              "chapter": 19,
              "verse": 19,
              "name": "Exodo 19:19",
              "text": "At nang lumalakas ng lumalakas ang tunog ng pakakak ay nagsasalita si Moises, at sinasagot siya ng Dios sa pamamagitan ng tinig."
            },
            {
              "chapter": 19,
              "verse": 20,
              "name": "Exodo 19:20",
              "text": "At ang Panginoon ay bumaba sa ibabaw ng bundok ng Sinai, sa taluktok ng bundok; at tinawag ng Panginoon si Moises sa taluktok ng bundok; at si Moises ay sumampa."
            },
            {
              "chapter": 19,
              "verse": 21,
              "name": "Exodo 19:21",
              "text": "At sinabi ng Panginoon kay Moises, Bumaba ka, pagbilinan mo ang bayan, baka sila'y lumagpas upang makita ang Panginoon, at mamatay ang karamihan sa kanila."
            },
            {
              "chapter": 19,
              "verse": 22,
              "name": "Exodo 19:22",
              "text": "At gayon din ang mga saserdote, na lumalapit sa Panginoon ay papagbanalin mo, baka ang Panginoon ay hindi makapagpigil sa kanila."
            },
            {
              "chapter": 19,
              "verse": 23,
              "name": "Exodo 19:23",
              "text": "At sinabi ni Moises sa Panginoon, Ang baya'y hindi makasasampa sa bundok ng Sinai: sapagka't iyong pinagbilinan kami, na iyong sinabi, lagyan mo ng hangganan sa palibot ang bundok, at iyong ariing banal."
            },
            {
              "chapter": 19,
              "verse": 24,
              "name": "Exodo 19:24",
              "text": "At sinabi ng Panginoon sa kaniya, Yumaon ka, bumaba ka; at ikaw ay sasampa, ikaw at si Aaron na iyong kasama: nguni't ang mga saserdote at ang bayan ay huwag lumampas sa mga hangganan upang lumapit sa Panginoon, baka siya ay hindi makapagpigil sa kanila."
            },
            {
              "chapter": 19,
              "verse": 25,
              "name": "Exodo 19:25",
              "text": "Sa gayo'y bumaba si Moises sa bayan at isinaysay sa kanila."
            }
          ]
        },
        {
          "chapter": 20,
          "name": "Exodo 20",
          "verses": [
            {
              "chapter": 20,
              "verse": 1,
              "name": "Exodo 20:1",
              "text": "At sinalita ng Dios ang lahat ng salitang ito, na sinasabi,"
            },
            {
              "chapter": 20,
              "verse": 2,
              "name": "Exodo 20:2",
              "text": "Ako ang Panginoon mong Dios, na naglabas sa iyo sa lupain ng Egipto, sa bahay ng pagkaalipin."
            },
            {
              "chapter": 20,
              "verse": 3,
              "name": "Exodo 20:3",
              "text": "Huwag kang magkakaroon ng ibang mga dios sa harap ko."
            },
            {
              "chapter": 20,
              "verse": 4,
              "name": "Exodo 20:4",
              "text": "Huwag kang gagawa para sa iyo ng larawang inanyuan o ng kawangis man ng anomang anyong nasa itaas sa langit, o ng nasa ibaba sa lupa, o ng nasa tubig sa ilalim ng lupa:"
            },
            {
              "chapter": 20,
              "verse": 5,
              "name": "Exodo 20:5",
              "text": "Huwag mong yuyukuran sila, o paglingkuran man sila; sapagka't akong Panginoon mong Dios, ay Dios na mapanibughuin, na aking dinadalaw ang katampalasanan ng mga magulang sa mga anak, hanggang sa ikatlo at ikaapat na salin ng lahi ng mga napopoot sa akin;"
            },
            {
              "chapter": 20,
              "verse": 6,
              "name": "Exodo 20:6",
              "text": "At pinagpapakitaan ko ng kaawaan ang libolibong umiibig sa akin at tumutupad ng aking mga utos."
            },
            {
              "chapter": 20,
              "verse": 7,
              "name": "Exodo 20:7",
              "text": "Huwag mong babanggitin ang pangalan ng Panginoon mong Dios sa walang kabuluhan; sapagka't hindi aariin ng Panginoong walang sala ang bumanggit ng kaniyang pangalan sa walang kabuluhan."
            },
            {
              "chapter": 20,
              "verse": 8,
              "name": "Exodo 20:8",
              "text": "Alalahanin mo ang araw ng sabbath upang ipangilin."
            },
            {
              "chapter": 20,
              "verse": 9,
              "name": "Exodo 20:9",
              "text": "Anim na araw na gagawa ka at iyong gagawin ang lahat ng iyong gawain."
            },
            {
              "chapter": 20,
              "verse": 10,
              "name": "Exodo 20:10",
              "text": "Nguni't ang ikapitong araw ay sabbath sa Panginoon mong Dios: sa araw na iyan ay huwag kang gagawa ng anomang gawa, ikaw, ni ang iyong anak na lalake ni babae, ni ang iyong aliping lalake ni babae, ni ang iyong baka, ni ang iyong tagaibang lupa na nasa loob ng iyong mga pintuang daan:"
            },
            {
              "chapter": 20,
              "verse": 11,
              "name": "Exodo 20:11",
              "text": "Sapagka't sa anim na araw ay ginawa ng Panginoon ang langit at lupa, ang dagat, at lahat ng nangaroon, at nagpahinga sa ikapitong araw; na ano pa't pinagpala ng Panginoon ang araw ng sabbath, at pinakabanal."
            },
            {
              "chapter": 20,
              "verse": 12,
              "name": "Exodo 20:12",
              "text": "Igalang mo ang iyong ama at ang iyong ina: upang ang iyong mga araw ay tumagal sa ibabaw ng lupa na ibinibigay sa iyo ng Panginoon mong Dios."
            },
            {
              "chapter": 20,
              "verse": 13,
              "name": "Exodo 20:13",
              "text": "Huwag kang papatay."
            },
            {
              "chapter": 20,
              "verse": 14,
              "name": "Exodo 20:14",
              "text": "Huwag kang mangangalunya."
            },
            {
              "chapter": 20,
              "verse": 15,
              "name": "Exodo 20:15",
              "text": "Huwag kang magnanakaw."
            },
            {
              "chapter": 20,
              "verse": 16,
              "name": "Exodo 20:16",
              "text": "Huwag kang magbibintang sa iyong kapuwa."
            },
            {
              "chapter": 20,
              "verse": 17,
              "name": "Exodo 20:17",
              "text": "Huwag mong iimbutin ang bahay ng iyong kapuwa, huwag mong iimbutin ang asawa ng iyong kapuwa, ni ang kaniyang aliping lalake o babae, ni ang kaniyang baka, ni ang kaniyang asno, ni anomang bagay ng iyong kapuwa."
            },
            {
              "chapter": 20,
              "verse": 18,
              "name": "Exodo 20:18",
              "text": "At nakikita ng buong bayan ang mga kulog, at ang mga kidlat, at ang tunog ng pakakak at ang bundok na umuusok: at nang makita ng bayan, ay nanginig sila, at tumayo sa malayo."
            },
            {
              "chapter": 20,
              "verse": 19,
              "name": "Exodo 20:19",
              "text": "At sinabi nila kay Moises, Magsalita ka sa amin, at aming didinggin: datapuwa't huwag magsalita ang Dios sa amin, baka kami ay mamatay."
            },
            {
              "chapter": 20,
              "verse": 20,
              "name": "Exodo 20:20",
              "text": "At sinabi ni Moises sa bayan, Huwag kayong matakot: sapagka't ang Dios ay naparito upang subukin kayo, at upang ang takot sa kaniya ay sumainyo, upang huwag kayong magkasala."
            },
            {
              "chapter": 20,
              "verse": 21,
              "name": "Exodo 20:21",
              "text": "At ang bayan ay tumayo sa malayo, at si Moises ay lumapit sa salimuot na kadiliman na kinaroroonan ng Dios."
            },
            {
              "chapter": 20,
              "verse": 22,
              "name": "Exodo 20:22",
              "text": "At sinabi ng Panginoon kay Moises, Ganito mo sasabihin sa mga anak ni Israel: Kayo ang nakakita na ako'y nakipagusap sa inyo mula sa langit."
            },
            {
              "chapter": 20,
              "verse": 23,
              "name": "Exodo 20:23",
              "text": "Huwag kayong gagawa ng ibang mga dios na iaagapay sa akin; ng mga dios na pilak, o ng mga dios na ginto, huwag kayong gagawa para sa inyo."
            },
            {
              "chapter": 20,
              "verse": 24,
              "name": "Exodo 20:24",
              "text": "Isang dambanang lupa ang inyong gagawin sa akin, at inyong ihahain doon ang inyong mga handog na susunugin, at ang inyong mga handog tungkol sa kapayapaan, ang inyong mga tupa, at ang inyong mga baka sa lahat ng dakong aking ipaaalaala ang aking pangalan, ay paparoonan kita at pagpapalain kita."
            },
            {
              "chapter": 20,
              "verse": 25,
              "name": "Exodo 20:25",
              "text": "At kung igagawa mo ako ng isang dambanang bato, ay huwag mong itatayong may tapyas: sapagka't kung iyong gamitin ang iyong patalim doon, ay iyong nilapastangan yaon."
            },
            {
              "chapter": 20,
              "verse": 26,
              "name": "Exodo 20:26",
              "text": "Ni huwag kang sasampa sa aking dambana sa pamamagitan ng mga baytang, upang ang inyong kahubaran ay huwag malitaw sa ibabaw niyaon."
            }
          ]
        },
        {
          "chapter": 21,
          "name": "Exodo 21",
          "verses": [
            {
              "chapter": 21,
              "verse": 1,
              "name": "Exodo 21:1",
              "text": "Ito nga ang mga hatol na igagawad mo sa harap nila."
            },
            {
              "chapter": 21,
              "verse": 2,
              "name": "Exodo 21:2",
              "text": "Kung ikaw ay bumili ng isang aliping Hebreo, ay anim na taong maglilingkod siya; at sa ikapito ay aalis siyang laya na walang sauling bayad."
            },
            {
              "chapter": 21,
              "verse": 3,
              "name": "Exodo 21:3",
              "text": "Kung siya'y pumasok na magisa, ay aalis na mag-isa: kung may asawa ay aalis nga ang kaniyang asawa na kasama niya."
            },
            {
              "chapter": 21,
              "verse": 4,
              "name": "Exodo 21:4",
              "text": "Kung siya'y bigyan ng kaniyang panginoon ng asawa, at magkaanak sa kaniya ng mga lalake, o mga babae; ang asawa at ang kaniyang mga anak ay magiging sa kaniyang panginoon, at siya'y aalis na magisa."
            },
            {
              "chapter": 21,
              "verse": 5,
              "name": "Exodo 21:5",
              "text": "Datapuwa't kung maliwanag na sabihin ng alipin, Aking iniibig ang aking panginoon, ang aking asawa, at ang aking mga anak; ako'y hindi aalis na laya:"
            },
            {
              "chapter": 21,
              "verse": 6,
              "name": "Exodo 21:6",
              "text": "Kung magkagayo'y dadalhin siya ng kaniyang panginoon sa Dios, at dadalhin siya sa pinto, o sa haligi ng pinto; at bubutasan ng kaniyang panginoon ang kaniyang tainga ng isang pangbutas; at paglilingkuran niya siya magpakailan man."
            },
            {
              "chapter": 21,
              "verse": 7,
              "name": "Exodo 21:7",
              "text": "At kung ipagbili ng isang lalake ang kaniyang anak na babae na maging alipin, ay hindi siya aalis na gaya ng pagalis ng mga aliping lalake."
            },
            {
              "chapter": 21,
              "verse": 8,
              "name": "Exodo 21:8",
              "text": "Kung siya'y hindi makapagpalugod sa kaniyang panginoon, na umayaw magasawa sa kaniya, ay ipatutubos nga niya siya: walang kapangyarihang ipagbili siya sa isang taga ibang lupa, yamang siya'y nadaya."
            },
            {
              "chapter": 21,
              "verse": 9,
              "name": "Exodo 21:9",
              "text": "At kung pinapag-asawa ng bumili sa kaniyang anak na lalake, ay kaniyang ipalalagay siya ng ayon sa kaugalian sa mga anak na babae."
            },
            {
              "chapter": 21,
              "verse": 10,
              "name": "Exodo 21:10",
              "text": "Kung siya'y magasawa sa iba, ang kaniyang pagkain, ang kaniyang damit at ang kaniyang kapangyarihang pagkaasawa ay hindi niya babawasan."
            },
            {
              "chapter": 21,
              "verse": 11,
              "name": "Exodo 21:11",
              "text": "At kung hindi niya gawin ang tatlong bagay na ito sa kaniya ay aalis nga siya na walang bayad, na walang tubos na salapi."
            },
            {
              "chapter": 21,
              "verse": 12,
              "name": "Exodo 21:12",
              "text": "Ang sumakit sa isang tao, na ano pa't mamatay ay papataying walang pagsala."
            },
            {
              "chapter": 21,
              "verse": 13,
              "name": "Exodo 21:13",
              "text": "At kung hindi sinasadya ng isang tao, kundi Dios ang naghulog sa kaniyang kamay; ay lalaanan kita ng isang dako na kaniyang tatakasan."
            },
            {
              "chapter": 21,
              "verse": 14,
              "name": "Exodo 21:14",
              "text": "At kung magtangka ang sinoman sa kaniyang kapuwa, na pumatay na may daya, ay alisin mo siya sa aking dambana, upang patayin."
            },
            {
              "chapter": 21,
              "verse": 15,
              "name": "Exodo 21:15",
              "text": "At ang sumakit sa kaniyang ama o sa kaniyang ina, ay papataying walang pagsala."
            },
            {
              "chapter": 21,
              "verse": 16,
              "name": "Exodo 21:16",
              "text": "At ang magnakaw ng isang tao, at ipagbili, o masumpungan sa kaniyang kamay, ay papataying walang pagsala."
            },
            {
              "chapter": 21,
              "verse": 17,
              "name": "Exodo 21:17",
              "text": "At ang lumait sa kaniyang ama, o sa kaniyang ina, ay papataying walang pagsala."
            },
            {
              "chapter": 21,
              "verse": 18,
              "name": "Exodo 21:18",
              "text": "At kung may magbabag, at saktan ng isa ang isa, ng bato, o ng kaniyang suntok, at hindi mamatay, kundi mahiga lamang sa banig:"
            },
            {
              "chapter": 21,
              "verse": 19,
              "name": "Exodo 21:19",
              "text": "Kung makabangon uli, at makalakad sa tulong ng kaniyang tungkod, ay ligtas nga yaong sumakit sa kaniya; pagbabayaran lamang niya ang panahong nasayang, at kaniyang pagagalinging maigi."
            },
            {
              "chapter": 21,
              "verse": 20,
              "name": "Exodo 21:20",
              "text": "At kung saktan ng sinoman ang kaniyang aliping lalake o babae, ng tungkod at mamatay sa kaniyang kamay; ay parurusahan siyang walang pagsala."
            },
            {
              "chapter": 21,
              "verse": 21,
              "name": "Exodo 21:21",
              "text": "Gayon ma'y kung tumagal ng isang araw o dalawa, ay hindi siya parurusahan: sapagka't siya'y kaniyang salapi."
            },
            {
              "chapter": 21,
              "verse": 22,
              "name": "Exodo 21:22",
              "text": "At kung may magbabag, at makasakit ng isang babaing buntis, na ano pa't makunan, at gayon ma'y walang karamdamang sumunod: ay tunay na papagbabayarin siya, ayon sa iatang sa kaniya ng asawa ng babae; at siya'y magbabayad ng ayon sa ipasiya ng mga hukom."
            },
            {
              "chapter": 21,
              "verse": 23,
              "name": "Exodo 21:23",
              "text": "Datapuwa't kung may anomang karamdamang sumunod, magbabayad ka nga ng buhay kung buhay,"
            },
            {
              "chapter": 21,
              "verse": 24,
              "name": "Exodo 21:24",
              "text": "Mata kung mata, ngipin kung ngipin, kamay kung kamay, paa kung paa,"
            },
            {
              "chapter": 21,
              "verse": 25,
              "name": "Exodo 21:25",
              "text": "Paso kung paso, sugat kung sugat, bugbog kung bugbog."
            },
            {
              "chapter": 21,
              "verse": 26,
              "name": "Exodo 21:26",
              "text": "At kung saktan ng sinoman ang mata ng kaniyang aliping lalake, o ang mata ng kaniyang aliping babae at mabulag, ay kaniyang palalayain dahil sa kaniyang mata."
            },
            {
              "chapter": 21,
              "verse": 27,
              "name": "Exodo 21:27",
              "text": "At kung kaniyang bungalan ang kaniyang aliping lalake, o babae, ay kaniyang palalayain dahil sa kaniyang ngipin."
            },
            {
              "chapter": 21,
              "verse": 28,
              "name": "Exodo 21:28",
              "text": "At kung ang isang baka ay manuwag ng isang lalake o ng isang babae, na ano pa't mamatay, ay babatuhing walang pagsala ang baka at ang kaniyang lama'y hindi kakanin; datapuwa't ang may-ari ng baka ay maliligtas."
            },
            {
              "chapter": 21,
              "verse": 29,
              "name": "Exodo 21:29",
              "text": "Datapuwa't kung ang baka ay dating manunuwag sa panahong nakaraan, at naisumbong na sa may-ari at hindi niya kinulong, na ano pa't makamatay ng isang lalake, o isang babae: ay babatuhin ang baka at ang may-ari naman ay papatayin."
            },
            {
              "chapter": 21,
              "verse": 30,
              "name": "Exodo 21:30",
              "text": "Kung siya'y atangan ng katubusan ay magbibigay nga siya ng katubusan sa kaniyang buhay anomang iatang sa kaniya."
            },
            {
              "chapter": 21,
              "verse": 31,
              "name": "Exodo 21:31",
              "text": "Maging manuwag sa isang anak na lalake o babae man, ay gagawin sa kaniya ayon sa kahatulang ito."
            },
            {
              "chapter": 21,
              "verse": 32,
              "name": "Exodo 21:32",
              "text": "Kung ang baka ay manuwag sa isang aliping lalake o babae, ay magbabayad ang may-ari ng tatlong pung siklong pilak sa kanilang panginoon, at ang baka ay babatuhin."
            },
            {
              "chapter": 21,
              "verse": 33,
              "name": "Exodo 21:33",
              "text": "At kung ang sinoman ay magbubukas ng isang balon, o huhukay ng isang balon at hindi tatakpan, at ang isang baka, o ang isang asno ay mahulog sa loob,"
            },
            {
              "chapter": 21,
              "verse": 34,
              "name": "Exodo 21:34",
              "text": "Ay sasaulian ng may-ari ng balon; magbabayad siya ng salapi sa may-ari ng mga yaon, at ang patay na hayop ay magiging kaniya."
            },
            {
              "chapter": 21,
              "verse": 35,
              "name": "Exodo 21:35",
              "text": "At kung ang baka ng sinoman ay sumakit sa baka ng iba, na ano pa't mamatay; ay kanila ngang ipagbibili ang bakang buhay, at kanilang paghahatiin ang halaga niyaon; at ang patay ay paghahatiin din nila."
            },
            {
              "chapter": 21,
              "verse": 36,
              "name": "Exodo 21:36",
              "text": "O kung kilala, na ang baka ay dating manunuwag sa panahong nakaraan, at hindi kinulong ng may-ari; ay tunay ngang magbabayad siya, ng baka kung baka, at ang patay na hayop ay magiging kaniyang sarili."
            }
          ]
        },
        {
          "chapter": 22,
          "name": "Exodo 22",
          "verses": [
            {
              "chapter": 22,
              "verse": 1,
              "name": "Exodo 22:1",
              "text": "Kung ang isang lalake ay magnakaw ng isang baka, o ng isang tupa at patayin, o ipagbili: ay kaniyang pagbabayaran ng limang baka ang isang baka, at ng apat na tupa ang isang tupa."
            },
            {
              "chapter": 22,
              "verse": 2,
              "name": "Exodo 22:2",
              "text": "Kung ang isang magnanakaw ay masumpungan, na naninira, at masaktan na ano pa't namatay ay hindi aariing mamamataytao ang pumatay."
            },
            {
              "chapter": 22,
              "verse": 3,
              "name": "Exodo 22:3",
              "text": "Kung sikatan siya ng araw, ay aariin siyang mamamataytao; siya'y dapat magsauli ng kabayaran: kung siya'y wala ay ipagbibili siya dahil sa kaniyang ninakaw."
            },
            {
              "chapter": 22,
              "verse": 4,
              "name": "Exodo 22:4",
              "text": "Kung ang ninakaw ay masumpungang buhay sa kaniyang kamay, maging baka, o asno, o tupa, ay magbabayad siya ng ibayo."
            },
            {
              "chapter": 22,
              "verse": 5,
              "name": "Exodo 22:5",
              "text": "Kung ang sinoman ay magpastol sa isang bukid, o sa isang ubasan, at pawalan ang kaniyang hayop at pastulin sa bukid ng iba; sa pinakamainam sa kaniyang sariling parang, at sa pinakamainam sa kaniyang sariling ubasan, ay sasaulian niya."
            },
            {
              "chapter": 22,
              "verse": 6,
              "name": "Exodo 22:6",
              "text": "Kung may magningas na apoy, at magtangay ng mga tinik, na ano pa't ang mga mandala, o ang mga uhay, o ang bukid ay masunog, ay tunay na magbabayad yaong nagpaningas ng apoy."
            },
            {
              "chapter": 22,
              "verse": 7,
              "name": "Exodo 22:7",
              "text": "Kung ang sinoman ay magpatago sa kaniyang kapuwa ng salapi o pag-aari, at nakawin sa bahay ng taong yaon; kung masumpungan ang magnanakaw, ay magbabayad ng ibayo."
            },
            {
              "chapter": 22,
              "verse": 8,
              "name": "Exodo 22:8",
              "text": "Kung hindi masumpungan ang magnanakaw, ay lalapit ang may-ari ng bahay sa Dios, upang maalaman kung hindi niya pinakialaman ang pag-aari ng kaniyang kapuwa."
            },
            {
              "chapter": 22,
              "verse": 9,
              "name": "Exodo 22:9",
              "text": "Sapagka't lahat ng bagay na pagsalangsang, maging sa baka, sa asno, sa tupa, sa damit, o sa anomang bagay na nawala, na may magsabi, Ito nga ay akin; ay dadalhin sa harap ng Dios ang usap ng dalawa; yaong parurusahan ng Dios ay magbabayad ng ibayo sa kaniyang kapuwa."
            },
            {
              "chapter": 22,
              "verse": 10,
              "name": "Exodo 22:10",
              "text": "Kung ang sinoman ay maghabilin sa kaniyang kapuwa ng isang asno, o ng isang baka, o ng isang tupa, o ng anomang hayop; at mamatay, o masasaktan, o maagaw, na walang nakakakitang sinoman:"
            },
            {
              "chapter": 22,
              "verse": 11,
              "name": "Exodo 22:11",
              "text": "Ay pamamagitanan silang dalawa ng pagsumpa sa Panginoon kung hindi niya pinakialaman ang pag-aari ng kaniyang kapuwa; at tatanggapin ng may-ari, at siya'y hindi magsasauli."
            },
            {
              "chapter": 22,
              "verse": 12,
              "name": "Exodo 22:12",
              "text": "Datapuwa't kung kaniyang ninakaw sa kaniya ay sasaulian niya ang may-ari niyaon."
            },
            {
              "chapter": 22,
              "verse": 13,
              "name": "Exodo 22:13",
              "text": "Kung nalapa ay dadalhing pinakapatotoo, at hindi sasaulian ang nalapa."
            },
            {
              "chapter": 22,
              "verse": 14,
              "name": "Exodo 22:14",
              "text": "At kung ang sinoman ay humiram ng anoman sa kaniyang kapuwa, at masaktan, o mamatay, na hindi kaharap ang may-ari, ay walang pagsala na siya'y magsasauli."
            },
            {
              "chapter": 22,
              "verse": 15,
              "name": "Exodo 22:15",
              "text": "Kung ang may-ari niyaon ay kaharap, ay hindi niya sasaulian; kung isang bagay na pinauupahan ay ihuhulog sa kaniyang kaupahan."
            },
            {
              "chapter": 22,
              "verse": 16,
              "name": "Exodo 22:16",
              "text": "At kung dayain ng isang lalake ang isang dalaga, na hindi pa niya nagiging asawa at kaniyang sipingan, ay tunay na kaniyang ipagbabayad ng bigay-kaya upang maging asawa niya."
            },
            {
              "chapter": 22,
              "verse": 17,
              "name": "Exodo 22:17",
              "text": "Kung itangging mainam ng kaniyang ama na ibigay sa kaniya, ay magbabayad siya ng salapi, ayon sa bigay-kaya sa mga dalaga."
            },
            {
              "chapter": 22,
              "verse": 18,
              "name": "Exodo 22:18",
              "text": "Huwag mong babatahing mabuhay ang isang babaing manggagaway."
            },
            {
              "chapter": 22,
              "verse": 19,
              "name": "Exodo 22:19",
              "text": "Sinomang makiapid sa isang hayop ay papataying walang pagsala."
            },
            {
              "chapter": 22,
              "verse": 20,
              "name": "Exodo 22:20",
              "text": "Yaong maghain sa anomang dios, maliban sa Panginoon lamang, ay lubos na papatayin."
            },
            {
              "chapter": 22,
              "verse": 21,
              "name": "Exodo 22:21",
              "text": "At ang taga ibang lupa ay huwag mong aapihin, o pipighatiin man; sapagka't kayo'y naging taga ibang lupa sa lupain ng Egipto."
            },
            {
              "chapter": 22,
              "verse": 22,
              "name": "Exodo 22:22",
              "text": "Huwag mong papagdadalamhatiin ang sinomang babaing bao, o ulila."
            },
            {
              "chapter": 22,
              "verse": 23,
              "name": "Exodo 22:23",
              "text": "Kung iyong dalamhatiin sila sa anomang paraan, at sila'y dumaing sa akin, ay walang pagsala, na aking didinggin ang kanilang daing;"
            },
            {
              "chapter": 22,
              "verse": 24,
              "name": "Exodo 22:24",
              "text": "At ang aking pagiinit ay magaalab, at aking papatayin kayo ng tabak; at ang inyong mga asawa ay magiging mga bao, at ang inyong mga anak ay mga ulila."
            },
            {
              "chapter": 22,
              "verse": 25,
              "name": "Exodo 22:25",
              "text": "Kung magpautang ka ng salapi sa kanino man sa aking bayan na kasama mo na dukha, huwag kang magpapakamanunubo sa kaniya ni hihingan mo man siya ng tubo."
            },
            {
              "chapter": 22,
              "verse": 26,
              "name": "Exodo 22:26",
              "text": "Kung iyong tanggapin sa anoman ang damit ng iyong kapuwa na pinakasangla, ay iyong isasauli sa kaniya bago lumubog ang araw;"
            },
            {
              "chapter": 22,
              "verse": 27,
              "name": "Exodo 22:27",
              "text": "Sapagka't iyan ang kaniya lamang pangbihis, siyang kaniyang pangdamit sa kaniyang balat: ano ngang kaniyang ipangtutulog? at mangyayari, na pagka siya'y dumaing sa akin, ay aking didinggin; sapagka't ako'y mapagbiyaya."
            },
            {
              "chapter": 22,
              "verse": 28,
              "name": "Exodo 22:28",
              "text": "Huwag mong lalapastanganin ang Dios, ni susumpain man ang pinuno sa iyong bayan."
            },
            {
              "chapter": 22,
              "verse": 29,
              "name": "Exodo 22:29",
              "text": "Huwag kang magmamakupad ng paghahandog ng iyong mga ani, at ng tulo ng iyong mga pigaan. Ang panganay sa iyong mga anak na lalake ay ibibigay mo sa akin."
            },
            {
              "chapter": 22,
              "verse": 30,
              "name": "Exodo 22:30",
              "text": "Gayon din ang gagawin mo sa iyong mga baka, at sa iyong mga tupa: pitong araw na mapapa sa kaniyang ina; sa ikawalong araw ay ibibigay mo sa akin."
            },
            {
              "chapter": 22,
              "verse": 31,
              "name": "Exodo 22:31",
              "text": "At kayo'y magpapakabanal na tao sa akin: na ano pa't huwag kayong kakain ng anomang laman, na nalapa ng ganid sa parang; inyong ihahagis sa mga asno."
            }
          ]
        },
        {
          "chapter": 23,
          "name": "Exodo 23",
          "verses": [
            {
              "chapter": 23,
              "verse": 1,
              "name": "Exodo 23:1",
              "text": "Huwag kang magkakalat ng kasinungalingan: huwag kang makikipagkayari sa masama, na maging saksi kang sinungaling."
            },
            {
              "chapter": 23,
              "verse": 2,
              "name": "Exodo 23:2",
              "text": "Huwag kang susunod sa karamihan na gumawa ng masama; ni magbibigay patotoo man sa isang usap, na ang kiling ay sa karamihan upang sirain ang kahatulan:"
            },
            {
              "chapter": 23,
              "verse": 3,
              "name": "Exodo 23:3",
              "text": "Ni huwag mo ring kikilingan ang dukha sa kaniyang usap."
            },
            {
              "chapter": 23,
              "verse": 4,
              "name": "Exodo 23:4",
              "text": "Kung iyong masumpungan ang baka ng iyong kaalit o ang kaniyang asno, na nakawala, ay tunay na ibabalik mo sa kaniya."
            },
            {
              "chapter": 23,
              "verse": 5,
              "name": "Exodo 23:5",
              "text": "Kung iyong makita ang asno ng napopoot sa iyo, na nakalugmok sa ilalim ng kaniyang pasan, at ayaw mo mang alisan ng pasan, ay walang pagsalang iyong tutulungan pati ng may-ari niyaon."
            },
            {
              "chapter": 23,
              "verse": 6,
              "name": "Exodo 23:6",
              "text": "Huwag mong sisirain ang kahatulan ng iyong dukha, sa kaniyang usap."
            },
            {
              "chapter": 23,
              "verse": 7,
              "name": "Exodo 23:7",
              "text": "Layuan mo ang bagay na kasinungalingan, at ang walang sala at ang matuwid, ay huwag mong papatayin: sapagka't hindi ko patototohanan ang masama."
            },
            {
              "chapter": 23,
              "verse": 8,
              "name": "Exodo 23:8",
              "text": "At huwag kang tatanggap ng suhol: sapagka't ang suhol ay bumubulag sa mga may paningin, at sinisira ang mga salita ng mga banal."
            },
            {
              "chapter": 23,
              "verse": 9,
              "name": "Exodo 23:9",
              "text": "At ang taga ibang lupa ay huwag mong pipighatiin sapagka't talastas ninyo ang puso ng taga ibang lupa, yamang kayo'y naging mga taga ibang lupa, sa lupain ng Egipto."
            },
            {
              "chapter": 23,
              "verse": 10,
              "name": "Exodo 23:10",
              "text": "Anim na taong hahasikan mo ang iyong lupa at aanihin mo ang bunga niyaon:"
            },
            {
              "chapter": 23,
              "verse": 11,
              "name": "Exodo 23:11",
              "text": "Datapuwa't sa ikapitong taon ay iyong iiwan at babayaan, upang kumain ang dukha sa iyong bayan: at ang kanilang iwan ay kakanin ng hayop sa bukid. Gayon din ang iyong gagawin sa iyong ubasan at sa iyong olibohan."
            },
            {
              "chapter": 23,
              "verse": 12,
              "name": "Exodo 23:12",
              "text": "Anim na araw, na iyong gagawin ang iyong gawain, at sa ikapitong araw, ay magpapahinga ka: upang ang iyong baka at ang iyong asno ay makapagpahinga; at ang anak na lalake ng iyong aliping babae, at ang taga ibang lupa ay makapagpahinga."
            },
            {
              "chapter": 23,
              "verse": 13,
              "name": "Exodo 23:13",
              "text": "At lahat ng mga bagay na aking sinabi sa inyo ay inyong ingatan: at huwag ninyong banggitin ang pangalan ng ibang dios, o marinig man sa inyong bibig."
            },
            {
              "chapter": 23,
              "verse": 14,
              "name": "Exodo 23:14",
              "text": "Makaitlong magdidiwang ka ng pista sa akin, sa bawa't taon."
            },
            {
              "chapter": 23,
              "verse": 15,
              "name": "Exodo 23:15",
              "text": "Ang pista ng tinapay na walang lebadura ay iyong ipagdidiwang; pitong araw na kakain ka ng tinapay na walang lebadura, gaya ng iniutos ko sa iyo, sa takdang panahon, sa buwan ng Abib (sapagka't niyaon ka umalis sa Egipto); at walang lalapit sa harap ko na walang dala:"
            },
            {
              "chapter": 23,
              "verse": 16,
              "name": "Exodo 23:16",
              "text": "At ang pista ng pagaani ng mga unang bunga ng iyong kapagalan, na iyong inihasik sa bukid: at ang pista ng pagaani, sa katapusan ng taon, nang pagaani mo ng iyong kapagalan sa bukid."
            },
            {
              "chapter": 23,
              "verse": 17,
              "name": "Exodo 23:17",
              "text": "Makaitlo sa bawa't taon na ang lahat na iyong mga lalake ay haharap sa Panginoong Dios."
            },
            {
              "chapter": 23,
              "verse": 18,
              "name": "Exodo 23:18",
              "text": "Huwag mong ihahandog ang dugo ng hain sa akin, na kasabay ng tinapay na may lebadura; o iiwan mo man ang taba ng aking pista sa buong magdamag hanggang sa kinaumagahan."
            },
            {
              "chapter": 23,
              "verse": 19,
              "name": "Exodo 23:19",
              "text": "Ang mga pinakauna ng mga unang bunga ng iyong lupa ay iyong ipapasok sa bahay ng Panginoon mong Dios. Huwag mong lulutuin ang batang kambing sa gatas ng kaniyang ina."
            },
            {
              "chapter": 23,
              "verse": 20,
              "name": "Exodo 23:20",
              "text": "Narito, aking sinusugo ang isang anghel sa unahan mo, upang ingatan ka sa daan, at upang dalhin ka sa dakong aking inihanda sa iyo."
            },
            {
              "chapter": 23,
              "verse": 21,
              "name": "Exodo 23:21",
              "text": "Magingat kayo sa kaniya, at dinggin ninyo ang kaniyang tinig; huwag ninyong mungkahiin siya: sapagka't hindi niya patatawarin ang inyong pagsalangsang; sapagka't ang aking pangalan ay nasa kaniya."
            },
            {
              "chapter": 23,
              "verse": 22,
              "name": "Exodo 23:22",
              "text": "Datapuwa't kung didinggin mong lubos ang kaniyang tinig, at gagawin mo ang lahat ng aking sinasalita; ay magiging kaaway nga ako ng iyong mga kaaway, kaalit ng iyong mga kaalit."
            },
            {
              "chapter": 23,
              "verse": 23,
              "name": "Exodo 23:23",
              "text": "Sapagka't ang aking anghel ay magpapauna sa iyo at dadalhin ka sa Amorrheo, at sa Hetheo at sa Perezeo, at sa Cananeo, at sa Heveo, at sa Jebuseo, at aking lilipulin."
            },
            {
              "chapter": 23,
              "verse": 24,
              "name": "Exodo 23:24",
              "text": "Huwag kang yuyukod sa kanilang mga dios, o maglilingkod man sa mga yaon, o gagawa man ng ayon sa kanilang mga gawa, kundi iyong iwawaksi at iyong pagpuputulputulin ang kanilang mga haligi na pinakaalaala."
            },
            {
              "chapter": 23,
              "verse": 25,
              "name": "Exodo 23:25",
              "text": "At inyong paglilingkuran ang Panginoon ninyong Dios, at kaniyang babasbasan ang iyong tinapay at ang iyong tubig; at aking aalisin ang sakit sa gitna mo."
            },
            {
              "chapter": 23,
              "verse": 26,
              "name": "Exodo 23:26",
              "text": "Walang babaing makukunan, o magiging baog man, sa iyong lupain: ang bilang ng iyong mga araw ay aking lulubusin."
            },
            {
              "chapter": 23,
              "verse": 27,
              "name": "Exodo 23:27",
              "text": "Aking susuguin ang sindak sa unahan mo, at aking liligaligin ang buong bayan na iyong paroroonan, at aking patatalikurin sa iyo ang lahat ng iyong mga kaaway."
            },
            {
              "chapter": 23,
              "verse": 28,
              "name": "Exodo 23:28",
              "text": "At aking susuguin ang mga putakti sa unahan mo, na magpapalayas sa Heveo, sa Cananeo at sa Hetheo, sa harap mo."
            },
            {
              "chapter": 23,
              "verse": 29,
              "name": "Exodo 23:29",
              "text": "Hindi ko palalayasin sila sa harap mo sa isang taon; baka ang lupa'y maging ilang, at ang mga ganid sa parang ay magsidami laban sa iyo."
            },
            {
              "chapter": 23,
              "verse": 30,
              "name": "Exodo 23:30",
              "text": "Untiunting aking palalayasin sila sa harap mo, hanggang sa ikaw ay kumapal at manahin mo ang lupain."
            },
            {
              "chapter": 23,
              "verse": 31,
              "name": "Exodo 23:31",
              "text": "At aking itatatag ang iyong hangganan na mula sa Dagat na Mapula hanggang sa dagat ng Filistia at mula sa ilang hanggang sa Ilog ng Eufrates: sapagka't aking ibibigay ang mga nananahan sa lupain sa iyong kamay, at iyo silang palalayasin sa harap mo."
            },
            {
              "chapter": 23,
              "verse": 32,
              "name": "Exodo 23:32",
              "text": "Huwag kang makikipagtipan sa kanila, ni sa kanilang mga dios."
            },
            {
              "chapter": 23,
              "verse": 33,
              "name": "Exodo 23:33",
              "text": "Sila'y hindi tatahan sa iyong lupain, baka papagkasalahin ka nila laban sa akin: sapagka't kung ikaw ay maglingkod sa kanilang mga dios, ay tunay na magiging silo sa iyo."
            }
          ]
        },
        {
          "chapter": 24,
          "name": "Exodo 24",
          "verses": [
            {
              "chapter": 24,
              "verse": 1,
              "name": "Exodo 24:1",
              "text": "At kaniyang sinabi kay Moises, Sumampa ka sa kinaroroonan ng Panginoon, ikaw, at si Aaron, si Nadab, at si Abiu, at pitong pu ng mga matanda sa Israel; at sumamba kayo mula sa malayo:"
            },
            {
              "chapter": 24,
              "verse": 2,
              "name": "Exodo 24:2",
              "text": "At si Moises lamang ang lalapit sa Panginoon; datapuwa't sila'y hindi lalapit; o ang bayan man ay sasampang kasama niya."
            },
            {
              "chapter": 24,
              "verse": 3,
              "name": "Exodo 24:3",
              "text": "At lumapit si Moises at isinaysay sa bayan ang lahat ng mga salita ng Panginoon, at ang lahat ng mga palatuntunan. At ang buong bayan ay sumagot ng paminsan, at nagsabi, Lahat ng mga salita na sinalita ng Panginoon, ay aming gagawin."
            },
            {
              "chapter": 24,
              "verse": 4,
              "name": "Exodo 24:4",
              "text": "At sinulat ni Moises ang lahat ng mga salita ng Panginoon, at bumangon ng maaga sa kinaumagahan, at nagtayo ng isang dambana sa paanan ng bundok, at ng labing dalawang batong pinakaalaala, ayon sa labing dalawang lipi ng Israel."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "Exodo 24:5",
              "text": "At kaniyang sinugo ang mga binata ng mga anak ni Israel, na nagsipaghandog ng mga handog na susunugin at nagsipaghain sa Panginoon ng handog na baka tungkol sa kapayapaan."
            },
            {
              "chapter": 24,
              "verse": 6,
              "name": "Exodo 24:6",
              "text": "At kinuha ni Moises ang kalahati ng dugo, at inilagay sa mga tasa; at ang kalahati ng dugo ay iniwisik sa ibabaw ng dambana."
            },
            {
              "chapter": 24,
              "verse": 7,
              "name": "Exodo 24:7",
              "text": "At kaniyang kinuha ang aklat ng tipan, at binasa sa pakinig ng bayan: at kanilang sinabi, Lahat ng sinalita ng Panginoon ay aming gagawin, at kami ay magmamasunurin."
            },
            {
              "chapter": 24,
              "verse": 8,
              "name": "Exodo 24:8",
              "text": "At kinuha ni Moises ang dugo at iniwisik sa bayan, at sinabi, Narito ang dugo ng tipan, na ipinakipagtipan ng Panginoon sa inyo tungkol sa lahat ng mga salitang ito."
            },
            {
              "chapter": 24,
              "verse": 9,
              "name": "Exodo 24:9",
              "text": "Nang magkagayo'y sumampa si Moises, at si Aaron, si Nadab, at si Abiu, at pitongpu ng mga matanda sa Israel:"
            },
            {
              "chapter": 24,
              "verse": 10,
              "name": "Exodo 24:10",
              "text": "At kanilang nakita ang Dios ng Israel; at mayroon sa ilalim ng kaniyang mga paa na parang isang yaring lapag na batong zafiro, at paris din ng langit sa kaliwanagan."
            },
            {
              "chapter": 24,
              "verse": 11,
              "name": "Exodo 24:11",
              "text": "At sa mga mahal na tao sa mga anak ni Israel ay hindi niya ipinatong ang kaniyang kamay: at sila'y tumingin sa Dios, at kumain at uminom."
            },
            {
              "chapter": 24,
              "verse": 12,
              "name": "Exodo 24:12",
              "text": "At sinabi ng Panginoon kay Moises, Sampahin mo ako sa bundok, at dumoon ka: at ikaw ay bibigyan ko ng mga tapyas na bato, at ng kautusan, at ng utos na aking isinulat, upang iyong maituro sa kanila."
            },
            {
              "chapter": 24,
              "verse": 13,
              "name": "Exodo 24:13",
              "text": "At tumindig si Moises, at si Josue na kaniyang tagapangasiwa: at si Moises ay sumampa sa bundok ng Dios."
            },
            {
              "chapter": 24,
              "verse": 14,
              "name": "Exodo 24:14",
              "text": "At kaniyang sinabi sa mga matanda, Hintayin ninyo kami rito hanggang sa kami ay bumalik sa inyo: at, narito si Aaron at si Hur ay kasama ninyo: sinomang magkaroon ng usap ay lumapit sa kanila."
            },
            {
              "chapter": 24,
              "verse": 15,
              "name": "Exodo 24:15",
              "text": "At sumampa si Moises sa bundok at tinakpan ng ulap ang bundok."
            },
            {
              "chapter": 24,
              "verse": 16,
              "name": "Exodo 24:16",
              "text": "At ang kaluwalhatian ng Panginoon ay nanahan sa ibabaw ng bundok ng Sinai, at tinakpan ng ulap na anim na araw: at sa ikapitong araw ay tinawag niya si Moises sa gitna ng ulap."
            },
            {
              "chapter": 24,
              "verse": 17,
              "name": "Exodo 24:17",
              "text": "At ang anyo ng kaluwalhatian ng Panginoon ay paris ng apoy na manunupok sa ibabaw ng taluktok ng bundok, sa harap ng mga mata ng mga anak ni Israel."
            },
            {
              "chapter": 24,
              "verse": 18,
              "name": "Exodo 24:18",
              "text": "At pumasok si Moises sa gitna ng ulap, at sumampa sa bundok: at si Moises ay natira sa bundok na apat na pung araw at apat na pung gabi."
            }
          ]
        },
        {
          "chapter": 25,
          "name": "Exodo 25",
          "verses": [
            {
              "chapter": 25,
              "verse": 1,
              "name": "Exodo 25:1",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 25,
              "verse": 2,
              "name": "Exodo 25:2",
              "text": "Salitain mo sa mga anak ni Israel, na sila'y magdala sa akin ng isang handog: ang bawa't tao na maganyak ang puso sa kagandahang loob ay kukunan ninyo ng handog sa akin."
            },
            {
              "chapter": 25,
              "verse": 3,
              "name": "Exodo 25:3",
              "text": "At ito ang handog na inyong kukunin sa kanila; ginto, at pilak, at tanso;"
            },
            {
              "chapter": 25,
              "verse": 4,
              "name": "Exodo 25:4",
              "text": "At kayong bughaw, kulay-ube, at pula, at lino at balahibo ng kambing;"
            },
            {
              "chapter": 25,
              "verse": 5,
              "name": "Exodo 25:5",
              "text": "At mga balat ng lalaking tupa na tinina sa pula, at mga balat ng poka, at kahoy na akasia;"
            },
            {
              "chapter": 25,
              "verse": 6,
              "name": "Exodo 25:6",
              "text": "Langis sa ilawan, mga espesia sa langis na pangpahid, at sa mabangong pangsuob;"
            },
            {
              "chapter": 25,
              "verse": 7,
              "name": "Exodo 25:7",
              "text": "Mga batong onix, at mga batong pangkalupkop sa efod, at sa pektoral."
            },
            {
              "chapter": 25,
              "verse": 8,
              "name": "Exodo 25:8",
              "text": "At kanilang igawa ako ng isang santuario; upang ako'y makatahan sa gitna nila."
            },
            {
              "chapter": 25,
              "verse": 9,
              "name": "Exodo 25:9",
              "text": "Ayon sa lahat ng aking ipinakita sa iyo, sa anyo ng tabernakulo at sa anyo ng lahat ng kasangkapan niyaon ay gayon ninyo gagawin."
            },
            {
              "chapter": 25,
              "verse": 10,
              "name": "Exodo 25:10",
              "text": "At sila'y gagawa ng isang kaban na kahoy na akasia: na may dalawang siko't kalahati ang haba niyaon, at may isang siko't kalahati ang luwang niyaon, at may isang siko't kalahati ang taas niyaon."
            },
            {
              "chapter": 25,
              "verse": 11,
              "name": "Exodo 25:11",
              "text": "At iyong babalutin ng taganas na ginto; sa loob at sa labas ay iyong babalutin, at igagawa mo sa ibabaw ng isang kornisa sa palibot."
            },
            {
              "chapter": 25,
              "verse": 12,
              "name": "Exodo 25:12",
              "text": "At ipagbububo mo ng apat na argolyang ginto, at ipaglalagay mo sa apat na paa niyaon, at dalawang argolya ang mapapasa isang tagiliran niyaon, at dalawang argolya sa kabilang tagiliran niyaon."
            },
            {
              "chapter": 25,
              "verse": 13,
              "name": "Exodo 25:13",
              "text": "At gagawa ka ng mga pingga na kahoy na akasia at iyong babalutin ng ginto."
            },
            {
              "chapter": 25,
              "verse": 14,
              "name": "Exodo 25:14",
              "text": "At iyong isusuot ang mga pingga sa loob ng mga argolya, sa mga tagiliran ng kaban, upang mabuhat ang kaban."
            },
            {
              "chapter": 25,
              "verse": 15,
              "name": "Exodo 25:15",
              "text": "Ang mga pingga ay masusuot sa loob ng mga argolya ng kaban: hindi aalisin doon."
            },
            {
              "chapter": 25,
              "verse": 16,
              "name": "Exodo 25:16",
              "text": "At iyong isisilid sa kaban ang mga kinalalagdaan ng patotoo na aking ibibigay sa iyo."
            },
            {
              "chapter": 25,
              "verse": 17,
              "name": "Exodo 25:17",
              "text": "At gagawa ka ng isang luklukan ng awa, na taganas na ginto: na may dalawang siko't kalahati ang haba niyaon, at may isang siko't kalahati ang luwang niyaon."
            },
            {
              "chapter": 25,
              "verse": 18,
              "name": "Exodo 25:18",
              "text": "At gagawa ka ng dalawang querubing ginto; na yari sa pamukpok iyong gagawin, sa dalawang dulo ng luklukan ng awa."
            },
            {
              "chapter": 25,
              "verse": 19,
              "name": "Exodo 25:19",
              "text": "At gawin mo ang isang querubin sa isang dulo, at ang isang querubin sa kabilang dulo: kaputol ng luklukan ng awa, gagawin mo ang mga querubin sa dalawang dulo niyaon."
            },
            {
              "chapter": 25,
              "verse": 20,
              "name": "Exodo 25:20",
              "text": "At ibubuka ng mga querubin ang kanilang pakpak na paitaas, na nilililiman ang luklukan ng awa, ng kanilang mga pakpak, na ang kanilang mukha ay nagkakaharap, sa dakong luklukan ng awa ihaharap ang mga mukha ng mga querubin."
            },
            {
              "chapter": 25,
              "verse": 21,
              "name": "Exodo 25:21",
              "text": "At iyong ilalagay ang luklukan ng awa sa ibabaw ng kaban; at sa loob ng kaban, ay iyong ilalagay ang mga kinalalagdaan ng patotoo, na aking ibibigay sa iyo."
            },
            {
              "chapter": 25,
              "verse": 22,
              "name": "Exodo 25:22",
              "text": "At diya'y makikipagkita ako sa iyo, at makikipanayam sa iyo mula sa ibabaw ng luklukan ng awa, sa gitna ng dalawang querubin na nangasa ibabaw ng kaban ng patotoo, tungkol sa lahat ng mga bagay na ibibigay ko sa iyong utos sa mga anak ni Israel."
            },
            {
              "chapter": 25,
              "verse": 23,
              "name": "Exodo 25:23",
              "text": "At gagawa ka ng isang dulang na kahoy na akasia: na may dalawang siko ang haba niyaon, at isang siko ang luwang niyaon, at isang siko't kalahati ang taas niyaon."
            },
            {
              "chapter": 25,
              "verse": 24,
              "name": "Exodo 25:24",
              "text": "At iyong babalutin ng taganas na ginto, at igagawa mo ng isang kornisang ginto sa palibot."
            },
            {
              "chapter": 25,
              "verse": 25,
              "name": "Exodo 25:25",
              "text": "At igagawa mo ng isang gilid na may isang palad ng kamay ang luwang sa palibot, at igagawa mo ng isang kornisang ginto ang palibot ng gilid niyaon."
            },
            {
              "chapter": 25,
              "verse": 26,
              "name": "Exodo 25:26",
              "text": "At igagawa mo ng apat na argolyang ginto, at ilalagay mo ang mga argolya sa apat na sulok na ukol sa apat na paa niyaon."
            },
            {
              "chapter": 25,
              "verse": 27,
              "name": "Exodo 25:27",
              "text": "Malalapit sa gilid ang mga argolya, sa daraanan ng mga pingga, upang madala ang dulang."
            },
            {
              "chapter": 25,
              "verse": 28,
              "name": "Exodo 25:28",
              "text": "At gagawin mo ang mga pingga na kahoy na akasia, at iyong babalutin ng ginto, upang ang dulang ay madala ng mga yaon."
            },
            {
              "chapter": 25,
              "verse": 29,
              "name": "Exodo 25:29",
              "text": "At gagawa ka ng mga pinggan niyaon, at ng mga kutsara niyaon, at ng mga kopa niyaon, at ng mga tasa niyaon na pagbubuhusan; na iyong gagawing taganas na ginto."
            },
            {
              "chapter": 25,
              "verse": 30,
              "name": "Exodo 25:30",
              "text": "At ilalagay mo sa dulang ang tinapay na handog sa harap ko na palagi."
            },
            {
              "chapter": 25,
              "verse": 31,
              "name": "Exodo 25:31",
              "text": "At gagawa ka ng isang kandelerong taganas na ginto: yari sa pamukpok gagawin mo ang kandelero, ang tuntungan niyaon, at ang haligi niyaon; ang mga kopa niyaon, ang mga globito niyaon at ang mga bulaklak niyaon ay mga kaputol:"
            },
            {
              "chapter": 25,
              "verse": 32,
              "name": "Exodo 25:32",
              "text": "At magkakaroon ng anim na sangang lumalabas sa mga tagiliran niyaon; tatlong sanga ng kandelero'y sa isang tagiliran niyaon, at ang tatlong sanga ng kandelero ay sa kabilang tagiliran niyaon:"
            },
            {
              "chapter": 25,
              "verse": 33,
              "name": "Exodo 25:33",
              "text": "At magkakaroon ng tatlong kopang anyong bulaklak ng almendro sa isang sanga, isang globito at isang bulaklak; at tatlong kopang anyong bulaklak ng almendro sa kabilang sanga, isang globito at isang bulaklak; at gayon sa anim na sangang lumalabas sa kandelero."
            },
            {
              "chapter": 25,
              "verse": 34,
              "name": "Exodo 25:34",
              "text": "At sa haligi ng kandelero'y magkakaroon ng apat na kopang anyong bulaklak ng almendro, sangpu ng mga globito niyaon, at ng mga bulaklak niyaon:"
            },
            {
              "chapter": 25,
              "verse": 35,
              "name": "Exodo 25:35",
              "text": "At magkakaroon ng isang globito sa ilalim ng dalawa sa mga sanga, at isang globito sa ilalim ng kabilang dalawa sa mga sanga na kaputol niyaon, at isang globito sa ilalim ng dalawang sangang nalalabi ayon sa anim na sanga na lumalabas sa kandelero."
            },
            {
              "chapter": 25,
              "verse": 36,
              "name": "Exodo 25:36",
              "text": "Ang magiging mga globito at mga sanga niyaon ay kaputol: kabuoan niyaon ay isa lamang putol na yari sa pamukpok, na taganas na ginto."
            },
            {
              "chapter": 25,
              "verse": 37,
              "name": "Exodo 25:37",
              "text": "At igagawa mo ng kaniyang mga ilawan, na pito: at kanilang sisindihan ang mga ilawan niyaon, upang lumiwanag sa dakong tapat ng kandelero."
            },
            {
              "chapter": 25,
              "verse": 38,
              "name": "Exodo 25:38",
              "text": "At ang magiging mga gunting at mga pinggan niyaon ay taganas na ginto."
            },
            {
              "chapter": 25,
              "verse": 39,
              "name": "Exodo 25:39",
              "text": "Isang talentong taganas na ginto gagawin, sangpu ng lahat ng kasangkapang ito."
            },
            {
              "chapter": 25,
              "verse": 40,
              "name": "Exodo 25:40",
              "text": "At ingatan mo, na iyong gawin ayon sa anyo ng mga yaon na ipinakita sa iyo sa bundok."
            }
          ]
        },
        {
          "chapter": 26,
          "name": "Exodo 26",
          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Exodo 26:1",
              "text": "Bukod dito'y gagawin mo ang tabernakulo na may sangpung tabing; na linong pinili, at bughaw, at kulay-ube, at pula, na may mga querubin na gawa ng bihasang manggagawa, iyong gagawin."
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Exodo 26:2",
              "text": "Ang magiging haba ng bawa't tabing ay dalawang pu't walong siko, at ang luwang ng bawa't tabing ay apat na siko: lahat ng tabing ay magkakaroon ng isang kasukatan."
            },
            {
              "chapter": 26,
              "verse": 3,
              "name": "Exodo 26:3",
              "text": "Limang tabing ay papagsusugpunging isa't isa; at ang ibang limang tabing ay papagsusugpunging isa't isa."
            },
            {
              "chapter": 26,
              "verse": 4,
              "name": "Exodo 26:4",
              "text": "At gagawa ka ng mga presilyang bughaw sa gilid ng isang tabing sa hangganan ng pagkakasugpong, at gayon din gagawin mo sa gilid ng ikalawang tabing na nasa ikalawang pagkakasugpong."
            },
            {
              "chapter": 26,
              "verse": 5,
              "name": "Exodo 26:5",
              "text": "Limang pung presilya ang iyong gagawin sa isang tabing, at limang pung presilya ang iyong gagawin sa gilid ng tabing na nasa ikalawang pagkakasugpong; ang mga presilya ay magkakatapat na isa't isa."
            },
            {
              "chapter": 26,
              "verse": 6,
              "name": "Exodo 26:6",
              "text": "At limang pung pangawit na ginto ang iyong gagawin at pagsusugpungin mo ang mga tabing sa pamamagitan ng mga kawit; at magiging isa lamang."
            },
            {
              "chapter": 26,
              "verse": 7,
              "name": "Exodo 26:7",
              "text": "At gagawa ka ng mga tabing na balahibo ng kambing na pinaka tolda sa ibabaw ng tabernakulo: labing isang tabing ang iyong gagawin."
            },
            {
              "chapter": 26,
              "verse": 8,
              "name": "Exodo 26:8",
              "text": "Ang magiging haba ng bawa't tabing ay tatlong pung siko, at ang luwang ng bawa't tabing ay apat na siko: ang labing isang tabing ay magkakaroon ng isang sukat."
            },
            {
              "chapter": 26,
              "verse": 9,
              "name": "Exodo 26:9",
              "text": "At iyong papagsusugpungin ang limang tabing, at gayon din ang anim na tabing, at iyong ititiklop ang ikaanim na tabing sa harapan ng tabernakulo."
            },
            {
              "chapter": 26,
              "verse": 10,
              "name": "Exodo 26:10",
              "text": "At limang pung presilya ang iyong gagawin sa tagiliran ng isang tabing na nasa hangganan ng pagkakasugpong, at limang pung presilya sa tagiliran ng ikalawang pagkakasugpong."
            },
            {
              "chapter": 26,
              "verse": 11,
              "name": "Exodo 26:11",
              "text": "At gagawa ka ng limang pung pangawit na tanso, at ikakabit mo ang mga pangawit sa mga presilya at pagsusugpungin mo ang tolda upang maging isa."
            },
            {
              "chapter": 26,
              "verse": 12,
              "name": "Exodo 26:12",
              "text": "At ang dakong nakalawit na nalalabi sa mga tabing ng tolda, na siyang kalahati ng tabing na nalalabi ay ilalaylay sa likuran ng tabernakulo."
            },
            {
              "chapter": 26,
              "verse": 13,
              "name": "Exodo 26:13",
              "text": "At ang siko ng isang dako at ang siko ng kabilang dako niyaong nalalabi sa haba ng mga tabing ng tolda, ay ilalaylay sa mga tagiliran ng tabernakulo, sa dakong ito at sa dakong yaon, upang takpan."
            },
            {
              "chapter": 26,
              "verse": 14,
              "name": "Exodo 26:14",
              "text": "At gagawa ka ng isang pangtakip sa tolda na balat ng lalaking tupa na tininang pula, at isang pangtakip na balat ng poka, sa ibabaw."
            },
            {
              "chapter": 26,
              "verse": 15,
              "name": "Exodo 26:15",
              "text": "At igagawa mo ng mga tabla ang tabernakulo, na kahoy na akasia na mga patayo."
            },
            {
              "chapter": 26,
              "verse": 16,
              "name": "Exodo 26:16",
              "text": "Sangpung siko ang magiging haba ng isang tabla, at isang siko at kalahati ang luwang ng bawa't tabla."
            },
            {
              "chapter": 26,
              "verse": 17,
              "name": "Exodo 26:17",
              "text": "Dalawang mitsa magkakaroon ang bawa't tabla na nagkakasugpong na isa't isa: ang gagawin mo sa lahat ng tabla ng tabernakulo."
            },
            {
              "chapter": 26,
              "verse": 18,
              "name": "Exodo 26:18",
              "text": "At igagawa mo ng mga tabla ang tabernakulo: dalawang pung tabla sa tagilirang timugan sa dakong timugan."
            },
            {
              "chapter": 26,
              "verse": 19,
              "name": "Exodo 26:19",
              "text": "At gagawa ka ng apat na pung tungtungang pilak upang ilagay sa ilalim ng dalawang pung tabla, dalawang tungtungan sa bawa't tabla na ukol sa kaniyang dalawang mitsa, at dalawang tungtungan sa ilalim ng ibang tabla na ukol sa kaniyang dalawang mitsa:"
            },
            {
              "chapter": 26,
              "verse": 20,
              "name": "Exodo 26:20",
              "text": "At sa ikalawang tagiliran ng tabernakulo, sa dakong hilagaan, ay dalawang pung tabla:"
            },
            {
              "chapter": 26,
              "verse": 21,
              "name": "Exodo 26:21",
              "text": "At ang kanilang apat na pung tungtungang pilak; dalawang tungtungan sa ilalim ng isang tabla, at dalawang tungtungan sa ilalim ng kabilang tabla."
            },
            {
              "chapter": 26,
              "verse": 22,
              "name": "Exodo 26:22",
              "text": "At sa dakong hulihan ng tabernakulo, sa dakong kalunuran ay igagawa mo ng anim na tabla."
            },
            {
              "chapter": 26,
              "verse": 23,
              "name": "Exodo 26:23",
              "text": "At igagawa mo ng dalawang tabla ang mga sulok ng tabernakulo sa dakong hulihan."
            },
            {
              "chapter": 26,
              "verse": 24,
              "name": "Exodo 26:24",
              "text": "At pagpapatungin sa dakong ibaba, at gayon din na maugnay sa itaas niyaon sa isang argolya; gayon ang gagawin sa dalawa; para sa dalawang sulok."
            },
            {
              "chapter": 26,
              "verse": 25,
              "name": "Exodo 26:25",
              "text": "At magkakaroon ng walong tabla, at ang kanilang mga tungtungang pilak ay labing anim na tungtungan: dalawang tungtungan sa ilalim ng isang tabla, at dalawang tungtungan sa ilalim ng kabilang tabla."
            },
            {
              "chapter": 26,
              "verse": 26,
              "name": "Exodo 26:26",
              "text": "At gagawa ka ng mga barakilan, na kahoy na akasia; lima sa mga tabla ng isang tagiliran ng tabernakulo;"
            },
            {
              "chapter": 26,
              "verse": 27,
              "name": "Exodo 26:27",
              "text": "At limang barakilan sa mga tabla ng kabilang tagiliran ng tabernakulo, at limang barakilan sa mga tabla ng tagiliran ng tabernakulo sa dakong hulihan, na dakong kalunuran."
            },
            {
              "chapter": 26,
              "verse": 28,
              "name": "Exodo 26:28",
              "text": "At ang gitnang barakilan ay daraan sa kalagitnaan ng mga tabla mula sa isang dulo hanggang sa kabila."
            },
            {
              "chapter": 26,
              "verse": 29,
              "name": "Exodo 26:29",
              "text": "At iyong babalutin ng ginto ang mga tabla, at gigintuin mo ang kanilang mga argolya na pagdaraanan ng mga barakilan: at iyong babalutin ng ginto ang mga barakilan."
            },
            {
              "chapter": 26,
              "verse": 30,
              "name": "Exodo 26:30",
              "text": "At iyong itatayo ang tabernakulo ayon sa anyo niyaon, na ipinakita sa iyo sa bundok."
            },
            {
              "chapter": 26,
              "verse": 31,
              "name": "Exodo 26:31",
              "text": "At gagawa ka ng isang lambong na bughaw at kulay-ube, at pula at linong pinili: na may mga querubing mainam ang pagkayari:"
            },
            {
              "chapter": 26,
              "verse": 32,
              "name": "Exodo 26:32",
              "text": "At iyong isasampay sa apat na haliging akasia na balot ng ginto, na pati ng kanilang mga pangipit ay ginto rin: na nakapatong sa ibabaw ng apat na tungtungang pilak."
            },
            {
              "chapter": 26,
              "verse": 33,
              "name": "Exodo 26:33",
              "text": "At iyong ibibitin ang lambong sa ilalim ng mga pangalawit, at iyong ipapasok doon sa loob ng lambong ang kaban ng patotoo: at paghihiwalayin sa inyo ng lambong ang dakong banal at ang kabanalbanalang dako."
            },
            {
              "chapter": 26,
              "verse": 34,
              "name": "Exodo 26:34",
              "text": "At iyong ilalagay ang luklukan ng awa sa ibabaw ng kaban ng patotoo sa kabanalbanalang dako."
            },
            {
              "chapter": 26,
              "verse": 35,
              "name": "Exodo 26:35",
              "text": "At iyong ilalagay ang dulang sa labas ng lambong, at ang kandelero ay sa tapat ng dulang sa tagiliran ng tabernakulo na dakong timugan: at ang dulang ay ilalagay mo sa dakong hilagaan."
            },
            {
              "chapter": 26,
              "verse": 36,
              "name": "Exodo 26:36",
              "text": "At igagawa mo ng isang tabing ang pintuan ng tolda na kayong bughaw at kulay-ube, at pula, at linong pinili, na yari ng mangbuburda."
            },
            {
              "chapter": 26,
              "verse": 37,
              "name": "Exodo 26:37",
              "text": "At igagawa mo ang tabing ng limang haliging akasia at babalutin mo ng ginto; na ang sima ng mga yaon ay ginto rin: at ipagbububo mo ng limang tungtungan."
            }
          ]
        },
        {
          "chapter": 27,
          "name": "Exodo 27",
          "verses": [
            {
              "chapter": 27,
              "verse": 1,
              "name": "Exodo 27:1",
              "text": "At gagawin mong kahoy ng akasia ang dambana, na limang siko ang haba at limang siko ang luwang; ang dambana ay gagawing parisukat: at ang taas ay magkakaroon ng tatlong siko."
            },
            {
              "chapter": 27,
              "verse": 2,
              "name": "Exodo 27:2",
              "text": "At gagawin mo ang mga anyong sungay sa ibabaw ng apat na sulok niyaon: ang mga anyong sungay ay kaputol din, at iyong babalutin ng tanso."
            },
            {
              "chapter": 27,
              "verse": 3,
              "name": "Exodo 27:3",
              "text": "At igagawa mo ng kaniyang mga kawa upang magalis ng mga abo, at ng mga pala, at ng mga mangkok, at ng mga pangalawit at ng mga suuban: lahat ng mga kasangkapa'y gagawin mong tanso."
            },
            {
              "chapter": 27,
              "verse": 4,
              "name": "Exodo 27:4",
              "text": "At igagawa mo ng isang salang tanso na tila lambat ang yari, at ang ibabaw ng nilambat ay igagawa mo ng apat na argolyang tanso sa apat na sulok niyaon."
            },
            {
              "chapter": 27,
              "verse": 5,
              "name": "Exodo 27:5",
              "text": "At ilalagay mo sa ibaba ng gilid ng dambana, sa dakong ibaba, upang ang nilambat ay umabot hanggang sa kalahatian ng dambana."
            },
            {
              "chapter": 27,
              "verse": 6,
              "name": "Exodo 27:6",
              "text": "At igagawa mo ng mga pingga ang dambana, mga pinggang kahoy na akasia at babalutin mo ng tanso."
            },
            {
              "chapter": 27,
              "verse": 7,
              "name": "Exodo 27:7",
              "text": "At ang mga pingga niyao'y isusuot sa mga argolya, at ang mga pingga ay ilalagay sa dalawang tagiliran ng dambana, pagka dinadala."
            },
            {
              "chapter": 27,
              "verse": 8,
              "name": "Exodo 27:8",
              "text": "Gagawin mo ang dambana na kuluong sa pamamagitan ng mga tabla kung paano ang ipinakita sa iyo sa bundok, ay gayon gagawin nila."
            },
            {
              "chapter": 27,
              "verse": 9,
              "name": "Exodo 27:9",
              "text": "At iyong gagawin ang looban ng tabernakulo: sa tagilirang timugan na dakong timugan ay magkakaroon ng mga tabing sa looban na linong pinili, na may isang daang siko ang haba sa isang tagiliran:"
            },
            {
              "chapter": 27,
              "verse": 10,
              "name": "Exodo 27:10",
              "text": "At ang ihahaligi doo'y dalawang pu, at ang mga tungtungan ng mga yaon ay dalawang pu na tanso; ang mga sima ng mga haligi at ang mga pilete niyaon ay pilak."
            },
            {
              "chapter": 27,
              "verse": 11,
              "name": "Exodo 27:11",
              "text": "At gayon din sa tagilirang dakong hilagaan, sa kahabaan ay magkakaroon ng mga tabing na may isang daang siko ang haba, at ang mga haligi ng mga yaon ay dalawangpu, at ang mga tungtungan ng mga yaon ay dalawangpu na tanso; ang mga sima ng mga haligi at ang mga pilete ng mga yaon ay pilak."
            },
            {
              "chapter": 27,
              "verse": 12,
              "name": "Exodo 27:12",
              "text": "At sa kaluwangan ng looban sa kalunuran ay magkakaroon ng mga tabing na may limangpung siko: ang haligi ng mga yaon ay sangpu at ang mga tungtungan ng mga yaon ay sangpu."
            },
            {
              "chapter": 27,
              "verse": 13,
              "name": "Exodo 27:13",
              "text": "At sa kaluwangan ng looban sa dakong silanganan, sa dakong sinisikatan ng araw, ay magkakaroon ng limangpung siko."
            },
            {
              "chapter": 27,
              "verse": 14,
              "name": "Exodo 27:14",
              "text": "Ang mga tabing sa isang dako ng pintuang-daan ay magkakaroon ng labinglimang siko: ang mga haligi ng mga yaon ay tatlo, at ang mga tungtungan ng mga yaon ay tatlo rin."
            },
            {
              "chapter": 27,
              "verse": 15,
              "name": "Exodo 27:15",
              "text": "At sa kabilang dako'y magkakaroon ng mga tabing na ma'y labing limang siko: ang mga haligi ng mga yao'y tatlo, at ang mga tungtungan ng mga yao'y tatlo."
            },
            {
              "chapter": 27,
              "verse": 16,
              "name": "Exodo 27:16",
              "text": "At sa pintuan ng looban ay magkakaroon ng isang tabing na may dalawang pung siko, na ang kayo'y bughaw, at kulay-ube, at pula, at kayong linong pinili, na yari ng mangbuburda: ang mga haligi ng mga yao'y apat, at ang mga tungtungan ng mga yao'y apat."
            },
            {
              "chapter": 27,
              "verse": 17,
              "name": "Exodo 27:17",
              "text": "Lahat ng haligi sa palibot ng looban ay pagsusugpungin ng mga pileteng pilak; ang mga sima ng mga yaon ay pilak, at ang mga tungtungan ng mga yaon ay tanso."
            },
            {
              "chapter": 27,
              "verse": 18,
              "name": "Exodo 27:18",
              "text": "Ang haba ng looban ay magkakaroon ng isang daang siko, at ang luwang ay limang pu magpasaan man, at ang taas ay limang siko, kayong linong pinili, at ang mga tuntungan ay tanso."
            },
            {
              "chapter": 27,
              "verse": 19,
              "name": "Exodo 27:19",
              "text": "Lahat ng mga kasangkapan ng tabernakulo, sa buong paglilingkod doon, at lahat ng mga tulos niyaon, at lahat ng mga tulos ng looban ay tanso."
            },
            {
              "chapter": 27,
              "verse": 20,
              "name": "Exodo 27:20",
              "text": "At iyong iuutos sa mga anak ni Israel na sila'y magdala sa iyo ng taganas na langis ng binayong oliba na pangilawan, upang papagningasing palagi ang ilawan."
            },
            {
              "chapter": 27,
              "verse": 21,
              "name": "Exodo 27:21",
              "text": "Sa tabernakulo ng kapisanan sa labas ng lambong na nasa harap ng kaban ng patotoo, ay aayusin yaon ni Aaron at ng kaniyang mga anak mula sa hapon hanggang sa umaga sa harap ng Panginoon: magiging palatuntunan sa buong panahon ng kanilang lahi sa ikagagaling ng mga anak ni Israel."
            }
          ]
        },
        {
          "chapter": 28,
          "name": "Exodo 28",
          "verses": [
            {
              "chapter": 28,
              "verse": 1,
              "name": "Exodo 28:1",
              "text": "At ilapit mo sa iyo si Aarong iyong kapatid at ang kaniyang mga anak na kasama niya, mula sa gitna ng mga anak ni Israel, upang makapangasiwa sa akin sa katungkulang saserdote, si Aaron, si Nadab at si Abiu, si Eleazar at si Ithamar, na mga anak ni Aaron."
            },
            {
              "chapter": 28,
              "verse": 2,
              "name": "Exodo 28:2",
              "text": "At igagawa mo ng mga banal na kasuutan si Aarong iyong kapatid sa ikaluluwalhati at ikagaganda."
            },
            {
              "chapter": 28,
              "verse": 3,
              "name": "Exodo 28:3",
              "text": "At iyong sasalitain sa lahat ng matalino, na aking pinagpupuspos ng diwa ng karunungan, na kanilang gawin ang kasuutan ni Aaron, upang siya'y italaga, na siya'y makapangasiwa sa akin sa katungkulang saserdote."
            },
            {
              "chapter": 28,
              "verse": 4,
              "name": "Exodo 28:4",
              "text": "At ito ang mga kasuutang kanilang gagawin; isang pektoral, at isang epod, at isang balabal, at isang tunika na tinahing guhitguhit na naaanyong pariparisukat, isang mitra at isang pamigkis: at kanilang igagawa ng mga banal na kasuutan si Aarong iyong kapatid, at ang kaniyang mga anak, upang makapangasiwa sa akin sa katungkulang saserdote."
            },
            {
              "chapter": 28,
              "verse": 5,
              "name": "Exodo 28:5",
              "text": "At kukuha sila ng ginto, at ng kayong bughaw, at ng kulay-ube, at ng pula, at ng lino."
            },
            {
              "chapter": 28,
              "verse": 6,
              "name": "Exodo 28:6",
              "text": "At kanilang gagawin ang epod na ginto, at kayong bughaw, at kulay-ube, pula, at linong pinili, na yari ng bihasang mangbuburda."
            },
            {
              "chapter": 28,
              "verse": 7,
              "name": "Exodo 28:7",
              "text": "Magkakaroon ng dalawang pangbalikat na nagkakasugpong sa dalawang dulo niyaon; upang magkasugpong."
            },
            {
              "chapter": 28,
              "verse": 8,
              "name": "Exodo 28:8",
              "text": "At ang mainam na pagkayaring pamigkis na nasa ibabaw ng epod upang ibigkis, ay gagawing gaya ng pagkayari ng epod at kaputol, na ginto, kayong bughaw, at kulay-ube, at pula, at linong pinili."
            },
            {
              "chapter": 28,
              "verse": 9,
              "name": "Exodo 28:9",
              "text": "At kukuha ka ng dalawang batong onix, at iyong iuukit na limbag sa ibabaw ng mga yaon ang mga pangalan ng mga anak ni Israel:"
            },
            {
              "chapter": 28,
              "verse": 10,
              "name": "Exodo 28:10",
              "text": "Anim sa kanilang mga pangalan ay sa isang bato, at ang mga pangalan ng anim na natitira ay sa isang bato, ayon sa kanilang kapanganakan."
            },
            {
              "chapter": 28,
              "verse": 11,
              "name": "Exodo 28:11",
              "text": "Nayari ng manguukit sa bato, na gaya ng ukit ng isang panatak, iyong iuukit sa dalawang bato, ayon sa mga pangalan ng mga anak ni Israel: iyong gagawing napamumutihan ng mga kalupkop na ginto."
            },
            {
              "chapter": 28,
              "verse": 12,
              "name": "Exodo 28:12",
              "text": "At iyong ilalagay ang dalawang bato sa ibabaw ng pangbalikat ng epod, upang maging mga batong pinakaalaala sa ikagagaling ng mga anak ni Israel: at papasanin ni Aaron ang kanilang mga pangalan sa harap ng Panginoon, sa ibabaw ng kaniyang dalawang balikat, na pinakaalaala."
            },
            {
              "chapter": 28,
              "verse": 13,
              "name": "Exodo 28:13",
              "text": "At gagawa ka ng mga kalupkop na ginto:"
            },
            {
              "chapter": 28,
              "verse": 14,
              "name": "Exodo 28:14",
              "text": "At ng dalawang tanikalang taganas na ginto; parang pisi iyong gagawin na yaring pinili: at iyong ilalapat sa mga kalupkop ang mga tanikalang pinili."
            },
            {
              "chapter": 28,
              "verse": 15,
              "name": "Exodo 28:15",
              "text": "At gagawin mo ang pektoral ng kahatulan, na gawa ng bihasang manggagawa; na gaya ng pagkayari ng epod iyong gagawin; gagawin mo na ginto, na bughaw, at kulay-ube, at pula, at linong pinili."
            },
            {
              "chapter": 28,
              "verse": 16,
              "name": "Exodo 28:16",
              "text": "Gagawing parisukat at nakatiklop; isang dangkal magkakaroon ang haba niyaon, at isang dangkal ang luwang niyaon."
            },
            {
              "chapter": 28,
              "verse": 17,
              "name": "Exodo 28:17",
              "text": "At iyong kakalupkupan ng mga kalupkop na mga bato, apat na hanay na bato: isang hanay na sardio, topacio, at karbungko ang magiging unang hanay;"
            },
            {
              "chapter": 28,
              "verse": 18,
              "name": "Exodo 28:18",
              "text": "At ang ikalawang hanay, ay isang esmeralda, isang zapiro, at isang diamante;"
            },
            {
              "chapter": 28,
              "verse": 19,
              "name": "Exodo 28:19",
              "text": "At ang ikatlong hanay ay isang hasinto, isang agata, at isang amatista;"
            },
            {
              "chapter": 28,
              "verse": 20,
              "name": "Exodo 28:20",
              "text": "At ang ikaapat na hanay ay isang berilo, isang onix, at isang haspe: pawang pamumutihan ng ginto sa kanilang mga kalupkop."
            },
            {
              "chapter": 28,
              "verse": 21,
              "name": "Exodo 28:21",
              "text": "At ang mga bato ay iaayos sa mga pangalan ng mga anak ni Israel; labingdalawa, ayon sa mga pangalan nila; gaya ng ukit ng isang panatak, bawa't isa'y ayon sa kanilang pangalan, na magiging ukol sa labing dalawang lipi."
            },
            {
              "chapter": 28,
              "verse": 22,
              "name": "Exodo 28:22",
              "text": "At gagawa ka sa ibabaw ng pektoral ng mga tanikalang parang pisi, yaring pinili, na taganas na ginto."
            },
            {
              "chapter": 28,
              "verse": 23,
              "name": "Exodo 28:23",
              "text": "At igagawa mo ang ibabaw ng pektoral ng dalawang singsing na ginto, at ilalagay mo ang dalawang singsing sa dalawang sulok ng itaas ng pektoral."
            },
            {
              "chapter": 28,
              "verse": 24,
              "name": "Exodo 28:24",
              "text": "At inyong ilalagay ang dalawang pinising tanikalang ginto sa dalawang singsing sa mga sulok ng pektoral."
            },
            {
              "chapter": 28,
              "verse": 25,
              "name": "Exodo 28:25",
              "text": "At ang dalawang dulo ng dalawang tanikala ng pinili ay iyong ilalapat sa dalawang kalupkop, at iyong mga ilalagay sa mga pangbalikat ng epod, sa harapan."
            },
            {
              "chapter": 28,
              "verse": 26,
              "name": "Exodo 28:26",
              "text": "At gagawa ka ng dalawang singsing na ginto, at mga ilalagay mo sa dalawang sulok ng pektoral sa laylayan niyaon na nasa dakong kabaligtaran ng epod."
            },
            {
              "chapter": 28,
              "verse": 27,
              "name": "Exodo 28:27",
              "text": "At gagawa ka ng dalawang singsing na ginto, at iyong mga ikakapit sa dalawang pangbalikat ng epod, sa dakong ibaba, sa harapan, na malapit sa pagkakasugpong sa ibabaw ng mainam na pagkayaring pamigkis ng epod."
            },
            {
              "chapter": 28,
              "verse": 28,
              "name": "Exodo 28:28",
              "text": "At kanilang itatali ang pektoral sa pamamagitan ng mga singsing niyaon sa mga singsing ng epod ng isang taling bughaw, upang mamalagi sa ibabaw ng mainam na pagkayaring pamigkis ng epod, at upang ang pektoral ay huwag makalag sa epod."
            },
            {
              "chapter": 28,
              "verse": 29,
              "name": "Exodo 28:29",
              "text": "At dadalhin ni Aaron sa kaniyang sinapupunan ang mga pangalan ng mga anak ni Israel na nasa pektoral ng kahatulan pagka siya'y pumapasok sa dakong banal, na pinakaalaala sa harap ng Panginoon, na palagi."
            },
            {
              "chapter": 28,
              "verse": 30,
              "name": "Exodo 28:30",
              "text": "At ilalagay mo sa pektoral ng kahatulan ang Urim at ang Tummim at mga ilalagay sa sinapupunan ni Aaron, pagka siya'y pumapasok sa harap ng Panginoon at dadalhing palagi ni Aaron sa harap ng Panginoon ang kahatulan sa mga anak ni Israel na nasa kaniyang sinapupunan."
            },
            {
              "chapter": 28,
              "verse": 31,
              "name": "Exodo 28:31",
              "text": "At gagawin mo ang balabal ng epod na taganas na bughaw."
            },
            {
              "chapter": 28,
              "verse": 32,
              "name": "Exodo 28:32",
              "text": "At magkakaroon ng isang pinakaleeg sa gitna niyaon: magkakaroon ito ng isang uriang tinahi sa palibot ng pinakaleeg, gaya ng butas ng isang koselete, upang huwag mapunit."
            },
            {
              "chapter": 28,
              "verse": 33,
              "name": "Exodo 28:33",
              "text": "At ang saya niyaon ay igagawa mo ng mga granadang bughaw, at kulay-ube, at pula, sa palibot ng saya niyaon; at ng mga kampanilyang ginto sa gitna ng mga yaon sa palibot:"
            },
            {
              "chapter": 28,
              "verse": 34,
              "name": "Exodo 28:34",
              "text": "Isang kampanilyang ginto at isang granada, isang kampanilyang ginto at isang granada sa saya sa ibaba ng balabal sa palibot."
            },
            {
              "chapter": 28,
              "verse": 35,
              "name": "Exodo 28:35",
              "text": "At isusuot ni Aaron upang mangasiwa: at ang tunog niyao'y maririnig pagka siya'y pumapasok sa dakong banal sa harap ng Panginoon, at pagka siya'y lumalabas, upang siya'y huwag mamatay."
            },
            {
              "chapter": 28,
              "verse": 36,
              "name": "Exodo 28:36",
              "text": "At gagawa ka ng isang laminang taganas na ginto, at doo'y isusulat mong ukit na ayon sa ukit ng isang panatak, Banal sa Panginoon."
            },
            {
              "chapter": 28,
              "verse": 37,
              "name": "Exodo 28:37",
              "text": "At iyong ilalagay sa isang listong bughaw, at malalagay sa ibabaw ng mitra; sa ibabaw ng harapan ng mitra malalagay."
            },
            {
              "chapter": 28,
              "verse": 38,
              "name": "Exodo 28:38",
              "text": "At malalagay sa noo ni Aaron, at dadalhin ni Aaron ang kasamaan ng mga banal na bagay, na pakakabanalin ng mga anak ni Israel sa lahat nilang mga banal na kaloob; at malalagay na palagi sa kaniyang noo, upang tanggapin sa harap ng Panginoon."
            },
            {
              "chapter": 28,
              "verse": 39,
              "name": "Exodo 28:39",
              "text": "At iyong hahabihin ang kasuutan na anyong parisukat, na lino, at iyong gagawin ang mitra na lino, at iyong gagawin ang pamigkis na yari ng mangbuburda."
            },
            {
              "chapter": 28,
              "verse": 40,
              "name": "Exodo 28:40",
              "text": "At iyong igagawa ang mga anak ni Aaron ng mga kasuutan, at iyong igagawa sila ng mga pamigkis, at iyong igagawa sila ng mga tiara sa ikaluluwalhati at ikagaganda."
            },
            {
              "chapter": 28,
              "verse": 41,
              "name": "Exodo 28:41",
              "text": "At iyong isusuot kay Aarong iyong kapatid at sa kaniyang mga anak na kasama niya; at iyong papahiran ng langis sila, at iyong itatalaga sila, at iyong papagbanalin sila, upang sila'y makapangasiwa sa akin, sa katungkulang saserdote."
            },
            {
              "chapter": 28,
              "verse": 42,
              "name": "Exodo 28:42",
              "text": "At iyong igagawa sila ng mga salawal na lino, upang takpan ang laman ng kanilang kahubaran; mula sa mga balakang hanggang sa mga hita aabot."
            },
            {
              "chapter": 28,
              "verse": 43,
              "name": "Exodo 28:43",
              "text": "At isusuot ni Aaron at ng kaniyang mga anak, pagka sila'y pumapasok sa tabernakulo ng kapisanan, o pagka sila'y lumalapit sa dambana upang mangasiwa sa dakong banal; upang sila'y huwag magdala ng kasamaan, at huwag mamatay: magiging isang palatuntunang walang hanggan sa kaniya at sa kaniyang binhi pagkamatay niya."
            }
          ]
        },
        {
          "chapter": 29,
          "name": "Exodo 29",
          "verses": [
            {
              "chapter": 29,
              "verse": 1,
              "name": "Exodo 29:1",
              "text": "At ito ang bagay na iyong gagawin sa kanila na ibukod sila, upang sila'y mangasiwa sa akin sa katungkulang saserdote: kumuha ka ng isang guyang toro at ng dalawang lalaking tupang walang kapintasan."
            },
            {
              "chapter": 29,
              "verse": 2,
              "name": "Exodo 29:2",
              "text": "At tinapay na walang lebadura, at mga munting tinapay na walang lebadura na hinaluan ng langis, at mga manipis na tinapay na walang lebadura na pinahiran ng langis: na gagawin mo sa mainam na harina ng trigo."
            },
            {
              "chapter": 29,
              "verse": 3,
              "name": "Exodo 29:3",
              "text": "At iyong isisilid sa isang bakol, at dadalhin mo na nasa bakol, sangpu ng toro at ng dalawang tupang lalake."
            },
            {
              "chapter": 29,
              "verse": 4,
              "name": "Exodo 29:4",
              "text": "At si Aaron at ang kaniyang mga anak ay iyong dadalhin sa pintuan ng tabernakulo ng kapisanan, at iyong huhugasan sila ng tubig."
            },
            {
              "chapter": 29,
              "verse": 5,
              "name": "Exodo 29:5",
              "text": "At iyong kukunin ang mga kasuutan, at iyong isusuot kay Aaron ang tunika niya, at ang balabal ng epod, at ang epod, at ang pektoral, at bibigkisan mo ng mainam na pagkayaring pamigkis ng epod:"
            },
            {
              "chapter": 29,
              "verse": 6,
              "name": "Exodo 29:6",
              "text": "At iyong ipuputong ang mitra sa kaniyang ulo, at ipapatong mo ang banal na korona sa mitra."
            },
            {
              "chapter": 29,
              "verse": 7,
              "name": "Exodo 29:7",
              "text": "Saka mo kukunin ang langis na pangpahid, at ibubuhos mo sa ibabaw ng kaniyang ulo, at papahiran mo ng langis siya."
            },
            {
              "chapter": 29,
              "verse": 8,
              "name": "Exodo 29:8",
              "text": "At iyong dadalhin ang kaniyang mga anak, at susuutan mo ng mga tunika sila."
            },
            {
              "chapter": 29,
              "verse": 9,
              "name": "Exodo 29:9",
              "text": "At iyong bibigkisan sila ng mga pamigkis, si Aaron at ang kaniyang mga anak, at itatali mo ang mga tiara sa kanikaniyang ulo: at tatamuhin nila ang pagkasaserdote na pinakapalatuntunang palagi: at iyong papagbabanalin si Aaron at ang kaniyang mga anak."
            },
            {
              "chapter": 29,
              "verse": 10,
              "name": "Exodo 29:10",
              "text": "At iyong dadalhin ang toro sa harap ng tabernakulo ng kapisanan: at ipapatong ni Aaron at ng kaniyang mga anak ang kanilang kamay sa ulo ng toro."
            },
            {
              "chapter": 29,
              "verse": 11,
              "name": "Exodo 29:11",
              "text": "At iyong papatayin ang toro sa harap ng Panginoon, sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 29,
              "verse": 12,
              "name": "Exodo 29:12",
              "text": "At kukuha ka ng dugo ng toro, at ilalagay mo ng iyong daliri sa ibabaw ng mga anyong sungay ng dambana; at iyong ibubuhos ang lahat ng dugo sa paanan ng dambana."
            },
            {
              "chapter": 29,
              "verse": 13,
              "name": "Exodo 29:13",
              "text": "At kukunin mo ang buong taba na nakababalot sa bituka, at ang mga lamak ng atay, at ang dalawang bato, at ang taba na nasa ibabaw ng mga yaon, at susunugin mo sa ibabaw ng dambana."
            },
            {
              "chapter": 29,
              "verse": 14,
              "name": "Exodo 29:14",
              "text": "Datapuwa't ang laman ng toro, at ang balat, at ang dumi ay iyong susunugin sa apoy sa labas ng kampamento: handog nga dahil sa kasalanan."
            },
            {
              "chapter": 29,
              "verse": 15,
              "name": "Exodo 29:15",
              "text": "Kukunin mo rin ang isang lalaking tupa; at ipapatong ni Aaron at ng kaniyang mga anak ang kanilang kamay sa ulo ng lalaking tupa."
            },
            {
              "chapter": 29,
              "verse": 16,
              "name": "Exodo 29:16",
              "text": "At iyong papatayin ang lalaking tupa, at iyong kukunin ang dugo, at iyong iwiwisik sa palibot sa ibabaw ng dambana."
            },
            {
              "chapter": 29,
              "verse": 17,
              "name": "Exodo 29:17",
              "text": "At iyong kakatayin ang tupa at huhugasan mo ang bituka, at ang mga hita, at ipapatong mo sa mga pinagputolputol at sa ulo."
            },
            {
              "chapter": 29,
              "verse": 18,
              "name": "Exodo 29:18",
              "text": "At iyong susunugin ang buong tupa sa ibabaw ng dambana: handog na susunugin nga sa Panginoon; pinaka masarap na amoy na handog sa Panginoon, na pinaraan sa apoy."
            },
            {
              "chapter": 29,
              "verse": 19,
              "name": "Exodo 29:19",
              "text": "At kukunin mo ang isang tupa; at ipapatong ni Aaron at ng kaniyang mga anak ang kanilang kamay sa ulo ng tupa."
            },
            {
              "chapter": 29,
              "verse": 20,
              "name": "Exodo 29:20",
              "text": "Saka mo papatayin ang tupa, at kukunin mo ang dugo, at ilalagay mo sa pingol ng kanang tainga ni Aaron, at sa pingol ng kanang tainga ng kaniyang mga anak, at sa hinlalaki ng kanilang kanang kamay, at sa hinlalaki ng kanilang kanang paa, at iwiwisik mo ang dugong labis sa ibabaw ng dambana sa palibot."
            },
            {
              "chapter": 29,
              "verse": 21,
              "name": "Exodo 29:21",
              "text": "At kukuha ka ng dugo na nasa ibabaw ng dambana, at ng langis na pangpahid, at iwiwisik mo kay Aaron, at sa kaniyang mga suot, at sa kaniyang mga anak na kasama niya: at ikapapaging banal niya at ng kaniyang mga suot, at ng kaniyang mga anak, at ng mga suot ng kaniyang mga anak na kasama niya."
            },
            {
              "chapter": 29,
              "verse": 22,
              "name": "Exodo 29:22",
              "text": "Kukunin mo rin naman sa lalaking tupa ang taba, at ang matabang buntot, at ang tabang nakababalot sa mga bituka, at ang mga lamak ng atay, at ang dalawang bato, at ang taba na nasa ibabaw ng mga yaon, at ang kanang hita (sapagka't isang lalaking tupa na itinalaga),"
            },
            {
              "chapter": 29,
              "verse": 23,
              "name": "Exodo 29:23",
              "text": "At isang malaking tinapay, at isang munting tinapay na nilangisan, at isang manipis na tinapay sa bakol ng tinapay na walang lebadura na nasa harap ng Panginoon:"
            },
            {
              "chapter": 29,
              "verse": 24,
              "name": "Exodo 29:24",
              "text": "At iyong ilalagay ang kabuoan sa mga kamay ni Aaron, at sa mga kamay ng kaniyang mga anak; at iyong mga luluglugin na pinakahandog na niluglog sa harap ng Panginoon."
            },
            {
              "chapter": 29,
              "verse": 25,
              "name": "Exodo 29:25",
              "text": "At iyong kukunin sa kanilang mga kamay, at iyong susunugin sa dambana sa ibabaw ng handog na susunugin, na pinaka masarap na amoy sa harap ng Panginoon: handog nga sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 29,
              "verse": 26,
              "name": "Exodo 29:26",
              "text": "At kukunin mo ang dibdib ng tupa na itinalaga ni Aaron, at luglugin mo na pinakahandog na niluglog sa harap ng Panginoon: at magiging iyong bahagi."
            },
            {
              "chapter": 29,
              "verse": 27,
              "name": "Exodo 29:27",
              "text": "At iyong ihihiwalay ang dibdib ng handog na niluglog, at ang hita ng handog na itinaas, ang niluglog at ang itinaas, ng lalaking tupa na itinalaga na kay Aaron at sa kaniyang mga anak;"
            },
            {
              "chapter": 29,
              "verse": 28,
              "name": "Exodo 29:28",
              "text": "At magiging kay Aaron at sa kaniyang mga anak, na pinaka bahagi magpakailan man, na mula sa mga anak ni Israel: sapagka't isang handog na itinaas: at magiging isang handog na itinaas sa ganang mga anak ni Israel, na kinuha sa kanilang mga hain tungkol sa kapayapaan: na dili iba't kanilang handog ngang itinaas sa Panginoon."
            },
            {
              "chapter": 29,
              "verse": 29,
              "name": "Exodo 29:29",
              "text": "At ang mga banal na kasuutan ni Aaron ay magiging sa kaniyang mga anak, pagkamatay niya, upang pahiran ng langis sa mga yaon, at upang italaga sa mga yaon."
            },
            {
              "chapter": 29,
              "verse": 30,
              "name": "Exodo 29:30",
              "text": "Pitong araw na isusuot ng anak na magiging saserdote nakahalili niya, pagka siya'y pumapasok sa tabernakulo ng kapisanan upang mangasiwa sa dakong banal."
            },
            {
              "chapter": 29,
              "verse": 31,
              "name": "Exodo 29:31",
              "text": "At kukunin mo ang lalaking tupa na itinalaga at lulutuin mo ang kaniyang laman sa dakong banal."
            },
            {
              "chapter": 29,
              "verse": 32,
              "name": "Exodo 29:32",
              "text": "At kakanin ni Aaron at ng kaniyang mga anak ang laman ng tupa, at ang tinapay na nasa bakol sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 29,
              "verse": 33,
              "name": "Exodo 29:33",
              "text": "At kanilang kakanin ang mga bagay na yaon, na ipinangtubos ng sala, upang italaga at pakabanalin sila: datapuwa't hindi kakain niyaon ang sinomang taga ibang lupa, sapagka't mga bagay na banal."
            },
            {
              "chapter": 29,
              "verse": 34,
              "name": "Exodo 29:34",
              "text": "At kung may lumabis sa laman na itinalaga, o sa tinapay, hanggang sa kinaumagahan, ay iyo ngang susunugin sa apoy ang labis: hindi kakanin, sapagka't yao'y banal."
            },
            {
              "chapter": 29,
              "verse": 35,
              "name": "Exodo 29:35",
              "text": "At ganito mo gagawin kay Aaron, at sa kaniyang mga anak, ayon sa lahat na aking iniutos sa iyo: pitong araw na iyong itatalaga sila."
            },
            {
              "chapter": 29,
              "verse": 36,
              "name": "Exodo 29:36",
              "text": "At araw-araw ay maghahandog ka ng toro na pinakahandog, dahil sa kasalanan na pinakapangtubos: at iyong lilinisin ang dambana pagka iyong ipinanggagawa ng katubusan yaon; at iyong papahiran ng langis upang pakabanalin."
            },
            {
              "chapter": 29,
              "verse": 37,
              "name": "Exodo 29:37",
              "text": "Pitong araw na iyong tutubusin sa sala ang dambana, at iyong pakakabanalin; at ang dambana ay magiging kabanalbanalan; anomang masagi sa dambana ay magiging banal."
            },
            {
              "chapter": 29,
              "verse": 38,
              "name": "Exodo 29:38",
              "text": "Ito nga ang iyong ihahandog sa ibabaw ng dambana: dalawang kordero ng unang taon araw-araw na palagi."
            },
            {
              "chapter": 29,
              "verse": 39,
              "name": "Exodo 29:39",
              "text": "Ang isang kordero ay iyong ihahandog sa umaga; at ang isang kordero ay iyong ihahandog sa hapon:"
            },
            {
              "chapter": 29,
              "verse": 40,
              "name": "Exodo 29:40",
              "text": "At kasama ng isang kordero na iyong ihahandog ang ikasangpung bahagi ng isang efa ng mainam na harina na may halong ikaapat na bahagi ng isang hin ng langis na hinalo; at ang ikaapat na bahagi ng isang hin na alak, ay pinakahandog na inumin."
            },
            {
              "chapter": 29,
              "verse": 41,
              "name": "Exodo 29:41",
              "text": "At ang isang kordero ay iyong ihahandog sa hapon, at iyong gagawin ayon sa handog na harina sa umaga, at ayon sa inuming handog niyaon, na pinaka masarap na amoy, na handog nga sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 29,
              "verse": 42,
              "name": "Exodo 29:42",
              "text": "Magiging isang palaging handog na susunugin sa buong panahon ng inyong lahi sa pintuan ng tabernakulo ng kapisanan, sa harap ng Panginoon; na aking pakikipagkitaan sa inyo, upang makipagusap ako roon sa iyo."
            },
            {
              "chapter": 29,
              "verse": 43,
              "name": "Exodo 29:43",
              "text": "At doo'y makikipagtagpo ako sa mga anak ni Israel: at ang Tolda ay pakakabanalin sa pamamagitan ng aking kaluwalhatian."
            },
            {
              "chapter": 29,
              "verse": 44,
              "name": "Exodo 29:44",
              "text": "At aking pakakabanalin ang tabernakulo ng kapisanan, at ang dambana; si Aaron man at ang kaniyang mga anak ay aking papagbabanalin upang mangasiwa sa akin sa katungkulang saserdote."
            },
            {
              "chapter": 29,
              "verse": 45,
              "name": "Exodo 29:45",
              "text": "At ako'y tatahan sa gitna ng mga anak ni Israel, at ako'y magiging kanilang Dios."
            },
            {
              "chapter": 29,
              "verse": 46,
              "name": "Exodo 29:46",
              "text": "At kanilang makikilala, na ako ang Panginoon nilang Dios, na kumuha sa kanila sa lupain ng Egipto, upang ako'y tumahan sa gitna nila: ako ang Panginoon nilang Dios."
            }
          ]
        },
        {
          "chapter": 30,
          "name": "Exodo 30",
          "verses": [
            {
              "chapter": 30,
              "verse": 1,
              "name": "Exodo 30:1",
              "text": "At gagawa ka ng isang dambana na mapagsusunugan ng kamangyan: na kahoy na akasia iyong gagawin."
            },
            {
              "chapter": 30,
              "verse": 2,
              "name": "Exodo 30:2",
              "text": "Isang siko magkakaroon ang haba niyaon, at isang siko ang luwang niyaon; parisukat nga: at dalawang siko magkakaroon ang taas niyaon: ang mga anyong sungay niyaon ay kaputol din."
            },
            {
              "chapter": 30,
              "verse": 3,
              "name": "Exodo 30:3",
              "text": "At iyong babalutin ng taganas na ginto ang ibabaw niyaon, at ang mga tagiliran niyaon sa palibot, at ang mga sungay niyaon; at igagawa mo ng isang kornisang ginto sa palibot."
            },
            {
              "chapter": 30,
              "verse": 4,
              "name": "Exodo 30:4",
              "text": "At igagawa mo yaon ng dalawang argolyang ginto sa ilalim ng kornisa, sa dakong itaas ng dalawang tagiliran iyong gagawin; at magiging suutan ng mga pingga upang mabuhat."
            },
            {
              "chapter": 30,
              "verse": 5,
              "name": "Exodo 30:5",
              "text": "At ang iyong gagawing mga pingga ay kahoy na akasia, at iyong babalutin ng ginto."
            },
            {
              "chapter": 30,
              "verse": 6,
              "name": "Exodo 30:6",
              "text": "At iyong ilalagay sa harap ng tabing na nasa siping ng kaban ng patotoo, sa harap ng luklukan ng awa na nasa ibabaw ng kaban ng patotoo, na aking pakikipagtagpuan sa iyo."
            },
            {
              "chapter": 30,
              "verse": 7,
              "name": "Exodo 30:7",
              "text": "At magsusunog si Aaron sa ibabaw niyaon ng kamangyan na mababangong espesia: tuwing umaga pagka kaniyang inaayos ang mga ilawan, ay susunugin niya."
            },
            {
              "chapter": 30,
              "verse": 8,
              "name": "Exodo 30:8",
              "text": "At pagka sinisindihan ni Aaron ang mga ilawan sa hapon, ay kaniyang susunugin, na isang kamangyang palagi sa harap ng Panginoon, sa buong panahon ng inyong mga lahi."
            },
            {
              "chapter": 30,
              "verse": 9,
              "name": "Exodo 30:9",
              "text": "Huwag kayong maghahandog ng ibang kamangyan sa ibabaw niyaon, o ng handog na susunugin, o ng handog na harina man: at huwag kayong magbubuhos ng inuming handog sa ibabaw niyaon."
            },
            {
              "chapter": 30,
              "verse": 10,
              "name": "Exodo 30:10",
              "text": "At si Aaron ay tutubos ng sala sa ibabaw ng mga anyong sungay ng dambana, minsan sa isang taon: kaniyang tutubusin sa sala na minsan sa isang taon, ng dugo ng handog dahil sa kasalanan, sa buong panahon ng inyong mga lahi: kabanal-banalan nga sa Panginoon."
            },
            {
              "chapter": 30,
              "verse": 11,
              "name": "Exodo 30:11",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 30,
              "verse": 12,
              "name": "Exodo 30:12",
              "text": "Pagbilang mo sa mga anak ni Israel, ayon sa mga nabilang sa kanila ay magbibigay nga ang bawa't isa sa kanila ng katubusan ng kaniyang kaluluwa sa Panginoon, pagka iyong binibilang sila; upang huwag magkaroon ng salot sa gitna nila pagka iyong binibilang sila."
            },
            {
              "chapter": 30,
              "verse": 13,
              "name": "Exodo 30:13",
              "text": "Ito ang kanilang ibibigay, bawa't maraanan sa kanila na nangabibilang: kalahati ng isang siklo ayon sa siklo ng santuario: (ang isang siklo ay dalawang pung gera): kalahating siklo na pinakahandog sa Panginoon."
            },
            {
              "chapter": 30,
              "verse": 14,
              "name": "Exodo 30:14",
              "text": "Bawa't maraanan sa kanila na nangabibilang, mula sa dalawang pung taong gulang na patanda, ay magbibigay ng handog sa Panginoon."
            },
            {
              "chapter": 30,
              "verse": 15,
              "name": "Exodo 30:15",
              "text": "Ang mayaman ay hindi magbibigay ng higit, at ang dukha ay hindi magbibigay ng kulang sa kalahating siklo, pagbibigay nila ng handog sa Panginoon, upang ipangtubos sa inyong mga kaluluwa."
            },
            {
              "chapter": 30,
              "verse": 16,
              "name": "Exodo 30:16",
              "text": "At iyong kukunin sa mga anak ni Israel ang pangtubos na salapi, at iyong gugugulin sa paglilingkod sa tabernakulo ng kapisanan; na maging pinakaalaala sa mga anak ni Israel sa harap ng Panginoon, upang ipangtubos sa inyong mga kaluluwa."
            },
            {
              "chapter": 30,
              "verse": 17,
              "name": "Exodo 30:17",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 30,
              "verse": 18,
              "name": "Exodo 30:18",
              "text": "Gagawa ka rin ng isang hugasang tanso, at ang tungtungan ay tanso, upang paghugasan: at iyong ilalagay sa gitna ng tabernakulo ng kapisanan at ng dambana at iyong sisidlan ng tubig."
            },
            {
              "chapter": 30,
              "verse": 19,
              "name": "Exodo 30:19",
              "text": "At si Aaron at ang kaniyang mga anak ay maghuhugas doon ng kanilang mga paa:"
            },
            {
              "chapter": 30,
              "verse": 20,
              "name": "Exodo 30:20",
              "text": "Pagka sila'y pumapasok sa tabernakulo ng kapisanan, ay maghuhugas sila ng tubig, upang sila'y huwag mamatay, o pagka sila'y lumalapit sa dambana na mangasiwa, upang magsunog ng handog na pinaraan sa apoy sa Panginoon."
            },
            {
              "chapter": 30,
              "verse": 21,
              "name": "Exodo 30:21",
              "text": "Gayon sila maghuhugas ng kanilang mga kamay at ng kanilang mga paa upang huwag silang mamatay: at magiging isang palatuntunan magpakailan man sa kanila, sa kaniya at sa kaniyang binhi, sa buong panahon ng kanilang mga lahi."
            },
            {
              "chapter": 30,
              "verse": 22,
              "name": "Exodo 30:22",
              "text": "Bukod dito'y nagsalita ang Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 30,
              "verse": 23,
              "name": "Exodo 30:23",
              "text": "Magdala ka rin ng mga pinakamagaling na espesia, ng taganas na mira ay limang daang siklo, at ng mabangong kanela ay kalahati nito, dalawang daan at limang pu; at ng mabangong kalamo ay dalawang daan at limang pu,"
            },
            {
              "chapter": 30,
              "verse": 24,
              "name": "Exodo 30:24",
              "text": "At ng kasia, limang daan, ayon sa siklo ng santuario, at ng langis ng oliva ay isang hin:"
            },
            {
              "chapter": 30,
              "verse": 25,
              "name": "Exodo 30:25",
              "text": "At iyong gagawing banal na langis na pangpahid, isang pabangong kinatha ng ayon sa katha ng manggagawa ng pabango: siya ngang magiging banal na langis na pangpahid."
            },
            {
              "chapter": 30,
              "verse": 26,
              "name": "Exodo 30:26",
              "text": "At iyong papahiran niyaon ang tabernakulo ng kapisanan, at ang kaban ng patotoo,"
            },
            {
              "chapter": 30,
              "verse": 27,
              "name": "Exodo 30:27",
              "text": "At ang dulang, at ang lahat ng mga kasangkapan niyaon, at ang kandelero at ang mga kasangkapan niyaon, at ang dambanang suuban."
            },
            {
              "chapter": 30,
              "verse": 28,
              "name": "Exodo 30:28",
              "text": "At ang dambana ng handog na susunugin sangpu ng lahat ng mga kasangkapan, at ang hugasan at ang tungtungan."
            },
            {
              "chapter": 30,
              "verse": 29,
              "name": "Exodo 30:29",
              "text": "At pakabanalin mo upang maging mga kabanalbanalan: lahat ng makahipo sa mga yao'y magiging banal."
            },
            {
              "chapter": 30,
              "verse": 30,
              "name": "Exodo 30:30",
              "text": "At iyong papahiran ng langis si Aaron at ang kaniyang mga anak, at iyong papagbabanalin sila, upang sila'y mangasiwa sa akin sa katungkulang saserdote."
            },
            {
              "chapter": 30,
              "verse": 31,
              "name": "Exodo 30:31",
              "text": "At iyong sasalitain sa mga anak ni Israel, na iyong sasabihin, Ito'y magiging banal na langis na pangpahid sa akin sa buong panahon ng iyong mga lahi."
            },
            {
              "chapter": 30,
              "verse": 32,
              "name": "Exodo 30:32",
              "text": "Sa laman ng tao ay huwag ninyong ibubuhos, ni huwag kayong gagawa ng gaya niyan sa pagkakatha: banal nga at aariin ninyong banal."
            },
            {
              "chapter": 30,
              "verse": 33,
              "name": "Exodo 30:33",
              "text": "Sinomang kumatha ng gaya niyan, o sinomang gumamit niyan sa isang taga ibang lupa, ay ihihiwalay sa kaniyang bayan."
            },
            {
              "chapter": 30,
              "verse": 34,
              "name": "Exodo 30:34",
              "text": "At sinabi ng Panginoon kay Moises, Magdala ka ng mababangong espesia, estacte, at onycha, at galbano; mabangong espesia na may taganas na kamangyan: na magkakaisa ng timbang;"
            },
            {
              "chapter": 30,
              "verse": 35,
              "name": "Exodo 30:35",
              "text": "At iyong gagawing kamangyan, na isang pabangong ayon sa katha ng manggagawa ng pabango, na tinimplahan ng asin, na pulos at banal;"
            },
            {
              "chapter": 30,
              "verse": 36,
              "name": "Exodo 30:36",
              "text": "At iyong didikdikin ang iba niyan ng durog na durog at ilalagay mo sa harap ng kaban ng patotoo, sa loob ng tabernakulo ng kapisanan na aking pakikipagtagpuan sa iyo: aariin ninyong kabanalbanalan."
            },
            {
              "chapter": 30,
              "verse": 37,
              "name": "Exodo 30:37",
              "text": "At ang kamangyan na inyong gagawin, ayon sa pagkakatha niyan ay huwag ninyong gagawin para sa inyo: aariin mong banal sa Panginoon."
            },
            {
              "chapter": 30,
              "verse": 38,
              "name": "Exodo 30:38",
              "text": "Sinomang gumawa ng gaya niyan, upang amuyin ay ihihiwalay sa kaniyang bayan."
            }
          ]
        },
        {
          "chapter": 31,
          "name": "Exodo 31",
          "verses": [
            {
              "chapter": 31,
              "verse": 1,
              "name": "Exodo 31:1",
              "text": "At ang Panginoon ay nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 31,
              "verse": 2,
              "name": "Exodo 31:2",
              "text": "Tingnan mo aking tinawag sa pangalan si Bezaleel na anak ni Uri, na anak ni Hur, sa lipi ni Juda:"
            },
            {
              "chapter": 31,
              "verse": 3,
              "name": "Exodo 31:3",
              "text": "At aking pinuspos siya ng Espiritu ng Dios, sa karunungan at pagkakilala, at kaalaman, at sa lahat ng sarisaring gawain,"
            },
            {
              "chapter": 31,
              "verse": 4,
              "name": "Exodo 31:4",
              "text": "Upang kumatha ng mga gawang kaayaaya, upang gumawa sa ginto, at sa pilak, at sa tanso,"
            },
            {
              "chapter": 31,
              "verse": 5,
              "name": "Exodo 31:5",
              "text": "At upang umukit ng mga batong pangkalupkop, upang gumawa ng mga nililok na kahoy, at upang gumawa sa lahat na sarisaring gawain."
            },
            {
              "chapter": 31,
              "verse": 6,
              "name": "Exodo 31:6",
              "text": "At ako, narito, aking inihalal na kasama niya si Aholiab, na anak ni Ahisamac sa lipi ni Dan; at sa puso ng lahat na maalam na puso, ay aking isinilid ang karunungan, upang magawa nila ang lahat ng aking iniutos sa iyo:"
            },
            {
              "chapter": 31,
              "verse": 7,
              "name": "Exodo 31:7",
              "text": "Ang tabernakulo ng kapisanan at ang kaban ng patotoo, at ang luklukan ng awa na nasa ibabaw niyaon, at ang lahat ng kasangkapan ng Tolda:"
            },
            {
              "chapter": 31,
              "verse": 8,
              "name": "Exodo 31:8",
              "text": "At ang dulang at ang mga sisidlan niyaon at ang kandelerong dalisay, sangpu ng lahat na mga sisidlan; at ang dambana ng kamangyan;"
            },
            {
              "chapter": 31,
              "verse": 9,
              "name": "Exodo 31:9",
              "text": "At ang dambana ng handog na susunugin sangpu ng lahat ng mga sisidlan niyaon, at ang hugasan at ang tungtungan niyaon;"
            },
            {
              "chapter": 31,
              "verse": 10,
              "name": "Exodo 31:10",
              "text": "At ang mga kasuutang mabuting yari, at ang mga banal na kasuutan na pangsuot kay Aarong saserdote, at ang mga kasuutan sa kaniyang mga anak, upang mangasiwa sa katungkulang saserdote;"
            },
            {
              "chapter": 31,
              "verse": 11,
              "name": "Exodo 31:11",
              "text": "At ang langis na pangpahid, at ang kamangyan na mabangong mga kamangyan na itataan sa dakong banal: ayon sa lahat na iniutos ko sa iyo ay kanilang gagawin."
            },
            {
              "chapter": 31,
              "verse": 12,
              "name": "Exodo 31:12",
              "text": "At ang Panginoo'y nagsalita kay Moises, na sinasabi,"
            },
            {
              "chapter": 31,
              "verse": 13,
              "name": "Exodo 31:13",
              "text": "Salitain mo rin sa mga anak ni Israel, na iyong sabihin, Katotohanang ipangingilin ninyo ang aking mga sabbath; sapagka't isang tanda sa akin at sa inyo sa buong panahon ng inyong mga lahi, upang inyong makilala na ako ang Panginoon na nagpapabanal sa inyo."
            },
            {
              "chapter": 31,
              "verse": 14,
              "name": "Exodo 31:14",
              "text": "Inyong ipangingilin ang sabbath nga; sapagka't yao'y pangilin sa inyo: bawa't lumapastangan ay walang pagsalang papatayin: sapagka't sinomang gumawa ng anomang gawa sa araw na yaon, ay ihihiwalay ang taong yaon sa kaniyang bayan."
            },
            {
              "chapter": 31,
              "verse": 15,
              "name": "Exodo 31:15",
              "text": "Anim na araw na gagawin ang gawain; datapuwa't ang ikapitong araw ay sabbath na takdang kapahingahan, pangilin sa Panginoon: sinomang gumawa ng anomang gawa sa araw ng sabbath, ay walang pagsalang papatayin."
            },
            {
              "chapter": 31,
              "verse": 16,
              "name": "Exodo 31:16",
              "text": "Kaya't ang mga anak ni Israel ay mangingilin ng sabbath, na tutuparin ang sabbath sa buong panahon ng kanilang mga lahi, na pinakapalaging tipan."
            },
            {
              "chapter": 31,
              "verse": 17,
              "name": "Exodo 31:17",
              "text": "Ito'y isang tanda sa akin at sa mga anak ni Israel magpakailan man: sapagka't sa anim na araw ay ginawa ng Panginoon ang langit at lupa, at sa ikapitong araw, ay nagpahinga at naginhawahan."
            },
            {
              "chapter": 31,
              "verse": 18,
              "name": "Exodo 31:18",
              "text": "At kaniyang ibinigay kay Moises, pagkatapos na makipagsalitaan sa kaniya sa ibabaw ng bundok ng Sinai, ang dalawang tapyas ng patotoo, na mga tapyas na bato, na sinulatan ng daliri ng Dios."
            }
          ]
        },
        {
          "chapter": 32,
          "name": "Exodo 32",
          "verses": [
            {
              "chapter": 32,
              "verse": 1,
              "name": "Exodo 32:1",
              "text": "At nang makita ng bayan na nagluluwat si Moises ng pagpanaog sa bundok, ay nagpipisan ang bayan kay Aaron, at nagsabi sa kaniya, Tumindig ka at igawa mo kami ng mga dios na mangunguna sa amin; sapagka't tungkol sa Moises na ito, na lalaking nagsampa sa amin mula sa lupain ng Egipto, ay hindi namin maalaman kung anong nangyari sa kaniya."
            },
            {
              "chapter": 32,
              "verse": 2,
              "name": "Exodo 32:2",
              "text": "At sinabi ni Aaron sa kanila, Alisin ninyo ang mga hikaw na ginto, na nasa tainga ng inyo-inyong asawa, ng inyong mga anak na lalake, at babae, at dalhin ninyo sa akin."
            },
            {
              "chapter": 32,
              "verse": 3,
              "name": "Exodo 32:3",
              "text": "At inalis ng buong bayan ang mga hikaw na ginto na nangasa kanilang mga tainga, at dinala kay Aaron."
            },
            {
              "chapter": 32,
              "verse": 4,
              "name": "Exodo 32:4",
              "text": "At kaniyang tinanggap sa kanilang kamay, at niyari sa pamamagitan ng isang buril, at ginawang isang guyang binubo, at kanilang sinabi, Ang mga ito ang maging iyong mga dios, Oh Israel, na nagsampa sa iyo mula sa lupain ng Egipto."
            },
            {
              "chapter": 32,
              "verse": 5,
              "name": "Exodo 32:5",
              "text": "At nang makita ito ni Aaron, ay nagtayo siya ng isang dambana sa harapan niyaon: at itinanyag ni Aaron at sinabi, Bukas ay pista sa Panginoon."
            },
            {
              "chapter": 32,
              "verse": 6,
              "name": "Exodo 32:6",
              "text": "At sila'y bumangong maaga nang kinabukasan, at naghandog ng mga handog na susunugin, at nagdala ng mga handog tungkol sa kapayapaan; at ang bayan ay umupong kumain at uminom, at tumindig upang magkatuwa."
            },
            {
              "chapter": 32,
              "verse": 7,
              "name": "Exodo 32:7",
              "text": "At sinalita ng Panginoon kay Moises, Yumaon ka, bumaba ka, sapagka't ang iyong bayan, na iyong isinampa mula sa lupain ng Egipto ay nangagsisama:"
            },
            {
              "chapter": 32,
              "verse": 8,
              "name": "Exodo 32:8",
              "text": "Sila'y humiwalay na madali sa daan na aking iniutos sa kanila: sila'y gumawa ng isang guyang binubo, at kanilang sinamba, at kanilang hinainan, at kanilang sinabi, Ang mga ito'y iyong maging mga dios, Oh Israel, na nagsampa sa iyo mula sa lupain ng Egipto."
            },
            {
              "chapter": 32,
              "verse": 9,
              "name": "Exodo 32:9",
              "text": "At sinabi ng Panginoon kay Moises, Aking nakita ang bayang ito, at, narito, isang bayang may matigas na ulo;"
            },
            {
              "chapter": 32,
              "verse": 10,
              "name": "Exodo 32:10",
              "text": "Ngayo'y bayaan mo nga ako upang ang aking pagiinit ay magalab laban sa kanila, at upang aking lipulin sila: at ikaw ay aking gagawing dakilang bansa."
            },
            {
              "chapter": 32,
              "verse": 11,
              "name": "Exodo 32:11",
              "text": "At dumalangin si Moises sa Panginoon niyang Dios, at sinabi, Panginoon, bakit ang iyong pagiinit ay pinapagaalab mo laban sa iyong bayan, na iyong inilabas sa lupain ng Egipto sa pamamagitan ng dakilang kapangyarihan at ng makapangyarihang kamay?"
            },
            {
              "chapter": 32,
              "verse": 12,
              "name": "Exodo 32:12",
              "text": "Bakit sasalitain ng mga Egipcio, na sasabihin, Dahil sa kasamaan, inilabas sila upang patayin sila sa mga bundok, at upang lipulin sila sa balat ng lupa? Iurong mo ang iyong mabangis na pagiinit, at pagsisihan mo ang kasamaang ito laban sa iyong bayan."
            },
            {
              "chapter": 32,
              "verse": 13,
              "name": "Exodo 32:13",
              "text": "Alalahanin mo si Abraham, si Isaac, at si Israel na iyong mga lingkod, na silang iyong mga sinumpaan sa iyong sarili, at mga pinagsabihan, Aking pararamihin ang inyong binhi na gaya ng mga bituin sa langit, at lahat ng lupaing ito na aking sinalita ay aking ibibigay sa inyong binhi, at kanilang mamanahin magpakailan man."
            },
            {
              "chapter": 32,
              "verse": 14,
              "name": "Exodo 32:14",
              "text": "At pinagsisihan ng Panginoon ang kasamaan na kaniyang sinabing kaniyang gagawin sa kaniyang bayan."
            },
            {
              "chapter": 32,
              "verse": 15,
              "name": "Exodo 32:15",
              "text": "At si Moises ay pumihit, at bumaba sa bundok, na dala ang dalawang tapyas ng patotoo sa kaniyang kamay; mga tapyas na may sulat sa dalawang mukha niyaon; sa isang mukha at sa kabilang mukha ay may sulat."
            },
            {
              "chapter": 32,
              "verse": 16,
              "name": "Exodo 32:16",
              "text": "At ang mga tapyas ay gawa ng Dios, at ang sulat ay sulat ng Dios, na nakaukit sa mga tapyas."
            },
            {
              "chapter": 32,
              "verse": 17,
              "name": "Exodo 32:17",
              "text": "At ng marinig ni Josue ang ingay ng bayan na humihiyaw, ay sinabi kay Moises, May ingay ng pagbabaka sa kampamento."
            },
            {
              "chapter": 32,
              "verse": 18,
              "name": "Exodo 32:18",
              "text": "At kaniyang sinabi, Hindi ingay ng pagtatagumpay, o ingay man ng pagkatalo, kundi ingay ng mga umaawit ang aking naririnig."
            },
            {
              "chapter": 32,
              "verse": 19,
              "name": "Exodo 32:19",
              "text": "At nangyari paglapit niya sa kampamento, na kaniyang nakita ang guya at ang sayawan; at ang galit ni Moises ay naginit at kaniyang inihagis ang mga tapyas na nasa kaniyang mga kamay at nangasira sa paanan ng bundok."
            },
            {
              "chapter": 32,
              "verse": 20,
              "name": "Exodo 32:20",
              "text": "At kaniyang kinuha ang guya na kanilang ginawa, at sinunog ng apoy, at giniling hanggang sa naging alabok, at isinaboy sa ibabaw ng tubig, at ipinainom sa mga anak ni Israel."
            },
            {
              "chapter": 32,
              "verse": 21,
              "name": "Exodo 32:21",
              "text": "At sinabi ni Moises kay Aaron, Anong ginawa ng bayang ito sa iyo, na dinalhan mo sila ng isang malaking sala?"
            },
            {
              "chapter": 32,
              "verse": 22,
              "name": "Exodo 32:22",
              "text": "At sinabi ni Aaron, Huwag maginit ang galit ng aking panginoon: iyong kilala ang bayan, na sila'y mahilig sa kasamaan."
            },
            {
              "chapter": 32,
              "verse": 23,
              "name": "Exodo 32:23",
              "text": "Sapagka't kanilang sinabi sa akin, Igawa mo kami ng mga dios na mangunguna sa amin: sapagka't tungkol sa Moises na ito, na lalaking nagsampa sa amin mula sa lupain ng Egipto ay hindi namin maalaman kung anong nangyari sa kaniya."
            },
            {
              "chapter": 32,
              "verse": 24,
              "name": "Exodo 32:24",
              "text": "At aking sinabi sa kanila, Sinomang may ginto, ay magalis; na anopa't kanilang ibinigay sa akin: at aking inihagis sa apoy at lumabas ang guyang ito."
            },
            {
              "chapter": 32,
              "verse": 25,
              "name": "Exodo 32:25",
              "text": "At nang makita ni Moises na ang bayan ay nakakawala; sapagka't pinabayaan ni Aarong makawala ng maging isang kabiruan sa gitna ng kanilang mga kaaway:"
            },
            {
              "chapter": 32,
              "verse": 26,
              "name": "Exodo 32:26",
              "text": "Ay tumayo nga si Moises sa pintuang-daan ng kampamento, at nagsabi, Sinomang sa Panginoon ang kiling ay lumapit sa akin. At lahat ng mga anak ni Levi ay nagpipisan sa kaniya."
            },
            {
              "chapter": 32,
              "verse": 27,
              "name": "Exodo 32:27",
              "text": "At sinabi niya sa kanila, Ganito ang sabi ng Panginoon, ng Dios ng Israel: Ipatong ng bawa't lalake ang kaniyang tabak sa kaniyang hita, at yumaon kayong paroo't parito sa mga pintuang-daan, sa buong kampamento, at patayin ng bawa't lalake ang kaniyang kapatid na lalake, at ng bawa't lalake ang kaniyang kasama, at ng bawa't lalake ang kaniyang kapuwa."
            },
            {
              "chapter": 32,
              "verse": 28,
              "name": "Exodo 32:28",
              "text": "At ginawa ng mga anak ni Levi ang ayon sa salita ni Moises: at nabuwal sa bayan ng araw na yaon, ang may tatlong libong katao."
            },
            {
              "chapter": 32,
              "verse": 29,
              "name": "Exodo 32:29",
              "text": "At sinabi ni Moises, Italaga ninyo ang inyong sarili ngayon sa Panginoon, oo, bawa't lalake laban sa kaniyang anak na lalake, at laban sa kaniyang kapatid na lalake, upang kaniyang ipagkaloob sa inyo ang pagpapala sa araw na ito."
            },
            {
              "chapter": 32,
              "verse": 30,
              "name": "Exodo 32:30",
              "text": "At nangyari ng kinabukasan, na sinabi ni Moises sa bayan, Kayo'y nagkasala ng malaking kasalanan: at ngayo'y sasampahin ko ang Panginoon; marahil ay aking matutubos ang inyong kasalanan."
            },
            {
              "chapter": 32,
              "verse": 31,
              "name": "Exodo 32:31",
              "text": "At bumalik si Moises sa Panginoon, at nagsabi, Oh, ang bayang ito'y nagkasala ng malaking kasalanan, at gumawa sila ng mga dios na ginto."
            },
            {
              "chapter": 32,
              "verse": 32,
              "name": "Exodo 32:32",
              "text": "Gayon ma'y ngayon, kung iyong ipatatawad ang kanilang kasalanan; at kung hindi, ay alisin mo ako, isinasamo ko sa iyo, sa iyong aklat na sinulat mo."
            },
            {
              "chapter": 32,
              "verse": 33,
              "name": "Exodo 32:33",
              "text": "At sinabi ng Panginoon kay Moises, Ang magkasala laban sa akin ay siya kong aalisin sa aking aklat."
            },
            {
              "chapter": 32,
              "verse": 34,
              "name": "Exodo 32:34",
              "text": "At ngayo'y yumaon ka, iyong patnubayan ang bayan sa dakong aking sinalita sa iyo: narito, ang aking anghel ay magpapauna sa iyo: gayon ma'y sa araw na aking dalawin sila ay aking dadalawin ang kanilang kasalanang ipinagkasala nila."
            },
            {
              "chapter": 32,
              "verse": 35,
              "name": "Exodo 32:35",
              "text": "At sinaktan nga ng Panginoon ang bayan, sapagka't kanilang ginawa ang guya na ginawa ni Aaron."
            }
          ]
        },
        {
          "chapter": 33,
          "name": "Exodo 33",
          "verses": [
            {
              "chapter": 33,
              "verse": 1,
              "name": "Exodo 33:1",
              "text": "At sinalita ng Panginoon kay Moises, Yumaon ka, sumampa ka mula rito, ikaw at ang bayan na iyong isinampa mula sa lupain ng Egipto, na patungo kayo sa lupain na aking isinumpa kay Abraham, kay Isaac, at kay Jacob, na aking sinasabi, Sa iyong binhi ay aking ibibigay."
            },
            {
              "chapter": 33,
              "verse": 2,
              "name": "Exodo 33:2",
              "text": "At aking susuguin ang isang anghel sa unahan mo: at aking palalayasin ang Cananeo, ang Amorrheo, at ang Hetheo, at ang Pherezeo, ang Heveo, at ang Jebuseo:"
            },
            {
              "chapter": 33,
              "verse": 3,
              "name": "Exodo 33:3",
              "text": "Sa isang lupaing binubukalan ng gatas at pulot: sapagka't hindi ako sasampa sa gitna mo; sapagka't ikaw ay bayang may matigas na ulo; baka ikaw ay aking lipulin sa daan."
            },
            {
              "chapter": 33,
              "verse": 4,
              "name": "Exodo 33:4",
              "text": "At nang marinig ng bayan ang masasamang balitang ito, ay nanangis sila: at walang taong nagsuot ng kaniyang mga pahiyas."
            },
            {
              "chapter": 33,
              "verse": 5,
              "name": "Exodo 33:5",
              "text": "At sinabi ng Panginoon kay Moises, Sabihin mo sa mga anak ni Israel, Kayo'y isang bayang may matigas na ulo: kung ako'y sumampa sa gitna mo na sangdali, ay lilipulin kita: kaya't ngayo'y alisin mo ang iyong mga pahiyas sa iyo upang aking maalaman kung anong aking gagawin sa iyo."
            },
            {
              "chapter": 33,
              "verse": 6,
              "name": "Exodo 33:6",
              "text": "At ang mga anak ni Israel ay naghubad ng kanilang mga pahiyas mula sa bundok ng Horeb."
            },
            {
              "chapter": 33,
              "verse": 7,
              "name": "Exodo 33:7",
              "text": "Kinaugalian nga ni Moises na dalhin ang tolda at itayo sa labas ng kampamento, na malayo sa kampamento at kaniyang tinawag iyon, Tabernakulo ng kapisanan. At nangyari na bawa't magsiyasat sa Panginoon ay lumalabas na pumaparoon sa tabernakulo ng kapisanan, na nasa labas ng kampamento."
            },
            {
              "chapter": 33,
              "verse": 8,
              "name": "Exodo 33:8",
              "text": "At nangyari, pagka si Moises ay lumalabas na napasa sa Tolda, na ang buong bayan ay bumabangon at tumatayo, bawa't lalake sa pintuan ng kaniyang tolda at pinanonood si Moises hanggang sa makapasok sa Tolda."
            },
            {
              "chapter": 33,
              "verse": 9,
              "name": "Exodo 33:9",
              "text": "At nangyari, pagka si Moises ay pumapasok sa Tolda ay bumababa ang haliging ulap at tumitigil sa pintuan ng Tolda ang Panginoon ay nakikipagsalitaan kay Moises."
            },
            {
              "chapter": 33,
              "verse": 10,
              "name": "Exodo 33:10",
              "text": "At nakikita ng buong bayan ang haliging ulap at tumitigil sa pintuan ng Tolda; at ang buong bayan ay tumitindig at sumasamba, na bawa't isa'y sa tabi ng pintuan ng kaniyang tolda."
            },
            {
              "chapter": 33,
              "verse": 11,
              "name": "Exodo 33:11",
              "text": "At nakikipagsalitaan ang Panginoon kay Moises ng mukhaan, gaya ng isang taong nakikipagsalitaan sa kaniyang kaibigan. At siya'y bumabalik uli sa kampamento, datapuwa't ang kaniyang tagapangasiwang si Josue, na anak ni Nun, na may kabataan pa, ay hindi umaalis sa Tolda."
            },
            {
              "chapter": 33,
              "verse": 12,
              "name": "Exodo 33:12",
              "text": "At sinabi ni Moises sa Panginoon, Tingnan mo, iyong sinasabi sa akin: Isampa mo ang bayang ito: at hindi mo ipinakilala sa akin kung sino yaong susuguin mo na kasama ko. Gayon ma'y iyong sinabi, Aking nakikilala ka sa pangalan, at ikaw rin naman ay nakasumpong ng biyaya sa aking paningin."
            },
            {
              "chapter": 33,
              "verse": 13,
              "name": "Exodo 33:13",
              "text": "Ngayon nga, isinasamo ko sa iyo, na kung ako'y nakasumpong ng biyaya sa iyong paningin, ay ituro mo sa akin ngayon ang iyong mga daan, upang ikaw ay aking makilala, na ano pa't ako'y makasumpong ng biyaya sa iyong paningin: at akalain mo, na ang bansang ito ay iyong bayan."
            },
            {
              "chapter": 33,
              "verse": 14,
              "name": "Exodo 33:14",
              "text": "At kaniyang sinabi, Ako'y sasa iyo, at ikaw ay aking bibigyan ng kapahingahan."
            },
            {
              "chapter": 33,
              "verse": 15,
              "name": "Exodo 33:15",
              "text": "At sinabi niya sa kaniya, Kung ikaw ay hindi sasa akin ay huwag mo na kaming pasampahin mula rito."
            },
            {
              "chapter": 33,
              "verse": 16,
              "name": "Exodo 33:16",
              "text": "Sapagka't saan ngayon makikilala na ako'y nakasumpong ng biyaya sa iyong paningin, ako at ang iyong bayan? hindi ba dahil sa ikaw ay lumalakad na kasama namin, upang kami ay maging bukod, ako at ang iyong bayan, sa lahat ng bayan na nasa balat ng lupa?"
            },
            {
              "chapter": 33,
              "verse": 17,
              "name": "Exodo 33:17",
              "text": "At sinabi ng Panginoon kay Moises, Akin ding gagawin ang bagay na ito na iyong sinalita: sapagka't ikaw ay nakasumpong ng biyaya sa aking paningin, at ikaw ay aking nakikilala sa pangalan."
            },
            {
              "chapter": 33,
              "verse": 18,
              "name": "Exodo 33:18",
              "text": "At sinabi ni Moises, Ipakita mo sa akin, idinadalangin ko sa iyo, ang iyong kaluwalhatian."
            },
            {
              "chapter": 33,
              "verse": 19,
              "name": "Exodo 33:19",
              "text": "At kaniyang sinabi, Aking papangyayarihin ang aking buong kabutihan sa harap mo, at aking itatanyag ang pangalan ng Panginoon sa harap mo; at ako'y magkakaloob ng biyaya sa kanino mang aking ibig pagkalooban, at ako'y magmamaawain sa kanino mang aking ibig kaawaan."
            },
            {
              "chapter": 33,
              "verse": 20,
              "name": "Exodo 33:20",
              "text": "At kaniyang sinabi, Hindi mo makikita ang aking mukha: sapagka't hindi maaaring makita ako ng tao at mabuhay."
            },
            {
              "chapter": 33,
              "verse": 21,
              "name": "Exodo 33:21",
              "text": "At sinabi ng Panginoon, Narito, may isang dako sa tabi ko, at ikaw ay tatayo sa ibabaw ng batong iyan:"
            },
            {
              "chapter": 33,
              "verse": 22,
              "name": "Exodo 33:22",
              "text": "At mangyayari, na samantalang ang aking kaluwalhatian ay dumadaan, na aking ilalagay ka sa isang bitak ng bato, at tatakpan kita ng aking kamay hanggang sa ako'y makaraan:"
            },
            {
              "chapter": 33,
              "verse": 23,
              "name": "Exodo 33:23",
              "text": "At aking aalisin ang aking kamay, at iyong makikita ang aking likod: datapuwa't ang aking mukha ay hindi makikita."
            }
          ]
        },
        {
          "chapter": 34,
          "name": "Exodo 34",
          "verses": [
            {
              "chapter": 34,
              "verse": 1,
              "name": "Exodo 34:1",
              "text": "At sinabi ng Panginoon kay Moises, Humugis ka ng dalawang tapyas na bato na gaya ng una: at aking isusulat sa mga tapyas ang mga salita na nasa unang mga tapyas, na iyong sinira."
            },
            {
              "chapter": 34,
              "verse": 2,
              "name": "Exodo 34:2",
              "text": "At iyong ihanda sa kinaumagahan, at sumampa ka sa kinaumagahan sa bundok ng Sinai at humarap ka roon sa akin sa taluktok ng bundok."
            },
            {
              "chapter": 34,
              "verse": 3,
              "name": "Exodo 34:3",
              "text": "At sinomang tao ay huwag sasampang kasama mo, o makikita ang sinomang tao sa buong bundok; kahit ang mga kawan at ang mga bakahan ay huwag manginain sa harap ng bundok na yaon."
            },
            {
              "chapter": 34,
              "verse": 4,
              "name": "Exodo 34:4",
              "text": "At siya'y humugis ng dalawang tapyas na bato na gaya ng una; at bumangon si Moises na maaga sa kinaumagahan, at sumampa sa bundok ng Sinai, gaya ng iniutos ng Panginoon sa kaniya, at kinuha sa kaniyang kamay ang dalawang tapyas na bato."
            },
            {
              "chapter": 34,
              "verse": 5,
              "name": "Exodo 34:5",
              "text": "At ang Panginoon ay bumaba sa ulap, at tumayong kasama niya roon at itinanyag ang pangalan ng Panginoon."
            },
            {
              "chapter": 34,
              "verse": 6,
              "name": "Exodo 34:6",
              "text": "At ang Panginoo'y nagdaan sa harap niya, na itinanyag, Ang Panginoon, ang Panginoong Dios na puspos ng kahabagan at mapagkaloob, banayad sa pagkagalit, at sagana sa kaawaan at katotohanan;"
            },
            {
              "chapter": 34,
              "verse": 7,
              "name": "Exodo 34:7",
              "text": "Na gumagamit ng kaawaan sa libolibo, na nagpapatawad ng kasamaan, at ng pagsalangsang, at ng kasalanan: at sa anomang paraan ay hindi aariing walang sala ang salarin; na dinadalaw ang kasamaan ng mga ama sa mga anak, at sa mga anak ng mga anak, hanggang sa ikatlo at ika apat na salin."
            },
            {
              "chapter": 34,
              "verse": 8,
              "name": "Exodo 34:8",
              "text": "At nagmadali si Moises, at itinungo ang kaniyang ulo sa lupa, at sumamba."
            },
            {
              "chapter": 34,
              "verse": 9,
              "name": "Exodo 34:9",
              "text": "At kaniyang sinabi, Kung ngayo'y nakasumpong ako ng biyaya sa iyong paningin, Oh Panginoon, ay ipahintulot nawa ng Panginoon, isinasamo ko sa iyo, na pasa gitna namin; sapagka't isang bayang may matigas na ulo; at ipatawad mo ang aming kasamaan, at ang aming kasalanan, at ariin mo kaming iyong mana."
            },
            {
              "chapter": 34,
              "verse": 10,
              "name": "Exodo 34:10",
              "text": "At kaniyang sinabi, Narito, ako'y nakikipagtipan sa harap ng iyong buong bayan at gagawa ako ng mga kababalaghan, na kailan ma'y hindi ginawa sa buong lupa, o sa alin mang bansa: at ang buong bayan sa gitna ng iyong kinaroroonan ay makakakita ng gawa ng Panginoon, sapagka't kakilakilabot na bagay ang aking gagawin sa pamamagitan mo."
            },
            {
              "chapter": 34,
              "verse": 11,
              "name": "Exodo 34:11",
              "text": "Tuparin mo ang mga iniutos ko sa iyo sa araw na ito: narito, aking pinalalayas sa harap mo ang Amorrheo, at ang Cananeo, at ang Hetheo, at ang Pherezeo, at ang Jebuseo."
            },
            {
              "chapter": 34,
              "verse": 12,
              "name": "Exodo 34:12",
              "text": "Magingat ka, na huwag kang makipagtipan sa mga tumatahan sa lupain na iyong pinaroroonan, baka maging isang silo sa gitna mo:"
            },
            {
              "chapter": 34,
              "verse": 13,
              "name": "Exodo 34:13",
              "text": "Kundi inyong iwawasak ang kanilang mga dambana, at inyong pagpuputolputulin ang kanilang mga haligi at inyong ibubuwal ang kanilang mga Asera."
            },
            {
              "chapter": 34,
              "verse": 14,
              "name": "Exodo 34:14",
              "text": "Sapagka't hindi ka sasamba sa ibang dios: sapagka't ang Panginoon na ang pangalan ay Mapanibughuin; ay mapanibughuin ngang Dios:"
            },
            {
              "chapter": 34,
              "verse": 15,
              "name": "Exodo 34:15",
              "text": "Magingat ka; baka ikaw ay makipagtipan sa mga tumatahan sa lupain, at sila'y sumunod sa kanilang mga dios, at magsipaghain sa kanilang mga dios, at ikaw ay alukin ng isa at kumain ka ng kanilang hain;"
            },
            {
              "chapter": 34,
              "verse": 16,
              "name": "Exodo 34:16",
              "text": "At iyong papag-asawahin ang iyong mga anak na lalake at kanilang mga anak na babae, at ang kanilang mga anak na babae ay sumunod sa kanilang mga dios at pasunurin ang inyong mga anak na sumunod sa kanilang mga dios."
            },
            {
              "chapter": 34,
              "verse": 17,
              "name": "Exodo 34:17",
              "text": "Huwag kang gagawa para sa iyo ng mga dios na binubo."
            },
            {
              "chapter": 34,
              "verse": 18,
              "name": "Exodo 34:18",
              "text": "Ang kapistahan ng tinapay na walang lebadura ay iyong ipangingilin. Pitong araw na kakain ka ng tinapay na walang lebadura na gaya ng iniutos ko sa iyo, sa takdang panahon sa buwan ng Abib: sapagka't sa buwan ng Abib, ay umalis ka sa Egipto."
            },
            {
              "chapter": 34,
              "verse": 19,
              "name": "Exodo 34:19",
              "text": "Yaong lahat na nagbubukas ng bahay-bata ay akin; at gayon din ang lahat ng hayop na lalake, ang panganay ng baka at ng tupa,"
            },
            {
              "chapter": 34,
              "verse": 20,
              "name": "Exodo 34:20",
              "text": "At ang panganay ng isang asno ay iyong tutubusin ng isang kordero: at kung hindi mo tutubusin ay iyo ngang babaliin ang kaniyang leeg. Lahat ng panganay sa iyong mga anak ay iyong tutubusin. At walang lalapit sa harapan ko na walang dala."
            },
            {
              "chapter": 34,
              "verse": 21,
              "name": "Exodo 34:21",
              "text": "Anim na araw na gagawa ka, nguni't sa ikapitong araw ay magpapahinga ka: sa panahon ng pagbubukid at sa pagaani ay magpapahinga ka."
            },
            {
              "chapter": 34,
              "verse": 22,
              "name": "Exodo 34:22",
              "text": "At iyong ipangingilin ang kapistahan ng mga sanglinggo, ang sa mga unang bunga ng pagaani ng trigo, at ang kapistahan ng pagaani sa katapusan ng taon."
            },
            {
              "chapter": 34,
              "verse": 23,
              "name": "Exodo 34:23",
              "text": "Makaitlo nga sa isang taon na haharap ang lahat ng iyong mga lalake sa Panginoong Dios, na Dios ng Israel."
            },
            {
              "chapter": 34,
              "verse": 24,
              "name": "Exodo 34:24",
              "text": "Sapagka't aking palalayasin ang mga bansa sa harap mo, at aking palalaparin ang iyong mga hangganan: at hindi pagnanasaan ng sinoman ang iyong lupain, pagka ikaw ay pumapanhik na humarap sa Panginoong iyong Dios, na makaitlo sa isang taon."
            },
            {
              "chapter": 34,
              "verse": 25,
              "name": "Exodo 34:25",
              "text": "Huwag kang maghahandog ng dugo ng hain sa akin, na kasabay ng tinapay na may lebadura; o magtitira man ng hain sa kapistahan ng paskua hanggang sa kinaumagahan."
            },
            {
              "chapter": 34,
              "verse": 26,
              "name": "Exodo 34:26",
              "text": "Ang pinakaunang bunga ng iyong lupa ay iyong dadalhin sa bahay ng Panginoon mong Dios. Huwag mong lulutuin ang batang kambing sa gatas ng kaniyang ina."
            },
            {
              "chapter": 34,
              "verse": 27,
              "name": "Exodo 34:27",
              "text": "At sinabi ng Panginoon kay Moises, Isulat mo ang mga salitang ito: sapagka't ayon sa tunog ng mga salitang ito, ay nakipagtipan ako sa iyo at sa Israel."
            },
            {
              "chapter": 34,
              "verse": 28,
              "name": "Exodo 34:28",
              "text": "At siya'y natira doong kasama ng Panginoon, na apat na pung araw at apat na pung gabi; hindi man lamang siya kumain ng tinapay, o uminom man ng tubig. At isinulat ng Panginoon sa mga tapyas ang mga salita ng tipan, ang sangpung utos."
            },
            {
              "chapter": 34,
              "verse": 29,
              "name": "Exodo 34:29",
              "text": "At nangyari, nang bumaba si Moises sa bundok ng Sinai, na dala ang tapyas na bato ng patotoo sa kamay niya, noong bumaba sa bundok ay hindi nalalaman ni Moises na ang balat ng kaniyang mukha ay nagliliwanag dahil sa pakikipagusap niya sa Dios."
            },
            {
              "chapter": 34,
              "verse": 30,
              "name": "Exodo 34:30",
              "text": "At nang makita ni Aaron at ng lahat ng mga anak ni Israel si Moises, narito, ang balat ng kaniyang mukha ay nagliliwanag; at sila'y natakot na lumapit sa kaniya."
            },
            {
              "chapter": 34,
              "verse": 31,
              "name": "Exodo 34:31",
              "text": "At tinawag sila ni Moises; at si Aaron at ang lahat ng puno sa Israel ay nagbalik sa kaniya: at si Moises ay nagsalita sa kanila."
            },
            {
              "chapter": 34,
              "verse": 32,
              "name": "Exodo 34:32",
              "text": "At pagkatapos, ang lahat ng mga anak ni Israel ay lumapit; at kaniyang ibinigay sa kanila sa pamamagitan ng utos ang lahat ng salita ng Panginoon na sinalita sa kaniya sa bundok ng Sinai."
            },
            {
              "chapter": 34,
              "verse": 33,
              "name": "Exodo 34:33",
              "text": "At pagkapagsalita sa kanila ni Moises ay naglagay siya ng isang lambong sa kaniyang mukha."
            },
            {
              "chapter": 34,
              "verse": 34,
              "name": "Exodo 34:34",
              "text": "Datapuwa't pagka si Moises ay pumapasok sa harap ng Panginoon upang makipagsalitaan sa kaniya, ay nagaalis siya ng lambong hanggang siya'y makalabas; at siya'y lumabas at kaniyang sinalita sa mga anak ni Israel ang iniutos sa kaniya;"
            },
            {
              "chapter": 34,
              "verse": 35,
              "name": "Exodo 34:35",
              "text": "At nakita ng mga anak ni Israel ang mukha ni Moises, na ang balat ng mukha ni Moises ay nagliliwanag: at inilagay uli ni Moises ang lambong sa ibabaw ng kaniyang mukha, hanggang sa siya'y makapasok na nakipagsalitaan sa Dios."
            }
          ]
        },
        {
          "chapter": 35,
          "name": "Exodo 35",
          "verses": [
            {
              "chapter": 35,
              "verse": 1,
              "name": "Exodo 35:1",
              "text": "At pinulong ni Moises ang buong kapisanan ng mga anak ni Israel, at sinabi sa kanila, Ito ang mga salita na iniutos ng Panginoon, na inyong gagawin."
            },
            {
              "chapter": 35,
              "verse": 2,
              "name": "Exodo 35:2",
              "text": "Anim na araw na gagawa, datapuwa't ang ikapitong araw ay ipangingilin ninyo, isang sabbath na takdang kapahingahan sa Panginoon: sinomang gumawa ng anomang gawa sa araw na iyan ay papatayin."
            },
            {
              "chapter": 35,
              "verse": 3,
              "name": "Exodo 35:3",
              "text": "Huwag kayong magpapaningas ng apoy sa inyong buong tahanan sa araw ng sabbath."
            },
            {
              "chapter": 35,
              "verse": 4,
              "name": "Exodo 35:4",
              "text": "At sinalita ni Moises, sa buong kapisanan ng mga anak ni Israel, na sinasabi, Ito ang bagay na iniutos ng Panginoon, na sinasabi,"
            },
            {
              "chapter": 35,
              "verse": 5,
              "name": "Exodo 35:5",
              "text": "Magsikuha kayo sa inyo ng isang handog na taan sa Panginoon; sinomang may kusang loob, ay magdala ng handog sa Panginoon; ginto, at pilak, at tanso;"
            },
            {
              "chapter": 35,
              "verse": 6,
              "name": "Exodo 35:6",
              "text": "At kayong bughaw, at kulay-ube, at pula, at lino, at balahibo ng kambing;"
            },
            {
              "chapter": 35,
              "verse": 7,
              "name": "Exodo 35:7",
              "text": "At mga balat ng tupang lalake na tininang pula, at mga balat ng poka, at kahoy na akasia;"
            },
            {
              "chapter": 35,
              "verse": 8,
              "name": "Exodo 35:8",
              "text": "At langis na pangilawan, at mga espesia sa langis na pangpahid, at sa mabangong kamangyan:"
            },
            {
              "chapter": 35,
              "verse": 9,
              "name": "Exodo 35:9",
              "text": "At mga batong onix, at mga batong pangkalupkop, na pang-epod, at pangpektoral."
            },
            {
              "chapter": 35,
              "verse": 10,
              "name": "Exodo 35:10",
              "text": "At pumarito ang bawa't matalino sa inyo, at gawin ang lahat ng iniutos ng Panginoon;"
            },
            {
              "chapter": 35,
              "verse": 11,
              "name": "Exodo 35:11",
              "text": "Ang tabernakulo, ang tolda niyan, at ang takip niyan, ang mga kawit niyan, at ang mga tabla niyan, ang mga barakilan niyan, ang mga haligi niyan, at ang mga tungtungan niyan;"
            },
            {
              "chapter": 35,
              "verse": 12,
              "name": "Exodo 35:12",
              "text": "Ang kaban, at ang mga pingga niyan, ang luklukan ng awa, at ang lambong ng tabing;"
            },
            {
              "chapter": 35,
              "verse": 13,
              "name": "Exodo 35:13",
              "text": "Ang dulang at ang mga pingga niyan, at ang lahat ng kasangkapan niyan at ang tinapay na handog;"
            },
            {
              "chapter": 35,
              "verse": 14,
              "name": "Exodo 35:14",
              "text": "Ang kandelero rin naman na pangilaw, at ang mga kasangkapan niyan, at ang mga ilawan niyan, at ang langis na pangilawan;"
            },
            {
              "chapter": 35,
              "verse": 15,
              "name": "Exodo 35:15",
              "text": "At ang dambana ng kamangyan at ang mga pingga niyan, at ang langis na pangpahid, at ang mabangong kamangyan, at ang tabing na pangpintuan sa pintuan ng tabernakulo;"
            },
            {
              "chapter": 35,
              "verse": 16,
              "name": "Exodo 35:16",
              "text": "Ang dambana ng handog na susunugin, sangpu ng salang tanso niyan, at lahat ng mga kasangkapan niyan, ang hugasan at ang tungtungan niyan;"
            },
            {
              "chapter": 35,
              "verse": 17,
              "name": "Exodo 35:17",
              "text": "Ang mga tabing sa looban, ang mga haligi niyan, at ang mga tungtungan ng mga iyan, at ang tabing sa pintuan ng looban;"
            },
            {
              "chapter": 35,
              "verse": 18,
              "name": "Exodo 35:18",
              "text": "Ang mga tulos ng tabernakulo, at ang mga tulos ng looban, at ang mga panali ng mga iyan;"
            },
            {
              "chapter": 35,
              "verse": 19,
              "name": "Exodo 35:19",
              "text": "Ang mga mainam na yaring kasuutan sa pangangasiwa sa dakong banal, ang mga banal na kasuutan kay Aaron na saserdote, at ang mga kasuutan ng kaniyang mga anak, upang mangasiwa sa katungkulang saserdote."
            },
            {
              "chapter": 35,
              "verse": 20,
              "name": "Exodo 35:20",
              "text": "At ang buong kapisanan ng mga anak ni Israel ay umalis sa harap ni Moises."
            },
            {
              "chapter": 35,
              "verse": 21,
              "name": "Exodo 35:21",
              "text": "At sila'y lumapit, lahat ng tao na napukaw ang kalooban, at lahat na pinapagkusa ng sariling diwa, at nagdala ng panghandog sa Panginoon, sa gawain sa tabernakulo ng kapisanan, at sa buong ipaglilingkod at sa mga banal na kasuutan."
            },
            {
              "chapter": 35,
              "verse": 22,
              "name": "Exodo 35:22",
              "text": "At sila'y naparoon, mga lalake at mga babae, yaong lahat na nagkaroon ng kusang loob, at nagdala ng mga espile, at ng mga hikaw, at ng mga singsing na panatak, at ng mga pulsera, ng madlang hiyas na ginto; sa makatuwid baga'y lahat na naghandog ng handog na ginto sa Panginoon."
            },
            {
              "chapter": 35,
              "verse": 23,
              "name": "Exodo 35:23",
              "text": "At bawa't taong may kayong bughaw, at kulay-ube, at pula, at lino, at balahibo ng mga kambing, at balat ng mga tupa na tininang pula, at ng mga balat ng poka, ay nangagdala."
            },
            {
              "chapter": 35,
              "verse": 24,
              "name": "Exodo 35:24",
              "text": "Ang lahat na naghandog ng handog na pilak at tanso, ay nagdala ng handog sa Panginoon: at lahat ng taong may kahoy na akasia na magagamit sa anomang gawa na paglilingkod ay nagdala."
            },
            {
              "chapter": 35,
              "verse": 25,
              "name": "Exodo 35:25",
              "text": "At lahat ng mga babaing matatalino ay nagsihabi ng kanilang mga kamay, at dinala ang kanilang mga hinabi, na kayong bughaw, at kulay-ube, at pula, at lino."
            },
            {
              "chapter": 35,
              "verse": 26,
              "name": "Exodo 35:26",
              "text": "At lahat ng mga babae na napukaw ang kalooban, sa karunungan, ay nagsihabi ng balahibo ng mga kambing."
            },
            {
              "chapter": 35,
              "verse": 27,
              "name": "Exodo 35:27",
              "text": "At ang mga pinuno ay nagdala ng mga batong onix, at ng mga batong pangkalupkop na gamit sa epod, at sa pektoral;"
            },
            {
              "chapter": 35,
              "verse": 28,
              "name": "Exodo 35:28",
              "text": "At ng mga espesia, at ng langis; na pangilawan, at langis na pangpahid, at pangmabangong kamangyan."
            },
            {
              "chapter": 35,
              "verse": 29,
              "name": "Exodo 35:29",
              "text": "Ang mga anak ni Israel ay nagdala ng kusang handog sa Panginoon; bawa't lalake at babae, na ang puso'y nagkusang nagpadala ng magagamit sa lahat na gawain, na iniutos ng Panginoon sa pamamagitan ni Moises na gawin."
            },
            {
              "chapter": 35,
              "verse": 30,
              "name": "Exodo 35:30",
              "text": "At sinabi ni Moises sa mga anak ni Israel, Tingnan ninyo, tinawag ng Panginoon sa pangalan si Bezaleel na anak ni Uri, na anak ni Hur, sa lipi ni Juda;"
            },
            {
              "chapter": 35,
              "verse": 31,
              "name": "Exodo 35:31",
              "text": "At kaniyang pinuspos siya ng Espiritu ng Dios, tungkol sa karunungan, sa pagkakilala, at sa kaalaman, at sa lahat ng sarisaring gawain;"
            },
            {
              "chapter": 35,
              "verse": 32,
              "name": "Exodo 35:32",
              "text": "At upang kumatha ng mga gawang kaayaaya, na gumawa sa ginto, at sa pilak, at sa tanso,"
            },
            {
              "chapter": 35,
              "verse": 33,
              "name": "Exodo 35:33",
              "text": "At sa pagputol ng mga batong pangkalupkop, at sa pagukit sa kahoy, na gumawa sa lahat ng sarisaring maiinam na gawa."
            },
            {
              "chapter": 35,
              "verse": 34,
              "name": "Exodo 35:34",
              "text": "At isinapuso niya ang katalinuhan, na siya'y makapagturo, siya at gayon din si Aholiab, na anak ni Ahisamac, sa lipi ni Dan."
            },
            {
              "chapter": 35,
              "verse": 35,
              "name": "Exodo 35:35",
              "text": "Sila'y kaniyang pinuspos ng karunungan sa puso upang gumawa ng lahat na sarisaring gawa, ng taga-ukit, at tagakatha, at ng mangbuburda sa kayong bughaw, at sa kulay-ube, sa pula, at sa lino, at ng manghahabi, ng mga gumagawa ng anomang gawain, at ng mga kumakatha ng maiinam na gawa."
            }
          ]
        },
        {
          "chapter": 36,
          "name": "Exodo 36",
          "verses": [
            {
              "chapter": 36,
              "verse": 1,
              "name": "Exodo 36:1",
              "text": "At si Bezaleel at si Aholiab ay gagawa, at lahat ng matalino na pinagkalooban ng Panginoon ng karunungan at pagkakilala na maalaman kung paanong paggawa ng lahat ng gawa sa paglilingkod sa santuario, ayon sa lahat ng iniutos ng Panginoon."
            },
            {
              "chapter": 36,
              "verse": 2,
              "name": "Exodo 36:2",
              "text": "At tinawag ni Moises si Bezaleel at si Aholiab, at lahat ng marunong na pinagkalooban ng Panginoon ng karunungan sa puso, lahat ng may pusong napukaw na pumaroon sa gawang gagawin:"
            },
            {
              "chapter": 36,
              "verse": 3,
              "name": "Exodo 36:3",
              "text": "At kanilang tinanggap kay Moises ang lahat ng handog na dinala ng mga anak ni Israel na magagamit sa gawang paglilingkod sa santuario, upang gawin. At dinalhan pa nila siya ng kusang handog tuwing umaga."
            },
            {
              "chapter": 36,
              "verse": 4,
              "name": "Exodo 36:4",
              "text": "At nagsidating ang lahat ng mga taong matatalino, na gumagawa ng lahat na gawa, sa santuario, na bawa't isa'y mula sa kaniyang gawain na ginagawa;"
            },
            {
              "chapter": 36,
              "verse": 5,
              "name": "Exodo 36:5",
              "text": "At sila'y nagsalita kay Moises, na nagsasabi, Ang baya'y nagdadala ng higit kay sa kinakailangan sa gawang paglilingkod, na iniutos gawin ng Panginoon."
            },
            {
              "chapter": 36,
              "verse": 6,
              "name": "Exodo 36:6",
              "text": "At si Moises ay nagbigay utos at itinanyag nila sa buong kampamento na sinasabi, Huwag nang gumawa ang lalake o ang babae man ng anomang gawang handog sa santuario. Na ano pa't sinangsala na ang bayan sa pagdadala."
            },
            {
              "chapter": 36,
              "verse": 7,
              "name": "Exodo 36:7",
              "text": "Sapagka't ang kagamitan na mayroon sila ay sapat na sa lahat ng gawa na gagawin, at higit pa."
            },
            {
              "chapter": 36,
              "verse": 8,
              "name": "Exodo 36:8",
              "text": "At lahat ng matatalinong lalake sa gumagawa ng gawa, ay gumawa ng tabernakulo na may sangpung tabing, na linong pinili, at kayong bughaw, at kulay-ube, at pula na may mga querubin na niyari ng bihasang manggagawa."
            },
            {
              "chapter": 36,
              "verse": 9,
              "name": "Exodo 36:9",
              "text": "Ang haba ng bawa't tabing ay dalawang pu't walong siko, at ang luwang ng bawa't tabing ay apat na siko: lahat ng tabing ay magkakaisang sukat."
            },
            {
              "chapter": 36,
              "verse": 10,
              "name": "Exodo 36:10",
              "text": "At pinapagsugpong na isa't isa ang limang tabing: at ang ibang limang tabing ay pinapagsugpong na isa't isa."
            },
            {
              "chapter": 36,
              "verse": 11,
              "name": "Exodo 36:11",
              "text": "At siya'y gumawa ng mga presilyang bughaw sa gilid ng tabing, sa gilid ng pagkakasugpong: gayon din ang ginawa niya sa gilid ng tabing na nasa dulo ng ikalawang pagkakasugpong."
            },
            {
              "chapter": 36,
              "verse": 12,
              "name": "Exodo 36:12",
              "text": "Limangpung presilya ang ginawa niya sa isang tabing, at limangpung presilya ang ginawa niya sa gilid ng tabing na nasa ikalawang pagkakasugpong: ang mga presilya ay nagkakatapat na isa't isa."
            },
            {
              "chapter": 36,
              "verse": 13,
              "name": "Exodo 36:13",
              "text": "At siya'y gumawa ng limangpung kawit na ginto, at pinapagsugpong ang mga tabing na ang isa'y sa isa, sa pamamagitan ng mga kawit: sa gayo'y naging isa ang tabernakulo."
            },
            {
              "chapter": 36,
              "verse": 14,
              "name": "Exodo 36:14",
              "text": "At siya'y gumawa ng mga tabing na balahibo ng mga kambing na magagamit sa tolda na nasa ibabaw ng tabernakulo: labing isang tabing ang ginawa niya."
            },
            {
              "chapter": 36,
              "verse": 15,
              "name": "Exodo 36:15",
              "text": "Ang haba ng bawa't tabing ay tatlong pung siko, at apat na siko ang luwang ng bawa't tabing; ang labing isang tabing ay magkakaisa ng sukat."
            },
            {
              "chapter": 36,
              "verse": 16,
              "name": "Exodo 36:16",
              "text": "At kaniyang pinapagsugpong ang limang tabing at ang anim na tabing ay bukod."
            },
            {
              "chapter": 36,
              "verse": 17,
              "name": "Exodo 36:17",
              "text": "At siya'y gumawa ng limangpung presilya sa gilid ng unang tabing, sa dulo ng pagkakasugpong, at limangpung presilya ang ginawa niya sa gilid ng tabing na nasa dulo ng ikalawang pagkakasugpong."
            },
            {
              "chapter": 36,
              "verse": 18,
              "name": "Exodo 36:18",
              "text": "At siya'y gumawa ng limangpung kawit na tanso ng papagsugpungin ang tolda, upang maging isa."
            },
            {
              "chapter": 36,
              "verse": 19,
              "name": "Exodo 36:19",
              "text": "At siya'y gumawa ng isang pantakip sa tolda na balat ng mga tupa na tininang pula, at ng isang takip na balat ng poka sa ibabaw."
            },
            {
              "chapter": 36,
              "verse": 20,
              "name": "Exodo 36:20",
              "text": "At siya'y gumawa ng mga tabla para sa tabernakulo na kahoy na akasia, na pawang patayo."
            },
            {
              "chapter": 36,
              "verse": 21,
              "name": "Exodo 36:21",
              "text": "Sangpung siko ang haba ng isang tabla, at isang siko't kalahati ang luwang ng bawa't tabla."
            },
            {
              "chapter": 36,
              "verse": 22,
              "name": "Exodo 36:22",
              "text": "Bawa't tabla'y mayroong dalawang mitsa na nagkakasugpong na isa't isa: gayon ang ginawa niya sa lahat ng tabla ng tabernakulo."
            },
            {
              "chapter": 36,
              "verse": 23,
              "name": "Exodo 36:23",
              "text": "At kaniyang iginawa ng mga tabla ang tabernakulo; dalawangpung tabla sa tagilirang timugan na dakong timugan:"
            },
            {
              "chapter": 36,
              "verse": 24,
              "name": "Exodo 36:24",
              "text": "At siya'y gumawa ng apat na pung tungtungang pilak sa ilalim ng dalawang pung tabla: dalawang tungtungan sa ilalim ng isang tabla na ukol sa kaniyang dalawang mitsa; at dalawang tungtungan sa ilalim ng isang tabla na ukol sa kaniyang dalawang mitsa."
            },
            {
              "chapter": 36,
              "verse": 25,
              "name": "Exodo 36:25",
              "text": "At sa ikalawang tagiliran ng tabernakulo sa dakong hilagaan, ay gumawa siya ng dalawang pung tabla."
            },
            {
              "chapter": 36,
              "verse": 26,
              "name": "Exodo 36:26",
              "text": "At ng kanilang apat na pung tungtungang pilak; dalawang tungtungan sa ilalim ng isang tabla, at dalawang tungtungan sa ilalim ng ibang tabla."
            },
            {
              "chapter": 36,
              "verse": 27,
              "name": "Exodo 36:27",
              "text": "At sa dakong hulihan ng tabernakulo, sa kalunuran ay gumawa siya ng anim na tabla."
            },
            {
              "chapter": 36,
              "verse": 28,
              "name": "Exodo 36:28",
              "text": "At dalawang tabla ang ginawa niya sa mga sulok ng tabernakulo sa dakong hulihan."
            },
            {
              "chapter": 36,
              "verse": 29,
              "name": "Exodo 36:29",
              "text": "Na mga nasugpong sa tablang nauukol sa dakong ibaba at nauugnay na mainam hanggang sa itaas, sa isang argolya; gayon ginawa niya sa dalawang yaon sa dalawang sulok."
            },
            {
              "chapter": 36,
              "verse": 30,
              "name": "Exodo 36:30",
              "text": "At mayroong walong tabla, at ang mga tungtungang pilak, ay labing anim na tungtungan; sa ilalim ng bawa't tabla ay dalawang tungtungan."
            },
            {
              "chapter": 36,
              "verse": 31,
              "name": "Exodo 36:31",
              "text": "At siya'y gumawa ng mga barakilan na kahoy na akasia; lima sa mga tabla ng isang tagiliran ng tabernakulo,"
            },
            {
              "chapter": 36,
              "verse": 32,
              "name": "Exodo 36:32",
              "text": "At limang barakilan sa mga tabla ng kabilang tagiliran ng tabernakulo, at limang barakilan sa mga tabla ng tabernakulo sa dakong hulihan na dakong kalunuran."
            },
            {
              "chapter": 36,
              "verse": 33,
              "name": "Exodo 36:33",
              "text": "At kaniyang pinaraan ang gitnang barakilan sa gitna ng mga tabla, mula sa isang dulo hanggang sa kabila."
            },
            {
              "chapter": 36,
              "verse": 34,
              "name": "Exodo 36:34",
              "text": "At kaniyang binalot ang mga tabla ng ginto, at gininto niya ang kanilang mga argolya na mga daraanan ng mga barakilan, at binalot ang mga barakilan ng ginto."
            },
            {
              "chapter": 36,
              "verse": 35,
              "name": "Exodo 36:35",
              "text": "At kaniyang ginawa ang lambong na kayong bughaw, at kulay-ube, at pula, at linong pinili na may mga querubin na gawa ng bihasang manggagawa."
            },
            {
              "chapter": 36,
              "verse": 36,
              "name": "Exodo 36:36",
              "text": "At kanilang iginawa ng apat na haliging akasia, at pinagbalot ng ginto: ang kanilang mga sima ay ginto rin: at kaniyang mga ipinagbubo ng apat na tungtungang pilak."
            },
            {
              "chapter": 36,
              "verse": 37,
              "name": "Exodo 36:37",
              "text": "At kaniyang iginawa ng tabing ang pintuan ng Tolda, na kayong bughaw, at kulay-ube, at pula, linong pinili, na yari ng mangbuburda;"
            },
            {
              "chapter": 36,
              "verse": 38,
              "name": "Exodo 36:38",
              "text": "At iginawa niya ng limang haligi sangpu ng kanilang mga sima: at kaniyang binalot ang mga kapitel at ang kanilang mga pilete ng ginto; at ang kanilang limang tungtungan ay tanso."
            }
          ]
        },
        {
          "chapter": 37,
          "name": "Exodo 37",
          "verses": [
            {
              "chapter": 37,
              "verse": 1,
              "name": "Exodo 37:1",
              "text": "At kahoy na akasia ang ginawang kaban ni Bezaleel: na may dalawang siko't kalahati ang haba niyaon, at may isang siko't kalahati ang luwang niyaon, at may isang siko't kalahati ang taas niyaon:"
            },
            {
              "chapter": 37,
              "verse": 2,
              "name": "Exodo 37:2",
              "text": "At kaniyang binalot ng taganas na ginto sa loob at sa labas, at iginawa ng isang kornisang ginto sa palibot."
            },
            {
              "chapter": 37,
              "verse": 3,
              "name": "Exodo 37:3",
              "text": "At ipinagbubo niya ng apat na argolyang ginto, sa apat na sulok niyaon; sa makatuwid baga'y dalawang argolya sa isang tagiliran."
            },
            {
              "chapter": 37,
              "verse": 4,
              "name": "Exodo 37:4",
              "text": "At siya'y gumawa ng mga pingga na kahoy na akasia, at pinagbalot ng ginto."
            },
            {
              "chapter": 37,
              "verse": 5,
              "name": "Exodo 37:5",
              "text": "At isinuot ang mga pingga sa mga argolya, sa mga tagiliran ng kaban, upang mabuhat ang kaban."
            },
            {
              "chapter": 37,
              "verse": 6,
              "name": "Exodo 37:6",
              "text": "At gumawa siya ng isang luklukan ng awa na taganas na ginto: na may dalawang siko at kalahati ang haba, at may isang siko't kalahati ang luwang."
            },
            {
              "chapter": 37,
              "verse": 7,
              "name": "Exodo 37:7",
              "text": "At siya'y gumawa ng dalawang querubing ginto; na niyari niya sa pamukpok sa dalawang dulo ng luklukan ng awa;"
            },
            {
              "chapter": 37,
              "verse": 8,
              "name": "Exodo 37:8",
              "text": "Isang querubin sa isang dulo, at isang querubin sa kabilang dulo: na kaputol ng luklukan ng awa, ginawa niya ang mga querubin sa dalawang dulo."
            },
            {
              "chapter": 37,
              "verse": 9,
              "name": "Exodo 37:9",
              "text": "At ibinubuka ng mga querubin ang mga pakpak na paitaas, na nalililiman ng kanilang mga pakpak ang luklukan ng awa, na nagkakaharap ang kanilang mga mukha; sa dakong luklukan ng awa nakaharap ang mga mukha ng mga querubin."
            },
            {
              "chapter": 37,
              "verse": 10,
              "name": "Exodo 37:10",
              "text": "At ginawa rin niya ang dulang na kahoy na akasia; na may dalawang siko ang haba niyaon, at isang siko ang luwang niyaon, at isang siko't kalahati ang taas niyaon:"
            },
            {
              "chapter": 37,
              "verse": 11,
              "name": "Exodo 37:11",
              "text": "At binalot niya ng taganas na ginto, at iginawa niya ng isang kornisang ginto sa palibot."
            },
            {
              "chapter": 37,
              "verse": 12,
              "name": "Exodo 37:12",
              "text": "At iginawa niya ng isang gilid na may isang kamay ang luwang sa palibot, at iginawa ng isang ginintong kornisa ang gilid sa palibot."
            },
            {
              "chapter": 37,
              "verse": 13,
              "name": "Exodo 37:13",
              "text": "At ipinagbubo ng apat na argolyang ginto, at inilagay ang mga argolya sa apat na sulok na ukol sa apat na paa niyaon."
            },
            {
              "chapter": 37,
              "verse": 14,
              "name": "Exodo 37:14",
              "text": "Malapit sa gilid ang mga argolya, na daraanan ng mga pingga, upang mabuhat ang dulang."
            },
            {
              "chapter": 37,
              "verse": 15,
              "name": "Exodo 37:15",
              "text": "At ginawa niya ang mga pingga na kahoy na akasia, at pinagbalot ng ginto, upang mabuhat ang dulang."
            },
            {
              "chapter": 37,
              "verse": 16,
              "name": "Exodo 37:16",
              "text": "At ginawa niyang taganas na ginto ang mga kasangkapang nasa ibabaw ng dulang, ang mga pinggan niyaon, at ang mga kutsara niyaon, at ang mga tasa niyaon, at ang mga kopa niyaon, na pagbubuhusan."
            },
            {
              "chapter": 37,
              "verse": 17,
              "name": "Exodo 37:17",
              "text": "At kaniyang ginawa ang kandelero na taganas na ginto: niyari niya sa pamukpuk ang kandelero, ang tungtungan niyaon at ang haligi niyaon; ang mga kopa niyaon, ang mga globito niyaon, at ang mga bulaklak ay kaputol niyaon:"
            },
            {
              "chapter": 37,
              "verse": 18,
              "name": "Exodo 37:18",
              "text": "At may anim na sangang lumalabas sa dalawang tagiliran niyaon; tatlong sanga ng kandelero ay sa isang tagiliran, at tatlong sanga ng kandelero ay sa kabilang tagiliran:"
            },
            {
              "chapter": 37,
              "verse": 19,
              "name": "Exodo 37:19",
              "text": "Tatlong kopang anyong bulaklak ng almendro sa isang sanga, isang globito at isang bulaklak; at tatlong kopang anyong bulaklak ng almendro sa kabilang sanga, isang globito at isang bulaklak; gayon sa anim na sangang lumalabas sa kandelero."
            },
            {
              "chapter": 37,
              "verse": 20,
              "name": "Exodo 37:20",
              "text": "At sa kandelero'y may apat na kopang anyong bulaklak ng almendro, sangpu ng mga globito niyaon, at ng mga bulaklak niyaon:"
            },
            {
              "chapter": 37,
              "verse": 21,
              "name": "Exodo 37:21",
              "text": "At may isang globito sa ilalim ng dalawa sa mga sanga na kaputol niyaon, at isang globito sa ilalim ng kabilang dalawa sa mga sanga na kaputol niyaon, at isang globito sa ilalim ng dalawang sanga na kaputol niyaon, sapagka't ang anim na sanga ay lumalabas doon."
            },
            {
              "chapter": 37,
              "verse": 22,
              "name": "Exodo 37:22",
              "text": "Ang mga globito at ang mga sanga ay kaputol ng kandelero: ang kabuoa'y isa lamang putol na yari sa pamukpok, taganas na ginto."
            },
            {
              "chapter": 37,
              "verse": 23,
              "name": "Exodo 37:23",
              "text": "At kaniyang ginawa ang mga ilawan niyaong pito, at ang mga pangipit niyaon, at ang mga pinggan niyaon, na taganas na ginto."
            },
            {
              "chapter": 37,
              "verse": 24,
              "name": "Exodo 37:24",
              "text": "Na isang talento na taganas na ginto ginawa niya, at ang lahat ng mga kasangkapan niyaon."
            },
            {
              "chapter": 37,
              "verse": 25,
              "name": "Exodo 37:25",
              "text": "At kaniyang ginawa ang dambanang suuban na kahoy na akasia: isang siko ang haba niyaon, at isang siko ang luwang niyaon, parisukat at dalawang siko ang taas niyaon; ang mga anyong sungay niyaon ay kaputol din."
            },
            {
              "chapter": 37,
              "verse": 26,
              "name": "Exodo 37:26",
              "text": "At kaniyang binalot ng taganas na ginto ang ibabaw niyaon, at ang mga tagiliran niyaon sa palibot, at ang mga anyong sungay niyaon: at kaniyang iginawa ng isang kornisang ginto sa palibot."
            },
            {
              "chapter": 37,
              "verse": 27,
              "name": "Exodo 37:27",
              "text": "At iginawa niya ng dalawang gintong argolya sa ilalim ng kornisa, sa dakong itaas ng dalawang panig, sa ibabaw ng dalawang panig, na pagsusuutan ng mga pingga upang mabuhat."
            },
            {
              "chapter": 37,
              "verse": 28,
              "name": "Exodo 37:28",
              "text": "At kaniyang ginawa ang mga pingga na kahoy na akasia, at mga binalot na ginto."
            },
            {
              "chapter": 37,
              "verse": 29,
              "name": "Exodo 37:29",
              "text": "At kaniyang ginawa ang banal na langis na pangpahid, at ang taganas na kamangyan na mainam na pabango ayon sa katha ng manggagawa ng pabango."
            }
          ]
        },
        {
          "chapter": 38,
          "name": "Exodo 38",
          "verses": [
            {
              "chapter": 38,
              "verse": 1,
              "name": "Exodo 38:1",
              "text": "At kaniyang ginawa ang dambanang pagsusunugan ng handog na kahoy na akasia: limang siko ang haba niyaon, at limang siko ang luwang niyaon, parisukat; at tatlong siko ang taas niyaon."
            },
            {
              "chapter": 38,
              "verse": 2,
              "name": "Exodo 38:2",
              "text": "At kaniyang ginawa ang mga anyong sungay niyaon sa ibabaw ng apat na sulok niyaon; ang mga anyong sungay niyaon ay kaputol din: at kaniyang binalot ng tanso."
            },
            {
              "chapter": 38,
              "verse": 3,
              "name": "Exodo 38:3",
              "text": "At kaniyang ginawa ang lahat ng mga kasangkapan ng dambana: ang mga kawa, at ang mga pala, at ang mga mangkok, ang mga pangalawit, at ang mga suuban lahat ng kasangkapan ay kaniyang ginawang tanso."
            },
            {
              "chapter": 38,
              "verse": 4,
              "name": "Exodo 38:4",
              "text": "At kaniyang iginawa ang dambana ng isang salang tanso na ayos lambat, sa ibaba ng gilid ng dambana sa palibot niyaon, sa dakong ibaba, na umaabot hanggang sa kalahatian ng dambana."
            },
            {
              "chapter": 38,
              "verse": 5,
              "name": "Exodo 38:5",
              "text": "At siya'y nagbubo ng apat na argolya para sa apat na sulok ng pinakasalang tanso, sa mga dakong susuutan ng mga pingga."
            },
            {
              "chapter": 38,
              "verse": 6,
              "name": "Exodo 38:6",
              "text": "At ginawa niya ang mga pingga na kahoy na akasia, at pinagbalot ng tanso."
            },
            {
              "chapter": 38,
              "verse": 7,
              "name": "Exodo 38:7",
              "text": "At kaniyang isinuot ang mga pingga sa mga argolya na nasa mga tagiliran ng dambana, upang mabuhat; ginawa niya ang dambana na kuluong sa pamamagitan ng mga tabla."
            },
            {
              "chapter": 38,
              "verse": 8,
              "name": "Exodo 38:8",
              "text": "At kaniyang ginawa ang hugasan na tanso, at ang tungtungan niyao'y tanso, na niyari sa mga salamin ang tanso ng mga tagapaglingkod na babae na naglilingkod sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 38,
              "verse": 9,
              "name": "Exodo 38:9",
              "text": "At kaniyang ginawa ang looban, sa tagilirang timugan na dakong timugan, ang tabing ng looban ay mga linong pinili na may isang daang siko:"
            },
            {
              "chapter": 38,
              "verse": 10,
              "name": "Exodo 38:10",
              "text": "Ang mga haligi ng mga yao'y dalawangpu, at ang mga tungtungan ay dalawangpu, tanso; ang mga sima ng mga haligi at ang mga pilete ay pilak."
            },
            {
              "chapter": 38,
              "verse": 11,
              "name": "Exodo 38:11",
              "text": "At sa dakong hilagaan ay may isang daang siko, ang mga haligi ay dalawangpu, at ang mga tungtungan ay dalawangpu, tanso; ang mga sima ng mga haligi at ang mga pilete ay pilak."
            },
            {
              "chapter": 38,
              "verse": 12,
              "name": "Exodo 38:12",
              "text": "At sa tagilirang kalunuran, may mga tabing na may limangpung siko, ang mga haligi ay sangpu, at ang mga tungtungan ay sangpu; ang mga sima ng mga haligi at ang mga pilete ay pilak."
            },
            {
              "chapter": 38,
              "verse": 13,
              "name": "Exodo 38:13",
              "text": "At sa tagilirang silanganan na dakong silanganan ay may limangpung siko."
            },
            {
              "chapter": 38,
              "verse": 14,
              "name": "Exodo 38:14",
              "text": "Ang mga tabing sa isang dako ng pintuang-daan ay may labinglimang siko; ang mga haligi ay tatlo, at ang mga tungtungan ay tatlo;"
            },
            {
              "chapter": 38,
              "verse": 15,
              "name": "Exodo 38:15",
              "text": "At gayon din sa kabilang dako: sa dakong ito at sa dakong yaon ng pintuang daan ng looban ay may mga tabing na tiglalabing limang siko; ang mga haligi niyaon, ay tatlo, at ang mga tungtungan niyaon ay tatlo."
            },
            {
              "chapter": 38,
              "verse": 16,
              "name": "Exodo 38:16",
              "text": "Lahat ng mga tabing ng looban sa palibot, ay linong pinili."
            },
            {
              "chapter": 38,
              "verse": 17,
              "name": "Exodo 38:17",
              "text": "At ang mga tungtungan para sa mga haligi ay tanso: ang mga sima ng mga haligi at ang mga pilete ay pilak; at ang mga balot ng mga kapitel ay pilak; at ang lahat ng haligi ng looban ay napipiletehan ng pilak."
            },
            {
              "chapter": 38,
              "verse": 18,
              "name": "Exodo 38:18",
              "text": "At ang tabing sa pintuang daan ng looban ay yari ng mangbuburda, na kayong bughaw, at kulay-ube, at pula, at linong pinili: at may dalawangpung siko ang haba, at ang taas sa luwang ay may limang siko, na kabagay ng mga tabing sa looban."
            },
            {
              "chapter": 38,
              "verse": 19,
              "name": "Exodo 38:19",
              "text": "At ang mga haligi ay apat, at ang mga tungtungan ay apat, tanso; ang mga sima ay pilak, at ang mga balot ng kapitel, at ang mga pilete ay pilak."
            },
            {
              "chapter": 38,
              "verse": 20,
              "name": "Exodo 38:20",
              "text": "At lahat ng mga tulos ng tabernakulo, at ng looban sa palibot, ay tanso."
            },
            {
              "chapter": 38,
              "verse": 21,
              "name": "Exodo 38:21",
              "text": "Ito ang mga bilang ng mga bagay sa tabernakulo, sa makatuwid baga'y sa tabernakulo ng patotoo, gaya ng binilang nila, ayon sa utos ni Moises para sa paglilingkod ng mga Levita sa pamamagitan ni Ithamar na anak ni Aaron na saserdote."
            },
            {
              "chapter": 38,
              "verse": 22,
              "name": "Exodo 38:22",
              "text": "At ginawa ni Bezaleel na anak ni Uri, na anak ni Hur, sa lipi ni Juda, yaong lahat na iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 38,
              "verse": 23,
              "name": "Exodo 38:23",
              "text": "At kasama niya si Aholiab, na anak ni Ahisamac, sa lipi ni Dan, na tagapagukit, at bihasang manggagawa, at mangbuburda sa bughaw at sa kulay-ube, at sa pula, at sa lino."
            },
            {
              "chapter": 38,
              "verse": 24,
              "name": "Exodo 38:24",
              "text": "Lahat ng ginto na ginamit sa gagawin sa buong gawain sa santuario, sa makatuwid baga'y ang gintong handog ay dalawangpu't siyam na talento, at pitong daan at tatlongpung siklo, ayon sa siklo ng santuario."
            },
            {
              "chapter": 38,
              "verse": 25,
              "name": "Exodo 38:25",
              "text": "At ang pilak niyaong mga nabilang sa kapisanan ay isang daang talento, at isang libo't pitong daan at pitongpu't limang siklo, ayon sa siklo ng santuario:"
            },
            {
              "chapter": 38,
              "verse": 26,
              "name": "Exodo 38:26",
              "text": "Na tigisang beka bawa't ulo, samakatuwid, kalahati ng isang siklo, ayon sa siklo ng santuario, sa bawa't isa na nasanib sa mga nabilang, magmula sa dalawangpung taong gulang na patanda, sa anim na raan at tatlong libo at limang daan at limangpung lalake."
            },
            {
              "chapter": 38,
              "verse": 27,
              "name": "Exodo 38:27",
              "text": "At ang isang daang talentong pilak ay ginamit sa pagbububo ng mga tungtungan ng santuario, at ng mga tungtungan ng mga haligi ng lambong; isang daang tungtungan sa isang daang talento, isang talento sa bawa't tungtungan."
            },
            {
              "chapter": 38,
              "verse": 28,
              "name": "Exodo 38:28",
              "text": "At sa isang libo't pitong daan at pitong pu't limang siklo, ay naigawa ng sima ang mga haligi at binalot ang mga kapitel, at iginawa ng mga pilete."
            },
            {
              "chapter": 38,
              "verse": 29,
              "name": "Exodo 38:29",
              "text": "At ang tansong handog ay pitongpung talento, at dalawang libo at apat na raang siklo."
            },
            {
              "chapter": 38,
              "verse": 30,
              "name": "Exodo 38:30",
              "text": "At siyang ipinaggawa ng mga tungtungan sa pintuan ng tabernakulo ng kapisanan, at ng dambanang tanso, at ng salang tanso niyaon, at ng lahat ng kasangkapan ng dambana,"
            },
            {
              "chapter": 38,
              "verse": 31,
              "name": "Exodo 38:31",
              "text": "At ng mga tungtungan ng looban sa palibot, at ng mga tungtungan ng pintuan ng looban, at ng lahat ng mga tulos ng dampa, at ng lahat ng mga tulos ng looban sa palibot."
            }
          ]
        },
        {
          "chapter": 39,
          "name": "Exodo 39",
          "verses": [
            {
              "chapter": 39,
              "verse": 1,
              "name": "Exodo 39:1",
              "text": "At sa kayong bughaw, at kulay-ube, at pula, ay gumawa sila ng mga kasuutang mainam ang pagkayari upang gamitin sa pangangasiwa sa dakong banal, at ginawang mga banal na kasuutan kay Aaron; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 2,
              "name": "Exodo 39:2",
              "text": "At kaniyang ginawa ang epod na ginto, na kayong bughaw, at kulay-ube, at pula, at linong pinili."
            },
            {
              "chapter": 39,
              "verse": 3,
              "name": "Exodo 39:3",
              "text": "At kanilang pinukpok ang ginto na pinanipis na pahaba at pinutol na ginawang kawad na ginto, upang itahi sa kayong bughaw, at sa kulay-ube, at sa pula, at sa lino na gawa ng bihasang manggagawa."
            },
            {
              "chapter": 39,
              "verse": 4,
              "name": "Exodo 39:4",
              "text": "Kanilang iginawa ng mga pangbalikat, na nagkakasugpong: sa dalawang dulo ay nagkakasugpong."
            },
            {
              "chapter": 39,
              "verse": 5,
              "name": "Exodo 39:5",
              "text": "At ang mainam na pagkayaring pamigkis, na nasa ibabaw ng epod upang ibigkis, ay kaputol at gaya ng pagkayari ng epod; na ginto, at kayong bughaw, at kulay-ube, at pula, linong pinili; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 6,
              "name": "Exodo 39:6",
              "text": "At kanilang ginawa ang mga batong onix na pinamutihan ng kalupkop na ginto, na ayos ukit ng isang panatak, ayon sa mga pangalan ng mga anak ni Israel."
            },
            {
              "chapter": 39,
              "verse": 7,
              "name": "Exodo 39:7",
              "text": "At kaniyang inilagay sa ibabaw ng pangbalikat ng epod upang maging mga batong pinakaalaala sa ikagagaling ng mga anak ni Israel; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 8,
              "name": "Exodo 39:8",
              "text": "At kaniyang ginawa ang pektoral, na gawa ng bihasang manggagawa, gaya ng pagkayari ng epod; na ginto, at kayong bughaw, at kulay-ube, at pula, at linong pinili."
            },
            {
              "chapter": 39,
              "verse": 9,
              "name": "Exodo 39:9",
              "text": "Parisukat; kanilang ginawang nakatiklop ang pektoral: isang dangkal ang luwang niyaon, pagka nakatiklop."
            },
            {
              "chapter": 39,
              "verse": 10,
              "name": "Exodo 39:10",
              "text": "At kanilang kinalupkupan ng apat na hanay na sarisaring bato: isang hanay ay sardio, topacio, at karbungko na siyang unang hanay."
            },
            {
              "chapter": 39,
              "verse": 11,
              "name": "Exodo 39:11",
              "text": "At ang ikalawang hanay, ay isang esmeralda, isang zafiro, at isang diamante."
            },
            {
              "chapter": 39,
              "verse": 12,
              "name": "Exodo 39:12",
              "text": "At ang ikatlong hanay, ay isang jacinto, isang agata, at isang ametista."
            },
            {
              "chapter": 39,
              "verse": 13,
              "name": "Exodo 39:13",
              "text": "At ang ikaapat na hanay ay isang berilo, isang onix, at isang jaspe; na mga natatakpan ng mga pamuting ginto sa kanilang mga pagkakakalupkop."
            },
            {
              "chapter": 39,
              "verse": 14,
              "name": "Exodo 39:14",
              "text": "At ang mga bato ay ayon sa mga pangalan ng mga anak ni Israel, labingdalawa, ayon sa kanilang mga pangalan; na ayos ukit ng isang panatak; bawa't isa'y ayon sa kaniyang pangalan, na ukol sa labingdalawang lipi."
            },
            {
              "chapter": 39,
              "verse": 15,
              "name": "Exodo 39:15",
              "text": "At kanilang iginawa ang pektoral ng mga tanikalang parang tirintas na ayos pinili na taganas na ginto."
            },
            {
              "chapter": 39,
              "verse": 16,
              "name": "Exodo 39:16",
              "text": "At sila'y gumawa ng dalawang pangkalupkop na ginto, at ng dalawang singsing na ginto; at inilagay ang dalawang singsing sa dalawang dulo ng pektoral."
            },
            {
              "chapter": 39,
              "verse": 17,
              "name": "Exodo 39:17",
              "text": "At kanilang ikinabit ang dalawang tanikalang pinili na ginto sa dalawang singsing sa mga sulok ng pektoral."
            },
            {
              "chapter": 39,
              "verse": 18,
              "name": "Exodo 39:18",
              "text": "At ang ibang dalawang dulo ng dalawang tanikalang ayos singsing ay kanilang ikinabit sa dalawang pangkalupkop, at mga ikinabit sa mga pangbalikat ng epod sa dakong harapan niyaon."
            },
            {
              "chapter": 39,
              "verse": 19,
              "name": "Exodo 39:19",
              "text": "At sila'y gumawa ng ibang dalawang singsing na ginto, at mga inilagay sa dalawang sulok ng pektoral sa gilid niyaon, na nasa dakong kabaligtaran ng epod."
            },
            {
              "chapter": 39,
              "verse": 20,
              "name": "Exodo 39:20",
              "text": "At sila'y gumawa ng dalawang singsing na ginto, at mga ikinabit sa dalawang pangbalikat ng epod sa dakong ibaba, sa may harapan, na malapit sa pagkakasugpong, sa ibabaw ng mainam na pagkayaring pamigkis ng epod."
            },
            {
              "chapter": 39,
              "verse": 21,
              "name": "Exodo 39:21",
              "text": "At kanilang itinali ang pektoral sa pamamagitan ng mga singsing, sa mga singsing ng epod ng isang panaling bughaw upang mamalagi sa ibabaw ng mainam na pagkayaring pamigkis ng epod; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 22,
              "name": "Exodo 39:22",
              "text": "At kaniyang ginawa ang balabal ng epod na yari ng manghahabi, na taganas na bughaw;"
            },
            {
              "chapter": 39,
              "verse": 23,
              "name": "Exodo 39:23",
              "text": "At ang butas ng balabal ay nasa gitna niyaon na gaya ng leeg ng isang koselete, na may isang uriang tinahi sa palibot ng pinakaleeg upang huwag mapunit."
            },
            {
              "chapter": 39,
              "verse": 24,
              "name": "Exodo 39:24",
              "text": "At kanilang ginawan ang mga ribete ng balabal ng mga granadang kayong bughaw, at kulay-ube, at pula, at linong pinili."
            },
            {
              "chapter": 39,
              "verse": 25,
              "name": "Exodo 39:25",
              "text": "At sila'y gumawa ng mga kampanilyang taganas na ginto, at inilagay ang mga kampanilya sa pagitan ng mga granada sa ibabaw ng ribete ng balabal sa palibot, sa pagitan ng mga granada;"
            },
            {
              "chapter": 39,
              "verse": 26,
              "name": "Exodo 39:26",
              "text": "Isang kampanilya at isang granada, isang kampanilya at isang granada, sa ibabaw ng ribete ng balabal sa palibot, upang ipangasiwa gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 27,
              "name": "Exodo 39:27",
              "text": "At kanilang ginawa ang mga tunika na lino na yaring hinabi para kay Aaron, at sa kaniyang mga anak,"
            },
            {
              "chapter": 39,
              "verse": 28,
              "name": "Exodo 39:28",
              "text": "At ang mitra na lino, at ang mga mainam na tiara na lino, at ang mga salawal na lino na kayong pinili na lino,"
            },
            {
              "chapter": 39,
              "verse": 29,
              "name": "Exodo 39:29",
              "text": "At ang bigkis na linong pinili, at kayong bughaw at kulay-ube, at pula, na gawa ng mangbuburda; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 30,
              "name": "Exodo 39:30",
              "text": "At kanilang ginawa ang lamina ng banal na korona na taganas na ginto, at sinulatan ng isang titik na ayos ukit ng isang panatak, Banal sa Panginoon."
            },
            {
              "chapter": 39,
              "verse": 31,
              "name": "Exodo 39:31",
              "text": "At kanilang tinalian ng isang panaling bughaw, upang ilapat sa ibabaw ng mitra; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 39,
              "verse": 32,
              "name": "Exodo 39:32",
              "text": "Gayon natapos ang buong gawa sa tabernakulo ng kapisanan: at ginawa ng mga anak ni Israel ayon sa buong iniutos ng Panginoon kay Moises: gayon ginawa nila."
            },
            {
              "chapter": 39,
              "verse": 33,
              "name": "Exodo 39:33",
              "text": "At kanilang dinala ang tabernakulo kay Moises, ang Tolda at ang lahat ng mga kasangkapan niyaon, ang mga kawit, ang mga tabla, ang mga barakilan, at ang mga haligi, at ang mga tungtungan;"
            },
            {
              "chapter": 39,
              "verse": 34,
              "name": "Exodo 39:34",
              "text": "At ang takip na mga balat ng mga tupa na tinina sa pula, at ang takip na balat ng mga poka, at ang lambong ng tabing;"
            },
            {
              "chapter": 39,
              "verse": 35,
              "name": "Exodo 39:35",
              "text": "Ang kaban ng patotoo at ang mga pingga niyaon, at ang luklukan ng awa;"
            },
            {
              "chapter": 39,
              "verse": 36,
              "name": "Exodo 39:36",
              "text": "Ang dulang, lahat ng mga sisidlan niyaon, at ang tinapay na handog;"
            },
            {
              "chapter": 39,
              "verse": 37,
              "name": "Exodo 39:37",
              "text": "Ang dalisay na kandelero, ang mga ilawan niyaon, ang mga ilawan na inayos, at lahat ng mga sisidlan niyaon, at ang langis na pangilawan;"
            },
            {
              "chapter": 39,
              "verse": 38,
              "name": "Exodo 39:38",
              "text": "At ang dambanang ginto, at ang langis na pangpahid, ang mabangong kamangyan, at ang tabing na gamit sa pintuan ng Tolda;"
            },
            {
              "chapter": 39,
              "verse": 39,
              "name": "Exodo 39:39",
              "text": "Ang dambanang tanso, at ang pinakasalang tanso, ang mga pingga at ang lahat ng mga sisidlan niyaon, ang hugasan at ang tungtungan;"
            },
            {
              "chapter": 39,
              "verse": 40,
              "name": "Exodo 39:40",
              "text": "Ang mga tabing ng looban, ang mga haligi, at ang mga tungtungan at ang tabing na pangpintuang-daan ng looban, ang mga panali, at ang mga tulos, at lahat ng mga kasangkapan sa paglilingkod sa tabernakulo, na gamit sa tabernakulo ng kapisanan;"
            },
            {
              "chapter": 39,
              "verse": 41,
              "name": "Exodo 39:41",
              "text": "Ang maiinam na pagkayaring kasuutan na gamit sa pangangasiwa sa dakong banal, at ang mga banal na kasuutan para kay Aaron na saserdote, at ang mga kasuutan ng kaniyang mga anak, upang mangasiwa sa katungkulang saserdote."
            },
            {
              "chapter": 39,
              "verse": 42,
              "name": "Exodo 39:42",
              "text": "Ayon sa lahat na iniutos ng Panginoon kay Moises, ay gayon ginawa ng mga anak ni Israel ang lahat ng gawa."
            },
            {
              "chapter": 39,
              "verse": 43,
              "name": "Exodo 39:43",
              "text": "At nakita ni Moises ang lahat ng gawain, at, narito, kanilang nagawa na kung paanong iniutos ng Panginoon ay gayon nila ginawa: at pinagbabasbasan ni Moises."
            }
          ]
        },
        {
          "chapter": 40,
          "name": "Exodo 40",
          "verses": [
            {
              "chapter": 40,
              "verse": 1,
              "name": "Exodo 40:1",
              "text": "At sinalita ng Panginoon kay Moises na sinasabi,"
            },
            {
              "chapter": 40,
              "verse": 2,
              "name": "Exodo 40:2",
              "text": "Sa unang araw ng unang buwan ay iyong itatayo ang tabernakulo ng kapisanan."
            },
            {
              "chapter": 40,
              "verse": 3,
              "name": "Exodo 40:3",
              "text": "At iyong isisilid doon ang kaban ng patotoo, at iyong tatabingan ang kaban ng lambong."
            },
            {
              "chapter": 40,
              "verse": 4,
              "name": "Exodo 40:4",
              "text": "At iyong ipapasok ang dulang, at iyong aayusin ang mga bagay na nasa ibabaw niyaon; at iyong ipapasok ang kandelero at iyong sisindihan ang mga ilawan niyaon."
            },
            {
              "chapter": 40,
              "verse": 5,
              "name": "Exodo 40:5",
              "text": "At iyong ilalagay ang dambanang ginto para sa kamangyan sa harap ng kaban ng patotoo, at ilalagay mo ang tabing ng pintuan sa tabernakulo."
            },
            {
              "chapter": 40,
              "verse": 6,
              "name": "Exodo 40:6",
              "text": "At iyong ilalagay ang dambanang pagsusunugan ng handog sa harap ng pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 40,
              "verse": 7,
              "name": "Exodo 40:7",
              "text": "At iyong ilalagay ang hugasan sa pagitan ng tabernakulo at ng dambana, at iyong sisidlan ng tubig."
            },
            {
              "chapter": 40,
              "verse": 8,
              "name": "Exodo 40:8",
              "text": "At iyong ilalagay ang looban sa palibot, at ibibitin mo ang tabing sa pintuang daan ng looban."
            },
            {
              "chapter": 40,
              "verse": 9,
              "name": "Exodo 40:9",
              "text": "At kukuha ka ng langis na pangpahid, at papahiran mo ang tabernakulo, at lahat na nandoon, at iyong pakakabanalin, at lahat ng kasangkapan niyaon: at magiging banal."
            },
            {
              "chapter": 40,
              "verse": 10,
              "name": "Exodo 40:10",
              "text": "At iyong papahiran ng langis ang dambanang pagsusunugan ng handog, at ang lahat ng kasangkapan, at iyong pakakabanalin ang dambana: at ang dambana ay magiging kabanalbanalan."
            },
            {
              "chapter": 40,
              "verse": 11,
              "name": "Exodo 40:11",
              "text": "At iyong papahiran din naman ng langis ang hugasan at ang tungtungan, at iyong pakakabanalin."
            },
            {
              "chapter": 40,
              "verse": 12,
              "name": "Exodo 40:12",
              "text": "At iyong dadalhin si Aaron at ang kaniyang mga anak sa pintuan ng tabernakulo ng kapisanan, at iyong paliliguan ng tubig."
            },
            {
              "chapter": 40,
              "verse": 13,
              "name": "Exodo 40:13",
              "text": "At iyong isusuot kay Aaron ang mga banal na kasuutan; at iyong papahiran ng langis siya, at iyong papagbanalin siya, upang siya'y makapangasiwa sa akin sa katungkulang saserdote."
            },
            {
              "chapter": 40,
              "verse": 14,
              "name": "Exodo 40:14",
              "text": "At iyong dadalhin ang kaniyang mga anak, at iyong susuutan sila ng mga kasuutan:"
            },
            {
              "chapter": 40,
              "verse": 15,
              "name": "Exodo 40:15",
              "text": "At iyong papahiran ng langis sila gaya ng iyong pagkapahid sa kanilang ama, upang sila'y makapangasiwa sa akin sa katungkulang saserdote, at ang pagpapahid sa kanila ay maging sa kanila'y pinakatanda ng walang hanggang pagka-saserdote sa buong panahon ng kanilang lahi."
            },
            {
              "chapter": 40,
              "verse": 16,
              "name": "Exodo 40:16",
              "text": "Gayon ginawa ni Moises, ayon sa lahat ng iniutos ng Panginoon sa kaniya, ay gayong ginawa niya."
            },
            {
              "chapter": 40,
              "verse": 17,
              "name": "Exodo 40:17",
              "text": "At nangyari sa unang buwan nang ikalawang taon nang unang araw ng buwan, na ang tabernakulo'y itinayo."
            },
            {
              "chapter": 40,
              "verse": 18,
              "name": "Exodo 40:18",
              "text": "At itinayo ni Moises ang tabernakulo, at inilagay ang mga tungtungan, at ipinatong ang mga malaking tabla, at isinuot ang mga barakilan, at itinayo ang mga haligi niyaon."
            },
            {
              "chapter": 40,
              "verse": 19,
              "name": "Exodo 40:19",
              "text": "At kaniyang inunat ang tolda sa ibabaw ng tabernakulo, at kaniyang inilagay ang takip ng tabernakulo sa itaas ng ibabaw niyaon; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 20,
              "name": "Exodo 40:20",
              "text": "At kaniyang kinuha at inilagay ang mga tabla ng patotoo sa loob ng kaban, at kaniyang inilagay ang mga pingga sa kaban, at kaniyang inilagay ang luklukan ng awa sa itaas ng ibabaw ng kaban:"
            },
            {
              "chapter": 40,
              "verse": 21,
              "name": "Exodo 40:21",
              "text": "At kaniyang ipinasok ang kaban sa tabernakulo, at inayos ang lambong ng tabing, at tinabingan ang kaban ng patotoo: gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 22,
              "name": "Exodo 40:22",
              "text": "At kaniyang inilagay ang dulang sa loob ng tabernakulo ng kapisanan, sa dakong hilagaan ng tabernakulo, sa labas ng lambong."
            },
            {
              "chapter": 40,
              "verse": 23,
              "name": "Exodo 40:23",
              "text": "At kaniyang inayos ang tinapay sa ibabaw ng dulang sa harap ng Panginoon, gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 24,
              "name": "Exodo 40:24",
              "text": "At kaniyang inilagay ang kandelero sa tabernakulo ng kapisanan, sa tapat ng dulang, sa tagilirang timugan ng tabernakulo."
            },
            {
              "chapter": 40,
              "verse": 25,
              "name": "Exodo 40:25",
              "text": "At kaniyang sinindihan ang mga ilawan sa harap ng Panginoon; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 26,
              "name": "Exodo 40:26",
              "text": "At kaniyang inilagay ang dambanang ginto sa loob ng tabernakulo ng kapisanan sa harap ng lambong."
            },
            {
              "chapter": 40,
              "verse": 27,
              "name": "Exodo 40:27",
              "text": "At siya'y nagsunog doon ng kamangyan na mabangong espesia; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 28,
              "name": "Exodo 40:28",
              "text": "At kaniyang inilagay ang tabing ng pintuan sa tabernakulo."
            },
            {
              "chapter": 40,
              "verse": 29,
              "name": "Exodo 40:29",
              "text": "At kaniyang inilagay ang dambanang pagsusunugan ng handog sa pintuan ng tabernakulo ng kapisanan, at pinaghandugan ng handog na susunugin, at ng handog na harina; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 30,
              "name": "Exodo 40:30",
              "text": "At kaniyang inilagay ang hugasan sa pagitan ng tabernakulo, ng kapisanan at ng dambana, at sinidlan ng tubig upang paghugasan."
            },
            {
              "chapter": 40,
              "verse": 31,
              "name": "Exodo 40:31",
              "text": "At si Moises at si Aaron at ang kaniyang mga anak, ay nagsipaghugas doon ng kanilang mga kamay at ng kanilang mga paa;"
            },
            {
              "chapter": 40,
              "verse": 32,
              "name": "Exodo 40:32",
              "text": "Pagka sila'y pumapasok sa tabernakulo ng kapisanan, at pagka sila'y lumalapit sa dambana ay naghuhugas sila: gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 40,
              "verse": 33,
              "name": "Exodo 40:33",
              "text": "At kaniyang inilagay ang looban sa palibot ng tabernakulo at ng dambana, at iniayos ang tabing ng pintuang daan ng looban. Gayon tinapos ni Moises ang gawain."
            },
            {
              "chapter": 40,
              "verse": 34,
              "name": "Exodo 40:34",
              "text": "Nang magkagayo'y tinakpan ng ulap ang tabernakulo ng kapisanan, at pinuno ng Panginoon ng kaluwalhatian ang tabernakulo."
            },
            {
              "chapter": 40,
              "verse": 35,
              "name": "Exodo 40:35",
              "text": "At si Moises ay hindi makapasok sa tabernakulo ng kapisanan, sapagka't lumagay sa ibabaw niyaon ang ulap, at pinuspos ng Panginoon ng kaluwalhatian ang tabernakulo."
            },
            {
              "chapter": 40,
              "verse": 36,
              "name": "Exodo 40:36",
              "text": "At pagka ang ulap ay napaiitaas mula sa tabernakulo, ay nagpapatuloy ang mga anak ni Israel sa kanilang buong paglalakbay:"
            },
            {
              "chapter": 40,
              "verse": 37,
              "name": "Exodo 40:37",
              "text": "Datapuwa't kung ang ulap ay hindi napaiitaas, ay hindi nga sila naglalakbay hanggang sa araw na napaiitaas."
            },
            {
              "chapter": 40,
              "verse": 38,
              "name": "Exodo 40:38",
              "text": "Sapagka't ang ulap ng Panginoon ay nasa ibabaw ng tabernakulo sa araw, at may apoy sa loob niyaon sa gabi, sa paningin ng buong lahi ng Israel, sa kanilang buong paglalakbay."
            }
          ]
        }
      ]
    },
    {
      "nr": 3,
      "name": "Levitico",
      "chapters": [
        {
          "chapter": 1,
          "name": "Levitico 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Levitico 1:1",
              "text": "At tinawag ng Panginoon si Moises at sinalita sa kaniya mula sa tabernakulo ng kapisanan, na sinasabi,"
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Levitico 1:2",
              "text": "Salitain mo sa mga anak ni Israel at sabihin mo sa kanila, Pagka ang sinoman sa inyo ay naghahandog ng alay sa Panginoon, ang ihahandog ninyong alay ay galing sa mga hayop, sa mga bakahan at sa kawan."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Levitico 1:3",
              "text": "Kung ang kaniyang alay ay handog na susunugin na kinuha sa bakahan, ang ihahandog niya'y isang lalake na walang kapintasan: sa pintuan ng tabernakulo ng kapisanan ihahandog niya, upang tanggapin sa harap ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Levitico 1:4",
              "text": "At ipapatong niya ang kaniyang kamay sa ulo ng handog na susunugin; at tatanggapin sa ikagagaling niya, upang gumawa ng pakikipagkasundo sa kaniya."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Levitico 1:5",
              "text": "At kaniyang papatayin ang guyang toro sa harap ng Panginoon: at ang mga anak ni Aaron, ang mga saserdote, ay siyang mangaghaharap ng dugo at iwiwisik ang dugo sa palibot ng dambana na nasa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Levitico 1:6",
              "text": "At lalaplapin ang handog na susunugin, at kakatayin."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Levitico 1:7",
              "text": "At ang mga anak ni Aaron na saserdote ay magsisipaglagay ng apoy sa ibabaw ng dambana, at magsisipagayos ng kahoy sa apoy;"
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Levitico 1:8",
              "text": "At aayusin ng mga anak ni Aaron, na mga saserdote, ang mga pinagputolputol, ang ulo, at ang taba, sa kahoy na nakapatong sa apoy na nasa ibabaw ng dambana:"
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Levitico 1:9",
              "text": "Datapuwa't ang mga lamang loob at ang mga paa, ay huhugasan niya ng tubig. At susunugin ng saserdote ang kabuoan sa ibabaw ng dambana na pinakahandog na susunugin, isang handog nga na pinaraan sa apoy na pinakamasarap na amoy sa Panginoon."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Levitico 1:10",
              "text": "At kung ang kaniyang alay ay kinuha sa kawan, sa mga tupa, o sa mga kambing, na pinakahandog na susunugin; ang kaniyang ihahandog ay isang lalaking walang kapintasan."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Levitico 1:11",
              "text": "At kaniyang papatayin sa dakong hilagaan ng dambana, sa harap ng Panginoon: at iwiwisik ng mga anak ni Aaron, na mga saserdote, ang dugo niyaon sa ibabaw ng dambana sa palibot."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Levitico 1:12",
              "text": "At kaniyang kakatayin pati ang ulo, at ang taba; at mga iaayos ng saserdote sa ibabaw ng kahoy na nasa apoy sa ibabaw ng dambana;"
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Levitico 1:13",
              "text": "Datapuwa't ang mga lamang loob at ang mga paa ay huhugasan ng tubig. At ihahandog ng saserdote ang kabuoan, at susunugin sa dambana: isa ngang handog na susunugin na isang handog na pinaraan sa apoy na pinakamasarap na amoy sa Panginoon."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Levitico 1:14",
              "text": "At kung ang kaniyang alay sa Panginoon ay handog na susunugin na mga ibon, ang ihahandog nga niyang alay ay mga batobato o mga inakay ng kalapati."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Levitico 1:15",
              "text": "At dadalhin ng saserdote sa dambana, at pupugutan ng ulo yaon, at susunugin sa ibabaw ng dambana; at ang dugo'y pipigain sa tabi ng dambana:"
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Levitico 1:16",
              "text": "At aalisin niya ang butsi pati ang mga balahibo, at ihahagis sa tabi ng dambana, sa dakong silanganan, sa kinalalagyan ng mga abo:"
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Levitico 1:17",
              "text": "At babaakin na hahawakan sa mga pakpak, datapuwa't hindi pakakahatiin. At susunugin ng saserdote sa ibabaw ng dambana, sa ibabaw ng kahoy na nasa apoy: isa ngang handog na susunugin, na isang handog na pinaraan sa apoy na pinakamasarap na amoy sa Panginoon."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Levitico 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Levitico 2:1",
              "text": "At pagka ang sinoman ay maghahandog sa Panginoon ng alay na handog na harina, ay mainam na harina ang kaniyang iaalay; at kaniyang bubuhusan ng langis, at lalagyan ng kamangyan:"
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Levitico 2:2",
              "text": "At dadalhin niya sa mga saserdote, na mga anak ni Aaron; at siya'y kukuha ng isang dakot na mainam na harina at ng langis, sangpu ng buong kamangyan niyaon. At susunugin ng saserdote sa ibabaw ng dambana na pinakaalaala, na isang handog nga na pinaraan sa apoy na pinakamasarap na amoy sa Panginoon:"
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Levitico 2:3",
              "text": "At ang kalabisan sa handog na harina ay mapapasa kay Aaron at sa kaniyang mga anak: kabanalbanalang bagay nga sa mga handog sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Levitico 2:4",
              "text": "At pagka ikaw ay maghahandog ng alay na handog na harina na luto sa hurno, ay mga munting tinapay na walang lebadura ang iaalay mo na mainam na harina, na hinaluan ng langis, o mga manipis na tinapay na walang lebadura, na hinaluan ng langis."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Levitico 2:5",
              "text": "At kung ang iyong alay ay handog na harina, na luto sa kawali, ay mainam na harina ang iaalay mo na walang lebadura, na hinaluan ng langis."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Levitico 2:6",
              "text": "Iyong pagpuputolputulin, at bubuhusan mo ng langis: isa ngang handog na harina."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Levitico 2:7",
              "text": "At kung ang iyong alay ay handog na harina na luto sa kawaling bakal, ay yari sa mainam na harina na may langis ang iaalay mo."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Levitico 2:8",
              "text": "At dadalhin mo sa Panginoon ang handog na harina na yari sa mga bagay na ito: at ihaharap sa saserdote at dadalhin niya sa dambana."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Levitico 2:9",
              "text": "At kukuha ang saserdote ng handog na harina, na pinakaalaala rin niyaon, at susunugin sa ibabaw ng dambana: handog ngang pinaraan sa apoy, na pinakamasarap na amoy sa Panginoon."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Levitico 2:10",
              "text": "At ang kalabisan sa handog na harina ay mapapasa kay Aaron at sa kaniyang mga anak; kabanalbanalang bagay nga sa mga handog sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Levitico 2:11",
              "text": "Walang handog na harina na ihahandog kayo sa Panginoon, na magkakalebadura: sapagka't huwag kayong magsusunog ng anomang lebadura ni ng anomang pulot na pinaka handog, sa Panginoon, na pinaraan sa apoy."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Levitico 2:12",
              "text": "Bilang pinakaalay na mga pangunang bunga ihahandog ninyo sa Panginoon: nguni't hindi sasampa sa dambana na parang masarap na amoy."
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Levitico 2:13",
              "text": "At titimplahan mo ng asin ang lahat ng alay na iyong handog na harina, ni huwag mong titiising magkulang sa iyong handog na harina ng asin ng tipan ng iyong Dios: lahat ng alay mo'y ihahandog mong may asin."
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Levitico 2:14",
              "text": "At kung maghahandog ka sa Panginoon ng handog na harina na pangunang bunga, ay ihahandog mong pinakahandog na harina ng iyong pangunang bunga ay sinangag sa apoy, mga murang butil na pinipi."
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Levitico 2:15",
              "text": "At bubuhusan mo ng langis yaon, at lalagyan mo sa ibabaw ng kamangyan: yaon nga'y handog na harina."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Levitico 2:16",
              "text": "At susunugin ng saserdote na nakaalaala niyaon, ang bahagi ng butil na pinipi at ang bahagi ng langis, pati ng buong kamangyan niyaon: handog nga sa Panginoon na pinaraan sa apoy."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Levitico 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Levitico 3:1",
              "text": "At kung ang kanilang alay ay haing mga handog tungkol sa kapayapaan; kung ang ihahandog niya ay sa bakahan maging lalake o babae, ay ihahandog niya na walang kapintasan sa harap ng Panginoon."
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Levitico 3:2",
              "text": "At kaniyang ipapatong ang kamay niya sa ulo ng kaniyang alay, at papatayin sa pintuan ng tabernakulo ng kapisanan: at iwiwisik ng mga anak ni Aaron, na mga saserdote, ang dugo sa ibabaw ng dambana, sa palibot."
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Levitico 3:3",
              "text": "At kaniyang ihahandog hinggil sa haing mga handog tungkol sa kapayapaan, na pinakahandog sa Panginoon na pinaraan sa apoy; ang tabang nakatatakip ng lamang loob at lahat ng tabang nasa ibabaw ng lamang loob,"
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Levitico 3:4",
              "text": "At ang dalawang bato at ang tabang nasa ibabaw ng mga yaon, ang nasa siping ng mga balakang, at ang lamad na nasa ibabaw ng atay ay kaniyang aalisin na kalakip ng mga bato."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Levitico 3:5",
              "text": "At susunugin ng mga anak ni Aaron sa dambana, sa ibabaw ng handog na susunugin na nasa ibabaw ng kahoy na nakapatong sa apoy; handog ngang pinaraan sa apoy, na pinakamasarap na amoy sa Panginoon."
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Levitico 3:6",
              "text": "At kung ang kaniyang alay sa Panginoon na pinakahaing mga handog tungkol sa kapayapaan ay kinuha sa kawan; maging lalake o babae, ay ihahandog niya na walang kapintasan."
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Levitico 3:7",
              "text": "Kung isang kordero ang kaniyang ihahandog na pinakaalay niya, ay ihahandog nga niya sa harap ng Panginoon:"
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Levitico 3:8",
              "text": "At kaniyang ipapatong ang kamay niya sa ulo ng kaniyang alay, at papatayin sa harap ng tabernakulo ng kapisanan: at iwiwisik ng mga anak ni Aaron ang dugo niyaon sa ibabaw ng dambana sa palibot."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Levitico 3:9",
              "text": "At kaniyang ihahandog hinggil sa hain na mga handog tungkol sa kapayapaan ay isang handog sa Panginoon na pinaraan sa apoy; ang taba niyaon, ang buong matabang buntot, ay aalisin niya sa siping ng gulugod; at ang tabang nakatatakip ng lamang loob, at ang lahat ng tabang nasa ibabaw ng lamang loob."
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Levitico 3:10",
              "text": "At ang dalawang bato, at ang tabang nasa ibabaw niyaon, na malapit sa mga balakang, at ang lamad na nasa ibabaw ng atay, ay aalisin niya na kalakip ng mga bato."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Levitico 3:11",
              "text": "At susunugin ng saserdote sa ibabaw ng dambana: pagkaing handog nga sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Levitico 3:12",
              "text": "At kung kambing ang kaniyang alay ay ihahandog nga niya sa harap ng Panginoon:"
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Levitico 3:13",
              "text": "At ipapatong niya ang kaniyang kamay sa ulo niyaon, at papatayin yaon sa harap ng tabernakulo ng kapisanan: at iwiwisik ng mga anak ni Aaron ang dugo sa ibabaw ng dambana sa palibot."
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Levitico 3:14",
              "text": "At ang ihahandog niya roon na kaniyang alay, na pinakahandog sa Panginoon, na pinaraan sa apoy; ang tabang nakatatakip ng lamang loob, lahat ng tabang nasa ibabaw ng lamang loob,"
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Levitico 3:15",
              "text": "At ang dalawang bato, at ang tabang nasa ibabaw, na malapit sa mga balakang, at ang lamad na nasa ibabaw ng atay, ay aalisin niya na kalakip ng mga bato."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Levitico 3:16",
              "text": "At mga susunugin ng saserdote sa ibabaw ng dambana; pagkaing handog nga na pinaraan sa apoy na pinakamasarap na amoy: lahat ng taba ay sa Panginoon."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Levitico 3:17",
              "text": "Magiging palatuntunang palagi sa buong panahon ng inyong lahi, sa lahat ng inyong tahanan na hindi kayo kakain ng taba ni dugo man."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Levitico 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Levitico 4:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Levitico 4:2",
              "text": "Salitain mo sa mga anak ni Israel, na iyong sabihin, Kung ang sinoman ay magkakasala ng hindi sinasadya sa alin man sa mga bagay na iniutos ng Panginoon na huwag gawin, at gagawin ng sinoman sa kanila;"
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Levitico 4:3",
              "text": "Kung ang pinahirang saserdote ang magkasala ng gayon na magdala ng sala sa bayan, ay maghahandog nga siya sa Panginoon dahil sa kaniyang kasalanan na ipinagkasala, ng isang guyang toro, na walang kapintasan, na pinakahandog dahil sa kasalanan."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Levitico 4:4",
              "text": "At dadalhin niya ang toro sa pintuan ng tabernakulo ng kapisanan sa harap ng Panginoon: at ipapatong niya ang kaniyang kamay sa ulo ng toro, at papatayin ang toro sa harap ng Panginoon."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Levitico 4:5",
              "text": "At ang pinahiran ng langis na saserdote ay kukuha ng dugo ng toro, at dadalhin sa tabernakulo ng kapisanan:"
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Levitico 4:6",
              "text": "At ilulubog ng saserdote ang kaniyang daliri sa dugo, at magwiwisik na makapito ng dugo sa harap ng Panginoon, sa tapat ng tabing ng santuario."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Levitico 4:7",
              "text": "At ang saserdote ay maglalagay ng dugong yaon sa ibabaw ng mga anyong sungay ng dambana ng mabangong kamangyan sa harap ng Panginoon, na nasa tabernakulo ng kapisanan: at lahat ng dugo ng toro ay ibubuhos sa paanan ng dambanang pagsusunugan ng handog na nasa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Levitico 4:8",
              "text": "At aalisin ang lahat ng taba ng toro na handog dahil sa kasalanan; ang tabang nakakatakip sa lamang loob, at ang lahat ng tabang nasa ibabaw ng lamang loob,"
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Levitico 4:9",
              "text": "At ang dalawang bato at ang tabang nasa ibabaw, na malapit sa mga balakang, at ang lamad na nasa ibabaw ng atay, ay aalisin na kalakip ng mga bato,"
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Levitico 4:10",
              "text": "Na gaya ng pagaalis ng sa toro na hain na mga handog tungkol sa kapayapaan: at susunugin ng saserdote sa ibabaw ng dambanang pagsusunugan ng handog."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Levitico 4:11",
              "text": "At ang balat ng toro at ang buong laman pati ng ulo at ng mga hita, at ng lamang loob, at ng dumi,"
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Levitico 4:12",
              "text": "Sa makatuwid baga'y ang buong toro ay ilalabas niya sa labas ng kampamento sa isang dakong malinis, na pinagtatapunan ng mga abo, at doon susunugin sa apoy sa ibabaw ng kahoy: sa pinagtatapunan ng mga abo susunugin yaon."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Levitico 4:13",
              "text": "At kung ang buong kapisanan ng Israel ay magkasala, at ang bagay ay malihim sa mga mata ng kapulungan, at sila'y nakagawa ng anoman sa mga bagay na iniutos ng Panginoon na huwag gawin, at naging salarin;"
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Levitico 4:14",
              "text": "Pagka nakilala ang kasalanan ng kanilang ipinagkasala, ay maghahandog nga ang kapisanan ng isang guyang toro na pinakahandog dahil sa kasalanan, at dadalhin sa harap ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Levitico 4:15",
              "text": "At ipapatong ng mga matanda ng kapulungan, ang kanilang kamay sa ulo ng toro sa harap ng Panginoon: at papatayin ang toro sa harap ng Panginoon."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Levitico 4:16",
              "text": "At ang saserdoteng pinahiran ng langis ay magdadala ng dugo ng toro sa tabernakulo ng kapisanan:"
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Levitico 4:17",
              "text": "At ilulubog ng saserdote ang kaniyang daliri sa dugo, at iwiwisik na makapito sa harap ng Panginoon, sa harap ng tabing."
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Levitico 4:18",
              "text": "At maglalagay siya ng dugo sa ibabaw ng mga anyong sungay ng dambana na nasa harap ng Panginoon, na nasa tabernakulo ng kapisanan, at ang lahat ng dugo ay ibubuhos niya sa paanan ng dambanang pagsusunugan ng handog na nasa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Levitico 4:19",
              "text": "At aalisin niya ang lahat ng taba niyaon, at susunugin niya sa ibabaw ng dambana."
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Levitico 4:20",
              "text": "Gayon ang gagawin niya sa toro; kung paano ang ginawa niya sa torong handog dahil sa kasalanan, ay gayon gagawin niya rito: at itutubos sa kanila ng saserdote, at patatawarin sila."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Levitico 4:21",
              "text": "At ilalabas niya ang toro sa kampamento, at susunugin niya, na gaya ng pagkasunog sa unang toro: handog nga dahil sa kasalanan ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "Levitico 4:22",
              "text": "Pagka ang isang pinuno ay nagkasala, at nakagawa ng hindi sinasadya sa alinman sa lahat ng bagay na iniutos ng Panginoon niyang Dios na huwag gawin, at siya'y naging salarin;"
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "Levitico 4:23",
              "text": "Kung maipakilala sa kaniya ang kasalanan niyang ipinagkasala, ay magdadala siya ng pinakaalay niya na isang lalaking kambing na walang kapintasan;"
            },
            {
              "chapter": 4,
              "verse": 24,
              "name": "Levitico 4:24",
              "text": "At ipapatong niya ang kaniyang kamay sa ulo ng kambing, at papatayin niya sa dakong pinagpapatayan ng handog na susunugin sa harap ng Panginoon: handog nga dahil sa kasalanan."
            },
            {
              "chapter": 4,
              "verse": 25,
              "name": "Levitico 4:25",
              "text": "At dadampot ang saserdote sa pamamagitan ng kaniyang daliri, ng dugo ng handog dahil sa kasalanan at ilalagay sa ibabaw ng mga anyong sungay ng dambanang pagsusunugan ng handog, at ang dugo'y ibubuhos sa paanan ng dambanang pagsusunugan ng handog."
            },
            {
              "chapter": 4,
              "verse": 26,
              "name": "Levitico 4:26",
              "text": "At ang lahat ng taba niyaon ay susunugin niya sa dambana, na gaya ng taba ng hain na mga handog tungkol sa kapayapaan: at itutubos sa kaniya ng saserdote tungkol sa kaniyang kasalanan, at siya'y patatawarin."
            },
            {
              "chapter": 4,
              "verse": 27,
              "name": "Levitico 4:27",
              "text": "At kung ang sinomang karaniwang tao sa bayan ay magkasala ng hindi sinasadya, sa paggawa sa alinman sa mga bagay na iniutos ng Panginoon na huwag gawin, at maging makasalanan;"
            },
            {
              "chapter": 4,
              "verse": 28,
              "name": "Levitico 4:28",
              "text": "Kung maipakilala sa kaniya ang kasalanan niyang pinagkasalahan, ay magdadala siya ng pinakaalay niya na isang babaing kambing na walang kapintasan, na dahil sa kaniyang kasalanang pinagkasalahan niya."
            },
            {
              "chapter": 4,
              "verse": 29,
              "name": "Levitico 4:29",
              "text": "At ipapatong niya ang kaniyang kamay sa ulo ng handog dahil sa kasalanan, at papatayin ang handog dahil sa kasalanan sa lagayan ng pagsusunugan ng handog."
            },
            {
              "chapter": 4,
              "verse": 30,
              "name": "Levitico 4:30",
              "text": "At dadampot ang saserdote sa pamamagitan ng kaniyang daliri ng dugo at ilalagay sa ibabaw ng mga anyong sungay ng dambanang pagsusunugan ng handog, at ang lahat ng dugo niyaon ay ibubuhos niya sa paanan ng dambana."
            },
            {
              "chapter": 4,
              "verse": 31,
              "name": "Levitico 4:31",
              "text": "At ang lahat ng taba niyaon ay kaniyang aalisin, na gaya ng pagaalis ng taba sa hain na mga handog tungkol sa kapayapaan; at susunugin ng saserdote sa dambana na pinakamasarap na amoy sa Panginoon; at itutubos sa kaniya ng saserdote, at siya'y patatawarin."
            },
            {
              "chapter": 4,
              "verse": 32,
              "name": "Levitico 4:32",
              "text": "At kung kordero ang kaniyang dalhing pinakaalay na bilang handog dahil sa kasalanan, ay babaing walang kapintasan ang dadalhin niya."
            },
            {
              "chapter": 4,
              "verse": 33,
              "name": "Levitico 4:33",
              "text": "At ipapatong niya ang kaniyang kamay sa ulo ng handog dahil sa kasalanan, at papatayin na pinakahandog dahil sa kasalanan, sa pinagpapatayan ng handog na susunugin."
            },
            {
              "chapter": 4,
              "verse": 34,
              "name": "Levitico 4:34",
              "text": "At dadampot ang saserdote sa pamamagitan ng kaniyang daliri ng dugo ng handog dahil sa kasalanan, at ilalagay sa ibabaw ng mga anyong sungay ng dambanang pagsusunugan ng handog, at ang lahat ng dugo ay ibubuhos niya sa paanan ng dambana:"
            },
            {
              "chapter": 4,
              "verse": 35,
              "name": "Levitico 4:35",
              "text": "At ang lahat ng taba ay kaniyang aalisin, gaya ng pagkaalis ng taba sa kordero na hain na mga handog tungkol sa kapayapaan; at susunugin ng saserdote sa dambana, sa ibabaw ng mga handog sa Panginoon na pinaraan sa apoy: at itutubos sa kaniya ng saserdote tungkol sa kasalanan na kaniyang pinagkasalahan; at siya'y patatawarin."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Levitico 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Levitico 5:1",
              "text": "At kung ang sinoman ay magkasala, sa pagkarinig niya ng tinig ng pautos, sa paraang siya'y saksi maging kaniyang nakita o nalaman, kung hindi niya ihayag, ay siya nga ang magtataglay ng kasamaan niya."
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Levitico 5:2",
              "text": "O kung ang sinoman ay nakahipo ng alinmang bagay na karumaldumal, maging bangkay ng ganid na karumaldumal, o ng bangkay na hayop na karumaldumal, o ng bangkay ng umuusad na karumaldumal, at nalihim sa kaniya, at siya'y maging karumaldumal, ay magiging makasalanan nga siya:"
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Levitico 5:3",
              "text": "O kung siya'y nakahipo ng karumaldumal ng tao, maging anomang karumaldumal niyaon na ikinapaging karumaldumal niya, at nalihim sa kaniya; pagka nalaman niya ay magiging makasalanan nga siya:"
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Levitico 5:4",
              "text": "O kung ang sinoma'y sumumpa ng kaniyang mga labi ng walang dilidili na gumawa ng masama o gumawa ng mabuti, maging anoman na sinasalita ng tao na walang dilidili na kaakbay ang sumpa, at sa kaniya'y nalihim; pagka nalaman niya yaon, ay magiging makasalanan nga siya sa isa sa mga bagay na ito:"
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Levitico 5:5",
              "text": "At mangyayari, na pagka siya'y magiging makasalanan sa isa sa mga bagay na ito, ay kaniyang isasaysay yaong kaniyang ipinagkasala:"
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Levitico 5:6",
              "text": "At dadalhin niya sa Panginoon ang handog niya dahil sa pagkakasala, dahil sa kasalanang pinagkasalahan niya, ay isang babae na kinuha sa kawan, isang kordero o isang kambing na pinakahandog dahil sa kasalanan; at itutubos sa kaniya ng saserdote tungkol sa kaniyang kasalanan."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Levitico 5:7",
              "text": "At kung ang kaniyang kaya ay hindi sapat upang magdala ng isang kordero, ay magdadala nga siya sa Panginoon, na pinakahandog niya sa pagkakasala, dahil sa ipinagkasala niya, ng dalawang batobato o ng dalawang inakay ng kalapati: ang isa'y pinakahandog dahil sa kasalanan at ang isa'y pinakahandog na susunugin."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Levitico 5:8",
              "text": "At sila'y dadalhin niya sa saserdote, na ang ihahandog nito na pinakahandog dahil sa kasalanan, ay ang una at pupugutin ang ulo sa leeg, nguni't hindi papaghihiwalaying bigla:"
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Levitico 5:9",
              "text": "At magwiwisik siya ng dugo ng handog dahil sa kasalanan sa ibabaw ng gilid ng dambana; at ang labis sa dugo ay pipigain sa paanan ng dambana: handog nga dahil sa kasalanan."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Levitico 5:10",
              "text": "At ihahandog niya ang ikalawa na pinakahandog na susunugin ayon sa alituntunin: at itutubos sa kaniya ng saserdote tungkol sa kaniyang kasalanan na kaniyang pinagkasalahan, at siya'y patatawarin."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Levitico 5:11",
              "text": "Datapuwa't kung ang kaniyang kaya ay hindi sapat upang magdala ng dalawang batobato, o ng dalawang inakay ng kalapati, ay magdadala nga siya ng ikasangpung bahagi ng isang epa ng mainam na harina, na pinakahandog dahil sa kasalanan niya; hindi niya lalagyan ng langis ni bubuhusan man niya ng kamangyan; sapagka't handog dahil sa kasalanan."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Levitico 5:12",
              "text": "At dadalhin niya sa saserdote, at ang saserdote ay kukuha ng kaniyang dakot sa pinaka alaala niyaon, na susunugin sa dambana; na gaya ng mga handog sa Panginoon na pinaraan sa apoy: handog nga dahil sa kasalanan."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Levitico 5:13",
              "text": "At itutubos sa kaniya ng saserdote, tungkol sa kasalanan na kaniyang pinagkasalahan sa alinman sa mga bagay na ito, at siya'y patatawarin: at ang labis ay mapapasa saserdote, gaya ng handog na harina."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Levitico 5:14",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Levitico 5:15",
              "text": "Kung ang sinoman ay makasuway at magkasala ng di sinasadya sa mga banal na bagay ng Panginoon; ay magdadala nga siya sa Panginoon ng handog dahil sa pagkakasala na isang tupang lalaking walang kapintasan na kinuha sa kawan, ayon sa iyong pagkahalaga sa siklong pilak, ayon sa siklo ng santuario na pinakahandog dahil sa pagkakasala:"
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Levitico 5:16",
              "text": "At isasauli niya yaong kaniyang nadaya sa banal na bagay, at magdaragdag pa ng ikalimang bahagi, at ibibigay niya sa saserdote: at itutubos sa kaniya ng saserdote sa pamamagitan ng lalaking tupang handog dahil sa pagkakasala; at siya'y patatawarin."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Levitico 5:17",
              "text": "At kung ang sinoman ay magkasala, at gumawa ng alin man sa mga bagay na iniutos ng Panginoon na huwag gawin; bagama't hindi niya nalalaman, makasalanan din siya at magtataglay siya ng kaniyang kasamaan."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Levitico 5:18",
              "text": "At siya'y magdadala sa saserdote ng isang tupang lalake na walang kapintasan na kinuha sa kawan ayon sa iyong pagkahalaga na pinakahandog dahil sa pagkakasala; at itutubos sa kaniya ng saserdote, tungkol sa bagay na pinagkamalian niya ng di sinasadya, at hindi niya nalalaman, at siya'y patatawarin."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Levitico 5:19",
              "text": "Yaon nga'y handog dahil sa pagkakasala: tunay ngang siya'y makasalanan sa harap ng Panginoon."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Levitico 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Levitico 6:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Levitico 6:2",
              "text": "Kung ang sinoman ay magkasala, at sumuway sa Panginoon, na magbulaan sa kaniyang kapuwa tungkol sa isang habilin, o sa isang sanla, o sa nakaw, o pumighati sa kaniyang kapuwa,"
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Levitico 6:3",
              "text": "O nakasumpong ng nawala, at ipagkaila at sumumpa ng kasinungalingan; sa alin man sa lahat ng ito na ginawa ng tao ng pinagkakasalahan:"
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Levitico 6:4",
              "text": "Ay mangyayari nga, na kung siya'y nagkasala at naging salarin, na isasauli niya ang ninakaw, o ang nakuha sa pagpighati, o ang habiling inihabilin sa kaniya, o ang bagay na nawala sa kaniyang nasumpungan,"
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Levitico 6:5",
              "text": "O anomang bagay na kaniyang sinumpaan ng kabulaanan; na isasauli niyang buo, at daragdagan pa niya ng ikalimang bahagi niyaon: sa may-ari ibibigay niya sa araw na pagkasumpong sa kaniya na siya'y may kasalanan."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Levitico 6:6",
              "text": "At dadalhin niya sa Panginoon ang kaniyang handog dahil sa pagkakasala, isang tupang lalake na walang kapintasan na kinuha sa kawan, ayon sa iyong pagkahalaga, at ibibigay sa saserdote na pinakahandog dahil sa pagkakasala:"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Levitico 6:7",
              "text": "At itutubos sa kaniya ng saserdote sa harap ng Panginoon; at siya'y patatawarin tungkol sa alin mang kaniyang nagawa, na kaniyang pinagkasalahan."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Levitico 6:8",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Levitico 6:9",
              "text": "Iutos mo kay Aaron at sa kaniyang mga anak, na iyong sabihin, Ito ang kautusan tungkol sa handog na susunugin: ang handog na susunugin ay malalagay sa ibabaw ng pinagsusunugan sa ibabaw ng dambana, buong gabi hanggang umaga; at ang apoy sa dambana ay papananatilihing nagniningas doon."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Levitico 6:10",
              "text": "At isusuot ng saserdote ang kaniyang kasuutang lino, at ang kaniyang mga salawal na kayong lino at itatakip niya sa kaniyang katawan; at dadamputin niya ang mga abo ng handog na susunugin na sinunog sa apoy sa ibabaw ng dambana, at ilalagay niya sa tabi ng dambana."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Levitico 6:11",
              "text": "At maghuhubad siya ng kaniyang mga suot, at magbibihis ng ibang mga kasuutan, at ilalabas ang mga abo sa labas ng kampamento sa isang dakong malinis."
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Levitico 6:12",
              "text": "At ang apoy sa ibabaw ng dambana ay papananatilihing nagniningas doon, hindi papatayin; at ang saserdote ay magsusunog ng kahoy sa ibabaw niyaon tuwing umaga: at aayusin niya sa ibabaw niyaon ang handog na susunugin, at susunugin sa ibabaw niyaon ang taba ng mga handog tungkol sa kapayapaan."
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Levitico 6:13",
              "text": "Ang apoy ay papananatilihing nagniningas sa ibabaw ng dambana; hindi papatayin."
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Levitico 6:14",
              "text": "At ito ang kautusan tungkol sa handog na harina: ihahandog ng mga anak ni Aaron sa harap ng Panginoon, sa harap ng dambana."
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Levitico 6:15",
              "text": "At kukuha siya niyaon ng kaniyang dakot, ng mainam na harina sa handog na harina, at ng langis niyaon, at ng lahat na kamangyan, na nasa ibabaw ng handog na harina, at kaniyang susunugin sa ibabaw ng dambana, na pinakamasarap na amoy, na alaala niyaon sa Panginoon."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Levitico 6:16",
              "text": "At ang labis sa handog ay kakanin ni Aaron at ng kaniyang mga anak: walang lebadurang kakanin sa dakong banal; sa looban ng tabernakulo ng kapisanan kakanin nila."
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Levitico 6:17",
              "text": "Hindi lulutuing may lebadura. Aking ibinigay sa kanilang pinakabahagi nila, sa mga handog sa akin na pinaraan sa apoy; kabanalbanalang bagay nga, na gaya ng handog dahil sa kasalanan, at gaya ng handog dahil sa pagkakasala."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Levitico 6:18",
              "text": "Bawa't lalake sa mga anak ni Aaron ay kakain niyaon na pinakabahagi nila magpakailan man, sa buong panahon ng inyong lahi, sa mga handog sa Panginoon na pinaraan sa apoy; sinomang humipo ng mga iyan ay magiging banal."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Levitico 6:19",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "Levitico 6:20",
              "text": "Ito ang alay ni Aaron at ng kaniyang mga anak na kanilang ihahandog sa Panginoon sa araw na siya'y pahiran ng langis; ang ikasangpung bahagi ng isang epa ng mainam na harina, na pinakahandog na harina magpakailan man, ang kalahati ay sa umaga at ang kalahati ay sa hapon."
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "Levitico 6:21",
              "text": "Sa kawali ihahandang may langis; pagkatigmak niyaon dadalhin mo: lutong putolputol na ihaharap mo ang handog na harina na pinaka masarap na amoy sa Panginoon."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "Levitico 6:22",
              "text": "At ang saserdoteng pinahiran ng langis na mahahalili sa kaniya, na mula sa gitna ng kaniyang mga anak ay maghahandog niyaon: ayon sa palatuntunang walang hanggan ay susunuging lahat sa Panginoon."
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "Levitico 6:23",
              "text": "At bawa't handog na harina ng saserdote ay susunuging lahat: hindi kakanin."
            },
            {
              "chapter": 6,
              "verse": 24,
              "name": "Levitico 6:24",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 25,
              "name": "Levitico 6:25",
              "text": "Salitain mo kay Aaron at sa kaniyang mga anak, na sabihin, Ito ang kautusan tungkol sa handog dahil sa kasalanan: sa dakong pinagpapatayan ng handog na susunugin ay doon papatayin ang handog dahil sa kasalanan, sa harap ng Panginoon; kabanalbanalang bagay nga."
            },
            {
              "chapter": 6,
              "verse": 26,
              "name": "Levitico 6:26",
              "text": "Ang saserdoteng maghandog niyaon dahil sa kasalanan ay kakain niyaon: sa dakong banal kakanin, sa looban ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 6,
              "verse": 27,
              "name": "Levitico 6:27",
              "text": "Anomang humipo ng laman niyaon ay magiging banal: at pagka pumilansik ang dugo sa alin mang damit, ay lalabhan mo yaong napilansikan sa dakong banal."
            },
            {
              "chapter": 6,
              "verse": 28,
              "name": "Levitico 6:28",
              "text": "Datapuwa't ang sisidlang lupa na pinaglutuan ay babasagin: at kung niluto sa sisidlang tanso ay lilinisin at babanlawan ng tubig."
            },
            {
              "chapter": 6,
              "verse": 29,
              "name": "Levitico 6:29",
              "text": "Bawa't lalake sa mga saserdote ay kakain niyaon: bagay ngang kabanalbanalan."
            },
            {
              "chapter": 6,
              "verse": 30,
              "name": "Levitico 6:30",
              "text": "At hindi kakanin ang anomang handog dahil sa kasalanan, kung may dugo niyao'y ipinasok sa tabernakulo ng kapisanan upang ipangtubos sa dakong banal: sa apoy nga susunugin."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Levitico 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Levitico 7:1",
              "text": "At ito ang kautusan tungkol sa handog dahil sa pagkakasala: bagay ngang kabanalbanalan."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Levitico 7:2",
              "text": "Sa dakong pinagpapatayan ng handog na susunugin ay doon papatayin ang handog dahil sa pagkakasala: at ang dugo niyao'y iwiwisik niya sa ibabaw ng dambana hanggang sa palibot."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Levitico 7:3",
              "text": "At siya'y maghahandog niyaon ng lahat ng taba niyaon; ang buntot na mataba at ang tabang nakatatakip sa lamang loob,"
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Levitico 7:4",
              "text": "At ang dalawang bato at ang tabang nasa ibabaw ng mga yaon, ang nasa siping ng mga balakang, at ang lamad na nasa ibabaw ng atay, ay kaniyang aalisin na kalakip ng mga bato:"
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Levitico 7:5",
              "text": "At susunugin ng saserdote sa ibabaw ng dambana na pinakahandog sa Panginoon na pinaraan sa apoy; handog nga dahil sa pagkakasala."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Levitico 7:6",
              "text": "Bawa't lalake sa mga saserdote ay kakain niyaon; sa dakong banal kakanin yaon: bagay ngang kabanalbanalan."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Levitico 7:7",
              "text": "Kung paano ang handog dahil sa kasalanan ay gayon ang handog dahil sa pagkakasala: ang dalawa'y may isang kautusan: mapapasa saserdoteng tumutubos."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Levitico 7:8",
              "text": "At ang saserdoteng naghahandog ng handog na susunugin ng sinomang tao, ay siyang magtatangkilik ng balat ng handog na susunugin na inihandog."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Levitico 7:9",
              "text": "At bawa't handog na harina na niluto sa hurno, at yaong lahat na pinagyaman sa kawaling bakal at sa kawaling lupa, ay mapapasa saserdote na naghahandog."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Levitico 7:10",
              "text": "At bawa't handog na harina na hinaluan ng langis o tuyo, ay mapapasa lahat ng anak ni Aaron; sa isa na gaya sa iba."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Levitico 7:11",
              "text": "At ito ang kautusan hinggil sa haing mga handog tungkol sa kapayapaan, na ihahandog sa Panginoon:"
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Levitico 7:12",
              "text": "Kung ihahandog niya na pinaka pasalamat, ay ihahandog nga niyang kalakip ng haing pasalamat ang mga munting tinapay na walang lebadura na hinaluan ng langis, at ang mga manipis na tinapay na walang lebadura na pinahiran ng langis, at ang mainam na harina na munting tinapay na hinaluan ng langis."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Levitico 7:13",
              "text": "Kalakip ng munting tinapay na walang lebadura kaniyang ihahandog ang alay niya, na kalakip ng haing mga handog tungkol sa kapayapaan na pinaka pasalamat."
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Levitico 7:14",
              "text": "At maghahandog ng isa niyaon na kaakbay ng bawa't alay na pinakahandog na itinaas sa Panginoon; mapapasa saserdoteng magwiwisik ng dugo ng mga handog tungkol sa kapayapaan."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Levitico 7:15",
              "text": "At ang laman ng hain na kaniyang mga handog tungkol sa kapayapaan na pinaka pasalamat ay kakanin sa kaarawan ng kaniyang pagaalay; siya'y hindi magtitira niyaon ng hanggang sa umaga."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Levitico 7:16",
              "text": "Nguni't kung ang hain ng kaniyang alay ay sa pagtupad ng isang panata, o kusang handog, ay kaniyang makakain sa araw na kaniyang ihandog ang kaniyang hain: at sa kinaumagahan man ay kaniyang makakain ang labis:"
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Levitico 7:17",
              "text": "Datapuwa't ang lumabis sa laman ng hain hanggang sa ikatlong araw ay susunugin sa apoy."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Levitico 7:18",
              "text": "At kung kanin sa ikatlong araw ang anomang bahagi ng laman ng haing kaniyang mga handog tungkol sa kapayapaan ay hindi tatanggapin, at hindi man maipatutungkol doon sa naghahandog niyaon: aariing kasuklamsuklam, at ang taong kumain niyaon ay magtataglay ng kaniyang kasamaan."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Levitico 7:19",
              "text": "At ang lamang masagi sa anomang bagay na karumaldumal ay hindi kakanin; yao'y susunugin sa apoy. At tungkol sa lamang hindi nahawa, lahat ng taong malinis ay makakakain niyaon."
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Levitico 7:20",
              "text": "Nguni't ang taong kumain ng laman ng haing mga handog tungkol sa kapayapaan na ukol sa Panginoon, na taglay niya ang kaniyang karumihan, ay ihihiwalay ang taong yaon sa kaniyang bayan."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Levitico 7:21",
              "text": "At pagka ang sinoman ay nakahipo ng anomang maruming bagay, ng dumi ng tao, o ng hayop na karumaldumal, o ng alin mang kasuklamsuklam, at kumain ng laman ng haing mga handog tungkol sa kapayapaan na ukol sa Panginoon, ay ihihiwalay ang taong yaon sa kaniyang bayan."
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Levitico 7:22",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Levitico 7:23",
              "text": "Iyong salitain sa mga anak ni Israel, na sabihin, Huwag kayong kakain ng taba ng baka, ng tupa, o ng kambing."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Levitico 7:24",
              "text": "At ang taba ng namatay sa kaniyang sarili, at ang taba ng nilapa ng ganid, ay magagamit sa alin mang kagamitan: nguni't sa anomang paraan ay huwag ninyong kakanin."
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "Levitico 7:25",
              "text": "Sapagka't sinomang kumain ng taba ng hayop na yaon na inihahandog ng mga tao sa Panginoon, na handog na pinaraan sa apoy, ay ihihiwalay sa kaniyang bayan ang taong kumain."
            },
            {
              "chapter": 7,
              "verse": 26,
              "name": "Levitico 7:26",
              "text": "At huwag kayong kakain sa anomang paraan ng dugo sa lahat ng inyong tahanan, maging sa ibon o sa hayop."
            },
            {
              "chapter": 7,
              "verse": 27,
              "name": "Levitico 7:27",
              "text": "Sinomang taong kumain ng alin mang dugo, ay ihihiwalay sa kaniyang bayan ang taong yaon."
            },
            {
              "chapter": 7,
              "verse": 28,
              "name": "Levitico 7:28",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 7,
              "verse": 29,
              "name": "Levitico 7:29",
              "text": "Iyong salitain sa mga anak ng Israel na sabihin, Ang naghahandog sa Panginoon ng hain niyang mga handog tungkol sa kapayapaan ay magdadala sa Panginoon ng kaniyang alay sa hain niyang mga handog tungkol sa kapayapaan;"
            },
            {
              "chapter": 7,
              "verse": 30,
              "name": "Levitico 7:30",
              "text": "Na dadalhin ng kaniyang sariling mga kamay sa Panginoon ang mga handog na pinaraan sa apoy; ang taba pati ng dibdib ay dadalhin niya, upang ang dibdib ay alugin na pinakahandog na inalog sa harap ng Panginoon."
            },
            {
              "chapter": 7,
              "verse": 31,
              "name": "Levitico 7:31",
              "text": "At susunugin ng saserdote ang taba sa ibabaw ng dambana: datapuwa't ang dibdib ay mapapasa kay Aaron at sa kaniyang mga anak."
            },
            {
              "chapter": 7,
              "verse": 32,
              "name": "Levitico 7:32",
              "text": "At ibibigay ninyo sa saserdote na pinakahandog na itinaas, ang hitang kanan sa mga haing inyong mga handog tungkol sa kapayapaan."
            },
            {
              "chapter": 7,
              "verse": 33,
              "name": "Levitico 7:33",
              "text": "Yaong sa mga anak ni Aaron na naghahandog ng dugo ng mga handog tungkol sa kapayapaan at ng taba, ay mapapasa kaniya ang kanang hita, na pinaka bahagi niya."
            },
            {
              "chapter": 7,
              "verse": 34,
              "name": "Levitico 7:34",
              "text": "Sapagka't aking kinuha sa mga anak ni Israel, sa kanilang mga haing mga handog tungkol sa kapayapaan, ang dibdib na inalog at ang hitang itinaas, at aking ibinigay kay Aaron na saserdote at sa kaniyang mga anak, na karampatang bahagi nila magpakailan man, sa ganang mga anak ni Israel."
            },
            {
              "chapter": 7,
              "verse": 35,
              "name": "Levitico 7:35",
              "text": "Ito ang nauukol sa pahid na langis ni Aaron at sa pahid na langis ng kaniyang mga anak, sa mga handog na pinaraan sa apoy sa Panginoon, sa araw na iniharap sila, upang mangasiwa sa Panginoon sa katungkulang saserdote;"
            },
            {
              "chapter": 7,
              "verse": 36,
              "name": "Levitico 7:36",
              "text": "Na iniutos ng Panginoon sa kanila'y ibibigay para sa mga anak ni Israel sa araw na kaniyang pinahiran sila. Karampatang bahagi nga nila magpakailan man, sa buong panahon ng kanilang lahi."
            },
            {
              "chapter": 7,
              "verse": 37,
              "name": "Levitico 7:37",
              "text": "Ito ang kautusan tungkol sa handog na susunugin, sa handog na harina, at sa handog dahil sa kasalanan, at sa handog dahil sa pagkakasala, at sa pagtatalaga, at sa haing mga handog tungkol sa kapayapaan."
            },
            {
              "chapter": 7,
              "verse": 38,
              "name": "Levitico 7:38",
              "text": "Na iniutos ng Panginoon kay Moises sa bundok ng Sinai, nang araw na iniutos sa mga anak ni Israel na kanilang ihandog ang kanilang mga alay sa Panginoon sa ilang ng Sinai."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Levitico 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Levitico 8:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Levitico 8:2",
              "text": "Dalhin mo si Aaron at pati ng kaniyang mga anak, at ang mga kasuutan, at ang langis na pangpahid, at ang torong handog dahil sa kasalanan, at ang dalawang tupang lalake, at ang bakol ng mga tinapay na walang lebadura:"
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Levitico 8:3",
              "text": "At pulungin mo ang buong kapisanan sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Levitico 8:4",
              "text": "At ginawa ni Moises ayon sa iniutos sa kaniya ng Panginoon; at nagpupulong ang kapisanan sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Levitico 8:5",
              "text": "At sinabi ni Moises sa kapisanan, Ito ang ipinagawa ng Panginoon."
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Levitico 8:6",
              "text": "At dinala ni Moises si Aaron at ang kaniyang mga anak, at hinugasan ng tubig."
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Levitico 8:7",
              "text": "At isinuot sa kaniya ang kasuutan, at binigkisan ng pamigkis, at ibinalabal sa kaniya ang balabal, at sa kaniya'y ipinatong ang epod, at ibinigkis sa kaniya ang pamigkis ng epod na mainam ang pagkayari, at tinalian nito."
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Levitico 8:8",
              "text": "At ipinatong sa kaniya ang pektoral: at inilagay sa loob ng pektoral ang Urim at ang Thummim."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Levitico 8:9",
              "text": "At ipinatong ang mitra sa kaniyang ulo; at ipinatong sa mitra sa harap, ang laminang ginto, ang banal na putong; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Levitico 8:10",
              "text": "At kinuha ni Moises ang langis na pang-pahid, at pinahiran ang tabernakulo, at ang lahat ng nandoon, ay pinapaging banal."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Levitico 8:11",
              "text": "At winisikan niya niyaon ang ibabaw ng dambana na makapito, at pinahiran ng langis ang dambana at ang lahat ng kasangkapan niyaon, at ang hugasan at ang tungtungan niyaon, upang ariing banal."
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Levitico 8:12",
              "text": "At binuhusan ng langis na pang-pahid ang ulo ni Aaron, at pinahiran niya ng langis siya upang papagbanalin."
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Levitico 8:13",
              "text": "At pinalapit ni Moises ang mga anak ni Aaron, at sila'y sinuutan ng mga kasuutan, at binigkisan ng mga pamigkis, at itinali sa kanilang ulo ang mga tiara; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Levitico 8:14",
              "text": "At kaniyang inilapit ang torong handog dahil sa kasalanan: at ipinatong ni Aaron at ng kaniyang mga anak ang mga kamay nila sa ulo ng torong handog dahil sa kasalanan."
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Levitico 8:15",
              "text": "At pinatay niya; at kumuha si Moises ng dugo at ipinahid ng kaniyang daliri sa ibabaw ng mga anyong sungay ng dambana sa palibot, at nilinis ang dambana, at ang dugo'y ibinuhos sa tungtungan ng dambana, at inaring banal upang pagtubusan."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Levitico 8:16",
              "text": "At kinuha niya ang lahat ng taba na nasa ibabaw ng mga lamang loob, at ang lamad ng atay, at ang dalawang bato, at ang taba ng mga yaon, at sinunog ni Moises sa ibabaw ng dambana."
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Levitico 8:17",
              "text": "Datapuwa't ang toro, at ang balat, at ang laman, at ang dumi, ay sinunog niya sa apoy sa labas ng kampamento; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "Levitico 8:18",
              "text": "At iniharap niya ang tupang lalake na handog na susunugin: at ipinatong ni Aaron at ng kaniyang mga anak ang mga kamay nila sa ulo ng tupa."
            },
            {
              "chapter": 8,
              "verse": 19,
              "name": "Levitico 8:19",
              "text": "At kaniyang pinatay yaon: at iniwisik ni Moises ang dugo sa ibabaw ng dambana sa palibot."
            },
            {
              "chapter": 8,
              "verse": 20,
              "name": "Levitico 8:20",
              "text": "At kinatay niya ang tupa; at sinunog ni Moises ang ulo, at ang mga putolputol, at ang taba."
            },
            {
              "chapter": 8,
              "verse": 21,
              "name": "Levitico 8:21",
              "text": "At kaniyang hinugasan sa tubig ang lamang loob at ang mga paa; at sinunog ni Moises ang buong tupa sa ibabaw ng dambana; handog na susunugin nga na pinakamasarap na amoy: handog nga sa Panginoon na pinaraan sa apoy; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 8,
              "verse": 22,
              "name": "Levitico 8:22",
              "text": "At iniharap niya ang ikalawang tupa, ang tupa na itinatalaga: at ipinatong ni Aaron at ng kaniyang mga anak ang kanilang mga kamay sa ulo ng tupa."
            },
            {
              "chapter": 8,
              "verse": 23,
              "name": "Levitico 8:23",
              "text": "At kaniyang pinatay yaon; at kumuha si Moises ng dugo niyaon, at inilagay sa pingol ng kanang tainga ni Aaron, at sa daliring hinlalaki ng kaniyang kanang kamay, at sa daliring hinlalaki ng kaniyang kanang paa."
            },
            {
              "chapter": 8,
              "verse": 24,
              "name": "Levitico 8:24",
              "text": "At pinaharap niya ang mga anak ni Aaron, at nilagyan ni Moises ng dugong yaon sa pingol ng kanilang kanang tainga, at sa daliring hinlalaki ng kanang kamay nila, at sa daliring hinlalaki ng kanang paa nila: at iniwisik ni Moises ang dugo sa ibabaw ng dambana sa palibot."
            },
            {
              "chapter": 8,
              "verse": 25,
              "name": "Levitico 8:25",
              "text": "At kinuha niya ang taba, at ang matabang buntot, at ang lahat ng tabang nasa ibabaw ng lamang loob, at ang lamad ng atay, at ang dalawang bato, at ang taba ng mga yaon, at ang kanang hita:"
            },
            {
              "chapter": 8,
              "verse": 26,
              "name": "Levitico 8:26",
              "text": "At sa bakol ng tinapay na walang lebadura na inilagay sa harap ng Panginoon, ay kumuha siya ng isang munting tinapay na walang lebadura, at ng isang munting tinapay na nilangisan at ng isang manipis na tinapay, at ipinaglalagay sa ibabaw ng taba at sa ibabaw ng kanang hita:"
            },
            {
              "chapter": 8,
              "verse": 27,
              "name": "Levitico 8:27",
              "text": "At inilagay na lahat sa mga kamay ni Aaron at sa mga kamay ng kaniyang mga anak, at pinagaalog na pinakahandog na inalog sa harap ng Panginoon."
            },
            {
              "chapter": 8,
              "verse": 28,
              "name": "Levitico 8:28",
              "text": "At kinuha ni Moises sa kanilang mga kamay, at sinunog sa dambana sa ibabaw ng handog na susunugin: mga talagang pinakamasarap na amoy: handog nga sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 8,
              "verse": 29,
              "name": "Levitico 8:29",
              "text": "At kinuha ni Moises ang dibdib at inalog na pinakahandog na inalog sa harap ng Panginoon: ito ang bahagi ni Moises sa tupang itinalaga; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 8,
              "verse": 30,
              "name": "Levitico 8:30",
              "text": "At kumuha si Moises ng langis na pang-pahid, at ng dugong nasa ibabaw ng dambana, at iniwisik kay Aaron, sa kaniyang mga suot, at sa kaniyang mga anak, at sa mga suot ng kaniyang mga anak na kasama niya; at pinapaging banal si Aaron at ang kaniyang mga suot, at ang kaniyang mga anak at ang mga suot ng kaniyang mga anak na kasama niya."
            },
            {
              "chapter": 8,
              "verse": 31,
              "name": "Levitico 8:31",
              "text": "At sinabi ni Moises kay Aaron at sa kaniyang mga anak, Pakuluan ninyo ang laman sa pintuan ng tabernakulo ng kapisanan: at doon ninyo kanin, at ang tinapay na nasa bakol ng itinatalaga, ayon sa iniutos ko, na sinasabi, Kakanin ni Aaron at ng kaniyang mga anak."
            },
            {
              "chapter": 8,
              "verse": 32,
              "name": "Levitico 8:32",
              "text": "At ang labis sa laman at sa tinapay ay susunugin ninyo sa apoy."
            },
            {
              "chapter": 8,
              "verse": 33,
              "name": "Levitico 8:33",
              "text": "At sa pintuan ng tabernakulo ng kapisanan ay huwag kayong lalabas na pitong araw, hanggang sa maganap ang mga kaarawan ng inyong pagtalaga: sapagka't pitong araw na kayo'y matatalaga."
            },
            {
              "chapter": 8,
              "verse": 34,
              "name": "Levitico 8:34",
              "text": "Kung paano ang ginawa sa araw na ito, ay gayon ang iniutos ng Panginoon na gawin upang itubos sa inyo."
            },
            {
              "chapter": 8,
              "verse": 35,
              "name": "Levitico 8:35",
              "text": "At sa pintuan ng tabernakulo ng kapisanan ay matitira kayo gabi't araw na pitong araw, at inyong tutuparin ang kautusan ng Panginoon, upang huwag kayong mamatay: sapagka't gayon ang iniutos ko."
            },
            {
              "chapter": 8,
              "verse": 36,
              "name": "Levitico 8:36",
              "text": "At ginawa ni Aaron at ng kaniyang mga anak ang lahat na iniutos ng Panginoon sa pamamagitan ni Moises."
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Levitico 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Levitico 9:1",
              "text": "At nangyari sa ikawalong araw, na tinawag ni Moises si Aaron at ang kaniyang mga anak, at ang mga matanda sa Israel;"
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Levitico 9:2",
              "text": "At sinabi niya kay Aaron, Magdala ka ng isang guyang toro, na handog dahil sa kasalanan at isang tupang lalake na handog na susunugin, na kapuwa walang kapintasan, at ihandog mo sa harap ng Panginoon."
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Levitico 9:3",
              "text": "At sa mga anak ni Israel ay sasalitain mo, na sasabihin, Kumuha kayo ng isang kambing na lalake na handog dahil sa kasalanan; at ng isang guyang baka, at ng isang kordero, na kapuwa na may gulang na isang taon, at walang kapintasan, na handog na susunugin;"
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Levitico 9:4",
              "text": "At ng isang toro at ng isang tupang lalake na mga handog tungkol sa kapayapaan, upang ihain sa harap ng Panginoon, at ng isang handog na harina na hinaluan ng langis: sapagka't napakikita sa inyo ngayon ang Panginoon."
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Levitico 9:5",
              "text": "At kanilang dinala sa harap ng tabernakulo ng kapisanan ang iniutos ni Moises: at lumapit doon ang buong kapisanan, at tumayo sa harap ng Panginoon."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Levitico 9:6",
              "text": "At sinabi ni Moises, Ito ang iniutos ng Panginoon na gawin ninyo: at lilitaw sa inyo ang kaluwalhatian ng Panginoon."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Levitico 9:7",
              "text": "At sinabi ni Moises kay Aaron, Lumapit ka sa dambana, at ihandog mo ang iyong handog dahil sa kasalanan, at ang iyong handog na susunugin, at itubos mo sa iyong sarili at sa bayan: at ihandog mo ang alay ng bayan, at itubos mo sa kanila; gaya ng iniutos ng Panginoon."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Levitico 9:8",
              "text": "Lumapit nga si Aaron sa dambana at pinatay ang guyang handog dahil sa kasalanan, na yao'y para sa kaniya."
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Levitico 9:9",
              "text": "At iniharap ng mga anak ni Aaron sa kaniya ang dugo: at itinubog niya ang kaniyang daliri sa dugo, at ipinahid sa ibabaw ng mga anyong sungay ng dambana at ang dugong labis ay ibinuhos sa tungtungan ng dambana:"
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Levitico 9:10",
              "text": "Datapuwa't ang taba at ang mga bato, at ang lamad na nasa atay ng handog dahil sa kasalanan, ay sinunog niya sa ibabaw ng dambana; gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Levitico 9:11",
              "text": "At ang laman at ang balat ay sinunog niya sa apoy sa labas ng kampamento."
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Levitico 9:12",
              "text": "At pinatay niya ang handog na susunugin; at ibinigay sa kaniya ng mga anak ni Aaron ang dugo, at kaniyang iniwisik sa ibabaw ng palibot ng dambana."
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Levitico 9:13",
              "text": "At kaniyang ibinigay sa kaniya ang handog na susunugin, na isaisang putol, at ang ulo: at sinunog niya sa ibabaw ng dambana."
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Levitico 9:14",
              "text": "At kaniyang hinugasan ang lamang loob at ang mga paa at sinunog sa ibabaw ng handog na susunugin sa ibabaw ng dambana."
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Levitico 9:15",
              "text": "At iniharap niya ang alay ng bayan; at kinuha ang kambing na handog dahil sa kasalanan na para sa bayan, at pinatay at inihandog dahil sa kasalanan, na gaya ng una."
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Levitico 9:16",
              "text": "At iniharap niya ang handog na susunugin, at inihandog ayon sa palatuntunan."
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Levitico 9:17",
              "text": "At iniharap niya ang handog na harina, at kumuha ng isang dakot, at sinunog sa ibabaw ng dambana, bukod sa handog na susunugin sa umaga."
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Levitico 9:18",
              "text": "Kaniyang pinatay rin ang toro at ang tupang lalake na haing mga handog tungkol sa kapayapaan, na para sa bayan: at ibinigay ng mga anak ni Aaron sa kaniya ang dugo, at kaniyang iniwisik sa ibabaw ng dambana hanggang sa palibot."
            },
            {
              "chapter": 9,
              "verse": 19,
              "name": "Levitico 9:19",
              "text": "At ang taba ng toro at ng tupang lalake, ang matabang buntot at ang tabang nakatakip sa lamang loob, at ang mga bato, at ang lamad ng atay."
            },
            {
              "chapter": 9,
              "verse": 20,
              "name": "Levitico 9:20",
              "text": "At kanilang inilagay ang mga taba sa ibabaw ng mga dibdib, at kaniyang sinunog ang taba sa ibabaw ng dambana:"
            },
            {
              "chapter": 9,
              "verse": 21,
              "name": "Levitico 9:21",
              "text": "At ang mga dibdib at ang kanang hita ay inalog ni Aaron na pinakahandog na inalog sa harap ng Panginoon; gaya ng iniutos ni Moises."
            },
            {
              "chapter": 9,
              "verse": 22,
              "name": "Levitico 9:22",
              "text": "At itinaas ni Aaron ang kaniyang mga kamay sa dakong bayan at binasbasan niya; at bumaba siya na mula sa paghahandog ng handog dahil sa kasalanan, at ng handog na susunugin, at ng mga handog tungkol sa kapayapaan."
            },
            {
              "chapter": 9,
              "verse": 23,
              "name": "Levitico 9:23",
              "text": "At pumasok si Moises at si Aaron sa tabernakulo ng kapisanan, at sila'y lumabas, at binasbasan ang bayan: at lumitaw ang kaluwalhatian ng Panginoon sa buong bayan."
            },
            {
              "chapter": 9,
              "verse": 24,
              "name": "Levitico 9:24",
              "text": "At may lumabas na apoy sa harap ng Panginoon, at sinunog sa ibabaw ng dambana ang handog na susunugin at ang taba: at nang makita yaon ng buong bayan, ay nagsigawan at nangagpatirapa."
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Levitico 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Levitico 10:1",
              "text": "At si Nadab at si Abiu, na mga anak ni Aaron, ay kumuha ang bawa't isa sa kanila ng kanikaniyang suuban, at sinidlan nila ng apoy, at pinatungan ng kamangyan, at sila'y naghandog sa harap ng Panginoon ng ibang apoy na hindi iniutos niya sa kanila."
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Levitico 10:2",
              "text": "At sa harap ng Panginoon ay may lumabas na apoy, at sinupok sila; at namatay sila sa harap ng Panginoon."
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Levitico 10:3",
              "text": "Nang magkagayo'y sinabi ni Moises kay Aaron, Ito ang sinalita ng Panginoon, na sinasabi, Ako'y babanalin ng mga lumalapit sa akin, at sa harap ng buong bayan ay luluwalhatiin ako. At si Aaron ay hindi umimik."
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Levitico 10:4",
              "text": "At tinawag ni Moises si Misael at si Elzaphan, na mga anak ni Uziel na amain ni Aaron, at sa kanila'y sinabi, Magsilapit kayo, ilabas ninyo ang inyong mga kapatid sa kampamento mula sa harap ng santuario."
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Levitico 10:5",
              "text": "Sa gayo'y lumapit sila, at kanilang binuhat sa kanilang mga kasuutan na inilabas sa kampamento, gaya ng sinabi ni Moises."
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Levitico 10:6",
              "text": "At sinabi ni Moises kay Aaron, at kay Eleazar at kay Itamar na kaniyang mga anak, Huwag ninyong ilugay ang buhok ng inyong ulo, o hapakin man ninyo ang inyong bihisan; upang huwag kayong mamatay at ng siya'y huwag magalit laban sa buong kapisanan: kundi ang inyong mga kapatid, ang buong sangbahayan ni Israel ay tumaghoy sa apoy na pinapagalab ng Panginoon."
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Levitico 10:7",
              "text": "At huwag kayong lalabas sa pintuan ng tabernakulo ng kapisanan, baka kayo'y mamatay: sapagka't ang langis na pang-pahid ng Panginoon ay nasa ulo ninyo. At kanilang ginawa ayon sa salita ni Moises."
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Levitico 10:8",
              "text": "At sinalita ng Panginoon kay Aaron, na sinasabi,"
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Levitico 10:9",
              "text": "Huwag iinom ng alak o ng matapang na inumin man, ikaw o ang iyong mga anak man, pagka kayo'y papasok sa tabernakulo ng kapisanan, upang kayo'y huwag mamatay: magiging palatuntunang walang hanggan sa buong panahon ng inyong mga lahi:"
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Levitico 10:10",
              "text": "At upang inyong malagyan ng pagkakaiba ang banal at ang karaniwan, at ang karumaldumal at ang malinis:"
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Levitico 10:11",
              "text": "At upang inyong maituro sa mga anak ni Israel ang lahat ng palatuntunang sa kanila'y sinalita ng Panginoon sa pamamagitan ni Moises."
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Levitico 10:12",
              "text": "At sinalita ni Moises kay Aaron, at kay Eleazar at kay Ithamar, na mga natitira niyang anak, Kunin ninyo ang handog na harina na lumabis sa mga handog sa Panginoon na pinaraan sa apoy, at inyong kaning walang lebadura sa tabi ng dambana; sapagka't kabanalbanalan;"
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Levitico 10:13",
              "text": "At inyong kakanin sa dakong banal, sapagka't karampatang bahagi ninyo, at karampatang bahagi ng inyong mga anak, sa mga handog sa Panginoon na pinaraan sa apoy: sapagka't gayon iniutos sa akin."
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Levitico 10:14",
              "text": "At ang dibdib na inalog at ang hita na itinaas, ay kakanin ninyo sa dakong malinis, kakanin mo at ng iyong mga anak na lalake at babae na kasama mo: sapagka't yamang karampatang bahagi mo at karampatang bahagi ng iyong mga anak na ibinigay sa inyo sa mga hain ng mga anak ni Israel."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Levitico 10:15",
              "text": "Ang hita na itinaas, at ang dibdib na inalog ay kanilang dadalhin na kalakip ng mga handog na pinaraan sa apoy, na mga taba upang alugin na pinakahandog na inalog sa harap ng Panginoon: at mapapasa iyo, at sa iyong mga anak na kasama mo, na karampatang bahagi ninyo magpakailan man; gaya ng iniutos ng Panginoon."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Levitico 10:16",
              "text": "At hinanap ni Moises ng buong sikap ang kambing na handog dahil sa kasalanan, at, narito, sinunog: at nagalit kay Eleazer at kay Ithamar na mga anak ni Aaron na natira na sinasabi,"
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Levitico 10:17",
              "text": "Bakit hindi ninyo kinain ang handog dahil sa kasalanan sa dakong santuario, yamang kabanalbanalang bagay at sa inyo'y ibinigay upang dalhin ang kasamaan ng kapisanan na itubos sa kanila sa harap ng Panginoon?"
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Levitico 10:18",
              "text": "Narito, hindi ipinasok ang dugo niyaon sa loob ng santuario; nararapat sana ninyong kanin sa santuario, gaya ng iniutos ko."
            },
            {
              "chapter": 10,
              "verse": 19,
              "name": "Levitico 10:19",
              "text": "At sinalita ni Aaron kay Moises, Narito, kanilang inihandog ng araw na ito ang kanilang handog dahil sa kasalanan, at ang kanilang handog na susunugin sa harap ng Panginoon; at sa akin ay nangyari ang mga ganyang bagay na gaya ng mga ito: at kung ako nga'y nakakain ng handog dahil sa kasalanan ngayon, kalulugdan ba kaya ako ng Panginoon?"
            },
            {
              "chapter": 10,
              "verse": 20,
              "name": "Levitico 10:20",
              "text": "At nang marinig ni Moises, ay nakalugod sa kaniyang paningin."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Levitico 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Levitico 11:1",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron, na sa kanila'y sinasabi,"
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Levitico 11:2",
              "text": "Inyong salitain sa mga anak ni Israel, na inyong sabihin, Ito ang mga bagay na may buhay na inyong makakain sa lahat ng mga hayop na nasa lupa."
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Levitico 11:3",
              "text": "Alinmang may hati ang paa na baak at ngumunguya, sa mga hayop, ay inyong makakain."
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Levitico 11:4",
              "text": "Gayon ma'y huwag ninyong kakanin ang mga ito sa mga ngumunguya o doon sa mga may hati ang paa: ang kamelyo, sapagka't ngumunguya, nguni't walang hati ang paa, karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Levitico 11:5",
              "text": "At ang koneho, sapagka't ngumunguya, datapuwa't walang hati ang paa, karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Levitico 11:6",
              "text": "At ang liebre; sapagka't ngumunguya datapuwa't walang hati ang paa, karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Levitico 11:7",
              "text": "At ang baboy, sapagka't may hati ang paa at baak, datapuwa't hindi ngumunguya, karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 8,
              "name": "Levitico 11:8",
              "text": "Huwag kayong kakain ng laman ng mga iyan, at ang bangkay ng mga yaon ay huwag ninyong hihipuin; mga karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 9,
              "name": "Levitico 11:9",
              "text": "Ang mga ito'y inyong makakain sa mga nasa tubig: alin mang may mga palikpik at mga kaliskis sa tubig, sa mga dagat at sa mga ilog, ay makakain ninyo."
            },
            {
              "chapter": 11,
              "verse": 10,
              "name": "Levitico 11:10",
              "text": "At lahat ng walang palikpik at kaliskis sa mga dagat, at sa mga ilog, at sa lahat ng mga gumagalaw sa tubig, at sa lahat ng may buhay sa tubig, ay pawang karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 11,
              "name": "Levitico 11:11",
              "text": "At magiging karumaldumal sa inyo; huwag kayong kakain ng laman ng mga iyan, at ang bangkay ng mga iyan ay aariin ninyong karumaldumal."
            },
            {
              "chapter": 11,
              "verse": 12,
              "name": "Levitico 11:12",
              "text": "Anomang walang palikpik at kaliskis sa tubig ay magiging karumaldumal sa inyo."
            },
            {
              "chapter": 11,
              "verse": 13,
              "name": "Levitico 11:13",
              "text": "At sa mga ibon ay aariin ninyong karumaldumal ang mga ito; hindi kakanin, mga karumaldumal nga; ang agila, ang agilang dumudurog ng mga buto, at ang agilang dagat:"
            },
            {
              "chapter": 11,
              "verse": 14,
              "name": "Levitico 11:14",
              "text": "At ang lawin, at ang limbas, ayon sa kaniyang pagkalimbas;"
            },
            {
              "chapter": 11,
              "verse": 15,
              "name": "Levitico 11:15",
              "text": "Lahat ng uwak ayon sa kaniyang pagkauwak;"
            },
            {
              "chapter": 11,
              "verse": 16,
              "name": "Levitico 11:16",
              "text": "At ang avestruz, at ang chotacabras at ang gaviota, at ang gavilan ayon sa kaniyang pagkagavilan;"
            },
            {
              "chapter": 11,
              "verse": 17,
              "name": "Levitico 11:17",
              "text": "At ang maliit na kuwago, at ang somormuho, at ang malaking kuwago;"
            },
            {
              "chapter": 11,
              "verse": 18,
              "name": "Levitico 11:18",
              "text": "At ang kuwagong tila may sungay at ang pelikano, at ang buitre;"
            },
            {
              "chapter": 11,
              "verse": 19,
              "name": "Levitico 11:19",
              "text": "At ang ciguena, ang tagak ayon sa kaniyang pagkatagak; at ang abubilla, at ang kabagkabag."
            },
            {
              "chapter": 11,
              "verse": 20,
              "name": "Levitico 11:20",
              "text": "Lahat na may pakpak na umuusad na lumalakad na may apat na paa ay marumi nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 21,
              "name": "Levitico 11:21",
              "text": "Gayon man, ang mga ito'y inyong makakain sa lahat ng may pakpak na umuusad na may apat na paa, ang mga may dalawang paang mahaba, bukod pa sa kanilang mga paa, upang kanilang ipanglukso sa lupa;"
            },
            {
              "chapter": 11,
              "verse": 22,
              "name": "Levitico 11:22",
              "text": "Sa kanila'y makakain ninyo ang mga ito: ang balang ayon sa kaniyang pagkabalang, at ang lukton ayon sa kaniyang pagkalukton, at ang kuliglig lupa ayon sa kaniyang pagkakuliglig, at ang tipaklong ayon sa kaniyang pagkatipaklong."
            },
            {
              "chapter": 11,
              "verse": 23,
              "name": "Levitico 11:23",
              "text": "Datapuwa't lahat na may pakpak na umuusad na mayroong apat na paa, ay kasuklamsuklam nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 24,
              "name": "Levitico 11:24",
              "text": "At sa mga ito ay magiging karumaldumal kayo: sinomang humipo ng bangkay ng mga iyan ay magiging karumaldumal hanggang sa hapon:"
            },
            {
              "chapter": 11,
              "verse": 25,
              "name": "Levitico 11:25",
              "text": "At sinomang bumuhat ng bangkay ng mga iyan, ay maglalaba ng kaniyang mga suot, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 11,
              "verse": 26,
              "name": "Levitico 11:26",
              "text": "Bawa't hayop na may hati ang paa na hindi baak, o hindi ngumunguya, ay karumaldumal sa inyo: bawa't humipo sa mga iyan ay magiging karumaldumal."
            },
            {
              "chapter": 11,
              "verse": 27,
              "name": "Levitico 11:27",
              "text": "At anomang inilalakad ang kaniyang pangamot sa lahat ng hayop na inilalakad ang apat na paa, ay karumaldumal nga sa inyo: sinomang humipo ng bangkay ng mga iyan ay magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 11,
              "verse": 28,
              "name": "Levitico 11:28",
              "text": "At ang bumuhat ng bangkay ng mga iyan, ay maglalaba ng kaniyang mga suot, at magiging karumaldumal hanggang sa hapon: mga karumaldumal nga sa inyo."
            },
            {
              "chapter": 11,
              "verse": 29,
              "name": "Levitico 11:29",
              "text": "At ang mga ito'y karumaldumal sa inyo, sa mga umuusad na nagsisiusad, sa ibabaw ng lupa: ang bubwit, at ang daga, at ang bayawak ayon sa kaniyang pagkabayawak;"
            },
            {
              "chapter": 11,
              "verse": 30,
              "name": "Levitico 11:30",
              "text": "At ang tuko, at ang buwaya, at ang butiki, at ang bubuli at ang hunyango."
            },
            {
              "chapter": 11,
              "verse": 31,
              "name": "Levitico 11:31",
              "text": "Ang mga ito'y karumaldumal sa inyo sa lahat ng umuusad: sinomang mangakahipo sa mga iyan pagka ang mga iyan ay patay, ay magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 11,
              "verse": 32,
              "name": "Levitico 11:32",
              "text": "At yaong lahat na kabagsakan ng mga iyan, pagka patay, ay magiging karumaldumal nga: maging alin mang kasangkapan kahoy, o bihisan, o balat, o supot, alin mang kasangkapang ginagamit sa anomang gawa, sa tubig dapat ilubog, at magiging karumaldumal hanggang sa hapon; kung magkagayo'y magiging malinis."
            },
            {
              "chapter": 11,
              "verse": 33,
              "name": "Levitico 11:33",
              "text": "At bawa't sisidlang lupa na kahulugan ng mga iyan, lahat ng nalalaman doon ay magiging karumaldumal, at yao'y inyong babasagin."
            },
            {
              "chapter": 11,
              "verse": 34,
              "name": "Levitico 11:34",
              "text": "Lahat ng pagkain na makakain na kabuhusan ng tubig, ay magiging karumaldumal; at lahat ng inuming maiinom na masilid sa alin man sa mga gayong sisidlang lupa, ay magiging karumaldumal."
            },
            {
              "chapter": 11,
              "verse": 35,
              "name": "Levitico 11:35",
              "text": "At lahat na kahulugan ng anomang bahagi ng bangkay ng mga yaon ay magiging karumaldumal; maging hurno o kalan ng mga palyok, ay babasagin: mga karumaldumal nga at magiging karumaldumal sa inyo."
            },
            {
              "chapter": 11,
              "verse": 36,
              "name": "Levitico 11:36",
              "text": "Gayon ma'y ang isang bukal o ang isang balon, na tipunan ng tubig, ay magiging malinis: datapuwa't ang masagi ng bangkay ng mga yaon ay magiging karumaldumal."
            },
            {
              "chapter": 11,
              "verse": 37,
              "name": "Levitico 11:37",
              "text": "At kung mahulugan ng kanilang bangkay ang alin mang binhing panhasik na ihahasik, ay malinis."
            },
            {
              "chapter": 11,
              "verse": 38,
              "name": "Levitico 11:38",
              "text": "Nguni't kung nabasa ang binhi at mahulugan ng bangkay ng mga yaon, ay magiging karumaldumal sa inyo."
            },
            {
              "chapter": 11,
              "verse": 39,
              "name": "Levitico 11:39",
              "text": "At kung ang anomang hayop na inyong makakain ay mamatay; ang makahipo ng bangkay niyaon ay magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 11,
              "verse": 40,
              "name": "Levitico 11:40",
              "text": "At ang kumain ng bangkay niyaon ay maglalaba ng kaniyang suot, at magiging karumaldumal hanggang sa hapon: gayon din ang bumuhat ng bangkay niyaon, ay maglalaba ng kaniyang suot, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 11,
              "verse": 41,
              "name": "Levitico 11:41",
              "text": "At bawa't umuusad na nagsisiusad sa ibabaw ng lupa, ay karumaldumal; hindi kakanin."
            },
            {
              "chapter": 11,
              "verse": 42,
              "name": "Levitico 11:42",
              "text": "Lahat ng lumalakad ng kaniyang tiyan, at lahat ng lumalakad ng apat na paa o mayroong maraming paa, sa lahat ng bagay na umuusad sa ibabaw ng lupa, ay huwag ninyong kakanin; sapagka't mga karumaldumal nga."
            },
            {
              "chapter": 11,
              "verse": 43,
              "name": "Levitico 11:43",
              "text": "Huwag kayong magpakarumal sa anomang umuusad, o huwag kayong magpakalinis man sa mga iyan, na anopa't huwag kayong mangahawa riyan,"
            },
            {
              "chapter": 11,
              "verse": 44,
              "name": "Levitico 11:44",
              "text": "Sapagka't ako ang Panginoon ninyong Dios: magpakabanal nga kayo at kayo'y maging mga banal; sapagka't ako'y banal: ni huwag kayong magpakahawa sa anomang umuusad na gumagalaw sa ibabaw ng lupa."
            },
            {
              "chapter": 11,
              "verse": 45,
              "name": "Levitico 11:45",
              "text": "Sapagka't ako ang Panginoon na nagsampa sa inyo mula sa lupain ng Egipto, upang ako'y inyong maging Dios: kayo nga'y magpakabanal, sapagka't ako'y banal."
            },
            {
              "chapter": 11,
              "verse": 46,
              "name": "Levitico 11:46",
              "text": "Ito ang kautusan tungkol sa hayop, at sa ibon, at sa lahat na may buhay na gumagalaw sa tubig, at sa lahat ng nilikha na umuusad sa ibabaw ng lupa;"
            },
            {
              "chapter": 11,
              "verse": 47,
              "name": "Levitico 11:47",
              "text": "Upang lagyan ninyo ng pagkakaiba ang karumaldumal at ang malinis, at ang may buhay na makakain at ang may buhay na hindi makakain."
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Levitico 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Levitico 12:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Levitico 12:2",
              "text": "Salitain mo sa mga anak ni Israel, na iyong sabihin, Kung ang babae ay maglihi, at manganak ng isang lalake, ay magiging karumaldumal na pitong araw; ayon sa mga araw ng karumihan ng kaniyang sakit, ay magiging karumaldumal."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Levitico 12:3",
              "text": "At sa ikawalong araw ay tutuliin ang bata sa laman ng kaniyang balat ng masama."
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Levitico 12:4",
              "text": "At siya'y mananatiling tatlong pu't tatlong araw na maglilinis ng kaniyang dugo; huwag siyang hihipo ng anomang bagay na banal, o papasok man sa santuario, hanggang sa matupad ang mga araw ng kaniyang paglilinis."
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Levitico 12:5",
              "text": "Nguni't kung manganak siya ng babae, ay magiging karumaldumal nga siya na dalawang linggo, ayon sa kaniyang karumihan: at mananatiling anim na pu't anim na araw na maglilinis ng kaniyang dugo."
            },
            {
              "chapter": 12,
              "verse": 6,
              "name": "Levitico 12:6",
              "text": "At pagkaganap niya ng mga araw ng kaniyang paglilinis, maging sa anak na lalake o sa anak na babae, ay magdadala siya ng isang kordero ng unang taon, na pinakahandog na susunugin, at isang inakay ng kalapati o isang batobato na pinakahandog dahil sa kasalanan, sa pintuan ng tabernakulo ng kapisanan, sa saserdote;"
            },
            {
              "chapter": 12,
              "verse": 7,
              "name": "Levitico 12:7",
              "text": "At kaniyang ihahandog sa harap ng Panginoon, at itutubos sa kaniya; at siya'y malilinis sa agas ng kaniyang dugo. Ito ang kautusan tungkol sa nanganak ng lalake o ng babae."
            },
            {
              "chapter": 12,
              "verse": 8,
              "name": "Levitico 12:8",
              "text": "At kung ang kaniyang kaya ay hindi sapat upang magdala ng kordero, ay kukuha nga siya ng dalawang batobato o ng dalawang inakay ng kalapati; ang isa'y pinakahandog na susunugin at ang isa'y pinakahandog dahil sa kasalanan: at itutubos sa kaniya ng saserdote, at siya'y magiging malinis."
            }
          ]
        },
        {
          "chapter": 13,
          "name": "Levitico 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "Levitico 13:1",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron, na sinasabi,"
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "Levitico 13:2",
              "text": "Pagka ang sinomang tao ay nagkaroon sa balat ng kaniyang laman, ng pamamaga, o langib, o pantal na makintab at naging salot na ketong sa balat ng kaniyang laman, ay dadalhin nga siya kay Aaron na saserdote, o sa isa sa kaniyang mga anak na saserdote:"
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "Levitico 13:3",
              "text": "At titingnan ng saserdote ang tila salot na nasa balat ng kaniyang laman: at kung ang balahibo sa tila salot ay pumuti, at makitang ang sugat ay malalim kay sa balat ng kaniyang laman, ay salot na ketong nga: at siya'y mamasdan ng saserdote at ipakikilala siyang karumaldumal."
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "Levitico 13:4",
              "text": "At kung ang pantal na makintab ay maputi sa balat ng kaniyang laman, at makitang hindi malalim kaysa balat, at ang balahibo niyaon ay hindi pumuti, ay kukulungin ng saserdote ang may tila salot na pitong araw."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "Levitico 13:5",
              "text": "At titingnan siya ng saserdote sa ikapitong araw: at, narito, kung makitang ang tila salot ay tumigil, at hindi kumalat ang tila salot sa balat, ay kukulungin uli siya ng saserdote na pitong araw:"
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "Levitico 13:6",
              "text": "At titingnan siya uli ng saserdote sa ikapitong araw: at, narito, kung makitang ang tila salot ay namutla, at ang tila salot ay hindi kumalat sa balat, ay ipakikilalang malinis siya ng saserdote: langib yaon; at kaniyang lalabhan ang kaniyang suot, at magiging malinis."
            },
            {
              "chapter": 13,
              "verse": 7,
              "name": "Levitico 13:7",
              "text": "Datapuwa't kung ang langib ay kumakalat sa balat, pagkatapos na siya'y makapakita sa saserdote upang siya'y linisin, ay pakikita siya uli sa saserdote:"
            },
            {
              "chapter": 13,
              "verse": 8,
              "name": "Levitico 13:8",
              "text": "At titingnan siya ng saserdote; at, narito, kung ang langib ay kumakalat sa balat, ay ipakikilala ng saserdote na karumaldumal: ketong nga yaon."
            },
            {
              "chapter": 13,
              "verse": 9,
              "name": "Levitico 13:9",
              "text": "Pagka nagkaroon ng tila salot na ketong ang sinomang tao, ay dadalhin siya sa saserdote;"
            },
            {
              "chapter": 13,
              "verse": 10,
              "name": "Levitico 13:10",
              "text": "At titingnan siya ng saserdote; at, narito, kung makitang may pamamaga na maputi sa balat, na pumuti ang balahibo, at may matigas na lamang buhay sa pamamaga,"
            },
            {
              "chapter": 13,
              "verse": 11,
              "name": "Levitico 13:11",
              "text": "Ay malaong ketong nga sa balat ng kaniyang laman, at ipakikilala ng saserdote na siya'y karumaldumal; hindi siya kukulungin; sapagka't siya'y karumaldumal."
            },
            {
              "chapter": 13,
              "verse": 12,
              "name": "Levitico 13:12",
              "text": "At kung kumalat ang ketong sa balat, at matakpan ng ketong ang buong balat ng may tila salot, mula sa ulo hanggang sa kaniyang mga paa, sa buong maaabot ng paningin ng saserdote;"
            },
            {
              "chapter": 13,
              "verse": 13,
              "name": "Levitico 13:13",
              "text": "At titingnan nga siya ng saserdote; at, narito, kung makitang ang ketong ay kumalat sa buong laman niya, ay ipakikilalang malinis ang may tila salot: pumuting lahat: siya'y malinis."
            },
            {
              "chapter": 13,
              "verse": 14,
              "name": "Levitico 13:14",
              "text": "Datapuwa't sa alin mang araw na makitaan siya ng lamang buhay, ay magiging karumaldumal siya."
            },
            {
              "chapter": 13,
              "verse": 15,
              "name": "Levitico 13:15",
              "text": "At titingnan ng saserdote ang lamang buhay, at ipakikilala siyang karumaldumal: ang lamang buhay ay karumaldumal: ketong nga."
            },
            {
              "chapter": 13,
              "verse": 16,
              "name": "Levitico 13:16",
              "text": "O kung magbago uli ang lamang buhay at pumuti, ay lalapit nga siya sa saserdote;"
            },
            {
              "chapter": 13,
              "verse": 17,
              "name": "Levitico 13:17",
              "text": "At titingnan siya ng saserdote: at, narito, kung pumuti ang tila salot ay ipakikilalang malinis ng saserdote ang may tila salot: siya'y malinis."
            },
            {
              "chapter": 13,
              "verse": 18,
              "name": "Levitico 13:18",
              "text": "At kung magkaroon sa balat ng laman ng isang bukol at gumaling,"
            },
            {
              "chapter": 13,
              "verse": 19,
              "name": "Levitico 13:19",
              "text": "At humalili sa bukol ay isang pamamaga na maputi, o isang pantal na makintab, na namumulang puti, ay ipakikita sa saserdote;"
            },
            {
              "chapter": 13,
              "verse": 20,
              "name": "Levitico 13:20",
              "text": "At titingnan ng saserdote; at, narito, kung makitang tila impis kaysa balat, at ang balahibo niyaon ay tila pumuti, ay ipakikilala ng saserdote na karumaldumal: salot na ketong yaon; lumitaw sa bukol."
            },
            {
              "chapter": 13,
              "verse": 21,
              "name": "Levitico 13:21",
              "text": "Datapuwa't kung pagtingin ng saserdote, ay makitang walang balahibong puti yaon, o hindi impis man kay sa balat, kungdi namutla, ay kukulungin ng saserdote siya na pitong araw."
            },
            {
              "chapter": 13,
              "verse": 22,
              "name": "Levitico 13:22",
              "text": "At kung kumalat sa balat, ay ipakikilala ng saserdote na karumaldumal: salot nga yaon."
            },
            {
              "chapter": 13,
              "verse": 23,
              "name": "Levitico 13:23",
              "text": "Nguni't kung ang pantal na makintab ay tumigil sa kaniyang kinaroroonan, at hindi kumalat, ay piklat nga ng bukol; at ipakikilala ng saserdote na malinis siya."
            },
            {
              "chapter": 13,
              "verse": 24,
              "name": "Levitico 13:24",
              "text": "O pagka nagkaroon sa balat ng laman, ng paso ng apoy, at ang lamang paso ay naging tila pantal na makintab, na namumulang puti, o maputi;"
            },
            {
              "chapter": 13,
              "verse": 25,
              "name": "Levitico 13:25",
              "text": "At titingnan nga ng saserdote: at, narito, kung makitang ang buhok ay pumuti sa pantal na makintab, at tila mandin malalim kaysa balat; ay ketong nga na lumitaw sa paso: at ipakikilala ng saserdote na karumaldumal; salot na ketong nga yaon."
            },
            {
              "chapter": 13,
              "verse": 26,
              "name": "Levitico 13:26",
              "text": "Nguni't kung pagtingin ng saserdote, at, narito, kung makita ngang sa pantal na makintab ay walang balahibong maputi, at hindi impis kaysa balat, kungdi namutla; ay kukulungin nga siya ng saserdote na pitong araw."
            },
            {
              "chapter": 13,
              "verse": 27,
              "name": "Levitico 13:27",
              "text": "At titingnan siya ng saserdote sa ikapitong araw: kung kumalat sa balat, ay ipakikilala ng saserdote na karumaldumal: salot na ketong nga yaon."
            },
            {
              "chapter": 13,
              "verse": 28,
              "name": "Levitico 13:28",
              "text": "At kung ang pantal na makintab ay tumigil sa kaniyang kinaroroonan at hindi kumalat sa balat, kungdi pumutla, ay pamamaga ng paso yaon, at ipakikilala ng saserdote na malinis: sapagka't piklat ng paso yaon."
            },
            {
              "chapter": 13,
              "verse": 29,
              "name": "Levitico 13:29",
              "text": "At kung ang sinomang lalake o babae ay mayroong tila salot sa ulo o sa baba,"
            },
            {
              "chapter": 13,
              "verse": 30,
              "name": "Levitico 13:30",
              "text": "Ay titingnan nga ng saserdote ang tila salot: at, narito, kung makitang tila malalim kaysa balat, at yao'y may buhok na naninilaw na manipis, ay ipakikilala ng saserdote na karumaldumal: tina nga, ketong nga yaon sa ulo o sa baba."
            },
            {
              "chapter": 13,
              "verse": 31,
              "name": "Levitico 13:31",
              "text": "At kung makita ng saserdote ang tila salot na tina, at, narito, tila hindi malalim kaysa balat, at walang buhok na maitim yaon, ay kukulungin ng saserdote na pitong araw ang may tila salot na tina;"
            },
            {
              "chapter": 13,
              "verse": 32,
              "name": "Levitico 13:32",
              "text": "At sa ikapitong araw ay titingnan ng saserdote ang tila salot; at, narito, kung makita ngang hindi kumalat ang tina, at walang buhok na naninilaw, at tila ang tina ay hindi malalim kaysa balat,"
            },
            {
              "chapter": 13,
              "verse": 33,
              "name": "Levitico 13:33",
              "text": "Ay aahitan nga, datapuwa't hindi aahitan ang kinaroroonan ng tina; at ipakukulong ng saserdote ang may tina ng muling pitong araw:"
            },
            {
              "chapter": 13,
              "verse": 34,
              "name": "Levitico 13:34",
              "text": "At titingnan ng saserdote ang tina sa ikapitong araw: at, narito, kung makitang hindi kumalat ang tina sa balat, at tila hindi malalim kaysa balat; ay ipakikilala nga ng saserdote na malinis at siya'y maglalaba ng kaniyang suot at magiging malinis."
            },
            {
              "chapter": 13,
              "verse": 35,
              "name": "Levitico 13:35",
              "text": "Nguni't kung ang tina ay kumalat sa balat, pagkatapos ng kaniyang paglilinis;"
            },
            {
              "chapter": 13,
              "verse": 36,
              "name": "Levitico 13:36",
              "text": "Ay titingnan nga ng saserdote: at, narito, kung makitang kumalat sa balat ang tina ay hindi hahanapin ng saserdote ang buhok na maninilaw; siya'y karumaldumal."
            },
            {
              "chapter": 13,
              "verse": 37,
              "name": "Levitico 13:37",
              "text": "Datapuwa't kung sa kaniyang paningin ay tumigil ang tina at may tumubong buhok na itim; ay gumaling ang tina, siya'y malinis: at ipakikilalang malinis siya ng saserdote."
            },
            {
              "chapter": 13,
              "verse": 38,
              "name": "Levitico 13:38",
              "text": "At pagka ang isang lalake o babae ay nagkaroon sa balat ng kaniyang laman ng nangingintab na pantal, ng makikintab na pantal na puti;"
            },
            {
              "chapter": 13,
              "verse": 39,
              "name": "Levitico 13:39",
              "text": "Ay titingnan nga ng saserdote: at, narito, kung makitang ang nangingintab na pantal sa balat ng kaniyang laman ay namumutimuti; yao'y buni na sumibol sa balat; siya'y malinis."
            },
            {
              "chapter": 13,
              "verse": 40,
              "name": "Levitico 13:40",
              "text": "At kung ang sinoman ay malugunan ng buhok, ay kalbo gayon ma'y malinis."
            },
            {
              "chapter": 13,
              "verse": 41,
              "name": "Levitico 13:41",
              "text": "At kung sa dakong harapan ng ulo nalugunan ng buhok, ay kalbo yaon sa noo gayon ma'y malinis."
            },
            {
              "chapter": 13,
              "verse": 42,
              "name": "Levitico 13:42",
              "text": "Datapuwa't kung sa kakalbuhan, sa ulo o sa noo ay magkaroon ng tila salot ng namumulang maputi; ay ketong na sumibol sa kaniyang kakalbuhan ng ulo o sa kaniyang kakalbuhan ng noo."
            },
            {
              "chapter": 13,
              "verse": 43,
              "name": "Levitico 13:43",
              "text": "Kung magkagayo'y titingnan siya ng saserdote: at, narito, kung ang pamamaga ng tila salot ay namumulamula ng maputi sa kaniyang kakalbuhan ng ulo o sa kaniyang kakalbuhan ng noo, gaya ng anyo ng ketong sa balat ng kaniyang laman;"
            },
            {
              "chapter": 13,
              "verse": 44,
              "name": "Levitico 13:44",
              "text": "Ay ketongin siya, siya'y karumaldumal ipakikilala siya ng saserdote na tunay na karumaldumal; nasa kaniyang ulo ang salot niya."
            },
            {
              "chapter": 13,
              "verse": 45,
              "name": "Levitico 13:45",
              "text": "At pupunitin ng may ketong na kinaroroonan ng salot, ang kaniyang mga suot at ang buhok ng kaniyang ulo ay ilulugay, at siya'y magtatakip ng kaniyang nguso, at maghihihiyaw. Karumaldumal, karumaldumal."
            },
            {
              "chapter": 13,
              "verse": 46,
              "name": "Levitico 13:46",
              "text": "Sa buong panahong siya'y karoonan ng salot, ay magiging karumaldumal; siya'y karumaldumal: siya'y tatahang bukod; sa labas ng kampamento malalagay ang kaniyang tahanan."
            },
            {
              "chapter": 13,
              "verse": 47,
              "name": "Levitico 13:47",
              "text": "Ang suot na kinaroroonan ng ketong, maging kasuutang balahibo ng tupa o kasuutang lino;"
            },
            {
              "chapter": 13,
              "verse": 48,
              "name": "Levitico 13:48",
              "text": "Maging nasa paayon o maging nasa pahalang; ng lino o ng balahibo ng tupa; maging sa balat o sa alin mang yaring balat;"
            },
            {
              "chapter": 13,
              "verse": 49,
              "name": "Levitico 13:49",
              "text": "Kung ang tila salot ay namemerde o namumula sa kasuutan, o sa balat, maging sa paayon, o maging sa pahalang, o sa alin mang kasangkapang balat; ay salot na ketong nga at ipakikita sa saserdote,"
            },
            {
              "chapter": 13,
              "verse": 50,
              "name": "Levitico 13:50",
              "text": "At titingnan ng saserdote ang tila salot, at ipatatago ng pitong araw ang bagay na may tila salot:"
            },
            {
              "chapter": 13,
              "verse": 51,
              "name": "Levitico 13:51",
              "text": "At titingnan ang bagay na may tila salot, sa ikapitong araw: kung kumalat ang tila salot sa kasuutan, maging sa paayon, o sa pahalang, o sa balat, o alin mang ginagawa sa balat, ay ketong na ngumangatngat ang gayon tila salot; yao'y karumaldumal."
            },
            {
              "chapter": 13,
              "verse": 52,
              "name": "Levitico 13:52",
              "text": "At kaniyang susunugin ang kasuutan, maging paayon, at maging pahalang ng balahibo ng tupa o lino o sa alin mang kasangkapang balat na kinaroroonan ng salot; sapagka't yao'y ketong na ngumangatngat, yao'y susunugin sa apoy."
            },
            {
              "chapter": 13,
              "verse": 53,
              "name": "Levitico 13:53",
              "text": "At kung pagtingin ng saserdote, at, narito, kung makita ngang hindi kumalat ang salot sa kasuutan, maging sa paayon man, o sa pahalang man, o sa alin mang kasangkapang balat;"
            },
            {
              "chapter": 13,
              "verse": 54,
              "name": "Levitico 13:54",
              "text": "Ay palalabhan nga ng saserdote yaong kinaroroonan ng salot, at ipatatago pa ng pitong araw:"
            },
            {
              "chapter": 13,
              "verse": 55,
              "name": "Levitico 13:55",
              "text": "At titingnan ng saserdote ang bagay na may salot, pagkatapos na malabhan: at, narito, kung makitang ang salot ay hindi nagbago ang kulay, at hindi kumalat ang salot, yao'y karumaldumal; susunugin mo sa apoy: isang ngatngat nga, maging ang nanisnis ay nasa karayagan o nasa kabaligtaran."
            },
            {
              "chapter": 13,
              "verse": 56,
              "name": "Levitico 13:56",
              "text": "At kung pagtingin ng saserdote, at, narito, kung makita ngang namutla ang dakong may salot pagkatapos na malabhan, ay hahapakin sa kasuutan, o sa balat, o sa paayon, o sa pahalang:"
            },
            {
              "chapter": 13,
              "verse": 57,
              "name": "Levitico 13:57",
              "text": "At kung muling lumitaw sa kasuutang yaon, maging sa paayon, o sa pahalang, o sa alin mang yari sa balat, ay muling sumisibol: susunugin mo sa apoy yaong kinaroroonan ng salot."
            },
            {
              "chapter": 13,
              "verse": 58,
              "name": "Levitico 13:58",
              "text": "At ang kasuutan, maging sa paayon, o sa pahalang, o sa alin mang yari sa balat, na iyong labhan, at maalis ang salot, ay lalabhan ngang ikalawa, at magiging malinis."
            },
            {
              "chapter": 13,
              "verse": 59,
              "name": "Levitico 13:59",
              "text": "Ito ang kautusan tungkol sa salot na ketong sa kasuutang balahibo ng tupa o lino, maging sa paayon, o sa pahalang, o sa alin mang yari sa balat, upang ipakilalang malinis, o upang ipakilalang karumaldumal."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "Levitico 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Levitico 14:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Levitico 14:2",
              "text": "Ito ang magiging kautusan tungkol sa may ketong, sa kaarawan ng kaniyang paglilinis, siya'y dadalhin sa saserdote:"
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Levitico 14:3",
              "text": "At ang saserdote ay lalabas sa kampamento; at titingnan ng saserdote, at, narito, kung ang salot na ketong ay gumaling sa may ketong;"
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Levitico 14:4",
              "text": "Ay ipagutos nga ng saserdote na ikuha siya na lilinisin, ng dalawang ibong malinis na buhay, at kahoy na cedro, at grana, at hisopo;"
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Levitico 14:5",
              "text": "At ipaguutos ng saserdote, na patayin ang isa sa mga ibon, sa isang sisidlang lupa sa ibabaw ng tubig na umaagos."
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Levitico 14:6",
              "text": "Tungkol sa ibong buhay, ay kaniyang kukunin at ang kahoy na cedro, at ang grana at ang hisopo, at babasain pati ng ibong buhay, sa dugo ng ibong pinatay sa ibabaw ng tubig na umaagos:"
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Levitico 14:7",
              "text": "At iwiwisik niya na makapito doon sa kaniya na lilinisin sa ketong, at ipakikilalang malinis, at pawawalan ang ibong buhay sa kalawakan ng parang."
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "Levitico 14:8",
              "text": "At siya na lilinisin ay maglalaba ng kaniyang mga suot, at magaahit ng lahat niyang buhok, at maliligo sa tubig; at magiging malinis: at pagkatapos ay papasok sa kampamento, datapuwa't tatahan sa labas ng kaniyang tolda na pitong araw."
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "Levitico 14:9",
              "text": "At mangyayaring sa ikapitong araw, ay muling magaahit ng lahat niyang buhok, sa kaniyang ulo, at sa kaniyang baba, at sa kaniyang kilay, na anopa't aahitin niya ang lahat niyang buhok; at kaniyang lalabhan ang kaniyang mga suot, at kaniyang paliliguan ang kaniyang laman sa tubig, at magiging malinis."
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "Levitico 14:10",
              "text": "At sa ikawalong araw ay kukuha siya ng dalawang korderong lalake na walang kapintasan, at ng isang korderong babae ng unang taon na walang kapintasan, at ng isang handog na harina na tatlong ikasangpung bahagi ng isang epa ng mainam na harina na hinaluan ng langis, at ng isang log na langis."
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "Levitico 14:11",
              "text": "At ihaharap ang taong lilinisin ng saserdoteng naglilinis sa kaniya, at gayon din ang mga bagay na yaon, sa harap ng Panginoon, sa pintuan ng tabernakulo ng kapisanan:"
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "Levitico 14:12",
              "text": "At kukuha ang saserdote ng isa sa mga korderong lalake at ihahandog na pinakahandog sa pagkakasala, at ng log ng langis, at aalugin na pinakahandog na inalog sa harap ng Panginoon:"
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "Levitico 14:13",
              "text": "At papatayin ang korderong lalake sa pinagpapatayan ng handog dahil sa kasalanan at ng handog na susunugin, sa dako ng santuario: sapagka't kung paanong ang handog dahil sa kasalanan ay sa saserdote, gayon din ang handog dahil sa pagkakasala; bagay ngang kabanalbanalan:"
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "Levitico 14:14",
              "text": "At ang saserdote ay kukuha sa dugo ng handog dahil sa pagkakasala, at ilalagay ng saserdote sa pingol ng kanang tainga niyaong lilinisin, at sa daliring hinlalaki ng kaniyang kanang kamay, at sa daliring hinlalaki ng kaniyang kanang paa;"
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "Levitico 14:15",
              "text": "At kukuha ang saserdote sa log ng langis, at ibubuhos sa ibabaw ng palad ng kaniyang kaliwang kamay:"
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "Levitico 14:16",
              "text": "At itutubog ng saserdote ang kanang daliri niya sa langis na nasa kaniyang kaliwang kamay, at magwiwisik siyang makapito ng langis ng kaniyang daliri sa harap ng Panginoon:"
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "Levitico 14:17",
              "text": "At sa lumabis sa langis na nasa kaniyang kamay, ay maglalagay ang saserdote sa ibabaw ng pingol ng kanang tainga niyaong lilinisin, at sa daliring hinlalaki ng kaniyang kanang kamay at sa daliring hinlalaki ng kaniyang kanang paa, sa ibabaw ng dugo ng dahil sa pagkakasala:"
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "Levitico 14:18",
              "text": "At ang labis sa langis na nasa kamay ng saserdote, ay ilalagay nito sa ulo niyaong lilinisin: at itutubos sa kaniya ng saserdote sa harap ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "Levitico 14:19",
              "text": "At ihahandog ng saserdote ang handog dahil sa kasalanan, at itutubos sa kaniya, na lilinisin dahil sa kaniyang karumihan; at pagkatapos ay papatayin ang handog na susunugin:"
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "Levitico 14:20",
              "text": "At ihahandog ng saserdote ang handog na susunugin at ang handog na harina sa ibabaw ng dambana: at itutubos sa kaniya ng saserdote, at siya'y magiging malinis."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "Levitico 14:21",
              "text": "At kung siya'y dukha at ang kaniyang kaya ay hindi aabot, ay kukuha nga siya ng isang korderong lalake na handog dahil sa pagkakasala, na aalugin upang itubos sa kaniya, at ng ikasampung bahagi ng isang epa na mainam na harina, na hinaluan ng langis na pinakahandog na harina, at ng isang log ng langis;"
            },
            {
              "chapter": 14,
              "verse": 22,
              "name": "Levitico 14:22",
              "text": "At ng dalawang batobato o ng dalawang inakay ng kalapati, kung alin ang aabutin ng kaniyang kaya; at ang isa'y magiging handog dahil sa kasalanan, at ang isa'y handog na susunugin."
            },
            {
              "chapter": 14,
              "verse": 23,
              "name": "Levitico 14:23",
              "text": "At sa ikawalong araw ay kaniyang dadalhin sa saserdote sa pintuan ng tabernakulo ng kapisanan upang gamitin sa kaniyang paglilinis sa harap ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 24,
              "name": "Levitico 14:24",
              "text": "At kukunin ng saserdote ang korderong handog dahil sa pagkakasala at ang log ng langis, at aalugin ng saserdote na pinakahandog na inalog sa harap ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 25,
              "name": "Levitico 14:25",
              "text": "At kaniyang papatayin ang korderong handog dahil sa pagkakasala, at kukuha ang saserdote ng dugo ng handog dahil sa pagkakasala, at ilalagay sa pingol ng kanang tainga niyaong lilinisin, at sa daliring hinlalaki ng kaniyang kanang kamay, at sa daliring hinlalaki ng kaniyang kanang paa:"
            },
            {
              "chapter": 14,
              "verse": 26,
              "name": "Levitico 14:26",
              "text": "At magbubuhos ang saserdote ng langis sa ibabaw ng palad ng kaniyang kaliwang kamay:"
            },
            {
              "chapter": 14,
              "verse": 27,
              "name": "Levitico 14:27",
              "text": "At makapitong magwiwisik ang saserdote ng kaniyang kanang daliri, ng langis na nasa kaniyang kaliwang kamay, sa harap ng Panginoon:"
            },
            {
              "chapter": 14,
              "verse": 28,
              "name": "Levitico 14:28",
              "text": "At maglalagay ang saserdote ng langis na nasa kaniyang kamay, sa pingol ng kanang tainga niyaong lilinisin, at sa daliring hinlalaki ng kaniyang kanang kamay, at sa daliring hinlalaki ng kaniyang kanang paa, sa ibabaw ng pinaglagyan ng dugong handog dahil sa pagkakasala:"
            },
            {
              "chapter": 14,
              "verse": 29,
              "name": "Levitico 14:29",
              "text": "At ang labis ng langis na nasa kamay ng saserdote ay ilalagay niya sa ulo niyaong lilinisin, upang itubos sa kaniya sa harap ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 30,
              "name": "Levitico 14:30",
              "text": "At kaniyang ihahandog ang isa sa mga batobato o sa mga inakay ng kalapati, kung alin ang kaniyang kaya;"
            },
            {
              "chapter": 14,
              "verse": 31,
              "name": "Levitico 14:31",
              "text": "Kung alin ang abutin ng kaniyang kaya, na ang isa'y handog dahil sa kasalanan, at ang isa'y handog na susunugin, pati ng handog na harina: at itutubos ng saserdote doon sa malilinis sa harap ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 32,
              "name": "Levitico 14:32",
              "text": "Ito ang kautusan tungkol sa may salot na ketong, na ang kaniyang kaya ay hindi abot sa nauukol sa kaniyang paglilinis."
            },
            {
              "chapter": 14,
              "verse": 33,
              "name": "Levitico 14:33",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron, na sinasabi,"
            },
            {
              "chapter": 14,
              "verse": 34,
              "name": "Levitico 14:34",
              "text": "Pagka kayo'y nakapasok na sa lupain ng Canaan, na ibibigay kong pag-aari sa inyo, at ako'y naglagay ng salot na ketong sa alin mang bahay sa lupain ninyong inaari;"
            },
            {
              "chapter": 14,
              "verse": 35,
              "name": "Levitico 14:35",
              "text": "Ay yayaon ang may-ari ng bahay at magbibigay alam sa saserdote, na sasabihin, Tila mandin mayroong parang salot sa bahay:"
            },
            {
              "chapter": 14,
              "verse": 36,
              "name": "Levitico 14:36",
              "text": "At ipaguutos ng saserdote na alisan ng laman ang bahay bago pumasok ang saserdote na kilalanin ang tila salot, upang ang lahat na nasa bahay ay huwag mahawa: at pagkatapos ay papasok ang saserdote upang tingnan ang bahay:"
            },
            {
              "chapter": 14,
              "verse": 37,
              "name": "Levitico 14:37",
              "text": "At titingnan ang salot, at kung makita ngang ang tila salot ay nasa mga panig ng bahay na may ukit na namemerde, o namumula at tila malalim kaysa panig;"
            },
            {
              "chapter": 14,
              "verse": 38,
              "name": "Levitico 14:38",
              "text": "Ay lalabas nga ang saserdote sa bahay hanggang sa pintuan ng bahay at ipasasara ang bahay na pitong araw:"
            },
            {
              "chapter": 14,
              "verse": 39,
              "name": "Levitico 14:39",
              "text": "At babalik ang saserdote sa ikapitong araw, at titingnan: at, narito, kung makita ngang kumalat ang salot sa mga panig ng bahay;"
            },
            {
              "chapter": 14,
              "verse": 40,
              "name": "Levitico 14:40",
              "text": "Ay ipaguutos nga ng saserdote na bunutin ang mga batong kinaroonan ng tila salot at ipatatapon sa labas ng bayan sa dakong karumaldumal:"
            },
            {
              "chapter": 14,
              "verse": 41,
              "name": "Levitico 14:41",
              "text": "At ipakakayas ang palibot ng loob ng bahay, at ang argamasang inalis na kinayas ay itatapon sa labas ng bayan sa dakong karumaldumal:"
            },
            {
              "chapter": 14,
              "verse": 42,
              "name": "Levitico 14:42",
              "text": "At magsisikuha ng ibang mga bato, at ihahalili sa mga batong yaon, at magsisikuha ng ibang argamasa at siyang ihahaplos sa mga panig ng bahay."
            },
            {
              "chapter": 14,
              "verse": 43,
              "name": "Levitico 14:43",
              "text": "At kung muling bumalik ang tila salot, at sumibol sa bahay, pagkatapos na mabunot ang mga bato; at pagkatapos makayas ang bahay, at pagkatapos na mahaplusan ng argamasa;"
            },
            {
              "chapter": 14,
              "verse": 44,
              "name": "Levitico 14:44",
              "text": "Ay papasok nga ang saserdote at titingnan, at, narito, kung makita ngang ang salot ay kumalat sa bahay ay ketong na nakakahawa sa bahay; ito'y karumaldumal."
            },
            {
              "chapter": 14,
              "verse": 45,
              "name": "Levitico 14:45",
              "text": "At gigibain niya ang bahay na yaon, ang mga bato at ang mga kahoy, at ang lahat ng argamasa ng bahay; ay dadalhin sa labas ng bayan sa dakong karumaldumal."
            },
            {
              "chapter": 14,
              "verse": 46,
              "name": "Levitico 14:46",
              "text": "Bukod dito'y ang pumasok sa bahay na yaon ng buong panahong nasasara ay magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 14,
              "verse": 47,
              "name": "Levitico 14:47",
              "text": "At ang mahiga sa bahay na yaon ay maglalaba ng kaniyang mga suot; at ang kumain sa bahay na yaon ay maglalaba ng kaniyang mga suot."
            },
            {
              "chapter": 14,
              "verse": 48,
              "name": "Levitico 14:48",
              "text": "At kung papasok ang saserdote, at, narito, kung hindi nga kumalat ang salot sa bahay, pagkatapos na nahaplusan ng argamasa; ay ipakikilala nga ng saserdote na malinis ang bahay, sapagka't gumaling sa salot."
            },
            {
              "chapter": 14,
              "verse": 49,
              "name": "Levitico 14:49",
              "text": "At upang linisin ang bahay ay kukuha ng dalawang ibon, at ng kahoy na cedro, at ng grana, at ng hisopo:"
            },
            {
              "chapter": 14,
              "verse": 50,
              "name": "Levitico 14:50",
              "text": "At papatayin ang isa sa mga ibon sa isang sisidlang lupa sa ibabaw ng tubig na umaagos:"
            },
            {
              "chapter": 14,
              "verse": 51,
              "name": "Levitico 14:51",
              "text": "At kukunin niya ang kahoy na cedro, at ang hisopo, at ang grana, at ang ibong buhay, at babasain sa dugo ng ibong pinatay, at sa tubig na umaagos, at wiwisikang makapito ang bahay:"
            },
            {
              "chapter": 14,
              "verse": 52,
              "name": "Levitico 14:52",
              "text": "At kaniyang lilinisin ng dugo ng ibon ang bahay at ng agos ng tubig, at ng ibong buhay at ng kahoy na cedro, at ng hisopo, at ng grana:"
            },
            {
              "chapter": 14,
              "verse": 53,
              "name": "Levitico 14:53",
              "text": "Datapuwa't pawawalan ang ibong buhay sa labas ng bayan, sa kalawakan ng parang: gayon tutubusin ang bahay: at magiging malinis."
            },
            {
              "chapter": 14,
              "verse": 54,
              "name": "Levitico 14:54",
              "text": "Ito ang kautusan tungkol sa sarisaring salot na ketong at sa tina,"
            },
            {
              "chapter": 14,
              "verse": 55,
              "name": "Levitico 14:55",
              "text": "At sa ketong ng suot, at ng bahay."
            },
            {
              "chapter": 14,
              "verse": 56,
              "name": "Levitico 14:56",
              "text": "At sa pamamaga at sa langib, at sa pantal na makintab:"
            },
            {
              "chapter": 14,
              "verse": 57,
              "name": "Levitico 14:57",
              "text": "Upang ituro kung kailan karumaldumal, at kung kailan malinis: ito ang kautusan tungkol sa ketong."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "Levitico 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "Levitico 15:1",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron na sinasabi,"
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "Levitico 15:2",
              "text": "Salitain ninyo sa mga anak ni Israel, at inyong sabihin sa kanila, Pagka ang sinomang tao ay inagasan sa kaniyang laman, ay magiging karumaldumal siya dahil sa kaniyang agas."
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "Levitico 15:3",
              "text": "At ito ang magiging kaniyang karumalan sa kaniyang agas: maging ang kaniyang laman ay balungan dahil sa kaniyang agas, o ang kaniyang laman ay masarhan dahil sa kaniyang agas, ay kaniyang karumalan nga."
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "Levitico 15:4",
              "text": "Bawa't higaang mahigan ng inaagasan ay magiging karumaldumal: at bawa't bagay na kaniyang kaupuan, ay magiging karumaldumal."
            },
            {
              "chapter": 15,
              "verse": 5,
              "name": "Levitico 15:5",
              "text": "At sinomang tao na makahipo ng kaniyang higaan ay maglalaba ng kaniyang mga damit, at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 6,
              "name": "Levitico 15:6",
              "text": "At ang maupo sa anomang bagay na kaupuan ng inaagasan ay maglalaba ng kaniyang mga damit, at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 7,
              "name": "Levitico 15:7",
              "text": "At ang humipo ng laman niyaong inaagasan ay maglalaba ng kaniyang mga damit at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "Levitico 15:8",
              "text": "At kung ang inaagasan ay makalura sa taong malinis, ay maglalaba nga siya ng kaniyang mga damit, at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 9,
              "name": "Levitico 15:9",
              "text": "At alin mang siya na kasakyan ng inaagasan, ay magiging karumaldumal."
            },
            {
              "chapter": 15,
              "verse": 10,
              "name": "Levitico 15:10",
              "text": "At ang alin mang taong humipo ng alinmang bagay na napalagay sa ilalim niyaon, ay magiging karumaldumal hanggang sa hapon: at ang magdala ng mga bagay na yaon ay maglalaba ng kaniyang mga damit at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 11,
              "name": "Levitico 15:11",
              "text": "At yaong lahat na mahipo ng inaagasan na hindi nakapaghugas ng kaniyang mga kamay sa tubig, ay maglalaba nga rin ng kaniyang mga damit, at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 12,
              "name": "Levitico 15:12",
              "text": "At ang sisidlang lupa na mahipo ng inaagasan, ay babasagin: at ang lahat ng kasangkapang kahoy ay babanlawan sa tubig."
            },
            {
              "chapter": 15,
              "verse": 13,
              "name": "Levitico 15:13",
              "text": "At kung ang inaagasan ay gumaling sa kaniyang agas, ay bibilang siya ng pitong araw sa kaniyang paglilinis, at maglalaba ng kaniyang mga damit; at paliliguan din niya ang kaniyang laman sa tubig na umaagos, at magiging malinis."
            },
            {
              "chapter": 15,
              "verse": 14,
              "name": "Levitico 15:14",
              "text": "At sa ikawalong araw ay magdadala siya ng dalawang batobato, o ng dalawang inakay ng kalapati, at ihaharap niya sa harap ng Panginoon sa pasukan ng tabernakulo ng kapisanan, at ibibigay niya sa saserdote."
            },
            {
              "chapter": 15,
              "verse": 15,
              "name": "Levitico 15:15",
              "text": "At ihahandog ng saserdote, na ang isa'y handog dahil sa kasalanan, at ang isa'y handog na susunugin; at itutubos sa kaniya ng saserdote sa harap ng Panginoon, dahil sa kaniyang agas."
            },
            {
              "chapter": 15,
              "verse": 16,
              "name": "Levitico 15:16",
              "text": "At kung ang sinomang tao ay labasan ng binhi ng pakikiapid, ay paliliguan nga niya ng tubig ang buong kaniyang laman, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 17,
              "name": "Levitico 15:17",
              "text": "At lahat ng damit at lahat ng balat na kinaroonan ng binhi ng pakikiapid, ay lalabhan sa tubig, at magiging karumaldumal hanggang hapon."
            },
            {
              "chapter": 15,
              "verse": 18,
              "name": "Levitico 15:18",
              "text": "Ang babae rin namang sinipingan ng lalaking mayroong binhi ng pakikiapid, ay maliligo sila kapuwa sa tubig, at magiging karumaldumal sila hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 19,
              "name": "Levitico 15:19",
              "text": "At kung ang babae ay agasan na ang umaagas sa kaniyang laman ay dugo, ay mapapasa kaniyang karumihan siyang pitong araw: at lahat ng humipo sa kaniya ay magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 20,
              "name": "Levitico 15:20",
              "text": "At bawa't kaniyang kahigaan sa panahon ng kaniyang karumihan, ay magiging karumaldumal: bawa't din namang kaupuan niya ay magiging karumaldumal."
            },
            {
              "chapter": 15,
              "verse": 21,
              "name": "Levitico 15:21",
              "text": "At sinomang humipo ng kaniyang higaan ay maglalaba ng kaniyang mga damit, at maliligo sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 22,
              "name": "Levitico 15:22",
              "text": "At ang sinomang humipo ng alin mang bagay na kaniyang kaupuan ay maglalaba ng kaniyang mga damit, at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 23,
              "name": "Levitico 15:23",
              "text": "At kung may nasa higaan o nasa anomang bagay na kinaupuan niya, ay magiging karumaldumal hanggang sa hapon ang humipo niyaon."
            },
            {
              "chapter": 15,
              "verse": 24,
              "name": "Levitico 15:24",
              "text": "At kung ang sinomang lalake ay sumiping sa kaniya, at mapasa lalake ang karumihan niya, ay magiging karumaldumal ito na pitong araw; at bawa't higaang kaniyang hihigaan ay magiging karumaldumal."
            },
            {
              "chapter": 15,
              "verse": 25,
              "name": "Levitico 15:25",
              "text": "At kung ang isang babae ay agasan ng kaniyang dugo ng maraming araw sa di kapanahunan ng kaniyang karumihan, o kung agasan sa dako pa roon ng panahon ng kaniyang karumihan; buong panahon ng agas ng kaniyang karumalan ay magiging para ng mga araw ng kaniyang karumihan: siya'y karumaldumal nga."
            },
            {
              "chapter": 15,
              "verse": 26,
              "name": "Levitico 15:26",
              "text": "Bawa't higaan na kaniyang hinihigan buong panahon ng kaniyang agas, ay magiging sa kaniya'y gaya ng higaan ng kaniyang karumihan; at bawa't bagay na kaniyang kaupuan, ay magiging karumaldumal, na gaya ng karumalan ng kaniyang karumihan."
            },
            {
              "chapter": 15,
              "verse": 27,
              "name": "Levitico 15:27",
              "text": "At sinomang humipo ng mga bagay na yaon ay magiging karumaldumal, at maglalaba ng kaniyang mga damit, at maliligo siya sa tubig, at magiging karumaldumal hanggang sa hapon."
            },
            {
              "chapter": 15,
              "verse": 28,
              "name": "Levitico 15:28",
              "text": "Datapuwa't kung siya'y gumaling sa kaniyang agas, ay bibilang siya ng pitong araw, at pagkatapos niyaon ay magiging malinis siya."
            },
            {
              "chapter": 15,
              "verse": 29,
              "name": "Levitico 15:29",
              "text": "At sa ikawalong araw ay kukuha siya ng dalawang batobato o ng dalawang inakay ng kalapati, at dadalhin niya sa saserdote sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 15,
              "verse": 30,
              "name": "Levitico 15:30",
              "text": "At ihahandog ng saserdote ang isa na handog dahil sa kasalanan, at ang isa'y handog na susunugin; at itutubos sa kaniya ng saserdote sa harap ng Panginoon, dahil sa agas ng kaniyang karumihan."
            },
            {
              "chapter": 15,
              "verse": 31,
              "name": "Levitico 15:31",
              "text": "Ganito ihihiwalay ninyo ang mga anak ni Israel sa kanilang karumalan; upang huwag mangamatay sa kanilang karumalan, kung kanilang ihawa ang aking tabernakulo na nasa gitna nila."
            },
            {
              "chapter": 15,
              "verse": 32,
              "name": "Levitico 15:32",
              "text": "Ito ang kautusan tungkol sa inaagasan, at sa nilalabasan ng binhi ng pakikiapid, na ikinarurumal;"
            },
            {
              "chapter": 15,
              "verse": 33,
              "name": "Levitico 15:33",
              "text": "At sa babaing may sakit ng kaniyang karumihan, at sa inaagasan, sa lalake at sa babae, at doon sa sumisiping sa babaing karumaldumal."
            }
          ]
        },
        {
          "chapter": 16,
          "name": "Levitico 16",
          "verses": [
            {
              "chapter": 16,
              "verse": 1,
              "name": "Levitico 16:1",
              "text": "At sinalita ng Panginoon kay Moises, pagkamatay ng dalawang anak ni Aaron, noong nagsilapit sa harap ng Panginoon, at namatay;"
            },
            {
              "chapter": 16,
              "verse": 2,
              "name": "Levitico 16:2",
              "text": "At sinabi ng Panginoon kay Moises, Salitain mo kay Aaron na iyong kapatid na huwag pumasok tuwina sa dakong banal, sa loob ng tabing, sa harap ng luklukan ng awa na nasa ibabaw ng kaban; upang siya'y huwag mamatay: sapagka't ako'y pakikitang nasa ulap sa ibabaw ng luklukan ng awa."
            },
            {
              "chapter": 16,
              "verse": 3,
              "name": "Levitico 16:3",
              "text": "Ganito papasok nga si Aaron sa loob ng dakong banal, may dalang isang guyang toro na handog dahil sa kasalanan, at isang tupang lalake na handog na susunugin."
            },
            {
              "chapter": 16,
              "verse": 4,
              "name": "Levitico 16:4",
              "text": "Siya'y magsusuot ng kasuutang banal, na lino at ng salawal na lino sa kaniyang laman, at magbibigkis siya ng pamigkis na lino, at ang mitra na lino ay kaniyang isusuot: ito ang mga bihisang banal; at paliliguan niya ang kaniyang laman sa tubig at pawang isusuot niya."
            },
            {
              "chapter": 16,
              "verse": 5,
              "name": "Levitico 16:5",
              "text": "At siya'y kukuha sa kapisanan ng mga anak ni Israel, ng dalawang kambing na lalake na pinakahandog dahil sa kasalanan, at ng isang tupang lalake na pinakahandog na susunugin."
            },
            {
              "chapter": 16,
              "verse": 6,
              "name": "Levitico 16:6",
              "text": "At ihaharap ni Aaron ang toro na handog dahil sa kasalanan na patungkol sa kaniyang sarili, at itutubos niya sa kaniya at sa kaniyang sangbahayan."
            },
            {
              "chapter": 16,
              "verse": 7,
              "name": "Levitico 16:7",
              "text": "At kukunin niya ang dalawang kambing at ilalagay niya sa harap ng Panginoon sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 16,
              "verse": 8,
              "name": "Levitico 16:8",
              "text": "At pagsasapalaran ni Aaron ang dalawang kambing; ang isang kapalaran ay sa Panginoon at ang isang kapalaran ay kay Azazel."
            },
            {
              "chapter": 16,
              "verse": 9,
              "name": "Levitico 16:9",
              "text": "At ihaharap ni Aaron ang kambing na kinahulugan ng kapalaran sa Panginoon, at ihahandog na pinakahandog dahil sa kasalanan."
            },
            {
              "chapter": 16,
              "verse": 10,
              "name": "Levitico 16:10",
              "text": "Nguni't ang kambing na kinahulugan ng kapalaran kay Azazel ay ilalagay na buhay sa harap ng Panginoon, upang itubos sa kaniya, at payaunin kay Azazel sa ilang."
            },
            {
              "chapter": 16,
              "verse": 11,
              "name": "Levitico 16:11",
              "text": "At ihaharap ni Aaron ang toro na handog dahil sa kasalanan, na patungkol sa kaniyang sarili, at itutubos sa kaniyang sarili at sa kaniyang sangbahayan, at papatayin ang toro na handog dahil sa kasalanan na patungkol sa kaniyang sarili:"
            },
            {
              "chapter": 16,
              "verse": 12,
              "name": "Levitico 16:12",
              "text": "At kukuha siya mula sa dambana na nasa harap ng Panginoon ng isang suuban na puno ng mga baga; at kukuha ng dalawang dakot ng masarap na kamangyan na totoong dikdik, at kaniyang dadalhin sa loob ng tabing:"
            },
            {
              "chapter": 16,
              "verse": 13,
              "name": "Levitico 16:13",
              "text": "At ilalagay niya ang kamangyan sa ibabaw ng apoy sa harap ng Panginoon, upang ang mga usok ng kamangyan ay tumakip sa luklukan ng awa na nasa ibabaw ng kaban ng patoo, upang huwag siyang mamatay:"
            },
            {
              "chapter": 16,
              "verse": 14,
              "name": "Levitico 16:14",
              "text": "At siya'y kukuha ng dugo ng toro at iwiwisik ng kaniyang daliri sa ibabaw ng luklukan ng awa, sa dakong silanganan: at sa harap ng luklukan ng awa ay iwiwisik niyang makapito ng kaniyang daliri ang dugo."
            },
            {
              "chapter": 16,
              "verse": 15,
              "name": "Levitico 16:15",
              "text": "Kung magkagayo'y papatayin niya ang kambing na handog dahil sa kasalanan, na patungkol sa bayan, at dadalhin ang dugo niyaon sa loob ng tabing, at ang gagawin sa dugo niyaon ay gaya ng ginawa sa dugo ng toro, at iwiwisik sa ibabaw ng luklukan ng awa at sa harap ng luklukan ng awa:"
            },
            {
              "chapter": 16,
              "verse": 16,
              "name": "Levitico 16:16",
              "text": "At itutubos niya sa dakong banal dahil sa mga karumalan ng mga anak ni Israel, at dahil sa kanilang mga pagsalangsang, sa makatuwid baga'y sa lahat nilang kasalanan: at gayon ang kaniyang gagawin sa tabernakulo ng kapisanan na nasa kanila, sa gitna ng kanilang mga karumalan,"
            },
            {
              "chapter": 16,
              "verse": 17,
              "name": "Levitico 16:17",
              "text": "At huwag magkakaroon ng sinomang tao sa tabernakulo pagka siya'y papasok upang itubos sa loob ng dakong banal, hanggang sa lumabas siya, at matubos ang sarili, at ang kaniyang kasangbahay, at ang buong kapisanan ng Israel."
            },
            {
              "chapter": 16,
              "verse": 18,
              "name": "Levitico 16:18",
              "text": "At lalabas siya sa dambana na nasa harap ng Panginoon, at itutubos sa ito; at kukuha ng dugo ng toro, at ng dugo ng kambing, at ilalagay sa ibabaw ng mga anyong sungay ng dambana sa palibot."
            },
            {
              "chapter": 16,
              "verse": 19,
              "name": "Levitico 16:19",
              "text": "At makapitong magwiwisik siya ng dugo sa dambana ng kaniyang daliri, at lilinisin at babanalin dahil sa mga karumalan ng mga anak ni Israel."
            },
            {
              "chapter": 16,
              "verse": 20,
              "name": "Levitico 16:20",
              "text": "At pagkatapos matubos niya ang dakong banal, at ang tabernakulo ng kapisanan, at ang dambana, ay ihahandog ang kambing na buhay:"
            },
            {
              "chapter": 16,
              "verse": 21,
              "name": "Levitico 16:21",
              "text": "At ipapatong ni Aaron ang kaniyang dalawang kamay sa ulo ng kambing na buhay, at isasaysay sa ibabaw niyaon ang lahat ng mga kasamaan ng mga anak ni Israel, at lahat ng kanilang mga pagsalangsang, lahat nga ng kanilang mga kasalanan; at ilalagay niya sa ulo ng kambing, at ipadadala sa ilang sa pamamagitan ng kamay ng isang taong handa:"
            },
            {
              "chapter": 16,
              "verse": 22,
              "name": "Levitico 16:22",
              "text": "At dadalhin ng kambing ang lahat ng mga kasamaan nila, sa lupaing hindi tinatahanan: at pawawalan niya ang kambing sa ilang."
            },
            {
              "chapter": 16,
              "verse": 23,
              "name": "Levitico 16:23",
              "text": "At papasok si Aaron sa tabernakulo ng kapisanan, at maghuhubad ng mga suot na lino, na isinuot niya nang siya'y pumasok sa dakong banal, at iiwan niya roon:"
            },
            {
              "chapter": 16,
              "verse": 24,
              "name": "Levitico 16:24",
              "text": "At paliliguan niya ang kaniyang laman sa tubig, sa isang dakong banal, at magsusuot ng kaniyang mga suot, at lalabas, at ihahandog ang kaniyang handog na susunugin at ang handog na susunugin ng bayan, at itutubos sa kaniyang sarili at sa bayan."
            },
            {
              "chapter": 16,
              "verse": 25,
              "name": "Levitico 16:25",
              "text": "At susunugin sa ibabaw ng dambana ang taba ng handog dahil sa kasalanan."
            },
            {
              "chapter": 16,
              "verse": 26,
              "name": "Levitico 16:26",
              "text": "At yaong nagpakawala ng kambing na ukol kay Azazel, ay maglalaba ng kaniyang mga suot at maliligo ang kaniyang laman sa tubig, at pagkatapos ay papasok siya sa kampamento."
            },
            {
              "chapter": 16,
              "verse": 27,
              "name": "Levitico 16:27",
              "text": "At ang toro na handog dahil sa kasalanan at ang kambing na handog dahil sa kasalanan, na ang dugo ay dinala sa loob ng dakong banal upang itubos, ay ilalabas, sa kampamento; at susunugin nila sa apoy ang mga balat ng mga yaon, at ang laman at ang dumi."
            },
            {
              "chapter": 16,
              "verse": 28,
              "name": "Levitico 16:28",
              "text": "At ang magsusunog ay maglalaba ng kaniyang mga suot, at maliligo ang kaniyang laman sa tubig, at pagkatapos, ay papasok siya sa kampamento."
            },
            {
              "chapter": 16,
              "verse": 29,
              "name": "Levitico 16:29",
              "text": "At ito'y magiging palatuntunan magpakailan man sa inyo: sa ikapitong buwan nang ikasangpung araw ng buwan, ay pagdadalamhatiin ninyo ang inyong mga kaluluwa, at anomang gawain ay huwag gagawa ang tubo sa lupain, ni ang taga ibang bayan na nakikipamayan sa inyo:"
            },
            {
              "chapter": 16,
              "verse": 30,
              "name": "Levitico 16:30",
              "text": "Sapagka't sa araw na ito gagawin ang pagtubos sa inyo upang linisin kayo; sa lahat ng inyong mga kasalanan ay magiging malinis kayo sa harap ng Panginoon."
            },
            {
              "chapter": 16,
              "verse": 31,
              "name": "Levitico 16:31",
              "text": "Sabbath nga na takdang kapahingahan sa inyo, at papagdadalamhatiin ninyo ang inyong mga kaluluwa; ito'y palatuntunang magpakailan man."
            },
            {
              "chapter": 16,
              "verse": 32,
              "name": "Levitico 16:32",
              "text": "At ang saserdote na papahiran at itatalaga upang maging saserdote na kahalili ng kaniyang ama, ay siyang tutubos at magsusuot ng mga kasuutang lino, na mga banal ngang kasuutan:"
            },
            {
              "chapter": 16,
              "verse": 33,
              "name": "Levitico 16:33",
              "text": "At tutubusin niya ang banal na santuario, at tutubusin niya ang tabernakulo ng kapisanan, at ang dambana; at tutubusin niya ang mga saserdote at ang buong bayan ng kapisanan."
            },
            {
              "chapter": 16,
              "verse": 34,
              "name": "Levitico 16:34",
              "text": "At ito'y magiging palatuntunang walang hanggan sa inyo; na tubusin ang mga anak ni Israel, dahil sa lahat nilang mga kasalanan, ng minsan sa isang taon. At ginawa niya ayon sa iniutos ng Panginoon kay Moises."
            }
          ]
        },
        {
          "chapter": 17,
          "name": "Levitico 17",
          "verses": [
            {
              "chapter": 17,
              "verse": 1,
              "name": "Levitico 17:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 17,
              "verse": 2,
              "name": "Levitico 17:2",
              "text": "Iyong salitain kay Aaron, at sa kaniyang mga anak, at sa lahat ng mga anak ni Israel, at sabihin mo sa kanila, Ito ang iniutos ng Panginoon, na sinasabi,"
            },
            {
              "chapter": 17,
              "verse": 3,
              "name": "Levitico 17:3",
              "text": "Sinomang tao sa sangbahayan ni Israel, na pumatay ng baka, o kordero, o kambing sa loob ng kampamento, o pumatay sa labas ng kampamento,"
            },
            {
              "chapter": 17,
              "verse": 4,
              "name": "Levitico 17:4",
              "text": "At hindi dinala sa pintuan ng tabernakulo ng kapisanan, upang ihandog na pinaka alay sa Panginoon, sa harap ng tabernakulo ng Panginoon: ay dugo ang ipararatang sa taong yaon; siya'y nagbubo ng dugo; at ang taong yaon: ay ihihiwalay sa kaniyang bayan:"
            },
            {
              "chapter": 17,
              "verse": 5,
              "name": "Levitico 17:5",
              "text": "Upang ang mga anak ni Israel ay magdala ng kanilang mga hain, na inihahain sa kalawakan ng parang, sa makatuwid baga'y upang kanilang dalhin sa Panginoon, sa pintuan ng tabernakulo ng kapisanan, sa saserdote, at ihain sa Panginoon na mga pinakahandog tungkol sa kapayapaan."
            },
            {
              "chapter": 17,
              "verse": 6,
              "name": "Levitico 17:6",
              "text": "At iwiwisik ng saserdote ang dugo sa ibabaw ng dambana ng Panginoon, sa pintuan ng tabernakulo ng kapisanan, at susunugin ang taba na pinakamasarap na amoy sa Panginoon."
            },
            {
              "chapter": 17,
              "verse": 7,
              "name": "Levitico 17:7",
              "text": "At huwag na nilang ihahain ang kanilang mga hain sa mga kambing na lalake na kanilang pinanaligan. Magiging palatuntunan nga magpakailan man sa kanila sa buong panahon ng kanilang lahi."
            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "Levitico 17:8",
              "text": "At sasabihin mo sa kanila, Sinomang tao sa sangbahayan ni Israel, o sa mga taga ibang bayan na nakikipamayan sa kanila, na naghandog ng handog na susunugin o hain,"
            },
            {
              "chapter": 17,
              "verse": 9,
              "name": "Levitico 17:9",
              "text": "At hindi dinala sa pintuan ng tabernakulo ng kapisanan, upang ihain sa Panginoon: ay ihihiwalay nga ang taong yaon sa kaniyang bayan."
            },
            {
              "chapter": 17,
              "verse": 10,
              "name": "Levitico 17:10",
              "text": "At sinomang tao sa sangbahayan ni Israel o sa mga taga ibang bayan na nakikipamayan sa kanila, na kumain ng anomang dugo, ay aking itititig ang aking mukha laban sa taong yaon na kumain ng dugo, at ihihiwalay ko sa kaniyang bayan."
            },
            {
              "chapter": 17,
              "verse": 11,
              "name": "Levitico 17:11",
              "text": "Sapagka't ang buhay ng laman ay nasa dugo; at aking ibinigay sa inyo sa ibabaw ng dambana upang itubos sa inyong mga kaluluwa: sapagka't ang dugo'y siyang tumutubos dahil sa buhay."
            },
            {
              "chapter": 17,
              "verse": 12,
              "name": "Levitico 17:12",
              "text": "Kaya't aking sinabi sa mga anak ni Israel, Sinoman sa inyo ay huwag kakain ng dugo, ni ang taga ibang bayan na nakikipamayan sa inyo ay huwag kakain ng dugo."
            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "Levitico 17:13",
              "text": "At sinomang tao sa mga anak ni Israel, o sa mga taga ibang bayan na nakikipamayan sa kanila na manghuli ng hayop o ng ibon na makakain; ay ibubuhos niya ang dugo niyaon at tatabunan ng lupa."
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "Levitico 17:14",
              "text": "Sapagka't tungkol sa buhay ng lahat ng laman, ang dugo nga niyan ay gaya rin ng buhay niyan. Kaya't sinabi ko sa mga anak ni Israel, Huwag kayong kakain ng dugo ng anomang laman: sapagka't ang buhay ng buong laman ay ang kaniyang dugo: sinomang kumain niyan ay ihihiwalay."
            },
            {
              "chapter": 17,
              "verse": 15,
              "name": "Levitico 17:15",
              "text": "At yaong lahat na kumain ng namamatay sa sarili o nilapa ng mga ganid, maging sa mga tubo sa lupain o sa mga taga ibang bayan, ay maglalaba ng kaniyang mga damit, at maliligo sa tubig, at magiging karumaldumal hanggang sa hapon: kung magkagayon ay magiging malinis."
            },
            {
              "chapter": 17,
              "verse": 16,
              "name": "Levitico 17:16",
              "text": "Datapuwa't kung di niya labhan, ni paliguan ang kaniyang laman, ay tataglayin nga niya ang kaniyang kasamaan."
            }
          ]
        },
        {
          "chapter": 18,
          "name": "Levitico 18",
          "verses": [
            {
              "chapter": 18,
              "verse": 1,
              "name": "Levitico 18:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 18,
              "verse": 2,
              "name": "Levitico 18:2",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 18,
              "verse": 3,
              "name": "Levitico 18:3",
              "text": "Huwag kayong gagawa ng gaya ng ginawa sa lupain ng Egipto na inyong tinahanan: at huwag din kayong gagawa ng gaya ng ginagawa sa lupain ng Canaan, na pinagdadalhan ko sa inyo: ni huwag kayong lalakad ng ayon sa mga palatuntunan nila."
            },
            {
              "chapter": 18,
              "verse": 4,
              "name": "Levitico 18:4",
              "text": "Tutuparin ninyo ang aking mga kahatulan, at iingatan ninyo ang aking mga palatuntunan, na inyong lalakaran: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 18,
              "verse": 5,
              "name": "Levitico 18:5",
              "text": "Tutuparin nga ninyo ang aking mga palatuntunan at ang aking mga kahatulan: na ikabubuhay ng mga taong magsisitupad: ako ang Panginoon."
            },
            {
              "chapter": 18,
              "verse": 6,
              "name": "Levitico 18:6",
              "text": "Huwag lalapit ang sinoman sa inyo sa kanino man sa kaniyang kamaganak na malapit, upang ilitaw ang kaniyang kahubaran: ako ang Panginoon."
            },
            {
              "chapter": 18,
              "verse": 7,
              "name": "Levitico 18:7",
              "text": "Ang kahubaran ng iyong ama, o ang kahubaran ng iyong ina ay huwag mong ililitaw: siya'y iyong ina; huwag mong ililitaw ang kahubaran niya."
            },
            {
              "chapter": 18,
              "verse": 8,
              "name": "Levitico 18:8",
              "text": "Ang kahubaran ng asawa ng iyong ama ay huwag mong ililitaw: yaon nga'y kahubaran ng iyong ama."
            },
            {
              "chapter": 18,
              "verse": 9,
              "name": "Levitico 18:9",
              "text": "Ang kahubaran ng iyong kapatid na babae, na anak ng iyong ama o anak ng iyong ina, maging ipinanganak sa sarili o sa ibang bayan, ay huwag mong ililitaw ang kahubaran nila."
            },
            {
              "chapter": 18,
              "verse": 10,
              "name": "Levitico 18:10",
              "text": "Ang kahubaran ng anak na babae ng iyong anak na lalake, o ng anak na babae ng iyong anak na babae, ay huwag mong ililitaw ang kahubaran nila: sapagka't ang kahubaran nila ay kahubaran mo rin."
            },
            {
              "chapter": 18,
              "verse": 11,
              "name": "Levitico 18:11",
              "text": "Ang kahubaran ng anak ng babae ng asawa ng iyong ama, na naging anak sa iyong ama, siya'y kapatid mo, huwag mong ililitaw ang kahubaran niya."
            },
            {
              "chapter": 18,
              "verse": 12,
              "name": "Levitico 18:12",
              "text": "Ang kahubaran ng kapatid na babae ng iyong ama ay huwag mong ililitaw: siya'y kamaganak na malapit ng iyong ama."
            },
            {
              "chapter": 18,
              "verse": 13,
              "name": "Levitico 18:13",
              "text": "Ang kahubaran ng kapatid na babae ng iyong ina ay huwag mong ililitaw: sapagka't siya'y kamaganak na malapit ng iyong ina."
            },
            {
              "chapter": 18,
              "verse": 14,
              "name": "Levitico 18:14",
              "text": "Ang kahubaran ng kapatid na lalake ng iyong ama ay huwag mong ililitaw, sa asawa niya ay huwag kang sisiping: siya'y iyong ali."
            },
            {
              "chapter": 18,
              "verse": 15,
              "name": "Levitico 18:15",
              "text": "Ang kahubaran ng iyong manugang na babae ay huwag mong ililitaw: siya'y asawa ng iyong anak; ang kahubaran niya ay huwag mong ililitaw."
            },
            {
              "chapter": 18,
              "verse": 16,
              "name": "Levitico 18:16",
              "text": "Ang kahubaran ng asawa ng iyong kapatid na lalake ay huwag mong ililitaw: kahubaran nga ng iyong kapatid na lalake."
            },
            {
              "chapter": 18,
              "verse": 17,
              "name": "Levitico 18:17",
              "text": "Ang kahubaran ng isang babae at ng kaniyang anak na babae ay huwag mong ililitaw; huwag mong pakikisamahan ang anak na babae ng kaniyang anak na lalake o ang anak na babae ng kaniyang anak na babae, upang ilitaw ang kaniyang kahubaran; sila'y kamaganak na malapit: kasamaan nga."
            },
            {
              "chapter": 18,
              "verse": 18,
              "name": "Levitico 18:18",
              "text": "At huwag kang makikisama sa isang babaing kalakip ng kaniyang kapatid, na magiging kaagaw niya, na iyong ililitaw ang kahubaran nito, bukod sa kahubaran niyaon, sa buong buhay niya."
            },
            {
              "chapter": 18,
              "verse": 19,
              "name": "Levitico 18:19",
              "text": "At huwag kang sisiping sa isang babae na ililitaw ang kahubaran niya habang siya'y marumi sa kaniyang karumalan."
            },
            {
              "chapter": 18,
              "verse": 20,
              "name": "Levitico 18:20",
              "text": "At huwag kang sisiping sa asawa ng iyong kapuwa, na magpapakadumi sa kaniya."
            },
            {
              "chapter": 18,
              "verse": 21,
              "name": "Levitico 18:21",
              "text": "At huwag kang magbibigay ng iyong binhi, na iyong palilipatin kay Moloch sa pamamagitan ng apoy; ni huwag mong lalapastanganin ang pangalan ng iyong Dios: ako ang Panginoon."
            },
            {
              "chapter": 18,
              "verse": 22,
              "name": "Levitico 18:22",
              "text": "Huwag kang sisiping sa lalake ng gaya sa babae: karumaldumal nga."
            },
            {
              "chapter": 18,
              "verse": 23,
              "name": "Levitico 18:23",
              "text": "At huwag kang sisiping sa anomang hayop na magpapakadumi riyan: ni ang babae ay huwag lalagay sa harap ng hayop upang pasiping: kahalayhalay nga."
            },
            {
              "chapter": 18,
              "verse": 24,
              "name": "Levitico 18:24",
              "text": "Huwag kayong magpakarumi sa alin man sa mga bagay na ito; sapagka't lahat ng ito ay nangadumhan ang mga bansang aking palayasin sa harap ninyo:"
            },
            {
              "chapter": 18,
              "verse": 25,
              "name": "Levitico 18:25",
              "text": "At nadumhan ang lupain: kaya't aking dinadalaw ang kasamaang iyan diyan, at ang lupain din ang nagluluwa sa mga tumatahan diyan."
            },
            {
              "chapter": 18,
              "verse": 26,
              "name": "Levitico 18:26",
              "text": "Inyo ngang iingatan ang aking mga palatuntunan, at ang aking mga kahatulan, at huwag kayong gagawa ng anoman sa mga karumaldumal na ito; maging ang mga tubo sa lupain o ang mga taga ibang bayan man na nakikipamayan sa inyo:"
            },
            {
              "chapter": 18,
              "verse": 27,
              "name": "Levitico 18:27",
              "text": "(Sapagka't ang lahat ng karumaldumal na ito, ay ginawa ng mga tao sa lupaing iyan, na mga una kaysa inyo; at ang lupain ay nadumhan);"
            },
            {
              "chapter": 18,
              "verse": 28,
              "name": "Levitico 18:28",
              "text": "Upang huwag naman kayong iluwa ng lupain, sa pagkahawa ninyo, na gaya ng pagluluwa sa bansang nagsitahan ng una kaysa inyo."
            },
            {
              "chapter": 18,
              "verse": 29,
              "name": "Levitico 18:29",
              "text": "Sapagka't yaong lahat na gumawa ng alin man sa mga kahalayang ito, sa makatuwid baga'y ang mga taong magsigawa ng gayon ay ihihiwalay sa kanilang bayan."
            },
            {
              "chapter": 18,
              "verse": 30,
              "name": "Levitico 18:30",
              "text": "Kaya ingatan ninyo ang aking bilin, na huwag kayong gumawa ng alin man sa mga karumaldumal na kaugaliang ito na kanilang ginawa ng una bago kayo, at huwag kayong magpakarumal sa mga iyan: ako ang Panginoon ninyong Dios."
            }
          ]
        },
        {
          "chapter": 19,
          "name": "Levitico 19",
          "verses": [
            {
              "chapter": 19,
              "verse": 1,
              "name": "Levitico 19:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 19,
              "verse": 2,
              "name": "Levitico 19:2",
              "text": "Salitain mo sa buong kapisanan ng mga anak ni Israel, at sabihin mo sa kanila, Kayo'y magpakabanal; sapagka't akong Panginoon ninyong Dios ay banal."
            },
            {
              "chapter": 19,
              "verse": 3,
              "name": "Levitico 19:3",
              "text": "Matatakot ang bawa't isa sa inyo, sa kaniyang ina at sa kaniyang ama, at ipangingilin ninyo ang aking mga sabbath: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 19,
              "verse": 4,
              "name": "Levitico 19:4",
              "text": "Huwag ninyong babalikan ang mga diosdiosan, ni huwag kayong gagawa para sa inyo ng mga dios na binubo: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 19,
              "verse": 5,
              "name": "Levitico 19:5",
              "text": "At pagka kayo'y maghahandog sa Panginoon ng hain na mga handog tungkol sa kapayapaan, ay inyong ihahandog upang kayo'y tanggapin."
            },
            {
              "chapter": 19,
              "verse": 6,
              "name": "Levitico 19:6",
              "text": "Sa araw ding ihandog ay kakanin, at sa kinabukasan: at kung may labis hanggang sa ikatlong araw ay susunugin sa apoy."
            },
            {
              "chapter": 19,
              "verse": 7,
              "name": "Levitico 19:7",
              "text": "At kung kanin sa anomang paraan sa ikatlong araw, ay karumaldumal nga; ito'y hindi tatanggapin:"
            },
            {
              "chapter": 19,
              "verse": 8,
              "name": "Levitico 19:8",
              "text": "Kundi yaong kumain ay siyang magtataglay ng kaniyang kasamaan; sapagka't nilapastangan niya ang banal na bagay ng Panginoon: at ihihiwalay ang gayong tao sa kaniyang bayan."
            },
            {
              "chapter": 19,
              "verse": 9,
              "name": "Levitico 19:9",
              "text": "At pagka gagapas kayo ng mga uhay sa inyong lupain, ay huwag ninyong pakakagapasin ang mga sulok ng inyong bukid, ni huwag ninyong pamulutan ang inyong lupang ginapasan."
            },
            {
              "chapter": 19,
              "verse": 10,
              "name": "Levitico 19:10",
              "text": "At huwag ninyong sisimutin ang inyong ubasan, ni huwag ninyong pupulutin ang bungang nahulog sa inyong ubasan; sa dukha at sa taga ibang bayan, pababayaan ninyo: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 19,
              "verse": 11,
              "name": "Levitico 19:11",
              "text": "Huwag kayong magnanakaw; ni magdadaya, ni magsisinungaling ang sinoman sa iba."
            },
            {
              "chapter": 19,
              "verse": 12,
              "name": "Levitico 19:12",
              "text": "At huwag kayong susumpa ng di totoo sa aking pangalan, na anopa't lapastanganin ninyo ang pangalan ng inyong Dios; ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 13,
              "name": "Levitico 19:13",
              "text": "Huwag kayong pipighati sa inyong kapuwa, o magnanakaw man sa kaniya: ang bayad ng isang mag-aaraw ay huwag matitira sa inyo ng buong gabi hanggang sa umaga."
            },
            {
              "chapter": 19,
              "verse": 14,
              "name": "Levitico 19:14",
              "text": "Huwag ninyong lalaitin ang bingi, ni maglalagay ng katitisuran sa harap ng bulag, kundi katatakutan ninyo ang inyong Dios: ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 15,
              "name": "Levitico 19:15",
              "text": "Huwag kayong gagawa ng kalikuan sa paghatol: huwag kayong magtatangi ng pagkatao ng dukha, ni huwag ninyong pararangalan ang pagkatao ng makapangyarihan: kundi hahatulan ninyo ng katuwiran ang inyong kapuwa."
            },
            {
              "chapter": 19,
              "verse": 16,
              "name": "Levitico 19:16",
              "text": "Huwag kayong maghahatid dumapit sa inyong bayan, ni titindig laban sa dugo ng inyong kapuwa: ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 17,
              "name": "Levitico 19:17",
              "text": "Huwag ninyong kapopootan ang inyong kapatid sa inyong puso; tunay na inyong sasawayin ang inyong kapuwa, at huwag kayong magtaglay ng kasalanan dahil sa kaniya."
            },
            {
              "chapter": 19,
              "verse": 18,
              "name": "Levitico 19:18",
              "text": "Huwag kayong manghihiganti o magtatanim laban sa mga anak ng inyong bayan, kungdi iibigin ninyo ang inyong kapuwa na gaya ng sa inyong sarili: ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 19,
              "name": "Levitico 19:19",
              "text": "Iingatan ninyo ang aking mga palatuntunan. Huwag ninyong pagaasawahin ang dalawang hayop ninyong magkaiba; huwag kayong maghahasik sa inyong bukid ng dalawang magkaibang binhi; ni damit na hinabi na may magkahalong dalawang magkaibang kayo ay huwag kayong magsusuot."
            },
            {
              "chapter": 19,
              "verse": 20,
              "name": "Levitico 19:20",
              "text": "At kung ang sinomang lalake ay sumiping sa isang babaing aliping may asawa, na hindi pa natutubos, o hindi pa man nabibigyan ng kalayaan; ay kapuwa parurusahan; hindi sila papatayin, sapagka't siya'y hindi laya."
            },
            {
              "chapter": 19,
              "verse": 21,
              "name": "Levitico 19:21",
              "text": "At kaniyang dadalhin sa Panginoon ang kaniyang handog dahil sa pagkakasala, sa pintuan ng tabernakulo ng kapisanan, sa makatuwid baga'y isang tupang lalake na pinakahandog dahil sa pagkakasala:"
            },
            {
              "chapter": 19,
              "verse": 22,
              "name": "Levitico 19:22",
              "text": "At itutubos sa kaniya ng saserdote sa pamamagitan ng tupang handog dahil sa pagkakasala sa harap ng Panginoon, dahil sa kaniyang kasalanan niyang pinagkasalahan: at ipatatawad sa kaniya ang kasalanan niyang kaniyang pinagkasalahan."
            },
            {
              "chapter": 19,
              "verse": 23,
              "name": "Levitico 19:23",
              "text": "At pagka kayo'y papasok sa lupain, at nakapagtanim na kayo ng sarisaring punong kahoy na pagkain, ay aariin ninyo ang bunga niyaon na parang hindi sa tuli: tatlong taong aariin ninyong parang hindi sa tuli; hindi kakanin."
            },
            {
              "chapter": 19,
              "verse": 24,
              "name": "Levitico 19:24",
              "text": "Datapuwa't sa ikaapat na taon, ang lahat ng bunga niyaon ay magiging banal na pinaka papuri sa Panginoon."
            },
            {
              "chapter": 19,
              "verse": 25,
              "name": "Levitico 19:25",
              "text": "At sa ikalimang taon ay kakain kayo ng bunga niyaon upang papagbungahin sa inyo: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 19,
              "verse": 26,
              "name": "Levitico 19:26",
              "text": "Huwag kayong kakain ng anomang may dugo: ni huwag kayong mag-eenkanto ni magpapamahiin."
            },
            {
              "chapter": 19,
              "verse": 27,
              "name": "Levitico 19:27",
              "text": "Huwag ninyong gugupitin ng pabilog ang mga buhok sa palibot ng inyong ulo, ni huwag mong sisirain ang mga dulo ng iyong balbas."
            },
            {
              "chapter": 19,
              "verse": 28,
              "name": "Levitico 19:28",
              "text": "Huwag ninyong kukudlitan ang inyong laman dahil sa namatay: ni huwag ninyong lilimbagan ang inyong laman ng anomang tanda; ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 29,
              "name": "Levitico 19:29",
              "text": "Huwag mong hahamakin ang iyong anak na babae, na siya'y iyong pagmamasamaing babae: baka ang lupain ay malugmok sa pakikiapid, at mapuno ang lupain ng kasamaan."
            },
            {
              "chapter": 19,
              "verse": 30,
              "name": "Levitico 19:30",
              "text": "Ipangingilin ninyo ang aking mga sabbath, at igagalang ninyo ang aking santuario: ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 31,
              "name": "Levitico 19:31",
              "text": "Huwag ninyong babalikan ang mga inaalihan ng masasamang espiritu ni ang mga mangkukulam: huwag ninyong hanapin na magpakahawa sa kanila: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 19,
              "verse": 32,
              "name": "Levitico 19:32",
              "text": "Titindig kayo sa harap ng may uban at igagalang ninyo ang mukha ng matanda, at katatakutan ninyo ang inyong Dios: ako ang Panginoon."
            },
            {
              "chapter": 19,
              "verse": 33,
              "name": "Levitico 19:33",
              "text": "At kung ang isang taga ibang bayan ay nakikipamayan na kasama ninyo sa inyong lupain, ay huwag ninyong gagawan ng masama."
            },
            {
              "chapter": 19,
              "verse": 34,
              "name": "Levitico 19:34",
              "text": "Ang taga ibang bayan na nakikipamayan na kasama ninyo, ay inyong aariing tubo sa lupain, at iibigin ninyo na gaya ng sa inyong sarili; sapagka't naging taga ibang bayan kayo sa lupain ng Egipto: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 19,
              "verse": 35,
              "name": "Levitico 19:35",
              "text": "Huwag kayong gagawa ng kalikuan sa paghatol, sa pagsukat, sa pagtimbang, o sa pagtakal."
            },
            {
              "chapter": 19,
              "verse": 36,
              "name": "Levitico 19:36",
              "text": "Timbangang matuwid, panimbang na matuwid, epa na matuwid at hin na matuwid ang aariin ninyo: ako ang Panginoon ninyong Dios na naglabas sa inyo sa lupain ng Egipto."
            },
            {
              "chapter": 19,
              "verse": 37,
              "name": "Levitico 19:37",
              "text": "At inyong iingatan ang lahat ng aking palatuntunan, at ang lahat ng aking kahatulan, at inyong isasagawa: ako ang Panginoon."
            }
          ]
        },
        {
          "chapter": 20,
          "name": "Levitico 20",
          "verses": [
            {
              "chapter": 20,
              "verse": 1,
              "name": "Levitico 20:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 20,
              "verse": 2,
              "name": "Levitico 20:2",
              "text": "Bukod dito'y sasabihin mo rin sa mga anak ni Israel, Sinomang tao sa mga anak ni Israel, o sa mga taga ibang bayan na nakikipamayan sa Israel, na magbigay ng kaniyang binhi kay Moloch; ay papataying walang pagsala; siya'y babatuhin ng mga bato ng mga tao ng lupain."
            },
            {
              "chapter": 20,
              "verse": 3,
              "name": "Levitico 20:3",
              "text": "Akin ding itititig ang aking mukha laban sa taong yaon, at akin siyang ihihiwalay sa kaniyang bayan: sapagka't binigyan niya ng kaniyang binhi si Moloch, upang ihawa ang aking santuario, at lapastanganin ang aking banal na pangalan."
            },
            {
              "chapter": 20,
              "verse": 4,
              "name": "Levitico 20:4",
              "text": "At kung ilingid ng bayan sa lupain sa paraang anoman ang kanilang mga mata sa taong yaon, pagka nagbibigay ng kaniyang binhi kay Moloch, at hindi papatayin:"
            },
            {
              "chapter": 20,
              "verse": 5,
              "name": "Levitico 20:5",
              "text": "Ay itititig ko nga ang aking mukha laban sa taong yaon, at laban sa kaniyang sangbahayan, at ihihiwalay ko sa kanilang bayan, siya at lahat ng manalig na sumunod sa kaniya, na nanalig kay Moloch."
            },
            {
              "chapter": 20,
              "verse": 6,
              "name": "Levitico 20:6",
              "text": "At ang taong magbalik sa inaalihan ng masamang espiritu at sa mga mangkukulam, upang manalig sa mga yaon ay itititig ko ang aking mukha laban sa taong yaon, at ihihiwalay ko siya sa kaniyang bayan."
            },
            {
              "chapter": 20,
              "verse": 7,
              "name": "Levitico 20:7",
              "text": "Magpakabanal nga kayo at kayo'y maging banal; sapagka't ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 20,
              "verse": 8,
              "name": "Levitico 20:8",
              "text": "At iingatan ninyo ang aking mga palatuntunan, at inyong isasagawa: ako ang Panginoon na nagpapabanal sa inyo."
            },
            {
              "chapter": 20,
              "verse": 9,
              "name": "Levitico 20:9",
              "text": "Sapagka't bawa't isa na lumalait sa kaniyang ama o sa kaniyang ina ay papatayin na walang pagsala: kaniyang nilait ang kaniyang ama o ang kaniyang ina: mabububo ang kaniyang dugo sa kaniya."
            },
            {
              "chapter": 20,
              "verse": 10,
              "name": "Levitico 20:10",
              "text": "Ang lalake na mangalunya sa asawa ng iba, sa makatuwid baga'y yaong mangalunya sa asawa ng kaniyang kapuwa, ay papatayin na walang pagsala ang nangangalunya at ang napakalunya."
            },
            {
              "chapter": 20,
              "verse": 11,
              "name": "Levitico 20:11",
              "text": "At ang lalaking sumiping sa asawa ng kaniyang ama, ay kahubaran ng kaniyang ama ang kaniyang inilitaw: kapuwa sila papatayin na walang pagsala; mabububo ang dugo nila sa kanila."
            },
            {
              "chapter": 20,
              "verse": 12,
              "name": "Levitico 20:12",
              "text": "At kung ang isang lalake ay sumiping sa kaniyang manugang, ay kapuwa sila papatayin; sila'y gumawa ng kahalayhalay; mabububo ang kanilang dugo sa kanila."
            },
            {
              "chapter": 20,
              "verse": 13,
              "name": "Levitico 20:13",
              "text": "At kung ang isang lalake ay sumiping sa kapuwa lalake, na gaya ng pagsiping sa babae: ay kapuwa sila nagkasala ng karumaldumal: sila'y papatayin na walang pagsala: mabububo ang kanilang dugo sa kanila."
            },
            {
              "chapter": 20,
              "verse": 14,
              "name": "Levitico 20:14",
              "text": "At kung ang isang lalake ay magasawa sa isang babae at sa kaniyang ina, ay kasamaan; susunugin sa apoy kapuwa siya at sila; upang huwag magkaroon ng kasamaan sa inyo."
            },
            {
              "chapter": 20,
              "verse": 15,
              "name": "Levitico 20:15",
              "text": "At kung ang isang lalake ay makiapid sa hayop, ay papatayin na walang pagsala: at papatayin din ninyo ang hayop."
            },
            {
              "chapter": 20,
              "verse": 16,
              "name": "Levitico 20:16",
              "text": "At kung ang isang babae ay lumapit sa alin mang hayop at pasiping ay papatayin mo ang babae at ang hayop: sila'y papatayin na walang pagsala; mabububo ang kanilang dugo sa kanila."
            },
            {
              "chapter": 20,
              "verse": 17,
              "name": "Levitico 20:17",
              "text": "At kung kunin ng isang lalake ang kaniyang kapatid na babae, na anak ng kaniyang ama o anak ng kaniyang ina, at kaniyang makita ang kaniyang kahubaran, at makita ng babae ang kahubaran niya: ay bagay na kahalayhalay nga; at sila'y ihihiwalay sa paningin ng mga anak ng kanilang bayan: ang kahubaran ng kaniyang kapatid na babae ay inilitaw niya; kaniyang tataglayin ang kasamaan niya."
            },
            {
              "chapter": 20,
              "verse": 18,
              "name": "Levitico 20:18",
              "text": "At kung ang isang lalake ay sumiping sa isang babaing may karumalan, at ilitaw ang kahubaran niya; ay kaniyang hinubdan ang agas niya, at siya naman ay lumitaw ng agas ng kaniyang dugo: at sila'y kapuwa ihihiwalay sa kanilang bayan."
            },
            {
              "chapter": 20,
              "verse": 19,
              "name": "Levitico 20:19",
              "text": "At huwag mong ililitaw ang kahubaran ng kapatid na babae ng iyong ina, ni ng kapatid na babae ng iyong ama: sapagka't hinubdan niya ang kaniyang kamaganak na malapit: kapuwa magtataglay ng kanilang kasamaan."
            },
            {
              "chapter": 20,
              "verse": 20,
              "name": "Levitico 20:20",
              "text": "At kung ang isang lalake ay sumiping sa asawa ng kaniyang amain ay kaniyang inilitaw ang kahubaran ng kaniyang amain: tataglayin nila ang kanilang kasalanan; mamamatay silang walang anak."
            },
            {
              "chapter": 20,
              "verse": 21,
              "name": "Levitico 20:21",
              "text": "At kung ang isang lalake ay makisama sa asawa ng kaniyang kapatid na lalake, ay kahalayan: kaniyang inilitaw ang kahubaran ng kaniyang kapatid na lalake; mabubuhay silang walang anak."
            },
            {
              "chapter": 20,
              "verse": 22,
              "name": "Levitico 20:22",
              "text": "Ingatan nga ninyo ang lahat ng aking mga palatuntunan at ang lahat ng aking mga kahatulan, at inyong isasagawa: upang huwag kayong iluwa ng lupain na aking pinagdadalhan sa inyo na inyong tatahanan."
            },
            {
              "chapter": 20,
              "verse": 23,
              "name": "Levitico 20:23",
              "text": "At huwag kayong lalakad ng ayon sa mga kaugalian ng mga bansang aking palalayasin sa harap ninyo: sapagka't ang lahat ng kasamaang ito ay ginawa nila, at kaya ko kinapopootan."
            },
            {
              "chapter": 20,
              "verse": 24,
              "name": "Levitico 20:24",
              "text": "Datapuwa't sa inyo'y aking sinabi, Mamanahin ninyo ang lupain nila, at ibibigay ko sa inyo upang inyong manahin, na isang lupaing binubukalan ng gatas at pulot: ako ang Panginoon ninyong Dios na ibinukod ko kayo sa mga bayan."
            },
            {
              "chapter": 20,
              "verse": 25,
              "name": "Levitico 20:25",
              "text": "Inyo ngang lalagyan ng pagkakaiba ang hayop na malinis at ang karumaldumal, at ang ibong karumaldumal at ang malinis: at huwag ninyong gagawing karumaldumal ang inyong pagkatao, sa hayop o sa ibon, o sa anomang bagay na umuusad sa lupa, na inihiwalay ko sa inyo palibhasa'y mga karumaldumal."
            },
            {
              "chapter": 20,
              "verse": 26,
              "name": "Levitico 20:26",
              "text": "At kayo'y magpapakabanal sa akin: sapagka't akong, Panginoon, ay banal, at kayo'y ibinukod ko sa mga bayan, upang kayo'y maging akin."
            },
            {
              "chapter": 20,
              "verse": 27,
              "name": "Levitico 20:27",
              "text": "Ang isang lalake rin naman o kaya'y ang isang babae na inaalihan ng masamang espiritu, o mangkukulam, ay papatayin na walang pagsala, sila'y babatuhin ng mga bato: mabububo ang kanilang dugo sa kanila."
            }
          ]
        },
        {
          "chapter": 21,
          "name": "Levitico 21",
          "verses": [
            {
              "chapter": 21,
              "verse": 1,
              "name": "Levitico 21:1",
              "text": "At sinabi ng Panginoon kay Moises, Salitain mo sa mga saserdote na mga anak ni Aaron, at sabihin mo sa kanila, Sinoman ay huwag magpakahawa ng dahil sa patay, sa gitna ng kaniyang bayan,"
            },
            {
              "chapter": 21,
              "verse": 2,
              "name": "Levitico 21:2",
              "text": "Maliban sa kamaganak na malapit, sa kaniyang ina at sa kaniyang ama at sa kaniyang anak na lalake at babae, at sa kaniyang kapatid na lalake,"
            },
            {
              "chapter": 21,
              "verse": 3,
              "name": "Levitico 21:3",
              "text": "At sa kaniyang kapatid na dalaga, na malapit sa kaniya, na walang asawa, ay maaring magpakahawa siya."
            },
            {
              "chapter": 21,
              "verse": 4,
              "name": "Levitico 21:4",
              "text": "Yamang puno sa kaniyang bayan, ay huwag siyang magpapakahawa na magpapakarumi."
            },
            {
              "chapter": 21,
              "verse": 5,
              "name": "Levitico 21:5",
              "text": "Huwag nilang kakalbuhin ang kanilang ulo, o gugupitin man ang dulo ng kanilang balbas, o kukudlitan man ang kanilang laman."
            },
            {
              "chapter": 21,
              "verse": 6,
              "name": "Levitico 21:6",
              "text": "Sila'y magpakabanal sa kanilang Dios, at huwag nilang lalapastanganin ang pangalan ng kanilang Dios: sapagka't sila ang naghahandog ng mga handog sa Panginoon na pinaraan sa apoy, na tinapay ng kanilang Dios, kaya't sila'y magpapakabanal."
            },
            {
              "chapter": 21,
              "verse": 7,
              "name": "Levitico 21:7",
              "text": "Huwag silang makikisama sa patutot o lapastangan, ni makikisama sa babaing inihiwalay ng kaniyang asawa: sapagka't ang saserdote ay banal sa kaniyang Dios."
            },
            {
              "chapter": 21,
              "verse": 8,
              "name": "Levitico 21:8",
              "text": "Papagbabanalin mo nga siya; sapagka't siya ang naghahandog ng tinapay ng inyong Dios: siya'y magiging banal sa inyo; sapagka't akong Panginoon nagpapaging banal sa inyo ay banal."
            },
            {
              "chapter": 21,
              "verse": 9,
              "name": "Levitico 21:9",
              "text": "At kung ang anak na babae ng isang saserdote ay magpakarumi sa pagpapatutot, ay kaniyang binigyan ng kahihiyan ang kaniyang ama: siya'y susunugin sa apoy."
            },
            {
              "chapter": 21,
              "verse": 10,
              "name": "Levitico 21:10",
              "text": "At ang pangulong saserdote sa kanilang magkakapatid, na binuhusan ang ulo ng langis na pang-pahid, at itinalaga, upang makapagbihis ng mga banal na bihisan ay huwag maglulugay ng buhok ng kaniyang ulo ni huwag hahapakin ang kaniyang mga suot;"
            },
            {
              "chapter": 21,
              "verse": 11,
              "name": "Levitico 21:11",
              "text": "Ni papasok sa kinaroroonan ng bangkay nino man, ni magpapakahawa dahil sa kaniyang ama, o dahil sa kaniyang ina;"
            },
            {
              "chapter": 21,
              "verse": 12,
              "name": "Levitico 21:12",
              "text": "Ni lalabas sa santuario, ni lalapastanganin ang santuario ng kaniyang Dios; sapagka't ang talaga na langis na pang-pahid ng kaniyang Dios ay nasa ulo niya: ako ang Panginoon."
            },
            {
              "chapter": 21,
              "verse": 13,
              "name": "Levitico 21:13",
              "text": "At siya'y magaasawa sa isang dalagang malinis."
            },
            {
              "chapter": 21,
              "verse": 14,
              "name": "Levitico 21:14",
              "text": "Sa bao o inihiwalay, sa lamas o patutot ay huwag siyang magaasawa; kundi sa isang dalagang malinis sa kaniyang sariling bayan magaasawa siya."
            },
            {
              "chapter": 21,
              "verse": 15,
              "name": "Levitico 21:15",
              "text": "At huwag niyang dudumhan ang kaniyang mga binhi sa gitna ng kaniyang bayan: sapagka't ako ang Panginoon na nagpapaging banal sa kaniya."
            },
            {
              "chapter": 21,
              "verse": 16,
              "name": "Levitico 21:16",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 21,
              "verse": 17,
              "name": "Levitico 21:17",
              "text": "Iyong salitain kay Aaron, na iyong sasabihin, Sinoman sa iyong mga binhi, sa buong panahon ng kaniyang lahi, na magkaroon ng anomang kapintasan, ay huwag lumapit na maghandog ng tinapay ng kaniyang Dios."
            },
            {
              "chapter": 21,
              "verse": 18,
              "name": "Levitico 21:18",
              "text": "Sapagka't sinomang magkaroon ng kapintasan ay huwag lalapit; maging ang taong bulag, o pilay, o magkaroon ng ilong na ungod, o ang mayroong kuntil,"
            },
            {
              "chapter": 21,
              "verse": 19,
              "name": "Levitico 21:19",
              "text": "O ang taong magkaroon ng paang bali o kamay na bali,"
            },
            {
              "chapter": 21,
              "verse": 20,
              "name": "Levitico 21:20",
              "text": "O taong kuba, o unano, o magkaroon ng kapintasan sa kaniyang mata, o galisin, o langibin, o luslusin:"
            },
            {
              "chapter": 21,
              "verse": 21,
              "name": "Levitico 21:21",
              "text": "Walang tao sa binhi ni Aaron na saserdote, na magkaroon ng kapintasan, na lalapit upang magharap ng mga handog sa Panginoon na pinaraan sa apoy: siya'y may kapintasan; siya'y huwag lalapit na magharap ng tinapay ng kaniyang Dios."
            },
            {
              "chapter": 21,
              "verse": 22,
              "name": "Levitico 21:22",
              "text": "Kaniyang kakanin ang tinapay ng kaniyang Dios, ang pinakabanal at ang mga bagay na banal:"
            },
            {
              "chapter": 21,
              "verse": 23,
              "name": "Levitico 21:23",
              "text": "Hindi lamang siya papasok sa loob ng tabing, o lalapit man sa dambana, sapagka't may kapintasan siya; upang huwag niyang lapastanganin ang aking mga santuario: sapagka't ako ang Panginoon na nagpapaging banal sa kanila."
            },
            {
              "chapter": 21,
              "verse": 24,
              "name": "Levitico 21:24",
              "text": "Gayon sinalita ni Moises kay Aaron at sa kaniyang mga anak, at sa lahat ng mga anak ni Israel."
            }
          ]
        },
        {
          "chapter": 22,
          "name": "Levitico 22",
          "verses": [
            {
              "chapter": 22,
              "verse": 1,
              "name": "Levitico 22:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 22,
              "verse": 2,
              "name": "Levitico 22:2",
              "text": "Salitain mo kay Aaron at sa kaniyang mga anak na sila'y magsihiwalay sa mga banal na bagay ng mga anak ni Israel, na ikinagiging banal nila sa akin, at huwag nilang lapastanganin ang aking banal na pangalan: ako ang Panginoon."
            },
            {
              "chapter": 22,
              "verse": 3,
              "name": "Levitico 22:3",
              "text": "Sabihin mo sa kanila, Sinomang lalake sa lahat ng inyong binhi sa buong panahon ng inyong lahi, na lumapit sa mga banal na bagay na ikinagiging banal ng mga anak ni Israel sa Panginoon, na taglay ang kaniyang karumihan, ay ihihiwalay ang taong iyon sa harap ko: ako ang Panginoon."
            },
            {
              "chapter": 22,
              "verse": 4,
              "name": "Levitico 22:4",
              "text": "Sinomang lalake sa binhi ni Aaron na may ketong o may agas; ay hindi kakain ng mga banal na bagay hanggang siya'y malinis. At ang humipo ng alin mang bagay na karumaldumal dahil sa patay, o lalaking nilabasan ng binhi nito;"
            },
            {
              "chapter": 22,
              "verse": 5,
              "name": "Levitico 22:5",
              "text": "O sinomang humipo ng anomang umuusad na makapagpaparumi, o lalaking makakahawa dahil sa alin mang karumihan niya;"
            },
            {
              "chapter": 22,
              "verse": 6,
              "name": "Levitico 22:6",
              "text": "Ang lalaking humipo ng gayon ay magiging karumaldumal hanggang sa hapon, at hindi kakain ng mga banal na bagay maliban na maligo siya sa tubig."
            },
            {
              "chapter": 22,
              "verse": 7,
              "name": "Levitico 22:7",
              "text": "At pagkalubog ng araw, ay magiging malinis siya; at pagkatapos ay makakakain ng mga banal na bagay, sapagka't siya niyang tinapay."
            },
            {
              "chapter": 22,
              "verse": 8,
              "name": "Levitico 22:8",
              "text": "Yaong bagay na namatay sa sarili, o nilapa ng mga ganid, ay huwag niyang kakanin, na makapagpapahawa sa kaniya: ako ang Panginoon."
            },
            {
              "chapter": 22,
              "verse": 9,
              "name": "Levitico 22:9",
              "text": "Iingatan nga nila ang aking bilin, baka sila'y magkasala sa paraang iyan, at kanilang ikamatay, kung kanilang lapastanganin: ako ang Panginoon na nagpapaging banal sa kanila."
            },
            {
              "chapter": 22,
              "verse": 10,
              "name": "Levitico 22:10",
              "text": "Hindi makakakain ang sinomang taga ibang bayan ng banal na bagay: sinomang nakikipanuluyan sa saserdote, o aliping upahan niya ay hindi makakakain ng banal na bagay."
            },
            {
              "chapter": 22,
              "verse": 11,
              "name": "Levitico 22:11",
              "text": "Nguni't kung ang saserdote ay bumili ng sinomang tao sa kaniyang salapi, ay makakakain ito; at gayon din ang aliping inianak sa kaniyang bahay ay makakakain ng kaniyang tinapay."
            },
            {
              "chapter": 22,
              "verse": 12,
              "name": "Levitico 22:12",
              "text": "At kung ang isang anak na babae ng saserdote ay magasawa sa isang taga ibang bayan, ay hindi makakakain sa handog na itinaas sa mga banal na bagay."
            },
            {
              "chapter": 22,
              "verse": 13,
              "name": "Levitico 22:13",
              "text": "Datapuwa't kung ang anak na babae ng saserdote ay bao o inihiwalay, na walang anak at bumalik sa bahay ng kaniyang ama na gaya rin ng kaniyang pagkadalaga, ay makakakain ng tinapay ng kaniyang ama, nguni't ang sinomang taga ibang bayan ay hindi makakakain niyaon."
            },
            {
              "chapter": 22,
              "verse": 14,
              "name": "Levitico 22:14",
              "text": "At kung ang sinomang lalake ay magkamaling kumain ng banal na bagay, ay kaniyang daragdagan pa nga ng ikalimang bahagi yaon, at ibibigay niya sa saserdote ang banal na bagay."
            },
            {
              "chapter": 22,
              "verse": 15,
              "name": "Levitico 22:15",
              "text": "At huwag nilang dudumhan ang mga banal na bagay ng mga anak ni Israel, na inihahandog sa Panginoon;"
            },
            {
              "chapter": 22,
              "verse": 16,
              "name": "Levitico 22:16",
              "text": "At gayon papasanin ang kasamaan ng nagtataglay ng sala, pagka kanilang kinakain ang kanilang mga banal na bagay: sapagka't ako ang Panginoon na nagpapaging banal sa kanila."
            },
            {
              "chapter": 22,
              "verse": 17,
              "name": "Levitico 22:17",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 22,
              "verse": 18,
              "name": "Levitico 22:18",
              "text": "Salitain mo kay Aaron at sa kaniyang mga anak, at sa lahat ng mga anak ni Israel, at sabihin mo sa kanila, Sinoman sa sangbahayan ni Israel, o sa mga taga ibang bayan sa Israel, na maghahandog ng kaniyang alay, maging anomang panata nila, o maging anomang kusang handog nila, na kanilang inihahandog sa Panginoon na pinakahandog na susunugin;"
            },
            {
              "chapter": 22,
              "verse": 19,
              "name": "Levitico 22:19",
              "text": "Upang kayo'y tanggapin, ang inyong ihahandog ay lalaking hayop na walang kapintasan, sa mga baka, sa mga tupa, o sa mga kambing."
            },
            {
              "chapter": 22,
              "verse": 20,
              "name": "Levitico 22:20",
              "text": "Datapuwa't alin mang may kapintasan, ay huwag ninyong ihahandog; sapagka't hindi tatanggapin sa inyo."
            },
            {
              "chapter": 22,
              "verse": 21,
              "name": "Levitico 22:21",
              "text": "At sinomang maghandog sa Panginoon ng haing handog tungkol sa kapayapaan, sa pagtupad ng isang panata o kaya'y kusang handog, na mula sa bakahan o sa kawan ay kinakailangang sakdal, upang tanggapin; anomang kapintasan ay huwag magkakaroon."
            },
            {
              "chapter": 22,
              "verse": 22,
              "name": "Levitico 22:22",
              "text": "Bulag, o may bali, o may hiwa, o may sugat, o galisin, o malangib, ay huwag ninyong ihahandog ang mga ito sa Panginoon, ni huwag kayong maghahandog sa Panginoon ng mga iyan na pinaraan sa apoy sa ibabaw ng dambana."
            },
            {
              "chapter": 22,
              "verse": 23,
              "name": "Levitico 22:23",
              "text": "Maging toro o tupa na may anomang kuntil o kulang sa kaniyang sangkap ng katawan, ay maihahandog mo na handog mo na kusa, datapuwa't sa panata ay hindi tatanggapin."
            },
            {
              "chapter": 22,
              "verse": 24,
              "name": "Levitico 22:24",
              "text": "Yaong niluluslusan, o napisa, o nabasag, o naputol ay huwag ninyong ihahandog sa Panginoon; ni huwag kayong gagawa ng ganyan sa inyong lupain."
            },
            {
              "chapter": 22,
              "verse": 25,
              "name": "Levitico 22:25",
              "text": "Ni mula sa kamay ng taga ibang lupa ay huwag ninyong ihahandog na pinakatinapay ng inyong Dios ang alin mang mga hayop na ito: sapagka't taglay nila ang kanilang karumhan, may kapintasan sa mga iyan: hindi tatanggapin sa inyo."
            },
            {
              "chapter": 22,
              "verse": 26,
              "name": "Levitico 22:26",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 22,
              "verse": 27,
              "name": "Levitico 22:27",
              "text": "Pagka may ipinanganak, na baka, o tupa, o kambing ay mapapasa kaniyang ina ngang pitong araw; at mula sa ikawalong araw hanggang sa haharapin ay tatanggaping alay sa Panginoon na handog na pinaraan sa apoy."
            },
            {
              "chapter": 22,
              "verse": 28,
              "name": "Levitico 22:28",
              "text": "At maging baka o tupa ay huwag ninyong papatayin sa isang araw siya at ang kaniyang anak."
            },
            {
              "chapter": 22,
              "verse": 29,
              "name": "Levitico 22:29",
              "text": "At pagka kayo'y maghahandog ng haing pasalamat sa Panginoon, ay inyong ihahain upang kayo'y tanggapin."
            },
            {
              "chapter": 22,
              "verse": 30,
              "name": "Levitico 22:30",
              "text": "Sa araw ding iyan kakanin; huwag kayong magtitira ng anoman niyan hanggang sa umaga: ako ang Panginoon."
            },
            {
              "chapter": 22,
              "verse": 31,
              "name": "Levitico 22:31",
              "text": "Kaya't inyong iingatan ang aking mga utos, at inyong tutuparin: ako ang Panginoon."
            },
            {
              "chapter": 22,
              "verse": 32,
              "name": "Levitico 22:32",
              "text": "At huwag ninyong lalapastanganin ang aking banal na pangalan; kundi ako'y sasambahin sa gitna ng mga anak ni Israel: ako ang Panginoon na nagpapaging banal sa inyo,"
            },
            {
              "chapter": 22,
              "verse": 33,
              "name": "Levitico 22:33",
              "text": "Na naglabas sa inyo sa lupain ng Egipto, upang ako'y maging inyong Dios: ako ang Panginoon."
            }
          ]
        },
        {
          "chapter": 23,
          "name": "Levitico 23",
          "verses": [
            {
              "chapter": 23,
              "verse": 1,
              "name": "Levitico 23:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 23,
              "verse": 2,
              "name": "Levitico 23:2",
              "text": "Salitain mo sa mga anak ni Israel at sabihin mo sa kanila, ang mga takdang kapistahan sa Panginoon, na inyong itatanyag na mga banal na pagpupulong, ay mga ito nga ang aking mga takdang kapistahan."
            },
            {
              "chapter": 23,
              "verse": 3,
              "name": "Levitico 23:3",
              "text": "Anim na araw na gagawa: datapuwa't sa ikapitong araw ay sabbath na takdang kapahingahan, siyang banal na pagpupulong; anomang gawa ay huwag ninyong gagawin: isang sabbath sa Panginoon sa lahat ng inyong tahanan."
            },
            {
              "chapter": 23,
              "verse": 4,
              "name": "Levitico 23:4",
              "text": "Ito ang mga takdang kapistahan sa Panginoon ng mga banal na pagpupulong na inyong itatanyag sa takdang panahon."
            },
            {
              "chapter": 23,
              "verse": 5,
              "name": "Levitico 23:5",
              "text": "Sa unang buwan, nang ikalabing apat na araw ng buwan, sa paglubog ng araw, ay paskua sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 6,
              "name": "Levitico 23:6",
              "text": "At nang ikalabing limang araw ng buwang iyan, ay kapistahan ng tinapay na walang lebadura sa Panginoon: pitong araw na kakain kayo ng tinapay na walang lebadura."
            },
            {
              "chapter": 23,
              "verse": 7,
              "name": "Levitico 23:7",
              "text": "Sa unang araw ay magkakaroon ng banal na pagpupulong: anomang gawang paglilingkod ay huwag ninyong gagawin."
            },
            {
              "chapter": 23,
              "verse": 8,
              "name": "Levitico 23:8",
              "text": "Kundi maghahandog kayo sa Panginoon na pitong araw ng handog na pinaraan sa apoy; sa ikapitong araw ay magkakaroon ng banal na pagpupulong anomang gawang paglilingkod ay huwag ninyong gagawin."
            },
            {
              "chapter": 23,
              "verse": 9,
              "name": "Levitico 23:9",
              "text": "At sinalita ng Panginoon kay Moises na sinasabi,"
            },
            {
              "chapter": 23,
              "verse": 10,
              "name": "Levitico 23:10",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagka kayo'y nakapasok sa lupain na ibibigay ko sa inyo, at inyong nagapas na ang ani niyaon, ay magdadala nga kayo sa saserdote ng bigkis na pinaka pangunang bunga ng inyong paggapas:"
            },
            {
              "chapter": 23,
              "verse": 11,
              "name": "Levitico 23:11",
              "text": "At aalugin niya ang bigkis sa harap ng Panginoon upang tanggapin sa ganang inyo: sa kinabukasan pagkatapos ng sabbath aalugin ng saserdote."
            },
            {
              "chapter": 23,
              "verse": 12,
              "name": "Levitico 23:12",
              "text": "At sa araw na inyong alugin ang bigkis, ay maghahandog kayo ng isang korderong lalake ng unang taon, na walang kapintasan, na pinakahandog na susunugin sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 13,
              "name": "Levitico 23:13",
              "text": "At ang handog na harina niyaon ay magiging dalawang ikasangpung bahagi ng isang epa ng mainam na harina na hinaluan ng langis, handog nga sa Panginoon na pinaraan sa apoy na pinakamasarap na amoy: at ang pinakahandog na inumin niyaon ay alak, na ikaapat na bahagi ng isang hin."
            },
            {
              "chapter": 23,
              "verse": 14,
              "name": "Levitico 23:14",
              "text": "At huwag kayong kakain ng tinapay, ni trigong sinangag, ni uhay na bago, hanggang sa araw na ito, hanggang sa inyong madala ang alay sa inyong Dios: siyang palatuntunan magpakailan man sa buong panahon ng inyong lahi, sa lahat ng inyong mga tahanan."
            },
            {
              "chapter": 23,
              "verse": 15,
              "name": "Levitico 23:15",
              "text": "At kayo'y bibilang sa inyo mula sa kinabukasan ng sabbath mula sa araw na inyong dalhin ang bigkis na handog na inalog: magiging pitong sabbath na ganap."
            },
            {
              "chapter": 23,
              "verse": 16,
              "name": "Levitico 23:16",
              "text": "Sa makatuwid baga'y hanggang sa kinabukasan ng ikapitong sabbath, bibilang kayo ng limang pung araw; at maghahandog kayo ng bagong handog na harina sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 17,
              "name": "Levitico 23:17",
              "text": "Sa inyong mga tahanan ay magdadala kayo ng dalawang tinapay na aalugin na may dalawang ikasangpung bahagi ng isang epa ng mainam na harina, at lulutuin na may levadura na pinaka pangunang bunga sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 18,
              "name": "Levitico 23:18",
              "text": "At ihaharap ninyo ang tinapay na kalakip ng pitong kordero ng unang taon na walang kapintasan, at ng isang guyang toro at ng dalawang tupang lalake: mga handog sa Panginoon na susunugin, na kalakip ng kanilang handog na harina, at ng kanilang mga handog na inumin, handog nga na pinaraan sa apoy na pinakamasarap na amoy sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 19,
              "name": "Levitico 23:19",
              "text": "At maghahandog kayo ng isang lalaking kambing na pinakahandog dahil sa kasalanan, at ng dalawang korderong lalake ng unang taon na haing mga handog tungkol sa kapayapaan."
            },
            {
              "chapter": 23,
              "verse": 20,
              "name": "Levitico 23:20",
              "text": "At aalugin ng saserdote pati ng tinapay ng mga unang bunga, na pinakahandog na inalog sa harap ng Panginoon, na kalakip ng dalawang kordero: ang mga tinapay ay magiging itinalaga sa Panginoon na ukol sa saserdote."
            },
            {
              "chapter": 23,
              "verse": 21,
              "name": "Levitico 23:21",
              "text": "At inyong ihahayag sa araw ding iyan; magiging banal na pagpupulong nga sa inyo; kayo'y huwag gagawa ng anomang gawang paglilingkod: siyang palatuntunan sa lahat ng inyong mga tahanan, sa buong panahon ng inyong lahi."
            },
            {
              "chapter": 23,
              "verse": 22,
              "name": "Levitico 23:22",
              "text": "At pagka inyong aanihin ang ani sa inyong lupain, ay huwag ninyong pakakaanihin ang mga sulok ng inyong bukid, ni pamulutan ang inyong naanihan: sa dukha at sa taga ibang lupa inyong ititira: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 23,
              "verse": 23,
              "name": "Levitico 23:23",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 23,
              "verse": 24,
              "name": "Levitico 23:24",
              "text": "Salitain mo sa mga anak ni Israel, na iyong sabihin, Sa ikapitong buwan, sa unang araw ng buwan, ay magkakaroon kayo ng takdang kapahingahan, na pinakaalaalang may tunog ng mga pakakak banal na pagpupulong nga."
            },
            {
              "chapter": 23,
              "verse": 25,
              "name": "Levitico 23:25",
              "text": "Kayo'y huwag gagawa ng anomang gawang paglilingkod: at kayo'y maghahandog ng handog sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 23,
              "verse": 26,
              "name": "Levitico 23:26",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 23,
              "verse": 27,
              "name": "Levitico 23:27",
              "text": "Gayon ma'y sa ikasangpung araw nitong ikapitong buwan ay araw ng pagtubos: magiging sa inyo'y banal na pagpupulong, at papagdadalamhatiin ninyo ang inyong mga kaluluwa; at maghahandog kayo ng handog sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 23,
              "verse": 28,
              "name": "Levitico 23:28",
              "text": "At huwag kayong gagawa ng anomang gawa sa araw ding iyan: sapagka't araw ng pagtubos, upang itubos sa inyo sa harap ng Panginoon ninyong Dios."
            },
            {
              "chapter": 23,
              "verse": 29,
              "name": "Levitico 23:29",
              "text": "Sapagka't sinomang tao na hindi magdalamhati sa araw ding iyan ay ihihiwalay sa kaniyang bayan."
            },
            {
              "chapter": 23,
              "verse": 30,
              "name": "Levitico 23:30",
              "text": "At sinomang tao na gumawa ng anomang gawa sa araw ding iyan ay pupuksain ko ang taong yaon sa kaniyang bayan."
            },
            {
              "chapter": 23,
              "verse": 31,
              "name": "Levitico 23:31",
              "text": "Kayo'y huwag gagawa ng anomang gawa: siyang palatuntunan magpakailan man sa buong panahon ng inyong lahi sa lahat ng inyong mga tahanan."
            },
            {
              "chapter": 23,
              "verse": 32,
              "name": "Levitico 23:32",
              "text": "Magiging sabbath na takdang kapahingahan sa inyo, at inyong pagdadalamhatiin ang inyong mga kaluluwa sa ikasiyam na araw ng buwan sa hapon, mula sa pagkalubog ng araw hanggang sa muling pagkalubog ng araw ay ipangingilin ninyo ang inyong sabbath."
            },
            {
              "chapter": 23,
              "verse": 33,
              "name": "Levitico 23:33",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 23,
              "verse": 34,
              "name": "Levitico 23:34",
              "text": "Iyong salitain sa mga anak ni Israel, na sabihin, Sa ikalabing limang araw ng ikapitong buwang ito ay kapistahan ng mga balag na pitong araw sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 35,
              "name": "Levitico 23:35",
              "text": "Sa unang araw ay magkakaroon ng banal na pagpupulong; kayo'y huwag gagawa ng anomang gawang paglilingkod."
            },
            {
              "chapter": 23,
              "verse": 36,
              "name": "Levitico 23:36",
              "text": "Pitong araw na maghahandog kayo sa Panginoon ng handog na pinaraan sa apoy; sa ikawalong araw ay magkakaroon kayo ng banal na pagpupulong; at kayo'y maghahandog sa Panginoon ng handog na pinaraan sa apoy; siyang pinaka dakilang kapulungan; huwag kayong gagawa ng anomang gawang paglilingkod."
            },
            {
              "chapter": 23,
              "verse": 37,
              "name": "Levitico 23:37",
              "text": "Ito ang mga takdang kapistahan sa Panginoon, na inyong itatanyag na mga banal na pagpupulong, upang maghandog sa Panginoon ng handog na pinaraan sa apoy, ng handog na susunugin, at ng handog na harina, ng hain, at ng mga handog na inumin na bawa't isa ay sa kaniyang sariling kaarawan:"
            },
            {
              "chapter": 23,
              "verse": 38,
              "name": "Levitico 23:38",
              "text": "Bukod sa mga sabbath sa Panginoon, at bukod sa inyong mga kaloob, at bukod sa lahat ng inyong mga panata, at bukod sa lahat ng inyong mga handog na kusa na inyong ibinibigay sa Panginoon."
            },
            {
              "chapter": 23,
              "verse": 39,
              "name": "Levitico 23:39",
              "text": "Gayon ma'y sa ikalabing limang araw ng ikapitong buwan, pagka inyong natipon ang bunga ng lupain, ay magdidiwang kayo sa Panginoon ng kapistahang pitong araw: ang unang araw ay magiging takdang kapahingahan, at ang ikawalong araw ay magiging takdang kapahingahan."
            },
            {
              "chapter": 23,
              "verse": 40,
              "name": "Levitico 23:40",
              "text": "At magdadala kayo sa unang araw ng bunga ng magagandang punong kahoy, ng mga sanga ng mga palma, at ng mga sanga ng mayayabong na punong kahoy, at ng mga sause ng batis; at kayo'y magpapakagalak sa harap ng Panginoon ninyong Dios, na pitong araw."
            },
            {
              "chapter": 23,
              "verse": 41,
              "name": "Levitico 23:41",
              "text": "At inyong ipangingiling isang kapistahan sa Panginoon na pitong araw sa bawa't taon: siyang palatuntunan magpakailan man sa buong panahon ng inyong lahi: sa ikapitong buwan ay ipagdidiwang ninyo ang kapistahang ito."
            },
            {
              "chapter": 23,
              "verse": 42,
              "name": "Levitico 23:42",
              "text": "Kayo'y tatahan sa mga balag na pitong araw; yaong lahat ng tubo sa Israel ay tatahan sa mga balag:"
            },
            {
              "chapter": 23,
              "verse": 43,
              "name": "Levitico 23:43",
              "text": "Upang maalaman ng inyong mga lahi na sa mga balag pinatahan ko ang mga anak ni Israel, nang aking ilabas sa lupain ng Egipto: ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 23,
              "verse": 44,
              "name": "Levitico 23:44",
              "text": "At ipinakilala ni Moises sa mga anak ni Israel ang mga takdang kapistahan sa Panginoon."
            }
          ]
        },
        {
          "chapter": 24,
          "name": "Levitico 24",
          "verses": [
            {
              "chapter": 24,
              "verse": 1,
              "name": "Levitico 24:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 24,
              "verse": 2,
              "name": "Levitico 24:2",
              "text": "Iutos mo sa mga anak ni Israel na dalhan ka ng langis na dalisay na oliva, na hinalo para sa ilawan, upang laging papagliyabin ang ilawan."
            },
            {
              "chapter": 24,
              "verse": 3,
              "name": "Levitico 24:3",
              "text": "Sa labas ng tabing ng kaban ng patotoo sa tabernakulo ng kapisanan, ay aayusing palagi ni Aaron, mula sa hapon hanggang sa umaga sa harap ng Panginoon: siyang palatuntunan magpakailan man sa buong panahon ng inyong lahi."
            },
            {
              "chapter": 24,
              "verse": 4,
              "name": "Levitico 24:4",
              "text": "Kanyang aayusin lagi ang mga ilawan sa ibabaw ng kandelerong dalisay sa harap ng Panginoon."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "Levitico 24:5",
              "text": "At kukuha ka ng mainam na harina, at magluluto ka niyan ng labing dalawang munting tinapay: tigdadalawang ikasampung bahagi ng isang epa ang bawa't munting tinapay."
            },
            {
              "chapter": 24,
              "verse": 6,
              "name": "Levitico 24:6",
              "text": "At ilalagay mong dalawang hanay, anim sa bawa't hanay, sa ibabaw ng dulang na dalisay sa harap ng Panginoon."
            },
            {
              "chapter": 24,
              "verse": 7,
              "name": "Levitico 24:7",
              "text": "At maglalagay ka sa bawa't hanay ng dalisay na kamangyan, upang ito'y maging paalaala na tinapay, na handog nga sa Panginoon na pinaraan sa apoy."
            },
            {
              "chapter": 24,
              "verse": 8,
              "name": "Levitico 24:8",
              "text": "Sa bawa't sabbath ay aayusing palagi ang tinapay sa harap ng Panginoon; sa ganang mga anak ni Israel, na pinakatipang walang hanggan."
            },
            {
              "chapter": 24,
              "verse": 9,
              "name": "Levitico 24:9",
              "text": "At magiging kay Aaron at sa kaniyang mga anak; at kanilang kakanin sa dakong banal: sapagka't kabanalbanalang bagay sa kaniya sa mga handog sa Panginoon na pinaraan sa apoy sa pamamagitan ng palatuntunang walang hanggan."
            },
            {
              "chapter": 24,
              "verse": 10,
              "name": "Levitico 24:10",
              "text": "At ang anak na lalake ng isang babaing, Israelita na ang ama'y Egipcio, ay napasa gitna ng mga anak ni Israel: at nagbabag sa gitna ng kampamento ang anak ng babaing Israelita at ang isang lalake ni Israel."
            },
            {
              "chapter": 24,
              "verse": 11,
              "name": "Levitico 24:11",
              "text": "At nilapastangan ng anak ng babaing Israelita ang Pangalan, at nilait: at siya'y kanilang dinala kay Moises, at ang pangalan ng kaniyang ina ay Selomith, na anak ni Dribi sa lipi ni Dan."
            },
            {
              "chapter": 24,
              "verse": 12,
              "name": "Levitico 24:12",
              "text": "At siya'y kanilang inilagay sa bilangguan hanggang sa ang hatol ay ipahayag sa kanila ng bibig ng Panginoon."
            },
            {
              "chapter": 24,
              "verse": 13,
              "name": "Levitico 24:13",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 24,
              "verse": 14,
              "name": "Levitico 24:14",
              "text": "Dalhin mo ang mapaglait sa labas ng kampamento; at ang lahat ng nakarinig sa kaniya ay magpatong ng kanilang mga kamay sa kaniyang ulo, at pagbatuhanan siya ng buong kapisanan."
            },
            {
              "chapter": 24,
              "verse": 15,
              "name": "Levitico 24:15",
              "text": "At sasalitain mo sa mga anak ni Israel, na iyong sasabihin, Sinomang mapanungayaw sa kaniyang Dios ay magpapasan ng kaniyang sala."
            },
            {
              "chapter": 24,
              "verse": 16,
              "name": "Levitico 24:16",
              "text": "At ang lumapastangan sa pangalan ng Panginoon ay papataying walang pagsala; walang pagsalang pagbabatuhanan siya ng buong kapisanan: maging taga ibang lupa o maging tubo sa lupain, ay papatayin pagka lumapastangan sa Pangalan ng Panginoon."
            },
            {
              "chapter": 24,
              "verse": 17,
              "name": "Levitico 24:17",
              "text": "At ang manakit ng malubha sa kanino mang tao, ay papataying walang pagsala;"
            },
            {
              "chapter": 24,
              "verse": 18,
              "name": "Levitico 24:18",
              "text": "At ang manakit ng malubha sa isang hayop ay magpapalit: hayop kung hayop."
            },
            {
              "chapter": 24,
              "verse": 19,
              "name": "Levitico 24:19",
              "text": "At kung ang sinoman ay makasakit sa kaniyang kapuwa: ayon sa ginawa niya ay gayon ang gagawin sa kaniya;"
            },
            {
              "chapter": 24,
              "verse": 20,
              "name": "Levitico 24:20",
              "text": "Bugbog kung bugbog, mata kung mata, ngipin kung ngipin: ayon sa kaniyang pagkasakit sa tao, ay gayon din ang gagawin sa kaniya."
            },
            {
              "chapter": 24,
              "verse": 21,
              "name": "Levitico 24:21",
              "text": "At ang pumatay ng isang hayop ay magpapalit, at ang pumatay sa isang tao ay papatayin."
            },
            {
              "chapter": 24,
              "verse": 22,
              "name": "Levitico 24:22",
              "text": "Magkakaroon kayo ng isa lamang kautusan sa taga ibang bayan, na gaya sa tubo sa lupain: sapagka't ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 24,
              "verse": 23,
              "name": "Levitico 24:23",
              "text": "At nagsalita si Moises sa mga anak ni Israel at siya na nanglait ay inilabas nila sa kampamento, at siya'y pinagbatuhanan ng mga bato. At ginawa ng mga anak ni Israel, ayon sa iniutos ng Panginoon kay Moises."
            }
          ]
        },
        {
          "chapter": 25,
          "name": "Levitico 25",
          "verses": [
            {
              "chapter": 25,
              "verse": 1,
              "name": "Levitico 25:1",
              "text": "At sinalita ng Panginoon kay Moises sa bundok ng Sinai, na sinasabi,"
            },
            {
              "chapter": 25,
              "verse": 2,
              "name": "Levitico 25:2",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagpasok ninyo sa lupain na ibibigay ko sa inyo, ay mangingilin ng isang sabbath sa Panginoon ang lupain."
            },
            {
              "chapter": 25,
              "verse": 3,
              "name": "Levitico 25:3",
              "text": "Anim na taong hahasikan mo ang iyong bukid, at anim na taong kakapunin mo ang iyong ubasan, at titipunin mo ang bunga ng mga iyan;"
            },
            {
              "chapter": 25,
              "verse": 4,
              "name": "Levitico 25:4",
              "text": "Datapuwa't sa ikapitong taon ay magiging sabbath na takdang kapahingahan sa lupain, sabbath sa Panginoon: huwag mong hahasikan ang iyong bukid, ni kakapunin ang iyong ubasan."
            },
            {
              "chapter": 25,
              "verse": 5,
              "name": "Levitico 25:5",
              "text": "Yaong tumubo sa sarili sa iyong inaanihan ay huwag mong aanihin, at ang mga ubas ng iyong ubasan na hindi nakapon ay huwag mong titipunin: magiging taong takdang kapahingahan sa lupain."
            },
            {
              "chapter": 25,
              "verse": 6,
              "name": "Levitico 25:6",
              "text": "At ang bunga sa sabbath ng lupain ay magiging pagkain sa inyo; sa iyo, at sa iyong aliping lalake at babae, at sa iyong aliping upahan, at sa taga ibang bayan na nakikipamayan sa iyo;"
            },
            {
              "chapter": 25,
              "verse": 7,
              "name": "Levitico 25:7",
              "text": "At sa iyong mga baka at sa mga hayop na nasa iyong lupain ay magiging pagkain ang lahat ng bunga ng mga iyan."
            },
            {
              "chapter": 25,
              "verse": 8,
              "name": "Levitico 25:8",
              "text": "At bibilang ka ng pitong sabbath ng taon, makapitong pitong taon; at magiging sa iyo'y mga araw ng pitong sabbath ng mga taon, sa makatuwid baga'y apat na pu't siyam na taon."
            },
            {
              "chapter": 25,
              "verse": 9,
              "name": "Levitico 25:9",
              "text": "Kung magkagayo'y maguutos ka na lumibot sa bayan ang pakakak na matunog sa ikasangpung araw ng ika pitong buwan; sa araw ng pagtubos patutunugin ninyo ang pakakak sa buong lupain ninyo."
            },
            {
              "chapter": 25,
              "verse": 10,
              "name": "Levitico 25:10",
              "text": "At ipangingilin ninyo ang ikalimang pung taon, at ihahayag ninyo sa buong lupain ang kalayaan sa lahat na tumatahan sa lupain: iya'y magiging kapistahan ng jubileo sa inyo; at bawa't isa sa inyo ay babalik sa kaniyang pag-aari, at bawa't isa'y babalik sa kaniyang sangbahayan."
            },
            {
              "chapter": 25,
              "verse": 11,
              "name": "Levitico 25:11",
              "text": "Magiging kapistahan ng jubileo nga sa inyo ang ikalimang pung taon: huwag ninyong hahasikan ni aanihin ang tumubo sa kaniyang sarili, ni titipunin ang mga ubas ng ubasan na hindi nakapon."
            },
            {
              "chapter": 25,
              "verse": 12,
              "name": "Levitico 25:12",
              "text": "Sapagka't kapistahan ng jubileo; magiging banal sa inyo: kakanin ninyo ang bunga niyan sa bukid."
            },
            {
              "chapter": 25,
              "verse": 13,
              "name": "Levitico 25:13",
              "text": "Sa taong ito ng jubileo, ay babalik kayo, bawa't isa sa kaniyang pag-aari."
            },
            {
              "chapter": 25,
              "verse": 14,
              "name": "Levitico 25:14",
              "text": "At kung ikaw ay magbili ng anoman sa iyong kapuwa o bumili ng anoman sa kamay ng iyong kapuwa, ay huwag kayong magdadayaan."
            },
            {
              "chapter": 25,
              "verse": 15,
              "name": "Levitico 25:15",
              "text": "Ayon sa bilang ng taon pagkatapos ng jubileo, ay bibilhin mo sa iyong kapuwa, ayon sa bilang ng taon ng pagaani, ay kaniyang ipagbibili sa iyo."
            },
            {
              "chapter": 25,
              "verse": 16,
              "name": "Levitico 25:16",
              "text": "Ayon sa dami ng mga taon, ay daragdagan mo ang halaga niyan, at ayon sa kakauntian ng mga taon, ay babawasan mo ang halaga niyan; sapagka't ganyang bilang ng ani ang kaniyang ipagbibili sa iyo."
            },
            {
              "chapter": 25,
              "verse": 17,
              "name": "Levitico 25:17",
              "text": "At huwag kayong magdadayaan; kundi matatakot kayo sa inyong Dios: sapagka't ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 25,
              "verse": 18,
              "name": "Levitico 25:18",
              "text": "Kaya't inyong tutuparin ang aking mga palatuntunan, at inyong iingatan ang aking mga kahatulan at inyong isasagawa at tatahan kayong tiwasay sa lupain."
            },
            {
              "chapter": 25,
              "verse": 19,
              "name": "Levitico 25:19",
              "text": "At ang lupain ay magbubunga, at kakain kayo hanggang sa mabusog at tatahan kayong tiwasay doon."
            },
            {
              "chapter": 25,
              "verse": 20,
              "name": "Levitico 25:20",
              "text": "At kung sasabihin ninyo, Anong aming kakanin sa ikapitong taon? narito, hindi kami maghahasik ni magtitipon ng aming mga bunga:"
            },
            {
              "chapter": 25,
              "verse": 21,
              "name": "Levitico 25:21",
              "text": "At aking igagawad ang aking pagpapala sa inyo sa ikaanim na taon, at magbubunga ng kasya sa tatlong taon."
            },
            {
              "chapter": 25,
              "verse": 22,
              "name": "Levitico 25:22",
              "text": "At maghahasik kayo sa ikawalong taon, at kakain kayo ng dating kinamalig na mga bunga hanggang sa ikasiyam na taon, hanggang sa dumating ang pagbubunga ng ikawalo ay kakain kayo ng dating kinamalig."
            },
            {
              "chapter": 25,
              "verse": 23,
              "name": "Levitico 25:23",
              "text": "At ang lupain ay hindi maipagbibili ng magpakailan man; sapagka't akin ang lupain: sapagka't kayo'y taga ibang bayan at makikipamayang kasama ko."
            },
            {
              "chapter": 25,
              "verse": 24,
              "name": "Levitico 25:24",
              "text": "At sa buong lupain na iyong pag-aari ay magkakaloob kayo ng pangtubos sa lupain."
            },
            {
              "chapter": 25,
              "verse": 25,
              "name": "Levitico 25:25",
              "text": "Kung ang iyong kapatid ay maghirap, at ipagbili ang anoman sa kaniyang pag-aari, ay paroroon ang kaniyang kamaganak na pinakamalapit sa kaniya, at tutubusin ang ipinagbili ng kaniyang kapatid."
            },
            {
              "chapter": 25,
              "verse": 26,
              "name": "Levitico 25:26",
              "text": "At kung ang taong yaon ay walang manunubos, at siya'y yumaman at nakasumpong ng kasapatan upang matubos yaon;"
            },
            {
              "chapter": 25,
              "verse": 27,
              "name": "Levitico 25:27",
              "text": "Ay kaniyang bilangin ang mga taon pagkatapos na kaniyang naipagbili, at isasauli ang labis sa taong kaniyang pinagbilhan; at babalik siya sa kaniyang pag-aari."
            },
            {
              "chapter": 25,
              "verse": 28,
              "name": "Levitico 25:28",
              "text": "Nguni't kung siya'y walang kasapatan, upang maibalik niya sa kaniya, ang ipinagbili ay matitira nga sa kapangyarihan ng bumili hanggang sa taon ng jubileo; at sa jubileo ay maaalis sa kapangyarihan niyaon, at ang may-ari ay babalik sa kaniyang pag-aari."
            },
            {
              "chapter": 25,
              "verse": 29,
              "name": "Levitico 25:29",
              "text": "At kung ang isang tao ay magbili ng bahay na tahanan sa nakukutaang bayan ay matutubos niya sa loob ng isang buong taon pagkatapos na maipagbili; sapagka't isang buong taon ang kaniyang matuwid ng pagtubos."
            },
            {
              "chapter": 25,
              "verse": 30,
              "name": "Levitico 25:30",
              "text": "At kung hindi matubos sa loob ng isang buong taon, ang bahay na nasa nakukutaang bayan ay lalagi magpakailan man, na pag-aari niyaong bumili, sa buong panahon ng kaniyang lahi: hindi maaalis sa kaniya sa jubileo."
            },
            {
              "chapter": 25,
              "verse": 31,
              "name": "Levitico 25:31",
              "text": "Nguni't ang mga bahay sa mga nayon na walang kuta sa palibot, ay aariing para ng sa mga bukirin sa lupain: kanilang matutubos; at sa jubileo ay magsisialis."
            },
            {
              "chapter": 25,
              "verse": 32,
              "name": "Levitico 25:32",
              "text": "Gayon ma'y sa mga bayan ng mga Levita, kailan ma'y maaaring matubos ng mga Levita ang mga bahay sa mga bayan ng kanilang pag-aari."
            },
            {
              "chapter": 25,
              "verse": 33,
              "name": "Levitico 25:33",
              "text": "At kung ang isa sa mga Levita ay tumubos, ang bahay na ipinagbili at ang bayang kaniyang pag-aari, ay maaalis sa jubileo, sapagka't ang mga bahay sa mga bayan ng mga Levita ay kanilang pag-aari sa gitna ng mga anak ni Israel."
            },
            {
              "chapter": 25,
              "verse": 34,
              "name": "Levitico 25:34",
              "text": "Datapuwa't ang mga bukid sa palibot ng mga bayan nila, ay hindi maipagbibili, sapagka't pag-aari nila magpakailan man."
            },
            {
              "chapter": 25,
              "verse": 35,
              "name": "Levitico 25:35",
              "text": "At kung maghirap ang iyong kapatid at manglupaypay sa iyong siping, ay iyo siyang aalalayan na patutuluyin mo, na manunuluyan sa iyong parang taga ibang bayan at nakikipamayan."
            },
            {
              "chapter": 25,
              "verse": 36,
              "name": "Levitico 25:36",
              "text": "Huwag kang kukuha sa kaniya ng patubo o pakinabang, kundi matakot ka sa iyong Dios: patuluyin mo ang iyong kapatid."
            },
            {
              "chapter": 25,
              "verse": 37,
              "name": "Levitico 25:37",
              "text": "Ang iyong salapi ay huwag mong ibibigay sa kaniya na may patubo, ni ibibigay mo sa kaniya na may pakinabang ang iyong pagkain."
            },
            {
              "chapter": 25,
              "verse": 38,
              "name": "Levitico 25:38",
              "text": "Ako ang Panginoon ninyong Dios, na inilabas ko kayo sa lupain ng Egipto, upang ibigay ko sa inyo ang lupain ng Canaan, at ako'y maging inyong Dios."
            },
            {
              "chapter": 25,
              "verse": 39,
              "name": "Levitico 25:39",
              "text": "At kung ang iyong kapatid na kasama mo ay maghirap at pabili siya sa iyo: ay huwag mo siyang papaglilingkuring parang alipin;"
            },
            {
              "chapter": 25,
              "verse": 40,
              "name": "Levitico 25:40",
              "text": "Ipalalagay mo siyang parang lingkod na upahan at parang nakikipamayan; hanggang sa taon ng jubileo ay maglilingkod siya sa iyo:"
            },
            {
              "chapter": 25,
              "verse": 41,
              "name": "Levitico 25:41",
              "text": "Kung magkagayo'y aalis siya sa iyo, siya at ang kaniyang mga anak na kasama niya, at babalik sa kaniyang sariling sangbahayan, at babalik sa pag-aari ng kaniyang mga magulang."
            },
            {
              "chapter": 25,
              "verse": 42,
              "name": "Levitico 25:42",
              "text": "Sapagka't sila'y aking mga lingkod, na aking inilabas sa lupain ng Egipto; sila'y hindi maipagbibiling parang mga alipin."
            },
            {
              "chapter": 25,
              "verse": 43,
              "name": "Levitico 25:43",
              "text": "Huwag kang papapanginoon sa kaniya na may kabagsikan; kundi ikaw ay matatakot sa iyong Dios."
            },
            {
              "chapter": 25,
              "verse": 44,
              "name": "Levitico 25:44",
              "text": "At tungkol sa iyong mga aliping lalake at babae na magkakaroon ka; sa mga bansang nasa palibot ninyo, ay makabibili kayo sa kanila ng mga aliping lalake at babae."
            },
            {
              "chapter": 25,
              "verse": 45,
              "name": "Levitico 25:45",
              "text": "Saka sa mga anak ng mga taga ibang lupa na nakikipamayan sa inyo, sa mga ito'y makabibili kayo, at sa kanilang mga sangbahayan na nasa inyo, na mga ipinanganak nila sa inyong lupain: at magiging inyong pag-aari."
            },
            {
              "chapter": 25,
              "verse": 46,
              "name": "Levitico 25:46",
              "text": "At inyong iiwang pinakapamana sa inyong mga anak pagkamatay ninyo, na pinakapag-aari; sa mga iyan kukuha kayo ng inyong mga alipin magpakailan man: nguni't sa inyong mga kapatid na mga anak ni Israel ay huwag kayong magpapanginoonan na may kabagsikan."
            },
            {
              "chapter": 25,
              "verse": 47,
              "name": "Levitico 25:47",
              "text": "At kung ang taga ibang lupa o ang nakikipamayan na kasama mo ay yumaman, at ang iyong kapatid ay maghirap sa siping niya, at pabili sa taga ibang bayan o nakikipamayan sa iyo o sa sinomang kasangbahay ng taga ibang lupa;"
            },
            {
              "chapter": 25,
              "verse": 48,
              "name": "Levitico 25:48",
              "text": "Pagkatapos na siya'y maipagbili ay kaniyang matutubos: isa sa kaniyang mga kapatid ay makatutubos sa kaniya:"
            },
            {
              "chapter": 25,
              "verse": 49,
              "name": "Levitico 25:49",
              "text": "O ang kaniyang amain o ang anak ng kaniyang amain ay makatutubos sa kaniya; o sinomang kamaganak na malapit niya sa kaniyang sangbahayan ay makatutubos sa kaniya; o kung yumaman siya ay makatutubos siya sa kaniyang sarili."
            },
            {
              "chapter": 25,
              "verse": 50,
              "name": "Levitico 25:50",
              "text": "At kaniyang bibilangan yaong bumili sa kaniya, mula sa taong bilhin siya hanggang sa taon ng jubileo: at ang halaga ng pagkabili sa kaniya ay magiging ayon sa bilang ng mga taon; at gagawin sa kaniya ay ayon sa panahon ng isang lingkod na upahan."
            },
            {
              "chapter": 25,
              "verse": 51,
              "name": "Levitico 25:51",
              "text": "Kung maraming taon pa ang kulang niya, ayon sa dami ng mga iyan, ay isasauli ang halaga ng kaniyang pagkatubos sa kaniya na salaping sa kaniya'y ibinili."
            },
            {
              "chapter": 25,
              "verse": 52,
              "name": "Levitico 25:52",
              "text": "At kung kaunti ang mga taong nagkukulang hanggang sa taon ng jubileo ay ibibilang sa kaniya; ayon sa kaniyang mga taon na nagkukulang ay isasauli ang halaga ng kaniyang katubusan."
            },
            {
              "chapter": 25,
              "verse": 53,
              "name": "Levitico 25:53",
              "text": "Kung paano ang alilang may bayad sa taon-taon, ay gayon matitira sa kaniya: siya'y huwag papapanginoon sa kaniya na may kabagsikan sa iyong paningin."
            },
            {
              "chapter": 25,
              "verse": 54,
              "name": "Levitico 25:54",
              "text": "At kung hindi siya tubusin sa mga paraang ito, ay aalis siya sa taon ng jubileo, siya at ang kaniyang mga anak na kasama niya."
            },
            {
              "chapter": 25,
              "verse": 55,
              "name": "Levitico 25:55",
              "text": "Sapagka't sa akin ang mga anak ni Israel ay mga lingkod; sila'y aking mga lingkod na aking inilabas sa lupain ng Egipto: ako ang Panginoon ninyong Dios."
            }
          ]
        },
        {
          "chapter": 26,
          "name": "Levitico 26",
          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Levitico 26:1",
              "text": "Huwag kayong gagawa para sa inyo ng mga diosdiosan, ni magtatayo kayo ng larawang inanyuan o haligi, ni huwag kayong maglalagay ng batong inanyuan sa inyong lupain, upang inyong yukuran yaon: sapagka't ako ang Panginoon ninyong Dios."
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Levitico 26:2",
              "text": "Inyong ipangingilin ang aking mga sabbath, at inyong igagalang ang aking santuario: ako ang Panginoon."
            },
            {
              "chapter": 26,
              "verse": 3,
              "name": "Levitico 26:3",
              "text": "Kung lalakad kayo ng ayon sa aking mga palatuntunan at iingatan ninyo ang aking mga utos, at inyong tutuparin:"
            },
            {
              "chapter": 26,
              "verse": 4,
              "name": "Levitico 26:4",
              "text": "Ay maglalagpak nga ako ng ulan sa kapanahunan, at ang lupain ay pakikinabangan, at ang mga kahoy sa parang ay magbubunga."
            },
            {
              "chapter": 26,
              "verse": 5,
              "name": "Levitico 26:5",
              "text": "At ang inyong paggiik ay aabot hanggang sa pagaani ng mga ubas, at ang pagaani ng ubas ay aabot sa paghahasik: at kakanin ninyo ang inyong pagkain na sagana, at tatahan kayong tiwasay sa inyong lupain."
            },
            {
              "chapter": 26,
              "verse": 6,
              "name": "Levitico 26:6",
              "text": "At magbibigay ako ng kapayapaan sa lupain, at mahihiga kayo, at walang katatakutan kayo: at aking papawiin sa lupain ang mababangis na hayop, ni hindi dadaanan ang inyong lupain sa tabak."
            },
            {
              "chapter": 26,
              "verse": 7,
              "name": "Levitico 26:7",
              "text": "At hahabulin ninyo ang inyong mga kaaway, at mangabubuwal sa harap ninyo sa tabak."
            },
            {
              "chapter": 26,
              "verse": 8,
              "name": "Levitico 26:8",
              "text": "At lima sa inyo'y hahabol sa isang daan, at isang daan sa inyo'y hahabol sa sangpung libo: at ang inyong mga kaaway ay mangabubuwal sa tabak sa harap ninyo."
            },
            {
              "chapter": 26,
              "verse": 9,
              "name": "Levitico 26:9",
              "text": "At lilingapin ko kayo, at palalaguin ko kayo, at pararamihin ko kayo; at papagtitibayin ko ang aking tipan sa inyo."
            },
            {
              "chapter": 26,
              "verse": 10,
              "name": "Levitico 26:10",
              "text": "At kakanin ninyo ang malaong kinamalig, at inyong ilalabas ang luma dahil sa bago."
            },
            {
              "chapter": 26,
              "verse": 11,
              "name": "Levitico 26:11",
              "text": "At ilalagay ko ang aking tabernakulo sa gitna ninyo: at hindi ko kayo kapopootan."
            },
            {
              "chapter": 26,
              "verse": 12,
              "name": "Levitico 26:12",
              "text": "At lalakad ako sa gitna ninyo at ako'y magiging inyong Dios, at kayo'y magiging aking bayan."
            },
            {
              "chapter": 26,
              "verse": 13,
              "name": "Levitico 26:13",
              "text": "Ako ang Panginoon ninyong Dios, na naglabas sa inyo sa lupain ng Egipto, upang huwag kayong maging mga alipin nila; at sinira ko ang mga kahoy ng inyong pamatok, at pinalakad ko kayo ng mga ulong matuwid."
            },
            {
              "chapter": 26,
              "verse": 14,
              "name": "Levitico 26:14",
              "text": "Nguni't kung hindi ninyo pakikinggan ako, at hindi ninyo tutuparin ang lahat ng mga utos na ito;"
            },
            {
              "chapter": 26,
              "verse": 15,
              "name": "Levitico 26:15",
              "text": "At kung inyong tatanggihan ang aking mga palatuntunan, at kasusuklaman nga ninyo ang aking mga hatol, na anopa't hindi ninyo tutuparin ang lahat ng aking mga utos, kundi inyong sisirain ang aking tipan;"
            },
            {
              "chapter": 26,
              "verse": 16,
              "name": "Levitico 26:16",
              "text": "Ay gagawin ko naman ito sa inyo; ilalagay ko sa gitna ninyo ang sindak, at pagkatuyo, at ang lagnat na uubos sa mga mata, at magpapalupaypay sa kaluluwa: at maghahasik kayo ng inyong binhi na walang kabuluhan, sapagka't kakanin ng inyong mga kaaway."
            },
            {
              "chapter": 26,
              "verse": 17,
              "name": "Levitico 26:17",
              "text": "At itititig ko ang aking mukha laban sa inyo, at kayo'y masasaktan sa harap ng inyong mga kaaway: kayo'y pagpupunuan ng mga napopoot sa inyo; at kayo'y tatakas nang walang humahabol sa inyo."
            },
            {
              "chapter": 26,
              "verse": 18,
              "name": "Levitico 26:18",
              "text": "At kung sa mga bagay na ito man ay hindi ninyo ako pakinggan, ay parurusahan ko kayong makapito pa, dahil sa inyong mga kasalanan."
            },
            {
              "chapter": 26,
              "verse": 19,
              "name": "Levitico 26:19",
              "text": "At sisirain ko ang kahambugan ng inyong kapangyarihan; at gagawin kong parang bakal ang inyong langit at parang tanso ang inyong lupa:"
            },
            {
              "chapter": 26,
              "verse": 20,
              "name": "Levitico 26:20",
              "text": "At gugugulin ninyo ang inyong kalakasan ng walang kabuluhan; sapagka't hindi ibibigay sa inyo ng inyong lupain ang kaniyang bunga ni ng kahoy sa parang ang kaniyang bunga."
            },
            {
              "chapter": 26,
              "verse": 21,
              "name": "Levitico 26:21",
              "text": "At kung kayo'y sasalangsang sa akin, at hindi ninyo ako didinggin; ay dadalhan ko kayo ng makapito ang higit ng salot ayon sa inyong mga kasalanan."
            },
            {
              "chapter": 26,
              "verse": 22,
              "name": "Levitico 26:22",
              "text": "At susuguin ko sa inyo ang mga halimaw sa parang, ng samsaman kayo ng inyong mga anak, at papatayin ang inyong mga hayop, at kayo'y pakakauntiin sa bilang; at mangungulila ang inyong mga lakad."
            },
            {
              "chapter": 26,
              "verse": 23,
              "name": "Levitico 26:23",
              "text": "At kung sa mga bagay mang ito ay hindi pa kayo magbago sa akin, kundi sasalangsang kayo sa akin:"
            },
            {
              "chapter": 26,
              "verse": 24,
              "name": "Levitico 26:24",
              "text": "At lalakad din naman ako ng laban sa inyo, at sasaktan ko kayo, ng makapito pa dahil sa inyong mga kasalanan:"
            },
            {
              "chapter": 26,
              "verse": 25,
              "name": "Levitico 26:25",
              "text": "At pararatingin ko sa inyo ang tabak na gaganap ng higanti ng tipan; at kayo'y matitipon sa loob ng inyong mga bayan: at pararatingin ko ang salot sa gitna ninyo; at kayo'y mabibigay sa kamay ng kaaway."
            },
            {
              "chapter": 26,
              "verse": 26,
              "name": "Levitico 26:26",
              "text": "Pagka masisira ko ang tungkod ninyong tinapay, ang sangpung babae ay magluluto ng inyong tinapay sa isa lamang hurno, at sa inyo'y isasauli sa timbang ang inyong tinapay: at kayo'y kakain at hindi kayo mangabubusog."
            },
            {
              "chapter": 26,
              "verse": 27,
              "name": "Levitico 26:27",
              "text": "At kung sa lahat ng ito ay hindi ninyo ako pakikinggan, kundi kayo'y sasalangsang sa akin;"
            },
            {
              "chapter": 26,
              "verse": 28,
              "name": "Levitico 26:28",
              "text": "Ay sasalangsang ako sa inyo na may kapusukan; at parurusahan ko kayong makapito pa dahil sa inyong mga kasalanan."
            },
            {
              "chapter": 26,
              "verse": 29,
              "name": "Levitico 26:29",
              "text": "At kakanin ninyo ang laman ng inyong mga anak na lalake, at ang mga laman ng inyong mga anak na babae ay inyong kakanin."
            },
            {
              "chapter": 26,
              "verse": 30,
              "name": "Levitico 26:30",
              "text": "At sisirain ko ang inyong matataas na dako, at aking wawasakin ang inyong mga larawang araw, at itatapon ko ang inyong mga bangkay sa mga katawan ng inyong mga diosdiosan; at kapopootan kayo ng aking kaluluwa."
            },
            {
              "chapter": 26,
              "verse": 31,
              "name": "Levitico 26:31",
              "text": "At gagawin kong giba ang inyong mga bayan, at gigibain ko ang inyong mga santuario, at hindi ko na sasamyuin ang amoy ng inyong mga may amoy na masarap."
            },
            {
              "chapter": 26,
              "verse": 32,
              "name": "Levitico 26:32",
              "text": "At gagawin kong ilang ang lupain: at pagtatakhan ng inyong mga kaaway na tumatahan doon."
            },
            {
              "chapter": 26,
              "verse": 33,
              "name": "Levitico 26:33",
              "text": "At kayo'y aking pangangalatin sa mga bansa, at pagbubunutan ko kayo ng tabak sa hulihan ninyo: at ang inyong lupain ay magiging isang ilang, at ang inyong mga bayan ay magiging sira."
            },
            {
              "chapter": 26,
              "verse": 34,
              "name": "Levitico 26:34",
              "text": "Kung magkagayo'y magagalak ang lupain sa kaniyang mga sabbath, habang nahahandusay na sira, at kayo'y mapapasa lupain ng inyong mga kaaway; ang lupain nga ay magpapahinga, at magagalak sa kaniyang mga sabbath."
            },
            {
              "chapter": 26,
              "verse": 35,
              "name": "Levitico 26:35",
              "text": "Habang nahahandusay na sira ay magkakaroon ng kapahingahan, sa makatuwid baga'y ang hindi ipinagpahinga sa inyong mga sabbath, nang kayo'y nagsisitahan doon."
            },
            {
              "chapter": 26,
              "verse": 36,
              "name": "Levitico 26:36",
              "text": "At tungkol sa mga matitira sa inyo, ay sisidlan ko ng takot sa kanilang puso, sa mga lupain ng kaniyang mga kaaway: at hahabulin sila ng kalatis ng isang dahong nalalaglag; at sila'y tatakas na parang tumatakas sa tabak; at sila'y mabubuwal nang walang humahabol sa kanila."
            },
            {
              "chapter": 26,
              "verse": 37,
              "name": "Levitico 26:37",
              "text": "At mangagkakatisuran sila na parang nasa harap ng tabak, kahit walang humahabol: at hindi kayo makatatayo sa harap ng inyong mga kaaway."
            },
            {
              "chapter": 26,
              "verse": 38,
              "name": "Levitico 26:38",
              "text": "At mamamatay kayo sa gitna ng mga bansa, at sasakmalin kayo ng lupain ng inyong mga kaaway."
            },
            {
              "chapter": 26,
              "verse": 39,
              "name": "Levitico 26:39",
              "text": "At ang mga matitira sa inyo ay magsisipanglupaypay sa kanilang kasamaan sa mga lupain ng inyong mga kaaway; at sa mga kasamaan naman ng kanilang mga magulang ay magsisipanglupaypay na kasama nila."
            },
            {
              "chapter": 26,
              "verse": 40,
              "name": "Levitico 26:40",
              "text": "At kanilang isasaysay ang kanilang kasamaan, at ang kasamaan ng kanilang mga magulang, sa ang kanilang pagsalangsang na isinalangsang laban sa akin, sapagka't sila'y lumakad naman ng laban sa akin."
            },
            {
              "chapter": 26,
              "verse": 41,
              "name": "Levitico 26:41",
              "text": "Ako naman ay lumakad ng laban sa kanila, at sila'y aking dinala sa lupain ng kanilang mga kaaway: kung magpapakababa nga ang kanilang mga pusong hindi tuli, at kanilang tatanggapin ang parusa sa kanilang kasamaan;"
            },
            {
              "chapter": 26,
              "verse": 42,
              "name": "Levitico 26:42",
              "text": "Ay aalalahanin ko nga ang aking tipan kay Jacob; at ang akin ding tipan kay Isaac, at gayon din ang aking tipan kay Abraham ay aking aalalahanin; at aking aalalahanin ang lupain."
            },
            {
              "chapter": 26,
              "verse": 43,
              "name": "Levitico 26:43",
              "text": "Ang lupain naman ay pababayaan nila, at magagalak sa kaniyang mga sabbath, samantalang nahahandusay na sira na wala sila; at kanilang tatanggapin ang kaparusahan ng kanilang kasamaan: sapagka't kanilang tinanggihan ang aking mga hatol, at kinapootan ng kanilang kaluluwa ang aking mga palatuntunan."
            },
            {
              "chapter": 26,
              "verse": 44,
              "name": "Levitico 26:44",
              "text": "At sa lahat mang ito, pagka sila'y nasa lupain ng kanilang mga kaaway ay hindi ko sila itatakuwil, ni kapopootan ko sila na sila'y aking lubos na lilipulin, at aking sisirain ang aking tipan sa kanila: sapagka't ako ang Panginoon nilang Dios:"
            },
            {
              "chapter": 26,
              "verse": 45,
              "name": "Levitico 26:45",
              "text": "Kundi aalalahanin ko alangalang sa kanila ang tipan ng kanilang mga magulang, na aking inilabas sa lupain ng Egipto, sa paningin ng mga bansa, upang ako'y maging kanilang Dios: ako ang Panginoon."
            },
            {
              "chapter": 26,
              "verse": 46,
              "name": "Levitico 26:46",
              "text": "Ito ang mga palatuntunan at ang mga hatol at ang mga kautusang ginawa ng Panginoon sa kaniyang sarili at sa mga anak ni Israel sa bundok ng Sinai sa pamamagitan ni Moises."
            }
          ]
        },
        {
          "chapter": 27,
          "name": "Levitico 27",
          "verses": [
            {
              "chapter": 27,
              "verse": 1,
              "name": "Levitico 27:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 27,
              "verse": 2,
              "name": "Levitico 27:2",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagka ang sinoman ay tutupad ng panata ayon sa iyong inihalaga, ay magiging sa Panginoon ang mga tao."
            },
            {
              "chapter": 27,
              "verse": 3,
              "name": "Levitico 27:3",
              "text": "At ang iyong inihalaga tungkol sa lalake, na mula sa may dalawang pung taong gulang hanggang sa may anim na pu, ay limang pung siklong pilak, ang iyong ihahalaga ayon sa siklo ng santuario."
            },
            {
              "chapter": 27,
              "verse": 4,
              "name": "Levitico 27:4",
              "text": "At kung tungkol sa babae tatlong pung siklo ang ihahalaga mo."
            },
            {
              "chapter": 27,
              "verse": 5,
              "name": "Levitico 27:5",
              "text": "At kung mula sa may limang taon hanggang sa may dalawang pung taon, ay dalawang pung siklo, ang ihahalaga mo sa lalake at sa babae ay sangpung siklo."
            },
            {
              "chapter": 27,
              "verse": 6,
              "name": "Levitico 27:6",
              "text": "At kung mula sa may isang buwan hanggang sa may limang taon ay limang siklong pilak ang iyong ihahalaga sa lalake at sa babae ay tatlong siklong pilak ang iyong ihahalaga."
            },
            {
              "chapter": 27,
              "verse": 7,
              "name": "Levitico 27:7",
              "text": "At kung sa may anim na pung taon na patanda; kung lalake, ay labing limang siklo ang iyong ihahalaga, at sa babae ay sangpung siklo."
            },
            {
              "chapter": 27,
              "verse": 8,
              "name": "Levitico 27:8",
              "text": "Nguni't kung kapos ng ikababayad sa iyong inihalaga, ay pahaharapin mo siya sa harap ng saserdote, at hahalagahan siya ng saserdote; ayon sa ikakakaya ng may panata, ay siyang ihahalaga sa kaniya ng saserdote."
            },
            {
              "chapter": 27,
              "verse": 9,
              "name": "Levitico 27:9",
              "text": "At kung hayop na ihahandog na alay sa Panginoon, lahat na ibibigay niyaon ng sinoman sa Panginoon ay magiging banal."
            },
            {
              "chapter": 27,
              "verse": 10,
              "name": "Levitico 27:10",
              "text": "Huwag niyang babaguhin o papalitan ang mabuti ng masama o ang masama ng mabuti: at kung sa anomang paraan ay palitan ang isang hayop ng iba, ay magiging kapuwa banal yaon at ang kapalit niyaon."
            },
            {
              "chapter": 27,
              "verse": 11,
              "name": "Levitico 27:11",
              "text": "At kung yao'y anomang hayop na karumaldumal na sa hindi maihahandog na alay sa Panginoon, ay ilalagay nga niya ang hayop sa harap ng saserdote:"
            },
            {
              "chapter": 27,
              "verse": 12,
              "name": "Levitico 27:12",
              "text": "At hahalagahan ng saserdote, maging mabuti o masama: ayon sa inihalaga ng saserdote ay magiging gayon."
            },
            {
              "chapter": 27,
              "verse": 13,
              "name": "Levitico 27:13",
              "text": "Datapuwa't kung tunay na kaniyang tutubusin, ay magdadagdag nga siya ng ikalimang bahagi niyaon sa inihalaga mo."
            },
            {
              "chapter": 27,
              "verse": 14,
              "name": "Levitico 27:14",
              "text": "At pagka ang sinoman ay magtatalaga ng kaniyang bahay upang maging banal sa Panginoon, ay hahalagahan nga ng saserdote, kung mabuti o masama: ayon sa ihahalaga ng saserdote ay magiging gayon."
            },
            {
              "chapter": 27,
              "verse": 15,
              "name": "Levitico 27:15",
              "text": "At kung tutubusin ng nagtalaga ang kaniyang bahay, ay magdadagdag nga ng ikalimang bahagi ng salapi na inihalaga mo roon, at magiging kaniya."
            },
            {
              "chapter": 27,
              "verse": 16,
              "name": "Levitico 27:16",
              "text": "At kung ang sinoman ay magtatalaga sa Panginoon ng bahagi ng bukid na kaniyang pag-aari, ay ayon sa hasik doon ang iyong ihahalaga nga: ang hasik na isang omer na cebada ay hahalagahan ng limang pung siklong pilak."
            },
            {
              "chapter": 27,
              "verse": 17,
              "name": "Levitico 27:17",
              "text": "Kung itatalaga niya ang kaniyang bukid mula sa taon ng jubileo, ay magiging ayon sa iyong inihalaga."
            },
            {
              "chapter": 27,
              "verse": 18,
              "name": "Levitico 27:18",
              "text": "Datapuwa't kung italaga niya ang kaniyang bukid pagkatapos ng jubileo, ay bibilangan sa kaniya ng saserdote ng salapi ayon sa mga taong natitira hanggang sa taon ng jubileo at bababaan ang iyong inihalaga."
            },
            {
              "chapter": 27,
              "verse": 19,
              "name": "Levitico 27:19",
              "text": "At kung tutubusin ng nagtalaga ng bukid ay magdadagdag ng ikalimang bahagi ng salaping iyong inihalaga roon, at mapapasa kaniya."
            },
            {
              "chapter": 27,
              "verse": 20,
              "name": "Levitico 27:20",
              "text": "At kung hindi niya tutubusin ang bukid, o kung ipinagbili niya ang bukid sa ibang tao ay hindi na niya matutubos:"
            },
            {
              "chapter": 27,
              "verse": 21,
              "name": "Levitico 27:21",
              "text": "Kundi ang bukid pagka naalis sa jubileo, ay magiging banal sa Panginoon, na parang bukid na itinalaga: ang kapangyarihan doon ay mapapasa saserdote."
            },
            {
              "chapter": 27,
              "verse": 22,
              "name": "Levitico 27:22",
              "text": "At kung ang sinoman ay magtalaga sa Panginoon ng bukid na binili, na hindi sa bukid na kaniyang pag-aari;"
            },
            {
              "chapter": 27,
              "verse": 23,
              "name": "Levitico 27:23",
              "text": "Ay ibibilang nga sa kaniya ng saserdote ang halaga ng iyong inihalaga hanggang sa taon ng jubileo, at babayaran niya ang iyong inihalaga ng araw ding iyon, na parang banal na bagay sa Panginoon."
            },
            {
              "chapter": 27,
              "verse": 24,
              "name": "Levitico 27:24",
              "text": "Sa taon ng jubileo ay mababalik ang bukid doon sa kaniyang binilhan, doon sa kinararapatan ng pag-aari ng lupa."
            },
            {
              "chapter": 27,
              "verse": 25,
              "name": "Levitico 27:25",
              "text": "At ang buo mong ihahalaga ay magiging ayon sa siklo ng santuario: dalawang pung gera ang isang siklo."
            },
            {
              "chapter": 27,
              "verse": 26,
              "name": "Levitico 27:26",
              "text": "Ang panganay lamang sa mga hayop na iniukol ang pagkapanganay sa Panginoon, ang hindi maitatalaga ninoman; maging baka o tupa, ay ukol sa Panginoon."
            },
            {
              "chapter": 27,
              "verse": 27,
              "name": "Levitico 27:27",
              "text": "At kung hayop na karumaldumal, ay kaniyang tutubusin nga yaon sa iyong inihalaga at idadagdag pa niya ang ikalimang bahagi niyaon; o kung hindi tutubusin ay ipagbibili ayon sa iyong inihalaga."
            },
            {
              "chapter": 27,
              "verse": 28,
              "name": "Levitico 27:28",
              "text": "Gayon ma'y walang bagay na itinalaga, na itatalaga ninoman sa Panginoon, sa lahat ng sariling kaniya, maging sa tao o sa hayop, o sa bukid na kaniyang pag-aari, ay maipagbibili o matutubos: bawa't bagay na itinalaga ay kabanalbanalan sa Panginoon."
            },
            {
              "chapter": 27,
              "verse": 29,
              "name": "Levitico 27:29",
              "text": "Walang itinalaga na itatalaga ng mga tao, ay matutubos: papataying walang pagsala."
            },
            {
              "chapter": 27,
              "verse": 30,
              "name": "Levitico 27:30",
              "text": "At lahat na ikasangpung bahagi ng lupain, maging sa binhi ng lupain, o sa bunga ng punong kahoy ay sa Panginoon: magiging banal sa Panginoon."
            },
            {
              "chapter": 27,
              "verse": 31,
              "name": "Levitico 27:31",
              "text": "At kung ang sinoman ay tutubos ng alin mang bahagi ng kaniyang ikasangpung bahagi ay idagdag niya roon ang ikalimang bahagi niyaon."
            },
            {
              "chapter": 27,
              "verse": 32,
              "name": "Levitico 27:32",
              "text": "At lahat ng ikasangpung bahagi sa bakahan o sa kawan, anomang madaan sa tungkod, ay magiging banal sa Panginoon ang ikasangpung bahagi."
