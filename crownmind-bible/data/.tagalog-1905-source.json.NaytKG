        {
          "chapter": 14,
          "name": "Mga Hukom 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Mga Hukom 14:1",
              "text": "At lumusong si Samson sa Timnah, at nakita ang isang babae sa Timnah sa mga anak ng mga Filisteo."
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Mga Hukom 14:2",
              "text": "At siya'y umahon, at isinaysay sa kaniyang ama at sa kaniyang ina, at sinabi, Aking nakita ang isang babae sa Timnah, sa mga anak ng mga Filisteo: ngayon nga'y papagasawahin ninyo ako sa kaniya."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Mga Hukom 14:3",
              "text": "Nang magkagayo'y sinabi ng kaniyang ama at ng kaniyang ina sa kaniya, Wala na bang babae sa mga anak ng iyong kapatid, o sa aking buong bayan, na ikaw ay yayaong magaasawa sa mga di tuling Filisteo? At sinabi ni Samson sa kaniyang ama, Papag-asawahin mo ako sa kaniya; sapagka't siya'y lubhang nakalulugod sa akin."
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Mga Hukom 14:4",
              "text": "Nguni't hindi naalaman ng kaniyang ama at ng kaniyang ina, na kalooban ng Panginoon; sapagka't siya'y humahanap ng pagkakataon laban sa mga Filisteo. Nang panahong yaon nga'y nagpupuno ang mga Filisteo sa Israel."
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Mga Hukom 14:5",
              "text": "Nang magkagayo'y lumusong si Samson, at ang kaniyang ama, at ang kaniyang ina, sa Timnah, at naparoon sa ubasan ng Timnah: at, narito, isang batang leon ay umuungal laban sa kaniya,"
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Mga Hukom 14:6",
              "text": "At ang Espiritu ng Panginoon ay makapangyarihang sumakaniya, at nilamuray niya siya na parang naglamuray ng isang batang kambing, at siya'y walang anoman sa kaniyang kamay; nguni't hindi niya sinaysay sa kaniyang ama o sa kaniyang ina kung ano ang kaniyang ginawa."
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Mga Hukom 14:7",
              "text": "At siya'y lumusong at nakipagusap sa babae, at siya'y lubhang nakalulugod kay Samson."
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "Mga Hukom 14:8",
              "text": "At pagkaraan ng sandali ay bumalik siya upang kunin niya siya, at siya'y lumiko upang tingnan ang patay na leon: at, narito, may isang kawan ng pukyutan sa loob ng bangkay ng leon, at pulot-pukyutan."
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "Mga Hukom 14:9",
              "text": "At kaniyang dinala sa kaniyang kamay at yumaon, na kinakain niya samantalang siya'y yumayaon, at siya'y naparoon sa kaniyang ama at ina, at ibinigay sa kanila, at kanilang kinain; nguni't hindi niya sinaysay sa kanila na kaniyang kinuha ang pulot sa bangkay ng leon."
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "Mga Hukom 14:10",
              "text": "At nilusong ng kaniyang ama ang babae: at gumawa si Samson ng isang kasayahan doon; sapagka't kinaugaliang ginagawang gayon ng mga binata."
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "Mga Hukom 14:11",
              "text": "At nangyari, pagkakita nila sa kaniya, na sila'y nagdala ng tatlong pung kasama, upang maging kasama niya."
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "Mga Hukom 14:12",
              "text": "At sinabi ni Samson sa kanila, Pagbubugtungan ko kayo: kung maisaysay ninyo sa akin sa loob ng pitong araw na kasayahan, at inyong maturingan, ay bibigyan ko nga kayo ng tatlong pung kasuutang lino at tatlong pung bihisan:"
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "Mga Hukom 14:13",
              "text": "Nguni't kung hindi ninyo maisaysay sa akin, ay bibigyan nga ninyo ako ng tatlong pung kasuutang lino at ng tatlong pung bihisan. At kanilang sinabi sa kaniya, Ipagbadya mo ang iyong bugtong, upang aming marinig."
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "Mga Hukom 14:14",
              "text": "At sinabi niya sa kanila, Sa mangangain ay lumabas ang pagkain, At sa malakas ay lumabas ang katamisan. At hindi nila maisaysay sa tatlong araw."
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "Mga Hukom 14:15",
              "text": "At nangyari, nang ikapitong araw, na kanilang sinabi sa asawa ni Samson, Dayain mo ang iyong asawa, upang maisaysay niya sa amin ang bugtong, baka ikaw ay sunugin namin at ang sangbahayan ng iyong ama: inanyayahan ba ninyo kami upang papaghirapin? di ba gayon?"
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "Mga Hukom 14:16",
              "text": "At umiyak ang asawa ni Samson sa harap niya, at nagsabi, Kinapopootan mo lamang ako, at hindi mo ako iniibig: ikaw ay nagbugtong ng isang bugtong sa mga anak ng aking bayan, at hindi mo isinaysay sa akin. At sinabi niya sa kaniya, Narito, hindi ko isinaysay sa aking ama, o sa aking ina man, at akin bang sasaysayin sa iyo?"
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "Mga Hukom 14:17",
              "text": "At umiyak siya sa harap niya na pitong araw, habang hindi natapos ang kanilang kasayahan: at nangyari nang ikapitong araw, na isinaysay niya sa kaniya, sapagka't pinilit niya siya: at isinaysay niya ang bugtong sa mga anak ng kaniyang bayan."
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "Mga Hukom 14:18",
              "text": "At sinabi ng mga lalake sa bayan kay Samson nang ikapitong araw bago lumubog ang araw. Alin kaya ang lalong matamis kay sa pulot? at ano pa kaya ang lalong malakas kay sa leon? At sinabi niya sa kanila. Kung hindi kayo nag-araro ng aking dumalaga, Hindi sana ninyo naturingan ang aking bugtong."
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "Mga Hukom 14:19",
              "text": "At ang Espiritu ng Panginoon ay makapangyarihang sumakaniya, at siya'y lumusong sa Ascalon, at pumatay ng tatlong pung lalake sa kanila, at kinuha ang samsam sa kanila, at ibinigay ang mga bihisan sa mga nakaturing ng bugtong at ang kaniyang galit ay nagalab, at siya'y umahon sa bahay ng kaniyang ama."
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "Mga Hukom 14:20",
              "text": "Nguni't ang asawa ni Samson ay ibinigay sa kaniyang kasama, na siya niyang inaaring parang kaniyang kaibigan."
            }
          ]
