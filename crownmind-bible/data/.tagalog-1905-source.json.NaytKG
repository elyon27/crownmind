            {
              "chapter": 6,
              "verse": 8,
              "name": "2 Samuel 6:8",
              "text": "At hindi minagaling ni David, sapagka't nagalit ang Panginoon kay Uzza: at kaniyang tinawag ang dakong yaon na Perez-uzza hanggang sa araw na ito."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "2 Samuel 6:9",
              "text": "At natakot si David sa Panginoon sa araw na yaon; at kaniyang sinabi, Paanong madadala rito ang kaban ng Panginoon sa akin?"
