            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "2 Mga Hari 9:9",
              "text": "At aking gagawin ang sangbahayan ni Achab na gaya ng sangbahayan ni Jeroboam na anak ni Nabat, at gaya ng sangbahayan ni Baasa na anak ni Ahia."
