            },
            {
              "chapter": 15,
              "verse": 17,
              "name": "Mga Hukom 15:17",
              "text": "At nangyari, pagkatapos niyang makapagsalita, na kaniyang inihagis ang panga na nasa kaniyang kamay, at ang dakong yao'y tinawag na Ramath-lehi."
