            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "Mga Hukom 15:8",
              "text": "At sinaktan niya sila, sa hita at sasapnan ng di kawasang pagpatay: at siya'y bumaba at tumahan sa isang guwang ng bato ng Etam."
