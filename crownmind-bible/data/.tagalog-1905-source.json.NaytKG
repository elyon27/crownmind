            {
              "chapter": 31,
              "verse": 43,
              "name": "Genesis 31:43",
              "text": "At sumagot si Laban at sinabi kay Jacob, Ang mga anak na babaing ito, ay aking mga anak at itong mga anak ay mga anak ko, at ang mga kawan ay mga kawan ko, at ang lahat ng iyong nakikita ay akin: at anong magagawa ko ngayon sa mga anak kong babae, o sa kanilang mga anak na ipinanganak nila?"
            },
            {
              "chapter": 31,
              "verse": 44,
              "name": "Genesis 31:44",
              "text": "At ngayo'y halika, gumawa tayo ng isang tipan, ako't ikaw na maging patotoo sa akin at sa iyo."
            },
            {
              "chapter": 31,
              "verse": 45,
              "name": "Genesis 31:45",
              "text": "At kumuha si Jacob ng isang bato, at itinindig na pinakaalaala."
