            {
              "chapter": 14,
              "verse": 20,
              "name": "2 Samuel 14:20",
              "text": "Upang baguhin ang anyo ng bagay ay ginawa ng iyong lingkod na si Joab ang bagay na ito: at ang aking panginoon ay pantas ayon sa karunungan ng anghel ng Dios, na makaalam ng lahat ng mga bagay na nasa lupa."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "2 Samuel 14:21",
