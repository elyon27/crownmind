            {
              "chapter": 25,
              "verse": 21,
              "name": "2 Mga Cronica 25:21",
              "text": "Sa gayo'y umahon si Joas na hari sa Israel; at siya at si Amasias na hari sa Juda ay nagtitigan sa Beth-semes, na ukol sa Juda."
            },
            {
              "chapter": 25,
              "verse": 22,
              "name": "2 Mga Cronica 25:22",
              "text": "At ang Juda ay nalagay sa kasamasamaan sa harap ng Israel; at sila'y nagsitakas bawa't isa sa kanikaniyang tolda."
