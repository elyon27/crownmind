            {
              "chapter": 2,
              "verse": 17,
              "name": "Jeremias 2:17",
              "text": "Hindi mo baga pinapangyari ito sa iyong sarili, dahil sa iyong pagpapabaya sa Panginoon mong Dios, nang kaniyang patnubayan ka sa daan?"
