            {
              "chapter": 44,
              "verse": 32,
              "name": "Genesis 44:32",
              "text": "Sapagka't ang iyong lingkod ang siyang nanagot sa bata sa aking ama, na nagsasabi: Kung hindi ko siya dalhin sa iyo, ay papasanin ko nga ang kasalanan sa aking ama magpakailan man."
            },
            {
              "chapter": 44,
              "verse": 33,
              "name": "Genesis 44:33",
              "text": "Ngayon nga, ay ipahintulot mo na ang iyong lingkod, aking isinasamo sa iyo, ay maiwan na kahalili ng bata na pinakaalipin ng aking panginoon; at iyong ipahintulot na ang bata ay umahong kasama ng kaniyang mga kapatid."
            },
            {
              "chapter": 44,
              "verse": 34,
              "name": "Genesis 44:34",
              "text": "Sapagka't paanong paroroon ako sa aking ama, at ang bata'y di ko kasama? Baka aking makita pa ang sakunang sasapit sa aking ama."
            }
