            },
            {
              "chapter": 51,
              "verse": 11,
              "name": "Isaias 51:11",
              "text": "At ang mga tinubos ng Panginoon ay magsisibalik, at magsisiparoong may awitan sa Sion; at walang hanggang kagalakan ay sasa kanilang mga ulo: sila'y mangagtatamo ng kasayahan at kagalakan; at ang kapanglawan at pagbubungtong-hininga ay tatakas."
            },
            {
              "chapter": 51,
              "verse": 12,
              "name": "Isaias 51:12",
