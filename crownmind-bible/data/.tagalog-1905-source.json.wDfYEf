            {
              "chapter": 1,
              "verse": 1,
              "name": "Jeremias 1:1",
              "text": "Ang mga salita ni Jeremias na anak ni Hilcias, isa sa mga saserdote na nasa Anathoth sa lupain ng Benjamin:"
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Jeremias 1:2",
              "text": "Na dinatnan ng salita ng Panginoon nang mga kaarawan ni Josias na anak ni Amon, na hari sa Juda, nang ikalabing tatlong taon ng kaniyang paghahari."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Jeremias 1:3",
              "text": "Dumating din nang kaarawan ni Joacim na anak ni Josias, hari sa Juda, nang katapusan nang ikalabing isang taon ni Sedechias, na anak ni Josias, hari sa Juda, hanggang sa pagkabihag ng Jerusalem nang ikalimang buwan."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Jeremias 1:4",
              "text": "Ang salita nga ng Panginoon ay dumating sa akin, na nagsasabi,"
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Jeremias 1:5",
              "text": "Bago kita inanyuan sa tiyan ay nakilala kita, at bago ka lumabas sa bahay-bata ay pinapaging banal kita; inihalal kitang propeta sa mga bansa."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Jeremias 1:6",
              "text": "Nang magkagayo'y sinabi ko, Ah, Panginoong Dios! narito, hindi ako marunong magsalita: sapagka't ako'y bata."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Jeremias 1:7",
              "text": "Nguni't sinabi sa akin ng Panginoon, Huwag mong sabihin, Ako'y bata: sapagka't saan man kita susuguin ay paroroon ka, at anomang iutos ko sa iyo ay sasalitain mo."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Jeremias 1:8",
              "text": "Huwag kang matakot dahil sa kanila; sapagka't ako'y sumasaiyo upang iligtas kita, sabi ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Jeremias 1:9",
              "text": "Nang magkagayo'y iniunat ng Panginoon ang kaniyang kamay, at hinipo ang aking bibig; at sinabi sa akin ng Panginoon, Narito, inilagay ko ang aking mga salita sa iyong bibig:"
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Jeremias 1:10",
              "text": "Tingnan mo, aking pinapagpupuno ka sa araw na ito sa mga bansa at sa mga kaharian, upang magalis at magbagsak at upang magsira at magwasak, upang magtayo at magtatag."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Jeremias 1:11",
              "text": "Bukod dito ay dumating sa akin ang salita ng Panginoon, na nagsasabi, Jeremias, anong nakikita mo? At aking sinabi, Ako'y nakakakita ng isang tungkod na almendro."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Jeremias 1:12",
              "text": "Nang magkagayo'y sinabi ng Panginoon sa akin, Iyong nakitang mabuti: sapagka't aking iniingatan ang aking salita upang isagawa."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Jeremias 1:13",
              "text": "At ang salita ng Panginoon ay dumating sa akin na ikalawa, na nagsasabi, Ano ang iyong nakikita? At aking sinabi, Ako'y nakakakita ng isang palyok na pinagpapakuluan; at paharap sa hilagaan."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Jeremias 1:14",
              "text": "Nang magkagayo'y sinabi ng Panginoon sa akin, Mula sa hilagaan ay lalabasin ng kasamaan ang lahat na nananahan sa lupain."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Jeremias 1:15",
              "text": "Sapagka't, narito, aking tatawagin ang lahat na angkan ng mga kaharian sa hilagaan, sabi ng Panginoon; at sila'y magsisiparoon, at sila'y maglalagay bawa't isa ng kanikaniyang luklukan sa pasukan ng mga pintuang-bayan ng Jerusalem, at laban sa lahat na kuta niyaon sa palibot, at laban sa lahat na bayan ng Juda."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Jeremias 1:16",
              "text": "At aking sasalitain ang aking mga kahatulan laban sa kanila tungkol sa lahat nilang kasamaan, sa kanilang nangagpabaya sa akin, at nangagsunog ng kamangyan sa ibang mga dios, at nagsisamba sa mga gawa ng kanilang sariling mga kamay."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Jeremias 1:17",
              "text": "Ikaw nga'y magbigkis ng iyong mga balakang, at ikaw ay bumangon, at salitain mo sa kanila ang lahat na iniuutos ko sa iyo: huwag kang manglupaypay sa kanila, baka ikaw ay panglupaypayin ko sa harap nila."
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Jeremias 1:18",
              "text": "Sapagka't, narito, ginawa kita sa araw na ito, na nakukutaang bayan, at pinakahaliging bakal, at pinaka kutang tanso, laban sa buong lupain, laban sa mga hari sa Juda, laban sa mga prinsipe niyaon, laban sa mga saserdote niyaon, at laban sa bayan ng lupain."
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "Jeremias 1:19",
              "text": "At sila'y magsisilaban sa iyo; nguni't hindi sila mangananaig laban sa iyo: sapagka't ako'y sumasa iyo, sabi ng Panginoon, upang iligtas ka."
            }
