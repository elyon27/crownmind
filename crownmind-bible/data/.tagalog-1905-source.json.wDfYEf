            },
            {
              "chapter": 44,
              "verse": 15,
              "name": "Jeremias 44:15",
              "text": "Nang magkagayo'y lahat ng lalake na nakaalam na ang kanilang mga asawa ay nangagsunog ng kamangyan sa ibang mga dios, at ang lahat na babae na nangakatayo, isang malaking kapulungan, sa makatuwid baga'y ang buong bayan na tumahan sa lupain ng Egipto, sa Pathros, ay sumagot kay Jeremias, na nagsasabi,"
            },
            {
              "chapter": 44,
              "verse": 16,
              "name": "Jeremias 44:16",
