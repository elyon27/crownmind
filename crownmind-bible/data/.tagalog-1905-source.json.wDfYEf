            {
              "chapter": 44,
              "verse": 11,
              "name": "Genesis 44:11",
              "text": "Nang magkagayo'y nagmadali sila, at ibinaba ng bawa't isa ang kaniyang bayong sa lupa, at binuksan ng bawa't isa ang kaniyang bayong."
