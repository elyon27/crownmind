          ]
        },
        {
          "chapter": 28,
          "name": "Genesis 28",
          "verses": [
            {
              "chapter": 28,
              "verse": 1,
              "name": "Genesis 28:1",
              "text": "At tinawag ni Isaac si Jacob, at siya'y binasbasan, at siya'y pinagbilinan, na sinabi sa kaniya, Huwag kang magaasawa sa mga anak ng Canaan."
            },
            {
              "chapter": 28,
              "verse": 2,
              "name": "Genesis 28:2",
              "text": "Tumindig ka, pumaroon ka sa Padan-aram, sa bahay ni Bethuel, na ama ng iyong ina, at magasawa ka roon sa mga anak ni Laban, na kapatid na lalake ng iyong ina."
            },
            {
              "chapter": 28,
              "verse": 3,
              "name": "Genesis 28:3",
              "text": "At ikaw ay pagpalain nawa ng Dios na Makapangyarihan sa lahat, at ikaw ay palaguin, at ikaw ay paramihin, upang ikaw ay maging kapisanan ng mga bayan;"
