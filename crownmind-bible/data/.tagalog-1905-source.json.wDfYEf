            {
              "chapter": 26,
              "verse": 14,
              "name": "Genesis 26:14",
              "text": "At siya'y may tinatangkilik na mga kawan, at mga tinatangkilik na mga bakahan, at malaking sangbahayan: at kinainggitan siya ng mga Filisteo."
