            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Nehemias 9:6",
              "text": "Ikaw ang Panginoon, ikaw lamang; ikaw ang lumikha ng langit, ng langit ng mga langit, pati ng lahat na natatanaw roon, ng lupa at ng lahat na bagay na nangaroon, ng mga dagat at ng lahat na nangaroon, at iyong pinamalaging lahat; at ang hukbo ng langit ay sumasamba sa iyo."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Nehemias 9:7",
