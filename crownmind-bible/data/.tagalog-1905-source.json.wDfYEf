          ]
        },
        {
          "chapter": 49,
          "name": "Isaias 49",
          "verses": [
            {
              "chapter": 49,
              "verse": 1,
              "name": "Isaias 49:1",
              "text": "Kayo'y magsipakinig sa akin, Oh mga pulo; at inyong pakinggan, ninyong mga bayan, sa malayo: tinawag ako ng Panginoon mula sa bahay-bata; mula sa bahay-bata ng aking ina ay binanggit niya ang aking pangalan:"
            },
            {
              "chapter": 49,
              "verse": 2,
              "name": "Isaias 49:2",
              "text": "At kaniyang ginawa ang aking bibig na parang matalas na tabak; sa lilim ng kaniyang kamay ay ikinubli niya ako: at ginawa niya akong makinang na pana; sa kaniyang lalagyan ng pana ay itinago niya ako:"
            },
            {
              "chapter": 49,
              "verse": 3,
              "name": "Isaias 49:3",
              "text": "At sinabi niya sa akin, Ikaw ay aking lingkod; Israel, na siyang aking ikaluluwalhati."
            },
            {
              "chapter": 49,
              "verse": 4,
              "name": "Isaias 49:4",
              "text": "Nguni't aking sinabi, Ako'y gumawang walang kabuluhan, aking ginugol ang aking lakas sa wala, at sa walang kabuluhan; gayon ma'y tunay na ang kahatulan sa akin ay nasa Panginoon, at ang kagantihan sa akin ay nasa aking Dios."
            },
            {
              "chapter": 49,
              "verse": 5,
              "name": "Isaias 49:5",
              "text": "At ngayo'y sinasabi ng Panginoon na naganyo sa akin mula sa bahay-bata upang maging kaniyang lingkod, upang dalhin uli ang Jacob sa kaniya, at ang Israel ay mapisan sa kaniya: (sapagka't ako'y marangal sa mga mata ng Panginoon, at ang aking Dios ay naging aking kalakasan;)"
            },
            {
              "chapter": 49,
              "verse": 6,
              "name": "Isaias 49:6",
              "text": "Oo, kaniyang sinasabi, Totoong magaan ang bagay na ikaw ay naging aking lingkod upang ibangon ang mga lipi ng Jacob, at isauli ang iningatan ng Israel, ikaw ay aking ibibigay na pinakailaw sa mga Gentil upang ikaw ay maging aking kaligtasan hanggang sa wakas ng lupa."
            },
            {
              "chapter": 49,
              "verse": 7,
              "name": "Isaias 49:7",
              "text": "Ganito ang sabi ng Panginoon, ng Manunubos ng Israel, na kaniyang Banal, doon sa hinahamak ng tao, doon sa kinayayamutan ng bansa, sa lingkod ng mga pinuno, Ang mga hari at ang mga pangulo, ay mangakakakita at magsisibangon, at sila'y magsisisamba; dahil sa Panginoon na tapat, sa Banal ng Israel, na siyang pumili sa iyo."
            },
            {
              "chapter": 49,
              "verse": 8,
              "name": "Isaias 49:8",
              "text": "Ganito ang sabi ng Panginoon, Sa kalugodlugod na panahon ay sinagot kita, at sa araw ng pagliligtas ay tinulungan kita: at aking iningatan ka, at ibibigay kita na pinakatipan sa bayan, upang ibangon ang lupain, upang ipamana sa kanila ang mga sirang mana;"
            },
            {
              "chapter": 49,
              "verse": 9,
              "name": "Isaias 49:9",
              "text": "Na nagsasabi sa kanilang nangabibilanggo, Kayo'y magsilabas; sa kanilang nangasa kadiliman, Pakita kayo. Sila'y magsisikain sa mga daan, at ang lahat na luwal na kaitaasan ay magiging kanilang pastulan."
            },
            {
              "chapter": 49,
              "verse": 10,
              "name": "Isaias 49:10",
              "text": "Sila'y hindi mangagugutom, o mangauuhaw man; at hindi man sila mangapapaso ng init, o ng araw man: sapagka't siyang may awa sa kanila ay papatnubay sa kanila, sa makatuwid baga'y sa tabi ng mga bukal ng tubig ay papatnubayan niya sila."
            },
            {
              "chapter": 49,
              "verse": 11,
              "name": "Isaias 49:11",
              "text": "At aking gagawing daan ang lahat ng aking mga bundok, at ang aking mga lansangan ay patataasin."
            },
            {
              "chapter": 49,
              "verse": 12,
              "name": "Isaias 49:12",
              "text": "Narito, ang mga ito'y manggagaling sa malayo; at, narito, ang mga ito ay mula sa hilagaan, at mula sa kalunuran; at ang mga ito ay mula sa lupain ng Sinim."
            },
            {
              "chapter": 49,
              "verse": 13,
              "name": "Isaias 49:13",
              "text": "Ikaw ay umawit, Oh langit; at magalak, Oh lupa; at kayo'y biglang magsiawit, Oh mga bundok: sapagka't inaliw ng Panginoon ang kaniyang bayan, at mahahabag sa kaniyang nagdadalamhati."
            },
            {
              "chapter": 49,
              "verse": 14,
              "name": "Isaias 49:14",
              "text": "Nguni't sinabi ng Sion, Pinabayaan ako ni Jehova, at nilimot ako ng Panginoon."
            },
            {
              "chapter": 49,
              "verse": 15,
              "name": "Isaias 49:15",
              "text": "Malilimutan ba ng babae ang kaniyang batang pasusuhin; na siya'y hindi mahahabag sa anak ng kaniyang bahay-bata? oo, ito'y makalilimot, nguni't hindi kita kalilimutan."
            },
            {
              "chapter": 49,
              "verse": 16,
              "name": "Isaias 49:16",
              "text": "Narito aking inanyuan ka sa mga palad ng aking mga kamay; ang iyong mga kuta ay laging nangasa harap ko."
            },
            {
              "chapter": 49,
              "verse": 17,
              "name": "Isaias 49:17",
              "text": "Ang iyong mga anak ay mangagmamadali; ang mga manghahamak sa iyo at ang sumisira sa iyo ay aalis sa iyo."
            },
            {
              "chapter": 49,
              "verse": 18,
              "name": "Isaias 49:18",
              "text": "Imulat mo ang iyong mga mata sa palibot, at tingnan mo: lahat ng mga ito ay nagpipipisan, at naparirito sa iyo. Buhay ako, sabi ng Panginoon, ikaw ay mabibihisan ng lahat ng mga yaon, na parang pinakagayak, at mabibigkisan ka ng mga yaon na parang isang kasintahang babae."
            },
            {
              "chapter": 49,
              "verse": 19,
              "name": "Isaias 49:19",
              "text": "Sapagka't tungkol sa iyong mga sira at sa iyong mga gibang dako at sa iyong lupain na nawasak, tunay na ikaw ngayon ay magiging totoong napakakipot sa mga mananahan, at silang nagsisisakmal sa iyo ay mangalalayo."
            },
            {
              "chapter": 49,
              "verse": 20,
              "name": "Isaias 49:20",
              "text": "Ang mga anak ng inyong kapanglawan ay mangagsasabi pa sa iyong mga pakinig, Ang dako ay totoong makipot sa ganang akin: bigyan mo ako ng dako upang aking matahanan."
            },
            {
              "chapter": 49,
              "verse": 21,
              "name": "Isaias 49:21",
              "text": "Kung magkagayo'y sasabihin mo sa iyong sarili, Sinong nanganak ng mga ito sa akin, dangang nawalan ako ng aking mga anak, at ako'y nagiisa, tapon, at lumalaboy na paroo't parito? at sinong nagpalaki ng mga ito? Narito, ako'y naiwang magisa; mga ito, saan nangandoon?"
            },
            {
              "chapter": 49,
              "verse": 22,
              "name": "Isaias 49:22",
              "text": "Ganito ang sabi ng Panginoong Dios, Narito, aking ikakaway ang aking kamay sa mga bansa, at itatayo ko ang aking watawat sa mga bayan; at sila'y kakalong ng iyong mga anak na lalake sa kanilang sinapupunan, at ang iyong mga anak na babae ay papasanin ng kanilang mga balikat."
            },
            {
              "chapter": 49,
              "verse": 23,
              "name": "Isaias 49:23",
              "text": "At mga hari ang magiging iyong mga taga kandiling ama, at ang kanilang mga reina, ay iyong mga taga kandiling ina: sila'y magsisiyukod sa iyo ng kanilang mga mukha sa lupa, at hihimuran ang alabok ng inyong mga paa: at iyong makikilala, na ako ang Panginoon, at ang nangaghihintay sa akin ay hindi mangapapahiya."
            },
            {
              "chapter": 49,
              "verse": 24,
              "name": "Isaias 49:24",
              "text": "Makukuha baga ang huli sa makapangyarihan, o maliligtas ang mga talagang nabihag?"
            },
            {
              "chapter": 49,
              "verse": 25,
              "name": "Isaias 49:25",
              "text": "Nguni't ganito ang sabi ng Panginoon, Pati ng mga bihag ng makapangyarihan ay kukunin, at ang huli ng kakilakilabot ay maliligtas; sapagka't ako'y makikipaglaban sa kaniya na nakikipaglaban sa iyo, at aking ililigtas ang iyong mga anak."
            },
            {
              "chapter": 49,
              "verse": 26,
              "name": "Isaias 49:26",
              "text": "At aking pakakanin silang nagsisipighati sa iyo ng kanilang sariling laman; at sila'y mangalalango ng kanilang sariling dugo, na gaya ng matamis na alak: at makikilala ng lahat ng tao, na akong Panginoon ay iyong Tagapagligtas, at iyong Manunubos, na Makapangyarihan ng Jacob."
            }
          ]
        },
        {
          "chapter": 50,
          "name": "Isaias 50",
          "verses": [
            {
              "chapter": 50,
              "verse": 1,
              "name": "Isaias 50:1",
              "text": "Ganito ang sabi ng Panginoon, Saan nandoon ang sulat ng pagkakahiwalay ng iyong ina, na aking ipinaghiwalay sa kaniya? o sa kanino sa mga nagpapautang sa akin ipinagbili kita? Narito, dahil sa inyong mga kasamaan ay naipagbili kayo, at dahil sa inyong mga pagsalangsang ay nahiwalay ang inyong ina."
            },
            {
              "chapter": 50,
              "verse": 2,
              "name": "Isaias 50:2",
              "text": "Bakit, nang ako'y parito, ay walang tao? nang ako'y tumawag, ay walang sumagot? naging maiksi na baga ang aking kamay na hindi makatubos? o wala akong kapangyarihang makapagligtas? Narito, sa saway ko ay aking tinutuyo ang dagat, aking pinapaging ilang ang mga ilog: ang kanilang isda ay bumabaho, sapagka't walang tubig, at namamatay dahil sa uhaw."
            },
            {
              "chapter": 50,
              "verse": 3,
              "name": "Isaias 50:3",
              "text": "Aking binibihisan ng kaitiman ang langit at aking ginagawang kayong magaspang ang kaniyang takip."
            },
            {
              "chapter": 50,
              "verse": 4,
              "name": "Isaias 50:4",
              "text": "Binigyan ako ng Panginoong Dios ng dila ng nangaturuan, upang aking maalaman kung paanong aaliwin ng mga salita siyang nanglulupaypay. Siya'y nagigising tuwing umaga, ginigising niya ang aking pakinig upang makinig na gaya ng mga natuturuan."
            },
            {
              "chapter": 50,
              "verse": 5,
              "name": "Isaias 50:5",
              "text": "Binuksan ng Panginoong Dios ang aking pakinig, at ako'y hindi naging mapanghimagsik, o tumalikod man."
            },
            {
              "chapter": 50,
              "verse": 6,
              "name": "Isaias 50:6",
              "text": "Aking ipinain ang aking likod sa mga mananakit, at ang aking mga pisngi sa mga bumabaltak ng balbas; hindi ko ikinubli ang aking mukha sa kahihiyan at sa paglura."
            },
            {
              "chapter": 50,
              "verse": 7,
              "name": "Isaias 50:7",
              "text": "Sapagka't tutulungan ako ng Panginoong Dios; kaya't hindi ako nalito: kaya't inilagay ko ang aking mukha na parang batong pingkian, at talastas ko na hindi ako mapapahiya."
            },
            {
              "chapter": 50,
              "verse": 8,
              "name": "Isaias 50:8",
              "text": "Siya'y malapit na nagpapatotoo sa akin; sinong makikipaglaban sa akin? tayo'y magsitayong magkakasama: sino ang aking kaaway? bayaang lumapit siya sa akin."
            },
            {
              "chapter": 50,
              "verse": 9,
              "name": "Isaias 50:9",
              "text": "Narito, tutulungan ako ng Panginoong Dios; sino siya na hahatol sa akin? narito, silang lahat ay mangalulumang parang bihisan; lalamunin sila ng tanga."
            },
            {
              "chapter": 50,
              "verse": 10,
              "name": "Isaias 50:10",
              "text": "Sino sa inyo ang natatakot sa Panginoon, na sumusunod sa tinig ng kaniyang lingkod? Siyang lumalakad sa kadiliman, at walang liwanag, tumiwala siya sa pangalan ng Panginoon, at umasa sa kaniyang Dios."
            },
            {
              "chapter": 50,
              "verse": 11,
              "name": "Isaias 50:11",
              "text": "Narito, kayong lahat na nangagsusulsol ng apoy, na kumukubkob ng mga sulo: magsilakad kayo sa liyab ng inyong apoy, at sa gitna ng mga sulo na inyong pinagalab. Ito ang tatamuhin ninyo sa aking kamay; kayo'y hihiga sa kapanglawan."
            }
          ]
        },
        {
          "chapter": 51,
          "name": "Isaias 51",
          "verses": [
            {
              "chapter": 51,
              "verse": 1,
              "name": "Isaias 51:1",
              "text": "Kayo'y magsipakinig sa akin, kayong nagsisisunod sa katuwiran, kayong nagsisihanap sa Panginoon: magsitingin kayo sa malaking bato na inyong kinaputulan, at sa luwang ng hukay na kinahukayan sa inyo."
            },
            {
              "chapter": 51,
              "verse": 2,
              "name": "Isaias 51:2",
              "text": "Tingnan ninyo si Abraham na inyong ama, at si Sara na nanganak sa inyo; sapagka't nang siya'y iisa ay tinawag ko siya, at aking pinagpala siya, at aking pinarami siya."
            },
            {
              "chapter": 51,
              "verse": 3,
              "name": "Isaias 51:3",
              "text": "Sapagka't inaliw ng Panginoon ang Sion; kaniyang pinasaya ang lahat niyang sirang dako, at ginawa niyang parang Eden ang kaniyang ilang, at ang kaniyang lupang masukal ay parang halamanan ng Panginoon; kagalakan at kasayahan ay masusumpungan doon, pagpapasalamat, at tinig na mainam."
            },
            {
              "chapter": 51,
              "verse": 4,
              "name": "Isaias 51:4",
              "text": "Makinig ka sa akin, Oh bayan ko; at pakinggan mo ako, Oh bansa ko: sapagka't isang kautusan ay magmumula sa akin, at ang aking kahatulan ay gagawin kong pinakaliwanag sa mga bayan."
