            {
              "chapter": 8,
              "verse": 13,
              "name": "Awit ni Solomon 8:13",
              "text": "Ikaw na tumatahan sa mga halamanan, ang mga kasama ay nangakikinig ng iyong tinig: iparinig mo sa akin."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Awit ni Solomon 8:14",
              "text": "Ikaw ay magmadali, sinisinta ko, at ikaw ay maging parang usa o batang usa sa mga bundok ng mga especia."
