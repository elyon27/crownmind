            {
              "chapter": 35,
              "verse": 29,
              "name": "Genesis 35:29",
              "text": "At nalagot ang hininga ni Isaac at namatay, at siya'y nalakip sa kaniyang bayan, matanda at puspos ng mga araw: at inilibing siya ng kaniyang mga anak na si Esau at si Jacob."
            }
          ]
