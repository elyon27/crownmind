          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Mga Hukom 5:1",
              "text": "Nang magkagayo'y umawit si Debora at si Barac na anak ni Abinoam nang araw na yaon, na sinasabi,"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Mga Hukom 5:2",
              "text": "Sapagka't namatnubay ang mga tagapatnubay sa Israel, Sapagka't ang bayan ay humandog na kusa, Purihin ninyo ang Panginoon."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Mga Hukom 5:3",
              "text": "Dinggin ninyo, Oh ninyong mga hari; pakinggan ninyo, Oh ninyong mga prinsipe; Ako, ako'y aawit sa Panginoon, Ako'y aawit ng pagpupuri sa Panginoon, na Dios ng Israel."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Mga Hukom 5:4",
              "text": "Panginoon, nang ikaw ay lumabas sa Seir, Nang ikaw ay yumaon mula sa bukid ng Edom, Ang lupa'y nayanig, ang langit naman ay pumatak, Oo, ang mga alapaap ay nagpatak ng tubig."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Mga Hukom 5:5",
              "text": "Ang mga bundok ay humuho sa harap ng Panginoon, Pati yaong Sinai, sa harap ng Panginoon, ng Dios ng Israel."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Mga Hukom 5:6",
              "text": "Sa mga kaarawan ni Samgar na anak ni Anat, Sa mga kaarawan ni Jael, ang mga paglalakbay ay naglikat, At ang mga manglalakbay ay bumagtas sa mga lihis na landas."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Mga Hukom 5:7",
              "text": "Ang mga pinuno ay naglikat sa Israel, sila'y naglikat, Hanggang sa akong si Debora, ay bumangon, Na ako'y bumangon na isang ina sa Israel."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Mga Hukom 5:8",
              "text": "Sila'y nagsipili ng mga bagong dios; Nang magkagayo'y nagkaroon ng digma sa mga pintuang-bayan: May nakita kayang kalasag o sibat sa apat na pung libo sa Israel?"
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Mga Hukom 5:9",
              "text": "Ang aking puso ay nasa mga gobernador sa Israel, Na nagsihandog na kusa sa bayan; Purihin ninyo ang Panginoon!"
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Mga Hukom 5:10",
              "text": "Saysayin ninyo, ninyong mga nakasakay sa mapuputing asno, Ninyong nangakaupo sa maiinam na latag, At ninyong nangagsisilakad sa daan."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Mga Hukom 5:11",
              "text": "Malayo sa ingay ng mga manghuhutok, sa mga dakong igiban ng tubig, Doon sila magpapanibagong magsanay sa mga matuwid na gawa ng Panginoon, Ng mga matuwid na gawa ng kaniyang pagpupuno sa Israel. Bumaba nga ang bayan ng Panginoon sa mga pintuang-bayan."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Mga Hukom 5:12",
              "text": "Gumising ka, gumising ka, Debora; gumising ka, gumising ka, bumigkas ka ng awit: Bumangon ka, Barac, at ihatid mo ang iyong mga bihag, ikaw na anak ni Abinoam."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Mga Hukom 5:13",
              "text": "Nagsibaba nga ang nalabi sa mga mahal, at ang bayan; Ang Panginoon ay bumaba dahil sa akin laban sa mga makapangyarihan."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Mga Hukom 5:14",
              "text": "Sa Ephraim nangagmula silang nasa Amalec ang ugat; Sa likuran mo, ay ang Benjamin, na kasama ng iyong mga bayan; Sa Machir nangagmula ang mga gobernador, At sa Zabulon yaong nangaghahawak ng tungkod ng pagpupuno."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Mga Hukom 5:15",
              "text": "At ang mga prinsipe sa Issachar ay kasama ni Debora; Na kung paano si Issachar ay gayon si Barac, Sa libis nagsisubasob sa kaniyang paanan. Sa tabi ng mga agusan ng tubig ng Ruben ay nagkaroon ng mga dakilang pasiya ng puso."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Mga Hukom 5:16",
              "text": "Bakit ka nakaupo sa gitna ng mga kulungan ng tupa, Upang makinig ba ng mga tawag sa mga kawan? Sa agusan ng tubig ng Ruben Nagkaroon ng mga dakilang pasiya ng puso."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Mga Hukom 5:17",
              "text": "Ang Galaad ay tumahan sa dako roon ng Jordan: At ang Dan, bakit siya'y natira sa mga sasakyan sa tubig? Ang Aser ay nanatili sa mga baybayin ng dagat, At nanahan sa kaniyang mga daong."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Mga Hukom 5:18",
              "text": "Ang Zabulon ay isang bayan na isinapanganib ang kanilang buhay sa ikamamatay, At ang Nephtali, ay sa matataas na dako ng bukiran."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Mga Hukom 5:19",
              "text": "Ang mga hari ay nagsiparito at nagsilaban; Nang magkagayo'y nagsilaban ang mga hari ng Canaan, Sa Taanach na nasa tabi ng tubig sa Megiddo: Sila'y hindi nagdala ng mga pakinabang na salapi."
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Mga Hukom 5:20",
              "text": "Ang mga bituin ay nakipaglaban mula sa langit, Sa kanilang paglakad sila'y nakipaglaban kay Sisara."
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Mga Hukom 5:21",
              "text": "Tinangay sila ng ilog Cison, Ng matandang ilog na yaon, ng ilog Cison. Oh kaluluwa ko, lumakad kang may lakas."
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Mga Hukom 5:22",
              "text": "Nang magkagayo'y nagsiyabag ang mga kuko ng mga kabayo, Dahil sa mga pagdamba, sa pagdamba ng kanilang mga malakas."
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Mga Hukom 5:23",
              "text": "Sumpain ninyo si Meroz, sabi ng anghel ng Panginoon, Sumpain ninyo ng kapaitpaitan ang mga tagaroon sa kaniya; Sapagka't sila'y hindi naparoon na tumulong sa Panginoon, Na tumulong sa Panginoon, laban sa mga makapangyarihan."
            },
            {
              "chapter": 5,
              "verse": 24,
              "name": "Mga Hukom 5:24",
              "text": "Pagpalain sa lahat ng babae si Jael, Ang asawa ni Heber na Cineo, Pagpalain siya sa lahat ng babae sa tolda."
            },
            {
              "chapter": 5,
              "verse": 25,
              "name": "Mga Hukom 5:25",
              "text": "Siya'y humingi ng tubig, at binigyan niya ng gatas; Kaniyang binigyan siya ng mantekilya sa pinggang mahal."
            },
            {
              "chapter": 5,
              "verse": 26,
              "name": "Mga Hukom 5:26",
              "text": "Kaniyang hinawakan ng kaniyang kamay ang tulos, At ng kaniyang kanang kamay ang pamukpok ng mga manggagawa; At sa pamamagitan ng pamukpok ay kaniyang sinaktan si Sisara, pinalagpasan niya sa kaniyang ulo, Oo, kaniyang tinarakan at pinalagpasan ang kaniyang pilipisan."
            },
            {
              "chapter": 5,
              "verse": 27,
              "name": "Mga Hukom 5:27",
              "text": "Sa kaniyang paanan ay nasubasob, siya'y nabuwal, siya'y nalugmok: Sa kaniyang paanan siya'y nasubasob, siya'y nabuwal. Kung saan siya sumubasob, doon siya nalugmok na patay."
            },
            {
              "chapter": 5,
              "verse": 28,
              "name": "Mga Hukom 5:28",
              "text": "Sa dungawan ay sumungaw, at sumigaw; Ang ina ni Sisara ay humiyaw mula sa mga silahia: Bakit kaya ang kaniyang karo ay nagluluwat ng pagdating? Bakit kaya bumabagal ang mga gulong ng kaniyang mga karo?"
            },
            {
              "chapter": 5,
              "verse": 29,
              "name": "Mga Hukom 5:29",
              "text": "Ang kaniyang mga pantas na babae ay sumagot sa kaniya, Oo, siya'y nagbalik ng sagot sa kaniyang sarili,"
            },
            {
              "chapter": 5,
              "verse": 30,
              "name": "Mga Hukom 5:30",
              "text": "Hindi ba sila nakasumpong, hindi ba nila binahagi ang samsam? Isang dalaga, dalawang dalaga sa bawa't lalake; Kay Sisara ay samsam na damit na may sarisaring kulay, Samsam na sarisaring kulay ang pagkaburda, Na sarisaring kulay, na burda sa dalawang tagiliran, Na suot sa leeg ng mga bihag?"
            },
            {
              "chapter": 5,
              "verse": 31,
              "name": "Mga Hukom 5:31",
              "text": "Gayon malipol ang lahat ng iyong mga kaaway, Oh Panginoon: Nguni't yaong mga umiibig sa kaniya ay maging parang araw pagka lumalabas sa kaniyang kalakasan. At ang lupain ay nagpahinga na apat na pung taon."
            }
