            {
              "chapter": 25,
              "verse": 20,
              "name": "1 Samuel 25:20",
              "text": "At nagkagayon na samantalang siya'y nakasakay sa kaniyang asno at lumulusong sa isang kubling dako ng bundok na narito, si David at ang kaniyang mga lalake ay lumulusong na patungo sa kaniya, at sinalubong niya sila."
            },
            {
              "chapter": 25,
              "verse": 21,
              "name": "1 Samuel 25:21",
