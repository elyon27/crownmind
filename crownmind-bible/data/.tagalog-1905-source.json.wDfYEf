        {
          "chapter": 55,
          "name": "Isaias 55",
          "verses": [
            {
              "chapter": 55,
              "verse": 1,
              "name": "Isaias 55:1",
              "text": "Oh lahat na nangauuhaw, magsiparito kayo sa tubig at siyang walang salapi; magsiparito kayo, kayo'y magsibili, at magsikain; oo, kayo'y magsiparito, kayo'y magsibili ng alak at gatas ng walang salapi at walang bayad."
            },
            {
              "chapter": 55,
              "verse": 2,
              "name": "Isaias 55:2",
              "text": "Ano't kayo'y nangaggugugol ng salapi sa hindi pagkain? at ng inyong gawa sa hindi nakabubusog? inyong pakinggan ako, at magsikain kayo ng mabuti, at mangalugod kayo sa katabaan."
            },
            {
              "chapter": 55,
              "verse": 3,
              "name": "Isaias 55:3",
              "text": "Inyong ikiling ang inyong tainga, at magsiparito kayo sa akin; kayo'y magsipakinig, at ang inyong kaluluwa ay mabubuhay: at ako'y makikipagtipan sa inyo ng walang hanggan, sa makatuwid baga'y ng tunay na mga kaawaan ni David."
            },
            {
              "chapter": 55,
              "verse": 4,
              "name": "Isaias 55:4",
              "text": "Narito, ibinigay ko siya na pinakasaksi sa mga bayan, na patnubay at tagapagutos sa mga bayan."
            },
            {
