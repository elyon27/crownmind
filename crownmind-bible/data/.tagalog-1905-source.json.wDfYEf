            {
              "chapter": 31,
              "verse": 55,
              "name": "Genesis 31:55",
              "text": "At bumangong maaga sa kinaumagahan si Laban, at hinagkan ang kaniyang mga anak na lalake at babae, at pinagbabasbasan: at yumaon at umuwi si Laban."
