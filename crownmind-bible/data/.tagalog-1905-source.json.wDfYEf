            {
              "chapter": 6,
              "verse": 10,
              "name": "Awit ni Solomon 6:10",
              "text": "Sino siyang tumitinging parang umaga, maganda na parang buwan, maliwanag na parang araw, kakilakilabot na parang hukbo na may mga watawat?"
