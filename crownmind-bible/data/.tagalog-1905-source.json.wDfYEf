            {
              "chapter": 26,
              "verse": 15,
              "name": "Genesis 26:15",
              "text": "Lahat ng mga balon ngang hinukay ng mga bataan ng kaniyang ama, nang mga kaarawan ni Abraham na kaniyang ama, ay pinagtabunan ng mga Filisteo, na mga pinuno ng lupa."
            },
            {
              "chapter": 26,
              "verse": 16,
              "name": "Genesis 26:16",
