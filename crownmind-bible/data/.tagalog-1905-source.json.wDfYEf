            {
              "chapter": 26,
              "verse": 24,
              "name": "Jeremias 26:24",
              "text": "Nguni't ang kamay ni Ahicam na anak ni Zaphan ay sumasa kay Jeremias upang huwag siyang ibigay nila sa kamay ng bayan at ipapatay siya."
