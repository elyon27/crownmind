            },
            {
              "chapter": 45,
              "verse": 14,
              "name": "Genesis 45:14",
              "text": "At siya'y humilig sa leeg ng kaniyang kapatid na si Benjamin, at umiyak; at si Benjamin ay umiyak sa ibabaw ng kaniyang leeg."
