            {
              "chapter": 15,
              "verse": 9,
              "name": "1 Samuel 15:9",
              "text": "Nguni't pinanghinayangan ni Saul at ng bayan si Agag, at ang pinakamabuti sa mga tupa, sa mga baka, at sa mga pinataba, at sa mga kordero, at lahat ng mabuti, at yaong mga hindi nila lubos na nilipol: nguni't bawa't bagay na hamak at walang kabuluhan, ay kanilang lubos na nilipol."
            },
            {
              "chapter": 15,
              "verse": 10,
              "name": "1 Samuel 15:10",
              "text": "Nang magkagayo'y dumating ang salita ng Panginoon kay Samuel, na sinasabi,"
