        {
          "chapter": 27,
          "name": "Jeremias 27",
          "verses": [
            {
              "chapter": 27,
              "verse": 1,
              "name": "Jeremias 27:1",
              "text": "Nang pasimula ng paghahari ni Joacim na anak ni Josias, na hari sa Juda, dumating ang salitang ito kay Jeremias na mula sa Panginoon, na nagsasabi,"
