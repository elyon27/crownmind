            {
              "chapter": 49,
              "verse": 17,
              "name": "Genesis 49:17",
              "text": "Si Dan ay magiging ahas sa daan, At ulupong sa landas, Na nangangagat ng mga sakong ng kabayo, Na ano pa't nahuhulog sa likuran ang sakay niyaon."
            },
            {
              "chapter": 49,
              "verse": 18,
              "name": "Genesis 49:18",
              "text": "Aking hinintay ang iyong pagliligtas, Oh Panginoon."
