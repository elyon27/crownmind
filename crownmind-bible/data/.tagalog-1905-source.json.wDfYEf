          ]
        },
        {
          "chapter": 13,
          "name": "Isaias 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "Isaias 13:1",
              "text": "Ang hula tungkol sa Babilonia na nakita ni Isaias na anak ni Amoz."
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "Isaias 13:2",
              "text": "Kayo'y mangaglagay ng isang watawa't sa bundok, na walang punong kahoy, mangaglakas kayo ng tinig sa kanila, inyong senyasan ng kamay, upang sila'y magsipasok sa mga pintuang-bayan ng mga mahal na tao."
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "Isaias 13:3",
              "text": "Aking inutusan ang aking mga itinalaga, oo, aking tinawag ang aking mga makapangyarihang lalake dahil sa aking galit, sa makatuwid baga'y ang nangagagalak sa aking kamahalan."
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "Isaias 13:4",
              "text": "Ang ingay ng karamihan sa mga bundok, gaya ng malaking bayan: ang ingay ng kagulo ng mga kaharian ng mga bansa na nagpipisan! pinipisan ng Panginoon ng mga hukbo ang hukbo ukol sa pagbabaka."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "Isaias 13:5",
              "text": "Sila'y nangagmumula sa malayong lupain, mula sa kaduluduluhang bahagi ng langit, sa makatuwid baga'y ang Panginoon, at ang mga almas ng kaniyang galit, upang gibain ang buong lupain."
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "Isaias 13:6",
              "text": "Magsiangal kayo; sapagka't ang araw ng Panginoon ay malapit na; darating na pinaka paggiba na mula sa Makapangyarihan sa lahat."
            },
            {
              "chapter": 13,
              "verse": 7,
              "name": "Isaias 13:7",
              "text": "Kaya't lahat ng kamay ay manghihina, at bawa't puso ng tao ay manglulumo:"
            },
            {
              "chapter": 13,
              "verse": 8,
              "name": "Isaias 13:8",
              "text": "At sila'y manglulupaypay; mga pagdaramdam at mga kapanglawan ay dadanasin nila; sila'y mangaghihirap na gaya ng babae sa pagdaramdam: mangagkakatigilan; ang kanilang mga mukha ay magiging parang liyab."
            },
            {
              "chapter": 13,
              "verse": 9,
              "name": "Isaias 13:9",
              "text": "Narito, ang kaarawan ng Panginoon ay dumarating, mabagsik, na may poot at mabangis na galit; upang gawin kagibaan ang lupa, at upang lipulin mula roon ang mga makasalanan niyaon."
            },
            {
              "chapter": 13,
              "verse": 10,
              "name": "Isaias 13:10",
              "text": "Sapagka't ang mga bituin ng langit at ang mga gayak niyaon, hindi magbibigay ng kanilang liwanag: ang araw ay magdidilim sa kaniyang pagsikat, at hindi pasisilangin ng buwan ang kaniyang liwanag."
            },
            {
              "chapter": 13,
              "verse": 11,
              "name": "Isaias 13:11",
              "text": "At aking parurusahan ang sanglibutan dahil sa kanilang kasamaan, at ang mga masama dahil sa kanilang kabalakyutan; at aking patitigilin ang kahambugan ng palalo, at aking ibababa ang kapalaluan ng kakilakilabot."
            },
            {
              "chapter": 13,
              "verse": 12,
              "name": "Isaias 13:12",
              "text": "At aking gagawin ang isang lalake ay maging mahalaga kay sa dalisay na ginto, ang tao na higit kay sa dalisay na ginto ng Ophir."
            },
            {
              "chapter": 13,
              "verse": 13,
              "name": "Isaias 13:13",
              "text": "Kaya't aking panginginigin ang mga langit, at ang lupa ay yayanigin mula sa kinaroroonan sa poot ng Panginoon ng mga hukbo, at sa kaarawan ng kaniyang mabangis na galit,"
            },
            {
              "chapter": 13,
              "verse": 14,
              "name": "Isaias 13:14",
              "text": "At mangyayari, na kung paano ang usang hinahabol, at kung paano ang mga tupa na walang pumisan, ay magsisibalik sila bawa't isa sa kaniyang sariling bayan, at tatakas bawa't isa sa kaniyang sariling lupain."
            },
            {
              "chapter": 13,
              "verse": 15,
              "name": "Isaias 13:15",
              "text": "Bawa't masusumpungan ay palalagpasan; at bawa't nahuli ay mabubuwal sa tabak."
            },
            {
              "chapter": 13,
              "verse": 16,
              "name": "Isaias 13:16",
              "text": "Ang kanilang mga sanggol ay pagluluraylurayin sa harap ng kanilang mga mata; ang kanilang mga bahay ay sasamsaman, at ang kanilang mga asawa ay dadahasin."
            },
            {
              "chapter": 13,
              "verse": 17,
              "name": "Isaias 13:17",
              "text": "Narito, aking hihikayatin ang mga Medo laban sa kanila, na hindi magpapakundangan sa pilak, at tungkol sa ginto, hindi nila kaluluguran."
            },
            {
              "chapter": 13,
              "verse": 18,
              "name": "Isaias 13:18",
              "text": "At pagluluraylurayin ng kanilang mga busog ang mga binata; at sila'y hindi maaawa sa bunga ng bahay-bata; ang kanilang mata ay hindi mahahabag sa mga bata."
            },
            {
              "chapter": 13,
              "verse": 19,
              "name": "Isaias 13:19",
              "text": "At ang Babilonia, ang kaluwalhatian ng mga kaharian, ang ganda ng kapalaluan ng mga Caldeo, ay magiging gaya nang gibain ng Dios ang Sodoma at Gomorra."
            },
            {
              "chapter": 13,
              "verse": 20,
              "name": "Isaias 13:20",
              "text": "Hindi matatahanan kailan man, ni di tatahanan sa buong panahon: ni di magtatayo roon ang taga Arabia ng tolda; ni di pahihigain doon ng mga pastor ang kanilang kawan."
            },
            {
              "chapter": 13,
              "verse": 21,
              "name": "Isaias 13:21",
              "text": "Kundi mga maiilap na hayop sa ilang ang magsisihiga roon; at ang kanilang mga bahay ay mangapupuno ng mga hayop na nagsisiungal; at mga avestruz ay magsisitahan doon, at ang mga lalaking kambing ay magluluksuhan roon."
            },
            {
              "chapter": 13,
              "verse": 22,
              "name": "Isaias 13:22",
              "text": "At ang mga lobo ay magsisihiyaw sa kanilang mga moog, at ang mga chakal sa mga maligayang palasio: at ang kanilang panahon ay malapit nang sumapit, at ang kanilang mga kaarawan ay hindi magtatagal."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "Isaias 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Isaias 14:1",
              "text": "Sapagka't ang Panginoon ay maaawa sa Jacob, at kaniyang pipiliin pa ang Israel, at ilalagay sila sa kanilang sariling lupain: at ang taga ibang lupa ay lalakip sa kanila, at sila'y masasanib sa sangbahayan ni Jacob."
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Isaias 14:2",
              "text": "At kukunin sila ng mga tao, at dadalhin sila sa kanilang dako: at aariin sila ng sangbahayan ng Israel sa lupain ng Panginoon, na mga pinakaaliping lalake at babae: at kanilang bibihagin sila, na nagsibihag sa kanila; at mangagpupuno sila sa mga mamimighati sa kanila."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Isaias 14:3",
              "text": "At mangyayari, sa araw na bibigyan ka ng Panginoon ng kapahingahan sa iyong kapanglawan, at sa iyong kabagabagan, at sa mabigat na paglilingkod na ipinapaglingkod sa iyo,"
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Isaias 14:4",
              "text": "Na iyong gagamitin ang talinghagang ito laban sa hari sa Babilonia, at iyong sasabihin, Kung paano ang mamimighati ay naglikat! ang bayang ginto ay naglikat!"
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Isaias 14:5",
              "text": "Binali ng Panginoon ang tungkod ng masama, ang cetro ng mga pinuno;"
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Isaias 14:6",
              "text": "Siya na sumakit ng mga tao sa poot ng walang likat na bugbog, na nagpuno sa mga bansa sa galit, na may pag-uusig na hindi pinigil ng sinoman."
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Isaias 14:7",
              "text": "Ang buong lupa ay nasa katiwasayan, at tahimik: sila'y biglang nagsisiawit."
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "Isaias 14:8",
              "text": "Oo, ang mga puno ng cipres ay nagagalak dahil sa iyo, at ang mga cedro sa Libano, na nangagsasabi, Mula nang ikaw ay malugmok wala nang mamumutol na umaahon laban sa amin."
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "Isaias 14:9",
              "text": "Ang Sheol mula sa ibaba ay nakikilos sa iyo upang salubungin ka sa iyong pagdating; nangapupukaw ang mga patay dahil sa iyo, sa makatuwid baga'y ang lahat na pinakapangulo sa lupa; nagsitindig mula sa kanilang mga luklukan ang lahat ng hari ng mga bansa."
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "Isaias 14:10",
              "text": "Silang lahat ay magsisisagot at mangagsasabi sa iyo, Pati ba ikaw ay naging mahinang gaya namin? ikaw ba'y naging gaya namin?"
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "Isaias 14:11",
              "text": "Ang iyong kahambugan ay nababa sa Sheol pati ng tunog ng iyong mga biola: ang uod ay nangangalat sa ilalim mo, at tinatakpan ka ng mga uod."
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "Isaias 14:12",
              "text": "Ano't nahulog ka mula sa langit, Oh tala sa umaga, anak ng umaga! paanong ikaw ay lumagpak sa lupa, ikaw na siyang nagpahina sa mga bansa!"
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "Isaias 14:13",
              "text": "At sinabi mo sa iyong sarili, Ako'y sasampa sa langit, aking itataas ang aking luklukan sa itaas ng mga bituin ng Dios; at ako'y uupo sa bundok ng kapisanan, sa mga kaduluduluhang bahagi ng hilagaan:"
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "Isaias 14:14",
              "text": "Ako'y sasampa sa itaas ng mga kaitaasan ng mga alapaap; ako'y magiging gaya ng Kataastaasan."
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "Isaias 14:15",
              "text": "Gayon ma'y mabababa ka sa Sheol, sa mga kaduluduluhang bahagi ng hukay."
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "Isaias 14:16",
              "text": "Silang nangakakakita sa iyo ay magsisititig sa iyo, kanilang mamasdan ka, na mangagsasabi, Ito baga ang lalake na nagpayanig ng lupa, na nagpauga ng mga kaharian;"
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "Isaias 14:17",
              "text": "Na ginawang gaya ng ilang ang sanglibutan, at gumiba ng mga bayan nito; na hindi nagpakawala ng kaniyang mga bilanggo upang magsiuwi?"
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "Isaias 14:18",
              "text": "Lahat ng mga hari ng mga bansa, silang lahat, nangatutulog sa kaluwalhatian, bawa't isa'y sa kaniyang sariling bahay."
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "Isaias 14:19",
              "text": "Nguni't ikaw ay natapon mula sa iyong libingan na gaya ng kasuklamsuklam na sanga, gaya ng bihisan ng mga patay, na tinaga ng tabak, na bumaba sa mga bato ng hukay: gaya ng bangkay na nayapakan ng paa."
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "Isaias 14:20",
              "text": "Ikaw ay hindi malalakip sa kanila sa libingan, sapagka't iyong sinira ang iyong lupain, iyong pinatay ang iyong bayan; ang angkan ng mga manggagawa ng kasamaan ay hindi lalagi magpakailan man."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "Isaias 14:21",
              "text": "Mangaghanda kayo na pumatay sa kanilang mga anak dahil sa kasamaan ng kanilang mga magulang; upang sila'y huwag magsibangon, at ariin ang lupain, at punuin ang ibabaw ng lupa ng mga bayan."
            },
            {
              "chapter": 14,
              "verse": 22,
              "name": "Isaias 14:22",
              "text": "At ako'y babangon laban sa kanila, sabi ng Panginoon ng mga hukbo, at ihihiwalay ko sa Babilonia ang pangalan at ang nalabi, at ang anak at ang anak ng anak, sabi ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 23,
              "name": "Isaias 14:23",
              "text": "Akin namang gagawing pinakaari ng hayop na erizo, at mga lawa ng tubig: at aking papalisin ng pangpalis na kagibaan, sabi ng Panginoon ng mga hukbo."
            },
            {
              "chapter": 14,
              "verse": 24,
              "name": "Isaias 14:24",
              "text": "Ang Panginoon ng mga hukbo ay sumumpa, na nagsabi, Tunay na kung ano ang iniisip ko, gayon ang mangyayari; at kung ano ang aking pinanukala, gayon mananayo:"
            },
            {
              "chapter": 14,
              "verse": 25,
              "name": "Isaias 14:25",
              "text": "Na aking lalansagin ang taga Asiria sa aking lupain, at sa aking mga bundok ay yayapakan ko siya sa ilalim ng paa; kung magkagayo'y mahihiwalay ang kaniyang atang sa kanila, at ang ipinasan niya ay mahihiwalay sa kanilang balikat."
            },
            {
              "chapter": 14,
              "verse": 26,
              "name": "Isaias 14:26",
              "text": "Ito ang panukala na aking pinanukala sa buong lupa: at ito ang kamay na umunat sa lahat ng mga bansa."
            },
            {
              "chapter": 14,
              "verse": 27,
              "name": "Isaias 14:27",
              "text": "Sapagka't pinanukala ng Panginoon ng mga hukbo, at sinong wawala ng kabuluhan? at ang kaniyang kamay na nakaunat, at sinong maguurong?"
            },
            {
              "chapter": 14,
              "verse": 28,
              "name": "Isaias 14:28",
              "text": "Nagkaroon ng hulang ito nang taong mamatay ang haring Achaz."
            },
            {
              "chapter": 14,
              "verse": 29,
              "name": "Isaias 14:29",
              "text": "Ikaw ay huwag magalak, ikaw na buong Filistia, sa pagkabali ng pamalo na sumakit sa iyo: sapagka't sa ahas ay lalabas ang ulupong, at ang kaniyang anak ay magiging mabangis na ahas na lumilipad."
            },
            {
              "chapter": 14,
              "verse": 30,
              "name": "Isaias 14:30",
              "text": "At ang panganay ng dukha ay kakain, at ang mapagkailangan ay mahihigang tiwasay: at aking papatayin ng gutom ang iyong angkan, at ang nalabi sa iyo ay papatayin."
            },
            {
              "chapter": 14,
              "verse": 31,
              "name": "Isaias 14:31",
              "text": "Ikaw ay umungal, Oh pintuang-bayan; ikaw ay humiyaw, Oh bayan; ikaw ay napugnaw, Oh ikaw na buong Filistia; sapagka't lumalabas ang usok na mula sa hilagaan, at walang malalabi sa kaniyang mga takdang panahon."
            },
            {
              "chapter": 14,
              "verse": 32,
              "name": "Isaias 14:32",
              "text": "Ano nga ang isasagot sa mga sugo ng bansa? Na itinayo ng Panginoon ang Sion, at doon nanganganlong ang nagdadalamhati sa kaniyang bayan."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "Isaias 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "Isaias 15:1",
              "text": "Ang hula tungkol sa Moab. Sapagka't sa isang gabi ang Ar ng Moab ay nagiba, at nawalan ng kabuluhan; sapagka't sa isang gabi ay nagiba ang Kir ng Moab, at nawalan ng kabuluhan."
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "Isaias 15:2",
              "text": "Siya'y umahon sa Bayith, at sa Dibon, sa mga mataas na dako, upang umiyak: ang Moab ay umaangal sa Nebo, at sa Medeba: lahat nilang ulo ay kalbo, bawa't balbas ay gupit."
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "Isaias 15:3",
              "text": "Sa kanilang mga lansangan ay nangagbibigkis sila ng kayong magaspang: sa kanilang mga bubungan, at sa kanilang mga luwal na dako, umaangal ang bawa't isa, na umiiyak ng di kawasa."
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "Isaias 15:4",
