            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Awit ni Solomon 5:6",
              "text": "Aking pinagbuksan ang aking sinta: nguni't ang aking sinta ay umurong at nakaalis, napanglupaypay na ako ng aking kaluluwa nang siya'y magsalita: aking hinanap siya, nguni't hindi ko nasumpungan siya; aking tinawag siya, nguni't hindi siya sumagot sa akin."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Awit ni Solomon 5:7",
              "text": "Nasumpungan ako ng mga bantay na nagsisilibot sa bayan, sinaktan nila ako, sinugatan nila ako, inalis sa akin ang aking balabal ng mga tanod ng mga kuta."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Awit ni Solomon 5:8",
              "text": "Pinagbibilinan ko kayo, Oh mga anak na babae ng Jerusalem, kung inyong masumpungan ang aking sinta, na inyong saysayin sa kaniya, na ako'y may sakit, na pagsinta."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Awit ni Solomon 5:9",
              "text": "Ano ang iyong sinta na higit kay sa ibang sinta, Oh ikaw na pinakamaganda sa mga babae? Ano ang iyong sinta na higit kay sa ibang sinta, na iyong ibinibilin sa amin ng ganyan?"
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Awit ni Solomon 5:10",
              "text": "Ang aking sinisinta ay maputi at mapulapula na pinakamainam sa sangpung libo."
            },
