            {
              "chapter": 34,
              "verse": 8,
              "name": "Genesis 34:8",
              "text": "At nakiusap si Hamor sa kanila, na sinasabi, Ang kaluluwa ni Sichem na aking anak ay sumasa iyong anak; ipinamamanhik ko sa inyo na ipagkaloob ninyo sa kaniya na maging asawa niya."
            },
            {
              "chapter": 34,
              "verse": 9,
              "name": "Genesis 34:9",
              "text": "At magsipagasawa kayo sa amin; ibigay ninyo sa amin ang inyong mga anak na babae, at ibibigay namin sa inyo ang aming mga anak na babae."
