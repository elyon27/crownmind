            {
              "chapter": 28,
              "verse": 4,
              "name": "Genesis 28:4",
              "text": "At ibigay nawa sa iyo ang pagpapala kay Abraham, sa iyo, at sangpu sa iyong binhi; upang iyong ariin ang lupaing iyong pinaglakbayan, na ibinigay ng Dios kay Abraham."
            },
            {
              "chapter": 28,
              "verse": 5,
              "name": "Genesis 28:5",
              "text": "At pinapagpaalam ni Isaac si Jacob: at naparoon siya sa Padan-aram kay Laban, anak ni Bethuel na taga Siria, na kapatid ni Rebeca, na ina ni Jacob at ni Esau."
            },
            {
              "chapter": 28,
              "verse": 6,
              "name": "Genesis 28:6",
              "text": "Nakita nga ni Esau na binasbasan ni Isaac si Jacob, at siya'y pinaparoon sa Padan-aram, upang doon magasawa; at nang siya'y basbasan ay ipinagbilin sa kaniya, na sinasabi, Huwag kang magaasawa sa mga anak ng Canaan."
            },
            {
              "chapter": 28,
              "verse": 7,
              "name": "Genesis 28:7",
              "text": "At sumunod si Jacob sa kaniyang ama at sa kaniyang ina, at naparoon sa Padan-aram;"
            },
            {
              "chapter": 28,
              "verse": 8,
              "name": "Genesis 28:8",
              "text": "At nakita ni Esau na hindi nakalulugod ang mga anak ng Canaan kay Isaac na kaniyang ama;"
            },
            {
              "chapter": 28,
              "verse": 9,
              "name": "Genesis 28:9",
              "text": "At naparoon si Esau kay Ismael, at nagasawa kay Mahaleth, anak ni Ismael, na anak ni Abraham, na kapatid na babae ni Nabaioth, bukod pa sa mga asawang mayroon na siya."
            },
            {
              "chapter": 28,
              "verse": 10,
              "name": "Genesis 28:10",
              "text": "At umalis si Jacob sa Beerseba at napasa dakong Haran."
            },
            {
              "chapter": 28,
              "verse": 11,
              "name": "Genesis 28:11",
              "text": "At dumating sa isang dako, at nagparaan ng buong gabi roon, sapagka't lumubog na ang araw; at kumuha ng isa sa mga bato sa dakong yaon, at inilagay sa kaniyang ulunan, at nahiga sa dakong yaon upang matulog."
            },
            {
              "chapter": 28,
              "verse": 12,
              "name": "Genesis 28:12",
              "text": "At nanaginip, at narito, ang isang hagdan, na ang puno ay nasa lupa, at ang dulo ay umaabot sa langit; at narito, ang mga anghel ng Dios na nagmamanhik manaog doon."
            },
            {
              "chapter": 28,
              "verse": 13,
              "name": "Genesis 28:13",
              "text": "At, narito, ang Panginoon ay nasa kataastaasan niyaon, at nagsabi, Ako ang Panginoon, ang Dios ni Abraham na iyong ama, at ang Dios ni Isaac: ang lupang kinahihigaan mo ay ibibigay ko sa iyo at sa iyong binhi;"
            },
            {
              "chapter": 28,
              "verse": 14,
              "name": "Genesis 28:14",
              "text": "At ang iyong binhi ay magiging parang alabok sa lupa, at kakalat ka sa kalunuran, at sa silanganan, at sa hilagaan, at sa timugan at sa iyo at sa iyong binhi ay pagpapalain ang lahat ng angkan sa lupa."
            },
            {
              "chapter": 28,
              "verse": 15,
              "name": "Genesis 28:15",
              "text": "At, narito't ako'y sumasa iyo, at iingatan kita saan ka man pumaroon, at pababalikin kita sa lupaing ito sapagka't hindi kita iiwan hanggang hindi ko magawa ang sinalita ko sa iyo."
            },
            {
              "chapter": 28,
              "verse": 16,
              "name": "Genesis 28:16",
              "text": "At nagising si Jacob sa kaniyang panaginip, at nagsabi, Tunay na ang Panginoon ay nasa dakong ito, at hindi ko nalalaman."
            },
            {
              "chapter": 28,
              "verse": 17,
              "name": "Genesis 28:17",
              "text": "At siya'y natakot, at kaniyang sinabi, Kakilakilabot na dako ito! ito'y hindi iba kundi bahay ng Dios, at ito ang pintuan ng langit."
            },
            {
              "chapter": 28,
              "verse": 18,
              "name": "Genesis 28:18",
              "text": "At si Jacob ay bumangong maaga ng kinaumagahan, at kinuha ang batong kaniyang inilagay sa ulunan niya, at kaniyang itinayo na pinakaalaala, at kaniyang binuhusan ng langis sa ibabaw."
            },
            {
              "chapter": 28,
              "verse": 19,
              "name": "Genesis 28:19",
              "text": "At ang ipinangalan niya sa dakong yaon ay Betel: datapuwa't ang pangalan ng bayan nang una ay Luz."
            },
            {
              "chapter": 28,
              "verse": 20,
              "name": "Genesis 28:20",
              "text": "At si Jacob ay nagpanata, na sinasabi, Kung sasaakin ang Dios, at ako'y iingatan sa daang ito na aking nilalakaran, at ako'y bibigyan ng tinapay na makakain, at damit na maisusuot,"
            },
            {
              "chapter": 28,
              "verse": 21,
              "name": "Genesis 28:21",
              "text": "Na ano pa't ako'y makabalik na payapa sa bahay ng aking ama, ay ang Panginoon nga ang magiging aking Dios,"
            },
            {
              "chapter": 28,
              "verse": 22,
              "name": "Genesis 28:22",
              "text": "At ang batong ito na aking itinayo na pinakaalaala ay magiging bahay ng Dios; at sa lahat ng ibigay mo sa akin ay walang pagsalang ang ikasangpung bahagi ay ibibigay ko sa iyo."
            }
          ]
        },
        {
          "chapter": 29,
          "name": "Genesis 29",
          "verses": [
            {
              "chapter": 29,
              "verse": 1,
              "name": "Genesis 29:1",
              "text": "Nang magkagayo'y nagpatuloy si Jacob ng kaniyang paglalakbay, at napasa lupain ng mga anak ng silanganan."
            },
            {
              "chapter": 29,
              "verse": 2,
              "name": "Genesis 29:2",
              "text": "At siya'y tumingin, at nakakita ng isang balon sa parang, at narito, may tatlong kawan ng mga tupa na nagpapahinga sa tabi roon: sapagka't sa balong yaon pinaiinom ang mga kawan: at ang batong nasa ibabaw ng labi ng balon ay malaki."
            },
            {
              "chapter": 29,
              "verse": 3,
              "name": "Genesis 29:3",
              "text": "At doon nagkakatipon ang lahat ng kawan: at kanilang iginugulong ang batong nasa ibabaw ng labi ng balon, at pinaiinom ang mga tupa, at muling inilalagay ang bato sa ibabaw ng labi ng balon, sa dako niyaon."
            },
            {
              "chapter": 29,
              "verse": 4,
              "name": "Genesis 29:4",
              "text": "At sinabi sa kanila ni Jacob, Mga kapatid ko, taga saan kayo? At kanilang sinabi, Taga Haran kami."
            },
            {
              "chapter": 29,
              "verse": 5,
              "name": "Genesis 29:5",
              "text": "At sinabi niya sa kanila, Nakikilala ba ninyo si Laban na anak ni Nachor? At kanilang sinabi, Nakikilala namin siya."
            },
            {
              "chapter": 29,
              "verse": 6,
              "name": "Genesis 29:6",
              "text": "At sinabi niya sa kanila, Siya ba'y mabuti? At, kanilang sinabi, Siya'y mabuti: at, narito, si Raquel na kaniyang anak ay dumarating na dala ang mga tupa."
            },
            {
              "chapter": 29,
              "verse": 7,
              "name": "Genesis 29:7",
              "text": "At sinabi niya, Narito, maaga pa, ni hindi oras tipunin ang mga hayop: painumin ninyo ang mga tupa, at inyo silang pasabsabin."
            },
            {
              "chapter": 29,
              "verse": 8,
              "name": "Genesis 29:8",
              "text": "At kanilang sinabi, Hindi namin magagawa hanggang sa magkatipon ang lahat ng kawan, at igugulong ang bato mula sa labi ng balon; gayon nga aming pinaiinom ang mga tupa."
            },
            {
              "chapter": 29,
              "verse": 9,
              "name": "Genesis 29:9",
              "text": "Samantalang nakikipagusap pa siya sa kanila, ay dumating si Raquel na dala ang mga tupa ng kaniyang ama; sapagka't siya ang nagaalaga ng mga iyon."
            },
            {
              "chapter": 29,
              "verse": 10,
              "name": "Genesis 29:10",
              "text": "At nangyari, nang makita ni Jacob si Raquel na anak ni Laban, na kapatid ng kaniyang ina, at ang mga tupa ni Laban na kapatid ng kaniyang ina, na lumapit si Jacob at iginulong ang bato mula sa labi ng balon, at pinainom ang kawan ni Laban, na kapatid ng kaniyang ina."
            },
            {
              "chapter": 29,
              "verse": 11,
              "name": "Genesis 29:11",
              "text": "At hinagkan ni Jacob si Raquel; at humiyaw ng malakas at umiyak."
            },
            {
              "chapter": 29,
              "verse": 12,
              "name": "Genesis 29:12",
              "text": "At kay Raquel ay sinaysay ni Jacob na siya'y kapatid ni Laban, na kaniyang ama, at anak siya ni Rebeca: at siya'y tumakbo at isinaysay sa kaniyang ama."
            },
            {
              "chapter": 29,
              "verse": 13,
              "name": "Genesis 29:13",
              "text": "At nangyari, nang marinig ni Laban ang mga balita tungkol kay Jacob, na anak ng kaniyang kapatid, ay tumakbo siya na kaniyang sinalubong, at kaniyang niyakap at kaniyang hinagkan, at kaniyang dinala sa kaniyang bahay. At isinaysay ni Jacob kay Laban ang lahat ng mga bagay na ito."
            },
            {
              "chapter": 29,
              "verse": 14,
              "name": "Genesis 29:14",
              "text": "At sinabi sa kaniya ni Laban, Tunay na ikaw ay aking buto at aking laman. At dumoon sa kaniyang isang buwan."
            },
            {
              "chapter": 29,
              "verse": 15,
              "name": "Genesis 29:15",
              "text": "At sinabi ni Laban kay Jacob, Sapagka't ikaw ay aking kapatid ay nararapat ka bang maglingkod sa akin ng walang bayad? sabihin mo sa akin kung ano ang magiging kaupahan mo."
            },
            {
              "chapter": 29,
              "verse": 16,
              "name": "Genesis 29:16",
              "text": "At may dalawang anak na babae si Laban: ang pangalan ng panganay ay Lea, at ang pangalan ng bunso ay Raquel."
            },
            {
              "chapter": 29,
              "verse": 17,
              "name": "Genesis 29:17",
              "text": "At ang mga mata ni Lea ay mapupungay; datapuwa't si Raquel ay maganda at kahalihalina."
            },
            {
              "chapter": 29,
              "verse": 18,
              "name": "Genesis 29:18",
              "text": "At sininta ni Jacob si Raquel; at kaniyang sinabi, Paglilingkuran kitang pitong taon dahil kay Raquel na iyong anak na bunso."
            },
            {
              "chapter": 29,
              "verse": 19,
              "name": "Genesis 29:19",
              "text": "At sinabi ni Laban, Magaling ang ibigay ko siya sa iyo, kay sa ibigay ko sa iba: matira ka sa akin."
