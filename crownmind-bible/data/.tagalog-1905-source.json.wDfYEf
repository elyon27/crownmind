            {
              "chapter": 34,
              "verse": 17,
              "name": "Genesis 34:17",
              "text": "Datapuwa't kung ayaw ninyo kaming pakinggan, na kayo'y mangatuli; ay dadalhin nga namin ang aming anak na babae at kami ay yayaon."
            },
            {
              "chapter": 34,
              "verse": 18,
              "name": "Genesis 34:18",
              "text": "At ang kanilang mga salita ay kinalugdan ni Hamor at ni Sichem, na anak ni Hamor."
