            {
              "chapter": 21,
              "verse": 16,
              "name": "Isaias 21:16",
              "text": "Sapagka't ganito ang sinabi ng Panginoon sa akin, Sa loob ng isang taon, ayon sa mga taon ng magpapaupa, ang lahat ng kaluwalhatian ng Cedar ay mapapawi:"
