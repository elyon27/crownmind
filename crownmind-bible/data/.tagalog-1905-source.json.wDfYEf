          "verses": [
            {
              "chapter": 32,
              "verse": 1,
              "name": "Genesis 32:1",
              "text": "At ipinagpatuloy ni Jacob ang kaniyang paglakad, at sinalubong siya ng mga anghel ng Dios."
            },
            {
              "chapter": 32,
              "verse": 2,
              "name": "Genesis 32:2",
              "text": "At sinabi ni Jacob nang makita niya sila, Ito'y hukbo ng Dios: at tinawag niya ang pangalan ng dakong yaon na Mahanaim."
            },
            {
              "chapter": 32,
              "verse": 3,
              "name": "Genesis 32:3",
              "text": "At si Jacob ay nagpasugo sa unahan niya kay Esau, na kaniyang kapatid sa lupain ng Seir, na parang ng Edom."
            },
            {
              "chapter": 32,
              "verse": 4,
              "name": "Genesis 32:4",
              "text": "At inutusan niya sila, na sinasabi, Ganito ninyo sabihin sa aking panginoong kay Esau, Ganito ang sabi ng iyong lingkod na si Jacob, Dumoon ako kay Laban at ako'y natira roon hanggang ngayon."
            },
            {
              "chapter": 32,
              "verse": 5,
              "name": "Genesis 32:5",
              "text": "At mayroon akong mga baka, at mga asno, at mga kawan, at mga aliping lalake at babae: at ako'y nagpasugo upang magbigay alam sa aking panginoon, upang makasumpong ng biyaya sa iyong paningin."
            },
            {
              "chapter": 32,
              "verse": 6,
              "name": "Genesis 32:6",
              "text": "At ang mga sugo ay nagsipagbalik kay Jacob, na nagsipagsabi, Dumating kami sa iyong kapatid na kay Esau, at siya rin naman ay sumasalubong sa iyo, at apat na raang tao ang kasama niya."
            },
            {
              "chapter": 32,
              "verse": 7,
              "name": "Genesis 32:7",
              "text": "Nang magkagayo'y natakot na mainam si Jacob at nahapis at kaniyang binahagi ang bayang kasama niya, at ang mga kawan, at ang mga bakahan, at ang mga kamelyo ng dalawang pulutong."
            },
            {
              "chapter": 32,
              "verse": 8,
              "name": "Genesis 32:8",
              "text": "At kaniyang sinabi, Kung dumating si Esau sa isang pulutong, at kaniyang saktan, ang pulutong ngang natitira ay tatanan."
            },
            {
              "chapter": 32,
              "verse": 9,
              "name": "Genesis 32:9",
              "text": "At sinabi ni Jacob, Oh Dios ng aking amang si Abraham, at Dios ng aking amang si Isaac, Oh Panginoon, na nagsabi sa akin, Magbalik ka sa iyong lupain at sa iyong kamaganakan, at gagawan kita ng magaling:"
            },
            {
              "chapter": 32,
              "verse": 10,
              "name": "Genesis 32:10",
              "text": "Hindi ako marapat sa kababababaan ng lahat ng kaawaan, at ng buong katotohanan na iyong ipinakita sa iyong lingkod: sapagka't dala ko ang aking tungkod, na dinaanan ko ang Jordang ito; at ngayo'y naging dalawang pulutong ako."
            },
            {
              "chapter": 32,
              "verse": 11,
              "name": "Genesis 32:11",
              "text": "Iligtas mo ako, ipinamamanhik ko sa iyo, sa kamay ng aking kapatid, sa kamay ni Esau; sapagka't ako'y natatakot sa kaniya, baka siya'y dumating at ako'y saktan niya, ang ina pati ng mga anak."
            },
            {
              "chapter": 32,
              "verse": 12,
              "name": "Genesis 32:12",
              "text": "At ikaw ang nagsabi, Tunay na ikaw ay gagawan ko ng magaling, at gagawin ko ang iyong binhi na parang buhangin sa dagat, na hindi mabibilang dahil sa karamihan."
            },
            {
              "chapter": 32,
              "verse": 13,
              "name": "Genesis 32:13",
              "text": "At siya'y nagparaan doon ng gabing yaon; at kumuha ng mayroon siya na ipagkakaloob kay Esau na kaniyang kapatid;"
            },
            {
              "chapter": 32,
              "verse": 14,
              "name": "Genesis 32:14",
              "text": "Dalawang daang kambing na babae, at dalawang pung lalaking kambing; dalawang daang tupang babae, at dalawang pung tupang lalake,"
            },
            {
              "chapter": 32,
              "verse": 15,
              "name": "Genesis 32:15",
              "text": "Tatlong pung kamelyong inahin na pati ng kanilang mga anak; apat na pung baka at sangpung toro, dalawang pung asna at sangpung anak ng mga yaon."
            },
            {
              "chapter": 32,
              "verse": 16,
              "name": "Genesis 32:16",
              "text": "At ipinagbibigay sa kamay ng kaniyang mga bataan, bawa't kawan ay bukod; at sinabi sa kaniyang mga bataan, Lumagpas kayo sa unahan ko, at iiwanan ninyo ng isang pagitan ang bawa't kawan."
            },
            {
              "chapter": 32,
              "verse": 17,
              "name": "Genesis 32:17",
              "text": "At iniutos sa una, na sinasabi, Pagka ikaw ay nasumpungan ni Esau na aking kapatid, at ikaw ay tinanong na sinasabi, Kanino ka? at saan ka paroroon? at kanino itong nangasa unahan mo."
            },
            {
              "chapter": 32,
              "verse": 18,
              "name": "Genesis 32:18",
              "text": "Kung magkagayo'y sasabihin mo, Sa iyong lingkod na kay Jacob; isang kaloob nga, na padala sa aking panginoong kay Esau: at, narito, siya'y nasa hulihan din naman namin."
            },
            {
              "chapter": 32,
              "verse": 19,
              "name": "Genesis 32:19",
              "text": "At iniutos din sa ikalawa, at sa ikatlo, at sa lahat ng sumusunod sa mga kawan, na sinasabi, Sa ganitong paraan sasalitain ninyo kay Esau, pagkasumpong ninyo sa kaniya;"
            },
            {
              "chapter": 32,
              "verse": 20,
              "name": "Genesis 32:20",
              "text": "At sasabihin ninyo, Saka, narito, ang iyong lingkod na si Jacob, ay nasa hulihan namin, sapagka't kaniyang sinabi, Paglulubagin ko ang kaniyang galit sa pamamagitan ng kaloob na sumasaunahan ko, at pagkatapos ay makikita ko ang kaniyang mukha; marahil ay tatanggapin niya ako."
            },
            {
              "chapter": 32,
              "verse": 21,
              "name": "Genesis 32:21",
              "text": "Gayon isinaunahan niya ang mga kaloob; at siya'y natira ng gabing yaon sa pulutong."
            },
            {
              "chapter": 32,
              "verse": 22,
              "name": "Genesis 32:22",
              "text": "At siya'y bumangon ng gabing yaon, at isinama niya ang kaniyang dalawang asawa, at ang kaniyang dalawang alilang babae, at ang kaniyang labing isang anak at tumawid sa tawiran ng Jaboc."
            },
            {
              "chapter": 32,
              "verse": 23,
              "name": "Genesis 32:23",
              "text": "At sila'y kaniyang isinama at itinawid sa batis, at kaniyang itinawid ang kaniyang tinatangkilik."
            },
            {
              "chapter": 32,
              "verse": 24,
              "name": "Genesis 32:24",
              "text": "At naiwang magisa si Jacob: at nakipagbuno ang isang lalake sa kaniya, hanggang sa magbukang liwayway."
            },
            {
              "chapter": 32,
              "verse": 25,
              "name": "Genesis 32:25",
              "text": "At nang makita nitong siya'y hindi manaig sa kaniya ay hinipo ang kasukasuan ng hita niya; at ang kasukasuan ni Jacob ay sinaktan samantalang nakikipagbuno sa kaniya."
            },
            {
              "chapter": 32,
              "verse": 26,
              "name": "Genesis 32:26",
              "text": "At sinabi, Bitawan mo ako, sapagka't nagbubukang liwayway na. At kaniyang sinabi, Hindi kita bibitawan hanggang hindi mo ako mabasbasan."
            },
            {
              "chapter": 32,
              "verse": 27,
              "name": "Genesis 32:27",
              "text": "At sinabi niya sa kaniya, Ano ang pangalan mo? At kaniyang sinabi, Jacob."
            },
            {
              "chapter": 32,
              "verse": 28,
              "name": "Genesis 32:28",
              "text": "At sinabi niya, Hindi na tatawaging Jacob ang iyong pangalan, kundi Israel; sapagka't ikaw ay nakipagpunyagi sa Dios at sa mga tao, at ikaw ay nanaig."
            },
            {
              "chapter": 32,
              "verse": 29,
              "name": "Genesis 32:29",
              "text": "At siya'y tinanong ni Jacob, at sinabi, Ipinamamanhik ko sa iyong sabihin mo sa akin ang iyong pangalan. At kaniyang sinabi, Bakit nagtatanong ka ng aking pangalan? At siya'y binasbasan doon."
            },
            {
              "chapter": 32,
              "verse": 30,
              "name": "Genesis 32:30",
              "text": "At tinawag ni Jacob ang pangalan ng dakong yaon na Peniel; sapagka't aniya'y nakita ko ang Dios ng mukhaan, at naligtas ang aking buhay."
            },
            {
              "chapter": 32,
              "verse": 31,
              "name": "Genesis 32:31",
              "text": "At sinikatan siya ng araw ng siya'y nagdadaan sa Penuel; at siya'y napipilay sa hita niya."
