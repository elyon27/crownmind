        {
          "chapter": 49,
          "name": "Genesis 49",
          "verses": [
            {
              "chapter": 49,
              "verse": 1,
              "name": "Genesis 49:1",
              "text": "At tinawag ni Jacob ang kaniyang mga anak, at sinabi, Magpipisan kayo, upang maisaysay ko sa inyo ang mangyayari sa inyo sa mga huling araw."
            },
            {
              "chapter": 49,
              "verse": 2,
              "name": "Genesis 49:2",
              "text": "Magpipisan kayo at kayo'y makinig, kayong mga anak ni Jacob; At inyong pakinggan si Israel na inyong ama."
            },
            {
              "chapter": 49,
              "verse": 3,
              "name": "Genesis 49:3",
              "text": "Ruben, ikaw ang aking panganay, ang aking kapangyarihan, at siyang pasimula ng aking kalakasan; Siyang kasakdalan ng kamahalan, at siyang kasakdalan ng kapangyarihan."
            },
            {
              "chapter": 49,
              "verse": 4,
              "name": "Genesis 49:4",
              "text": "Kumukulong parang tubig na umaawas, hindi ka magtataglay ng kasakdalan, Sapagka't, sumampa ka sa higaan ng iyong ama: Hinamak mo nga; sumampa sa aking higaan."
            },
            {
              "chapter": 49,
              "verse": 5,
              "name": "Genesis 49:5",
              "text": "Si Simeon at si Levi ay magkapatid; Mga almas na marahas ang kanilang mga tabak."
