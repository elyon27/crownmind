            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "2 Mga Cronica 17:13",
              "text": "At siya'y nagkaroon ng maraming mga gawain sa mga bayan ng Juda; at ng mga lalaking mangdidigma, na mga makapangyarihang lalaking matatapang, sa Jerusalem."
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "2 Mga Cronica 17:14",
