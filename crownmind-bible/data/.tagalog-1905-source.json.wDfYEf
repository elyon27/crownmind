            {
              "chapter": 24,
              "verse": 4,
              "name": "2 Mga Hari 24:4",
              "text": "At dahil naman sa walang salang dugo na kaniyang ibinubo; sapagka't kaniyang pinuno ang Jerusalem ng walang salang dugo: at hindi pinatawad ng Panginoon."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "2 Mga Hari 24:5",
