            {
              "chapter": 5,
              "verse": 12,
              "name": "Awit ni Solomon 5:12",
              "text": "Ang kaniyang mga mata ay gaya ng mga kalapati sa siping ng mga batis ng tubig; na hinugasan ng gatas at bagay ang pagkalagay."
