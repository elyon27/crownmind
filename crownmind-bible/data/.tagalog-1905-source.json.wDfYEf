            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "2 Mga Hari 17:8",
              "text": "At lumakad sa mga palatuntunan ng mga bansa, na pinalayas ng Panginoon sa harap ng mga anak ni Israel, at ng mga hari ng Israel, na kanilang ginawa."
