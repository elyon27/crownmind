            },
            {
              "chapter": 21,
              "verse": 18,
              "name": "Genesis 21:18",
              "text": "Magtindig ka, iyong itayo ang bata, at alalayan mo siya ng iyong kamay; sapagka't siya'y gagawin kong isang bansang malaki."
            },
