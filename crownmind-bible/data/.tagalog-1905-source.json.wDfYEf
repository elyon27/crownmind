          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Nehemias 9:1",
              "text": "Nang ikadalawang pu't apat na araw nga ng buwang ito ay nagpupulong ang mga anak ni Israel na may pagaayuno, at may pananamit na magaspang, at may lupa sa ulo nila."
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Nehemias 9:2",
              "text": "At ang binhi ni Israel ay nagsihiwalay sa lahat na taga ibang bayan, at nagsitayo at nangagpahayag ng kanilang mga kasalanan, at ng mga kasamaan ng kanilang mga magulang."
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Nehemias 9:3",
