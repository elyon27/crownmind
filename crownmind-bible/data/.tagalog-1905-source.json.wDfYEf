          "name": "Josue 21",
          "verses": [
            {
              "chapter": 21,
              "verse": 1,
              "name": "Josue 21:1",
              "text": "Nang magkagayo'y lumapit ang mga pangulo ng mga sangbahayan ng mga magulang ng mga Levita kay Eleazar na saserdote, at kay Josue na anak ni Nun at sa mga pangulo ng mga sangbahayan ng mga magulang ng mga lipi ng mga anak ni Israel;"
            },
            {
              "chapter": 21,
              "verse": 2,
              "name": "Josue 21:2",
              "text": "At sila'y nagsalita sa kanila sa Silo, sa lupain ng Canaan, na sinasabi, Ang Panginoon ay nagutos sa pamamagitan ni Moises, na bigyan kami ng mga bayan na matatahanan, pati ng mga nayon niyaon para sa aming hayop."
            },
            {
              "chapter": 21,
              "verse": 3,
              "name": "Josue 21:3",
