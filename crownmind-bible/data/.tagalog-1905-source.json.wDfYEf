            {
              "chapter": 31,
              "verse": 25,
              "name": "Genesis 31:25",
              "text": "At inabutan ni Laban si Jacob, At naitirik na ni Jacob ang kaniyang tolda sa bundok; at si Laban sangpu ng kaniyang mga kapatid ay nagtirik din sa bundok ng Gilead."
            },
            {
              "chapter": 31,
              "verse": 26,
              "name": "Genesis 31:26",
              "text": "At sinabi ni Laban kay Jacob, Anong ginawa mo na tumanan ka ng di ko nalalaman, at dinala mo ang aking mga anak na parang mangabihag sa tabak?"
            },
            {
              "chapter": 31,
              "verse": 27,
              "name": "Genesis 31:27",
              "text": "Bakit ka tumakas ng lihim, at tumanan ka sa akin; at hindi mo ipinaalam sa akin, upang ikaw ay napagpaalam kong may sayahan at may awitan, may tambol at may alpa;"
