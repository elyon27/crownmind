            {
              "chapter": 52,
              "verse": 2,
              "name": "Isaias 52:2",
              "text": "Magpagpag ka ng alabok; ikaw ay bumangon, umupo ka sa iyong luklukan, Oh Jerusalem: magkalag ka ng mga tali ng iyong leeg, Oh bihag na anak na babae ng Sion."
            },
            {
              "chapter": 52,
              "verse": 3,
              "name": "Isaias 52:3",
              "text": "Sapagka't ganito ang sabi ng Panginoon, Kayo'y naipagbili sa wala; at kayo'y matutubos ng walang salapi."
