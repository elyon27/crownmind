    {
      "nr": 22,
      "name": "Awit ni Solomon",
      "chapters": [
        {
          "chapter": 1,
          "name": "Awit ni Solomon 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Awit ni Solomon 1:1",
              "text": "Ang awit ng mga awit, na kay Salomon."
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Awit ni Solomon 1:2",
              "text": "Hagkan niya ako ng mga halik ng kaniyang bibig: sapagka't ang iyong pagsinta ay maigi kay sa alak."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Awit ni Solomon 1:3",
              "text": "Ang iyong mga langis ay may masarap na amoy; ang iyong pangalan ay gaya ng langis na ibinuhos; kaya't sinisinta ka ng mga dalaga."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Awit ni Solomon 1:4",
              "text": "Batakin mo ako, tatakbo kaming kasunod mo: Ipinasok ako ng hari sa kaniyang mga silid: kami ay matutuwa at magagalak sa iyo. Aming babanggitin ang iyong pagsinta ng higit kay sa alak: matuwid ang pagsinta nila sa iyo."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Awit ni Solomon 1:5",
              "text": "Ako'y maitim, nguni't kahalihalina, Oh kayong mga anak na babae ng Jerusalem, gaya ng mga tolda sa Cedar, gaya ng mga tabing ni Salomon."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Awit ni Solomon 1:6",
              "text": "Huwag ninyo akong masdan dahil sa ako'y kayumanggi, sapagka't sinunog ako ng araw. Ang mga anak ng aking ina ay nagalit laban sa akin, kanilang ginawa akong tagapagingat ng mga ubasan; nguni't ang sarili kong ubasan ay hindi ko iningatan."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Awit ni Solomon 1:7",
              "text": "Saysayin mo sa akin, ikaw na sinisinta ng aking kaluluwa, kung saan mo pinapastulan ang iyong kawan, kung saan mo pinagpapahinga sa katanghaliang tapat: sapagka't bakit ako'y magiging gaya ng nalalambungan sa siping ng mga kawan ng iyong mga kasama?"
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Awit ni Solomon 1:8",
              "text": "Kung hindi mo nalalaman, Oh ikaw na pinakamaganda sa mga babae, yumaon kang sumunod sa mga bakas ng kawan, at pastulan mo ang iyong mga anak ng kambing sa siping ng mga tolda ng mga pastor."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Awit ni Solomon 1:9",
              "text": "Aking itinulad ka, Oh aking sinta, sa isang kabayo sa mga karo ni Faraon."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Awit ni Solomon 1:10",
              "text": "Pinagaganda ang iyong mga pisngi ng mga tirintas ng buhok, ang iyong leeg ng mga kuwintas na hiyas."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Awit ni Solomon 1:11",
              "text": "Igagawa ka namin ng mga kuwintas na ginto na may mga kabit na pilak."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Awit ni Solomon 1:12",
              "text": "Samantalang ang hari ay nauupo sa kaniyang dulang, ang aking nardo ay humahalimuyak ng kaniyang bango."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Awit ni Solomon 1:13",
              "text": "Ang aking sinta ay gaya ng bigkis ng mira sa akin, na humihilig sa pagitan ng aking mga suso."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Awit ni Solomon 1:14",
              "text": "Ang sinta ko ay gaya ng kumpol ng bulaklak ng alhena sa akin sa mga ubasan ng En-gadi."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Awit ni Solomon 1:15",
              "text": "Narito, ikaw ay maganda, sinta ko, narito, ikaw ay maganda; ang iyong mga mata ay gaya ng mga kalapati."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Awit ni Solomon 1:16",
              "text": "Narito, ikaw ay maganda sinisinta ko, oo, maligaya: ang ating higaan naman ay lungtian."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Awit ni Solomon 1:17",
              "text": "Ang mga kilo ng ating bahay ay mga sedro, at ang kaniyang mga bubong ay mga sipres."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Awit ni Solomon 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Awit ni Solomon 2:1",
              "text": "Ako'y rosa ng Saron, lila ng mga libis."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Awit ni Solomon 2:2",
              "text": "Kung paano ang lila sa gitna ng mga tinik, gayon ang aking pagsinta sa mga dalaga."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Awit ni Solomon 2:3",
              "text": "Kung paano ang puno ng mansanas sa gitna ng mga punong kahoy sa gubat, gayon ang aking sinta sa gitna ng mga anak na lalake. Ako'y nauupo sa ilalim ng kaniyang lilim na may malaking kaluguran. At ang kaniyang bunga ay naging matamis sa aking lasa."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Awit ni Solomon 2:4",
              "text": "Dinala niya sa bahay na may pigingan, at ang kaniyang watawat sa akin ay pagsinta."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Awit ni Solomon 2:5",
              "text": "Kandilihin ninyo ako ng mga pasas, aliwin ninyo ako ng mga mansanas: sapagka't ako'y may sakit na pagsinta."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Awit ni Solomon 2:6",
              "text": "Ang kaniyang kaliwang kamay ay nasa ilalim ng aking ulo, at ang kaniyang kanang kamay ay yumayakap sa akin."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Awit ni Solomon 2:7",
              "text": "Pinagbibilinan ko kayo, Oh mga anak na babae ng Jerusalem, alangalang sa mga usang lalake at babae sa parang, na huwag ninyong pukawin, o gisingin man ang aking pagsinta, hanggang sa ibigin niya."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Awit ni Solomon 2:8",
              "text": "Ang tinig ng aking sinta! narito, siya'y dumarating, na lumulukso sa mga bundok, lumulundag sa mga burol."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Awit ni Solomon 2:9",
              "text": "Ang aking sinta ay gaya ng usa o ng batang usa: narito, siya'y tumatayo sa likod ng ating bakod, siya'y sumusungaw sa mga dungawan, siya'y napakikita sa mga silahia."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Awit ni Solomon 2:10",
              "text": "Ang aking sinta ay nagsalita, at nagsabi sa akin, Bumangon ka, sinta ko, maganda ko, at tayo na."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Awit ni Solomon 2:11",
              "text": "Sapagka't narito, ang tagginaw ay nakaraan; ang ulan ay lumagpas at wala na;"
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Awit ni Solomon 2:12",
              "text": "Ang mga bulaklak ay namumukadkad sa lupa; ang panahon ng pagaawitan ng mga ibon ay dumarating, at ang tinig ng batobato ay naririnig sa ating lupain;"
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Awit ni Solomon 2:13",
              "text": "Nahihinog ang sariwang mga bunga ng puno ng higos, at ang mga puno ng ubas ay namumulaklak, kanilang pinahahalimuyak ang kanilang bango. Bumangon ka, sinta ko, maganda ko, at tayo na."
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Awit ni Solomon 2:14",
              "text": "Oh kalapati ko, na nasa mga bitak ng malalaking bato, sa puwang ng matarik na dako, ipakita mo sa akin ang iyong mukha, iparinig mo sa akin ang iyong tinig; Sapagka't matamis ang iyong tinig, at ang iyong mukha ay kahalihalina."
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Awit ni Solomon 2:15",
              "text": "Hulihin ninyo para sa atin ang mga sora, ang mga munting sora na naninira ng mga ubasan; sapagka't ang ating mga ubasan ay namumulaklak."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Awit ni Solomon 2:16",
              "text": "Ang sinta ko ay akin, at ako ay kaniya: pinapastulan niya ang kaniyang kawan sa gitna ng mga lila."
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Awit ni Solomon 2:17",
              "text": "Hanggang sa ang araw ay lumamig, at ang mga lilim ay mawala, pumihit ka, sinta ko, at ikaw ay maging gaya ng usa o ng batang usa sa mga bundok ng Bether."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Awit ni Solomon 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Awit ni Solomon 3:1",
              "text": "Sa kinagabihan sa aking higaan, ay hinahanap ko siya na sinisinta ng aking kaluluwa: aking hinanap siya, nguni't hindi ko siya nasumpungan."
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Awit ni Solomon 3:2",
              "text": "Aking sinabi, ako'y babangon at liligid sa bayan, sa mga lansangan at sa mga maluwang na daan, aking hahanapin siya na sinisinta ng aking kaluluwa: aking hinanap siya, nguni't hindi ko siya nasumpungan."
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Awit ni Solomon 3:3",
              "text": "Ang mga bantay na nagsisilibot sa bayan ay nasumpungan ako: na siya kong pinagsabihan, nakita baga ninyo siya na sinisinta ng aking kaluluwa?"
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Awit ni Solomon 3:4",
              "text": "Kaunti lamang ang inilagpas ko sa kanila. Nang masumpungan ko siya na sinisinta ng aking kaluluwa: pinigilan ko siya, at hindi ko binayaang umalis, hanggang sa siya'y aking nadala sa bahay ng aking ina, at sa silid niya na naglihi sa akin."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Awit ni Solomon 3:5",
              "text": "Pinagbibilinan ko kayo, Oh mga anak na babae ng Jerusalem, alangalang sa mga usang lalake at babae sa parang, na huwag ninyong pukawin o gisingin man ang aking sinta, hanggang sa ibigin niya."
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Awit ni Solomon 3:6",
              "text": "Sino itong umaahong mula sa ilang na gaya ng mga haliging usok, na napapabanguhan ng mira at ng kamangyan, ng lahat na blanquete ng mangangalakal?"
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Awit ni Solomon 3:7",
              "text": "Narito, ito ang arag-arag ni Salomon; anim na pung makapangyarihang lalake ay nangasa palibot nito, sa mga makapangyarihang lalake ng Israel."
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Awit ni Solomon 3:8",
              "text": "Silang lahat ay nagsisihawak ng tabak, at bihasa sa pakikidigma: bawa't isa'y may tabak sa kaniyang pigi, dahil sa takot kung gabi."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Awit ni Solomon 3:9",
              "text": "Ang haring Salomon ay gumawa para sa kaniya ng palankin na kahoy sa Libano,"
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Awit ni Solomon 3:10",
              "text": "Ginawa niya ang mga haligi niyaon na pilak, ang pinakailalim niyaon ay ginto, at ang upuan ay kulay ube, ang gitna niyaon ay nalalatagan ng pagsinta, na mula sa mga anak na babae ng Jerusalem."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Awit ni Solomon 3:11",
              "text": "Magsilabas kayo, Oh kayong mga anak na babae ng Sion, at inyong masdan ang haring Salomon, na may putong na ipinutong sa kaniya ng kaniyang ina, sa kaarawan ng kaniyang pagaasawa, at sa kaarawan ng kasayahan ng kaniyang puso."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Awit ni Solomon 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Awit ni Solomon 4:1",
              "text": "Narito, ikaw ay maganda, sinta ko; narito, ikaw ay maganda; ang iyong mga mata ay gaya ng mga kalapati sa likod ng iyong lambong: ang iyong buhok ay gaya ng kawan ng mga kambing, na nagpapahinga sa gulod ng bundok ng Galaad."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Awit ni Solomon 4:2",
              "text": "Ang iyong mga ngipin ay gaya ng mga kawan ng mga tupa na bagong gupit, na nagsiahong mula sa pagpaligo, na bawa't isa'y may anak na kambal, at walang baog sa kanila."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Awit ni Solomon 4:3",
              "text": "Ang iyong mga labi ay gaya ng pising mapula, at ang iyong bibig ay kahalihalina: ang iyong mga pisngi ay gaya ng putol ng granada. Sa likod ng iyong lambong."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Awit ni Solomon 4:4",
              "text": "Ang iyong leeg ay gaya ng moog ni David na itinayo na pinaka sakbatan, na kinabibitinan ng libong kalasag, ng lahat na kalasag ng mga makapangyarihang lalake."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Awit ni Solomon 4:5",
              "text": "Ang iyong dalawang suso ay gaya ng dalawang batang usa na mga kambal ng isang inahin, na nagsisisabsab sa gitna ng mga lila."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Awit ni Solomon 4:6",
              "text": "Hanggang sa ang araw ay lumamig at ang mga lilim ay tumakas, ako'y paroroon sa bundok ng mira, at sa burol ng kamangyan."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Awit ni Solomon 4:7",
              "text": "Ikaw ay totoong maganda, sinta ko; at walang kapintasan sa iyo."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Awit ni Solomon 4:8",
              "text": "Sumama ka sa akin mula sa Libano, kasintahan ko, na kasama ko mula sa Libano: tumanaw ka mula sa taluktok ng Amana, mula sa taluktok ng Senir at ng Hermon, mula sa mga yungib ng mga leon, mula sa mga bundok ng mga leopardo."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Awit ni Solomon 4:9",
              "text": "Inagaw mo ang aking puso, kapatid ko, kasintahan ko, iyong inagaw ang aking puso ng isang sulyap ng iyong mga mata, ng isang kuwintas ng iyong leeg."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Awit ni Solomon 4:10",
              "text": "Pagkaganda ng iyong pagsinta, kapatid ko, kasintahan ko! Pagkaigi ng iyong pagsinta kay sa alak! At ang amoy ng iyong mga langis kay sa lahat na sari-saring pabango!"
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Awit ni Solomon 4:11",
              "text": "Ang iyong mga labi, Oh kasintahan ko, na nagsisitulo na gaya ng pulot-pukyutan: pulot at gatas ay nasa ilalim ng iyong dila; at ang amoy ng iyong mga suot ay gaya ng amoy ng Libano."
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Awit ni Solomon 4:12",
              "text": "Halamanang nababakuran ang kapatid ko, ang kasintahan ko; bukal na nababakuran, balon na natatakpan."
