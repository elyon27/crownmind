            {
              "chapter": 39,
              "verse": 9,
              "name": "Genesis 39:9",
              "text": "Walang sinomang dakila kay sa akin sa bahay na ito; walang ipinagkait sa aking anomang bagay, kung di ikaw lamang, sapagka't ikaw ay kaniyang asawa: paano ngang aking magagawa itong malaking kasamaan, at kasalanan laban sa Dios?"
            },
            {
              "chapter": 39,
              "verse": 10,
              "name": "Genesis 39:10",
              "text": "At nangyari, na nakikiusap man siya kay Jose araw-araw, ay hindi nakikinig sa kaniya na siya'y sipingan, o pakisamahan."
            },
            {
              "chapter": 39,
              "verse": 11,
              "name": "Genesis 39:11",
              "text": "At nangyari nang panahong ito, na siya'y pumasok sa bahay upang gawin niya ang kaniyang gawain at wala sinoman sa mga tao sa bahay doon sa loob."
            },
            {
              "chapter": 39,
              "verse": 12,
              "name": "Genesis 39:12",
              "text": "At siya'y pinigilan niya sa kaniyang suot, na sinasabi, Sipingan mo ako: at iniwan niya ang kaniyang suot sa kamay niya at tumakas, at lumabas."
            },
            {
              "chapter": 39,
              "verse": 13,
              "name": "Genesis 39:13",
              "text": "At nangyari, na pagkakita niyang iniwan ang kaniyang suot sa kamay niya, at tumakas sa labas,"
            },
            {
              "chapter": 39,
              "verse": 14,
              "name": "Genesis 39:14",
              "text": "Na siya'y tumawag ng mga tao sa kaniyang bahay, at sinalita sa kanila, na sinasabi, Tingnan ninyo, na dinalhan niya tayo ng isang Hebreo, upang tayo'y tuyain; pinasok niya ako upang ako'y sipingan, at ako'y naghihiyaw ng malakas:"
            },
            {
              "chapter": 39,
              "verse": 15,
              "name": "Genesis 39:15",
              "text": "At nangyari nang marinig niyang ako'y nagtaas ng tinig at naghihiyaw, na iniwan ang kaniyang suot sa aking siping, at tumakas, at lumabas."
            },
            {
              "chapter": 39,
              "verse": 16,
              "name": "Genesis 39:16",
              "text": "At kaniyang iningatan ang suot niya sa kaniyang siping, hanggang sa umuwi ang kaniyang panginoon sa kaniyang bahay."
            },
            {
              "chapter": 39,
              "verse": 17,
              "name": "Genesis 39:17",
              "text": "At sinalita niya sa kaniya ng ayon sa mga salitang ito, na sinasabi, Pinasok ako ng aliping Hebreo na iyong dinala sa atin, upang tuyain ako:"
            },
            {
              "chapter": 39,
              "verse": 18,
              "name": "Genesis 39:18",
              "text": "At nangyari, na sapagka't nagtaas ako ng aking tinig at ako'y naghihiyaw, ay kaniyang iniwan ang suot niya sa aking siping, at tumakas sa labas."
            },
            {
              "chapter": 39,
              "verse": 19,
              "name": "Genesis 39:19",
              "text": "At nangyari, na pagkarinig ng kaniyang panginoon ng mga salita na sinalita sa kaniya ng kaniyang asawa, na sinasabi, Ganitong paraan ang ginawa sa akin ng iyong alipin; ay nagalab ang kaniyang galit."
