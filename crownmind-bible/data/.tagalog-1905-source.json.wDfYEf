            {
              "chapter": 22,
              "verse": 23,
              "name": "Isaias 22:23",
              "text": "At aking ikakapit siya na parang pako sa isang matibay na dako; at siya'y magiging pinakaluklukan ng kaluwalhatian sa sangbahayan ng kaniyang magulang."
            },
            {
              "chapter": 22,
              "verse": 24,
              "name": "Isaias 22:24",
              "text": "At kanilang ipagkakaloob sa kaniya ang buong kaluwalhatian ng sangbahayan ng kaniyang magulang, ang mga anak at ang angkan, bawa't sisidlan, mula sa mga munting sisidlan hanggang sa mga malalaking sisidlan."
            },
            {
              "chapter": 22,
              "verse": 25,
              "name": "Isaias 22:25",
              "text": "Sa araw na yaon, sabi ng Panginoon ng mga hukbo, matatanggal ang pakong nakapit sa matibay na dako; at mababalikwat, at mahuhulog, at ang mga sabit niyaon ay malalaglag; sapagka't sinalita ng Panginoon."
            }
          ]
        },
        {
          "chapter": 23,
          "name": "Isaias 23",
          "verses": [
            {
              "chapter": 23,
              "verse": 1,
              "name": "Isaias 23:1",
              "text": "Ang hula tungkol sa Tiro. Magsiangal kayo, kayong mga sasakyang dagat ng Tarsis; sapagka't nasira, na anopa't walang bahay, walang pasukan: mula sa lupain ng Chittim ay nahayag sa kanila."
            },
            {
              "chapter": 23,
              "verse": 2,
              "name": "Isaias 23:2",
              "text": "Magsitahimik kayo, kayong mga nananahan sa baybayin; ikaw na pinasagana ng mga mangangalakal ng Sidon, na nagdaraan sa dagat."
            },
            {
              "chapter": 23,
              "verse": 3,
              "name": "Isaias 23:3",
              "text": "At nasa baybayin ng malawak na tubig ang binhi ng Sihor, ang ani ng Nilo, naging kaniyang pakinabang; at siya'y naging pamilihan ng mga bansa."
            },
            {
              "chapter": 23,
              "verse": 4,
              "name": "Isaias 23:4",
              "text": "Mahiya ka, O Sidon: sapagka't sinalita ng dagat, ng tanggulan ng dagat, na sinasabi, hindi ako nagdamdam, o nanganak man, o nagalaga man ako ng mga binata, o nagpalaki ng mga dalaga."
            },
            {
              "chapter": 23,
              "verse": 5,
              "name": "Isaias 23:5",
              "text": "Pagka ang balita ay dumating sa Egipto, ay mamamanglaw silang mainam sa balita tungkol sa Tiro."
            },
            {
              "chapter": 23,
              "verse": 6,
              "name": "Isaias 23:6",
              "text": "Mangagpatuloy kayo sa Tarsis: magsiangal kayo, kayong mga nananahan sa baybayin."
            },
            {
              "chapter": 23,
              "verse": 7,
              "name": "Isaias 23:7",
              "text": "Ito baga ang inyong masayang bayan, na matanda na mula pa noong unang araw, na dinadala ng kaniyang mga paa sa malayo upang mangibang bayan?"
            },
            {
              "chapter": 23,
              "verse": 8,
              "name": "Isaias 23:8",
              "text": "Sinong nagpanukala nito laban sa Tiro na siyang bayang nagpuputong, na ang mga manininda ay mga pangulo, na ang mga mangangalakal ay mararangal sa lupa."
            },
            {
              "chapter": 23,
              "verse": 9,
              "name": "Isaias 23:9",
              "text": "Pinanukala ng Panginoon ng mga hukbo, upang hamakin ang kapalaluan ng buong kaluwalhatian, upang hiyain ang lahat na mararangal sa lupa?"
            },
            {
              "chapter": 23,
              "verse": 10,
              "name": "Isaias 23:10",
              "text": "Magdaan ka sa iyong lupain na gaya ng Nilo, Oh anak na babae ng Tarsis; wala ka ng lakas."
            },
            {
              "chapter": 23,
              "verse": 11,
              "name": "Isaias 23:11",
              "text": "Kaniyang iniunat ang kaniyang kamay sa dagat, kaniyang niyanig ang mga kaharian: ang Panginoon ay nagutos tungkol sa Canaan, upang gibain ang mga kuta niyaon."
            },
            {
              "chapter": 23,
              "verse": 12,
              "name": "Isaias 23:12",
              "text": "At kaniyang sinabi, Ikaw ay hindi na magagalak pa, Oh ikaw na aping dalaga ng Sidon; bumangon ka, magdaan ka sa Chittim: doon ma'y hindi ka magkakaroon ng kapahingahan."
            },
            {
              "chapter": 23,
              "verse": 13,
              "name": "Isaias 23:13",
              "text": "Tingnan mo ang lupain ng mga Caldeo; ang bayang ito ay wala na; inilaan ng taga Asiria para sa mga hayop sa ilang; kanilang itinayo ang kanilang mga moog; iginiba nila ang mga palacio niyaon: kaniyang pinapaging isang guho."
            },
            {
              "chapter": 23,
              "verse": 14,
              "name": "Isaias 23:14",
              "text": "Magsiangal kayo, kayong mga sasakyang dagat ng Tarsis: sapagka't ang inyong tanggulan ay giba."
            },
            {
              "chapter": 23,
              "verse": 15,
              "name": "Isaias 23:15",
              "text": "At mangyayari, sa araw na yaon na ang Tiro ay malilimutang pitong pung taon, ayon sa mga kaarawan ng isang hari: pagkatapos ng pitong pung taon ay mangyayari sa Tiro ang gaya sa awit ng patutot."
            },
            {
              "chapter": 23,
              "verse": 16,
              "name": "Isaias 23:16",
              "text": "Ikaw ay humawak ng alpa, lumibot ka sa bayan, ikaw na patutot na nalimutan; magpainam ka ng tinig, umawit ka ng maraming awit, upang ikaw ay maalaala."
            },
            {
              "chapter": 23,
              "verse": 17,
              "name": "Isaias 23:17",
              "text": "At mangyayari, sa katapusan ng pitong pung taon, na dadalawin ng Panginoon ang Tiro, at pagbabalikan niya ang kaniyang upa, at magiging patutot sa lahat ng kaharian ng sanglibutan sa ibabaw ng lupa."
            },
            {
              "chapter": 23,
              "verse": 18,
              "name": "Isaias 23:18",
              "text": "At ang kaniyang kalakal at ang upa sa kaniya ay itatalaga sa Panginoon: hindi itatago o isisimpan man, sapagka't ang kaniyang kalakal ay magiging sa ganang kanila na nagsisitahan sa harap ng Panginoon, upang magsikaing may kabusugan, at manamit na mainam."
            }
          ]
        },
        {
          "chapter": 24,
          "name": "Isaias 24",
          "verses": [
            {
              "chapter": 24,
              "verse": 1,
              "name": "Isaias 24:1",
              "text": "Narito, pinawawalan ng laman ng Panginoon ang lupa, at sinisira, at binabaligtad, at pinangangalat ang mga nananahan doon."
            },
            {
              "chapter": 24,
              "verse": 2,
              "name": "Isaias 24:2",
              "text": "At mangyayari, na kung paano sa mga tao, gayon sa saserdote; kung paano sa alipin, gayon sa kaniyang panginoon; kung paano sa alilang babae, gayon sa kaniyang panginoong babae; kung paano sa mamimili, gayon sa nagbibili; kung paano sa mapagpahiram, gayon sa manghihiram; kung paano sa mapagpatubo, gayon sa pinatutubuan."
            },
            {
              "chapter": 24,
              "verse": 3,
              "name": "Isaias 24:3",
              "text": "Ang lupa ay lubos na mawawalan ng laman, at lubos na masasamsaman; sapagka't sinalita ng Panginoon ang salitang ito."
            },
            {
              "chapter": 24,
              "verse": 4,
              "name": "Isaias 24:4",
              "text": "Ang lupa ay tumatangis at nasisira, ang sanglibutan ay nanghihina at nanglalata, ang mapagmataas na bayan sa lupa ay nanghihina."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "Isaias 24:5",
              "text": "Ang lupa naman ay nadumhan sa ilalim ng mga nananahan doon; sapagka't kanilang sinalangsang ang kautusan, binago ang alituntunin, sinira ang walang hanggang tipan."
            },
            {
              "chapter": 24,
              "verse": 6,
              "name": "Isaias 24:6",
              "text": "Kaya't nilamon ng sumpa ang lupa, at silang nagsisitahan doon ay nangasumpungang salarin; kaya't ang mga nananahan sa lupa ay nangasunog, at nangagilan ang tao."
            },
            {
              "chapter": 24,
              "verse": 7,
              "name": "Isaias 24:7",
              "text": "Ang bagong alak ay pinabayaan, ang puno ng ubas ay nalanta, lahat ng masayang puso ay nagbubuntong-hininga."
            },
            {
              "chapter": 24,
              "verse": 8,
              "name": "Isaias 24:8",
              "text": "Ang saya ng mga pandereta ay naglikat, ang kaingay nila na nangagagalak ay nagkawakas, ang galak ng alpa ay naglikat."
            },
            {
              "chapter": 24,
              "verse": 9,
              "name": "Isaias 24:9",
              "text": "Sila'y hindi magsisiinom ng alak na may awitan; matapang na alak ay magiging mapait sa kanila na nagsisiinom niyaon."
            },
            {
              "chapter": 24,
              "verse": 10,
              "name": "Isaias 24:10",
              "text": "Ang bayan ng pagkalito ay nabagsak: bawa't bahay ay nasarhan, upang walang taong makapasok doon."
            },
            {
              "chapter": 24,
              "verse": 11,
              "name": "Isaias 24:11",
              "text": "May daing sa mga lansangan dahil sa alak; lahat ng kagalakan ay naparam, ang kasayahan sa lupa ay nawala."
            },
            {
              "chapter": 24,
              "verse": 12,
              "name": "Isaias 24:12",
              "text": "Naiwan sa bayan ay kagibaan, at ang pintuang-bayan ay nawasak."
            },
            {
              "chapter": 24,
              "verse": 13,
              "name": "Isaias 24:13",
              "text": "Sapagka't ganito ang mangyayari sa mga tao sa gitna ng lupain na gaya ng paguga sa isang punong olibo, gaya ng pamumulot ng ubas pagkatapos ng pag-aani."
            },
            {
              "chapter": 24,
              "verse": 14,
              "name": "Isaias 24:14",
              "text": "Ang mga ito ay maglalakas ng kanilang tinig, sila'y magsisihiyaw; dahil sa kamahalan ng Panginoon ay nagsisihiyaw sila ng malakas mula sa dagat."
            },
            {
              "chapter": 24,
              "verse": 15,
              "name": "Isaias 24:15",
              "text": "Kaya't luwalhatiin ninyo ang Panginoon sa silanganan, sa makatuwid baga'y ang pangalan ng Panginoon, ng Dios ng Israel, sa mga pulo ng dagat."
            },
            {
              "chapter": 24,
              "verse": 16,
              "name": "Isaias 24:16",
              "text": "Mula sa kaduluduluhang bahagi ng lupa ay nakarinig kami ng mga awit, kaluwalhatian sa matuwid. Nguni't aking sinabi, Namamatay ako, namamayat ako, sa aba ko! ang mga manggagawang taksil ay nagsisigawang may kataksilan, oo, ang mga manggagawang taksil ay nagsisigawa na may lubhang kataksilan."
            },
            {
              "chapter": 24,
              "verse": 17,
              "name": "Isaias 24:17",
              "text": "Takot, at ang hukay, at ang silo ay nangasa iyo, Oh nananahan sa lupa."
            },
            {
              "chapter": 24,
              "verse": 18,
              "name": "Isaias 24:18",
              "text": "At mangyayari, na siyang tumatakas sa kakilakilabot na kaingay ay mahuhulog sa hukay; at siyang sumasampa mula sa gitna ng hukay ay mahuhuli sa silo: sapagka't ang mga dungawan sa itaas ay nangabuksan, at ang mga patibayan ng lupa ay umuuga."
            },
            {
              "chapter": 24,
              "verse": 19,
              "name": "Isaias 24:19",
              "text": "Ang lupa ay nagibang lubos, ang lupa ay lubos na nasira, ang lupa ay nakilos ng di kawasa."
            },
            {
              "chapter": 24,
              "verse": 20,
              "name": "Isaias 24:20",
              "text": "Ang lupa ay gigiray na parang lango, at mauuga na parang dampa; at ang kaniyang pagsalangsang ay magiging mabigat sa kaniya, at mabubuwal, at hindi na magbabangon."
            },
            {
              "chapter": 24,
              "verse": 21,
              "name": "Isaias 24:21",
              "text": "At mangyayari, sa araw na yaon, na parurusahan ng Panginoon ang hukbo ng mga mataas sa itaas, at ang mga hari sa lupa sa ibabaw ng lupa."
            },
            {
              "chapter": 24,
              "verse": 22,
              "name": "Isaias 24:22",
              "text": "At sila'y mangapipisan, gaya ng mga bilanggo na mangapipisan sa hukay, at masasarhan sa bilangguan, at pagkaraan ng maraming araw ay dadalawin sila."
            },
            {
              "chapter": 24,
              "verse": 23,
              "name": "Isaias 24:23",
              "text": "Kung magkagayo'y malilito ang buwan, at ang araw ay mapapahiya; sapagka't ang Panginoon ng mga hukbo ay maghahari sa bundok ng Sion, at sa Jerusalem; at sa harap ng kaniyang mga matanda ay may kaluwalhatian."
            }
          ]
        },
        {
          "chapter": 25,
          "name": "Isaias 25",
          "verses": [
            {
              "chapter": 25,
              "verse": 1,
              "name": "Isaias 25:1",
              "text": "Oh Panginoon, ikaw ay aking Dios; aking ibubunyi ka, aking pupurihin ang iyong pangalan; sapagka't ikaw ay gumawa ng kagilagilalas na bagay, sa makatuwid baga'y ang iyong binalak noong una, sa pagtatapat at katotohanan."
            },
            {
              "chapter": 25,
              "verse": 2,
              "name": "Isaias 25:2",
              "text": "Sapagka't iyong pinapaging isang bunton ang isang bayan, ang bayang matibay ay pinapaging isang guho: ang palasio ng mga taga ibang lupa ay di na magiging bayan; hindi matatayo kailan man."
            },
            {
              "chapter": 25,
              "verse": 3,
              "name": "Isaias 25:3",
              "text": "Kaya't luluwalhatiin ka ng matibay na bayan, ang bayan ng kakilakilabot na mga bansa ay matatakot sa iyo."
            },
            {
              "chapter": 25,
              "verse": 4,
              "name": "Isaias 25:4",
              "text": "Sapagka't ikaw ay naging ampunan sa dukha, ampunan sa mapagkailangan sa kaniyang kahirapan, silongan sa bagyo, lilim sa init, pagka ang hihip ng mga kakilakilabot ay parang bagyo laban sa kuta."
            },
            {
              "chapter": 25,
              "verse": 5,
              "name": "Isaias 25:5",
              "text": "Gaya ng init sa tuyong dako patitigilin mo ang ingay ng mga taga ibang lupa; gaya ng init sa pamamagitan ng lilim ng alapaap, matitigil ang awit ng mga kakilakilabot."
            },
            {
              "chapter": 25,
              "verse": 6,
              "name": "Isaias 25:6",
              "text": "At sa bundok na ito ay gagawa ang Panginoon ng mga hukbo sa lahat ng mga bayan, ng isang kapistahan ng mga matabang bagay, ng isang kapistahan ng mga alak na laon, ng mga matabang bagay na puno ng utak, ng mga alak na laon na totoong sala."
            },
            {
              "chapter": 25,
              "verse": 7,
              "name": "Isaias 25:7",
              "text": "At kaniyang aalisin sa bundok na ito ang takip na nalagay sa lahat ng mga bayan, at ang lambong na naladlad sa lahat na bansa."
            },
            {
              "chapter": 25,
              "verse": 8,
              "name": "Isaias 25:8",
              "text": "Sinakmal niya ang kamatayan magpakailan man; at papahirin ng Panginoong Dios ang mga luha sa lahat ng mga mukha; at ang kakutyaan ng kaniyang bayan ay maaalis sa buong lupa: sapagka't sinalita ng Panginoon."
            },
            {
              "chapter": 25,
              "verse": 9,
              "name": "Isaias 25:9",
              "text": "At sasabihin sa araw na yaon, Narito, ito'y ating Dios; hinintay natin siya, at ililigtas niya tayo: ito ang Panginoon; ating hinintay siya, tayo'y matutuwa at magagalak sa kaniyang pagliligtas."
            },
            {
              "chapter": 25,
              "verse": 10,
              "name": "Isaias 25:10",
              "text": "Sapagka't sa bundok na ito magpapahinga ang kamay ng Panginoon; at ang Moab ay mayayapakan sa kaniyang dako, gaya ng dayami na nayayapakan sa tapunan ng dumi."
            },
            {
              "chapter": 25,
              "verse": 11,
              "name": "Isaias 25:11",
              "text": "At kaniyang iuunat ang kaniyang mga kamay sa gitna niyaon, gaya ng paguunat ng lumalangoy upang lumangoy: at kaniyang ibababa ang kaniyang kapalaluan sangpu ng gawa ng kaniyang mga kamay."
            },
            {
              "chapter": 25,
              "verse": 12,
              "name": "Isaias 25:12",
              "text": "At ang mataas na moog ng iyong mga kuta ay kaniyang ibinaba, giniba, at ibinagsak sa lupa, hanggang sa alabok."
            }
          ]
        },
        {
          "chapter": 26,
          "name": "Isaias 26",
          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Isaias 26:1",
              "text": "Sa araw na yaon ay aawitin ang awit na ito sa lupain ng Juda: Tayo ay may matibay na bayan; kaligtasan ay kaniyang ilalagay na pinakakuta at pinakakatibayan."
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Isaias 26:2",
              "text": "Buksan ninyo ang mga pintuang-bayan, upang mapasukan ng matuwid na bansa na nagiingat ng katotohanan."
