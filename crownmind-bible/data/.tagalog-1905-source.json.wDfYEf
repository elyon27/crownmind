            {
              "chapter": 15,
              "verse": 6,
              "name": "2 Samuel 15:6",
              "text": "At ganitong paraan ang ginagawa ni Absalom sa buong Israel na naparoroon sa hari sa pagpapahatol: sa gayo'y ginanyak ni Absalom ang mga kalooban ng mga tao ng Israel."
            },
            {
              "chapter": 15,
              "verse": 7,
              "name": "2 Samuel 15:7",
              "text": "At nangyari, sa katapusan ng apat na pung taon, na sinasabi ni Absalom sa hari, Isinasamo ko sa iyo na payaunin mo ako at ako'y tumupad ng aking panata na aking ipinanata sa Panginoon, sa Hebron."
            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "2 Samuel 15:8",
              "text": "Sapagka't ang iyong lingkod ay nanata ng isang panata samantalang ako'y tumatahan sa Gesur sa Siria, na nagsabi, Kung tunay na dadalhin uli ako ng Panginoon sa Jerusalem, maglilingkod nga ako sa Panginoon."
            },
            {
              "chapter": 15,
              "verse": 9,
              "name": "2 Samuel 15:9",
              "text": "At sinabi ng hari sa kaniya, Yumaon kang payapa. Sa gayo'y bumangon siya, at naparoon sa Hebron."
            },
            {
