            {
              "chapter": 6,
              "verse": 22,
              "name": "2 Samuel 6:22",
              "text": "At ako'y magpapakawalang kabuluhan pa kay sa yaon, at ako'y magpapakababa sa aking sariling paningin: nguni't sa mga babaing lingkod na iyong sinalita, ay pararangalan ako."
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "2 Samuel 6:23",
              "text": "At si Michal na anak ni Saul ay hindi nagkaanak hanggang sa araw ng kaniyang kamatayan."
