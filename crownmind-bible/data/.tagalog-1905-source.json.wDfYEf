            },
            {
              "chapter": 21,
              "verse": 28,
              "name": "Josue 21:28",
              "text": "At sa lipi ni Issachar, ang Cesion pati ng mga nayon niyaon, ang Dabereth pati ng mga nayon niyaon;"
