            {
              "chapter": 12,
              "verse": 6,
              "name": "Isaias 12:6",
              "text": "Humiyaw ka ng malakas at sumigaw ka, ikaw na nananahan sa Sion: sapagka't dakila ang Banal ng Israel sa gitna mo."
