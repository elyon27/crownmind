          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Genesis 26:1",
              "text": "At nagkagutom sa lupain, bukod sa unang pagkakagutom na nangyari ng mga araw ni Abraham. At naparoon si Isaac kay Abimelech, na hari ng mga Filisteo sa Gerar."
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Genesis 26:2",
              "text": "At napakita ang Panginoon sa kaniya, at nagsabi, Huwag kang bumaba sa Egipto; matira ka sa lupaing aking sasabihin sa iyo:"
            },
            {
              "chapter": 26,
              "verse": 3,
              "name": "Genesis 26:3",
              "text": "Matira ka sa lupaing ito, at ako'y sasa iyo, at ikaw ay aking pagpapalain; sapagka't sa iyo at sa iyong binhi ay ibibigay ko ang lahat ng lupaing ito, at pagtitibayin ko ang sumpang aking isinumpa kay Abraham na iyong ama;"
            },
            {
              "chapter": 26,
              "verse": 4,
              "name": "Genesis 26:4",
              "text": "At aking pararamihin ang iyong binhi na gaya ng mga bituin sa langit, at ibibigay ko sa iyong binhi ang lahat ng lupaing ito: at pagpapalain sa iyong binhi ang lahat ng bansa sa lupa;"
            },
            {
              "chapter": 26,
              "verse": 5,
              "name": "Genesis 26:5",
              "text": "Sapagka't sinunod ni Abraham ang aking tinig, at ginanap ang aking bilin, ang aking mga utos, ang aking mga palatuntunan at ang aking mga kautusan."
