            {
              "chapter": 48,
              "verse": 21,
              "name": "Isaias 48:21",
              "text": "At sila'y hindi nangauhaw nang pinapatnubayan niya sila sa mga ilang; kaniyang pinaagos ang tubig mula sa bato para sa kanila; kaniyang ginuwangan din naman ang bato, at ang tubig ay bumukal."
            },
            {
              "chapter": 48,
              "verse": 22,
              "name": "Isaias 48:22",
              "text": "Walang kapayapaan sa masama, sabi ng Panginoon."
