            {
              "chapter": 6,
              "verse": 6,
              "name": "2 Mga Hari 6:6",
              "text": "At sinabi ng lalake ng Dios, Saan nalaglag? At itinuro niya sa kaniya ang dako. At siya'y pumutol ng isang patpat, at inihagis doon, at pinalutang ang bakal."
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "2 Mga Hari 6:7",
