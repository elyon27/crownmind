            {
              "chapter": 21,
              "verse": 5,
              "name": "Josue 21:5",
              "text": "At ang nalabi sa mga anak ni Coath ay nagtamo sa pamamagitan ng sapalaran sa mga angkan ng lipi ni Ephraim, at sa lipi ni Dan, at sa kalahating lipi ni Manases, ng sangpung bayan."
            },
            {
              "chapter": 21,
              "verse": 6,
              "name": "Josue 21:6",
              "text": "At ang mga anak ni Gerson ay nagtamo sa pamamagitan ng sapalaran sa mga angkan ng lipi ni Issachar, at sa lipi ni Aser, at sa lipi ni Nephtali, at sa kalahating lipi ni Manases sa Basan, ng labing tatlong bayan."
            },
            {
              "chapter": 21,
              "verse": 7,
              "name": "Josue 21:7",
              "text": "Ang mga anak ni Merari ayon sa kanilang mga angkan ay nagtamo sa lipi ni Ruben, at sa lipi ni Gad, at sa lipi ni Zabulon, ng labing dalawang bayan."
