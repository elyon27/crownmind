            {
              "chapter": 22,
              "verse": 6,
              "name": "Genesis 22:6",
              "text": "At kinuha ni Abraham ang kahoy ng handog na susunugin, at ipinasan kay Isaac na kaniyang anak; at dinala sa kaniyang kamay ang apoy at ang sundang; at sila'y kapuwa yumaong magkasama."
            },
            {
              "chapter": 22,
              "verse": 7,
              "name": "Genesis 22:7",
              "text": "At nagsalita si Isaac kay Abraham na kaniyang ama, na sinabi, Ama ko: at kaniyang sinabi, Narito ako, anak ko. At sinabi, Narito, ang apoy at ang kahoy, nguni't saan naroon ang korderong pinakahandog na susunugin?"
            },
            {
              "chapter": 22,
              "verse": 8,
              "name": "Genesis 22:8",
              "text": "At sinabi ni Abraham, Dios ang maghahanda ng korderong pinakahandog na susunugin, anak ko: ano pa't sila'y kapuwa yumaong magkasama."
            },
            {
              "chapter": 22,
              "verse": 9,
              "name": "Genesis 22:9",
              "text": "At sila'y dumating sa dakong sa kaniya'y sinabi ng Dios; at nagtayo si Abraham doon ng isang dambana, at inayos ang kahoy, at tinalian si Isaac na kaniyang anak at inilagay sa ibabaw ng dambana, sa ibabaw ng kahoy."
            },
            {
              "chapter": 22,
              "verse": 10,
              "name": "Genesis 22:10",
              "text": "At iniunat ni Abraham ang kaniyang kamay at hinawakan ang sundang upang patayin ang kaniyang anak."
            },
            {
              "chapter": 22,
              "verse": 11,
              "name": "Genesis 22:11",
              "text": "At tinawag siya ng anghel ng Panginoon mula sa langit, at sinabi, Abraham, Abraham: at kaniyang sinabi, Narito ako."
            },
            {
              "chapter": 22,
              "verse": 12,
              "name": "Genesis 22:12",
              "text": "At sa kaniya'y sinabi, Huwag mong buhatin ang iyong kamay sa bata, o gawan man siya ng anoman: sapagka't talastas ko ngayon, na ikaw ay natatakot sa Dios, sa paraang hindi mo itinanggi sa akin ang iyong anak, ang iyong bugtong na anak."
            },
            {
              "chapter": 22,
              "verse": 13,
              "name": "Genesis 22:13",
              "text": "At itiningin ni Abraham ang kaniyang mga mata, at nagmalas, at narito, ang isang tupang lalake, sa dakong likuran niya na huli sa dawag sa kaniyang mga sungay: at pumaroon si Abraham, at kinuha ang tupa, at siyang inihandog na handog na susunugin na inihalili sa kaniyang anak."
            },
            {
              "chapter": 22,
              "verse": 14,
              "name": "Genesis 22:14",
              "text": "At pinanganlan ni Abraham ang dakong yaon, ng Jehova-jireh: gaya ng kasabihan hanggang sa araw na ito: Sa bundok ng Panginoon ay mahahanda."
            },
            {
              "chapter": 22,
              "verse": 15,
              "name": "Genesis 22:15",
              "text": "At tinawag ng anghel ng Panginoon si Abraham na ikalawa mula sa langit."
            },
            {
              "chapter": 22,
              "verse": 16,
              "name": "Genesis 22:16",
              "text": "At sinabi, Sa aking sarili ay sumumpa ako, anang Panginoon, sapagka't ginawa mo ito, at hindi mo itinanggi sa akin ang iyong anak, ang iyong bugtong na anak;"
            },
            {
              "chapter": 22,
              "verse": 17,
              "name": "Genesis 22:17",
              "text": "Na sa pagpapala ay pagpapalain kita, at sa pagpaparami ay pararamihin ko ang iyong binhi, na gaya ng mga bituin sa langit, at gaya ng mga buhangin sa baybayin ng dagat; at kakamtin ng iyong binhi ang pintuang-bayan ng kaniyang mga kaaway;"
            },
            {
              "chapter": 22,
              "verse": 18,
              "name": "Genesis 22:18",
              "text": "At pagpapalain sa iyong binhi ang lahat ng bansa sa lupa; sapagka't sinunod mo ang aking tinig."
            },
            {
              "chapter": 22,
              "verse": 19,
              "name": "Genesis 22:19",
              "text": "Sa gayo'y nagbalik si Abraham sa kaniyang mga alila, at nagsitindig at samasamang nagsiparoon sa Beerseba; at tumahan si Abraham sa Beerseba."
            },
            {
              "chapter": 22,
              "verse": 20,
              "name": "Genesis 22:20",
              "text": "At nangyari, pagkatapos ng mga bagay na ito, na ibinalita kay Abraham na sinasabi, Narito, si Milca rin naman ay nagkaroon ng mga anak kay Nahor na iyong kapatid."
