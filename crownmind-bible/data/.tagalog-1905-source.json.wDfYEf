        {
          "chapter": 13,
          "name": "1 Mga Hari 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "1 Mga Hari 13:1",
              "text": "At, narito, dumating ang isang lalake ng Dios na mula sa Juda ayon sa salita ng Panginoon sa Beth-el: at si Jeroboam ay nakatayo sa siping ng dambana upang magsunog ng kamangyan."
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "1 Mga Hari 13:2",
              "text": "At siya'y sumigaw laban sa dambana ayon sa salita ng Panginoon, at nagsabi, Oh dambana, dambana, ganito ang sabi ng Panginoon: Narito, isang bata'y ipanganganak sa sangbahayan ni David na ang pangalan ay Josias: at sa iyo'y ihahain ang mga saserdote ng mga mataas na dako na nagsisipagsunog ng kamangyan sa iyo, at mga buto ng mga tao ang kanilang susunugin sa iyo."
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "1 Mga Hari 13:3",
              "text": "At siya'y nagbigay ng tanda nang araw ding yaon, na nagsasabi, Ito ang tanda na sinalita ng Panginoon: Narito, ang dambana ay mababaak, at ang mga abo na nasa ibabaw ay mabubuhos."
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "1 Mga Hari 13:4",
              "text": "At nangyari, nang marinig ng hari ang sabi ng lalake ng Dios, na kaniyang isinigaw laban sa dambana sa Beth-el, na iniunat ni Jeroboam ang kaniyang kamay mula sa dambana, na sinasabi, Hulihin siya. At ang kaniyang kamay na kaniyang iniunat laban sa kaniya ay natuyo, na anopa't hindi niya napanauli sa dati."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "1 Mga Hari 13:5",
              "text": "Ang dambana naman ay nabaak, at ang mga abo ay nabuhos mula sa dambana, ayon sa tanda na ibinigay ng lalake ng Dios ayon sa salita ng Panginoon."
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "1 Mga Hari 13:6",
              "text": "At ang hari ay sumagot, at nagsabi sa lalake ng Dios, Isamo mo ngayon ang biyaya ng Panginoon mong Dios, at idalangin mo ako, upang ang aking kamay ay gumaling. At idinalangin ng lalake ng Dios sa Panginoon, at ang kamay ng hari ay gumaling uli, at naging gaya ng dati."
            },
            {
              "chapter": 13,
              "verse": 7,
              "name": "1 Mga Hari 13:7",
              "text": "At sinabi ng hari sa lalake ng Dios, Umuwi kang kasama ko, at kumain ka, at bibigyan kita ng kagantihan."
            },
            {
              "chapter": 13,
              "verse": 8,
              "name": "1 Mga Hari 13:8",
              "text": "At sinabi ng lalake ng Dios sa hari, Kung ang ibibigay mo sa akin ay kalahati ng iyong bahay ay hindi ako yayaong kasama mo, o kakain man ako ng tinapay o iinom man ako ng tubig sa dakong ito:"
            },
            {
              "chapter": 13,
              "verse": 9,
              "name": "1 Mga Hari 13:9",
              "text": "Sapagka't gayon ibinilin sa akin sa pamamagitan ng salita ng Panginoon, na sinasabi, Huwag kang kakain ng tinapay, o iinom man ng tubig, ni babalik man sa daan na iyong pinanggalingan."
            },
            {
              "chapter": 13,
              "verse": 10,
              "name": "1 Mga Hari 13:10",
              "text": "Sa gayo'y yumaon siya sa ibang daan, at hindi na bumalik sa daan na kaniyang pinanggalingan sa Beth-el."
            },
            {
              "chapter": 13,
              "verse": 11,
              "name": "1 Mga Hari 13:11",
              "text": "Tumatahan nga ang isang matandang propeta sa Beth-el; at isa sa kaniyang mga anak ay naparoon, at isinaysay sa kaniya ang lahat ng mga gawa na ginawa ng lalake ng Dios sa araw na yaon sa Beth-el: ang mga salita na kaniyang sinalita sa hari, ay siya ring isinaysay nila sa kanilang ama."
            },
            {
              "chapter": 13,
              "verse": 12,
              "name": "1 Mga Hari 13:12",
              "text": "At sinabi ng kanilang ama sa kanila, Saan siya napatungo? At itinuro sa kaniya ng kaniyang mga anak ang daang pinatunguhan ng lalake ng Dios na nanggaling sa Juda."
            },
            {
              "chapter": 13,
              "verse": 13,
              "name": "1 Mga Hari 13:13",
              "text": "At sinabi niya sa kaniyang mga anak, Siyahan ninyo sa akin ang asno. Sa gayo'y kanilang siniyahan ang asno sa kaniya: at kaniyang sinakyan."
            },
            {
              "chapter": 13,
              "verse": 14,
              "name": "1 Mga Hari 13:14",
              "text": "At kaniyang sinundan ang lalake ng Dios, at nasumpungan niyang nakaupo sa ilalim ng isang puno ng encina: at sinabi niya sa kaniya, Ikaw ba ang lalake ng Dios na nanggaling sa Juda? At sinabi niya, Ako nga."
            },
            {
              "chapter": 13,
              "verse": 15,
              "name": "1 Mga Hari 13:15",
              "text": "Nang magkagayo'y sinabi niya sa kaniya, Umuwi kang kasama ko, at kumain ng tinapay."
            },
            {
              "chapter": 13,
              "verse": 16,
              "name": "1 Mga Hari 13:16",
              "text": "At sinabi niya, Hindi ako makababalik na kasama mo, o makapapasok na kasama mo: ni makakakain man ng tinapay o makaiinom man ng tubig na kasalo mo sa dakong ito:"
            },
            {
              "chapter": 13,
              "verse": 17,
              "name": "1 Mga Hari 13:17",
              "text": "Sapagka't isinaysay sa akin sa pamamagitan ng salita ng Panginoon. Huwag kang kakain ng tinapay o iinom man ng tubig doon, o babalik man na yumaon sa daan na iyong pinanggalingan."
            },
            {
              "chapter": 13,
              "verse": 18,
              "name": "1 Mga Hari 13:18",
              "text": "At sinabi niya sa kaniya, Ako man ay propeta na gaya mo; at isang anghel ay nagsalita sa akin sa pamamagitan ng salita ng Panginoon, na nagsasabi, Ibalik mo siya na kasama mo sa iyong bahay, upang siya'y makakain ng tinapay at makainom ng tubig. Nguni't siya'y nagbulaan sa kaniya."
            },
            {
              "chapter": 13,
              "verse": 19,
              "name": "1 Mga Hari 13:19",
              "text": "Sa gayo'y bumalik na kasama niya, at kumain ng tinapay sa kaniyang bahay at uminom ng tubig."
            },
            {
              "chapter": 13,
              "verse": 20,
              "name": "1 Mga Hari 13:20",
              "text": "At nangyari, samantalang sila'y nauupo sa dulang, na ang salita ng Panginoon ay dumating sa propeta na nagpabalik sa kaniya:"
            },
            {
              "chapter": 13,
              "verse": 21,
              "name": "1 Mga Hari 13:21",
              "text": "At siya'y sumigaw sa lalake ng Dios na nanggaling sa Juda, na sinasabi, Ganito ang sabi ng Panginoon: Sa paraang ikaw ay naging manunuway sa bibig ng Panginoon, at hindi mo iningatan ang utos na iniutos ng Panginoon sa iyo,"
            },
            {
              "chapter": 13,
              "verse": 22,
              "name": "1 Mga Hari 13:22",
              "text": "Kundi ikaw ay bumalik at kumain ng tinapay, at uminom ng tubig sa dakong kaniyang pinagsabihan sa iyo: Huwag kang kumain ng tinapay, at huwag kang uminom ng tubig; ang iyong bangkay ay hindi darating sa libingan ng iyong mga magulang."
            },
            {
              "chapter": 13,
              "verse": 23,
              "name": "1 Mga Hari 13:23",
              "text": "At nangyari, pagkatapos na makakain ng tinapay, at pagkatapos na makainom, na siniyahan niya ang asno para sa kaniya, sa makatuwid baga'y, para sa propeta na kaniyang pinabalik."
            },
            {
              "chapter": 13,
              "verse": 24,
              "name": "1 Mga Hari 13:24",
              "text": "At nang siya'y makayaon, isang leon ay nasalubong niya sa daan, at pinatay siya: at ang kaniyang bangkay ay napahagis sa daan, at ang asno ay nakatayo sa siping; ang leon naman ay nakatayo sa siping ng bangkay."
            },
            {
              "chapter": 13,
              "verse": 25,
              "name": "1 Mga Hari 13:25",
              "text": "At, narito, may mga taong nagsipagdaan, at nakita ang bangkay na nakahagis sa daan, at ang leon ay nakatayo sa siping ng bangkay: at sila'y yumaon at isinaysay nila sa bayan na kinatatahanan ng matandang propeta."
            },
            {
              "chapter": 13,
              "verse": 26,
              "name": "1 Mga Hari 13:26",
              "text": "At nang marinig ng propeta na nagpabalik sa kaniya sa daan, sinabi niya: Lalake nga ng Dios, na naging masuwayin sa bibig ng Panginoon, kaya't ibinigay siya ng Panginoon sa leon, na lumapa sa kaniya at pumatay sa kaniya ayon sa salita ng Panginoon, na sinalita sa kaniya."
            },
            {
              "chapter": 13,
              "verse": 27,
              "name": "1 Mga Hari 13:27",
              "text": "At sinalita niya sa kaniyang mga anak na sinasabi, Siyahan ninyo sa akin ang asno. At kanilang siniyahan."
            },
            {
              "chapter": 13,
              "verse": 28,
              "name": "1 Mga Hari 13:28",
              "text": "At siya'y yumaon, at nasumpungan ang kaniyang bangkay na nakahagis sa daan, at ang leon at ang asno ay nakatayo sa siping ng bangkay: hindi nilamon ng leon ang bangkay, o nilapa man ang asno."
            },
            {
              "chapter": 13,
              "verse": 29,
              "name": "1 Mga Hari 13:29",
              "text": "At kinuha ng propeta ang bangkay ng lalake ng Dios, at ipinatong sa asno, at ibinalik: at naparoon sa bayan ng matandang propeta, upang tumangis, at ilibing siya."
            },
            {
              "chapter": 13,
              "verse": 30,
              "name": "1 Mga Hari 13:30",
              "text": "At inilagay niya ang kaniyang bangkay sa kaniyang sariling libingan; at kanilang tinangisan siya, na sinasabi, Ay kapatid ko!"
            },
            {
              "chapter": 13,
              "verse": 31,
              "name": "1 Mga Hari 13:31",
              "text": "At nangyari, pagkatapos na kaniyang mailibing, na siya'y nagsalita sa kaniyang mga anak, na sinasabi, Pagka ako'y namatay, ilibing nga ninyo ako sa libingan na pinaglibingan sa lalake ng Dios: ilagay ninyo ang aking mga buto sa siping ng kaniyang mga buto."
            },
            {
              "chapter": 13,
              "verse": 32,
              "name": "1 Mga Hari 13:32",
              "text": "Sapagka't ang sabi na kaniyang isinigaw sa pamamagitan ng salita ng Panginoon laban sa dambana sa Beth-el, at laban sa lahat ng mga bahay sa mga mataas na dako na nangasa mga bayan ng Samaria, ay walang pagsalang mangyayari."
            },
            {
              "chapter": 13,
              "verse": 33,
              "name": "1 Mga Hari 13:33",
              "text": "Pagkatapos ng bagay na ito, si Jeroboam ay hindi tumalikod sa kaniyang masamang lakad, kundi gumawa uli mula sa buong bayan ng mga saserdote sa mga mataas na dako: sinomang may ibig, kaniyang itinatalaga upang magkaroon ng mga saserdote sa mga mataas na dako."
            },
            {
              "chapter": 13,
              "verse": 34,
              "name": "1 Mga Hari 13:34",
              "text": "At ang bagay na ito ay naging kasalanan sa sangbahayan ni Jeroboam, kaya't inihiwalay at nilipol sa ibabaw ng lupa."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "1 Mga Hari 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "1 Mga Hari 14:1",
              "text": "Nang panahong yaon si Abias na anak ni Jeroboam ay nagkasakit."
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "1 Mga Hari 14:2",
              "text": "At sinabi ni Jeroboam sa kaniyang asawa, Bumangon ka, isinasamo ko sa iyo at magpakunwari kang iba upang huwag kang makilala na asawa ni Jeroboam; at pumaroon ka sa Silo; narito, naroon si Ahias na propeta na nagsalita tungkol sa akin, na ako'y magiging hari sa bayang ito."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "1 Mga Hari 14:3",
              "text": "At magdala ka ng sangpung tinapay, at mga munting tinapay, at isang bangang pulot, at paroon ka sa kaniya: kaniyang sasaysayin sa iyo kung ano ang mangyayari sa bata."
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "1 Mga Hari 14:4",
              "text": "At ginawang gayon ng asawa ni Jeroboam at bumangon, at naparoon sa Silo, at naparoon sa bahay ni Ahias. Si Ahias nga ay di na makakita; sapagka't ang kaniyang mga mata'y malabo na, dahil sa kaniyang gulang."
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "1 Mga Hari 14:5",
              "text": "At sinabi ng Panginoon kay Ahias, Narito, ang asawa ni Jeroboam ay naparirito na tinatanong ka tungkol sa kaniyang anak; sapagka't siya'y may sakit: ganito't ganito ang iyong sasabihin sa kaniya: sapagka't mangyayari, pagka siya'y pumasok, na siya'y magpapakunwari na ibang babae."
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "1 Mga Hari 14:6",
              "text": "At nagkagayon, nang marinig ni Ahias ang ingay ng kaniyang mga paa, pagpasok niya sa pintuan, na sinabi niya, Pumasok ka, ikaw, na asawa ni Jeroboam; bakit ka nagpapakunwaring iba? Sapagka't ako'y sinugo sa iyo na may masamang balita."
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "1 Mga Hari 14:7",
              "text": "Ikaw ay yumaon na saysayin mo kay Jeroboam, Ganito ang sabi ng Panginoon, ng Dios ng Israel, Yamang kita'y itinaas sa gitna ng bayan, at ginawa kitang pangulo sa aking bayang Israel,"
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "1 Mga Hari 14:8",
              "text": "At inagaw ang kaharian mula sa sangbahayan ni David, at ibinigay sa iyo: at gayon ma'y ikaw ay hindi naging gaya ng lingkod kong si David, na nagingat ng aking mga utos, at sumunod sa akin ng kaniyang buong puso, upang gawin ang matuwid lamang sa harap ng aking mga mata;"
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "1 Mga Hari 14:9",
              "text": "Kundi ikaw ay gumawa ng masama na higit kay sa lahat ng nauna sa iyo, at ikaw ay yumaon, at gumawa ka sa ganang iyo ng mga ibang dios, at mga larawang binubo upang mungkahiin mo ako sa galit, at inihagis mo ako sa iyong likuran;"
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "1 Mga Hari 14:10",
              "text": "Kaya't, narito ako'y magdadala ng kasamaan sa sangbahayan ni Jeroboam, at aking ihihiwalay kay Jeroboam ang bawa't lalake ang nakukulong, at ang naiwan sa kaluwangan sa Israel, at aking lubos na papalisin ang sangbahayan ni Jeroboam, kung paanong pinapalis ng isang tao ang dumi, hanggang sa mapaalis."
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "1 Mga Hari 14:11",
              "text": "Ang mamatay kay Jeroboam sa bayan ay kakanin ng mga aso; at ang mamatay sa parang ay kakanin ng mga ibon sa himpapawid: sapagka't sinalita ng Panginoon."
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "1 Mga Hari 14:12",
              "text": "Tumindig ka nga, umuwi ka sa iyong bahay: pagpasok ng iyong mga paa sa bayan ay mamamatay ang bata."
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "1 Mga Hari 14:13",
              "text": "At tatangisan siya ng buong Israel, at ililibing siya; sapagka't siya lamang ang kay Jeroboam na darating sa libingan: sapagka't siya'y kinasumpungan sa sangbahayan ni Jeroboam, ng bagay na mabuti sa Panginoon, sa Dios ng Israel."
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "1 Mga Hari 14:14",
              "text": "Bukod dito'y magtitindig ang Panginoon ng isang hari sa Israel, na siyang maghihiwalay ng sangbahayan ni Jeroboam sa araw na yaon; nguni't ano? ngayon din."
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "1 Mga Hari 14:15",
              "text": "Sapagka't sasaktan ng Panginoon ang Israel ng gaya ng isang tambo na gumagalaw sa tubig; at kaniyang bubunutin ang Israel dito sa mabuting lupa na ibinigay sa kanilang mga magulang, at pangangalatin sila sa dako roon ng ilog; dahil sa kanilang ginawa ang kanilang mga Asera, na minungkahi ang Panginoon sa galit."
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "1 Mga Hari 14:16",
              "text": "At kaniyang pababayaan ang Israel dahil sa mga kasalanan ni Jeroboam, na kaniyang ipinagkasala, at ipinapagkasala sa Israel."
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "1 Mga Hari 14:17",
              "text": "At ang asawa ni Jeroboam ay tumindig, at yumaon, at naparoon sa Thirsa: at pagpasok niya sa pasukan ng bahay, ang bata'y namatay."
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "1 Mga Hari 14:18",
              "text": "At inilibing siya ng buong Israel, at tinangisan siya; ayon sa salita ng Panginoon na kaniyang sinalita sa pamamagitan ng kaniyang lingkod na si Ahias na propeta."
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "1 Mga Hari 14:19",
              "text": "At ang iba sa mga gawa ni Jeroboam kung paanong siya'y nakidigma, at kung paanong siya'y naghari, narito, nangasusulat sa aklat ng mga alaala sa mga hari sa Israel."
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "1 Mga Hari 14:20",
              "text": "At ang mga araw na ipinaghari ni Jeroboam ay dalawang pu't dalawang taon: at siya'y natulog na kasama ng kaniyang mga magulang, at si Nadab na kaniyang anak ay naghari na kahalili niya."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "1 Mga Hari 14:21",
              "text": "At si Roboam na anak ni Salomon ay naghari sa Juda. Si Roboam ay apat na pu't isang taon nang siya'y magpasimulang maghari, at siya'y naghari na labing pitong taon sa Jerusalem, na bayan na pinili ng Panginoon sa lahat ng mga lipi ng Israel, upang ilagay ang kaniyang pangalan doon: at ang pangalan ng kaniyang ina ay Naama na Ammonita."
            },
            {
              "chapter": 14,
              "verse": 22,
              "name": "1 Mga Hari 14:22",
              "text": "At gumawa ang Juda ng masama sa paningin ng Panginoon, at kanilang minungkahi siya sa paninibugho sa pamamagitan ng kanilang mga kasalanan na kanilang nagawa, na higit kay sa lahat na ginawa ng kanilang mga magulang,"
            },
            {
              "chapter": 14,
              "verse": 23,
              "name": "1 Mga Hari 14:23",
              "text": "Sapagka't sila'y nagsipagtayo naman para sa kanila ng mga mataas na dako, at ng mga haligi, at ng mga Asera, sa bawa't mataas na burol, at sa ilalim ng bawa't sariwang punong kahoy;"
            },
            {
              "chapter": 14,
              "verse": 24,
              "name": "1 Mga Hari 14:24",
              "text": "At nagkaroon din naman ng mga sodomita ang lupain: sila'y nagsigawa ng ayon sa lahat na karumaldumal ng mga bansa na pinalayas ng Panginoon sa harap ng mga anak ng Israel."
            },
            {
              "chapter": 14,
              "verse": 25,
              "name": "1 Mga Hari 14:25",
              "text": "At nangyari, nang ikalimang taon ng haring Roboam, na si Sisac na hari sa Egipto ay umahon laban sa Jerusalem:"
            },
            {
              "chapter": 14,
              "verse": 26,
              "name": "1 Mga Hari 14:26",
              "text": "At kaniyang dinala ang mga kayamanan ng bahay ng Panginoon, at ang mga kayamanan ng bahay ng hari; kaniya ngang dinalang lahat: at kaniyang dinala ang lahat na kalasag na ginto na ginawa ni Salomon."
            },
            {
              "chapter": 14,
              "verse": 27,
              "name": "1 Mga Hari 14:27",
              "text": "At ang haring Roboam ay gumawa ng mga kalasag na tanso na kahalili ng mga yaon, at ipinagkatiwala sa mga kamay ng mga punong kawal na bantay, na nagiingat ng pintuan ng bahay ng hari."
            },
            {
              "chapter": 14,
              "verse": 28,
              "name": "1 Mga Hari 14:28",
              "text": "At nangyari, na pagka nanasok ang hari sa bahay ng Panginoon, ay dinadala ng bantay, at ibinabalik sa silid ng bantay."
            },
            {
              "chapter": 14,
              "verse": 29,
              "name": "1 Mga Hari 14:29",
              "text": "Ang iba nga sa mga gawa ni Roboam at ang lahat na bagay na kaniyang ginawa, hindi ba nasusulat sa aklat ng mga alaala sa mga hari sa Juda?"
            },
            {
              "chapter": 14,
              "verse": 30,
              "name": "1 Mga Hari 14:30",
              "text": "At nagkaroong palagi ng pagdidigmaan si Roboam at si Jeroboam."
            },
            {
              "chapter": 14,
              "verse": 31,
              "name": "1 Mga Hari 14:31",
              "text": "At si Roboam ay natulog na kasama ng kaniyang mga magulang, at nalibing na kasama ng kaniyang mga magulang sa bayan ni David: at ang pangalan ng kaniyang ina ay Naama na Ammonita. At si Abiam na kaniyang anak ay naghari na kahalili niya."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "1 Mga Hari 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "1 Mga Hari 15:1",
              "text": "Nang ikalabing walong taon nga ng haring Jeroboam, na anak ni Nabat, ay nagpasimula si Abiam na maghari sa Juda."
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "1 Mga Hari 15:2",
              "text": "Tatlong taon siyang naghari sa Jerusalem, at ang pangalan ng kaniyang ina ay Maacha na anak ni Abisalom."
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "1 Mga Hari 15:3",
              "text": "At siya'y lumakad sa lahat ng mga kasalanan ng kaniyang ama na ginawa nito na una sa kaniya: at ang kaniyang puso ay hindi sakdal sa Panginoon niyang Dios, na gaya ng puso ni David na kaniyang magulang."
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "1 Mga Hari 15:4",
              "text": "Gayon ma'y dahil kay David ay binigyan siya ng Panginoon na kaniyang Dios ng isang ilawan sa Jerusalem, upang itaas ang kaniyang anak pagkamatay niya, at upang itatag sa Jerusalem:"
            },
            {
              "chapter": 15,
              "verse": 5,
              "name": "1 Mga Hari 15:5",
              "text": "Sapagka't ginawa ni David ang matuwid sa harap ng mga mata ng Panginoon, at hindi lumihis sa anomang bagay na iniutos niya sa kaniya sa lahat ng kaarawan ng kaniyang buhay, liban lamang sa bagay ni Uria na Hetheo."
            },
            {
              "chapter": 15,
              "verse": 6,
              "name": "1 Mga Hari 15:6",
              "text": "Nagkaroon nga ng pagdidigmaan si Roboam at si Jeroboam sa lahat ng kaarawan ng kaniyang buhay."
            },
            {
              "chapter": 15,
              "verse": 7,
              "name": "1 Mga Hari 15:7",
              "text": "At ang iba nga sa mga gawa ni Abiam, at ang lahat niyang ginagawa, hindi ba nasusulat sa aklat ng mga alaala sa mga hari sa Juda? At nagkaroon ng pagdidigmaan si Abiam at si Jeroboam."
            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "1 Mga Hari 15:8",
              "text": "At si Abiam ay natulog na kasama ng kaniyang mga magulang; at inilibing nila siya sa bayan ni David: at si Asa na kaniyang anak ay naghari na kahalili niya."
            },
            {
              "chapter": 15,
              "verse": 9,
              "name": "1 Mga Hari 15:9",
              "text": "At nang ikadalawang pung taon ni Jeroboam na hari sa Israel ay nagpasimula si Asa na maghari sa Juda."
            },
            {
              "chapter": 15,
              "verse": 10,
              "name": "1 Mga Hari 15:10",
              "text": "At apat na pu't isang taong naghari siya sa Jerusalem: at ang pangalan ng kaniyang ina ay Maacha, na anak ni Abisalom."
            },
            {
              "chapter": 15,
              "verse": 11,
              "name": "1 Mga Hari 15:11",
              "text": "At ginawa ni Asa ang matuwid sa harap ng mga mata ng Panginoon, gaya ng ginawa ni David na kaniyang magulang."
            },
            {
              "chapter": 15,
              "verse": 12,
              "name": "1 Mga Hari 15:12",
              "text": "At kaniyang inalis ang mga Sodomita sa lupain, at inalis ang lahat ng diosdiosan na ginawa ng kaniyang mga magulang."
            },
            {
              "chapter": 15,
              "verse": 13,
              "name": "1 Mga Hari 15:13",
              "text": "At si Maacha naman na kaniyang ina ay inalis niya sa pagkareina, sapagka't gumawa ng karumaldumal na larawan na pinaka Asera; at pinutol ni Asa ang kaniyang larawan, at sinunog sa batis Cedron."
            },
            {
              "chapter": 15,
              "verse": 14,
              "name": "1 Mga Hari 15:14",
              "text": "Nguni't ang matataas na dako ay hindi inalis: gayon ma'y ang puso ni Asa ay sakdal sa Panginoon sa lahat ng kaniyang kaarawan."
            },
            {
              "chapter": 15,
              "verse": 15,
              "name": "1 Mga Hari 15:15",
              "text": "At kaniyang ipinasok sa bahay ng Panginoon ang mga bagay na itinalaga ng kaniyang ama, at ang mga bagay na itinalaga niya, pilak, at ginto, at mga sisidlan."
            },
            {
              "chapter": 15,
              "verse": 16,
              "name": "1 Mga Hari 15:16",
              "text": "At nagkaroon ng pagdidigmaan si Asa at si Baasa na hari sa Israel sa lahat ng kanilang kaarawan."
            },
            {
              "chapter": 15,
              "verse": 17,
              "name": "1 Mga Hari 15:17",
              "text": "At si Baasa na hari sa Israel ay umahon laban sa Juda, at itinayo ang Rama upang huwag niyang matiis na sinoma'y lumabas o pumaroon kay Asa na hari sa Juda."
            },
            {
              "chapter": 15,
              "verse": 18,
              "name": "1 Mga Hari 15:18",
              "text": "Nang magkagayo'y kinuha ni Asa ang lahat na pilak at ginto na naiwan sa mga kayamanan ng bahay ng Panginoon, at sa mga kayamanan ng bahay ng hari, at ibinigay sa kamay ng kaniyang mga lingkod: at ipinadala ang mga yaon ng haring Asa kay Ben-adad na anak ni Tabrimon, na anak ni Hezion, na hari sa Siria, na tumatahan sa Damasco, na nagsasabi,"
            },
            {
              "chapter": 15,
              "verse": 19,
              "name": "1 Mga Hari 15:19",
              "text": "May pagkakasundo ako at ikaw, ang aking ama at ang iyong ama: narito, aking ipinadala sa iyo ang isang kaloob na pilak at ginto; ikaw ay yumaon, sirain mo ang iyong pakikipagkasundo kay Baasa na hari sa Israel, upang siya'y lumayas sa akin."
            },
            {
              "chapter": 15,
              "verse": 20,
              "name": "1 Mga Hari 15:20",
              "text": "At dininig ni Ben-adad ang haring Asa, at sinugo ang mga puno ng kaniyang mga hukbo laban sa mga bayan ng Israel, at sinaktan ang Ahion at ang Dan, at ang Abel-bethmaacha at ang buong Cinneroth, sangpu ng buong lupain ng Nephtali."
            },
            {
              "chapter": 15,
              "verse": 21,
              "name": "1 Mga Hari 15:21",
              "text": "At nangyari nang mabalitaan yaon ni Baasa, na iniwan ang pagtatayo ng Rama, at tumahan sa Thirsa."
            },
            {
              "chapter": 15,
              "verse": 22,
              "name": "1 Mga Hari 15:22",
              "text": "Nang magkagayo'y itinanyag ng haring Asa ang buong Juda; walang natangi: at kanilang inalis ang mga bato ng Rama, at ang mga kahoy niyaon, na ipinagtayo ni Baasa; at itinayo ng haring Asa sa pamamagitan niyaon ang Gabaa ng Benjamin at ang Mizpa."
            },
            {
              "chapter": 15,
              "verse": 23,
              "name": "1 Mga Hari 15:23",
              "text": "Ang iba nga sa lahat na gawa ni Asa, at sa kaniyang buong kapangyarihan, at ang lahat niyang ginawa, at ang mga bayan na kaniyang itinayo, di ba nasusulat sa aklat ng mga alaala sa mga hari sa Juda? Nguni't sa panahon ng kaniyang katandaan, siya'y nagkasakit sa kaniyang mga paa."
            },
            {
              "chapter": 15,
              "verse": 24,
              "name": "1 Mga Hari 15:24",
              "text": "At si Asa ay natulog na kasama ng kaniyang mga magulang, at nalibing na kasama ng kaniyang mga magulang sa bayan ni David na kaniyang magulang: at si Josaphat na kaniyang anak ay naghari na kahalili niya."
            },
            {
              "chapter": 15,
              "verse": 25,
              "name": "1 Mga Hari 15:25",
              "text": "At si Nadab na anak ni Jeroboam ay nagpasimulang maghari sa Israel sa ikalawang taon ni Asa na hari sa Juda, at siya'y naghari sa Israel na dalawang taon."
            },
            {
              "chapter": 15,
              "verse": 26,
              "name": "1 Mga Hari 15:26",
              "text": "At siya'y gumawa ng masama sa paningin ng Panginoon, at lumakad ng lakad ng kaniyang ama, at sa kaniyang kasalanan na kaniyang ipinapagkasala sa Israel."
            },
            {
              "chapter": 15,
              "verse": 27,
              "name": "1 Mga Hari 15:27",
              "text": "At si Baasa na anak ni Ahia, sa sangbahayan ni Issachar ay nagbanta laban sa kaniya; at sinaktan siya ni Baasa sa Gibbethon, na nauukol sa mga Filisteo; sapagka't kinukulong ni Nadab at ng buong Israel ang Gibbethon."
            },
            {
              "chapter": 15,
              "verse": 28,
              "name": "1 Mga Hari 15:28",
              "text": "Nang ikatlong taon nga ni Asa na hari sa Juda, ay pinatay siya ni Baasa, at naghari na kahalili niya."
            },
            {
              "chapter": 15,
              "verse": 29,
              "name": "1 Mga Hari 15:29",
              "text": "At nangyari, na pagkapaging hari niya, sinaktan niya ang buong sangbahayan ni Jeroboam, hindi siya nag-iwan kay Jeroboam ng sinomang may hininga, hanggang sa kaniyang nilipol siya, ayon sa sabi ng Panginoon na kaniyang sinalita sa pamamagitan ng kaniyang lingkod na si Ahias na Silonita:"
            },
            {
              "chapter": 15,
              "verse": 30,
              "name": "1 Mga Hari 15:30",
              "text": "Dahil sa mga kasalanan ni Jeroboam na kaniyang ipinagkasala, at kaniyang ipinapagkasala sa Israel; dahil sa kaniyang pamumungkahi na kaniyang iminungkahing galit sa Panginoon, sa Dios ng Israel."
            },
            {
              "chapter": 15,
              "verse": 31,
              "name": "1 Mga Hari 15:31",
              "text": "Ang iba nga sa mga gawa ni Nadab, at ang lahat niyang ginawa, di ba nasusulat sa aklat ng mga alaala sa mga hari sa Israel?"
            },
            {
              "chapter": 15,
              "verse": 32,
              "name": "1 Mga Hari 15:32",
              "text": "At nagkaroon ng pagdidigmaan si Asa at si Baasa na hari sa Israel sa lahat ng kanilang kaarawan."
            },
            {
              "chapter": 15,
              "verse": 33,
              "name": "1 Mga Hari 15:33",
              "text": "Nang ikatlong taon ni Asa na hari sa Juda, ay nagpasimulang maghari si Baasa na anak ni Ahia sa buong Israel sa Thirsa, at naghari na dalawang pu't apat na taon."
            },
            {
              "chapter": 15,
              "verse": 34,
              "name": "1 Mga Hari 15:34",
              "text": "At siya'y gumawa ng masama sa paningin ng Panginoon, at lumakad ng lakad ni Jeroboam, at sa kaniyang kasalanan na ipinapagkasala sa Israel."
            }
          ]
        },
        {
          "chapter": 16,
          "name": "1 Mga Hari 16",
          "verses": [
            {
              "chapter": 16,
              "verse": 1,
              "name": "1 Mga Hari 16:1",
              "text": "At ang salita ng Panginoon ay, dumating kay Jehu na anak ni Hanani, laban kay Baasa, na sinasabi,"
            },
            {
              "chapter": 16,
              "verse": 2,
              "name": "1 Mga Hari 16:2",
              "text": "Yamang itinaas kita mula sa alabok, at ginawa kitang pangulo sa aking bayang Israel; at ikaw ay lumakad ng lakad ni Jeroboam, at iyong pinapagkasala ang aking bayang Israel, upang mungkahiin mo ako sa galit sa pamamagitan ng kanilang mga kasalanan;"
            },
            {
              "chapter": 16,
              "verse": 3,
              "name": "1 Mga Hari 16:3",
              "text": "Narito, aking lubos na papalisin si Baasa at ang kaniyang sangbahayan; at aking gagawin ang iyong sangbahayan na gaya ng sangbahayan ni Jeroboam na anak ni Nabat."
            },
            {
              "chapter": 16,
              "verse": 4,
              "name": "1 Mga Hari 16:4",
              "text": "Ang mamatay kay Baasa sa bayan ay kakanin ng mga aso; at ang mamatay sa kaniya sa parang ay kakanin ng mga ibon sa himpapawid,"
            },
            {
              "chapter": 16,
              "verse": 5,
              "name": "1 Mga Hari 16:5",
              "text": "Ang iba nga sa mga gawa ni Baasa, at ang kaniyang ginawa, at ang kaniyang kapangyarihan, di ba nasusulat sa aklat ng mga alaala sa mga hari sa Israel?"
            },
            {
              "chapter": 16,
              "verse": 6,
              "name": "1 Mga Hari 16:6",
              "text": "At natulog si Baasa na kasama ng kaniyang mga magulang, at nalibing sa Thirsa; at si Ela na kaniyang anak ay naghari na kahalili niya."
            },
            {
              "chapter": 16,
              "verse": 7,
              "name": "1 Mga Hari 16:7",
              "text": "At bukod dito'y, sa pamamagitan ng propetang si Jehu na anak ni Hanani, ay dumating ang salita ng Panginoon laban kay Baasa, at laban sa kaniyang sangbahayan, dahil sa lahat na kasamaan na kaniyang ginawa sa paningin ng Panginoon, upang mungkahiin siya sa galit sa pamamagitan ng gawa ng kaniyang mga kamay, sa pagkagaya sa sangbahayan ni Jeroboam, at sapagka't sinaktan din niya siya."
            },
            {
              "chapter": 16,
              "verse": 8,
              "name": "1 Mga Hari 16:8",
              "text": "Nang ikadalawang pu't anim na taon ni Asa na hari sa Juda ay nagpasimula si Ela na anak ni Baasa na maghari sa Israel sa Thirsa, at nagharing dalawang taon."
            },
            {
              "chapter": 16,
              "verse": 9,
              "name": "1 Mga Hari 16:9",
              "text": "At ang kaniyang lingkod na si Zimri, na punong kawal sa kalahati ng kaniyang mga karo, ay nagbanta laban sa kaniya. Siya'y nasa Thirsa nga, na nagiinom at lasing sa bahay ni Arsa, na siyang katiwala sa sangbahayan sa Thirsa:"
            },
            {
              "chapter": 16,
              "verse": 10,
              "name": "1 Mga Hari 16:10",
              "text": "At pumasok si Zimri, at sinaktan siya, at pinatay siya, nang ikadalawang pu't pitong taon ni Asa na hari sa Juda, at naghari na kahalili niya."
            },
            {
              "chapter": 16,
              "verse": 11,
              "name": "1 Mga Hari 16:11",
              "text": "At nangyari, nang siya'y magpasimulang maghari, pagupo niya sa kaniyang luklukan, ay kaniyang sinaktan ang buong sangbahayan ni Baasa: hindi siya nagiwan ng isa man lamang lalaking bata, kahit kamaganak niya, kahit mga kaibigan niya."
            },
            {
              "chapter": 16,
              "verse": 12,
              "name": "1 Mga Hari 16:12",
              "text": "Ganito nilipol ni Zimri ang buong sangbahayan ni Baasa, ayon sa salita ng Panginoon, na kaniyang sinalita laban kay Baasa, sa pamamagitan ni Jehu na propeta,"
            },
            {
              "chapter": 16,
              "verse": 13,
              "name": "1 Mga Hari 16:13",
              "text": "Dahil sa lahat ng mga kasalanan ni Baasa, at mga kasalanan ni Ela na kaniyang anak, na kanilang ipinagkasala, at kanilang ipinapagkasala sa Israel, upang mungkahiin sa galit ang Panginoon, ang Dios ng Israel sa pamamagitan ng kanilang mga kalayawan."
            },
            {
              "chapter": 16,
              "verse": 14,
              "name": "1 Mga Hari 16:14",
              "text": "Ang iba nga sa mga gawa ni Ela, at ang lahat na kaniyang ginawa, di ba nasusulat sa aklat ng mga alaala sa mga hari sa Israel?"
            },
            {
              "chapter": 16,
              "verse": 15,
              "name": "1 Mga Hari 16:15",
              "text": "Nang ikadalawang pu't pitong taon ni Asa na hari sa Juda, ay naghari si Zimri na pitong araw sa Thirsa. Ang bayan nga ay humantong laban sa Gibbethon na nauukol sa mga Filisteo."
            },
            {
              "chapter": 16,
              "verse": 16,
              "name": "1 Mga Hari 16:16",
              "text": "At narinig ng bayan na nasa hantungan na sinabing nagbanta si Zimri, at sinaktan ang hari: kaya't ginawang hari sa Israel ng buong Israel si Omri na punong kawal ng hukbo nang araw na yaon sa kampamento."
            },
            {
              "chapter": 16,
              "verse": 17,
              "name": "1 Mga Hari 16:17",
              "text": "At si Omri ay umahon mula sa Gibbethon, at ang buong Israel ay kasama niya, at kanilang kinubkob ang Thirsa."
            },
            {
              "chapter": 16,
              "verse": 18,
              "name": "1 Mga Hari 16:18",
              "text": "At nangyari, nang makita ni Zimri na ang bayan ay nasakop, na siya'y naparoon sa castilyo ng bahay ng hari, at sinunog ng apoy ang bahay na kinaroroonan ng hari at siya'y namatay."
            },
            {
              "chapter": 16,
              "verse": 19,
              "name": "1 Mga Hari 16:19",
              "text": "Dahil sa kaniyang mga kasalanan na kaniyang ipinagkasala sa paggawa ng masama sa paningin ng Panginoon sa paglakad sa lakad ni Jeroboam, at sa kaniyang kasalanan na kaniyang ginawa, upang papagkasalahin ang Israel."
            },
            {
              "chapter": 16,
              "verse": 20,
              "name": "1 Mga Hari 16:20",
              "text": "Ang iba nga sa mga gawa ni Zimri, at ang kaniyang panghihimagsik na kaniyang ginawa, di ba nasusulat sa aklat ng mga alaala sa mga hari sa Israel?"
            },
            {
              "chapter": 16,
              "verse": 21,
              "name": "1 Mga Hari 16:21",
              "text": "Nang magkagayo'y ang bayan ng Israel ay nahati sa dalawa: ang kalahati ng bayan ay sumunod kay Thibni na anak ni Gineth, upang gawin siyang hari; at ang kalahati ay sumunod kay Omri."
            },
            {
              "chapter": 16,
              "verse": 22,
              "name": "1 Mga Hari 16:22",
              "text": "Nguni't ang bayan na sumunod kay Omri ay nanaig laban sa bayan na sumunod kay Thibni na anak ni Gineth: sa gayo'y namatay si Thibni at naghari si Omri."
            },
            {
              "chapter": 16,
              "verse": 23,
              "name": "1 Mga Hari 16:23",
              "text": "Nang ikatatlong pu't isang taon ni Asa na hari sa Juda ay nagpasimula si Omri na maghari sa Israel, at naghari na labing dalawang taon: anim na taon na naghari siya sa Thirsa."
            },
            {
              "chapter": 16,
              "verse": 24,
              "name": "1 Mga Hari 16:24",
              "text": "At binili niya ang burol ng Samaria kay Semer sa halagang dalawang talentong pilak; at siya'y nagtayo sa burol, at tinawag ang pangalan ng bayan na kaniyang itinayo, ayon sa pangalan ni Semer, na may-ari ng burol, na Samaria."
            },
            {
              "chapter": 16,
              "verse": 25,
              "name": "1 Mga Hari 16:25",
              "text": "At gumawa si Omri ng masama sa paningin ng Panginoon, at gumawa ng masama na higit kay sa lahat na nauna sa kaniya."
            },
            {
              "chapter": 16,
              "verse": 26,
              "name": "1 Mga Hari 16:26",
              "text": "Sapagka't siya'y lumakad sa buong lakad ni Jeroboam na anak ni Nabat, at sa kaniyang mga kasalanan na ipinapagkasala niya sa Israel, upang mungkahiin sa galit ang Panginoon, ang Dios ng Israel sa pamamagitan ng kanilang mga kalayawan."
            },
            {
              "chapter": 16,
              "verse": 27,
              "name": "1 Mga Hari 16:27",
              "text": "Ang iba nga sa mga gawa ni Omri na kaniyang ginawa, at ang kapangyarihan niya na kaniyang ipinamalas, di ba nasusulat sa mga aklat ng mga alaala sa mga hari sa Israel?"
            },
            {
              "chapter": 16,
              "verse": 28,
              "name": "1 Mga Hari 16:28",
              "text": "Sa gayo'y natulog si Omri na kasama ng kaniyang mga magulang, at nalibing sa Samaria; at si Achab na kaniyang anak ay naghari na kahalili niya."
            },
            {
              "chapter": 16,
              "verse": 29,
              "name": "1 Mga Hari 16:29",
              "text": "At nang ikatatlong pu't walong taon ni Asa na hari sa Juda, ay nagpasimula si Achab na anak ni Omri na maghari sa Israel: at si Achab na anak ni Omri ay naghari sa Israel sa Samaria na dalawang pu't dalawang taon."
            },
            {
              "chapter": 16,
              "verse": 30,
              "name": "1 Mga Hari 16:30",
              "text": "At si Achab na anak ni Omri ay gumawa ng masama sa paningin ng Panginoon na higit kay sa lahat na nauna sa kaniya."
            },
            {
              "chapter": 16,
              "verse": 31,
              "name": "1 Mga Hari 16:31",
              "text": "At nangyari, na wari isang magaang bagay sa kaniya na lumakad sa mga kasalanan ni Jeroboam na anak ni Nabat, na siya'y nagasawa kay Jezabel, na anak ni Ethbaal na hari ng mga Sidonio, at yumaon at naglingkod kay Baal, at sumamba sa kaniya."
            },
            {
              "chapter": 16,
              "verse": 32,
              "name": "1 Mga Hari 16:32",
              "text": "At kaniyang ipinagtayo ng dambana si Baal sa bahay ni Baal na kaniyang itinayo sa Samaria."
            },
            {
              "chapter": 16,
              "verse": 33,
              "name": "1 Mga Hari 16:33",
              "text": "At gumawa si Achab ng Asera; at gumawa pa ng higit si Achab upang mungkahiin ang Panginoon, ang Dios ng Israel, sa galit kay sa lahat ng mga hari sa Israel na nauna sa kaniya."
            },
            {
              "chapter": 16,
              "verse": 34,
              "name": "1 Mga Hari 16:34",
              "text": "Sa kaniyang mga kaarawan itinayo ni Hiel na taga Beth-el ang Jerico: siya'y naglagay ng talagang-baon sa pagkamatay ni Abiram na kaniyang panganay, at itinayo ang mga pintuang-bayan niyaon sa pagkamatay ng kaniyang bunsong anak na si Segub; ayon sa salita ng Panginoon na kaniyang sinalita sa pamamagitan ni Josue na anak ni Nun."
            }
          ]
        },
        {
          "chapter": 17,
          "name": "1 Mga Hari 17",
          "verses": [
            {
              "chapter": 17,
              "verse": 1,
              "name": "1 Mga Hari 17:1",
              "text": "At si Elias na Thisbita, na sa mga nakikipamayan sa Galaad, ay nagsabi kay Achab: Buhay ang Panginoon, ang Dios ng Israel, na ako'y nakatayo sa harap niya hindi magkakaroon ng hamog o ulan man sa mga taong ito, kundi ayon sa aking salita."
            },
            {
              "chapter": 17,
              "verse": 2,
              "name": "1 Mga Hari 17:2",
              "text": "At ang salita ng Panginoon ay dumating sa kaniya, na nagsasabi,"
            },
            {
              "chapter": 17,
              "verse": 3,
              "name": "1 Mga Hari 17:3",
              "text": "Umalis ka rito, at lumiko ka sa dakong silanganan, at magkubli ka sa tabi ng batis Cherith na nasa tapat ng Jordan."
            },
            {
              "chapter": 17,
              "verse": 4,
              "name": "1 Mga Hari 17:4",
              "text": "At mangyayari, na ikaw ay iinom sa batis; at aking iniutos sa mga uwak na pakanin ka roon."
            },
            {
              "chapter": 17,
              "verse": 5,
              "name": "1 Mga Hari 17:5",
              "text": "Sa gayo'y naparoon siya at ginawa ang ayon sa salita ng Panginoon: sapagka't siya'y pumaroon at tumahan sa tabi ng batis Cherith, na nasa tapat ng Jordan."
            },
            {
              "chapter": 17,
              "verse": 6,
              "name": "1 Mga Hari 17:6",
              "text": "At dinadalhan siya ng tinapay at laman ng mga uwak sa umaga, at tinapay at laman sa hapon, at siya'y umiinom sa batis."
            },
            {
              "chapter": 17,
              "verse": 7,
              "name": "1 Mga Hari 17:7",
              "text": "At nangyari, pagkaraan ng sanggayon, na ang batis ay natuyo, sapagka't walang ulan sa lupain."
            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "1 Mga Hari 17:8",
              "text": "At ang salita ng Panginoon ay dumating sa kaniya, na sinasabi,"
            },
            {
              "chapter": 17,
              "verse": 9,
              "name": "1 Mga Hari 17:9",
              "text": "Ikaw ay bumangon, paroon ka sa Sarepta, na nauukol sa Sidon, at tumahan ka roon: narito, aking inutusan ang isang baong babae roon na pakanin ka."
            },
            {
              "chapter": 17,
              "verse": 10,
              "name": "1 Mga Hari 17:10",
              "text": "Sa gayo'y bumangon siya, at naparoon sa Sarepta; at nang siya'y dumating sa pintuan ng bayan, narito, isang baong babae ay nandoon na namumulot ng mga patpat: at tinawag niya siya, at sinabi, Isinasamo ko sa iyo na dalhan mo ako ng kaunting tubig sa inuman, upang aking mainom."
            },
            {
              "chapter": 17,
              "verse": 11,
              "name": "1 Mga Hari 17:11",
              "text": "At nang siya'y yumayaon upang kumuha, tinawag niya siya, at sinabi, Dalhan mo ako, isinasamo ko sa iyo, ng isang subong tinapay sa iyong kamay."
            },
            {
              "chapter": 17,
              "verse": 12,
              "name": "1 Mga Hari 17:12",
              "text": "At kaniyang sinabi, Ang Panginoon mong Dios ay buhay, ako'y wala kahit munting tinapay, kundi isang dakot na harina sa gusi, at kaunting langis sa banga: at, narito, ako'y namumulot ng dalawang patpat, upang ako'y pumasok, at ihanda sa akin at sa aking anak, upang aming makain, bago kami mamatay."
            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "1 Mga Hari 17:13",
              "text": "At sinabi ni Elias sa kaniya, Huwag kang matakot; yumaon ka, at gawin mo ang iyong sinabi, nguni't igawa mo muna ako ng munting tinapay, at ilabas mo sa akin, at pagkatapos ay gumawa ka para sa iyo at para sa iyong anak."
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "1 Mga Hari 17:14",
              "text": "Sapagka't ganito ang sabi ng Panginoon, ng Dios ng Israel, Ang gusi ng harina ay hindi makukulangan, o ang banga ng langis man ay mababawasan hanggang sa araw na magpaulan ang Panginoon sa ibabaw ng lupa."
            },
            {
              "chapter": 17,
              "verse": 15,
              "name": "1 Mga Hari 17:15",
              "text": "At siya'y yumaon, at ginawa ang ayon sa sabi ni Elias: at kumain ang babae, at siya, at ang kaniyang sangbahayan na maraming araw."
            },
            {
              "chapter": 17,
              "verse": 16,
              "name": "1 Mga Hari 17:16",
              "text": "Ang gusi ng harina ay hindi nakulangan, o ang banga ng langis man ay nabawasan, ayon sa salita ng Panginoon, na kaniyang sinalita sa pamamagitan ni Elias."
            },
            {
              "chapter": 17,
              "verse": 17,
              "name": "1 Mga Hari 17:17",
              "text": "At nangyari, pagkatapos ng mga bagay na ito, na ang anak na lalake ng babae, na may-ari ng bahay ay nagkasakit; at ang kaniyang sakit ay malubha, na walang hiningang naiwan sa kaniya."
            },
            {
              "chapter": 17,
              "verse": 18,
              "name": "1 Mga Hari 17:18",
              "text": "At sinabi niya kay Elias, Ano ang ipakikialam ko sa iyo, Oh ikaw na lalake ng Dios? ikaw ay naparito sa akin upang ipaalala mo ang aking kasalanan, at upang patayin ang aking anak!"
            },
            {
              "chapter": 17,
              "verse": 19,
              "name": "1 Mga Hari 17:19",
              "text": "At sinabi niya sa kaniya, Ibigay mo sa akin ang iyong anak. At kinuha niya sa kaniyang kandungan, at dinala sa silid na kaniyang tinatahanan, at inihiga sa kaniyang sariling higaan."
            },
            {
              "chapter": 17,
              "verse": 20,
              "name": "1 Mga Hari 17:20",
              "text": "At siya'y dumaing sa Panginoon, at nagsabi, Oh Panginoon kong Dios, dinalhan mo rin ba ng kasamaan ang bao na aking kinatutuluyan, sa pagpatay sa kaniyang anak?"
            },
            {
              "chapter": 17,
              "verse": 21,
              "name": "1 Mga Hari 17:21",
              "text": "At siya'y umunat sa bata na makaitlo, at dumaing sa Panginoon, at nagsabi, Oh Panginoon kong Dios, idinadalangin ko sa iyo na iyong pabalikin sa kaniya ang kaluluwa ng batang ito."
            },
            {
              "chapter": 17,
              "verse": 22,
              "name": "1 Mga Hari 17:22",
              "text": "At dininig ng Panginoon ang tinig ni Elias; at ang kaluluwa ng bata ay bumalik sa kaniya, at siya'y muling nabuhay."
            },
            {
              "chapter": 17,
              "verse": 23,
              "name": "1 Mga Hari 17:23",
              "text": "At kinuha ni Elias ang bata, at ibinaba sa loob ng bahay na mula sa silid, at ibinigay siya sa kaniyang ina: at sinabi ni Elias, Tingnan mo, ang iyong anak ay buhay."
            },
            {
              "chapter": 17,
              "verse": 24,
              "name": "1 Mga Hari 17:24",
              "text": "At sinabi ng babae kay Elias, Ngayo'y talastas ko na ikaw ay lalake ng Dios, at ang salita ng Panginoon sa iyong bibig ay katotohanan."
            }
          ]
        },
        {
          "chapter": 18,
          "name": "1 Mga Hari 18",
          "verses": [
            {
              "chapter": 18,
              "verse": 1,
              "name": "1 Mga Hari 18:1",
              "text": "At nangyari, pagkaraan ng maraming araw, na ang salita ng Panginoon ay dumating kay Elias, sa ikatlong taon, na nagsasabi, Ikaw ay yumaon, pakita ka kay Achab; at ako'y magpapaulan sa lupa."
            },
            {
              "chapter": 18,
              "verse": 2,
              "name": "1 Mga Hari 18:2",
              "text": "At si Elias ay yumaon napakita kay Achab. At ang kagutom ay malala sa Samaria."
            },
            {
              "chapter": 18,
              "verse": 3,
              "name": "1 Mga Hari 18:3",
              "text": "At tinawag ni Achab si Abdias na siyang katiwala sa bahay. (Si Abdias nga ay natatakot na mainam sa Panginoon:"
