            {
              "chapter": 3,
              "verse": 11,
              "name": "Job 3:11",
              "text": "Bakit hindi pa ako namatay mula sa bahay-bata? Bakit di pa napatid ang aking hininga nang ipanganak ako ng aking ina?"
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Job 3:12",
              "text": "Bakit tinanggap ako ng mga tuhod? O bakit ng mga suso, na aking sususuhin?"
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Job 3:13",
              "text": "Sapagka't ngayon ay nahihiga sana ako at natatahimik; ako sana'y nakakatulog; na napapahinga ako:"
