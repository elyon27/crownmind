            {
              "chapter": 1,
              "verse": 49,
              "name": "Mga Bilang 1:49",
              "text": "Ang lipi lamang ni Levi ang hindi mo bibilangin, ni di mo ilalahok ang bilang nila sa mga anak ni Israel:"
            },
            {
              "chapter": 1,
              "verse": 50,
              "name": "Mga Bilang 1:50",
              "text": "Kundi ipamamahala mo sa mga Levita ang tabernakulo ng patotoo, at ang lahat ng kasangkapan niyaon, at ang lahat ng nauukol doon; kanilang dadalhin ang tabernakulo, at ang lahat ng kasangkapan niyaon; at kanilang pangangasiwaan at sila'y hahantong sa palibot ng tabernakulo."
            },
            {
              "chapter": 1,
              "verse": 51,
              "name": "Mga Bilang 1:51",
              "text": "At pagka ililipat ang tabernakulo ay pagtatanggaltanggalin ng mga Levita: at pagka itatayo ang tabernakulo ay paguugnay-ugnayin ng mga Levita: at ang taga ibang bayan na lumapit ay papatayin."
            },
            {
              "chapter": 1,
              "verse": 52,
              "name": "Mga Bilang 1:52",
              "text": "At ang mga anak ni Israel ay magtatayo ng kanilang mga tolda, na bawa't lalake ay sa kaniyang sariling kampamento at bawa't lalake ay sa siping ng kaniyang sariling watawat ayon sa kanilang mga hukbo."
            },
            {
              "chapter": 1,
              "verse": 53,
              "name": "Mga Bilang 1:53",
              "text": "Datapuwa't ang mga Levita ay magsisitayo sa palibot ng tabernakulo ng patotoo, upang huwag magtaglay ng galit sa kapisanan ng mga anak ni Israel: at ang mga Levita ay mamahala ng tabernakulo ng patotoo."
            },
            {
              "chapter": 1,
              "verse": 54,
              "name": "Mga Bilang 1:54",
              "text": "Gayon ginawa ng mga anak ni Israel; ayon sa lahat na iniutos ng Panginoon kay Moises, ay gayon nila ginawa."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Mga Bilang 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Mga Bilang 2:1",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron, na sinasabi,"
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Mga Bilang 2:2",
              "text": "Ang mga anak ni Israel ay magsisitayo bawa't lalake sa siping ng kaniyang sariling watawat, na may tanda ng mga sangbahayan ng kaniyang mga magulang: sa tapat ng tabernakulo ng kapisanan ay tatayo sila sa palibot."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Mga Bilang 2:3",
              "text": "At yaong tatayo sa dakong silanganan, sa dakong sinisikatan ng araw, ay ang mga sa watawat ng kampamento ng Juda, ayon sa kanilang mga hukbo: at ang magiging prinsipe sa mga anak ni Juda ay si Naason na anak ni Aminadab."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Mga Bilang 2:4",
              "text": "At ang kaniyang hukbo, at yaong nangabilang sa kanila ay pitong pu't apat na libo at anim na raan."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Mga Bilang 2:5",
              "text": "At yaong magsisitayo sa siping niya ay ang lipi ni Issachar: at ang magiging prinsipe sa mga anak ni Issachar ay si Nathanael na anak ni Suar."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Mga Bilang 2:6",
              "text": "At ang kaniyang hukbo, at ang nangabilang niyaon ay limang pu't apat na libo at apat na raan."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Mga Bilang 2:7",
              "text": "At ang lipi ni Zabulon: at ang magiging prinsipe sa mga anak ni Zabulon, ay si Eliab na anak ni Helon:"
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Mga Bilang 2:8",
              "text": "At ang kaniyang hukbo, at ang nangabilang niyaon, ay limang pu't pitong libo at apat na raan."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Mga Bilang 2:9",
              "text": "Lahat ng nangabilang sa kampamento ng Juda ay isang daan at walong pu't anim na libo at apat na raan, ayon sa kanilang mga hukbo. Sila ang unang magsisisulong."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Mga Bilang 2:10",
              "text": "Sa dakong timugan, ay malalagay ang watawat ng kampamento ng Ruben, ayon sa kanilang mga hukbo: at ang magiging prinsipe ng mga anak ni Ruben, ay si Elisur na anak ni Sedeur."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Mga Bilang 2:11",
              "text": "At ang kaniyang hukbo at ang nangabilang niyaon, ay apat na pu't anim na libo at limang daan."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Mga Bilang 2:12",
              "text": "At yaong tatayo sa siping niya ay ang lipi ni Simeon: at ang magiging prinsipe sa mga anak ni Simeon ay si Selumiel na anak ni Zurisaddai."
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Mga Bilang 2:13",
              "text": "At ang kaniyang hukbo at yaong nangabilang sa kanila, ay limang pu't siyam na libo at tatlong daan:"
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Mga Bilang 2:14",
              "text": "At ang lipi ni Gad: at ang magiging prinsipe sa mga anak ni Gad ay si Eliasaph na anak ni Rehuel:"
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Mga Bilang 2:15",
              "text": "At ang kaniyang hukbo, at yaong nangabilang sa kanila, ay apat na pu't limang libo at anim na raan at limang pu."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Mga Bilang 2:16",
              "text": "Lahat ng nangabilang sa kampamento ng Ruben ay isang daan at limang pu't isang libo at apat na raan at limang pu, ayon sa kanilang mga hukbo. At sila ang pangalawang magsisisulong."
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Mga Bilang 2:17",
              "text": "Kung magkagayon, ang tabernakulo ng kapisanan ay susulong na kaakbay ng kampamento ng mga Levita sa gitna ng mga kampamento: ayon sa kanilang pagkahantong, ay gayon sila magsisisulong, na bawa't lalake ay sa kanikaniyang sariling dako, sa siping ng kanilang mga watawat."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "Mga Bilang 2:18",
              "text": "Sa dakong kalunuran ay malalagay ang watawat ng kampamento ng Ephraim, ayon sa kanilang mga hukbo: at ang magiging prinsipe sa mga anak ni Ephraim ay si Elisama na anak ni Ammiud."
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "Mga Bilang 2:19",
              "text": "At ang kaniyang hukbo, at yaong nangabilang sa kanila ay apat na pung libo at limang daan."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "Mga Bilang 2:20",
              "text": "At sa siping niya ay malalagay ang lipi ni Manases at ang magiging prinsipe sa mga anak ni Manases ay si Gamaliel na anak ni Pedasur."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "Mga Bilang 2:21",
              "text": "At ang kaniyang hukbo, at yaong nangabilang sa kanila ay tatlong pu't dalawang libo at dalawang daan:"
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "Mga Bilang 2:22",
              "text": "At ang lipi ni Benjamin: at ang magiging prinsipe sa mga anak ni Benjamin, ay si Abidan na anak ni Gedeon."
            },
            {
              "chapter": 2,
              "verse": 23,
              "name": "Mga Bilang 2:23",
              "text": "At ang kaniyang hukbo, at yaong nangabilang sa kanila, ay tatlong pu't limang libo at apat na raan."
            },
            {
              "chapter": 2,
              "verse": 24,
              "name": "Mga Bilang 2:24",
              "text": "Yaong lahat na nangabilang sa kampamento ng Ephraim ay isang daan at walong libo at isang daan, ayon sa kanilang mga hukbo. At sila ang pangatlong magsisisulong."
            },
            {
              "chapter": 2,
              "verse": 25,
              "name": "Mga Bilang 2:25",
              "text": "Sa dakong hilagaan ay malalagay ang watawat ng kampamento ng Dan, ayon sa kanilang mga hukbo: at ang magiging prinsipe sa mga anak ni Dan, ay si Ahiezer na anak ni Ammisaddai."
            },
            {
              "chapter": 2,
              "verse": 26,
              "name": "Mga Bilang 2:26",
              "text": "At ang kanilang hukbo, at yaong nangabilang sa kanila ay anim na pu't dalawang libo at pitong daan."
            },
            {
              "chapter": 2,
              "verse": 27,
              "name": "Mga Bilang 2:27",
              "text": "At yaong hahantong sa siping niya ay ang lipi ni Aser: at ang magiging prinsipe sa mga anak ni Aser ay si Phegiel na anak ni Ocran:"
            },
            {
              "chapter": 2,
              "verse": 28,
              "name": "Mga Bilang 2:28",
              "text": "At ang kaniyang hukbo, at yaong nangabilang sa kanila ay apat na pu't isang libo at limang daan."
            },
            {
              "chapter": 2,
              "verse": 29,
              "name": "Mga Bilang 2:29",
              "text": "At ang lipi ni Nephtali: at ang magiging prinsipe sa mga anak ni Nephtali ay si Ahira na anak ni Enan."
            },
            {
              "chapter": 2,
              "verse": 30,
              "name": "Mga Bilang 2:30",
              "text": "At ang kaniyang hukbo at yaong nangabilang sa kanila ay limang pu't tatlong libo at apat na raan."
            },
            {
              "chapter": 2,
              "verse": 31,
              "name": "Mga Bilang 2:31",
              "text": "Yaong lahat na nangabilang sa kampamento ng Dan, ay isang daan at limang pu't pitong libo at anim na raan. Sila ang magsisisulong na huli, ayon sa kanilang mga watawat."
            },
            {
              "chapter": 2,
              "verse": 32,
              "name": "Mga Bilang 2:32",
              "text": "Ito ang nangabilang sa mga anak ni Israel, ayon sa mga sangbahayan ng kanilang mga magulang: yaong lahat na nangabilang sa mga kampamento, ayon sa kanilang mga hukbo, ay anim na raan at tatlong libo at limang daan at limang pu."
            },
            {
              "chapter": 2,
              "verse": 33,
              "name": "Mga Bilang 2:33",
              "text": "Datapuwa't ang mga Levita ay hindi ibinilang sa mga anak ni Israel: gaya ng iniutos ng Panginoon kay Moises."
            },
            {
              "chapter": 2,
              "verse": 34,
              "name": "Mga Bilang 2:34",
              "text": "Gayon ginawa ng mga anak ni Israel; ayon sa lahat ng iniutos ng Panginoon kay Moises ay gayon sila humantong sa siping ng kanilang mga watawat, at gayon sila nagsisulong, na bawa't isa'y ayon sa kanilang mga angkan, ayon sa mga sangbahayan ng kanilang mga magulang."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Mga Bilang 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Mga Bilang 3:1",
              "text": "At ito ang mga lahi ni Aaron at ni Moises, nang araw na magsalita ang Panginoon kay Moises sa bundok ng Sinai."
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Mga Bilang 3:2",
              "text": "At ito ang mga pangalan ng mga anak ni Aaron: si Nadab ang panganay, at si Abiu, si Eleazar, at si Ithamar."
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Mga Bilang 3:3",
              "text": "Ito ang mga pangalan ng mga anak ni Aaron, na mga saserdote na pinahiran ng langis, na itinalaga upang mangasiwa sa katungkulang saserdote."
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Mga Bilang 3:4",
              "text": "At si Nadab at si Abiu ay nangamatay sa harap ng Panginoon, nang sila'y maghandog ng ibang apoy sa harap ng Panginoon, sa ilang ng Sinai, at sila'y hindi nagkaanak: at si Eleazar at si Ithamar ay nangasiwa sa katungkulang saserdote sa harap ni Aaron na kanilang ama."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Mga Bilang 3:5",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Mga Bilang 3:6",
              "text": "Ilapit mo ang lipi ni Levi, at ilagay mo sila sa harap ni Aaron na saserdote, upang pangasiwaan nila siya."
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Mga Bilang 3:7",
              "text": "At kanilang gaganapin ang kaniyang katungkulan, at ang katungkulan ng buong kapisanan sa harap ng tabernakulo ng kapisanan upang isagawa ang paglilingkod sa tabernakulo."
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Mga Bilang 3:8",
              "text": "At kanilang iingatan ang lahat ng kasangkapan ng tabernakulo ng kapisanan at ang katungkulan ng mga anak ni Israel upang isagawa ang paglilingkod sa tabernakulo."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Mga Bilang 3:9",
              "text": "At iyong ibibigay ang mga Levita kay Aaron at sa kaniyang mga anak: sila'y tunay na ibinigay sa kaniya sa ganang mga anak ni Israel."
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Mga Bilang 3:10",
              "text": "At iyong ihahalal si Aaron at ang kaniyang mga anak, at kanilang gaganapin ang kanilang pagkasaserdote: at ang taga ibang bayan na lumapit ay papatayin."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Mga Bilang 3:11",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Mga Bilang 3:12",
              "text": "At tungkol sa akin, narito, aking kinuha ang mga Levita sa gitna ng mga anak ni Israel sa halip ng mga panganay na nagbubukas ng bahay-bata sa mga anak ni Israel: at ang mga Levita ay magiging akin:"
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Mga Bilang 3:13",
              "text": "Sapagka't lahat ng mga panganay ay sa akin; sapagka't nang araw na aking lipulin ang lahat ng mga panganay sa lupain ng Egipto ay aking pinapagingbanal sa akin, ang lahat ng mga panganay sa Israel, maging tao at maging hayop: sila'y magiging akin; ako ang Panginoon."
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Mga Bilang 3:14",
              "text": "At sinalita ng Panginoon kay Moises sa ilang ng Sinai, na sinasabi,"
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Mga Bilang 3:15",
              "text": "Bilangin mo ang mga anak ni Levi, ayon sa mga sangbahayan ng kanilang mga magulang, ayon sa kanilang mga angkan: bawa't lalake na mula sa isang buwang gulang na patanda ay bibilangin mo."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Mga Bilang 3:16",
              "text": "At sila'y binilang ni Moises ayon sa salita ng Panginoon, gaya ng iniutos sa kaniya."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Mga Bilang 3:17",
              "text": "At ito ang mga naging anak ni Levi ayon sa kanilang mga pangalan: si Gerson, at si Coath, at si Merari."
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "Mga Bilang 3:18",
              "text": "At ito ang mga pangalan ng mga anak ni Gerson ayon sa kanilang mga angkan: si Libni at si Simei."
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "Mga Bilang 3:19",
              "text": "At ang mga anak ni Coath ayon sa kanilang mga angkan, ay si Amram, at si Izhar, si Hebron, at si Uzziel."
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "Mga Bilang 3:20",
              "text": "At ang mga anak ni Merari ayon sa kanilang mga angkan; ay si Mahali at si Musi. Ito ang mga angkan ng mga Levita ayon sa mga sangbahayan ng kanilang mga magulang."
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Mga Bilang 3:21",
              "text": "Kay Gerson galing ang angkan ng mga Libnita, at ang angkan ng mga Simeita: ito ang mga angkan ng mga Gersonita."
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Mga Bilang 3:22",
              "text": "Yaong nangabilang sa kanila, ayon sa bilang ng lahat ng mga lalake, mula sa isang buwang gulang na patanda, ay pitong libo at limang daan ang nangabilang sa kanila."
            },
            {
              "chapter": 3,
              "verse": 23,
              "name": "Mga Bilang 3:23",
              "text": "Ang mga angkan ng mga Gersonita ay hahantong sa likuran ng tabernakulo sa dakong kalunuran."
            },
            {
              "chapter": 3,
              "verse": 24,
              "name": "Mga Bilang 3:24",
              "text": "At ang magiging prinsipe sa sangbahayan ng mga magulang ng mga Gersonita ay si Eliasaph na anak ni Lael."
            },
            {
              "chapter": 3,
              "verse": 25,
              "name": "Mga Bilang 3:25",
              "text": "At ang magiging katungkulan ng mga anak ni Gerson sa tabernakulo ng kapisanan ay ang tabernakulo, at ang Tolda, ang takip niyaon at ang tabing sa pintuan ng tabernakulo ng kapisanan,"
            },
            {
              "chapter": 3,
              "verse": 26,
              "name": "Mga Bilang 3:26",
              "text": "At ang mga tabing ng looban at ang tabing sa pintuan ng looban na nasa palibot ng tabernakulo at sa palibot ng dambana, at ang mga tali niyaon na naukol sa buong paglilingkod doon."
            },
            {
              "chapter": 3,
              "verse": 27,
              "name": "Mga Bilang 3:27",
              "text": "At kay Coath ang angkan ng mga Amramita at ang angkan ng mga Izharita, at ang angkan ng mga Hebronita, at ang angkan ng mga Uzzielita: ito ang mga angkan ng mga Coathita."
            },
            {
              "chapter": 3,
              "verse": 28,
              "name": "Mga Bilang 3:28",
              "text": "Ayon sa bilang ng lahat na mga lalake, mula sa isang buwang gulang na patanda, ay may walong libo at anim na raang nangamamahala ng katungkulan sa santuario."
            },
            {
              "chapter": 3,
              "verse": 29,
              "name": "Mga Bilang 3:29",
              "text": "Ang mga angkan ng mga anak ni Coath ay magsisihantong sa tagiliran ng tabernakulo, sa dakong timugan."
            },
            {
              "chapter": 3,
              "verse": 30,
              "name": "Mga Bilang 3:30",
              "text": "At ang magiging prinsipe sa sangbahayan ng mga magulang ng mga angkan ng mga Coathita ay si Elisaphan na anak ni Uzziel."
            },
            {
              "chapter": 3,
              "verse": 31,
              "name": "Mga Bilang 3:31",
              "text": "At ang magiging katungkulan nila ay ang kaban, at ang dulang, at ang kandelero, at ang mga dambana, at ang mga kasangkapan ng santuario na kanilang pinangangasiwaan, at ang tabing at ang lahat ng paglilingkod doon."
            },
            {
              "chapter": 3,
              "verse": 32,
              "name": "Mga Bilang 3:32",
              "text": "At si Eleazar na anak ni Aaron na saserdote ay siyang magiging prinsipe ng mga prinsipe ng mga Levita at mamamahala sa mga may katungkulan sa santuario."
            },
            {
              "chapter": 3,
              "verse": 33,
              "name": "Mga Bilang 3:33",
              "text": "Kay Merari ang angkan ng mga Mahalita at angkan ng mga Musita: ito ang mga angkan ni Merari."
            },
            {
              "chapter": 3,
              "verse": 34,
              "name": "Mga Bilang 3:34",
              "text": "At yaong nangabilang sa kanila, ayon sa bilang ng lahat na mga lalake, mula sa isang buwang gulang na patanda, ay anim na libo at dalawang daan."
            },
            {
              "chapter": 3,
              "verse": 35,
              "name": "Mga Bilang 3:35",
              "text": "At ang magiging prinsipe sa sangbahayan ng mga magulang ng mga angkan ni Merari ay si Suriel na anak ni Abihail: sila'y magsisihantong sa tagiliran ng tabernakulo sa dakong hilagaan."
            },
            {
              "chapter": 3,
              "verse": 36,
              "name": "Mga Bilang 3:36",
              "text": "At ang magiging katungkulan ng mga anak ni Merari, ay ang mga tabla ng tabernakulo, at ang mga barakilan, at ang mga haligi, at ang mga tungtungan, at ang lahat ng kasangkapan, at lahat ng paglilingkod doon;"
            },
            {
              "chapter": 3,
              "verse": 37,
              "name": "Mga Bilang 3:37",
              "text": "At ang mga haligi sa palibot ng looban, at ang mga tungtungan, at ang mga tulos, at ang mga tali ng mga yaon."
            },
            {
              "chapter": 3,
              "verse": 38,
              "name": "Mga Bilang 3:38",
              "text": "At yaong lahat na hahantong sa harap ng tabernakulo sa dakong silanganan, sa harap ng tabernakulo ng kapisanan, sa dakong sinisikatan ng araw, ay si Moises, at si Aaron, at ang kaniyang mga anak na mamamahala ng katungkulan sa santuario, upang ganapin ang pamamahala ng mga anak ni Israel: at ang taga ibang bayan na lumapit ay papatayin."
            },
            {
              "chapter": 3,
              "verse": 39,
              "name": "Mga Bilang 3:39",
              "text": "Yaong lahat na nangabilang sa mga Levita na binilang ni Moises at ni Aaron sa utos ng Panginoon ayon sa kanilang mga angkan, lahat ng lalake mula sa isang buwang gulang na patanda, ay dalawang pu't dalawang libo."
            },
            {
              "chapter": 3,
              "verse": 40,
              "name": "Mga Bilang 3:40",
              "text": "At sinabi ng Panginoon kay Moises, Bilangin mo ang lahat ng mga lalaking panganay sa mga anak ni Israel mula sa isang buwang gulang na patanda, at iguhit mo ang bilang ng kanilang mga pangalan."
            },
            {
              "chapter": 3,
              "verse": 41,
              "name": "Mga Bilang 3:41",
              "text": "At iuukol mo sa akin ang mga Levita (ako ang Panginoon) sa halip ng lahat ng mga panganay sa mga anak ni Israel; at ang mga hayop ng mga Levita sa halip ng lahat ng mga panganay sa mga hayop ng mga anak ni Israel."
            },
            {
              "chapter": 3,
              "verse": 42,
              "name": "Mga Bilang 3:42",
              "text": "At binilang ni Moises, gaya ng iniutos sa kaniya ng Panginoon, ang lahat ng mga panganay sa mga anak ni Israel."
            },
            {
              "chapter": 3,
              "verse": 43,
              "name": "Mga Bilang 3:43",
              "text": "At lahat ng mga panganay na lalake ayon sa bilang ng mga pangalan, mula sa isang buwang gulang na patanda, doon sa nangabilang sa kanila, ay dalawang pu't dalawang libo at dalawang daan at pitong pu't tatlo."
            },
            {
              "chapter": 3,
              "verse": 44,
              "name": "Mga Bilang 3:44",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 3,
              "verse": 45,
              "name": "Mga Bilang 3:45",
              "text": "Kunin mo ang mga Levita sa halip ng lahat na mga panganay sa mga anak ni Israel, at ang mga hayop ng mga Levita sa halip ng kanilang mga hayop: at ang mga Levita ay magiging akin; ako ang Panginoon."
            },
            {
              "chapter": 3,
              "verse": 46,
              "name": "Mga Bilang 3:46",
              "text": "At sa ikatutubos sa dalawang daan at pitong pu't tatlong panganay ng mga anak ni Israel na higit sa bilang ng mga Levita,"
            },
            {
              "chapter": 3,
              "verse": 47,
              "name": "Mga Bilang 3:47",
              "text": "Ay kukuha ka ng limang siklo sa bawa't isa ayon sa ulo; ayon sa siklo ng santuario kukunin mo (isang siklo ay dalawang pung gera):"
            },
            {
              "chapter": 3,
              "verse": 48,
              "name": "Mga Bilang 3:48",
              "text": "At ibibigay mo kay Aaron at sa kaniyang mga anak ang salaping ikatutubos na humigit sa bilang nila."
            },
            {
              "chapter": 3,
              "verse": 49,
              "name": "Mga Bilang 3:49",
              "text": "At kinuha ni Moises ang salaping pangtubos sa mga labis na humigit sa mga natubos ng mga Levita:"
            },
            {
              "chapter": 3,
              "verse": 50,
              "name": "Mga Bilang 3:50",
              "text": "Mula sa mga panganay ng mga anak ni Israel kinuha niya ang salapi; isang libo at tatlong daan at anim na pu't limang siklo, ayon sa siklo ng santuario:"
            },
            {
              "chapter": 3,
              "verse": 51,
              "name": "Mga Bilang 3:51",
              "text": "At ibinigay ni Moises kay Aaron at sa kaniyang mga anak ang salaping pangtubos ayon sa salita ng Panginoon, gaya ng iniutos ng Panginoon kay Moises."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Mga Bilang 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Mga Bilang 4:1",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron, na sinasabi,"
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Mga Bilang 4:2",
              "text": "Ayusin ninyo ang bilang ng mga anak ni Coath, sa gitna ng mga anak ni Levi, ayon sa kanilang mga angkan, ayon sa mga sangbahayan ng kanilang mga magulang."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Mga Bilang 4:3",
              "text": "Mula sa tatlong pung taong gulang hanggang sa limang pung taong gulang, lahat ng pumapasok sa paglilingkod, upang gumawa ng gawain sa tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Mga Bilang 4:4",
              "text": "Ito ang paglilingkod ng mga anak ni Coath sa tabernakulo ng kapisanan, sa mga bagay na kabanalbanalan:"
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Mga Bilang 4:5",
              "text": "Pagka ang kampamento ay isusulong, ay papasok si Aaron sa loob, at ang kaniyang mga anak, at kanilang ibababa ang lambong ng tabing, at kanilang tatakpan niyaon ang kaban ng patotoo:"
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Mga Bilang 4:6",
              "text": "At kanilang ilalagay sa ibabaw ang isang takip na balat ng foka at kanilang lalatagan ang ibabaw ng isang kayong taganas na bughaw, at kanilang ilalagay ang mga pingga niyaon."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Mga Bilang 4:7",
              "text": "At sa ibabaw ng dulang ng tinapay na handog ay maglalatag sila ng isang kayong bughaw, at kanilang ilalagay sa ibabaw nito ang mga pinggan, at ang mga sandok, at ang mga mangkok, at ang mga tasa upang buhusan; at ang namamalaging tinapay ay malalagay sa ibabaw niyaon."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Mga Bilang 4:8",
              "text": "At kanilang lalatagan ang ibabaw ng mga yaon ng kayong pula, at kanilang tatakpan ito ng isang panakip na balat ng foka, at kanilang ilalagay ang mga pingga."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Mga Bilang 4:9",
              "text": "At kukuha sila ng isang kayong bughaw at kanilang tatakpan ang kandelerong pangtanglaw at ang mga ilawan, at ang mga gunting, at ang mga pinggan, at ang lahat ng sisidlan ng langis niyaon, na kanilang pinangangasiwaan:"
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Mga Bilang 4:10",
              "text": "At kanilang ilalagay, pati ang lahat ng kasangkapan niyaon sa loob ng isang takip na balat ng foka, at kanilang ilalagay sa ibabaw ng isang patungan."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Mga Bilang 4:11",
              "text": "At ang ibabaw ng dambanang ginto ay kanilang lalatagan ng isang kayong bughaw, at kanilang tatakpan ng isang panakip na balat ng foka, at kanilang ilalagay ang mga pingga niyaon:"
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Mga Bilang 4:12",
              "text": "At kanilang kukunin ang lahat ng mga kasangkapan na ukol sa pangangasiwa na ipinangangasiwa nila sa santuario, at kanilang ilalagay sa isang kayong bughaw, at kanilang tatakpan ng isang panakip na balat ng foka, at kanilang ipapatong sa patungan."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Mga Bilang 4:13",
              "text": "At kanilang aalisin ang mga abo sa dambana at kanilang lalatagan ng isang kayong kulay ube."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Mga Bilang 4:14",
              "text": "At kanilang ipapatong doon ang lahat ng mga kasangkapan na kanilang ipinangangasiwa sa palibot ng dambana, ang suuban at ang mga pangipit, at ang mga pala at ang mga mangkok, lahat ng mga kasangkapan ng dambana; at kanilang lalatagan ng isang panakip na balat ng foka, at kanilang ilalagay ang mga pingga niyaon."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Mga Bilang 4:15",
              "text": "At pagka si Aaron at ang kaniyang mga anak ay nakatapos na makapagtakip sa santuario at sa buong kasangkapan ng santuario, kailan ma't isusulong ang kampamento: ay magsisilapit pagkatapos ang mga anak ni Koath upang kanilang buhatin yaon: datapuwa't huwag silang hihipo sa santuario, baka sila'y mamatay. Ang mga bagay na ito ay siyang pasanin ng mga anak ni Coath sa tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Mga Bilang 4:16",
              "text": "At ang magiging katungkulan ni Eleazar na anak ni Aaron na saserdote, ay ang langis sa ilawan, at ang mabangong kamangyan, at ang palaging handog na harina, at ang langis na pang-pahid, at ang pagiingat ng buong tabernakulo at ng lahat na nandoon, ang santuario at ang mga kasangkapan niyaon."
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Mga Bilang 4:17",
              "text": "At sinalita ng Panginoon kay Moises at kay Aaron, na sinasabi,"
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Mga Bilang 4:18",
              "text": "Huwag ninyong ihiwalay ang lipi ng mga angkan ng mga Coathita sa gitna ng mga Levita."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Mga Bilang 4:19",
              "text": "Kundi gawin ninyo sa kanila ang ganito, upang sila'y mabuhay at huwag mamatay, paglapit nila sa mga kabanalbanalang bagay: si Aaron at ang kaniyang mga anak ay paparoon at ituturo sa bawa't isa ang kanikaniyang paglilingkod at ang kanikaniyang pasanin:"
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Mga Bilang 4:20",
              "text": "Nguni't sila'y huwag magsisipasok upang tingnan ang santuario kahit sandali man, baka sila'y mamatay."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Mga Bilang 4:21",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "Mga Bilang 4:22",
              "text": "Aayusin mo rin ang bilang ng mga anak ni Gerson, ayon sa mga sangbahayan ng kanilang mga magulang ayon sa kanilang mga angkan;"
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "Mga Bilang 4:23",
              "text": "Mula sa tatlong pung taong gulang hanggang sa limang pung taong gulang ay bibilangin mo sila; yaong lahat na pumapasok na nangangasiwa sa paglilingkod upang gawin ang gawain sa tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 24,
              "name": "Mga Bilang 4:24",
              "text": "Ito ang paglilingkod ng mga angkan ng mga Gersonita, sa paglilingkod at sa pagdadala ng mga pasanin:"
            },
            {
              "chapter": 4,
              "verse": 25,
              "name": "Mga Bilang 4:25",
              "text": "Dadalhin nila ang mga tabing ng tabernakulo, at ang tabernakulo ng kapisanan, ang takip niyaon, at ang panakip na balat ng foka na nasa ibabaw nito, at ang tabing sa pintuan ng tabernakulo ng kapisanan;"
            },
            {
              "chapter": 4,
              "verse": 26,
              "name": "Mga Bilang 4:26",
              "text": "At ang mga tabing sa looban, at ang tabing sa pintuang-daan ng looban na nasa siping ng tabernakulo, at ng dambana, at ang mga tali ng mga yaon, at ang lahat ng kasangkapan sa kanilang paglilingkod at ang lahat na marapat na gawin sa mga yaon ay kanilang ipaglilingkod."
            },
            {
              "chapter": 4,
              "verse": 27,
              "name": "Mga Bilang 4:27",
              "text": "Mapapasa kapangyarihan ni Aaron at ng kaniyang mga anak ang buong paglilingkod ng mga anak ng mga Gersonita sa buong kanilang pasanin, at sa buong kanilang paglilingkod: at inyong ituturo sa kanila ang mga nauukol sa kanilang buong pasanin."
            },
            {
              "chapter": 4,
              "verse": 28,
              "name": "Mga Bilang 4:28",
              "text": "Ito ang paglilingkod ng mga angkan ng mga Gersonita sa tabernakulo ng kapisanan: at ang katungkulan nila ay mapapasa ilalim ng pamamahala ni Ithamar na anak ni Aaron na saserdote."
            },
            {
              "chapter": 4,
              "verse": 29,
              "name": "Mga Bilang 4:29",
              "text": "Tungkol sa mga anak ni Merari, ay bibilangin mo sila ayon sa kanilang mga angkan, ayon sa mga sangbahayan ng kanilang mga magulang;"
            },
            {
              "chapter": 4,
              "verse": 30,
              "name": "Mga Bilang 4:30",
              "text": "Mula sa tatlong pung taong gulang na patanda hanggang sa limang pung taong gulang ay iyong bibilangin sila, lahat na pumapasok sa paglilingkod, upang gawin ang gawain sa tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 31,
              "name": "Mga Bilang 4:31",
              "text": "At ito ang katungkulan sa kanilang pasanin ayon sa buong paglilingkod nila sa tabernakulo ng kapisanan: ang mga tabla ng tabernakulo, at ang mga barakilan, at ang mga haligi, at ang mga tungtungan;"
            },
            {
              "chapter": 4,
              "verse": 32,
              "name": "Mga Bilang 4:32",
              "text": "At ang mga haligi sa palibot ng looban, at ang mga tungtungan, at ang mga tulos, at ang mga tali pati ng lahat ng kasangkapan at ng buong paglilingkod: at ayon sa pangalan, ay ituturo mo sa kanila ang mga kasangkapan na katungkulan sa kanilang pasanin."
            },
            {
              "chapter": 4,
              "verse": 33,
              "name": "Mga Bilang 4:33",
              "text": "Ito ang paglilingkod ng mga angkan ng mga anak ni Merari ayon sa buong paglilingkod nila sa tabernakulo ng kapisanan, sa ilalim ng pamamahala ni Ithamar na anak ni Aaron na saserdote."
            },
            {
              "chapter": 4,
              "verse": 34,
              "name": "Mga Bilang 4:34",
              "text": "At binilang ni Moises at ni Aaron, at ng mga prinsipe ng kapisanan ang mga anak ng mga Coathita ayon sa kanilang mga angkan, at ayon sa mga sangbahayan ng kanilang mga magulang,"
            },
            {
              "chapter": 4,
              "verse": 35,
              "name": "Mga Bilang 4:35",
              "text": "Mula sa tatlong pung taong gulang na patanda hanggang sa limang pung taong gulang, ang bawa't isa na pumapasok sa paglilingkod, upang gumawa sa tabernakulo ng kapisanan;"
            },
            {
              "chapter": 4,
              "verse": 36,
              "name": "Mga Bilang 4:36",
              "text": "At yaong nangabilang sa kanila ayon sa kanilang mga angkan, ay dalawang libo at pitong daan at limangpu."
            },
            {
              "chapter": 4,
              "verse": 37,
              "name": "Mga Bilang 4:37",
              "text": "Ito ang nangabilang sa mga angkan ng mga Coathita, lahat ng nagsisipaglingkod sa tabernakulo ng kapisanan na binilang ni Moises at ni Aaron, ayon sa utos ng Panginoon sa pamamagitan ni Moises."
            },
            {
              "chapter": 4,
              "verse": 38,
              "name": "Mga Bilang 4:38",
              "text": "At yaong nangabilang sa mga anak ni Gerson, ang kanilang mga angkan, at ayon sa mga sangbahayan ng kanilang mga magulang,"
            },
            {
              "chapter": 4,
              "verse": 39,
              "name": "Mga Bilang 4:39",
              "text": "Mula sa tatlong pung taong gulang na patanda hanggang sa limang pung taong gulang, bawa't isa na pumapasok sa paglilingkod upang gumawa sa tabernakulo ng kapisanan."
            },
            {
              "chapter": 4,
              "verse": 40,
              "name": "Mga Bilang 4:40",
              "text": "Sa makatuwid baga'y ang nangabilang sa kanila, ayon sa kanilang mga angkan, ayon sa mga sangbahayan ng kanilang mga magulang, ay dalawang libo at anim na raan at tatlong pu."
            },
            {
              "chapter": 4,
              "verse": 41,
              "name": "Mga Bilang 4:41",
              "text": "Ito ang nangabilang sa mga angkan ng mga anak ni Gerson, sa lahat ng naglingkod sa tabernakulo ng kapisanan, na binilang ni Moises at ni Aaron, ayon sa utos ng Panginoon."
            },
            {
              "chapter": 4,
              "verse": 42,
              "name": "Mga Bilang 4:42",
              "text": "At ang nangabilang sa mga angkan ng mga anak ni Merari ayon sa kanilang mga angkan, ayon sa mga sangbahayan ng kanilang mga magulang."
            },
            {
              "chapter": 4,
              "verse": 43,
              "name": "Mga Bilang 4:43",
              "text": "Mula sa tatlong pung taong gulang na patanda hanggang sa limang pung taong gulang, bawa't isa na pumapasok sa paglilingkod, upang gumawa sa tabernakulo ng kapisanan,"
            },
            {
              "chapter": 4,
              "verse": 44,
              "name": "Mga Bilang 4:44",
              "text": "Sa makatuwid baga'y yaong lahat na nangabilang sa kanila ayon sa kanilang mga angkan, ay tatlong libo at dalawang daan."
            },
            {
              "chapter": 4,
              "verse": 45,
              "name": "Mga Bilang 4:45",
              "text": "Ito ang nangabilang sa mga angkan ng mga anak ni Merari na binilang ni Moises at ni Aaron, ayon sa utos ng Panginoon sa pamamagitan ni Moises."
            },
            {
              "chapter": 4,
              "verse": 46,
              "name": "Mga Bilang 4:46",
              "text": "Yaong lahat na nangabilang sa mga Levita, na binilang ni Moises at ni Aaron at ng mga prinsipe sa Israel, ayon sa kanilang mga angkan, at ayon sa mga sangbahayan ng kanilang mga magulang,"
            },
            {
              "chapter": 4,
              "verse": 47,
              "name": "Mga Bilang 4:47",
              "text": "Mula sa tatlong pung taong gulang na patanda hanggang sa limang pung taong gulang, bawa't isa na pumapasok upang gumawa ng gawang paglilingkod, at ng gawang pagdadala ng mga pasanin sa tabernakulo ng kapisanan,"
            },
            {
              "chapter": 4,
              "verse": 48,
              "name": "Mga Bilang 4:48",
              "text": "Sa makatuwid baga'y yaong nangabilang sa kanila, ay walong libo at limang daan at walong pu."
            },
            {
              "chapter": 4,
              "verse": 49,
              "name": "Mga Bilang 4:49",
              "text": "Ayon sa utos ng Panginoon ay nangabilang sa pamamagitan ni Moises, bawa't isa ayon sa kaniyang paglilingkod, at ayon sa kaniyang pasanin: ganito niya binilang sila gaya ng iniutos ng Panginoon kay Moises."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Mga Bilang 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Mga Bilang 5:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Mga Bilang 5:2",
              "text": "Iutos mo sa mga anak ni Israel na ilabas sa kampamento ang bawa't may ketong, at bawa't inaagasan, at ang sinomang karumaldumal sa pagkahipo sa patay:"
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Mga Bilang 5:3",
              "text": "Lalake at babae ay kapuwa ninyo ilalabas, sa labas ng kampamento ilalagay ninyo sila; upang huwag nilang ihawa ang kanilang kampamento na aking tinatahanan sa gitna."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Mga Bilang 5:4",
              "text": "At ginawang gayon ng mga anak ni Israel, at inilabas sa labas ng kampamento: kung paanong sinalita ng Panginoon kay Moises ay gayon ginawa ng mga anak ni Israel."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Mga Bilang 5:5",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Mga Bilang 5:6",
              "text": "Salitain mo sa mga anak ni Israel, Pagka ang isang lalake o babae ay nakagawa ng anomang kasalanan na nagagawa ng mga tao, na sumasalangsang laban sa Panginoon at ang gayong tao ay naging salarin;"
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Mga Bilang 5:7",
              "text": "Ay kaniyang isusulit nga ang kaniyang kasalanang nagawa: at kaniyang pagbabayarang lubos ang kaniyang sala, at dadagdagan pa niya ng ikalimang bahagi at ibibigay sa pinagkasalahan."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Mga Bilang 5:8",
              "text": "Datapuwa't kung ang lalake ay walang kamaganak na mapagbabayaran ng sala, ay mapapasa saserdote ang kabayaran ng sala na handog sa Panginoon, bukod sa tupang lalaking pinakatubos na ipangtutubos sa kaniya."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Mga Bilang 5:9",
              "text": "At ang bawa't handog na itinaas sa lahat ng bagay na banal ng mga anak ni Israel, na kanilang ihaharap sa saserdote ay magiging kaniya."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Mga Bilang 5:10",
              "text": "At ang mga bagay na banal ng bawa't lalake ay magiging kaniya: ang ibigay ng sinomang tao sa saserdote ay magiging kaniya."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Mga Bilang 5:11",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Mga Bilang 5:12",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Kung ang asawa ng sinomang lalake ay malilisya, at sasalangsang sa kaniya,"
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Mga Bilang 5:13",
              "text": "At ang ibang lalake ay sisiping sa kaniya, at ito'y makukubli sa mga mata ng kaniyang asawa at ang bagay ay malilihim, at ang babae ay madudumhan at walang saksi laban sa kaniya, o hindi man matututop siya sa pagkakasala;"
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Mga Bilang 5:14",
              "text": "At ang diwa ng paninibugho ay sasakaniya, at siya'y maninibugho sa kaniyang asawa at siya'y madudumhan: o kung sasakaniya ang diwa ng paninibugho at siya'y maninibugho sa kaniyang asawa, at ito'y hindi madudumhan:"
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Mga Bilang 5:15",
              "text": "Ay dadalhin nga ng lalake sa saserdote ang kaniyang asawa, at ipagdadala ng alay ng babae ng ikasangpung bahagi ng isang epa ng harina ng sebada: hindi niya bubuhusan ng langis o lalagyan man ng kamangyan; sapagka't handog na harina tungkol sa paninibugho, handog na harinang alaala na nagpapaalaala ng kasalanan."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Mga Bilang 5:16",
              "text": "At ilalapit ng saserdote ang babae, at pahaharapin sa Panginoon:"
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Mga Bilang 5:17",
              "text": "At ang saserdote ay kukuha ng banal na tubig sa isang sisidlang lupa: at sa alabok na nasa lapag ng tabernakulo ay dadampot ang saserdote, at ilalagay sa tubig:"
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Mga Bilang 5:18",
              "text": "At pahaharapin ng saserdote ang babae sa Panginoon, at ipalulugay ang buhok ng babae, at ilalagay ang handog na harina na alaala sa kaniyang mga kamay, na handog na harina tungkol sa paninibugho: at tatangnan ng saserdote sa kamay ang mapapait na tubig na nagbubugso ng sumpa:"
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Mga Bilang 5:19",
              "text": "At siya'y papanunumpain ng saserdote, at sasabihin sa babae, Kung walang sumiping sa iyo na ibang lalake, at kung di ka nalisya sa karumihan, sa isang hindi mo asawa, ay maligtas ka nga sa mapapait na tubig na ito na nagbubugso ng sumpa:"
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Mga Bilang 5:20",
              "text": "Datapuwa't kung ikaw ay tunay na nalisya sa iba na di mo asawa, at kung ikaw ay nadumhan, at ibang lalake ay sumiping sa iyo, bukod sa iyong asawa:"
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Mga Bilang 5:21",
              "text": "Ay panunumpain nga ng saserdote ang babae ng panunumpang sumpa, at sasabihin ng saserdote sa babae, Ilagay ka ng Panginoon na pinakasumpa at pinakapula sa gitna ng iyong bayan, kung papanglumuhin ng Panginoon ang iyong hita at pamagain ang iyong tiyan;"
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Mga Bilang 5:22",
              "text": "At ang tubig na ito na nagbubugso ng sumpa ay tatalab sa iyong tiyan, at ang iyong katawan ay pamamagain at ang iyong hita ay panglulumuhin. At ang babae ay magsasabi, Siya nawa, Siya nawa."
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Mga Bilang 5:23",
              "text": "At isusulat ng saserdote ang mga sumpang ito sa isang aklat, at kaniyang buburahin sa mapait na tubig:"
            },
            {
              "chapter": 5,
              "verse": 24,
              "name": "Mga Bilang 5:24",
              "text": "At kaniyang ipaiinom sa babae ang mapait na tubig ng nagbubugso ng sumpa at tatalab sa kaniya ang tubig na nagbubugso ng sumpa, at magiging mapait."
            },
            {
              "chapter": 5,
              "verse": 25,
              "name": "Mga Bilang 5:25",
              "text": "At kukunin ng saserdote sa kamay ng babae ang handog na harina tungkol sa paninibugho at kaniyang aalugin ang handog na harina sa harap ng Panginoon, at dadalhin sa dambana:"
            },
            {
              "chapter": 5,
              "verse": 26,
              "name": "Mga Bilang 5:26",
              "text": "At ang saserdote ay kukuha ng isang dakot ng handog na harina na pinakaalaala niyaon at susunugin sa ibabaw ng dambana, at pagkatapos ay ipaiinom sa babae ang tubig."
            },
            {
              "chapter": 5,
              "verse": 27,
              "name": "Mga Bilang 5:27",
              "text": "At pagka napainom na siya ng tubig, ay mangyayari na kung siya'y nadumhan, at siya'y sumalangsang sa kaniyang asawa, na ang tubig na nagbubugso ng sumpa ay tatalab sa kaniya at magiging mapait, at ang kaniyang katawan ay mamamaga at ang kaniyang hita ay manglulumo: at ang babae ay magiging sumpa sa gitna ng kaniyang bayan."
            },
            {
              "chapter": 5,
              "verse": 28,
              "name": "Mga Bilang 5:28",
              "text": "At kung ang babae ay hindi nadumhan, kundi malinis; ay magiging laya nga at magdadalang-tao."
            },
            {
              "chapter": 5,
              "verse": 29,
              "name": "Mga Bilang 5:29",
              "text": "Ito ang kautusan tungkol sa paninibugho, pagka ang isang babae ay nalilisiya sa lalaking di niya asawa, at nadumhan;"
            },
            {
              "chapter": 5,
              "verse": 30,
              "name": "Mga Bilang 5:30",
              "text": "O pagka ang diwa ng paninibugho ay sumasaisang lalake, at naninibugho sa kaniyang asawa; ay pahaharapin nga ang babae sa Panginoon at gagawin ng saserdote sa kaniya ang buong kautusang ito."
            },
            {
              "chapter": 5,
              "verse": 31,
              "name": "Mga Bilang 5:31",
              "text": "At ang lalake ay maliligtas sa kasamaan, at ang babae ay siyang magdadala ng kaniyang kasamaan."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Mga Bilang 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Mga Bilang 6:1",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Mga Bilang 6:2",
              "text": "Salitain mo sa mga anak ni Israel, at sabihin mo sa kanila, Pagka ang sinomang lalake o babae ay gagawa ng isang tanging panata, ng panata ng isang Nazareo, upang tumalaga sa Panginoon:"
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Mga Bilang 6:3",
              "text": "Ay hihiwalay siya sa alak at sa matapang na inumin; siya'y hindi iinom ng suka ng alak, o tubang nakalalasing, ni iinom man ng anomang katas na galing sa ubas o kakain man ng sariwang ubas o pasas."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Mga Bilang 6:4",
              "text": "Sa lahat ng araw ng kaniyang pagkatalaga ay hindi siya kakain ng anomang bagay na ibinubunga ng puno ng ubas, magmula sa mga butil hanggang sa balat."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Mga Bilang 6:5",
              "text": "Sa lahat ng araw ng kaniyang pagkatalaga ay walang pang-ahit na daraan sa ibabaw ng kaniyang ulo: hanggang sa matupad ang mga araw na kaniyang itinalaga sa Panginoon, ay magpapakabanal siya; kaniyang pababayaang humaba ang buhok ng kaniyang ulo."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Mga Bilang 6:6",
              "text": "Sa lahat ng araw ng kaniyang pagtalaga sa Panginoon, ay huwag siyang lalapit sa patay na katawan."
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Mga Bilang 6:7",
              "text": "Siya'y huwag magpapakarumi sa kaniyang ama o sa kaniyang ina, o sa kaniyang kapatid na lalake, o babae, pagka sila'y namatay: sapagka't ang pagtalaga niya sa Dios, ay sumasa kaniyang ulo."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Mga Bilang 6:8",
              "text": "Sa lahat ng araw ng kaniyang pagtalaga, ay banal siya sa Panginoon."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Mga Bilang 6:9",
              "text": "At kung ang sinoman ay biglang mamatay sa kaniyang siping, at mahawa ang ulo ng kaniyang pagkatalaga: ay aahitan nga niya ang kaniyang ulo sa araw ng paglilinis, sa ikapitong araw ay aahitan niya ito."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Mga Bilang 6:10",
              "text": "At sa ikawalong araw ay magdadala siya ng dalawang batobato o dalawang inakay ng kalapati sa saserdote, sa pintuan ng tabernakulo ng kapisanan."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Mga Bilang 6:11",
              "text": "At ihahandog ng saserdote ang isa na pinakahandog dahil sa kasalanan, at ang isa'y pinakahandog na susunugin at itutubos sa kaniya, sapagka't siya'y nagkasala dahil sa patay, at babanalin ang kaniyang ulo sa araw ding yaon."
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Mga Bilang 6:12",
              "text": "At itatalaga niya sa Panginoon ang mga araw ng kaniyang pagkatalaga, at siya'y magdadala ng isang korderong lalake ng unang taon na pinakahandog dahil sa pagkakasala: datapuwa't ang mga unang araw ay mawawalan ng kabuluhan, sapagka't ang kaniyang pagkatalaga ay nadumhan."
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Mga Bilang 6:13",
              "text": "At ito ang kautusan tungkol sa Nazareo, pagka natupad na ang mga araw ng kaniyang pagkatalaga: siya'y dadalhin sa pintuan ng tabernakulo ng kapisanan;"
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Mga Bilang 6:14",
              "text": "At kaniyang ihahandog ang kaniyang alay sa Panginoon, na isang korderong lalake ng unang taon na walang kapintasan, na pinakahandog na susunugin, at isang korderong babae ng unang taon na walang kapintasan na pinakahandog dahil sa kasalanan at isang tupang lalake na walang kapintasan na pinakahandog tungkol sa kapayapaan,"
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Mga Bilang 6:15",
              "text": "At isang bakol na tinapay na walang lebadura, mga munting tinapay ng mainam na harina na hinaluan ng langis at mga manipis na tinapay na walang lebadura na pinahiran ng langis, at ang handog na harina niyaon at ang mga handog na inumin niyaon."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Mga Bilang 6:16",
              "text": "At ihaharap ng saserdote yaon sa harapan ng Panginoon, at ihahandog ang kaniyang handog dahil sa kasalanan at ang kaniyang handog na susunugin:"
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Mga Bilang 6:17",
              "text": "At kaniyang ihahandog sa Panginoon ang tupang lalake na pinaka-hain na handog tungkol sa kapayapaan na kalakip ng bakol ng mga tinapay na walang lebadura: ihahandog din ng saserdote ang handog na harina niyaon at ang handog na inumin niyaon."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Mga Bilang 6:18",
              "text": "At ang Nazareo ay magaahit ng ulo sa kaniyang pagkatalaga sa pintuan ng tabernakulo ng kapisanan at kaniyang dadamputin ang buhok ng ulo ng kaniyang pagkatalaga at ilalagay sa ibabaw ng apoy na nasa ilalim ng hain na handog tungkol sa kapayapaan."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Mga Bilang 6:19",
              "text": "At kukunin ng saserdote ang lutong balikat ng tupa, at isang munting tinapay na walang lebadura sa bakol, at isang manipis na tinapay na walang lebadura, at ilalagay sa mga kamay ng Nazareo, pagkatapos na makapagahit ng ulo ng kaniyang pagkatalaga:"
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "Mga Bilang 6:20",
              "text": "At aalugin ng saserdote na pinakahandog na inalog sa harapan ng Panginoon; ito'y banal sa saserdote, pati ng dibdib na inalog at ng hitang itinaas; at pagkatapos nito'y ang Nazareo ay makaiinom ng alak."
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "Mga Bilang 6:21",
              "text": "Ito ang kautusan tungkol sa Nazareo na nagpanata, at tungkol sa kaniyang alay sa Panginoon dahil sa kaniyang pagtalaga, bukod pa sa aabutin ng kaniyang mga kaya: ayon sa kaniyang panata na kaniyang ipinanata, ay gayon niya dapat gagawin, ayon sa kautusan tungkol sa kaniyang pagkatalaga."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "Mga Bilang 6:22",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "Mga Bilang 6:23",
              "text": "Salitain mo kay Aaron at sa kaniyang mga anak, na sasabihin, Sa ganitong paraan babasbasan ninyo ang mga anak ni Israel; inyong sasabihin sa kanila:"
            },
            {
              "chapter": 6,
              "verse": 24,
              "name": "Mga Bilang 6:24",
              "text": "Pagpalain ka nawa ng Panginoon at ingatan ka:"
            },
            {
              "chapter": 6,
              "verse": 25,
              "name": "Mga Bilang 6:25",
              "text": "Paliwanagin nawa ng Panginoon ang kaniyang mukha sa iyo, at mahabag sa iyo:"
            },
            {
              "chapter": 6,
              "verse": 26,
              "name": "Mga Bilang 6:26",
              "text": "Ilingap nawa ng Panginoon ang kaniyang mukha sa iyo, at bigyan ka ng kapayapaan."
            },
            {
              "chapter": 6,
              "verse": 27,
              "name": "Mga Bilang 6:27",
              "text": "Gayon nila ilalagay ang aking pangalan sa mga anak ni Israel; at aking pagpapalain sila."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Mga Bilang 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Mga Bilang 7:1",
              "text": "At nangyari ng araw na matapos ni Moises na maitayo ang tabernakulo, at mapahiran ng langis at mapaging banal, pati ng lahat ng kasangkapan niyaon, at ang dambana pati ng lahat na kasangkapan niyaon, at mapahiran ng langis at mapaging banal;"
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Mga Bilang 7:2",
              "text": "Na naghandog ang mga prinsipe sa Israel, ang mga pangulo sa mga sangbahayan ng kanilang mga magulang. Ito ang mga prinsipe sa mga lipi, ito ang mga namamahala roon sa nangabilang:"
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Mga Bilang 7:3",
              "text": "At kanilang dinala ang kanilang alay sa harap ng Panginoon, anim na karitong may takip, at labing dalawang baka; isang kariton sa bawa't dalawa sa mga prinsipe, at sa bawa't isa'y isang baka: at kanilang iniharap sa harapan ng tabernakulo."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Mga Bilang 7:4",
              "text": "At sinalita ng Panginoon kay Moises, na sinasabi,"
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Mga Bilang 7:5",
              "text": "Tanggapin mo sa kanila, upang sila'y gumawa ng paglilingkod sa tabernakulo ng kapisanan, at ibibigay mo sa mga Levita, sa bawa't lalake ang ayon sa kanikaniyang paglilingkod."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Mga Bilang 7:6",
              "text": "At tinanggap ni Moises ang mga kariton at ang mga baka, at ibinigay sa mga Levita."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Mga Bilang 7:7",
              "text": "Dalawang kariton at apat na baka ay ibinigay niya sa mga anak ni Gerson, ayon sa kanilang paglilingkod:"
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Mga Bilang 7:8",
              "text": "At apat na kariton at walong baka ay kaniyang ibinigay sa mga anak ni Merari, ayon sa kanilang paglilingkod, sa ilalim ng pamamahala ni Ithamar na anak ni Aaron na saserdote."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Mga Bilang 7:9",
              "text": "Nguni't sa mga anak ni Coath ay walang ibinigay siya: sapagka't ang paglilingkod sa santuario ay nauukol sa kanila; kanilang pinapasan sa kanilang mga balikat."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Mga Bilang 7:10",
              "text": "At ang mga prinsipe ay naghandog sa pagtatalaga sa dambana noong araw na pahiran ng langis, sa makatuwid baga'y ang mga prinsipe ay naghandog ng kanilang alay sa harap ng dambana."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Mga Bilang 7:11",
              "text": "At sinabi ng Panginoon kay Moises, Sila'y maghahandog ng kanilang alay, na bawa't prinsipe'y sa kaniyang kaarawan, sa pagtatalaga sa dambana."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Mga Bilang 7:12",
              "text": "At ang naghandog ng kaniyang alay nang unang araw ay si Naason na anak ni Aminadab sa lipi ni Juda:"
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Mga Bilang 7:13",
              "text": "At ang kaniyang alay ay isang pinggang pilak, na ang bigat niyaon ay isang daan at tatlong pung siklo, isang mangkok na pilak na ang bigat ay pitong pung siklo ayon sa siklo ng santuario; kapuwa puno ng mainam na harina na hinaluan ng langis, na pinakahandog na harina;"
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Mga Bilang 7:14",
              "text": "Isang kutsarang ginto na ang bigat ay sangpung siklo, na puno ng kamangyan,"
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Mga Bilang 7:15",
              "text": "Isang guyang toro, isang tupang lalake, isang korderong lalake ng unang taon, na handog na susunugin;"
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Mga Bilang 7:16",
              "text": "Isang lalake sa mga kambing na handog dahil sa kasalanan;"
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Mga Bilang 7:17",
              "text": "At sa hain na mga handog tungkol sa kapayapaan, ay dalawang baka, limang tupang lalake, limang kambing na lalake, at limang korderong lalake ng unang taon: ito ang alay ni Naason na anak ni Aminadab."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Mga Bilang 7:18",
              "text": "Nang ikalawang araw, si Nathanael na anak ni Suar, na prinsipe ni Issachar ay naghandog:"
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Mga Bilang 7:19",
              "text": "Kaniyang inihandog na pinakaalay niya, ay isang pinggang pilak na ang bigat ay isang daan at tatlong pung siklo, isang mangkok na pilak na ang bigat ay pitong pung siklo, ayon sa siklo ng santuario; kapuwa puno ng mainam na harina na hinaluan ng langis, na pinakahandog na harina;"
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Mga Bilang 7:20",
              "text": "Isang kutsarang ginto na ang bigat ay sangpung siklo na puno ng kamangyan;"
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Mga Bilang 7:21",
              "text": "Isang guyang toro, isang tupang lalake, isang korderong lalake ng unang taon, na handog na susunugin;"
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Mga Bilang 7:22",
              "text": "Isang lalaking kambing na handog dahil sa kasalanan;"
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Mga Bilang 7:23",
              "text": "At sa hain na mga handog tungkol sa kapayapaan, ay dalawang baka, limang tupang lalake, limang kambing na lalake, at limang korderong lalake ng unang taon: ito ang alay ni Nathanael na anak ni Suar."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Mga Bilang 7:24",
              "text": "Nang ikatlong araw ay si Eliab na anak ni Helon, na prinsipe sa mga anak ni Zabulon:"
            },
            {
              "chapter": 7,
              "verse": 25,
