          ]
        },
        {
          "chapter": 4,
          "name": "Nehemias 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Nehemias 4:1",
              "text": "Nguni't nangyari, na nang mabalitaan ni Sanballat na aming itinayo ang kuta, siya'y naginit, at nagalit na mainam, at tinuya ang mga Judio."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Nehemias 4:2",
              "text": "At siya'y nagsalita sa harap ng kaniyang mga kapatid, at ng hukbo ng Samaria, at nagsabi, Anong ginagawa nitong mahihinang Judio? magpapakatibay ba sila? mangaghahain ba sila? wawakasan ba nila sa isang araw? kanila bang bubuhayin ang mga bato mula sa mga bunton ng dumi, dangang nangasunog na ang mga yaon?"
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Nehemias 4:3",
              "text": "Si Tobias nga na Ammonita ay nasa tabi niya, at sinabi niya, Bagaman sila'y nangagtatayo, kung ang isang zorra ay sumampa, ibabagsak ang kanilang mga batong kuta."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Nehemias 4:4",
              "text": "Dinggin mo, Oh aming Dios: sapagka't kami ay hinamak; at ibalik mo ang kanilang pagdusta sa kanilang sariling ulo, at ibigay mo sila sa pagkasamsam sa isang lupain sa pagkabihag:"
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Nehemias 4:5",
              "text": "At huwag mong ikubli ang kanilang kasamaan, at huwag mong pawiin ang kanilang kasalanan sa harap mo: sapagka't kanilang minungkahi ka sa galit sa harap ng mga manggagawa."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Nehemias 4:6",
              "text": "Sa gayo'y aming itinayo ang kuta; at ang buong kuta ay nahusay hanggang sa kalahatian ng taas niyaon: sapagka't ang bayan ay nagkaroon ng kaloobang gumawa."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Nehemias 4:7",
              "text": "Nguni't nangyari, na nang mabalitaan ni Sanballat, at ni Tobias, at ng mga taga Arabia, at ng mga Ammonita, at ng mga Asdodita, na ipinatuloy ang paghuhusay ng mga kuta ng Jerusalem, at ang mga sira ay pinasimulang tinakpan, sila nga'y nangaginit na mainam;"
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Nehemias 4:8",
              "text": "At nagsipagbanta silang lahat na magkakasama upang magsiparoon, at magsilaban sa Jerusalem, at upang manggulo roon."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Nehemias 4:9",
              "text": "Nguni't kami ay nagsidalangin sa aming Dios, at naglagay ng bantay laban sa kanila araw at gabi, dahil sa kanila."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Nehemias 4:10",
              "text": "At ang Juda ay nagsabi, Nawalan ng lakas ang mga tagadala ng mga pasan, at may maraming dumi; na anopa't hindi kami makapagtayo ng kuta."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Nehemias 4:11",
              "text": "At sinabi ng aming mga kalaban: Sila'y hindi mangakakaalam, o mangakakakita man hanggang sa kami ay magsidating sa gitna nila, at patayin sila, at ipatigil ang gawain."
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Nehemias 4:12",
              "text": "At nangyari, na nang magsidating ang mga Judio na nagsisitahan sa siping nila, sinabi nila sa aming makasangpu, mula sa lahat na dako: Kayo'y marapat magsibalik sa amin."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Nehemias 4:13",
              "text": "Kaya't inilagay ko sa mga pinakamababang dako ng pagitan ng likuran ng kuta, sa mga luwal na dako, sa makatuwid baga'y aking inilagay ang bayan ayon sa kanilang mga angkan, pati ng kanilang mga tabak, ng kanilang mga sibat, at ng kanilang mga busog."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Nehemias 4:14",
              "text": "At ako'y tumingin, at tumayo, at nagsabi sa mga mahal na tao, at sa mga pinuno, at sa nalabi sa bayan: Huwag kayong mangatakot sa kanila: inyong alalahanin ang Panginoon, na dakila at kakilakilabot, at ipakipaglaban ninyo ang inyong mga kapatid, ang inyong mga anak na lalake at babae, ang inyong mga asawa at ang inyong mga bahay."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Nehemias 4:15",
              "text": "At nangyari, nang mabalitaan ng aming mga kaaway na naalaman namin, at iniuwi sa wala ng Dios ang kanilang payo, na kami na nagsibalik na lahat sa kuta, bawa't isa'y sa kaniyang gawa."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Nehemias 4:16",
              "text": "At nangyari, mula nang panahong yaon, na kalahati sa aking mga lingkod ay nagsigawa sa gawain, at kalahati sa kanila ay nagsisihawak ng mga sibat, mga kalasag, at mga busog, at ng mga baluti; at ang mga pinuno ay nangasa likuran ng buong sangbahayan ng Juda."
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Nehemias 4:17",
              "text": "Silang nangagtayo ng kuta, at silang nangagpapasan ng mga pasan ay nagsipagsakbat, bawa't isa'y may isa ng kaniyang mga kamay na iginagawa sa gawain, at may isa na inihahawak ng kaniyang sakbat;"
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Nehemias 4:18",
              "text": "At ang mga manggagawa, bawa't isa'y may kaniyang tabak na nakasabit sa kaniyang tagiliran, at gayon gumagawa. At ang nagpapatunog ng pakakak ay nasa siping ko."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Nehemias 4:19",
              "text": "At sinabi ko sa mga mahal na tao at sa mga pinuno, at sa nalabi sa bayan: Ang gawain ay malaki at malaon, at tayo'y nangagkakahiwalay sa kuta, isa'y malayo sa isa:"
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Nehemias 4:20",
              "text": "Sa anomang dako na inyong marinig ang tunog ng pakakak, ay makipisan kayo sa amin; ipakikipaglaban tayo ng ating Dios."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Nehemias 4:21",
              "text": "Ganito nagsigawa kami sa gawain: at kalahati sa kanila ay nagsisihawak ng mga sibat mula sa pagbubukang liwayway hanggang sa ang mga bituin ay magsilitaw."
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "Nehemias 4:22",
              "text": "Sinabi ko rin nang panahong yaon sa bayan: Magsitahan bawa't isa sa Jerusalem, na kasama ng kanikaniyang lingkod upang sa gabi ay maging bantay sila sa atin, at makagawa sa araw."
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "Nehemias 4:23",
              "text": "Sa gayo'y maging ako, ni ang aking mga kapatid man, ni ang aking mga lingkod man, ni ang mga lalake mang bantay na nagsisisunod sa akin, ay walang naghubad sa amin ng aming mga suot, na bawa't isa'y yumaon na may kaniyang sandata sa tubig."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Nehemias 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Nehemias 5:1",
              "text": "Nang magkagayo'y umalingawngaw ang malakas na daing ng bayan at ng kanilang mga asawa laban sa kanilang mga kapatid na mga Judio,"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Nehemias 5:2",
              "text": "Sapagka't may nagsisipagsabi, Kami, ang aming mga anak na lalake at babae ay marami: tulutan kaming magsikuha ng trigo, upang aming makain at mabuhay kami."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Nehemias 5:3",
              "text": "May nagsisipagsabi naman: Aming isinasangla ang aming mga bukid at ang aming mga ubasan, at ang aming mga bahay: tulutan kaming magsikuha ng trigo, dahil sa kasalatan."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Nehemias 5:4",
              "text": "May nagsisipagsabi naman: Aming ipinangutang ng salapi ang buwis sa hari na hinihingi sa aming mga bukid at aming mga ubasan."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Nehemias 5:5",
              "text": "Gayon ma'y ang aming laman ngayon ay gaya ng laman ng aming mga kapatid, ang aming mga anak ay gaya ng kanilang mga anak: at, narito, aming dinadala sa pagkaalipin ang aming mga anak na lalake at babae upang maging mga alipin, at ang iba sa aming mga anak na babae ay nangadala sa pagkaalipin: wala man lamang kaming kapangyarihang makatulong; sapagka't ibang mga tao ang nagtatangkilik ng aming bukid at ng aming mga ubasan."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Nehemias 5:6",
              "text": "At ako'y nagalit na mainam, nang aking marinig ang kanilang daing at ang mga salitang ito."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Nehemias 5:7",
              "text": "Nang magkagayo'y sumangguni ako sa aking sarili, at nakipagtalo ako sa mga mahal na tao at sa mga pinuno, at nagsabi sa kanila, Kayo'y nangagpapatubo, bawa't isa sa kaniyang kapatid. At ako'y nagdaos ng malaking kapulungan laban sa kanila."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Nehemias 5:8",
              "text": "At sinabi ko sa kanila, Kami ayon sa aming kaya ay aming tinubos ang aming mga kapatid na mga Judio, na mga naipagbili sa mga bansa; at inyo ba ring ipagbibili ang inyong mga kapatid, at sila'y maipagbibili sa amin? Nang magkagayo'y nagsitahimik sila, at hindi nakasumpong kailan man ng salita."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Nehemias 5:9",
              "text": "Sinabi ko rin, Ang bagay na inyong ginagawa ay hindi mabuti: hindi ba kayo marapat magsilakad sa takot sa ating Dios, dahil sa pagdusta ng mga bansa, na ating mga kaaway?"
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Nehemias 5:10",
              "text": "At ako'y gayon din, ang aking mga kapatid at ang aking mga lingkod ay nangutang sa kanila ng salapi at trigo. Isinasamo ko sa inyo na ating iwan ang patubong ito."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Nehemias 5:11",
              "text": "Isinasamo ko sa inyo, na isauli ninyo sa kanila, sa araw ding ito, ang kanilang mga bukid, at ang kanilang mga ubasan, ang kanilang mga olibohan, at ang kanilang mga bahay, gayon din ang ikasangdaang bahagi ng salapi, at ng trigo, ng alak, at ng langis, na inyong hinihingi sa kanila."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Nehemias 5:12",
              "text": "Nang magkagayo'y sinabi nila, Aming isasauli, at wala kaming hihilingin sa kanila; gayon namin gagawin, gaya ng iyong sinasabi. Nang magkagayo'y tinawag ko ang mga saserdote at pinanumpa ko sila, na sila'y magsisigawa ng ayon sa pangakong ito."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Nehemias 5:13",
              "text": "Ipinagpag ko naman ang aking laylayan, at ako'y nagsabi, Ganito ipagpag ng Dios ang bawa't tao mula sa kaniyang bahay, at mula sa kaniyang gawain, na hindi tumupad ng pangakong ito; sa makatuwid baga'y ganito ipagpag siya, at mahungkag. At ang buong kapisanan ay nagsabi, Siya nawa, at pumuri sa Panginoon. At ginawa ng bayan ayon sa pangakong ito."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Nehemias 5:14",
              "text": "Bukod dito'y mula sa panahon na ako'y mahalal na kanilang tagapamahala sa lupain ng Juda, mula sa ikadalawang pung taon hanggang sa ikatatlong pu't dalawang taon ni Artajerjes na hari, sa makatuwid baga'y labing dalawang taon, ako at ang aking mga kapatid ay hindi nagsikain ng tinapay ng tagapamahala."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Nehemias 5:15",
              "text": "Nguni't ang mga dating tagapamahala na una sa akin ay naging pasan sa bayan, at kumuha sa kanila ng tinapay at alak, bukod sa apat na pung siklong pilak; oo, pati ng kanilang mga lingkod ay nagpupuno sa bayan: nguni't ang gayon ay hindi ko ginawa, dahil sa takot sa Dios."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Nehemias 5:16",
              "text": "Oo, ako nama'y nagpatuloy sa gawain ng kutang ito, ni hindi man lamang kami nagsibili ng anomang lupain: at ang lahat ng aking mga lingkod ay nagpipisan doon sa gawain."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Nehemias 5:17",
              "text": "Bukod dito'y nagkaroon sa dulang ko ng mga Judio at mga pinuno na isang daan at limang pung tao, bukod sa nagsiparoon sa amin na mula sa mga bansa na nasa palibot namin."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Nehemias 5:18",
              "text": "Ang inihahanda nga sa bawa't araw ay isang baka at anim na piling tupa; mga ibon naman ay nahanda sa akin, at minsan sa sangpung araw ay sarisaring alak na masagana: gayon ma'y sa lahat ng ito ay hindi ako humingi ng tinapay sa tagapamahala, sapagka't ang pagkaalipin ay mabigat sa bayang ito."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Nehemias 5:19",
              "text": "Alalahanin mo ako, Oh aking Dios, sa ikabubuti, lahat na aking ginawa dahil sa bayang ito."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Nehemias 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Nehemias 6:1",
              "text": "Nangyari nga nang maibalita kay Sanballat at kay Tobias, at kay Gesem na taga Arabia, at sa nalabi sa aming mga kaaway, na aking naitayo na ang kuta, at wala nang sirang naiiwan doon; (bagaman hanggang sa panahong yaon ay hindi ko pa nailalagay ang mga pinto sa mga pintuang-bayan;)"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Nehemias 6:2",
              "text": "Na si Sanballat at si Gesem ay nagsugo sa akin, na nagpapasabi, Ikaw ay parito, magkikita tayo sa isa ng mga nayon sa mga kapatagan ng Ono. Nguni't pinagisipan nila akong gawan ng masama."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Nehemias 6:3",
              "text": "At ako'y nagsugo ng mga sugo sa kanila, na nangagsasabi, Ako'y gumagawa ng dakilang gawain, na anopa't hindi ako makababa: bakit ititigil ang gawain, habang aking maiiwan, at binababa kayo?"
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Nehemias 6:4",
              "text": "At sila'y nangagsugo sa aking makaapat sa dahilang ito; at sinagot ko sila ng ayon sa gayon ding paraan."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Nehemias 6:5",
              "text": "Nang magkagayo'y sinugo ni Sanballat ang kaniyang lingkod sa akin ng gaya ng paraan ng ikalima na may bukas na sulat sa kaniyang kamay."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Nehemias 6:6",
              "text": "Na kinasusulatan: Naibalita sa mga bansa, at sinasabi ni Gasmu na ikaw at ang mga Judio ay nagaakalang manghimagsik; na siyang kadahilanan ng iyong pagtatayo ng kuta: at ikaw ay magiging kanilang hari ayon sa mga salitang ito."
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Nehemias 6:7",
              "text": "At ikaw naman ay naghalal ng mga propeta upang magsipangaral tungkol sa iyo sa Jerusalem, na nangagsasabi, May isang hari sa Juda; at ngayo'y ibabalita sa hari ang ayon sa mga salitang ito. Parito ka nga ngayon, at magsanggunian tayo."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Nehemias 6:8",
              "text": "Nang magkagayo'y nagsugo ako sa kaniya, na aking sinasabi, Walang ganyang mga bagay na nagawa na gaya ng iyong sinasabi, kundi iyong mga pinagbubuhat sa iyong sariling puso."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Nehemias 6:9",
              "text": "Sapagka't ibig nilang lahat na sidlan ng takot kami, na sinasabi, Ang kanilang mga kamay ay manganghihina sa gawain na anopa't hindi mayayari. Nguni't ngayon, Oh Dios, palakasin mo ang aking mga kamay."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Nehemias 6:10",
              "text": "At ako'y naparoon sa bahay ni Semaias na anak ni Delaias na anak ni Mehetabeel na nakulong; at kaniyang sinabi, Tayo'y magpupulong na magkakasama sa bahay ng Dios, sa loob ng templo, at ating isara ang mga pinto ng templo: sapagka't sila'y magsisiparito upang patayin ka; oo, sa kinagabiha'y magsisiparito sila upang patayin ka."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Nehemias 6:11",
              "text": "At aking sinabi, Tatakas ba ang isang lalaking gaya ko? at sino kaya; na sa paraang gaya ko, ay paroroon sa templo upang iligtas ang kaniyang buhay? hindi ako papasok."
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Nehemias 6:12",
              "text": "At nahalata ko, at, narito, hindi siya sinugo ng Dios; kundi kaniyang sinaysay ang hulang ito laban sa akin: at inupahan siya ni Tobias, at ni Sanballat."
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Nehemias 6:13",
              "text": "Dahil sa bagay na ito inupahan siya, upang ako'y matakot, at gumawa ng gayon, at magkasala, at upang sila'y magkaroon ng dahilan sa isang masamang pinaka hiwatig, upang kanilang madusta ako."
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Nehemias 6:14",
              "text": "Alalahanin mo, Oh aking Dios, si Tobias at si Sanballat ayon sa ganitong mga gawa nila, at gayon din ang propetisa na Noadias, at ang nalabi sa mga propeta, na ibig nilang sidlan ako ng katakutan."
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Nehemias 6:15",
              "text": "Sa gayo'y natapos ang kuta sa ikadalawang pu't limang araw ng buwan ng Elul, sa limang pu't dalawang araw."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Nehemias 6:16",
              "text": "At nangyari, nang mabalitaan ng lahat naming mga kaaway, na ang lahat ng mga bansa na nangasa palibot namin ay nangatakot, at nangalumatang mainam: sapagka't kanilang nahalata na ang gawang ito ay gawa ng aming Dios."
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Nehemias 6:17",
              "text": "Bukod dito'y sa mga araw na yao'y ang mga mahal na tao sa Juda ay nangagpadala ng maraming sulat kay Tobias at ang mga sulat ni Tobias ay dumating sa kanila."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Nehemias 6:18",
              "text": "Sapagka't marami sa Juda na nanganumpa sa kaniya, sapagka't siya'y manugang ni Sechanias na anak ni Arah; at ang kaniyang anak na si Johanan ay nagasawa sa anak na babae ni Mesullam na anak ni Berechias."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Nehemias 6:19",
              "text": "Sila nama'y nangagsalita ng kaniyang mga mabuting gawa sa harap ko, at ibinalita ang aking mga salita sa kaniya. At si Tobias ay nagpadala ng mga sulat upang sidlan ako ng katakutan."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Nehemias 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Nehemias 7:1",
              "text": "Nangyari nga nang ang kuta ay maitayo, at aking mailagay ang mga pinto, at ang mga tagatanod-pinto, at ang mga mangaawit, at ang mga Levita ay mangahalal."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Nehemias 7:2",
              "text": "Na aking ibinigay kay Hanani, na aking kapatid at kay Hananias na tagapamahala ng kuta, ang pamamahala sa Jerusalem: sapagka't siya'y tapat na lalake at natatakot sa Dios na higit kay sa marami."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Nehemias 7:3",
              "text": "At aking sinabi sa kanila, Huwag buksan ang mga pintuang-bayan ng Jerusalem hanggang sa ang araw ay uminit; at samantalang sila'y nangagbabantay, isara nila ang mga pinto, at inyong mga itrangka: at kayo'y mangaghalal ng mga bantay sa mga taga Jerusalem, bawa't isa'y sa kaniyang pagbabantay, at bawa't isa'y sa tapat ng kaniyang bahay."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Nehemias 7:4",
              "text": "Ang bayan nga ay maluwang at malaki: nguni't ang mga tao ay kakaunti roon, at ang mga bahay ay hindi naitatayo pa."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Nehemias 7:5",
              "text": "At inilagak ng aking Dios sa aking puso na pisanin ang mga mahal na tao, at ang mga pinuno, at ang bayan, upang mangabilang ayon sa talaan ng lahi. At aking nasumpungan ang aklat ng talaan ng lahi nila na nagsiahon noong una, at aking nasumpungang nakasulat doon:"
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Nehemias 7:6",
              "text": "Ang mga ito sa nangadala, ang mga anak ng lalawigan, na nagsiahon mula sa pagkabihag na dinala ni Nabucodonosor na hari sa Babilonia, at nagsibalik sa Jerusalem at sa Juda, na bawa't isa'y sa kaniyang bayan;"
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Nehemias 7:7",
              "text": "Na siyang nagsisama kay Zorobabel, kay Jesua, kay Nehemias, kay Azarias, kay Raamias, kay Nahamani, kay Mardocheo, kay Bilsan, kay Misperet, kay Bigvai, kay Nehum, kay Baana. Ang bilang ng mga lalake ng Israel ay ito:"
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Nehemias 7:8",
              "text": "Ang mga anak ni Paros, dalawang libo't isang daan at pitong pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Nehemias 7:9",
              "text": "Ang mga anak ni Sephatias, tatlong daan at pitong pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Nehemias 7:10",
              "text": "Ang mga anak ni Ara, anim na raan at limang pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Nehemias 7:11",
              "text": "Ang mga anak ni Pahath-moab, sa mga anak ni Jesua at ni Joab, dalawang libo't walong daan at labing walo."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Nehemias 7:12",
              "text": "Ang mga anak ni Elam, isang libo't dalawang daan at limang pu't apat."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Nehemias 7:13",
              "text": "Ang mga anak ni Zattu, walong daan at apat na pu't lima."
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Nehemias 7:14",
              "text": "Ang mga anak ni Zachai, pitong daan at anim na pu."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Nehemias 7:15",
              "text": "Ang mga anak ni Binnui, anim na raan at apat na pu't walo."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Nehemias 7:16",
              "text": "Ang mga anak ni Bebai, anim na raan at dalawang pu't walo."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Nehemias 7:17",
              "text": "Ang mga anak ni Azgad, dalawang libo't tatlong daan at dalawang pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Nehemias 7:18",
              "text": "Ang mga anak ni Adonicam, anim na raan at anim na pu't pito."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Nehemias 7:19",
              "text": "Ang mga anak ni Bigvai, dalawang libo't anim na pu't pito."
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Nehemias 7:20",
              "text": "Ang mga anak ni Addin, anim na raan at limang pu't lima."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Nehemias 7:21",
              "text": "Ang mga anak ni Ater, ni Ezechias, siyam na pu't walo."
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Nehemias 7:22",
              "text": "Ang mga anak ni Hasum, tatlong daan at dalawang pu't walo."
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Nehemias 7:23",
              "text": "Ang mga anak ni Besai, tatlong daan at dalawang pu't apat."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Nehemias 7:24",
              "text": "Ang mga anak ni Hariph, isang daan at labing dalawa."
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "Nehemias 7:25",
              "text": "Ang mga anak ni Gabaon, siyam na pu't lima."
            },
            {
              "chapter": 7,
              "verse": 26,
              "name": "Nehemias 7:26",
              "text": "Ang mga lalake ng Bethlehem, at ng Netopha, isang daan at walong pu't walo."
            },
            {
              "chapter": 7,
              "verse": 27,
              "name": "Nehemias 7:27",
              "text": "Ang mga lalake ng Anathoth, isang daan at dalawang pu't walo."
            },
            {
              "chapter": 7,
              "verse": 28,
              "name": "Nehemias 7:28",
              "text": "Ang mga lalake ng Beth-azmaveth, apat na pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 29,
              "name": "Nehemias 7:29",
              "text": "Ang mga lalake ng Chiriathjearim, ng Chephra, at ng Beeroth, pitong daan at apat na pu't tatlo."
            },
            {
              "chapter": 7,
              "verse": 30,
              "name": "Nehemias 7:30",
              "text": "Ang mga lalake ng Rama, at ng Gebaa, anim na raan at dalawang pu't isa."
            },
            {
              "chapter": 7,
              "verse": 31,
              "name": "Nehemias 7:31",
              "text": "Ang mga lalake ng Michmas, isang daan at dalawang pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 32,
              "name": "Nehemias 7:32",
              "text": "Ang mga lalake ng Beth-el at ng Ai isang daan at dalawang pu't tatlo."
            },
            {
              "chapter": 7,
              "verse": 33,
              "name": "Nehemias 7:33",
              "text": "Ang mga lalake ng isang Nebo, limang pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 34,
              "name": "Nehemias 7:34",
              "text": "Ang mga anak ng isang Elam, isang libo't dalawang daan at limang pu't apat."
            },
            {
              "chapter": 7,
              "verse": 35,
              "name": "Nehemias 7:35",
              "text": "Ang mga anak ni Harim, tatlong daan at dalawang pu."
            },
            {
              "chapter": 7,
              "verse": 36,
              "name": "Nehemias 7:36",
              "text": "Ang mga anak ni Jerico, tatlong daan at apat na pu't lima."
            },
            {
              "chapter": 7,
              "verse": 37,
              "name": "Nehemias 7:37",
              "text": "Ang mga anak ni Lod, ni Hadid, at ni Ono, pitong daan at dalawang pu't isa."
            },
            {
              "chapter": 7,
              "verse": 38,
              "name": "Nehemias 7:38",
              "text": "Ang mga anak ni Senaa, tatlong libo at siyam na raan at tatlong pu."
            },
            {
              "chapter": 7,
              "verse": 39,
              "name": "Nehemias 7:39",
              "text": "Ang mga saserdote: ang mga anak ni Jedaias sa sangbahayan ni Jesua, siyam na raan at pitong pu't tatlo."
            },
            {
              "chapter": 7,
              "verse": 40,
              "name": "Nehemias 7:40",
              "text": "Ang mga anak ni Immer, isang libo't limang pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 41,
              "name": "Nehemias 7:41",
              "text": "Ang mga anak ni Pashur, isang libo't dalawang daan at apat na pu't pito."
            },
            {
              "chapter": 7,
              "verse": 42,
              "name": "Nehemias 7:42",
              "text": "Ang mga anak ni Harim, isang libo't labing pito."
            },
            {
              "chapter": 7,
              "verse": 43,
              "name": "Nehemias 7:43",
              "text": "Ang mga Levita: ang mga anak ni Jesua, ni Cadmiel, sa mga anak ni Odevia, pitong pu't apat."
            },
            {
              "chapter": 7,
              "verse": 44,
              "name": "Nehemias 7:44",
              "text": "Ang mga mangaawit: ang mga anak ni Asaph isang daan at apat na pu't walo."
            },
            {
              "chapter": 7,
              "verse": 45,
              "name": "Nehemias 7:45",
              "text": "Ang mga tagatanod-pinto: ang mga anak ni Sallum, ang mga anak ni Ater, ang mga anak ni Talmon, ang mga anak ni Accub, ang mga anak ni Hatita, ang mga anak ni Sobai, isang daan at tatlong pu't walo."
            },
            {
              "chapter": 7,
              "verse": 46,
              "name": "Nehemias 7:46",
              "text": "Ang mga Nethineo: ang mga anak ni Siha, ang mga anak ni Hasupha, ang mga anak ni Thabaoth;"
            },
            {
              "chapter": 7,
              "verse": 47,
              "name": "Nehemias 7:47",
              "text": "Ang mga anak ni Ceros, ang mga anak ni Siaa, ang mga anak ni Phadon:"
            },
            {
              "chapter": 7,
              "verse": 48,
              "name": "Nehemias 7:48",
              "text": "Ang mga anak ni Lebana, ang mga anak ni Hagaba, ang mga anak ni Salmai;"
            },
            {
              "chapter": 7,
              "verse": 49,
              "name": "Nehemias 7:49",
              "text": "Ang mga anak ni Hanan, ang mga anak ni Giddel, ang mga anak ni Gahar;"
            },
            {
              "chapter": 7,
              "verse": 50,
              "name": "Nehemias 7:50",
              "text": "Ang mga anak ni Rehaia, ang mga anak ni Resin, ang mga anak ni Necoda;"
            },
            {
              "chapter": 7,
              "verse": 51,
              "name": "Nehemias 7:51",
              "text": "Ang mga anak ni Gazzam, ang mga anak ni Uzza, ang mga anak ni Phasea;"
            },
            {
              "chapter": 7,
              "verse": 52,
              "name": "Nehemias 7:52",
              "text": "Ang mga anak ni Besai, ang mga anak ni Meunim, ang mga anak ni Nephisesim;"
            },
            {
              "chapter": 7,
              "verse": 53,
              "name": "Nehemias 7:53",
              "text": "Ang mga anak ni Bacbuc, ang mga anak ni Hacupha, ang mga anak ni Harhur;"
            },
            {
              "chapter": 7,
              "verse": 54,
              "name": "Nehemias 7:54",
              "text": "Ang mga anak ni Baslit, ang mga anak ni Mehida, ang mga anak ni Harsa;"
            },
            {
              "chapter": 7,
              "verse": 55,
              "name": "Nehemias 7:55",
              "text": "Ang mga anak ni Barcos, ang mga anak ni Sisera, ang mga anak ni Tema;"
            },
            {
              "chapter": 7,
              "verse": 56,
              "name": "Nehemias 7:56",
              "text": "Ang mga anak ni Nesia, ang mga anak ni Hatipha."
            },
            {
              "chapter": 7,
              "verse": 57,
              "name": "Nehemias 7:57",
              "text": "Ang mga anak ng mga lingkod ni Salomon; ang mga anak ni Sotai, ang mga anak ni Sophereth, ang mga anak ni Perida;"
            },
            {
              "chapter": 7,
              "verse": 58,
              "name": "Nehemias 7:58",
              "text": "Ang mga anak ni Jahala, ang mga anak ni Darcon, ang mga anak ni Giddel;"
            },
            {
              "chapter": 7,
              "verse": 59,
              "name": "Nehemias 7:59",
              "text": "Ang mga anak ni Sephatias, ang mga anak ni Hattil, ang mga anak ni Pochereth-hassebaim, ang mga anak ni Amon."
            },
            {
              "chapter": 7,
              "verse": 60,
              "name": "Nehemias 7:60",
              "text": "Lahat ng Nethineo, at ang mga anak ng mga lingkod ni Salomon, ay tatlong daan at siyam na pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 61,
              "name": "Nehemias 7:61",
              "text": "At ang mga ito ang nagsiahon mula sa Telmelah, Telharsa, Cherub, Addon, at Immer: nguni't hindi nila naipakilala ang mga sangbahayan ng kanilang mga magulang, o ang kanilang binhi man kung mga taga Israel:"
            },
            {
              "chapter": 7,
              "verse": 62,
              "name": "Nehemias 7:62",
              "text": "Ang mga anak ni Delaia, ang mga anak ni Tobias, ang mga anak ni Necoda, anim na raan at apat na pu't dalawa."
            },
            {
              "chapter": 7,
              "verse": 63,
              "name": "Nehemias 7:63",
              "text": "At sa mga saserdote: ang mga anak ni Hobaias, ang mga anak ni Cos, ang mga anak ni Barzillai, na nagasawa sa anak ni Barzillai, na Galaadita, at tinawag ayon sa kanilang pangalan."
            },
            {
              "chapter": 7,
              "verse": 64,
              "name": "Nehemias 7:64",
              "text": "Ang mga ito ay nagsihanap ng kanilang talaan ng lahi sa mga yaon na nangabilang sa pamamagitan ng talaan ng lahi, nguni't hindi nasumpungan: kaya't sila'y nangabilang na hawa, at nangaalis sa pagkasaserdote."
            },
            {
              "chapter": 7,
              "verse": 65,
              "name": "Nehemias 7:65",
              "text": "At ang tagapamahala ay nagsabi sa kanila na sila'y huwag magsikain ng mga kabanalbanalang bagay, hangang sa tumayo ang isang saserdote na may Urim at may Thummim."
            },
            {
              "chapter": 7,
              "verse": 66,
              "name": "Nehemias 7:66",
              "text": "Ang buong kapisanang magkakasama ay apat na pu't dalawang libo at tatlong daan at anim na pu."
            },
            {
              "chapter": 7,
              "verse": 67,
              "name": "Nehemias 7:67",
              "text": "Bukod sa kanilang mga bataang lalake at babae, na may pitong libo at tatlong daan at tatlong pu't pito: at sila'y may dalawang daan at apat na pu't lima na mangaawit na lalake at babae."
            },
            {
              "chapter": 7,
              "verse": 68,
              "name": "Nehemias 7:68",
              "text": "Ang kanilang mga kabayo ay pitong daan at tatlong pu't anim; ang kanilang mga mula, dalawang daan at apat na pu't lima;"
            },
            {
              "chapter": 7,
              "verse": 69,
              "name": "Nehemias 7:69",
              "text": "Ang kanilang mga kamelyo, apat na raan at tatlong pu't lima; ang kanilang mga asno, anim na libo't pitong daan at dalawang pu."
            },
            {
              "chapter": 7,
              "verse": 70,
              "name": "Nehemias 7:70",
              "text": "At ang mga iba sa mga pangulo ng mga sangbahayan ng mga magulang ay nangagbigay sa gawain. Ang tagapamahala ay nagbigay sa ingatang-yaman ng isang libong darikong ginto, limangpung mangkok, limang daan at tatlong pung bihisan ng mga saserdote."
            },
            {
              "chapter": 7,
              "verse": 71,
              "name": "Nehemias 7:71",
              "text": "At ang iba sa mga pangulo ng mga sangbahayan ng mga magulang ay nangagbigay sa ingatang-yaman ng gawain ng dalawang pung libong darikong ginto, at dalawang libo at dalawang daang librang pilak."
            },
            {
              "chapter": 7,
              "verse": 72,
              "name": "Nehemias 7:72",
              "text": "At ang nangalabi sa bayan ay nangagbigay ng dalawang pung libong darikong ginto, at dalawang libong librang pilak, at anim na pu't pitong bihisan ng mga saserdote."
            },
            {
              "chapter": 7,
              "verse": 73,
              "name": "Nehemias 7:73",
              "text": "Sa gayo'y ang mga saserdote, at ang mga Levita, at ang mga tagatanod-pinto, at ang mga mangaawit, at ang iba sa bayan, at ang mga Nethineo, at ang buong Israel, ay nagsitahan sa kanilang mga bayan. At nang dumating ang ikapitong buwan ang mga anak ni Israel ay nangasa kanilang mga bayan."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Nehemias 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Nehemias 8:1",
              "text": "At ang buong bayan ay nagpipisan na parang isang lalake sa luwal na dako na nasa harap ng pintuang-bayan ng tubig; at sila'y nangagsalita kay Ezra na kalihim, na dalhin ang aklat ng kautusan ni Moises, na iniutos ng Panginoon sa Israel."
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Nehemias 8:2",
              "text": "At dinala ni Ezra na saserdote ang aklat ng kautusan sa harap ng kapisanan, na mga lalake at mga babae, at lahat na makadidinig na may kaalaman nang unang araw ng ikapitong buwan."
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Nehemias 8:3",
              "text": "At binasa niya roon sa harap ng luwal na dako na nasa harap ng pintuang-bayan ng tubig, mula sa madaling araw hanggang sa katanghaliang tapat sa harapan ng mga lalake at mga babae, at ng makakaalam: at ang mga pakinig ng buong bayan ay nakikinig sa aklat ng kautusan."
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Nehemias 8:4",
              "text": "At si Ezra na kalihim ay tumayo sa pulpitong kahoy, na kanilang ginawa sa panukalang ito; at sa tabi niya ay nakatayo si Mathithias, at si Sema, at si Anaias, at si Urias, at si Hilcias, at si Maasias, sa kaniyang kanan; at sa kaniyang kaliwa, si Pedaias, at si Misael, at si Malchias, at si Hasum, at si Hasbedana, si Zacharias, at si Mesullam."
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Nehemias 8:5",
              "text": "At binuksan ni Ezra ang aklat sa paningin ng buong bayan; (sapagka't siya'y nasa mataas sa buong bayan;) at nang kaniyang buksan, ang buong bayan ay tumayo:"
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Nehemias 8:6",
              "text": "At si Ezra ay pumuri sa Panginoon, na dakilang Dios. At ang buong bayan ay sumagot: Siya nawa, Siya nawa, na may pagtataas ng kanilang mga kamay: at kanilang iniyukod ang kanilang mga ulo, at nagsisamba sa Panginoon na ang kanilang mga mukha'y nakatungo sa lupa."
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Nehemias 8:7",
              "text": "Si Jesua naman, at si Bani, at si Serebias, at si Jamin, si Accub, si Sabethai, si Odias, si Maasias, si Celita, si Azarias, si Jozabed, si Hanan, si Pelaia, at ang mga Levita, ay nangagpakilala sa bayan ng kautusan; at ang bayan ay nakatayo sa kanilang dako."
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Nehemias 8:8",
              "text": "At sila'y nagsibasa sa aklat, sa kautusan ng Dios, na maliwanag; at kanilang ibinigay ang kahulugan, na anopa't kanilang nabatid ang binasa."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Nehemias 8:9",
              "text": "At si Nehemias na siyang tagapamahala, at si Ezra na saserdote na kalihim, at ang mga Levita na nangagturo sa bayan, ay nangagsabi sa buong bayan: Ang araw na ito ay banal sa Panginoon ninyong Dios; huwag kayong magsitaghoy, ni magsiiyak man. Sapagka't ang buong bayan ay umiyak, nang kanilang marinig ang mga salita ng kautusan."
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Nehemias 8:10",
              "text": "Nang magkagayo'y kaniyang sinabi sa kanila, Magsilakad kayo ng inyong lakad, magsikain kayo ng taba, at magsiinom kayo ng matamis; at mangagpadala kayo ng mga bahagi roon sa walang naihanda: sapagka't ang araw na ito ay banal sa ating Panginoon: huwag din kayong mangamanglaw; sapagka't ang kagalakan sa Panginoon ay inyong kalakasan."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Nehemias 8:11",
              "text": "Sa gayo'y napatahimik ng mga Levita ang buong bayan, na sinasabi, Kayo'y magsitahimik, sapagka't ang kaarawan ay banal; ni huwag man kayong mamanglaw."
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Nehemias 8:12",
              "text": "At ang buong bayan ay yumaon ng kanilang lakad na nagsikain at nagsiinom at nangagpadala ng mga bahagi, at nangagsayang mainam sapagka't kanilang nabatid ang mga salita na ipinahayag sa kanila."
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Nehemias 8:13",
              "text": "At nang ikalawang araw ay nagpipisan ang mga pangulo ng mga sangbahayan ng mga magulang ng buong bayan, ang mga saserdote, at ang mga Levita, kay Ezra na kalihim, upang makinig sa mga salita ng kautusan."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Nehemias 8:14",
              "text": "At kanilang nasumpungang nakasulat sa kautusan, kung paanong iniutos ng Panginoon, sa pamamagitan ni Moises, na ang mga anak ni Israel ay magsitahan sa mga balag sa kapistahan ng ikapitong buwan:"
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Nehemias 8:15",
              "text": "At kanilang ihahayag at itatanyag sa lahat ng kanilang mga bayan, at sa Jerusalem, na sasabihin: Magsilabas kayo sa bundok, at magsikuha kayo ng mga sanga ng olibo, at ng mga sanga ng olibong gubat, at ng mga sanga ng mirto, at mga sanga ng palma, at mga sanga ng mga mayabong na punong kahoy, upang magsigawa ng mga balag, gaya ng nakasulat."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Nehemias 8:16",
              "text": "Sa gayo'y lumabas ang bayan, at nangagdala sila, at nagsigawa ng mga balag, bawa't isa'y sa bubungan ng kaniyang bahay, at sa kanilang mga looban, at sa mga looban ng bahay ng Dios, at sa luwal na dako ng pintuang-bayan ng tubig, at sa luwal na dako ng pintuang-bayan ng Ephraim."
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Nehemias 8:17",
              "text": "At ang buong kapisanan nila na bumalik na mula sa pagkabihag ay gumawa ng mga balag, at tumahan sa mga balag: sapagka't mula ng mga araw ni Josue na anak ni Nun hanggang sa araw na yaon ay hindi nagsigawa ang mga anak ni Israel ng gayon. At nagkaroon ng totoong malaking kasayahan."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "Nehemias 8:18",
              "text": "Gayon din naman araw-araw, mula sa unang araw hanggang sa huling araw, kaniyang binasa ang aklat ng kautusan ng Dios. At kanilang ipinagdiwang ang kapistahan na pitong araw; at sa ikawalong araw ay takdang kapulungan, ayon sa ayos."
            }
          ]
