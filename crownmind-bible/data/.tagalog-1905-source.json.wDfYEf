            {
              "chapter": 49,
              "verse": 12,
              "name": "Genesis 49:12",
              "text": "Ang kaniyang mga mata ay mamumula sa alak, At ang kaniyang mga ngipin ay mamumuti sa gatas."
            },
            {
              "chapter": 49,
              "verse": 13,
              "name": "Genesis 49:13",
              "text": "Si Zabulon ay tatahan sa daongan ng dagat: At siya'y magiging daongan ng mga sasakyan; At ang kaniyang hangganan ay magiging hanggang Sidon."
            },
            {
              "chapter": 49,
              "verse": 14,
              "name": "Genesis 49:14",
              "text": "Si Issachar ay isang malakas na asno, Na lumulugmok sa gitna ng mga tupahan:"
            },
            {
              "chapter": 49,
              "verse": 15,
              "name": "Genesis 49:15",
              "text": "At nakakita siya ng dakong pahingahang mabuti, At ng lupang kaayaaya; At kaniyang iniyukod ang kaniyang balikat upang pumasan, At naging aliping mangaatag."
            },
            {
              "chapter": 49,
              "verse": 16,
              "name": "Genesis 49:16",
              "text": "Si Dan ay hahatol sa kaniyang bayan, Gaya ng isa sa angkan ni Israel."
