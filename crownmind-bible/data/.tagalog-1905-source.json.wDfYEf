            {
              "chapter": 3,
              "verse": 20,
              "name": "Job 3:20",
              "text": "Bakit binibigyan ng liwanag ang nasa karalitaan, at ng buhay ang kaluluwang nasa kahirapan;"
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Job 3:21",
              "text": "Na naghihintay ng kamatayan, nguni't hindi dumarating; at hinahangad ng higit kaysa mga kayamanang nakatago;"
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Job 3:22",
              "text": "Na nagagalak ng di kawasa, at nangasasayahan, pagka nasumpungan ang libingan?"
            },
            {
              "chapter": 3,
              "verse": 23,
              "name": "Job 3:23",
              "text": "Bakit binibigyan ng liwanag ang tao na kinalilingiran ng lakad, at ang kinulong ng Dios?"
            },
            {
              "chapter": 3,
              "verse": 24,
              "name": "Job 3:24",
              "text": "Sapagka't nagbubuntong hininga ako bago ako kumain, at ang aking mga angal ay bumubugsong parang tubig."
            },
            {
              "chapter": 3,
              "verse": 25,
              "name": "Job 3:25",
              "text": "Sapagka't ang bagay na aking kinatatakutan ay dumarating sa akin, at ang aking pinangingilabutan ay dumarating sa akin."
            },
            {
              "chapter": 3,
              "verse": 26,
              "name": "Job 3:26",
              "text": "Hindi ako tiwasay, ni ako man ay tahimik, ni ako man ay napapahinga; kundi kabagabagan ang dumarating."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Job 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Job 4:1",
              "text": "Nang magkagayo'y sumagot si Eliphaz na Temanita, at nagsabi,"
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Job 4:2",
              "text": "Kung tikman ng isa na makipagusap sa iyo, ikababalisa mo ba? Nguni't sinong makapipigil ng pagsasalita?"
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Job 4:3",
              "text": "Narito, ikaw ay nagturo sa marami, at iyong pinalakas ang mahinang mga kamay."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Job 4:4",
              "text": "Ang iyong mga salita ay nagsialalay sa nangabubuwal, at iyong pinalakas ang mahinang mga tuhod."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Job 4:5",
              "text": "Nguni't ngayo'y dinaratnan ka ng kasamaan, at ikaw ay nanglulupaypay; ginagalaw ka, at ikaw ay nababagabag."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Job 4:6",
              "text": "Hindi ba ang iyong takot sa Dios ay ang iyong tiwala, at ang iyong pagasa ay ang pagtatapat ng iyong mga lakad?"
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Job 4:7",
              "text": "Iyong alalahanin, isinasamo ko sa iyo, kung sino ang namatay, na walang malay? O saan nangahiwalay ang mga matuwid?"
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Job 4:8",
              "text": "Ayon sa aking pagkakita yaong nagsisipagararo ng kasamaan, at nangaghahasik ng kabagabagan ay gayon din ang inaani."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Job 4:9",
              "text": "Sa hinga ng Dios sila'y nangamamatay, at sa bugso ng kaniyang galit sila'y nangalilipol."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Job 4:10",
              "text": "Ang ungal ng leon, at ang tinig ng mabangis na leon, at ang mga ngipin ng mga batang leon, ay nangabali."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Job 4:11",
              "text": "Ang matandang leon ay namamatay dahil sa kawalan ng huli, at ang mga batang leong babae ay nagsisipangalat."
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Job 4:12",
              "text": "Ngayo'y nadalang lihim sa akin ang isang bagay, at ang aking pakinig ay nakakaulinig ng bulong niyaon."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Job 4:13",
              "text": "Sa mga pagiisip na mula sa mga pangitain sa gabi, pagka ang mahimbing na tulog ay nahuhulog sa mga tao,"
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Job 4:14",
              "text": "Takot ay dumating sa akin, at panginginig, na nagpapanginig ng lahat ng aking mga buto."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Job 4:15",
              "text": "Nang magkagayo'y dumaan ang isang espiritu sa aking mukha. Ang balahibo ng aking balat ay nanindig."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Job 4:16",
              "text": "Tumayong nakatigil, nguni't hindi ko mawari ang anyo niyaon; isang anyo ang nasa harap ng aking mga mata: tahimik, at ako'y nakarinig ng tinig, na nagsasabi,"
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Job 4:17",
              "text": "Magiging ganap pa ba ang taong may kamatayan kay sa Dios? Lilinis pa ba kaya ang tao kay sa Maylalang sa kaniya?"
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Job 4:18",
              "text": "Narito, siya'y hindi naglalagak ng tiwala sa kaniyang mga lingkod; at inaari niyang mga mangmang ang kaniyang mga anghel:"
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Job 4:19",
              "text": "Gaano pa kaya sila na nagsisitahan sa mga bahay na putik, na ang patibayan ay nasa alabok, na napipisang gaya ng paroparo!"
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Job 4:20",
              "text": "Sa pagitan ng umaga at hapon, ay nangagigiba; nangapaparam magpakailan man na walang pumupuna."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Job 4:21",
              "text": "Hindi ba nalalagot ang tali ng kanilang tolda sa loob nila? Sila'y nangamamatay at walang karunungan."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Job 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Job 5:1",
              "text": "Tumawag ka ngayon; may sasagot ba sa iyo? At sa kanino sa mga banal babalik ka?"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Job 5:2",
              "text": "Sapagka't ang bigat ng loob ay pumapatay sa taong hangal, at ang paninibugho ay pumapatay sa mangmang."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Job 5:3",
              "text": "Aking nakita ang hangal na umuunlad: nguni't agad kong sinumpa ang kaniyang tahanan."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Job 5:4",
              "text": "Ang kaniyang mga anak ay malayo sa katiwasayan, at sila'y mangapipisa sa pintuang-bayan, na wala mang magligtas sa kanila."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Job 5:5",
              "text": "Na ang kaniyang ani ay kinakain ng gutom, at kinukuha na mula sa mga tinik, at ang silo ay nakabuka sa kanilang pag-aari."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Job 5:6",
              "text": "Sapagka't ang kadalamhatian ay hindi lumalabas sa alabok, ni bumubukal man sa lupa ang kabagabagan;"
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Job 5:7",
              "text": "Kundi ang tao ay ipinanganak sa kabagabagan. Gaya ng alipato na umiilanglang sa itaas."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Job 5:8",
              "text": "Nguni't sa ganang akin, ay hahanapin ko ang Dios, at sa Dios ay aking ihahabilin ang aking usap:"
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Job 5:9",
              "text": "Na siyang gumagawa ng mga dakilang bagay at ng mga hindi magunita; ng mga kamanghamanghang bagay na walang bilang:"
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Job 5:10",
              "text": "Na siyang nagbibigay ng ulan sa lupa, at nagpapahatid ng tubig sa mga bukid;"
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Job 5:11",
              "text": "Na anopa't kaniyang iniuupo sa mataas yaong nangasa mababa; at yaong nagsisitangis ay itinataas sa katiwasayan."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Job 5:12",
              "text": "Kaniyang sinasayang ang mga katha-katha ng mapagkatha, na anopa't hindi maisagawa ng kanilang mga kamay ang kanilang panukala."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Job 5:13",
              "text": "Kaniyang hinuhuli ang pantas sa kanilang sariling katha: at ang payo ng suwail ay napapariwara."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Job 5:14",
              "text": "Kanilang nasasalunuan ang kadiliman sa araw, at nagsisikapa sa katanghaliang tapat na gaya sa gabi."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Job 5:15",
              "text": "Nguni't kaniyang inililigtas sa tabak ng kanilang bibig, sa makatuwid baga'y ang maralita sa kamay ng malakas."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Job 5:16",
              "text": "Na anopa't ang dukha ay may pagasa, at ang kasamaan ay nagtitikom ng kaniyang bibig."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Job 5:17",
              "text": "Narito, maginhawa ang tao na sinasaway ng Dios: kaya't huwag mong waling kabuluhan ang pagsaway ng Makapangyarihan sa lahat."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Job 5:18",
              "text": "Sapagka't siya'y sumusugat, at nagtatapal; siya'y sumusugat, at pinagagaling ng kaniyang mga kamay."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Job 5:19",
              "text": "Kaniyang ililigtas ka sa anim na kabagabagan. Oo, sa pito, ay walang kasamaang kikilos sa iyo."
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Job 5:20",
              "text": "Sa kagutom ay tutubusin ka niya sa kamatayan; at sa pagdidigma ay sa kapangyarihan ng tabak."
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Job 5:21",
              "text": "Ikaw ay makukubli sa talas ng dila; na hindi ka man matatakot sa paggiba pagka dumarating."
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Job 5:22",
              "text": "Sa kagibaan at sa kasalatan ay tatawa ka; ni hindi ka matatakot sa mga ganid sa lupa."
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Job 5:23",
              "text": "Sapagka't ikaw ay makakasundo ng mga bato sa parang; at ang mga ganid sa parang ay makikipagpayapaan sa iyo."
            },
            {
              "chapter": 5,
              "verse": 24,
              "name": "Job 5:24",
              "text": "At iyong makikilala na ang iyong tolda ay nasa kapayapaan; at iyong dadalawin ang iyong kulungan, at walang mawawala na anoman."
            },
            {
              "chapter": 5,
              "verse": 25,
              "name": "Job 5:25",
              "text": "Iyo rin namang makikilala na ang iyong binhi ay magiging dakila, at ang iyong lahi ay gaya ng damo sa lupa."
            },
            {
              "chapter": 5,
              "verse": 26,
              "name": "Job 5:26",
              "text": "Ikaw ay darating sa iyong libingan sa lubos na katandaan. Gaya ng bigkis ng trigo na dumarating sa kaniyang kapanahunan."
            },
            {
              "chapter": 5,
              "verse": 27,
              "name": "Job 5:27",
              "text": "Narito, aming siniyasat, at gayon nga; dinggin mo, at talastasin mo sa iyong ikabubuti."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Job 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Job 6:1",
              "text": "Nang magkagayo'y sumagot si Job at nagsabi,"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Job 6:2",
              "text": "Oh timbangin nawa ang aking pagkainip, at ang aking mga kasakunaan ay malagay sa mga timbangan na magkakasama."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Job 6:3",
              "text": "Sapagka't ngayo'y magiging lalong mabigat kay sa buhangin sa mga dagat: kaya't ang aking pananalita ay napabigla."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Job 6:4",
              "text": "Sapagka't ang mga palaso ng Makapangyarihan sa lahat ay nasasaksak sa akin, ang lason niyaon ay hinitit ng aking diwa; ang mga pangkilabot ng Dios ay nangahahanay laban sa akin."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Job 6:5",
              "text": "Umuungal ba ang mailap na asno pag may damo? O umuungal ba ang baka sa kaniyang pagkain?"
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Job 6:6",
              "text": "Makakain ba ng walang asin ang matabang? O mayroon bang lasa ang puti ng isang itlog?"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Job 6:7",
              "text": "Tinatanggihang hipuin ng aking kaluluwa; mga karumaldumal na pagkain sa akin."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Job 6:8",
              "text": "Oh mangyari nawa ang aking kahilingan; at ipagkaloob nawa sa akin ng Dios ang bagay na aking minimithi!"
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Job 6:9",
              "text": "Sa makatuwid baga'y kalugdan nawa ng Dios na pisain ako; na bitawan ang kaniyang kamay, at ihiwalay ako!"
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Job 6:10",
              "text": "Kung magkagayo'y magtataglay pa ako ng kaaliwan; Oo, ako'y makapagbabata sa mga walang awang sakit; sapagka't hindi ko itinakuwil ang mga salita ng Banal."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Job 6:11",
              "text": "Ano ang aking lakas, na ako'y maghihintay? At ano ang aking wakas na ako'y magtitiis?"
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Job 6:12",
              "text": "Ang akin bang tibay ay tibay ng mga bato? O ang akin bang laman ay tanso?"
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Job 6:13",
              "text": "Di ba ako'y walang sukat na kaya, at ang karunungan ay lumayo sa akin?"
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Job 6:14",
              "text": "Siyang nanglulupaypay ay dapat pagpakitaang loob ng kaniyang kaibigan; kahit siya na walang takot sa Makapangyarihan sa lahat."
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Job 6:15",
              "text": "Ang aking mga kapatid ay nagsipagdaya na parang batis, na parang daan ng mga batis na nababago;"
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Job 6:16",
              "text": "Na malabo dahil sa hielo, at siyang kinatunawan ng nieve:"
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Job 6:17",
              "text": "Paginit ay nawawala: pagka mainit, ay nangatutunaw sa kanilang dako."
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Job 6:18",
              "text": "Ang mga pulutong na naglalakbay sa pagsunod sa mga yaon ay nangaliligaw; nagsisilihis sa ilang at nawawala."
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Job 6:19",
              "text": "Minasdan ng mga pulutong na mula sa Tema, hinintay ang mga yaon ng mga pulutong na mula sa Seba."
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "Job 6:20",
              "text": "Sila'y nangapahiya, sapagka't sila'y nagsiasa; sila'y nagsiparoon at nangatulig."
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "Job 6:21",
              "text": "Sapagka't ngayon, kayo'y nauwi sa wala; kayo'y nangakakakita ng kakilabutan, at nangatatakot."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "Job 6:22",
              "text": "Sinabi ko baga: Bigyan mo ako? O, Maghandog ka ng isang kaloob sa akin ng iyong pag-aari?"
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "Job 6:23",
              "text": "O, Iligtas mo ako sa kamay ng kaaway? O, tubusin mo ako sa kamay ng mga namimighati?"
            },
            {
              "chapter": 6,
              "verse": 24,
              "name": "Job 6:24",
              "text": "Turuan mo ako, at ako'y mamamayapa; at ipaunawa mo sa akin kung ano ang aking pinagkasalahan."
            },
            {
              "chapter": 6,
              "verse": 25,
              "name": "Job 6:25",
              "text": "Pagkatindi nga ng mga salita ng katuwiran! Nguni't anong sinasaway ng iyong pakikipagtalo?"
            },
            {
              "chapter": 6,
              "verse": 26,
              "name": "Job 6:26",
              "text": "Iniisip ba ninyong sumaway ng mga salita? Dangang ang mga salita ng walang inaasahan ay parang hangin."
            },
            {
              "chapter": 6,
              "verse": 27,
              "name": "Job 6:27",
              "text": "Oo, kayo'y magsasapalaran sa ulila, at ginawa ninyong kalakal ang inyong kaibigan."
            },
            {
              "chapter": 6,
              "verse": 28,
              "name": "Job 6:28",
              "text": "Ngayon nga'y kalugdan mong lingapin ako; sapagka't tunay na hindi ako magbubulaan sa iyong harap."
            },
            {
              "chapter": 6,
              "verse": 29,
              "name": "Job 6:29",
              "text": "Kayo'y magsibalik isinasamo ko sa inyo, huwag magkaroon ng kalikuan; Oo, kayo'y magsibalik uli, ang aking usap ay matuwid."
            },
            {
              "chapter": 6,
              "verse": 30,
              "name": "Job 6:30",
              "text": "May di ganap ba sa aking dila? Hindi ba makapapansin ang aking pagwawari ng mga suwail na bagay?"
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Job 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Job 7:1",
              "text": "Wala bang kapanahunan ng kaguluhan ang tao sa ibabaw ng lupa? At hindi ba ang kaniyang mga kaarawan ay gaya ng mga kaarawan ng nagpapaupa?"
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Job 7:2",
              "text": "Na gaya ng alipin na ninanasang mainam ang lilim, at gaya ng nagpapaupa na tumitingin sa kaniyang mga kaupahan:"
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Job 7:3",
              "text": "Gayon ako pinapagdaan ng mga buwan na walang kabuluhan at mga gabing nakaiinip ang itinakda sa akin."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Job 7:4",
              "text": "Pag ako'y nahihiga, aking sinasabi, kailan ako babangon at nakadaan na ang gabi? At ako'y puspos ng pagkabalisa hanggang sa pagbubukang liwayway ng araw."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Job 7:5",
              "text": "Ang aking laman ay nabibihisan ng mga uod at ng libag na alabok; ang aking balat ay namamaga at putok putok."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Job 7:6",
              "text": "Ang aking mga kaarawan ay matulin kay sa panghabi ng manghahabi, at nagugugol na walang pagasa."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Job 7:7",
              "text": "Oh alalahanin mo na ang aking buhay ay hinga: Ang aking mata ay hindi na makakakita pa ng mabuti."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Job 7:8",
              "text": "Ang matang tumingin sa akin ay hindi na ako mamamasdan: ang iyong mga mata ay sasa akin, nguni't wala na ako."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Job 7:9",
              "text": "Kung paanong ang ulap ay napapawi at nawawala, gayon siyang bumababa sa Sheol ay hindi na aahon pa."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Job 7:10",
              "text": "Siya'y hindi na babalik pa sa kaniyang bahay, ni malalaman pa man niya ang kaniyang dako."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Job 7:11",
              "text": "Kaya't hindi ko pipigilin ang aking bibig; ako'y magsasalita sa kadalamhatian ng aking diwa; ako'y dadaing sa kahirapan ng aking kaluluwa."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Job 7:12",
              "text": "Ako ba'y isang dagat, o isang malaking hayop dagat, na pinababantayan mo ako sa isang bantay?"
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Job 7:13",
              "text": "Pag aking sinasabi, Aaliwin ako ng aking higaan, papayapain ng aking unan ang aking karamdaman;"
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Job 7:14",
              "text": "Kung magkagayo'y pinupukaw mo ako ng mga panaginip, at pinangingilabot mo ako sa mga pangitain:"
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Job 7:15",
              "text": "Na anopa't pinipili ng aking kaluluwa ang pagkainis, at ang kamatayan kay sa aking mga butong ito."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Job 7:16",
              "text": "Aking kinayayamutan ang aking buhay; di ko na ibig mabuhay magpakailan man: bayaan akong magisa; sapagka't ang aking mga kaarawan ay walang kabuluhan."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Job 7:17",
              "text": "Ano ang tao, na iyong palalakhin siya, at iyong ilalagak ang iyong puso sa kaniya,"
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Job 7:18",
              "text": "At iyong dadalawin siya tuwing umaga, at susubukin siya sa tuwi-tuwina?"
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Job 7:19",
              "text": "Hanggang kailan di mo ako iiwan, ni babayaan man hanggang sa aking lunukin ang aking laway?"
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Job 7:20",
              "text": "Kung ako'y nagkasala, ano ang aking magagawa sa iyo, Oh ikaw na bantay sa mga tao? Bakit mo nga inilalagay akong pinakatanda sa iyo. Na anopa't ako'y isang pasan sa aking sarili?"
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Job 7:21",
              "text": "At bakit hindi mo ipinatatawad ang aking pagsalangsang, at inaalis ang aking kasamaan? Sapagka't ngayo'y mahihiga ako sa alabok; at ako'y hahanapin mong mainam, nguni't wala na ako."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Job 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Job 8:1",
              "text": "Nang magkagayo'y sumagot si Bildad na Suhita, at nagsabi,"
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Job 8:2",
              "text": "Hanggang kailan magsasalita ka ng mga bagay na ito? At hanggang kailan magiging gaya ng makapangyarihang hangin ang mga salita ng iyong bibig?"
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Job 8:3",
              "text": "Nagliliko ba ng kahatulan ang Dios? O nagliliko ba ang Makapangyarihan sa lahat ng kaganapan?"
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Job 8:4",
              "text": "Kung ang iyong mga anak ay nangagkasala laban sa kaniya, at kaniyang ibinigay sila sa kamay ng kanilang pagkasalangsang:"
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Job 8:5",
              "text": "Kung hanapin mong mainam ang Dios, at iyong pamanhikan ang Makapangyarihan sa lahat;"
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Job 8:6",
              "text": "Kung ikaw ay malinis at matuwid; walang pagsalang ngayo'y gigising siya dahil sa iyo. At pasasaganain ang tahanan ng iyong katuwiran."
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Job 8:7",
              "text": "At bagaman ang iyong pasimula ay maliit, gayon ma'y ang iyong huling wakas ay lalaking mainam."
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Job 8:8",
              "text": "Sapagka't ikaw ay magsisiyasat, isinasamo ko sa iyo, sa unang panahon, at pasiyahan mo ang sinaliksik ng kanilang mga magulang:"
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Job 8:9",
              "text": "(Sapagka't tayo'y kahapon lamang, at walang nalalaman, sapagka't ang ating mga kaarawan sa lupa ay anino:)"
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Job 8:10",
              "text": "Hindi ka ba nila tuturuan, at sasaysayin sa iyo, at mangagsasalita ng mga salita mula sa kanilang puso?"
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Job 8:11",
              "text": "Makatataas ba ang yantok ng walang putik? Tutubo ba ang tambo ng walang tubig?"
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Job 8:12",
              "text": "Samantalang nasa kasariwaan, at hindi pinuputol, natutuyong una kay sa alin mang damo."
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Job 8:13",
              "text": "Gayon ang mga landas ng lahat na nagsisilimot sa Dios; at ang pagasa ng di banal ay mawawala:"
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Job 8:14",
              "text": "Na ang kaniyang pagtitiwala ay mapaparam, at ang kaniyang tiwala ay isang bahay gagamba."
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Job 8:15",
              "text": "Siya'y sasandal sa kaniyang bahay, nguni't hindi tatayo; siya'y pipigil na mahigpit dito, nguni't hindi makapagmamatigas."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Job 8:16",
              "text": "Siya'y sariwa sa harap ng araw, at ang kaniyang mga suwi ay sumisibol sa kaniyang halamanan."
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Job 8:17",
              "text": "Ang kaniyang mga ugat ay nagkakapitan sa palibot ng bunton, kaniyang minamasdan ang dako ng mga bato."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "Job 8:18",
              "text": "Kung siya'y magiba sa kaniyang dako, kung magkagayo'y itatakuwil niya siya, na sinasabi: Hindi kita nakita."
            },
            {
              "chapter": 8,
              "verse": 19,
              "name": "Job 8:19",
              "text": "Narito, ito ang kagalakan ng kaniyang lakad, at mula sa lupa ay sisibol ang mga iba."
            },
            {
              "chapter": 8,
              "verse": 20,
              "name": "Job 8:20",
              "text": "Narito, hindi itatakuwil ng Dios ang sakdal na tao, ni aalalayan man niya ang mga manggagawa ng kasamaan."
            },
            {
              "chapter": 8,
              "verse": 21,
              "name": "Job 8:21",
              "text": "Kaniya namang pupunuin ang iyong bibig ng pagtawa, at ang iyong mga labi ng paghiyaw."
            },
            {
              "chapter": 8,
              "verse": 22,
              "name": "Job 8:22",
              "text": "Silang nangapopoot sa iyo ay mabibihisan ng pagkahiya; at ang tolda ng masama ay mawawala."
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Job 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Job 9:1",
              "text": "Nang magkagayo'y sumagot si Job, at nagsabi,"
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Job 9:2",
              "text": "Sa katotohanan ay nalalaman kong ito'y gayon: nguni't paanong makapaggaganap ang tao sa Dios?"
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Job 9:3",
              "text": "Kung kalugdan niyang makipagtalo sa kaniya, siya'y hindi makasasagot sa kaniya ng isa sa isang libo."
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Job 9:4",
              "text": "Siya ay pantas sa puso, at may kaya sa kalakasan: sinong nagmatigas laban sa kaniya at guminhawa?"
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Job 9:5",
              "text": "Na siyang naglilipat ng mga bundok, at hindi nila nalalaman, pagka nililiglig niya sa kaniyang pagkagalit."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Job 9:6",
              "text": "Na siyang umuuga ng lupa sa kaniyang kinaroroonan, at ang mga haligi nito ay nangayayanig."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Job 9:7",
              "text": "Na siyang naguutos sa araw, at hindi sumisikat; at nagtatakda sa mga bituin."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Job 9:8",
              "text": "Na nagiisang inuunat ang langit, at tumutungtong sa mga alon ng dagat."
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Job 9:9",
              "text": "Na lumikha sa Oso, sa Orion, at sa mga Pleyade, at sa mga silid ng timugan."
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Job 9:10",
              "text": "Na gumagawa ng mga dakilang bagay na di masayod; Oo, mga kamanghamanghang bagay na walang bilang."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Job 9:11",
              "text": "Narito, siya'y dumaraan sa siping ko, at hindi ko siya nakikita: siya'y nagpapatuloy rin naman, nguni't hindi ko siya namamataan."
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Job 9:12",
              "text": "Narito, siya'y nangangagaw sinong makasasansala sa kaniya? Sinong magsasabi sa kaniya: Anong ginagawa mo?"
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Job 9:13",
              "text": "Hindi iuurong ng Dios ang kaniyang galit; ang mga manunulong sa Rahab ay nagsisiyukod sa ilalim niya."
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Job 9:14",
              "text": "Gaano pa nga kaya kaliit ang maisasagot ko sa kaniya, at mapipiling aking mga salita na maimamatuwid ko sa kaniya?"
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Job 9:15",
              "text": "Na kahiman ako'y matuwid, gayon may hindi ako sasagot sa kaniya; ako'y mamamanhik sa aking hukom."
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Job 9:16",
              "text": "Kung ako'y tumawag, at siya'y sumagot sa akin; gayon ma'y hindi ako maniniwala na kaniyang dininig ang aking tinig."
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Job 9:17",
              "text": "Sapagka't ako'y ginigiba niya sa pamamagitan ng isang bagyo, at pinararami ang aking mga sugat ng walang kadahilanan."
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Job 9:18",
              "text": "Hindi niya ako tutulutang ako'y huminga, nguni't nililipos niya ako ng hirap."
            },
            {
              "chapter": 9,
              "verse": 19,
              "name": "Job 9:19",
              "text": "Kung kami ay magsalita tungkol sa kalakasan, narito, siya'y may kapangyarihan! At kung sa kahatulan, sino, sinasabi niya ay magtatakda sa akin ng panahon?"
            },
            {
              "chapter": 9,
              "verse": 20,
              "name": "Job 9:20",
              "text": "Kahiman ako'y matuwid, ang aking sariling bibig ay hahatol sa akin: kahiman ako'y sakdal patototohanan niya akong masama."
            },
            {
              "chapter": 9,
              "verse": 21,
              "name": "Job 9:21",
              "text": "Ako'y sakdal; hindi ko talos ang aking sarili; aking niwalang kabuluhan ang aking buhay."
            },
            {
              "chapter": 9,
              "verse": 22,
              "name": "Job 9:22",
              "text": "Lahat ay isa; kaya't aking sinasabi: kaniyang ginigiba ang sakdal at ang masama."
            },
            {
              "chapter": 9,
              "verse": 23,
              "name": "Job 9:23",
              "text": "Kung ang panghampas ay pumapatay na bigla, tatawanan niya ang paglilitis sa mga walang sala."
            },
            {
              "chapter": 9,
              "verse": 24,
              "name": "Job 9:24",
              "text": "Ang lupa ay nabigay sa kamay ng masama: kaniyang tinatakpan ang mga mukha ng mga hukom nito; kung hindi siya, sino nga?"
            },
            {
              "chapter": 9,
              "verse": 25,
              "name": "Job 9:25",
              "text": "Ngayo'y ang mga kaarawan ko ay matulin kay sa isang sugo: dumadaang matulin, walang nakikitang mabuti."
            },
            {
              "chapter": 9,
              "verse": 26,
              "name": "Job 9:26",
              "text": "Sila'y nagsisidaang parang mga matuling sasakyan: parang agila na dumadagit ng huli."
            },
            {
              "chapter": 9,
              "verse": 27,
              "name": "Job 9:27",
              "text": "Kung aking sabihin: Aking kalilimutan ang aking daing, aking papawiin ang aking malungkot na mukha, at magpapakasaya ako:"
            },
            {
              "chapter": 9,
              "verse": 28,
              "name": "Job 9:28",
              "text": "Ako'y natatakot sa lahat kong kapanglawan, talastas ko na hindi mo aariin akong walang sala."
            },
            {
              "chapter": 9,
              "verse": 29,
              "name": "Job 9:29",
              "text": "Ako'y mahahatulan; bakit nga ako gagawa ng walang kabuluhan?"
            },
            {
              "chapter": 9,
              "verse": 30,
              "name": "Job 9:30",
              "text": "Kung ako'y maligo ng nieveng tubig, at gawin ko ang aking mga kamay na napakalinis;"
            },
            {
              "chapter": 9,
              "verse": 31,
              "name": "Job 9:31",
              "text": "Gayon ma'y itutulak mo ako sa hukay, at kayayamutan ako ng aking mga sariling kasuutan."
            },
            {
              "chapter": 9,
              "verse": 32,
              "name": "Job 9:32",
              "text": "Sapagka't siya'y hindi tao, na gaya ko, na sasagot ako sa kaniya, na tayo'y pumasok kapuwa sa kahatulan,"
            },
            {
              "chapter": 9,
              "verse": 33,
              "name": "Job 9:33",
              "text": "Walang hukom sa pagitan natin, na makapaglagay ng kaniyang kamay sa ating dalawa."
            },
            {
              "chapter": 9,
              "verse": 34,
              "name": "Job 9:34",
              "text": "Ihiwalay niya sa akin ang kaniyang tungkod, at huwag akong takutin ng kaniyang pangilabot:"
            },
            {
              "chapter": 9,
              "verse": 35,
              "name": "Job 9:35",
              "text": "Kung magkagayo'y magsasalita ako, at hindi matatakot sa kaniya; sapagka't hindi gayon ako sa aking sarili."
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Job 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Job 10:1",
              "text": "Ang aking kaluluwa ay nalulunos sa aking buhay; aking palalayain ang aking daing; ako'y magsasalita sa kapaitan ng aking kaluluwa."
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Job 10:2",
              "text": "Sasabihin ko sa Dios: Huwag mo akong hatulan; ipakilala mo sa akin kung bakit nakikipagtalo ka sa akin."
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Job 10:3",
              "text": "Mabuti ba sa iyo na ikaw ay mamighati, na iyong itakuwil ang gawa ng iyong mga kaaway, at iyong pasilangin ang payo ng masama?"
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Job 10:4",
              "text": "Ikaw ba'y may mga matang laman, o nakakakita ka bang gaya ng pagkakita ng tao?"
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Job 10:5",
              "text": "Ang iyo bang mga kaarawan ay gaya ng mga kaarawan ng tao, o ang iyong mga taon ay gaya ng mga kaarawan ng tao,"
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Job 10:6",
              "text": "Upang ikaw ay magsiyasat ng aking kasamaan, at magusisa ng aking kasalanan,"
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Job 10:7",
              "text": "Bagaman iyong nalalaman na ako'y hindi masama; at walang makapagliligtas sa iyong kamay?"
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Job 10:8",
              "text": "Ang iyong mga kamay ang siyang lumalang at nagbigay anyo sa akin sa buong palibot; gayon ma'y pinahihirapan mo ako."
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Job 10:9",
              "text": "Iyong alalahanin, isinasamo ko sa iyo, na ako'y iyong binigyang anyo na gaya ng putik; at iuuwi mo ba ako uli sa pagkaalabok?"
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Job 10:10",
              "text": "Hindi mo ba ako ibinuhos na parang gatas, at binuo mo akong parang keso?"
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Job 10:11",
              "text": "Ako'y binihisan mo ng balat at laman, at sinugpong mo ako ng mga buto at mga litid."
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Job 10:12",
              "text": "Ako'y pinagkalooban mo ng buhay at kagandahang-loob, at pinamalagi ang aking diwa ng iyong pagdalaw."
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Job 10:13",
              "text": "Gayon ma'y ang mga bagay na ito ay iyong ikinubli sa iyong puso; talastas ko na ito'y sa iyo:"
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Job 10:14",
              "text": "Kung ako'y magkasala, iyo nga akong tinatandaan, at hindi mo ako patatawarin sa aking kasamaan."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Job 10:15",
              "text": "Kung ako'y maging masama, sa aba ko; at kung ako'y maging matuwid, hindi ko man itataas ang aking ulo; yamang puspos ng kakutyaan, at ng pagmamasid niring kadalamhatian."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Job 10:16",
              "text": "At kung ang aking ulo ay mataas, iyong hinuhuli akong parang leon: at napakikita ka uling kagilagilalas sa akin."
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Job 10:17",
              "text": "Iyong binabago ang iyong mga pagsaksi laban sa akin, at dinaragdagan mo ang iyong galit sa akin; paninibago at pakikipagbaka ang sumasaakin."
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Job 10:18",
              "text": "Bakit mo nga ako inilabas mula sa bahay-bata? Napatid sana ang aking hininga, at wala nang matang nakakita pa sa akin."
            },
            {
              "chapter": 10,
              "verse": 19,
              "name": "Job 10:19",
              "text": "Ako sana'y naging parang hindi nabuhay; nadala sana ako mula sa bahay-bata hanggang sa libingan,"
            },
            {
              "chapter": 10,
              "verse": 20,
              "name": "Job 10:20",
              "text": "Hindi ba kaunti ang aking mga araw? paglikatin mo nga, at ako'y iyong bayaan, upang ako'y maginhawahan ng kaunti,"
            },
            {
              "chapter": 10,
              "verse": 21,
              "name": "Job 10:21",
              "text": "Bago ako manaw doon na hindi ako babalik, sa lupain ng kadiliman at ng lilim ng kamatayan;"
            },
            {
              "chapter": 10,
              "verse": 22,
              "name": "Job 10:22",
              "text": "Ang lupain na dilim, na gaya ng salimuot na kadiliman; lupain ng lilim ng kamatayan, na walang anomang ayos, at doon sa ang liwanag ay gaya ng salimuot na kadiliman."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Job 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Job 11:1",
              "text": "Nang magkagayo'y sumagot si Sophar na Naamathita, at nagsabi,"
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Job 11:2",
              "text": "Hindi ba sasagutin ang karamihan ng mga salita? At ang lalaking masalita ay aariing ganap?"
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Job 11:3",
              "text": "Pamamayapain ba ang mga tao ng iyong mga paghahambog. At kung ikaw ay nanunuya, wala bang hihiya sa iyo?"
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Job 11:4",
              "text": "Sapagka't iyong sinasabi, Ang aking aral ay dalisay, at ako'y malinis sa iyong mga mata."
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Job 11:5",
              "text": "Nguni't Oh ang Dios nawa'y magsalita, at bukhin ang kaniyang mga labi laban sa iyo;"
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Job 11:6",
              "text": "At ipakilala nawa sa iyo ang mga lihim ng karunungan, pagka't siya ay masagana sa pagkaunawa. Talastasin mo nga na nilalapatan ka ng Dios ng kulang kay sa nauukol sa iyong kasamaan."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Job 11:7",
              "text": "Masusumpungan mo ba ang Dios sa pagsaliksik? Masusumpungan mo ba sa kasakdalan ang Makapangyarihan sa lahat?"
            },
            {
              "chapter": 11,
              "verse": 8,
              "name": "Job 11:8",
              "text": "Mataas na gaya ng langit; anong iyong magagawa? Malalim kay sa Sheol: anong iyong malalaman?"
            },
            {
              "chapter": 11,
              "verse": 9,
              "name": "Job 11:9",
              "text": "Ang sukat niyao'y mahaba kay sa lupa. At maluwang kay sa dagat."
            },
            {
              "chapter": 11,
              "verse": 10,
              "name": "Job 11:10",
              "text": "Kung siya'y dumaan at magsara, at tumawag sa kahatulan, sino ngang makapipigil sa kaniya?"
            },
            {
              "chapter": 11,
              "verse": 11,
              "name": "Job 11:11",
              "text": "Sapagka't nakikilala niya ang mga walang kabuluhang tao: Nakikita rin naman niya ang kasamaan, bagaman hindi niya pinapansin."
            },
            {
              "chapter": 11,
              "verse": 12,
              "name": "Job 11:12",
              "text": "Nguni't ang walang kabuluhang tao ay walang unawa, Oo, ang tao ay ipinanganak na gaya ng anak ng mabangis na asno."
            },
            {
              "chapter": 11,
              "verse": 13,
              "name": "Job 11:13",
              "text": "Kung iyong ihahanda ang iyong puso, at iuunat mo ang iyong kamay sa kaniya;"
            },
            {
              "chapter": 11,
              "verse": 14,
              "name": "Job 11:14",
              "text": "Kung ang kasamaan ay sumaiyong kamay, ilayo mo, at huwag manahan ang kalikuan sa iyong mga tolda;"
            },
            {
              "chapter": 11,
              "verse": 15,
              "name": "Job 11:15",
              "text": "Walang pagsala ngang iyong itataas ang iyong mukha na walang kapintasan; Oo, ikaw ay matatatag, at hindi matatakot:"
            },
            {
              "chapter": 11,
              "verse": 16,
              "name": "Job 11:16",
              "text": "Sapagka't iyong malilimutan ang iyong karalitaan; iyong aalalahaning parang tubig na umaagos:"
            },
            {
              "chapter": 11,
              "verse": 17,
              "name": "Job 11:17",
              "text": "At ang iyong buhay ay magiging lalong maliwanag kay sa katanghaliang tapat; bagaman magkaroon ng kadiliman, ay magiging gaya ng umaga."
            },
            {
              "chapter": 11,
              "verse": 18,
              "name": "Job 11:18",
              "text": "At ikaw ay matitiwasay sapagka't may pagasa; Oo, ikaw ay magsiyasat sa palibot mo, at magpapahinga kang tiwasay."
            },
            {
              "chapter": 11,
              "verse": 19,
              "name": "Job 11:19",
              "text": "Ikaw nama'y hihiga at walang tatakot sa iyo; Oo, maraming liligaw sa iyo."
            },
            {
              "chapter": 11,
              "verse": 20,
              "name": "Job 11:20",
              "text": "Nguni't ang mga mata ng masama ay mangangalumata, at mawawalan sila ng daang tatakasan, at ang kanilang pagasa ay pagkalagot ng hininga."
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Job 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Job 12:1",
              "text": "Nang magkagayo'y sumagot si Job; at nagsabi,"
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Job 12:2",
              "text": "Walang pagaalinlangan na kayo ang bayan, At ang karunungan ay mamamatay na kasama ninyo."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Job 12:3",
              "text": "Nguni't ako'y may pagkaunawang gaya ninyo: Hindi ako huli sa inyo: Oo, sinong hindi nakaalam ng mga bagay na gaya nito?"
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Job 12:4",
              "text": "Ako'y gaya ng tinatawanan ng kaniyang kapuwa, ako na tumawag sa Dios, at sinagot niya: Ang ganap, ang taong sakdal ay tinatawanan."
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Job 12:5",
              "text": "Sa pagiisip niyaong nasa katiwasayan ay may pagkakutya sa ikasasawi; nahahanda sa mga iyan yaong nangadudulas ang paa."
            },
            {
              "chapter": 12,
              "verse": 6,
              "name": "Job 12:6",
              "text": "Ang mga tolda ng mga tulisan ay gumiginhawa, at silang nangagmumungkahi sa Dios ay tiwasay; na ang kamay ay pinadadalhan ng Dios ng sagana."
            },
            {
              "chapter": 12,
              "verse": 7,
              "name": "Job 12:7",
              "text": "Nguni't tanungin mo ngayon ang mga hayop, at tuturuan ka nila: at ang mga ibon sa himpapawid, at kanilang sasaysayin sa iyo:"
            },
            {
              "chapter": 12,
              "verse": 8,
              "name": "Job 12:8",
              "text": "O magsalita ka sa lupa, at magtuturo sa iyo; at ang mga isda sa dagat ay magsasaysay sa iyo."
            },
            {
              "chapter": 12,
              "verse": 9,
              "name": "Job 12:9",
              "text": "Sinong hindi nakakaalam sa lahat ng mga ito, na ang kamay ng Panginoon ang siyang gumawa nito?"
            },
            {
              "chapter": 12,
              "verse": 10,
              "name": "Job 12:10",
              "text": "Nasa kamay niya ang kaluluwa ng bawa't bagay na may buhay, at ang hininga ng lahat ng mga tao."
            },
            {
              "chapter": 12,
              "verse": 11,
              "name": "Job 12:11",
              "text": "Hindi ba lumilitis ng mga salita ang pakinig; gaya ng ngalangala na lumalasa ng pagkain niya?"
            },
            {
              "chapter": 12,
              "verse": 12,
              "name": "Job 12:12",
              "text": "Nasa mga matanda ang karunungan, at sa kagulangan ang unawa."
            },
            {
              "chapter": 12,
              "verse": 13,
              "name": "Job 12:13",
              "text": "Nasa Dios ang karunungan at kakayahan; kaniya ang payo at pagkaunawa."
            },
            {
              "chapter": 12,
              "verse": 14,
              "name": "Job 12:14",
              "text": "Narito, siya'y nagbabagsak at hindi maitayo uli; siya'y kumulong ng tao at hindi mapagbubuksan."
            },
            {
              "chapter": 12,
              "verse": 15,
              "name": "Job 12:15",
              "text": "Narito, kaniyang pinipigil ang tubig at nangatutuyo; muli, kaniyang binibitawan sila at ginugulo nila ang lupa."
            },
            {
              "chapter": 12,
              "verse": 16,
              "name": "Job 12:16",
              "text": "Nasa kaniya ang kalakasan at ang karunungan, ang nadadaya at ang magdaraya ay kaniya."
            },
            {
              "chapter": 12,
              "verse": 17,
              "name": "Job 12:17",
              "text": "Kaniyang pinalalakad ang mga kasangguni na hubad sa bait, at ginagawa niyang mga mangmang ang mga hukom."
            },
            {
              "chapter": 12,
              "verse": 18,
              "name": "Job 12:18",
              "text": "Kaniyang kinakalag ang panali ng mga hari, at binibigkisan ang kanilang mga baywang ng pamigkis."
            },
            {
              "chapter": 12,
              "verse": 19,
              "name": "Job 12:19",
              "text": "Kaniyang pinalalakad na hubad sa bait ang mga saserdote."
            },
            {
              "chapter": 12,
              "verse": 20,
              "name": "Job 12:20",
              "text": "Kaniyang pinapagbabago ang pananalita ng napagtitiwalaan. At inaalis ang pagkaunawa ng mga matanda."
            },
            {
              "chapter": 12,
              "verse": 21,
              "name": "Job 12:21",
              "text": "Siya'y nagbubuhos ng kutya sa mga pangulo, at kinakalag ang pamigkis ng malakas."
            },
            {
              "chapter": 12,
              "verse": 22,
              "name": "Job 12:22",
              "text": "Siya'y naglilitaw ng mga malalim na bagay mula sa kadiliman, at inilalabas sa liwanag ang lihim ng kamatayan."
            },
            {
              "chapter": 12,
              "verse": 23,
              "name": "Job 12:23",
              "text": "Kaniyang pinararami ang mga bansa at mga nililipol niya: kaniyang pinalaki ang mga bansa, at mga dinala sa pagkabihag."
            },
            {
              "chapter": 12,
              "verse": 24,
              "name": "Job 12:24",
              "text": "Kaniyang inaalis ang pangunawa mula sa mga pinuno ng bayan sa lupa, at kaniyang pinagagala sila sa ilang na doo'y walang lansangan."
            },
            {
              "chapter": 12,
              "verse": 25,
              "name": "Job 12:25",
              "text": "Sila'y nagsisikapa sa dilim na walang liwanag, at kaniyang pinagigiraygiray sila na gaya ng lango."
            }
          ]
        },
        {
          "chapter": 13,
          "name": "Job 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "Job 13:1",
              "text": "Narito, nakita ang lahat na ito ng aking mata, ang aking tainga ay nakarinig at nakaunawa."
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "Job 13:2",
              "text": "Kung ano ang iyong nalalaman, ay nalalaman ko rin naman: hindi ako huli sa inyo."
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "Job 13:3",
              "text": "Walang pagsalang ako'y magsasalita sa Makapangyarihan sa lahat, at nagnanasa akong makipagmatuwiranan sa Dios."
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "Job 13:4",
              "text": "Nguni't kayo'y mapagkatha ng mga kabulaanan. Kayong lahat ay mga manggagamot na walang kabuluhan."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "Job 13:5",
              "text": "Mano nawa ay magsitahimik kayong lahat! At magiging inyong karunungan."
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "Job 13:6",
              "text": "Dinggin ninyo ngayon ang aking pangangatuwiran, at inyong dinggin ang mga pagsasanggalang ng aking mga labi."
            },
            {
              "chapter": 13,
              "verse": 7,
              "name": "Job 13:7",
              "text": "Kayo ba'y mangagsasalita ng kalikuan dahil sa Dios, at mangungusap ng karayaan dahil sa kaniya?"
            },
            {
              "chapter": 13,
              "verse": 8,
              "name": "Job 13:8",
              "text": "Inyo bang lilingapin ang kaniyang pagka Dios? Inyo bang ipakikipagtalo ang Dios?"
            },
            {
              "chapter": 13,
              "verse": 9,
              "name": "Job 13:9",
              "text": "Mabuti ba na kayo'y siyasatin niya? O kung paanong dinadaya ang isang tao ay inyo bang dadayain siya?"
            },
            {
              "chapter": 13,
              "verse": 10,
              "name": "Job 13:10",
              "text": "Walang pagsalang sasawayin niya kayo, kung lihim na kayo'y tatangi ng pagkatao."
            },
            {
              "chapter": 13,
              "verse": 11,
              "name": "Job 13:11",
              "text": "Hindi ba kayo tatakutin ng kaniyang karilagan, at ang gulat sa kaniya ay sasa inyo?"
            },
            {
              "chapter": 13,
              "verse": 12,
              "name": "Job 13:12",
              "text": "Ang inyong mga alaalang sabi ay kawikaang abo, ang inyong mga pagsasanggalang ay mga pagsasanggalang na putik."
            },
            {
              "chapter": 13,
              "verse": 13,
              "name": "Job 13:13",
              "text": "Magsitahimik kayo, bayaan ninyo ako, na ako'y makapagsalita, at paratingin sa akin ang darating."
            },
            {
              "chapter": 13,
              "verse": 14,
              "name": "Job 13:14",
              "text": "Bakit kakagatin ng aking mga ngipin ang aking laman, at aking ilalagay ang aking buhay sa aking kamay?"
            },
            {
              "chapter": 13,
              "verse": 15,
              "name": "Job 13:15",
              "text": "Bagaman ako'y patayin niya, akin ding hihintayin siya: gayon ma'y aking aalalayan ang aking mga lakad sa harap niya."
            },
            {
              "chapter": 13,
              "verse": 16,
              "name": "Job 13:16",
              "text": "Ito man ay magiging aking kaligtasan; sapagka't ang isang di banal ay hindi makahaharap sa kaniya."
            },
            {
              "chapter": 13,
              "verse": 17,
              "name": "Job 13:17",
              "text": "Pakinggan ninyong masikap ang aking pananalita, at ang aking pahayag ay sumainyong mga pakinig."
            },
            {
              "chapter": 13,
              "verse": 18,
              "name": "Job 13:18",
              "text": "Narito, ngayon, aking inayos ang aking usap; talastas ko na ako'y matuwid."
            },
            {
              "chapter": 13,
              "verse": 19,
              "name": "Job 13:19",
              "text": "Sino ang makikipagtalo sa akin? Sapagka't ngayo'y tatahimik ako at malalagot ang aking hininga."
            },
            {
              "chapter": 13,
              "verse": 20,
              "name": "Job 13:20",
              "text": "Dalawang bagay lamang ang huwag mong gawin sa akin, kung magkagayo'y hindi ako magkukubli sa iyong mukha:"
            },
            {
              "chapter": 13,
              "verse": 21,
              "name": "Job 13:21",
              "text": "Iurong mo ng malayo ang iyong kamay sa akin; at huwag akong takutin ng pangingilabot sa iyo."
            },
            {
              "chapter": 13,
              "verse": 22,
              "name": "Job 13:22",
              "text": "Kung magkagayo'y tumawag ka, at ako'y sasagot; o papagsalitain mo ako, at sumagot ka sa akin."
            },
            {
              "chapter": 13,
              "verse": 23,
              "name": "Job 13:23",
              "text": "Ilan ang aking mga kasamaan at mga kasalanan? Ipakilala mo sa akin ang aking pagsalangsang at ang aking kasalanan."
            },
            {
              "chapter": 13,
              "verse": 24,
              "name": "Job 13:24",
              "text": "Bakit ikinukubli mo ang iyong mukha, at inaari mo akong iyong kaaway?"
            },
            {
              "chapter": 13,
              "verse": 25,
              "name": "Job 13:25",
              "text": "Iyo bang pangingilabutin ang isang dahong pinapaspas ng hangin? At iyo bang hahabulin ang dayaming tuyo?"
            },
            {
              "chapter": 13,
              "verse": 26,
              "name": "Job 13:26",
              "text": "Sapagka't ikaw ay sumusulat ng mga mabigat na bagay laban sa akin, at ipinamamana mo sa akin ang mga kasamaan ng aking kabataan:"
            },
            {
              "chapter": 13,
              "verse": 27,
              "name": "Job 13:27",
              "text": "Iyo ring inilalagay ang aking mga paa sa pangawan, at pinupuna mo ang lahat kong landas: ikaw ay gumuguhit ng isang guhit sa palibot ng mga talampakan ng aking mga paa:"
            },
            {
              "chapter": 13,
              "verse": 28,
              "name": "Job 13:28",
              "text": "Bagaman ako'y parang bagay na bulok na natutunaw, na parang damit na kinain ng tanga."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "Job 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Job 14:1",
              "text": "Taong ipinanganak ng babae ay sa kaunting araw, at lipos ng kabagabagan."
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Job 14:2",
              "text": "Siya'y umuusli na gaya ng bulaklak, at nalalagas: siya rin nama'y tumatakas na gaya ng anino, at hindi namamalagi."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Job 14:3",
              "text": "At iyo bang idinidilat ang iyong mga mata sa isang gaya nito, at ipinagsasama mo ako upang hatulan mo?"
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Job 14:4",
              "text": "Sinong makakakuha ng malinis na bagay sa marumi? wala."
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Job 14:5",
              "text": "Yayamang ang kaniyang mga kaarawan ay nangapasiyahan, ang bilang ng kaniyang mga buwan ay talastas mo, at iyong hinanggahan ang kaniyang mga hangganan upang huwag siyang makaraan;"
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Job 14:6",
              "text": "Ilayo mo sa kaniya ang iyong paningin, upang siya'y makapagpahinga, hanggang sa maganap niya, na gaya ng isang magpapaupa, ang kaniyang araw."
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Job 14:7",
              "text": "Sapagka't may pagasa sa isang punong kahoy, na kung ito'y putulin, ay sisibol uli, at ang sariwang sanga niyaon ay hindi maglilikat."
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "Job 14:8",
              "text": "Bagaman ang kaniyang ugat ay tumanda sa lupa, at ang puno niyao'y mamatay sa lupa;"
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "Job 14:9",
              "text": "Gayon ma'y sa pamamagitan ng amoy ng tubig ay sisibol, at magsasanga na gaya ng pananim."
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "Job 14:10",
              "text": "Nguni't ang tao ay namamatay at natutunaw; Oo, ang tao ay nalalagutan ng hininga, at saan nandoon siya?"
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "Job 14:11",
              "text": "Kung paanong ang tubig ay lumalabas sa dagat, at ang ilog ay humuhupa at natutuyo;"
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "Job 14:12",
              "text": "Gayon ang tao ay nabubuwal at hindi na bumabangon: hanggang sa ang langit ay mawala, sila'y hindi magsisibangon, ni mangagigising man sa kanilang pagkakatulog."
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "Job 14:13",
              "text": "Oh ikubli mo nawa ako sa Sheol. Na ingatan mo nawa akong lihim hanggang sa ang iyong poot ay makaraan, na takdaan mo nawa ako ng takdang panahon, at iyong alalahanin ako!"
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "Job 14:14",
              "text": "Kung ang isang tao ay mamatay, mabubuhay pa ba siya? Lahat ng araw ng aking pakikipagbaka ay maghihintay ako, hanggang sa dumating ang pagbabago."
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "Job 14:15",
              "text": "Ikaw ay tatawag, at ako'y sasagot sa iyo: ikaw ay magtataglay ng nasa sa gawa ng iyong mga kamay."
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "Job 14:16",
              "text": "Nguni't ngayo'y binibilang mo ang aking mga hakbang: hindi mo ba pinapansin ang aking kasalanan?"
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "Job 14:17",
              "text": "Ang aking pagsalangsang ay natatatakan sa isang supot, at iyong inilalapat ang aking kasamaan."
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "Job 14:18",
              "text": "At tunay na ang bundok na natitibag, ay nawawala, at ang bato ay napababago mula sa kinaroroonan niyaon;"
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "Job 14:19",
              "text": "Inuukit ng tubig ang mga bato; tinatangay ng mga baha niyaon ang alabok ng lupa: sa gayon iyong sinisira ang pagasa ng tao."
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "Job 14:20",
              "text": "Ikaw ay nananaig kailan man laban sa kaniya at siya'y pumapanaw; iyong pinapagbabago ang kaniyang mukha, at iyong pinayayaon siya."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "Job 14:21",
              "text": "Ang kaniyang mga anak ay nagtataglay ng karangalan, at hindi niya nalalaman; at sila'y ibinababa, nguni't hindi niya nahahalata sila."
            },
            {
              "chapter": 14,
              "verse": 22,
              "name": "Job 14:22",
              "text": "Nguni't ang kaniyang laman sa kaniya ay masakit, at ang kaniyang kaluluwa sa loob niya ay namamanglaw."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "Job 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "Job 15:1",
              "text": "Nang magkagayo'y sumagot si Eliphaz na Temanita, at nagsabi,"
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "Job 15:2",
              "text": "Sasagot ba ang isang pantas ng walang kabuluhang kaalaman, at pupunuin ang kaniyang tiyan ng hanging silanganan?"
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "Job 15:3",
              "text": "Makikipagmatuwiranan ba siya ng walang kapakinabangang pangungusap, o ng mga salita na hindi niya ikagagawa ng mabuti?"
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "Job 15:4",
              "text": "Oo, ikaw ay nagaalis ng katakutan, at iyong pinipigil ang dalangin sa harap ng Dios."
            },
            {
              "chapter": 15,
              "verse": 5,
              "name": "Job 15:5",
              "text": "Sapagka't ang iyong kasamaan ang nagtuturo sa iyong bibig, at iyong pinipili ang dila ng mapagkatha."
            },
            {
              "chapter": 15,
              "verse": 6,
              "name": "Job 15:6",
              "text": "Ang iyong sariling bibig ang humahatol laban sa iyo, at hindi ako; Oo, ang iyong sariling mga labi ay nagpapatotoo laban sa iyo."
            },
            {
              "chapter": 15,
              "verse": 7,
              "name": "Job 15:7",
              "text": "Ikaw ba ang unang tao na ipinanganak? O nalabas ka bang una kay sa mga burol?"
            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "Job 15:8",
              "text": "Iyo bang narinig ang lihim na payo ng Dios? At ikaw ba'y nagpigil ng karunungan sa iyong sarili?"
            },
            {
              "chapter": 15,
              "verse": 9,
              "name": "Job 15:9",
              "text": "Anong nalalaman mo na di namin nalalaman? Anong nauunawa mo na wala sa amin?"
            },
            {
              "chapter": 15,
              "verse": 10,
              "name": "Job 15:10",
              "text": "Kasama namin ay mga ulong may uban, at mga totoong napakatandang tao, matandang makapupo kay sa iyong ama."
            },
            {
              "chapter": 15,
              "verse": 11,
              "name": "Job 15:11",
              "text": "Ang mga pagaliw ba ng Dios ay totoong kaunti pa sa ganang iyo, sa makatuwid baga'y ang salitang napakabuti sa iyo?"
            },
            {
              "chapter": 15,
              "verse": 12,
              "name": "Job 15:12",
              "text": "Bakit ka napadadala sa iyong puso? At bakit kumikindat ang iyong mga mata?"
            },
            {
              "chapter": 15,
              "verse": 13,
              "name": "Job 15:13",
              "text": "Na tinatalikdan mo ng iyong diwa ang Dios, at binibigkas mo ang ganyang mga salita sa iyong bibig."
            },
            {
              "chapter": 15,
              "verse": 14,
              "name": "Job 15:14",
              "text": "Ano ang tao upang maging malinis? At siyang ipinanganak ng babae, upang siya'y maging matuwid?"
            },
            {
              "chapter": 15,
              "verse": 15,
              "name": "Job 15:15",
              "text": "Narito, siya'y hindi naglalagak ng tiwala sa kaniyang mga banal; Oo, ang langit ay hindi malinis sa kaniyang paningin."
            },
            {
              "chapter": 15,
              "verse": 16,
              "name": "Job 15:16",
              "text": "Gaano pa nga kaliit ang karumaldumal at hamak, ang taong umiinom ng kasamaan na parang tubig!"
            },
            {
              "chapter": 15,
              "verse": 17,
              "name": "Job 15:17",
              "text": "Ipakikilala ko sa iyo, dinggin mo ako; at ang aking nakita ay aking ipahahayag:"
            },
            {
              "chapter": 15,
              "verse": 18,
              "name": "Job 15:18",
              "text": "(Ang isinaysay ng mga pantas na mula sa kanilang mga magulang, at hindi inilingid;"
            },
            {
              "chapter": 15,
              "verse": 19,
              "name": "Job 15:19",
              "text": "Sa mga yaon lamang ibinigay ang lupain, at walang taga ibang lupa na dumaan sa gitna nila:)"
            },
            {
              "chapter": 15,
              "verse": 20,
              "name": "Job 15:20",
              "text": "Ang masamang tao ay nagdaramdam ng sakit lahat ng kaniyang araw, sa makatuwid baga'y ang bilang ng mga taon na itinakda sa mamimighati."
            },
            {
              "chapter": 15,
              "verse": 21,
              "name": "Job 15:21",
              "text": "Ang hugong ng kakilabutan ay nasa kaniyang mga pakinig; sa kaginhawahan ay daratnan siya ng mga mananamsam:"
            },
            {
              "chapter": 15,
              "verse": 22,
              "name": "Job 15:22",
              "text": "Siya'y hindi naniniwala na babalik siya na mula sa kadiliman, at siya'y hinihintay ng tabak:"
            },
            {
              "chapter": 15,
              "verse": 23,
              "name": "Job 15:23",
              "text": "Siya'y gumagala dahil sa tinapay, na nagsasabi: Nasaan? Kaniyang nalalaman na ang araw ng kadiliman ay handa sa kaniyang kamay:"
            },
            {
              "chapter": 15,
              "verse": 24,
              "name": "Job 15:24",
              "text": "Kapanglawan at kadalamhatian ay tumatakot sa kaniya: nangananaig laban sa kaniya, na gaya ng isang hari na handa sa pakikipagbaka;"
            },
            {
              "chapter": 15,
              "verse": 25,
              "name": "Job 15:25",
              "text": "Sapagka't iniuunat niya ang kaniyang kamay laban sa Dios. At nagpapalalo laban sa Makapangyarihan sa lahat;"
            },
            {
              "chapter": 15,
              "verse": 26,
              "name": "Job 15:26",
              "text": "Tinatakbo niya siya na may mapagmatigas na leeg, sa kakapalan ng kaniyang mga kalasag;"
            },
            {
              "chapter": 15,
              "verse": 27,
              "name": "Job 15:27",
              "text": "Sapagka't tinakpan niya ang kaniyang mukha ng kaniyang katabaan at nagpangulubot ng kaniyang mga pigi;"
            },
            {
              "chapter": 15,
              "verse": 28,
              "name": "Job 15:28",
              "text": "At siya'y tumahan sa mga sirang bayan, sa mga bahay na walang taong tumatahan, na madaling magiging mga bunton."
            },
            {
              "chapter": 15,
              "verse": 29,
              "name": "Job 15:29",
              "text": "Hindi siya yayaman, o mamamalagi man ang kaniyang pag-aari. Ni di lalawak sa lupa ang kaniyang mga tinatangkilik."
            },
            {
              "chapter": 15,
              "verse": 30,
              "name": "Job 15:30",
              "text": "Siya'y hindi hihiwalay sa kadiliman; tutuyuin ng liyab ang kaniyang mga sanga, at sa pamamagitan ng hininga ng bibig ng Dios ay papanaw siya."
            },
            {
              "chapter": 15,
              "verse": 31,
              "name": "Job 15:31",
              "text": "Huwag siyang tumiwala sa kalayawan na dayain ang sarili: sapagka't kalayawan ang magiging kagantihan sa kaniya."
            },
            {
              "chapter": 15,
              "verse": 32,
              "name": "Job 15:32",
              "text": "Magaganap ito bago dumating ang kaniyang kapanahunan, at ang kaniyang sanga ay hindi mananariwa."
            },
            {
              "chapter": 15,
              "verse": 33,
              "name": "Job 15:33",
              "text": "Lalagasin niya ang kaniyang mga hilaw na ubas na gaya ng puno ng ubas, at lalagasin ang kaniyang bulaklak na gaya ng olibo."
            },
            {
              "chapter": 15,
              "verse": 34,
              "name": "Job 15:34",
              "text": "Sapagka't ang pulutong ng mga di banal ay hindi lalago, at susupukin ng apoy ang mga toldang suhulan."
            },
            {
              "chapter": 15,
              "verse": 35,
              "name": "Job 15:35",
              "text": "Sila'y nag-iisip ng pagapi at naglalabas ng kasamaan, at ang kanilang kalooban ay naghahanda ng pagdaraya."
            }
          ]
        },
        {
          "chapter": 16,
          "name": "Job 16",
          "verses": [
            {
              "chapter": 16,
              "verse": 1,
              "name": "Job 16:1",
              "text": "Nang magkagayo'y sumagot si Job, at nagsabi,"
            },
            {
              "chapter": 16,
              "verse": 2,
              "name": "Job 16:2",
              "text": "Ako'y nakarinig ng maraming ganyang bagay: maralitang mga mangaaliw kayong lahat."
            },
            {
              "chapter": 16,
              "verse": 3,
              "name": "Job 16:3",
              "text": "Magkakawakas ba ang mga walang kabuluhang salita? O anong naguudyok sa iyo, na ikaw ay sumagot?"
            },
            {
              "chapter": 16,
              "verse": 4,
              "name": "Job 16:4",
              "text": "Ako nama'y makapangungusap na gaya ng inyong ginagawa; kung ang inyong kaluluwa ay nasa kalagayan ng aking kaluluwa, ako'y makapagdudugtongdugtong ng salita laban sa inyo, at maigagalaw ang aking ulo sa inyo."
            },
            {
              "chapter": 16,
              "verse": 5,
              "name": "Job 16:5",
              "text": "Nguni't aking palalakasin kayo ng aking bibig, at ang pagaliw ng aking mga labi ay magpapalikat ng inyong hirap,"
            },
            {
              "chapter": 16,
              "verse": 6,
              "name": "Job 16:6",
              "text": "Bagaman ako'y nagsasalita, ang aking hirap ay hindi naglilikat: at bagaman ako'y tumatahimik, anong ikinalalayo sa akin?"
            },
            {
              "chapter": 16,
              "verse": 7,
              "name": "Job 16:7",
              "text": "Nguni't ngayo'y niyamot niya ako: nilansag mo ang aking buong pulutong."
            },
            {
              "chapter": 16,
              "verse": 8,
              "name": "Job 16:8",
              "text": "At ako'y pinagdalamhati mo, na siyang saksi laban sa akin; at ang aking kapayatan ay bumabangon laban sa akin, nagpapatotoo sa aking mukha."
            },
            {
              "chapter": 16,
              "verse": 9,
              "name": "Job 16:9",
              "text": "Niluray niya ako sa kaniyang kapootan, at inusig ako; pinagngangalitan niya ako ng kaniyang mga ngipin: pinangdidilatan ako ng mga mata ng aking kaaway."
            },
            {
              "chapter": 16,
              "verse": 10,
              "name": "Job 16:10",
              "text": "Kanilang pinagbubukahan ako ng kanilang bibig: kanilang sinampal ako sa mukha na kahiyahiya: sila'y nagpipisan laban sa akin."
            },
            {
              "chapter": 16,
              "verse": 11,
              "name": "Job 16:11",
              "text": "Ibinibigay ako ng Dios sa di banal, at inihahagis niya ako sa mga kamay ng masama."
            },
            {
              "chapter": 16,
              "verse": 12,
              "name": "Job 16:12",
              "text": "Ako'y nasa kaginhawahan at kaniyang niligalig akong mainam; Oo, sinunggaban niya ako sa leeg, at pinagwaraywaray niya ako: inilagay naman niya akong pinakatanda niya."
            },
            {
              "chapter": 16,
              "verse": 13,
              "name": "Job 16:13",
              "text": "Kinubkob ako sa palibot ng kaniyang mga mamamana, kaniyang sinaksak ang aking mga bato, at hindi nagpapatawad; kaniyang ibinubuhos ang aking apdo sa lupa."
            },
            {
              "chapter": 16,
              "verse": 14,
              "name": "Job 16:14",
              "text": "Kaniyang binubugbog ako ng bugbog at bugbog; siya'y gaya ng isang higanti na dinadaluhong niya ako."
            },
            {
              "chapter": 16,
              "verse": 15,
              "name": "Job 16:15",
              "text": "Ako'y nanahi ng kayong magaspang sa aking katawan, at aking inilugmok ang aking kapalaluan sa alabok."
            },
            {
              "chapter": 16,
              "verse": 16,
              "name": "Job 16:16",
              "text": "Ang aking mukha ay namamaga sa pagiyak, at nasa aking mga pilik-mata ang anino ng kamatayan;"
            },
            {
              "chapter": 16,
              "verse": 17,
              "name": "Job 16:17",
              "text": "Bagaman walang karahasan sa aking mga kamay, at ang aking dalangin ay malinis,"
            },
            {
              "chapter": 16,
              "verse": 18,
              "name": "Job 16:18",
              "text": "Oh lupa, huwag mong tabunan ang aking dugo, at huwag magkaroon ng pahingahang dako ang aking daing."
            },
            {
              "chapter": 16,
              "verse": 19,
              "name": "Job 16:19",
              "text": "Kahit na ngayon, narito, ang aking saksi ay nasa langit, at siyang nananagot sa akin ay nasa kaitaasan."
            },
            {
              "chapter": 16,
              "verse": 20,
              "name": "Job 16:20",
              "text": "Ginagalit ako ng aking mga kaibigan: nguni't ang aking mata ay nagbubuhos ng mga luha sa Dios;"
            },
            {
              "chapter": 16,
              "verse": 21,
              "name": "Job 16:21",
              "text": "Upang kaniyang alalayan ang katuwiran ng tao sa Dios; at ang anak ng tao sa kaniyang kapuwa."
            },
            {
              "chapter": 16,
              "verse": 22,
              "name": "Job 16:22",
              "text": "Sapagka't pagsapit ng ilang taon, ako'y papanaw sa daan na hindi ko pagbabalikan."
            }
          ]
        },
        {
          "chapter": 17,
          "name": "Job 17",
          "verses": [
            {
              "chapter": 17,
              "verse": 1,
              "name": "Job 17:1",
              "text": "Ang aking diwa ay nanglulumo, ang aking mga kaarawan ay natatapos, ang libingan ay handa sa akin."
            },
            {
              "chapter": 17,
              "verse": 2,
              "name": "Job 17:2",
              "text": "Tunay na may mga manunuya na kasama ako, at ang aking mata ay nananahan sa kanilang pamumungkahi."
            },
            {
              "chapter": 17,
              "verse": 3,
              "name": "Job 17:3",
              "text": "Magbigay ka ngayon ng sangla, panagutan mo ako ng iyong sarili; sinong magbubuhat ng mga kamay sa akin?"
            },
            {
              "chapter": 17,
              "verse": 4,
              "name": "Job 17:4",
              "text": "Sapagka't iyong ikinubli ang kanilang puso sa pagunawa: kaya't hindi mo sila itataas."
            },
            {
              "chapter": 17,
              "verse": 5,
              "name": "Job 17:5",
              "text": "Ang paglililo sa kaniyang mga kaibigan upang mahuli, ang mga mata nga ng kaniyang mga anak ay mangangalumata."
            },
            {
              "chapter": 17,
              "verse": 6,
              "name": "Job 17:6",
              "text": "Nguni't ginawa rin niya akong kakutyaan ng bayan: at niluraan nila ako sa mukha."
            },
            {
              "chapter": 17,
              "verse": 7,
              "name": "Job 17:7",
              "text": "Ang aking mata naman ay nanglalabo dahil sa kapanglawan. At ang madlang sangkap ko ay parang isang anino."
            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "Job 17:8",
              "text": "Mga matuwid na tao ay matitigilan nito, at ang walang sala ay babangon laban sa di banal."
            },
            {
              "chapter": 17,
              "verse": 9,
              "name": "Job 17:9",
              "text": "Gayon ma'y magpapatuloy ang matuwid ng kaniyang lakad, at ang may malinis na mga kamay ay lalakas ng lalakas."
            },
            {
              "chapter": 17,
              "verse": 10,
              "name": "Job 17:10",
              "text": "Nguni't tungkol sa inyong lahat, magsiparito kayo ngayon uli; at hindi ako makakasumpong ng isang pantas sa gitna ninyo."
            },
            {
              "chapter": 17,
              "verse": 11,
              "name": "Job 17:11",
              "text": "Ang aking mga kaarawan ay lumipas, ang aking mga panukala ay nangasira, sa makatuwid baga'y ang mga akala ng aking puso."
            },
            {
              "chapter": 17,
              "verse": 12,
              "name": "Job 17:12",
              "text": "Kanilang ipinalit ang araw sa gabi: ang liwanag, wika nila, ay malapit sa kadiliman."
            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "Job 17:13",
              "text": "Kung aking hanapin ang Sheol na parang aking bahay; kung aking ilatag ang aking higaan sa kadiliman:"
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "Job 17:14",
              "text": "Kung sinabi ko sa kapahamakan: ikaw ay aking ama: sa uod: ikaw ay aking ina, at aking kapatid na babae;"
            },
            {
              "chapter": 17,
              "verse": 15,
              "name": "Job 17:15",
              "text": "Nasaan nga ang aking pagasa? At tungkol sa aking pagasa, sinong makakakita?"
            },
            {
              "chapter": 17,
              "verse": 16,
              "name": "Job 17:16",
              "text": "Lulusong sa mga pangawan ng Sheol, pagtataglay ng kapahingahan sa alabok."
            }
          ]
        },
        {
          "chapter": 18,
          "name": "Job 18",
          "verses": [
            {
              "chapter": 18,
              "verse": 1,
              "name": "Job 18:1",
              "text": "Nang magkagayo'y sumagot si Bildad na Suhita, at nagsabi,"
            },
            {
              "chapter": 18,
              "verse": 2,
              "name": "Job 18:2",
              "text": "Hanggang kailan manghuhuli kayo ng mga salita? Inyong bulayin, at pagkatapos ay magsasalita kami."
            },
            {
              "chapter": 18,
              "verse": 3,
              "name": "Job 18:3",
              "text": "Bakit kami nangabibilang na parang mga hayop, at naging marumi sa iyong paningin?"
            },
            {
              "chapter": 18,
              "verse": 4,
              "name": "Job 18:4",
              "text": "Ikaw na nagpapakabagbag sa iyong galit, pababayaan ba ang lupa dahil sa iyo? O babaguhin ba ang bato mula sa kinaroroonan?"
            },
            {
              "chapter": 18,
              "verse": 5,
              "name": "Job 18:5",
              "text": "Oo, ang ilaw ng masama ay papatayin, at ang liyab ng kaniyang apoy ay hindi liliwanag."
            },
            {
              "chapter": 18,
              "verse": 6,
              "name": "Job 18:6",
              "text": "Ang ilaw ay magdidilim sa kaniyang tolda, at ang kaniyang ilawan sa itaas niya ay papatayin."
            },
            {
              "chapter": 18,
              "verse": 7,
              "name": "Job 18:7",
              "text": "Ang mga hakbang ng kaniyang kalakasan ay mapipigil, at ang kaniyang sariling payo ang magbabagsak sa kaniya."
            },
            {
              "chapter": 18,
              "verse": 8,
              "name": "Job 18:8",
              "text": "Sapagka't siya'y inihagis sa lambat ng kaniyang sariling mga paa, at siya'y lumalakad sa mga silo."
            },
            {
              "chapter": 18,
              "verse": 9,
              "name": "Job 18:9",
              "text": "Isang panghuli ang huhuli sa kaniya sa mga sakong. At isang silo ay huhuli sa kaniya."
            },
            {
              "chapter": 18,
              "verse": 10,
              "name": "Job 18:10",
              "text": "Ang panali ay nakakubli ukol sa kaniya sa lupa, at isang patibong na ukol sa kaniya ay nasa daan."
            },
            {
              "chapter": 18,
              "verse": 11,
              "name": "Job 18:11",
              "text": "Mga kakilabutan ay tatakot sa kaniya sa lahat ng dako, at hahabol sa kaniya sa kaniyang mga sakong."
            },
            {
              "chapter": 18,
              "verse": 12,
              "name": "Job 18:12",
              "text": "Ang kaniyang kalakasan ay manglalata sa gutom, at ang kapahamakan ay mahahanda sa kaniyang tagiliran."
            },
            {
              "chapter": 18,
              "verse": 13,
              "name": "Job 18:13",
              "text": "Susupukin ang mga sangkap ng kaniyang katawan, Oo, lalamunin ng panganay ng kamatayan ang kaniyang mga sangkap."
            },
            {
              "chapter": 18,
              "verse": 14,
              "name": "Job 18:14",
              "text": "Siya'y ilalabas sa kaniyang tolda na kaniyang tinitiwalaan; at siya'y dadalhin sa hari ng mga kakilabutan."
            },
            {
              "chapter": 18,
              "verse": 15,
              "name": "Job 18:15",
              "text": "Tatahan sa kaniyang tolda yaong di niya kaanoano: azufre ay makakalat sa kaniyang tahanan."
            },
            {
              "chapter": 18,
              "verse": 16,
              "name": "Job 18:16",
              "text": "Ang kaniyang mga ugat ay mangatutuyo sa ilalim, at sa ibabaw ay puputulin ang kaniyang sanga."
            },
            {
              "chapter": 18,
              "verse": 17,
              "name": "Job 18:17",
              "text": "Ang alaala sa kaniya ay mawawala sa lupa, at siya'y mawawalan ng pangalan sa lansangan."
            },
            {
              "chapter": 18,
              "verse": 18,
              "name": "Job 18:18",
              "text": "Siya'y ihahatid sa kadiliman mula sa liwanag, at itatapon sa labas ng sanglibutan."
            },
            {
              "chapter": 18,
              "verse": 19,
              "name": "Job 18:19",
              "text": "Siya'y hindi magkakaroon kahit anak, ni anak man ng anak sa gitna ng kaniyang bayan, ni anomang nalabi sa kaniyang pinakipamayanan."
            },
            {
              "chapter": 18,
              "verse": 20,
              "name": "Job 18:20",
              "text": "Silang nagsisidating pagkatapos ay mangatitigilan sa kaniyang kaarawan, gaya ng nangauna na nangatakot."
            },
            {
              "chapter": 18,
              "verse": 21,
              "name": "Job 18:21",
              "text": "Tunay na ganyan ang mga tahanan ng mga liko, at ito ang kalalagyan niya na hindi nakakakilala sa Dios."
            }
          ]
        },
        {
          "chapter": 19,
          "name": "Job 19",
          "verses": [
            {
              "chapter": 19,
              "verse": 1,
              "name": "Job 19:1",
              "text": "Nang magkagayo'y sumagot si Job, at nagsabi,"
            },
            {
              "chapter": 19,
              "verse": 2,
              "name": "Job 19:2",
              "text": "Hanggang kailan pahihirapan ninyo ang aking kaluluwa, at babagabagin ako ng mga salita?"
            },
            {
              "chapter": 19,
              "verse": 3,
              "name": "Job 19:3",
              "text": "Ng makasangpung ito ay pinulaan ninyo ako: kayo'y hindi nangapapahiya na nangagpapahirap sa akin."
            },
            {
              "chapter": 19,
              "verse": 4,
              "name": "Job 19:4",
              "text": "At kahima't ako'y magkamali, ang aking kamalian ay maiwan sa aking sarili."
            },
            {
              "chapter": 19,
              "verse": 5,
              "name": "Job 19:5",
              "text": "Kung tunay na kayo'y magpapakalaki laban sa akin, at ipakikipagtalo laban sa akin ang kakutyaan ko:"
            },
            {
              "chapter": 19,
              "verse": 6,
              "name": "Job 19:6",
              "text": "Talastasin ninyo ngayon na inilugmok ako ng Dios, at inikid ako ng kaniyang silo."
            },
            {
              "chapter": 19,
              "verse": 7,
              "name": "Job 19:7",
              "text": "Narito, ako'y humihiyaw dahil sa kamalian, nguni't hindi ako dinidinig; ako'y humihiyaw ng tulong, nguni't walang kahatulan."
            },
            {
              "chapter": 19,
              "verse": 8,
              "name": "Job 19:8",
              "text": "Kaniyang pinadiran ang aking daan upang huwag akong makaraan, at naglagay ng kadiliman sa aking mga landas."
            },
            {
              "chapter": 19,
              "verse": 9,
              "name": "Job 19:9",
              "text": "Hinubaran niya ako ng aking kaluwalhatian, at inalis ang putong sa aking ulo."
            },
            {
              "chapter": 19,
              "verse": 10,
              "name": "Job 19:10",
              "text": "Kaniyang inilugmok ako sa bawa't dako, at ako'y nananaw: at ang aking pagasa ay binunot niyang parang punong kahoy."
            },
            {
              "chapter": 19,
              "verse": 11,
              "name": "Job 19:11",
              "text": "Kaniya rin namang pinapagalab ang kaniyang pagiinit laban sa akin, at ibinilang niya ako sa kaniya na gaya ng isa sa kaniyang mga kaaway,"
            },
            {
              "chapter": 19,
              "verse": 12,
              "name": "Job 19:12",
              "text": "Ang kaniyang mga hukbo ay dumarating na magkakasama, at ipinagpatuloy ang kanilang lakad laban sa akin, at kinubkob ang palibot ng aking tolda."
            },
            {
              "chapter": 19,
              "verse": 13,
              "name": "Job 19:13",
              "text": "Inilayo niya ang aking mga kapatid sa akin, at ang aking mga kakilala ay pawang nangiba sa akin."
            },
            {
              "chapter": 19,
              "verse": 14,
              "name": "Job 19:14",
              "text": "Ang aking mga kamaganak ay nangagsilayo, at nilimot ako ng aking mga kasamasamang kaibigan."
            },
            {
              "chapter": 19,
              "verse": 15,
              "name": "Job 19:15",
              "text": "Silang nagsisitahan sa aking bahay, at ang aking mga lingkod na babae, ay ibinibilang akong manunuluyan; ako'y naging kaiba sa kanilang paningin."
            },
            {
              "chapter": 19,
              "verse": 16,
              "name": "Job 19:16",
              "text": "Aking tinatawag ang aking lingkod, at hindi ako sinasagot, bagaman sinasamo ko siya ng aking bibig."
            },
            {
              "chapter": 19,
              "verse": 17,
              "name": "Job 19:17",
              "text": "Ang aking hininga ay iba sa aking asawa, at ang aking pamanhik sa mga anak ng tunay kong ina."
            },
            {
              "chapter": 19,
              "verse": 18,
              "name": "Job 19:18",
              "text": "Pati ng mga bata ay humahamak sa akin; kung ako'y bumangon, sila'y nangagsasalita ng laban sa akin:"
            },
            {
              "chapter": 19,
              "verse": 19,
              "name": "Job 19:19",
              "text": "Lahat ng aking mahal na kaibigan ay nangayayamot sa akin: at ang aking minamahal ay nagsipihit ng laban sa akin,"
            },
            {
              "chapter": 19,
              "verse": 20,
              "name": "Job 19:20",
              "text": "Ang aking buto ay dumidikit sa aking balat at sa aking laman, at ako'y nakatanan ng sukat sa balat ng aking mga ngipin."
            },
            {
              "chapter": 19,
              "verse": 21,
              "name": "Job 19:21",
              "text": "Mahabag kayo sa akin, mahabag kayo sa akin, Oh kayong mga kaibigan ko; sapagka't kinilos ako ng kamay ng Dios,"
            },
            {
              "chapter": 19,
              "verse": 22,
              "name": "Job 19:22",
              "text": "Bakit ninyo ako inuusig na gaya ng Dios. At hindi pa kayo nasisiyahan sa akin laman?"
            },
            {
              "chapter": 19,
              "verse": 23,
              "name": "Job 19:23",
              "text": "Oh mangasulat nawa ngayon ang aking mga salita! Oh mangalagda nawa sa isang aklat!"
            },
            {
              "chapter": 19,
              "verse": 24,
              "name": "Job 19:24",
              "text": "Ng isa nawang panulat na bakal at tingga, na mangaukit nawa sa bato magpakailan man!"
            },
            {
              "chapter": 19,
              "verse": 25,
              "name": "Job 19:25",
              "text": "Nguni't talastas ko na manunubos sa akin ay buhay, at siya'y tatayo sa lupa sa kahulihulihan:"
            },
            {
              "chapter": 19,
              "verse": 26,
              "name": "Job 19:26",
              "text": "At pagkatapos na magibang ganito ang aking balat, gayon ma'y makikita ko ang Dios sa aking laman:"
            },
            {
              "chapter": 19,
              "verse": 27,
              "name": "Job 19:27",
              "text": "Siyang makikita ko ng sarili, at mamamasdan ng aking mga mata, at hindi ng iba. Ang aking puso ay natutunaw sa loob ko."
            },
            {
              "chapter": 19,
              "verse": 28,
              "name": "Job 19:28",
              "text": "Kung inyong sabihin: paanong aming pag-uusigin siya? Dangang ang kadahilanan ay nasusumpungan sa akin;"
            },
            {
              "chapter": 19,
              "verse": 29,
              "name": "Job 19:29",
              "text": "Mangatakot kayo sa tabak: sapagka't ang kapootan ang nagdadala ng mga parusa ng tabak, upang inyong malaman na may kahatulan."
            }
          ]
        },
        {
          "chapter": 20,
          "name": "Job 20",
          "verses": [
            {
              "chapter": 20,
              "verse": 1,
              "name": "Job 20:1",
              "text": "Nang magkagayo'y sumagot si Zophar na Naamathita, at nagsabi,"
            },
            {
              "chapter": 20,
              "verse": 2,
              "name": "Job 20:2",
              "text": "Kaya't nagbibigay sagot sa akin ang aking mga pagiisip, dahil nga sa aking pagmamadali na taglay ko."
            },
            {
              "chapter": 20,
              "verse": 3,
              "name": "Job 20:3",
              "text": "Aking narinig ang saway na inilalagay ako sa kahihiyan, at ang diwa ng aking pagkaunawa ay sumasagot sa akin."
            },
            {
              "chapter": 20,
              "verse": 4,
              "name": "Job 20:4",
              "text": "Hindi mo ba nalalaman ito ng una, mula nang ang tao'y malagay sa lupa,"
            },
            {
              "chapter": 20,
              "verse": 5,
              "name": "Job 20:5",
              "text": "Na ang pagtatagumpay ng masama ay maikli, at ang kagalakan ng di banal ay sandali lamang?"
            },
            {
              "chapter": 20,
              "verse": 6,
              "name": "Job 20:6",
              "text": "Bagaman ang kaniyang karilagan ay napaiilanglang hanggang sa langit, at ang kaniyang ulo ay umaabot hanggang sa mga alapaap;"
            },
            {
              "chapter": 20,
              "verse": 7,
              "name": "Job 20:7",
              "text": "Gayon may matutunaw siya magpakailan man, na gaya ng kaniyang sariling dumi: silang nangakakita sa kaniya ay mangagsasabi: Nasaan siya?"
            },
            {
              "chapter": 20,
              "verse": 8,
              "name": "Job 20:8",
              "text": "Siya'y mawawala na gaya ng panaginip, at hindi masusumpungan. Oo, siya'y mawawala na parang pangitain sa gabi."
            },
            {
              "chapter": 20,
              "verse": 9,
              "name": "Job 20:9",
              "text": "Ang mata na nakakita sa kaniya ay hindi na siya makikita pa; ni mamamalas pa man siya sa kaniyang pook."
            },
            {
              "chapter": 20,
              "verse": 10,
              "name": "Job 20:10",
              "text": "Hahanapin ng kaniyang mga anak ang lingap ng dukha, at ang kaniyang mga kamay ay magsasauli ng kaniyang kayamanan."
            },
            {
              "chapter": 20,
              "verse": 11,
              "name": "Job 20:11",
              "text": "Ang kaniyang mga buto ay puspos ng kaniyang kabataan, nguni't hihiga na kasama niya sa alabok."
            },
            {
              "chapter": 20,
              "verse": 12,
              "name": "Job 20:12",
              "text": "Bagaman ang kasamaan ay masarap sa kaniyang bibig, bagaman kaniyang itago sa ilalim ng kaniyang dila;"
            },
            {
              "chapter": 20,
              "verse": 13,
              "name": "Job 20:13",
              "text": "Bagaman kaniyang patawarin, at hindi niya ito babayaan, kundi ingatan pa sa loob ng kaniyang bibig;"
            },
            {
              "chapter": 20,
              "verse": 14,
              "name": "Job 20:14",
              "text": "Gayon ma'y ang kaniyang pagkain ay nabago na sa kaniyang tiyan, siyang kamandag ng mga ahas sa loob niya."
            },
            {
              "chapter": 20,
              "verse": 15,
              "name": "Job 20:15",
              "text": "Siya'y sumakmal ng mga kayamanan, at kaniyang mga isusuka uli: mga aalisin uli ng Dios sa kaniyang tiyan."
            },
            {
              "chapter": 20,
              "verse": 16,
              "name": "Job 20:16",
              "text": "Kaniyang hihititin ang kamandag ng mga ahas; papatayin siya ng dila ng ulupong."
            },
            {
              "chapter": 20,
              "verse": 17,
              "name": "Job 20:17",
              "text": "Hindi niya matitingnan ang mga ilog, ang umaagos na mga bukal ng pulot at mantekilya."
            },
            {
              "chapter": 20,
              "verse": 18,
              "name": "Job 20:18",
              "text": "Na kaniyang isasauli ang kaniyang pinagpagalan, at hindi lalamunin; ayon sa pag-aari na kaniyang tinangkilik, hindi siya magagalak."
            },
            {
              "chapter": 20,
              "verse": 19,
              "name": "Job 20:19",
              "text": "Sapagka't kaniyang pinighati at pinabayaan ang dukha; kaniyang kinuhang marahas ang isang bahay; at hindi niya itatayo."
            },
            {
              "chapter": 20,
              "verse": 20,
              "name": "Job 20:20",
              "text": "Sapagka't hindi siya nakakilala ng katiwasayan sa loob niya, hindi siya makapagliligtas ng anoman sa kaniyang kinaluluguran."
            },
            {
              "chapter": 20,
              "verse": 21,
              "name": "Job 20:21",
              "text": "Walang bagay na naiwan na hindi niya sinakmal; kaya't ang kaniyang kaginhawahan ay hindi mananatili."
            },
            {
              "chapter": 20,
              "verse": 22,
              "name": "Job 20:22",
              "text": "Sa lubos niyang kasaganaan ay magigipit siya; ang kamay ng bawa't nasa karalitaan ay darating sa kaniya."
            },
            {
              "chapter": 20,
              "verse": 23,
              "name": "Job 20:23",
              "text": "Pagka kaniyang bubusugin ang kaniyang tiyan, ihuhulog ng Dios ang kaniyang mabangis na poot sa kaniya. At ibubugso sa kaniya samantalang siya'y kumakain."
            },
            {
              "chapter": 20,
              "verse": 24,
              "name": "Job 20:24",
              "text": "Kaniyang tatakasan ang sandatang bakal, at ang busog na tanso ay hihilagpos sa kaniya."
            },
            {
              "chapter": 20,
              "verse": 25,
              "name": "Job 20:25",
              "text": "Binubunot niya ang pana, at lumalabas sa kaniyang katawan: Oo, ang makintab na talim ay lumalabas mula sa kaniyang apdo; mga kakilabutan ang sumasa kaniya."
            },
            {
              "chapter": 20,
              "verse": 26,
              "name": "Job 20:26",
              "text": "Lahat na kadiliman ay nalalagay na mga pinakakayamanan niya; isang apoy na hindi hinipan ng tao ay susupok sa kaniya: susupukin niyaon ang naiwan sa kaniyang tolda."
            },
            {
              "chapter": 20,
              "verse": 27,
              "name": "Job 20:27",
              "text": "Ihahayag ng mga langit ang kaniyang kasamaan, at ang lupa ay babangon laban sa kaniya."
            },
            {
              "chapter": 20,
              "verse": 28,
              "name": "Job 20:28",
              "text": "Ang pakinabang ng kaniyang bahay ay yayaon, ang kaniyang mga pag-aari ay huhuho sa kaarawan ng kaniyang kapootan."
            },
            {
              "chapter": 20,
              "verse": 29,
              "name": "Job 20:29",
              "text": "Ito ang bahagi ng masamang tao mula sa Dios, at ang manang takda sa kaniya ng Dios."
            }
          ]
        },
        {
          "chapter": 21,
          "name": "Job 21",
          "verses": [
            {
              "chapter": 21,
              "verse": 1,
              "name": "Job 21:1",
              "text": "Nang magkagayo'y sumagot si Job, at nagsabi,"
            },
            {
              "chapter": 21,
              "verse": 2,
              "name": "Job 21:2",
              "text": "Pakinggan ninyong mainam ang aking pananalita; at ito'y maging inyong mga kaaliwan."
            },
            {
              "chapter": 21,
              "verse": 3,
              "name": "Job 21:3",
              "text": "Pagdalitaan ninyo ako, at ako nama'y magsasalita, at pagkatapos na ako'y makapagsalita, ay manuya kayo."
            },
            {
              "chapter": 21,
              "verse": 4,
              "name": "Job 21:4",
              "text": "Tungkol sa akin, ay sa tao ba ang aking daing? At bakit hindi ako maiinip?"
            },
            {
              "chapter": 21,
              "verse": 5,
              "name": "Job 21:5",
              "text": "Tandaan ninyo ako, at matigilan kayo. At ilagay ninyo ang inyong kamay sa inyong bibig,"
            },
            {
              "chapter": 21,
              "verse": 6,
              "name": "Job 21:6",
              "text": "Pagka aking naaalaala nga ay nababagabag ako, at kikilabutan ang humahawak sa aking laman."
            },
            {
              "chapter": 21,
              "verse": 7,
              "name": "Job 21:7",
              "text": "Bakit nabubuhay ang masama, nagiging matanda, oo, nagiging malakas ba sa kapangyarihan?"
            },
            {
              "chapter": 21,
              "verse": 8,
              "name": "Job 21:8",
              "text": "Ang kanilang binhi ay natatatag nakasama nila sa kanilang paningin, at ang kanilang mga suwi ay nasa harap ng kanilang mga mata."
            },
            {
              "chapter": 21,
              "verse": 9,
              "name": "Job 21:9",
              "text": "Ang kanilang mga bahay ay tiwasay na walang takot, kahit ang pamalo man ng Dios ay wala sa kanila."
            },
            {
              "chapter": 21,
              "verse": 10,
              "name": "Job 21:10",
              "text": "Ang kanilang baka ay naglilihi, at hindi nababaog; ang kanilang baka ay nanganganak, at hindi napapahamak ang kaniyang guya."
            },
            {
              "chapter": 21,
              "verse": 11,
              "name": "Job 21:11",
              "text": "Kaniyang inilabas ang kanilang mga bata na gaya ng kawan, at ang kanilang mga anak ay nangagsasayawan,"
            },
            {
              "chapter": 21,
              "verse": 12,
              "name": "Job 21:12",
              "text": "Sila'y nangagaawitan na katugma ng pandereta at alpa, at nangagkakatuwa sa tunog ng plauta."
            },
            {
              "chapter": 21,
              "verse": 13,
              "name": "Job 21:13",
              "text": "Kanilang ginugugol ang kanilang mga kaarawan sa kaginhawahan, at sa isang sandali ay nagsisilusong sila sa Sheol."
            },
            {
              "chapter": 21,
              "verse": 14,
              "name": "Job 21:14",
              "text": "At sinasabi nila sa Dios: Lumayo ka sa amin; sapagka't hindi namin ninanasa ang pagkaalam ng inyong mga lakad."
            },
            {
              "chapter": 21,
              "verse": 15,
              "name": "Job 21:15",
              "text": "Ano ang Makapangyarihan sa lahat na siya'y paglilingkuran namin? At anong pakinabang magkakaroon kami, kung kami ay magsidalangin sa kaniya?"
            },
            {
              "chapter": 21,
              "verse": 16,
              "name": "Job 21:16",
              "text": "Narito, ang kanilang kaginhawahan ay wala sa kanilang kamay: ang payo ng masama ay malayo sa akin."
            },
            {
              "chapter": 21,
              "verse": 17,
              "name": "Job 21:17",
              "text": "Gaano kadalas pinapatay ang ilawan ng masama? Na ang kanilang kapahamakan ay dumarating ba sa kanila? Na nagbabahagi ba ang Dios ng mga kapanglawan sa kaniyang galit?"
            },
            {
              "chapter": 21,
              "verse": 18,
              "name": "Job 21:18",
              "text": "Na sila'y gaya ng dayami sa harap ng hangin, at gaya ng ipa na tinatangay ng bagyo?"
            },
            {
              "chapter": 21,
              "verse": 19,
              "name": "Job 21:19",
              "text": "Inyong sinasabi, Inilalapat ng Dios ang kaniyang parusa sa kaniyang mga anak. Gantihin sa kaniyang sarili upang maalaman niya."
            },
            {
              "chapter": 21,
              "verse": 20,
              "name": "Job 21:20",
              "text": "Makita ng kaniyang mga mata ang kaniyang pagkagiba, at uminom siya ng poot ng Makapangyarihan sa lahat."
            },
            {
              "chapter": 21,
              "verse": 21,
              "name": "Job 21:21",
              "text": "Sapagka't anong kasayahan magkakaroon siya sa kaniyang bahay pagkamatay niya, pagka ang bilang ng kaniyang mga buwan ay nahiwalay sa gitna?"
            },
            {
              "chapter": 21,
              "verse": 22,
              "name": "Job 21:22",
              "text": "May makapagtuturo ba ng kaalaman sa Dios? Dangang kaniyang hinahatulan yaong nangasa mataas."
            },
            {
              "chapter": 21,
              "verse": 23,
              "name": "Job 21:23",
              "text": "Isa'y namamatay sa kaniyang lubos na kalakasan, palibhasa't walang bahala at tahimik:"
            },
            {
              "chapter": 21,
              "verse": 24,
              "name": "Job 21:24",
              "text": "Ang kaniyang mga suso ay puno ng gatas, at ang utak ng kaniyang mga buto ay halumigmig."
            },
            {
              "chapter": 21,
              "verse": 25,
              "name": "Job 21:25",
              "text": "At ang iba'y namamatay sa paghihirap ng kaluluwa, at kailan man ay hindi nakakalasa ng mabuti."
            },
            {
              "chapter": 21,
              "verse": 26,
              "name": "Job 21:26",
              "text": "Sila'y nahihigang magkakasama sa alabok, at tinatakpan sila ng uod."
            },
            {
              "chapter": 21,
              "verse": 27,
              "name": "Job 21:27",
              "text": "Narito, aking nalalaman ang inyong pagiisip, at ang mga maling haka ng inyong inaakala laban sa akin."
            },
            {
              "chapter": 21,
              "verse": 28,
              "name": "Job 21:28",
              "text": "Sapagka't inyong sinasabi, Saan naroon ang bahay ng prinsipe? At saan naroon ang tolda na tinatahanan ng masama?"
            },
            {
              "chapter": 21,
              "verse": 29,
              "name": "Job 21:29",
              "text": "Hindi ba ninyo itinanong sa kanilang nangagdadaan? At hindi ba ninyo nalalaman ang kanilang mga pinagkakakilanlan?"
            },
            {
              "chapter": 21,
              "verse": 30,
              "name": "Job 21:30",
              "text": "Na ang masamang tao ay natataan sa kaarawan ng kasakunaan? Na sila'y pinapatnubayan sa kaarawan ng kapootan?"
            },
            {
              "chapter": 21,
              "verse": 31,
              "name": "Job 21:31",
              "text": "Sinong magpapahayag ng kaniyang lakad sa kaniyang mukha? At sinong magbabayad sa kaniya ng kaniyang ginawa?"
            },
            {
              "chapter": 21,
              "verse": 32,
              "name": "Job 21:32",
              "text": "Gayon ma'y dadalhin siya sa libingan, at magbabantay ang mga tao sa libingan."
            },
            {
              "chapter": 21,
              "verse": 33,
              "name": "Job 21:33",
              "text": "Ang mga bugal ng libis ay mamabutihin niya, at lahat ng tao ay magsisisunod sa kaniya, gaya ng nauna sa kaniya na walang bilang."
            },
            {
              "chapter": 21,
              "verse": 34,
              "name": "Job 21:34",
              "text": "Paano ngang inyong aaliwin ako ng walang kabuluhan, dangang sa inyong mga sagot ang naiiwan lamang ay kabulaanan?"
            }
          ]
        },
        {
          "chapter": 22,
          "name": "Job 22",
          "verses": [
            {
              "chapter": 22,
              "verse": 1,
              "name": "Job 22:1",
              "text": "Nang magkagayo'y sumagot si Eliphaz na Temanita, at nagsabi,"
            },
            {
              "chapter": 22,
              "verse": 2,
              "name": "Job 22:2",
              "text": "Mapapakinabangan ba ang tao ng Dios? Tunay na siyang pantas ay nakikinabang sa kaniyang sarili."
            },
            {
              "chapter": 22,
              "verse": 3,
              "name": "Job 22:3",
              "text": "May kasayahan ba sa Makapangyarihan sa lahat na ikaw ay matuwid? O may pakinabang ba sa kaniya na iyong pinasasakdal ang iyong mga lakad?"
            },
            {
              "chapter": 22,
              "verse": 4,
              "name": "Job 22:4",
              "text": "Dahil ba sa iyong takot sa kaniya na kaniyang sinasaway ka, na siya'y pumasok sa iyo sa kahatulan?"
            },
            {
              "chapter": 22,
              "verse": 5,
              "name": "Job 22:5",
              "text": "Hindi ba malaki ang iyong kasamaan? Ni wala mang anomang wakas sa iyong mga kasamaan."
            },
            {
              "chapter": 22,
              "verse": 6,
              "name": "Job 22:6",
              "text": "Sapagka't ikaw ay kumuha ng sangla ng iyong kapatid sa wala, at iyong hinubdan ng kanilang suot ang hubad."
            },
            {
              "chapter": 22,
              "verse": 7,
              "name": "Job 22:7",
              "text": "Ikaw ay hindi nagbigay ng tubig sa pagod upang uminom, at ikaw ay nagkait ng tinapay sa gutom."
            },
            {
              "chapter": 22,
              "verse": 8,
              "name": "Job 22:8",
              "text": "Nguni't tungkol sa makapangyarihang tao, siya'y nagtatangkilik ng lupa; at ang marangal na tao, ay tumatahan doon."
            },
            {
              "chapter": 22,
              "verse": 9,
              "name": "Job 22:9",
              "text": "Iyong pinayaong walang dala ang mga babaing bao, at ang mga kamay ng ulila ay nangabali."
            },
            {
              "chapter": 22,
              "verse": 10,
              "name": "Job 22:10",
              "text": "Kaya't ang mga silo ay nangasa palibot mo, at biglang takot ay bumabagabag sa iyo,"
            },
            {
              "chapter": 22,
              "verse": 11,
              "name": "Job 22:11",
              "text": "O kadiliman, upang huwag kang makakita. At kasaganaan ng tubig ay tumatabon sa iyo."
            },
            {
              "chapter": 22,
              "verse": 12,
              "name": "Job 22:12",
              "text": "Hindi ba ang Dios ay nasa kaitaasan ng langit? At, narito, ang kataasan ng mga bituin, pagkataastaas nila!"
            },
            {
              "chapter": 22,
              "verse": 13,
              "name": "Job 22:13",
              "text": "At iyong sinasabi, Anong nalalaman ng Dios? Makahahatol ba siya sa salisalimuot na kadiliman?"
            },
            {
              "chapter": 22,
              "verse": 14,
              "name": "Job 22:14",
              "text": "Masinsing alapaap ang tumatakip sa kaniya, na siya'y hindi nakakakita; at siya'y lumalakad sa balantok ng langit."
            },
            {
              "chapter": 22,
              "verse": 15,
              "name": "Job 22:15",
              "text": "Iyo bang pagpapatuluyan ang dating daan, na nilakaran ng mga masamang tao?"
            },
            {
              "chapter": 22,
              "verse": 16,
              "name": "Job 22:16",
              "text": "Na siyang mga naalis bago dumating ang kanilang kapanahunan. Na ang patibayan ay nahuhong parang agos:"
            },
            {
              "chapter": 22,
              "verse": 17,
              "name": "Job 22:17",
              "text": "Na nagsabi sa Dios: Lumayo ka sa amin; at, anong magagawa sa amin ng Makapangyarihan sa lahat?"
            },
            {
              "chapter": 22,
              "verse": 18,
              "name": "Job 22:18",
              "text": "Gayon ma'y pinuno niya ang kanilang mga bahay ng mga mabuting bagay; nguni't ang payo ng masama ay malayo sa akin."
            },
            {
              "chapter": 22,
              "verse": 19,
              "name": "Job 22:19",
              "text": "Nakikita ng mga matuwid at nangatutuwa; at tinatawanang mainam ng walang sala:"
            },
            {
              "chapter": 22,
              "verse": 20,
              "name": "Job 22:20",
              "text": "Na nagsasabi, Walang pagsalang silang nagsisibangon laban sa atin ay nahiwalay, at ang nalabi sa kanila ay sinupok ng apoy."
            },
            {
              "chapter": 22,
              "verse": 21,
              "name": "Job 22:21",
              "text": "Makipagkilala ka sa kaniya, at ikaw ay mapayapa: anopa't ang mabuti ay darating sa iyo."
            },
            {
              "chapter": 22,
              "verse": 22,
              "name": "Job 22:22",
              "text": "Iyong tanggapin, isinasamo ko sa iyo, ang kautusan mula sa kaniyang bibig, at ilagak mo ang kaniyang mga salita sa iyong puso."
            },
            {
              "chapter": 22,
              "verse": 23,
              "name": "Job 22:23",
              "text": "Kung ikaw ay bumalik sa Makapangyarihan sa lahat, ay matatayo ka; kung iyong ilayo ang kalikuan sa iyong mga tolda."
            },
            {
              "chapter": 22,
              "verse": 24,
              "name": "Job 22:24",
              "text": "At ilagay mo ang iyong kayamanan sa alabok, at ang ginto ng Ophir sa gitna ng mga bato ng mga batis:"
            },
            {
              "chapter": 22,
              "verse": 25,
              "name": "Job 22:25",
              "text": "At ang Makapangyarihan sa lahat ay magiging iyong kayamanan, at mahalagang pilak sa iyo."
            },
            {
              "chapter": 22,
              "verse": 26,
              "name": "Job 22:26",
              "text": "Sapagka't ikaw ay magagalak nga ng iyong sarili sa Makapangyarihan sa lahat, at iyong itataas ang iyong mukha sa Dios."
            },
            {
              "chapter": 22,
              "verse": 27,
              "name": "Job 22:27",
              "text": "Ikaw ay dadalangin sa kaniya, at kaniyang didinggin ka: at iyong babayaran ang iyong mga panata."
            },
            {
              "chapter": 22,
              "verse": 28,
              "name": "Job 22:28",
              "text": "Ikaw nama'y magpapasiya ng isang bagay, at ito'y matatatag sa iyo; at liwanag ay sisilang sa iyong mga daan."
            },
            {
              "chapter": 22,
              "verse": 29,
              "name": "Job 22:29",
              "text": "Pagka inilulugmok ka nila, ay iyong sasabihin: Magpakataas; at ililigtas niya ang mapagpakumbabang tao."
            },
            {
              "chapter": 22,
              "verse": 30,
              "name": "Job 22:30",
              "text": "Kaniyang ililigtas, pati ng hindi banal: Oo, siya'y maliligtas sa kalinisan ng iyong mga kamay."
            }
          ]
        },
        {
          "chapter": 23,
          "name": "Job 23",
          "verses": [
            {
              "chapter": 23,
              "verse": 1,
              "name": "Job 23:1",
              "text": "Nang magkagayo'y sumagot si Job, at nagsabi,"
            },
            {
              "chapter": 23,
              "verse": 2,
              "name": "Job 23:2",
              "text": "Magpahanggang ngayo'y mapanghimagsik ang aking daing: ang bugbog sa akin ay lalong mabigat kaysa aking hibik."
            },
            {
              "chapter": 23,
              "verse": 3,
              "name": "Job 23:3",
              "text": "Oh mano nawang maalaman ko kung saan ko masusumpungan siya, upang ako'y dumating hanggang sa kaniyang likmuan!"
            },
            {
              "chapter": 23,
              "verse": 4,
              "name": "Job 23:4",
              "text": "Aking aayusin ang aking usap sa harap niya, at pupunuin ko ang aking bibig ng mga pangangatuwiran."
            },
            {
              "chapter": 23,
              "verse": 5,
              "name": "Job 23:5",
              "text": "Aking malalaman ang mga salita na kaniyang isasagot sa akin, at matatalastas ko kung ano ang kaniyang sasabihin sa akin."
            },
            {
              "chapter": 23,
              "verse": 6,
              "name": "Job 23:6",
              "text": "Makikipagtalo ba siya sa akin sa kalakhan ng kaniyang kapangyarihan? Hindi; kundi pakikinggan niya ako."
            },
            {
              "chapter": 23,
              "verse": 7,
              "name": "Job 23:7",
              "text": "Doo'y makapangangatuwiran sa kaniya ang matuwid; sa gayo'y maliligtas ako magpakailan man sa aking hukom."
            },
            {
              "chapter": 23,
              "verse": 8,
              "name": "Job 23:8",
              "text": "Narito, ako'y nagpapatuloy, nguni't wala siya; at sa dakong likuran, nguni't hindi ko siya mamataan:"
            },
            {
              "chapter": 23,
              "verse": 9,
              "name": "Job 23:9",
              "text": "Sa kaliwa pagka siya'y gumagawa, nguni't hindi ko mamasdan siya: siya'y nagkukubli sa kanan, na hindi ko makita siya."
            },
            {
              "chapter": 23,
              "verse": 10,
              "name": "Job 23:10",
              "text": "Nguni't nalalaman niya ang daang aking nilalakaran; pagka kaniyang nasubok ako ay lalabas akong parang ginto."
            },
            {
              "chapter": 23,
              "verse": 11,
              "name": "Job 23:11",
              "text": "Ang aking paa ay sumunod na lubos sa kaniyang mga hakbang. Ang kaniyang daan ay aking iningatan, at hindi ako lumiko."
            },
            {
              "chapter": 23,
              "verse": 12,
              "name": "Job 23:12",
              "text": "Ako'y hindi humiwalay sa utos ng kaniyang mga labi; aking pinagyaman ang mga salita ng kaniyang bibig ng higit kay sa aking kailangang pagkain."
            },
            {
              "chapter": 23,
              "verse": 13,
              "name": "Job 23:13",
              "text": "Nguni't siya'y sa isang akala, at sinong makapagpapabalik sa kaniya? At kung ano ang ninanasa ng kaniyang kaluluwa siya nga niyang ginagawa."
            },
            {
              "chapter": 23,
              "verse": 14,
              "name": "Job 23:14",
              "text": "Sapagka't kaniyang isinasagawa ang itinakda sa akin: at maraming gayong mga bagay ang nasa kaniya."
            },
            {
              "chapter": 23,
              "verse": 15,
              "name": "Job 23:15",
              "text": "Kaya't ako'y nababagabag sa kaniyang harapan; pagka aking binubulay, ay natatakot ako sa kaniya."
            },
            {
              "chapter": 23,
              "verse": 16,
              "name": "Job 23:16",
              "text": "Dahil sa pinapanglupaypay ng Dios ang aking puso, at binagabag ako ng Makapangyarihan sa lahat:"
            },
            {
              "chapter": 23,
              "verse": 17,
              "name": "Job 23:17",
              "text": "Sapagka't hindi ako inihiwalay sa harap ng kadiliman, ni tinakpan man niya ang salimuot na kadiliman sa aking mukha."
            }
          ]
        },
        {
          "chapter": 24,
          "name": "Job 24",
          "verses": [
            {
              "chapter": 24,
              "verse": 1,
              "name": "Job 24:1",
              "text": "Bakit ang mga kapanahunan ay hindi itinakda ng Makapangyarihan sa lahat? At bakit hindi nangakakakita ng kaniyang mga araw ang nangakakakilala sa kaniya?"
            },
            {
              "chapter": 24,
              "verse": 2,
              "name": "Job 24:2",
              "text": "May nagsisipagbago ng lindero; kanilang dinadalang may karahasan ang mga kawan, at pinasasabsab."
            },
            {
              "chapter": 24,
              "verse": 3,
              "name": "Job 24:3",
              "text": "Kanilang itinataboy ang asno ng ulila, kanilang kinukuha ang baka ng babaing bao na pinakasangla."
            },
            {
              "chapter": 24,
              "verse": 4,
              "name": "Job 24:4",
              "text": "Kanilang inililigaw sa daan ang mapagkailangan: ang mga dukha sa lupa ay nagsisikubling magkakasama."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "Job 24:5",
              "text": "Narito, gaya ng mga mabangis na asno sa ilang, sila'y nagsisilabas sa kanilang gawa, na nagsisihanap na masikap ng pagkain; ang ilang ay siyang nagbibigay sa kanila ng pagkaing ukol sa kanilang mga anak."
            },
            {
              "chapter": 24,
              "verse": 6,
              "name": "Job 24:6",
              "text": "Kanilang pinitas sa bukid ang kanilang pagkain; at kanilang pinamumulutan ang ubasan ng masama."
            },
            {
              "chapter": 24,
              "verse": 7,
              "name": "Job 24:7",
              "text": "Sila'y hubad na nangahihiga buong gabi na walang suot. At walang kumot sa ginaw."
            },
            {
              "chapter": 24,
              "verse": 8,
              "name": "Job 24:8",
              "text": "Sila'y basa ng ulan sa mga bundok, at niyayakap ang bato sa pagkakailangan ng kulungan."
            },
            {
              "chapter": 24,
              "verse": 9,
              "name": "Job 24:9",
              "text": "May nagsisiagaw ng ulila mula sa suso, at nagsisikuha ng sangla ng dukha:"
            },
            {
              "chapter": 24,
              "verse": 10,
              "name": "Job 24:10",
              "text": "Na anopa't sila'y yumayaong hubad na walang damit, at palibhasa'y gutom ay kanilang dinadala ang mga bigkis;"
            },
            {
              "chapter": 24,
              "verse": 11,
              "name": "Job 24:11",
              "text": "Sila'y nagsisigawa ng langis sa loob ng olibohan ng mga taong ito; sila'y nagpipisa sa kanilang pisaan ng ubas, at nagtitiis ng uhaw."
            },
            {
              "chapter": 24,
              "verse": 12,
              "name": "Job 24:12",
              "text": "Mula sa makapal na bayan ay nagsisidaing ang mga tao, at ang kaluluwa ng may sugat ay humihiyaw; gayon ma'y hindi inaaring mangmang ng Dios."
            },
            {
              "chapter": 24,
              "verse": 13,
              "name": "Job 24:13",
              "text": "Ito'y sa mga nangaghihimagsik laban sa liwanag; Hindi nila nalalaman ang mga daan niyaon, ni tumatahan man sa mga landas niyaon."
            },
            {
              "chapter": 24,
              "verse": 14,
              "name": "Job 24:14",
              "text": "Ang mamamatay tao ay bumabangon pagliliwanag, pinapatay niya ang dukha at mapagkailangan; at sa gabi ay gaya siya ng magnanakaw."
            },
            {
              "chapter": 24,
              "verse": 15,
              "name": "Job 24:15",
              "text": "Ang mata naman ng mapangalunya ay naghihintay ng pagtatakip-silim, na sinasabi, Walang matang makakakita sa akin: at nagiiba ng kaniyang mukha."
            },
            {
              "chapter": 24,
              "verse": 16,
              "name": "Job 24:16",
              "text": "Sa kadiliman ay nagsisihukay sila sa mga bahay: sila'y nagkukulong sa sarili kung araw; hindi nila nalalaman ang liwanag,"
            },
            {
              "chapter": 24,
              "verse": 17,
              "name": "Job 24:17",
              "text": "Sapagka't ang umaga sa kanilang lahat ay parang salimuot na kadiliman, sapagka't kanilang nalalaman ang mga kakilabutan ng salimot na kadiliman."
            },
            {
              "chapter": 24,
              "verse": 18,
              "name": "Job 24:18",
              "text": "Siya'y matulin sa ibabaw ng tubig; ang kanilang bahagi ay sinumpa sa lupa: siya'y hindi babalik sa daan ng mga ubasan."
            },
            {
              "chapter": 24,
              "verse": 19,
              "name": "Job 24:19",
              "text": "Katuyuan at kainitan ay tumutunaw ng mga niebeng tubig: gaya ng Sheol ng mga nagkakasala."
            },
            {
              "chapter": 24,
              "verse": 20,
              "name": "Job 24:20",
              "text": "Kalilimutan siya ng bahay-bata: siya'y kakaning maigi ng uod; siya'y hindi na maaalaala pa: at ang kalikuan ay babaliing parang punong kahoy."
            },
            {
              "chapter": 24,
              "verse": 21,
              "name": "Job 24:21",
              "text": "Kaniyang sinasakmal ang baog na hindi nanganganak; at hindi gumagawa ng mabuti sa babaing bao."
            },
            {
              "chapter": 24,
              "verse": 22,
              "name": "Job 24:22",
              "text": "Inaagawan naman ng Dios ang may kaya sa pamamagitan ng kaniyang kapangyarihan: siya'y bumabangon na walang katiwasayan sa buhay."
            },
            {
              "chapter": 24,
              "verse": 23,
              "name": "Job 24:23",
              "text": "Pinagkakalooban sila ng Dios na malagay sa katiwasayan, at sila'y nagpapahinga roon; at ang kaniyang mga mata ay nasa kanilang mga lakad."
            },
            {
              "chapter": 24,
              "verse": 24,
              "name": "Job 24:24",
              "text": "Sila'y nangataas, gayon ma'y isang sandali pa, at sila'y wala na. Oo, sila'y nangababa, sila'y nangaalis sa daan na gaya ng lahat ng mga iba, at nangaputol na gaya ng mga uhay."
            },
            {
              "chapter": 24,
              "verse": 25,
              "name": "Job 24:25",
              "text": "At kung hindi gayon ngayon, sinong magpapatotoo na ako'y sinungaling, at magwawala ng kabuluhan ng aking pananalita?"
            }
          ]
        },
        {
          "chapter": 25,
          "name": "Job 25",
          "verses": [
            {
              "chapter": 25,
              "verse": 1,
              "name": "Job 25:1",
              "text": "Nang magkagayo'y sumagot si Bildad na Suhita, at nagsabi,"
            },
            {
              "chapter": 25,
              "verse": 2,
              "name": "Job 25:2",
              "text": "Kapangyarihan at takot ay sumasa kaniya; siya'y gumagawa ng kapayapaan sa kaniyang mga mataas na dako."
            },
            {
              "chapter": 25,
              "verse": 3,
              "name": "Job 25:3",
              "text": "May anomang bilang ba sa kaniyang mga hukbo? At doon sa hindi sinisikatan ng kaniyang liwanag?"
            },
            {
              "chapter": 25,
              "verse": 4,
              "name": "Job 25:4",
              "text": "Paano ngang makapagiging ganap ang tao sa Dios? O paanong magiging malinis siya na ipinanganak ng isang babae."
            },
            {
              "chapter": 25,
              "verse": 5,
              "name": "Job 25:5",
              "text": "Narito, pati ng buwan ay walang liwanag, at ang mga bituin ay hindi dalisay sa kaniyang paningin:"
            },
            {
              "chapter": 25,
              "verse": 6,
              "name": "Job 25:6",
              "text": "Gaano pa nga kaliit ang tao, na isang uod! At ang anak ng tao, na isang uod!"
            }
          ]
        },
        {
          "chapter": 26,
          "name": "Job 26",
          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Job 26:1",
              "text": "Nang magkagayo'y sumagot si Job, at nagsabi,"
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Job 26:2",
              "text": "Paano mong tinulungan siya na walang kapangyarihan! Paano mong iniligtas ang kamay na walang lakas!"
            },
            {
              "chapter": 26,
              "verse": 3,
              "name": "Job 26:3",
              "text": "Paano mong pinayuhan siya na walang karunungan, at saganang ipinahayag mo ang mabuting kaalaman!"
            },
            {
              "chapter": 26,
              "verse": 4,
              "name": "Job 26:4",
              "text": "Kanino mo binigkas ang mga salita? At kanino ang diwa na lumabas sa iyo?"
            },
            {
              "chapter": 26,
              "verse": 5,
              "name": "Job 26:5",
              "text": "Ang mga patay ay nanginginig sa ilalim ng tubig, at ang mga nananahan doon."
            },
            {
              "chapter": 26,
              "verse": 6,
              "name": "Job 26:6",
              "text": "Ang Sheol ay hubad sa harap ng Dios, at ang Abaddon ay walang takip."
            },
            {
              "chapter": 26,
              "verse": 7,
              "name": "Job 26:7",
              "text": "Kaniyang iniuunat ang hilagaan sa pagitang walang laman, at ibinibitin ang lupa sa wala."
            },
            {
              "chapter": 26,
              "verse": 8,
              "name": "Job 26:8",
              "text": "Kaniyang itinatali ang tubig sa kaniyang masinsing alapaap; at ang alapaap ay hindi nahahapak sa ilalim nila."
            },
            {
              "chapter": 26,
              "verse": 9,
              "name": "Job 26:9",
              "text": "Kaniyang tinatakpan ang ibabaw ng kaniyang luklukan, at iniladlad ang kaniyang mga alapaap sa ibabaw niyaon."
            },
            {
              "chapter": 26,
              "verse": 10,
              "name": "Job 26:10",
              "text": "Siya'y gumuguhit ng isang hangganan sa ibabaw ng tubig, hanggang sa pinagsasalikupan ng liwanag at kadiliman."
            },
            {
              "chapter": 26,
              "verse": 11,
              "name": "Job 26:11",
              "text": "Ang mga haligi ng langit ay nagsisipanginig. At nangatitigilan sa kaniyang saway."
            },
            {
              "chapter": 26,
              "verse": 12,
              "name": "Job 26:12",
              "text": "Kaniyang pinapag-iinalon ang dagat ng kaniyang kapangyarihan, at sa kaniyang kaalaman ay sinasaktan niya ang Rahab."
            },
            {
              "chapter": 26,
              "verse": 13,
              "name": "Job 26:13",
              "text": "Sa pamamagitan ng kaniyang Espiritu ay ginayakan niya ang langit; sinaksak ng kaniyang mga kamay ang maliksing ahas."
            },
            {
              "chapter": 26,
              "verse": 14,
              "name": "Job 26:14",
              "text": "Narito, ang mga ito ang mga gilid lamang ng kaniyang mga daan: at pagkarahan ng bulong na ating naririnig sa kaniya! Nguni't sinong makakaunawa ng kulog ng kaniyang kapangyarihan?"
            }
          ]
        },
        {
          "chapter": 27,
          "name": "Job 27",
          "verses": [
            {
              "chapter": 27,
              "verse": 1,
              "name": "Job 27:1",
              "text": "At muling sinambit ni Job ang kaniyang talinhaga, at nagsabi,"
            },
            {
              "chapter": 27,
              "verse": 2,
              "name": "Job 27:2",
              "text": "Buhay ang Dios, na siyang nagalis ng aking katuwiran, at ang Makapangyarihan sa lahat na siyang nagpapanglaw ng aking kaluluwa;"
            },
            {
              "chapter": 27,
              "verse": 3,
              "name": "Job 27:3",
              "text": "(Sapagka't ang aking buhay ay buo pa sa akin, at ang espiritu ng Dios ay nasa mga butas ng aking ilong);"
            },
            {
              "chapter": 27,
              "verse": 4,
              "name": "Job 27:4",
              "text": "Tunay na ang aking mga labi ay hindi magsasalita ng kalikuan, ni ang aking dila man ay magsasaysay ng karayaan."
            },
            {
              "chapter": 27,
              "verse": 5,
              "name": "Job 27:5",
              "text": "Malayo nawa sa aking kayo'y ariin kong ganap: Hanggang sa ako'y mamatay ay hindi ko aalisin sa akin ang aking pagtatapat."
            },
            {
              "chapter": 27,
              "verse": 6,
              "name": "Job 27:6",
              "text": "Ang aking katuwiran ay aking pinanghahawakan at hindi ko bibitiwan: hindi ako aalipustain ng aking puso habang ako'y buhay."
            },
            {
              "chapter": 27,
              "verse": 7,
              "name": "Job 27:7",
              "text": "Ang aking kaaway ay maging gaya nawa ng masama, at ang bumangon laban sa akin ay maging gaya nawa ng liko."
            },
            {
              "chapter": 27,
              "verse": 8,
              "name": "Job 27:8",
              "text": "Sapagka't ano ang pagasa ng di banal, bagaman siya'y makikinabang sa kaniya, pagka kinuha ng Dios ang kaniyang kaluluwa?"
            },
            {
              "chapter": 27,
              "verse": 9,
              "name": "Job 27:9",
              "text": "Didinggin ba ng Dios ang kaniyang iyak, pagka ang kabagabagan ay dumating sa kaniya?"
            },
            {
              "chapter": 27,
              "verse": 10,
              "name": "Job 27:10",
              "text": "Makapagsasaya ba siya sa Makapangyarihan sa lahat, at tatawag sa Dios sa lahat ng mga panahon?"
            },
            {
              "chapter": 27,
              "verse": 11,
              "name": "Job 27:11",
              "text": "Aking tuturuan kayo ng tungkol sa kamay ng Dios; ang nasa Makapangyarihan sa lahat ay hindi ko ililihim."
            },
            {
              "chapter": 27,
              "verse": 12,
              "name": "Job 27:12",
              "text": "Narito, kayong lahat ay nangakakita; bakit nga kayo ay lubos na nawalan ng kabuluhan?"
            },
            {
              "chapter": 27,
              "verse": 13,
              "name": "Job 27:13",
              "text": "Ito ang bahagi ng masamang tao sa Dios, at ang mana ng mga mamimighati, na kanilang tinatanggap sa Makapangyarihan sa lahat."
            },
            {
              "chapter": 27,
              "verse": 14,
              "name": "Job 27:14",
              "text": "Kung ang kaniyang mga anak ay dumami, ay para sa tabak, at ang kaniyang lahi ay hindi mabubusog ng tinapay."
            },
            {
              "chapter": 27,
              "verse": 15,
              "name": "Job 27:15",
              "text": "Yaong nangaiwan sa kaniya ay mangalilibing sa kamatayan, at ang kaniyang mga bao ay hindi magsisipanaghoy."
            },
            {
              "chapter": 27,
              "verse": 16,
              "name": "Job 27:16",
              "text": "Bagaman siya'y magbunton ng pilak na parang alabok, at maghahanda ng bihisan na parang putik;"
            },
            {
              "chapter": 27,
              "verse": 17,
              "name": "Job 27:17",
              "text": "Maihahanda niya, nguni't ang ganap ang magsusuot niyaon. At babahagihin ng walang sala ang pilak."
            },
            {
              "chapter": 27,
              "verse": 18,
              "name": "Job 27:18",
              "text": "Siya'y nagtatayo ng kaniyang bahay na gaya ng tanga, at gaya ng isang bantayan na ginagawa ng bantay."
            },
            {
              "chapter": 27,
              "verse": 19,
              "name": "Job 27:19",
              "text": "Siya'y nahihigang mayaman, nguni't hindi siya pupulutin; kaniyang ididilat ang kaniyang mga mata, nguni't wala na siya."
            },
            {
              "chapter": 27,
              "verse": 20,
              "name": "Job 27:20",
              "text": "Mga kakilabutan ang tumatabon sa kaniya na gaya ng tubig; bagyo ang umaagaw sa kaniya sa kinagabihan,"
            },
            {
              "chapter": 27,
              "verse": 21,
              "name": "Job 27:21",
              "text": "Tinangay siya ng hanging silanganan, at siya'y nananaw; at pinapalis siya sa kaniyang kinaroroonang dako."
            },
            {
              "chapter": 27,
              "verse": 22,
              "name": "Job 27:22",
              "text": "Sapagka't hahalibasin siya ng Dios, at hindi magpapatawad; siya'y magpupumilit na tumakas sa kaniyang kamay."
            },
            {
              "chapter": 27,
              "verse": 23,
              "name": "Job 27:23",
              "text": "Ipapakpak ng mga tao ang kanilang mga kamay sa kaniya. At hihiyawan siya mula sa kaniyang kinaroroonang dako."
            }
          ]
        },
        {
          "chapter": 28,
          "name": "Job 28",
          "verses": [
            {
              "chapter": 28,
              "verse": 1,
              "name": "Job 28:1",
              "text": "Tunay na may mina na mayroong pilak, at dako na ukol sa ginto na kanilang pinagdadalisayan."
            },
            {
              "chapter": 28,
              "verse": 2,
              "name": "Job 28:2",
              "text": "Bakal ay hinuhukay sa lupa, at tanso ay binububo mula sa bato."
            },
            {
              "chapter": 28,
              "verse": 3,
              "name": "Job 28:3",
              "text": "Ang tao'y naglalagay ng wakas sa kadiliman, at sumisiyasat hanggang sa kalayulayuang hangganan ng mga bato ng kadiliman at salimuot na kadiliman."
            },
            {
              "chapter": 28,
              "verse": 4,
              "name": "Job 28:4",
              "text": "Siya'y humuhukay ng malayo sa tinatahanan ng mga tao: nililimot ng paa na dumadaan nagbibitin doong malayo sa mga tao, sila'y umuugoy na paroo't parito."
            },
            {
              "chapter": 28,
              "verse": 5,
              "name": "Job 28:5",
              "text": "Tungkol sa lupa, mula rito'y nanggagaling ang tinapay: at sa ilalim ay wari tinutuklap ng apoy."
            },
            {
              "chapter": 28,
              "verse": 6,
              "name": "Job 28:6",
              "text": "Ang mga bato nito'y kinaroroonan ng mga zafiro. At ito'y may alabok na ginto."
            },
            {
              "chapter": 28,
              "verse": 7,
              "name": "Job 28:7",
              "text": "Yaong landas na walang ibong mangdadagit ay nakakaalam. Ni nakita man ng mata ng falkon:"
            },
            {
              "chapter": 28,
              "verse": 8,
              "name": "Job 28:8",
              "text": "Hindi natungtungan ng mga palalong hayop, ni naraanan man ng mabangis na leon,"
            },
            {
              "chapter": 28,
              "verse": 9,
              "name": "Job 28:9",
              "text": "Kaniyang inilalabas ang kaniyang kamay sa batong pingkian; binabaligtad ng mga ugat ang mga bundok."
            },
            {
              "chapter": 28,
              "verse": 10,
              "name": "Job 28:10",
              "text": "Siya'y nagbabangbang sa gitna ng mga bato; at ang kaniyang mata ay nakakakita ng bawa't mahalagang bagay."
            },
            {
              "chapter": 28,
              "verse": 11,
              "name": "Job 28:11",
              "text": "Kaniyang tinatalian ang mga lagaslas upang huwag umagos; at ang bagay na nakukubli ay inililitaw niya sa liwanag."
            },
            {
              "chapter": 28,
              "verse": 12,
              "name": "Job 28:12",
              "text": "Nguni't saan masusumpungan ang karunungan? At saan naroon ang dako ng pagkaunawa?"
            },
            {
              "chapter": 28,
              "verse": 13,
              "name": "Job 28:13",
              "text": "Hindi nalalaman ng tao ang halaga niyaon; ni nasusumpungan man sa lupain ng may buhay."
            },
            {
              "chapter": 28,
              "verse": 14,
              "name": "Job 28:14",
              "text": "Sinasabi ng kalaliman. Wala sa akin: at sinasabi ng dagat: Hindi sumasaakin."
            },
            {
              "chapter": 28,
              "verse": 15,
              "name": "Job 28:15",
              "text": "Hindi mabibili ng ginto, ni matitimbangan man ng pilak ang halaga niyaon."
            },
            {
              "chapter": 28,
              "verse": 16,
              "name": "Job 28:16",
              "text": "Hindi mahahalagahan ng ginto sa Ophir, ng mahalagang onix, o ng zafiro."
            },
            {
              "chapter": 28,
              "verse": 17,
              "name": "Job 28:17",
              "text": "Ginto at salamin ay hindi maihahalintulad doon: ni maipagpapalit man sa mga hiyas na dalisay na ginto."
            },
            {
              "chapter": 28,
              "verse": 18,
              "name": "Job 28:18",
              "text": "Hindi mabibilang ang coral o ang cristal; Oo, ang halaga ng karunungan ay higit sa mga rubi."
            },
            {
              "chapter": 28,
              "verse": 19,
              "name": "Job 28:19",
              "text": "Ang topacio sa Etiopia ay hindi maipapantay doon, ni mahahalagahan man ng dalisay na ginto."
            },
            {
              "chapter": 28,
              "verse": 20,
              "name": "Job 28:20",
              "text": "Saan nanggagaling nga ang karunungan? At saan naroon ang dako ng pagkaunawa?"
            },
            {
              "chapter": 28,
              "verse": 21,
              "name": "Job 28:21",
              "text": "Palibhasa't nakukubli sa mga mata ng lahat na may buhay, at natatago sa mga ibon sa himpapawid."
            },
            {
              "chapter": 28,
              "verse": 22,
              "name": "Job 28:22",
              "text": "Ang kapahamakan at ang kamatayan ay nagsasabi, narinig namin ng aming mga pakinig ang bulungbulungan niyaon."
            },
            {
              "chapter": 28,
              "verse": 23,
              "name": "Job 28:23",
              "text": "Nauunawa ng Dios ang daan niyaon, at nalalaman niya ang dako niyaon."
            },
            {
              "chapter": 28,
              "verse": 24,
              "name": "Job 28:24",
              "text": "Sapagka't tumitingin siya hanggang sa mga wakas ng lupa, at nakikita ang silong ng buong langit;"
            },
            {
              "chapter": 28,
              "verse": 25,
              "name": "Job 28:25",
              "text": "Upang bigyan ng timbang ang hangin; Oo, kaniyang tinatakal ang tubig sa takalan."
            },
            {
              "chapter": 28,
              "verse": 26,
              "name": "Job 28:26",
              "text": "Nang siya'y gumawa ng pasiya sa ulan, at ng daan sa kidlat ng kulog:"
            },
            {
              "chapter": 28,
              "verse": 27,
              "name": "Job 28:27",
              "text": "Nang magkagayo'y nakita niya ito, at inihayag; kaniyang itinatag ito, oo, at siniyasat."
            },
            {
              "chapter": 28,
              "verse": 28,
              "name": "Job 28:28",
              "text": "At sa tao ay sinabi niya, Narito, ang pagkatakot sa Dios ay siyang karunungan; at ang paghiwalay sa kasamaan ay pagkaunawa."
            }
          ]
        },
        {
          "chapter": 29,
          "name": "Job 29",
          "verses": [
            {
              "chapter": 29,
              "verse": 1,
              "name": "Job 29:1",
              "text": "At muling ipinagbadya ni Job ang kaniyang talinghaga, at nagsabi,"
            },
            {
              "chapter": 29,
              "verse": 2,
              "name": "Job 29:2",
              "text": "Oh ako nawa'y napasa mga buwan noong dakong una, gaya noong mga kaarawan ng binabantayan ako ng Dios;"
            },
            {
              "chapter": 29,
              "verse": 3,
              "name": "Job 29:3",
              "text": "Nang ang kaniyang ilawan ay sumisilang sa aking ulo at sa pamamagitan ng kaniyang liwanag ay lumalakad ako sa kadiliman;"
            },
            {
              "chapter": 29,
              "verse": 4,
              "name": "Job 29:4",
              "text": "Gaya noong ako'y nasa kabutihan ng aking mga kaarawan, noong ang pagkasi ng Dios ay nasa aking tolda;"
            },
            {
              "chapter": 29,
              "verse": 5,
              "name": "Job 29:5",
              "text": "Noong ang Makapangyarihan sa lahat ay sumasaakin pa, at ang aking mga anak ay nangasa palibot ko;"
            },
            {
              "chapter": 29,
              "verse": 6,
              "name": "Job 29:6",
              "text": "Noong ang aking mga hakbang ay naliligo sa gatas, at ang bato ay nagbubuhos para sa akin ng mga ilog ng langis!"
            },
            {
              "chapter": 29,
              "verse": 7,
              "name": "Job 29:7",
              "text": "Noong ako'y lumalabas sa pintuang-bayan hanggang sa bayan, noong aking inihahanda ang aking upuan sa lansangan,"
            },
            {
              "chapter": 29,
              "verse": 8,
              "name": "Job 29:8",
              "text": "Nakikita ako ng mga binata, at nagsisipagkubli, at ang mga matanda ay nagsisitindig at nagsisitayo:"
            },
            {
              "chapter": 29,
              "verse": 9,
              "name": "Job 29:9",
              "text": "Ang mga pangulo ay nagpipigil ng pangungusap, at inilalagay ang kanilang kamay sa kanilang bibig;"
            },
            {
              "chapter": 29,
              "verse": 10,
              "name": "Job 29:10",
              "text": "Ang tinig ng mga mahal na tao ay tumatahimik, at ang kanilang dila ay dumidikit sa ngalangala ng kanilang bibig."
            },
            {
              "chapter": 29,
              "verse": 11,
              "name": "Job 29:11",
              "text": "Sapagka't pagka naririnig ako ng pakinig, ay pinagpapala nga ako; at pagka nakikita ako ng mata, ay sumasaksi sa akin:"
            },
            {
              "chapter": 29,
              "verse": 12,
              "name": "Job 29:12",
              "text": "Sapagka't aking iniligtas ang dukha na dumadaing, ang ulila rin naman na walang tumutulong sa kaniya."
            },
            {
              "chapter": 29,
              "verse": 13,
              "name": "Job 29:13",
              "text": "Ang basbas ng malapit nang mamamatay ay sumaakin: at aking pinaawit sa kagalakan ang puso ng babaing bao."
            },
            {
              "chapter": 29,
              "verse": 14,
              "name": "Job 29:14",
              "text": "Ako'y nagbibihis ng katuwiran, at sinusuutan niya ako: ang aking kaganapan ay parang isang balabal at isang diadema."
            },
            {
              "chapter": 29,
              "verse": 15,
              "name": "Job 29:15",
              "text": "Ako'y naging mga mata sa bulag, at naging mga paa ako sa pilay."
            },
            {
              "chapter": 29,
              "verse": 16,
              "name": "Job 29:16",
              "text": "Ako'y naging ama sa mapagkailangan; at ang usap niyaong hindi ko nakikilala ay aking sinisiyasat."
            },
            {
              "chapter": 29,
              "verse": 17,
              "name": "Job 29:17",
              "text": "At aking binali ang mga pangil ng liko, at inagaw ko ang huli sa kaniyang mga ngipin."
            },
            {
              "chapter": 29,
              "verse": 18,
              "name": "Job 29:18",
              "text": "Nang magkagayo'y sinabi ko, mamamatay ako sa aking pugad, at aking pararamihin ang aking mga kaarawan na gaya ng buhangin:"
            },
            {
              "chapter": 29,
              "verse": 19,
              "name": "Job 29:19",
              "text": "Ang aking ugat ay nakalat sa tubig, at ang hamog ay lumalapag buong gabi sa aking sanga:"
            },
            {
              "chapter": 29,
              "verse": 20,
              "name": "Job 29:20",
              "text": "Ang aking kaluwalhatian ay sariwa sa akin, at ang aking busog ay nababago sa aking kamay."
            },
            {
              "chapter": 29,
              "verse": 21,
              "name": "Job 29:21",
              "text": "Sa akin ay nangakikinig ang mga tao, at nangaghihintay, at nagsisitahimik sa aking payo."
            },
            {
              "chapter": 29,
              "verse": 22,
              "name": "Job 29:22",
              "text": "Pagkatapos ng aking mga salita ay hindi na sila nagsasalita pa uli; at ang aking pananalita ay tumutulo sa kanila."
            },
            {
              "chapter": 29,
              "verse": 23,
              "name": "Job 29:23",
              "text": "At kanilang hinihintay ako, na gaya ng paghihintay sa ulan, at kanilang ibinubuka ang kanilang bibig na maluwang na gaya sa huling ulan."
            },
            {
              "chapter": 29,
              "verse": 24,
              "name": "Job 29:24",
              "text": "Ako'y ngumingiti sa kanila pagka sila'y hindi nanganiniwala: at ang liwanag ng aking mukha ay hindi nila hinahamak."
            },
            {
              "chapter": 29,
              "verse": 25,
              "name": "Job 29:25",
              "text": "Ako'y namimili sa kanilang daan, at nauupong gaya ng puno, at tumatahang gaya ng hari sa hukbo, gaya ng nangaaliw sa nananangis."
            }
          ]
        },
        {
          "chapter": 30,
          "name": "Job 30",
          "verses": [
            {
              "chapter": 30,
              "verse": 1,
              "name": "Job 30:1",
              "text": "Nguni't ngayo'y silang bata kay sa akin ay nagsisitawa sa akin, na ang mga magulang ay di ko ibig na malagay na kasama ng mga aso ng aking kawan."
            },
            {
              "chapter": 30,
              "verse": 2,
              "name": "Job 30:2",
              "text": "Oo, ang kalakasan ng kanilang kamay, sa ano ko mapapakinabangan? Mga taong ang kalusugan ng gulang ay lumipas na."
            },
            {
              "chapter": 30,
              "verse": 3,
              "name": "Job 30:3",
              "text": "Sila'y lata sa pangangailangan at sa kagutom; kanilang nginangata ang tuyong lupa, sa kadiliman ng kasalatan at kapahamakan."
            },
            {
              "chapter": 30,
              "verse": 4,
              "name": "Job 30:4",
              "text": "Sila'y nagsisibunot ng mga malvas sa tabi ng mabababang punong kahoy; at ang mga ugat ng enebro ay siyang kanilang pinakapagkain."
            },
            {
              "chapter": 30,
              "verse": 5,
              "name": "Job 30:5",
              "text": "Sila'y pinalayas mula sa gitna ng mga tao; sila'y sumisigaw sa likuran nila, na gaya ng sa likuran ng isang magnanakaw."
            },
            {
              "chapter": 30,
              "verse": 6,
              "name": "Job 30:6",
              "text": "Upang sila'y magsitahan sa nakatatakot na mga libis, sa mga puwang ng lupa, at ng mga bato."
            },
            {
              "chapter": 30,
              "verse": 7,
              "name": "Job 30:7",
              "text": "Sa gitna ng mabababang punong kahoy ay nagsisiangal; sa ilalim ng mga tinikan ay nangapipisan."
            },
            {
              "chapter": 30,
              "verse": 8,
              "name": "Job 30:8",
              "text": "Mga anak ng mga mangmang, oo, mga anak ng mga walang puring tao; sila'y mga itinapon mula sa lupain."
            },
            {
              "chapter": 30,
              "verse": 9,
              "name": "Job 30:9",
              "text": "At ngayon ay naging kantahin nila ako, Oo, ako'y kasabihan sa kanila."
            },
            {
              "chapter": 30,
              "verse": 10,
              "name": "Job 30:10",
              "text": "Kanilang kinayayamutan ako, nilalayuan nila ako, at hindi sila nagpipigil ng paglura sa aking mukha."
            },
            {
              "chapter": 30,
              "verse": 11,
              "name": "Job 30:11",
              "text": "Sapagka't kinalag niya ang kaniyang panali, at pinighati ako, at kanilang inalis ang paningkaw sa harap ko."
            },
            {
              "chapter": 30,
              "verse": 12,
              "name": "Job 30:12",
              "text": "Sa aking kanan ay tumatayo ang tanga; itinutulak nila ang aking mga paa, at kanilang pinapatag laban sa akin ang kanilang mga paraan ng paghamak."
            },
            {
              "chapter": 30,
              "verse": 13,
              "name": "Job 30:13",
              "text": "Kanilang sinisira ang aking landas, kanilang isinusulong ang aking kapahamakan, mga taong walang tumulong."
            },
            {
              "chapter": 30,
              "verse": 14,
              "name": "Job 30:14",
              "text": "Tila dumarating sila sa isang maluwang na pasukan: sa gitna ng kasiraan ay nagsisigulong sila."
            },
            {
              "chapter": 30,
              "verse": 15,
              "name": "Job 30:15",
              "text": "Mga kakilabutan ay dumadagan sa akin, kanilang tinatangay ang aking karangalan na gaya ng hangin; at ang aking kaginhawahan ay napaparam na parang alapaap."
            },
            {
              "chapter": 30,
              "verse": 16,
              "name": "Job 30:16",
              "text": "At ngayo'y nanglulupaypay ang aking kaluluwa sa loob ko; mga kaarawan ng pagkapighati ay humawak sa akin."
            },
            {
              "chapter": 30,
              "verse": 17,
              "name": "Job 30:17",
              "text": "Sa gabi ay nagaantakan ang aking mga buto, at ang mga antak na nagpapahirap sa akin ay hindi nagpapahinga."
            },
            {
              "chapter": 30,
              "verse": 18,
              "name": "Job 30:18",
              "text": "Sa matinding karahasan ng aking sakit ay nagiging katuwa ang aking suot: tumatali sa akin sa palibot na gaya ng leeg ng aking baro."
            },
            {
              "chapter": 30,
              "verse": 19,
              "name": "Job 30:19",
              "text": "Inihahagis niya ako sa banlik, at ako'y naging parang alabok at mga abo."
            },
            {
              "chapter": 30,
              "verse": 20,
              "name": "Job 30:20",
              "text": "Ako'y dumadaing sa iyo, at hindi mo ako sinasagot: ako'y tumatayo, at minamasdan mo ako."
            },
            {
              "chapter": 30,
              "verse": 21,
              "name": "Job 30:21",
              "text": "Ikaw ay naging mabagsik sa akin: sa pamamagitan ng kapangyarihan ng iyong kamay ay hinahabol mo ako."
            },
            {
              "chapter": 30,
              "verse": 22,
              "name": "Job 30:22",
              "text": "Itinataas mo ako sa hangin, pinasasakay mo ako roon; at tinutunaw mo ako sa bagyo."
            },
            {
              "chapter": 30,
              "verse": 23,
              "name": "Job 30:23",
              "text": "Sapagka't talastas ko na iyong dadalhin ako sa kamatayan, at sa bahay na takda sa lahat na may buhay."
            },
            {
              "chapter": 30,
              "verse": 24,
              "name": "Job 30:24",
              "text": "Gayon man ang isa ay di ba naguunat ng kamay sa kaniyang pagkahulog? O sa kaniyang kasakunaan kung kaya sisigaw ng tulong?"
            },
            {
              "chapter": 30,
              "verse": 25,
              "name": "Job 30:25",
              "text": "Hindi ko ba iniyakan yaong nasa kabagabagan? Hindi ba ang aking kaluluwa ay nakikidamay sa mapagkailangan?"
            },
            {
              "chapter": 30,
              "verse": 26,
              "name": "Job 30:26",
              "text": "Pagka ako'y humahanap ng mabuti, ang kasamaan nga ang dumarating: at pagka ako'y naghihintay ng liwanag ay kadiliman ang dumarating."
            },
            {
              "chapter": 30,
              "verse": 27,
              "name": "Job 30:27",
              "text": "Ang aking puso'y nababagabag at walang pahinga; mga araw ng kapighatian ay dumating sa akin."
            },
            {
              "chapter": 30,
              "verse": 28,
              "name": "Job 30:28",
              "text": "Ako'y yumayaong tumatangis na walang araw; ako'y tumatayo sa kapulungan at humihinging tulong."
            },
            {
              "chapter": 30,
              "verse": 29,
              "name": "Job 30:29",
              "text": "Ako'y kapatid ng mga chakal, at mga kasama ng mga avestruz."
            },
            {
              "chapter": 30,
              "verse": 30,
              "name": "Job 30:30",
              "text": "Ang aking balat ay maitim, at natutuklap, at ang aking mga buto ay nagpapaltos."
            },
            {
              "chapter": 30,
              "verse": 31,
              "name": "Job 30:31",
              "text": "Kaya't ang aking alpa ay naging panangis, at ang aking flauta ay naging tinig ng umiiyak."
            }
          ]
        },
        {
          "chapter": 31,
          "name": "Job 31",
          "verses": [
            {
              "chapter": 31,
              "verse": 1,
              "name": "Job 31:1",
              "text": "Ako'y nakipagtipan sa aking mga mata; paano nga akong titingin sa isang dalaga?"
            },
            {
              "chapter": 31,
              "verse": 2,
              "name": "Job 31:2",
              "text": "Sapagka't ano ang bahagi sa ganang akin sa Dios mula sa itaas, at ang mana sa Makapangyarihan sa lahat mula sa kaitaasan?"
            },
            {
              "chapter": 31,
              "verse": 3,
              "name": "Job 31:3",
              "text": "Hindi ba kasakunaan sa liko, at kasawiang palad sa mga manggagawa ng kasamaan?"
            },
            {
              "chapter": 31,
              "verse": 4,
              "name": "Job 31:4",
              "text": "Hindi ba niya nakikita ang aking mga lakad, at binibilang ang lahat ng aking mga hakbang?"
            },
            {
              "chapter": 31,
              "verse": 5,
              "name": "Job 31:5",
              "text": "Kung ako'y lumakad na walang kabuluhan, at ang aking paa ay nagmadali sa pagdaraya;"
            },
            {
              "chapter": 31,
              "verse": 6,
              "name": "Job 31:6",
              "text": "(Timbangin ako sa matuwid na timbangan, upang mabatid ng Dios ang aking pagtatapat;)"
            },
            {
              "chapter": 31,
              "verse": 7,
              "name": "Job 31:7",
              "text": "Kung ang aking hakbang ay lumiko sa daan, at ang aking puso ay lumakad ayon sa aking mga mata, at kung ang anomang dungis ay kumapit sa aking mga kamay:"
            },
            {
              "chapter": 31,
              "verse": 8,
              "name": "Job 31:8",
              "text": "Kung gayo'y papaghasikin mo ako, at bayaang kanin ng iba; Oo, bunutin ang bunga ng aking bukid."
            },
            {
              "chapter": 31,
              "verse": 9,
              "name": "Job 31:9",
              "text": "Kung ang aking puso ay napadaya sa babae, at ako'y bumakay sa pintuan ng aking kapuwa:"
            },
            {
              "chapter": 31,
              "verse": 10,
              "name": "Job 31:10",
              "text": "Kung magkagayo'y iba ang ipaggiling ng aking asawa, at iba ang yumuko sa kaniya."
            },
            {
              "chapter": 31,
              "verse": 11,
              "name": "Job 31:11",
              "text": "Sapagka't iya'y isang mabigat na sala; Oo, isang kasamaan na parurusahan ng mga hukom:"
            },
            {
              "chapter": 31,
              "verse": 12,
              "name": "Job 31:12",
              "text": "Sapagka't isang apoy na namumugnaw hanggang sa pagkapahamak, at bubunutin ang lahat ng aking bunga."
            },
            {
              "chapter": 31,
              "verse": 13,
              "name": "Job 31:13",
              "text": "Kung hinamak ko ang katuwiran ng aking aliping lalake o aliping babae, nang sila'y makipagtalo sa akin:"
            },
            {
              "chapter": 31,
              "verse": 14,
              "name": "Job 31:14",
              "text": "Ano nga ang aking gagawin pagka bumabangon ang Dios? At pagka kaniyang dinadalaw, anong isasagot ko sa kaniya?"
            },
            {
              "chapter": 31,
              "verse": 15,
              "name": "Job 31:15",
              "text": "Hindi ba siyang lumalang sa akin sa bahay-bata ang lumalang sa kaniya; at hindi ba iisa ang humugis sa atin sa bahay-bata?"
            },
            {
              "chapter": 31,
              "verse": 16,
              "name": "Job 31:16",
              "text": "Kung pinagkaitan ko ang dukha sa kanilang nasa, o pinangalumata ko ang mga mata ng babaing bao:"
            },
            {
              "chapter": 31,
              "verse": 17,
              "name": "Job 31:17",
              "text": "O kumain akong magisa ng aking subo, at ang ulila ay hindi kumain niyaon;"
            },
            {
              "chapter": 31,
              "verse": 18,
              "name": "Job 31:18",
              "text": "(Hindi, mula sa aking kabataan ay lumaki siyang kasama ko, na gaya ng may isang ama, at aking pinatnubayan siya mula sa bahay-bata ng aking ina;)"
            },
            {
              "chapter": 31,
              "verse": 19,
              "name": "Job 31:19",
              "text": "Kung ako'y nakakita ng sinomang nangangailangan ng kasuutan, o ng mapagkailangan ng walang kumot;"
            },
            {
              "chapter": 31,
              "verse": 20,
              "name": "Job 31:20",
              "text": "Kung hindi ako pinagpala ng kaniyang mga balakang, at kung siya'y hindi nainitan ng balahibo ng aking mga tupa:"
            },
            {
              "chapter": 31,
              "verse": 21,
              "name": "Job 31:21",
              "text": "Kung binuhat ko ang aking kamay laban sa ulila, sapagka't nakita ko ang tulong sa akin sa pintuang-bayan:"
            },
            {
              "chapter": 31,
              "verse": 22,
              "name": "Job 31:22",
              "text": "Kung nagkagayo'y malaglag ang aking balikat sa abot-agawin, at ang aking kamay ay mabali sa buto."
            },
            {
              "chapter": 31,
              "verse": 23,
              "name": "Job 31:23",
              "text": "Sapagka't ang kasakunaang mula sa Dios ay kakilabutan sa akin, at dahil sa kaniyang karilagan ay wala akong magawa."
            },
            {
              "chapter": 31,
              "verse": 24,
              "name": "Job 31:24",
              "text": "Kung aking pinapaging ginto ang aking pagasa, at sinabi ko sa dalisay na ginto, ikaw ay aking tiwala;"
            },
            {
              "chapter": 31,
              "verse": 25,
              "name": "Job 31:25",
              "text": "Kung ako'y nagalak sapagka't ang aking kayamanan ay malaki, at sapagka't ang aking kamay ay nagtamo ng marami;"
            },
            {
              "chapter": 31,
              "verse": 26,
              "name": "Job 31:26",
              "text": "Kung ako'y tumingin sa araw pagka sumisikat, o sa buwan na lumalakad sa kakinangan;"
            },
            {
              "chapter": 31,
              "verse": 27,
              "name": "Job 31:27",
              "text": "At ang aking puso ay napadayang lihim, at hinagkan ng aking bibig ang aking kamay:"
            },
            {
              "chapter": 31,
              "verse": 28,
              "name": "Job 31:28",
              "text": "Ito may isang kasamaang marapat parusahan ng mga hukom: sapagka't itinakuwil ko ang Dios na nasa itaas."
            },
            {
              "chapter": 31,
              "verse": 29,
              "name": "Job 31:29",
              "text": "Kung ako'y nagalak sa kasakunaan niyaong nagtatanim ng loob sa akin, o nagmataas ako ng datnan siya ng kasamaan;"
            },
            {
              "chapter": 31,
              "verse": 30,
              "name": "Job 31:30",
              "text": "(Oo, hindi ko tiniis ang aking bibig sa kasalanan sa paghingi ng kaniyang buhay na may sumpa;)"
            },
            {
              "chapter": 31,
              "verse": 31,
              "name": "Job 31:31",
              "text": "Kung ang mga tao sa aking tolda ay hindi nagsabi, sinong makakasumpong ng isa na hindi nabusog sa kaniyang pagkain?"
            },
            {
              "chapter": 31,
              "verse": 32,
              "name": "Job 31:32",
              "text": "Ang taga ibang lupa ay hindi tumigil sa lansangan; kundi aking ibinukas ang aking mga pinto sa manglalakbay,"
            },
            {
              "chapter": 31,
              "verse": 33,
              "name": "Job 31:33",
              "text": "Kung aking tinakpan na gaya ni Adan ang aking mga pagsalangsang, sa pagkukubli ng aking kasamaan sa aking sinapupunan;"
            },
            {
              "chapter": 31,
              "verse": 34,
              "name": "Job 31:34",
              "text": "Sapagka't aking kinatakutan ang lubhang karamihan, at pinangilabot ako ng paghamak ng mga angkan. Na anopa't ako'y tumahimik, at hindi lumabas sa pintuan?"
            },
            {
              "chapter": 31,
              "verse": 35,
              "name": "Job 31:35",
              "text": "O mano nawang may duminig sa akin! (Narito ang aking tala, sagutin ako ng Makapangyarihan sa lahat;) At mano nawang magkaroon ako ng sumbong na isinulat ng aking kaaway!"
            },
            {
              "chapter": 31,
              "verse": 36,
              "name": "Job 31:36",
              "text": "Tunay na aking papasanin ito sa aking balikat; aking itatali sa akin na gaya ng isang putong."
            },
            {
              "chapter": 31,
              "verse": 37,
              "name": "Job 31:37",
              "text": "Aking ipahahayag sa kaniya ang bilang ng aking mga hakbang, gaya ng isang pangulo na lalapitan ko siya."
            },
            {
              "chapter": 31,
              "verse": 38,
              "name": "Job 31:38",
              "text": "Kung ang aking lupa ay humiyaw laban sa akin, at ang mga bungkal niyaon ay umiyak na magkakasama;"
            },
            {
              "chapter": 31,
              "verse": 39,
              "name": "Job 31:39",
              "text": "Kung kumain ako ng bunga niyaon na walang bayad, o ipinahamak ko ang buhay ng mga may-ari niyaon:"
            },
            {
              "chapter": 31,
              "verse": 40,
              "name": "Job 31:40",
              "text": "Tubuan ng dawag sa halip ng trigo, at ng mga masamang damo sa halip ng cebada. Ang mga salita ni Job ay natapos."
            }
          ]
        },
        {
          "chapter": 32,
          "name": "Job 32",
          "verses": [
            {
              "chapter": 32,
              "verse": 1,
              "name": "Job 32:1",
              "text": "Sa gayo'y ang tatlong lalaking ito ay nagsitigil ng pagsagot kay Job, sapagka't siya'y matuwid sa kaniyang sariling paningin."
            },
            {
              "chapter": 32,
              "verse": 2,
              "name": "Job 32:2",
              "text": "Nang magkagayo'y nagalab ang poot ni Eliu, na anak ni Barachel na Bucita, na angkan ni Ram: laban kay Job ay nagalab ang kaniyang poot, sapagka't siya'y nagpapanggap na ganap kay sa Dios."
            },
            {
              "chapter": 32,
              "verse": 3,
              "name": "Job 32:3",
              "text": "Laban din naman sa kaniyang tatlong kaibigan ay nagalab ang kaniyang poot, sapagka't sila'y hindi nakasumpong ng sagot, at gayon man ay nahatulan si Job."
            },
            {
              "chapter": 32,
              "verse": 4,
              "name": "Job 32:4",
              "text": "Si Eliu nga ay naghintay upang magsalita kay Job, sapagka't sila'y matanda kay sa kaniya."
            },
            {
              "chapter": 32,
              "verse": 5,
              "name": "Job 32:5",
              "text": "At nang makita ni Eliu na walang kasagutan sa bibig ng tatlong lalaking ito, ay nagalab ang kaniyang poot."
            },
            {
              "chapter": 32,
              "verse": 6,
              "name": "Job 32:6",
              "text": "At si Eliu na anak ni Barachel na Bucita ay sumagot at nagsabi, Ako'y bata, at kayo'y totoong matatanda; kaya't ako'y nagpakapigil at hindi ako nangahas magpatalastas sa inyo ng aking haka."
            },
            {
              "chapter": 32,
              "verse": 7,
              "name": "Job 32:7",
              "text": "Aking sinabi, Ang mga kaarawan ang mangagsasalita, at ang karamihan ng mga taon ay mangagtuturo ng karunungan."
            },
            {
              "chapter": 32,
              "verse": 8,
              "name": "Job 32:8",
              "text": "Nguni't may espiritu sa tao, at ang hinga ng Makapangyarihan sa lahat ay nagbibigay sa kanila ng unawa."
            },
            {
              "chapter": 32,
              "verse": 9,
              "name": "Job 32:9",
              "text": "Hindi ang dakila ang siyang pantas, ni ang matanda man ang siyang nakakaunawa ng kahatulan."
            },
            {
              "chapter": 32,
              "verse": 10,
              "name": "Job 32:10",
              "text": "Kaya't aking sinabi, Dinggin ninyo ako; akin namang ipakikilala ang aking haka."
            },
            {
              "chapter": 32,
              "verse": 11,
              "name": "Job 32:11",
              "text": "Narito, aking hinintay ang inyong mga salita, aking dininig ang inyong mga pangangatuwiran, samantalang kayo'y naghahagilap ng masasabi."
            },
            {
              "chapter": 32,
              "verse": 12,
              "name": "Job 32:12",
              "text": "Oo, aking inulinig kayo, at, narito, walang isang makahikayat kay Job, o sa inyo'y may makasagot sa kaniyang mga salita."
            },
            {
              "chapter": 32,
              "verse": 13,
              "name": "Job 32:13",
              "text": "Magbawa nga kayo, baka kayo'y magsabi, Kami ay nakasumpong ng karunungan; madadaig ng Dios siya, hindi ng tao;"
            },
            {
              "chapter": 32,
              "verse": 14,
              "name": "Job 32:14",
              "text": "Sapagka't hindi itinukoy ang kaniyang mga salita sa akin; ni hindi ko sasagutin siya ng inyong mga pananalita."
            },
            {
              "chapter": 32,
              "verse": 15,
              "name": "Job 32:15",
              "text": "Sila'y nangalito, sila'y hindi na nagsisagot pa; Sila'y walang salitang masabi,"
            },
            {
              "chapter": 32,
              "verse": 16,
              "name": "Job 32:16",
              "text": "At ako ba'y maghihintay, sapagka't sila'y hindi nangagsasalita, sapagka't sila'y nangakatigil, at hindi na nagsisisagot."
            },
            {
              "chapter": 32,
              "verse": 17,
              "name": "Job 32:17",
              "text": "Ako nama'y sasagot ng ganang akin, akin namang ipakikilala ang aking haka."
            },
            {
              "chapter": 32,
              "verse": 18,
              "name": "Job 32:18",
              "text": "Sapagka't ako'y puspos ng mga salita; ang diwa na sumasaloob ko ay pumipigil sa akin,"
            },
            {
              "chapter": 32,
              "verse": 19,
              "name": "Job 32:19",
              "text": "Narito, ang aking dibdib ay parang alak na walang pahingahan: parang mga bagong sisidlang-balat na handa sa pagkahapak."
            },
            {
              "chapter": 32,
              "verse": 20,
              "name": "Job 32:20",
              "text": "Ako'y magsasalita, upang ako'y maginhawahan: aking ibubuka ang aking mga labi at sasagot ako."
            },
            {
              "chapter": 32,
              "verse": 21,
              "name": "Job 32:21",
              "text": "Huwag itulot sa akin na pakundanganan ko, isinasamo ko sa inyo, ang pagkatao ninoman; ni gumamit man sa kanino man ng mga pakunwaring papuring salita."
            },
            {
              "chapter": 32,
              "verse": 22,
              "name": "Job 32:22",
              "text": "Sapagka't hindi ako marunong sumambit ng mga pakunwaring papuring salita; na kung dili ay madaling papanawin ako ng Maylalang sa akin."
            }
          ]
        },
        {
          "chapter": 33,
          "name": "Job 33",
          "verses": [
            {
              "chapter": 33,
              "verse": 1,
              "name": "Job 33:1",
              "text": "Gayon man, Job, isinasamo ko sa iyo na, dinggin mo ang aking pananalita, at pakinggan mo ang lahat ng aking mga salita."
            },
            {
              "chapter": 33,
              "verse": 2,
              "name": "Job 33:2",
              "text": "Narito, ngayon ay aking ibinuka ang aking bibig; nagsalita ang aking dila sa aking bibig."
            },
            {
              "chapter": 33,
              "verse": 3,
              "name": "Job 33:3",
              "text": "Sasaysayin ng aking mga salita ang katuwiran ng aking puso; at ang nalalaman ng aking mga labi ay sasalitaing may pagtatapat."
            },
            {
              "chapter": 33,
              "verse": 4,
              "name": "Job 33:4",
              "text": "Nilalang ako ng Espiritu ng Dios, at ang hinga ng Makapangyarihan sa lahat ay nagbibigay sa akin ng buhay."
            },
            {
              "chapter": 33,
              "verse": 5,
              "name": "Job 33:5",
              "text": "Kung ikaw ay makasasagot ay sumagot ka sa akin; ayusin mo ang iyong mga salita sa harap ko, tumayo ka."
            },
            {
              "chapter": 33,
              "verse": 6,
              "name": "Job 33:6",
              "text": "Narito, ako'y sa Dios na gaya mo: ako ma'y nilalang mula rin sa putik."
            },
            {
              "chapter": 33,
              "verse": 7,
              "name": "Job 33:7",
              "text": "Narito, hindi ka tatakutin ng aking kakilabutan, ni ang aking kalakhan man ay magiging mabigat sa iyo."
            },
            {
              "chapter": 33,
              "verse": 8,
              "name": "Job 33:8",
              "text": "Tunay na ikaw ay nagsalita sa aking pakinig, at aking narinig ang tinig ng iyong mga salita, na nagsasabi,"
            },
            {
              "chapter": 33,
              "verse": 9,
              "name": "Job 33:9",
              "text": "Ako'y malinis na walang pagsalangsang; ako'y walang sala, ni may kasamaan man sa akin:"
            },
            {
              "chapter": 33,
              "verse": 10,
              "name": "Job 33:10",
              "text": "Narito, siya'y nakasumpong ng kadahilanan laban sa akin, ibinilang niya ako na pinakakaaway:"
            },
            {
              "chapter": 33,
              "verse": 11,
              "name": "Job 33:11",
              "text": "Inilagay niya ang aking mga paa sa mga pangawan, kaniyang pinupuna ang lahat na aking landas."
            },
            {
              "chapter": 33,
              "verse": 12,
              "name": "Job 33:12",
              "text": "Narito, ako'y sasagot sa iyo, dito'y hindi ka ganap; sapagka't ang Dios ay dakila kay sa tao."
            },
            {
              "chapter": 33,
              "verse": 13,
              "name": "Job 33:13",
              "text": "Bakit ka nakikilaban sa kaniya? Sapagka't hindi siya nagbibigay alam ng anoman sa kaniyang mga usap."
            },
            {
              "chapter": 33,
              "verse": 14,
              "name": "Job 33:14",
              "text": "Sapagka't ang Dios ay minsang nagsasalita, Oo, makalawa, bagaman hindi pinakikinggan ng tao."
            },
            {
              "chapter": 33,
              "verse": 15,
              "name": "Job 33:15",
              "text": "Sa isang panaginip, sa isang pangitain sa gabi, pagka ang mahimbing na pagkakatulog ay nahuhulog sa mga tao, sa mga pagkakatulog sa higaan;"
            },
            {
              "chapter": 33,
              "verse": 16,
              "name": "Job 33:16",
              "text": "Kung magkagayo'y ibinubukas niya ang mga pakinig ng mga tao, at itinatatak ang kanilang turo,"
            },
            {
              "chapter": 33,
              "verse": 17,
              "name": "Job 33:17",
              "text": "Upang ihiwalay ang tao sa kaniyang panukala, at ikubli ang kapalaluan sa tao;"
            },
            {
              "chapter": 33,
              "verse": 18,
              "name": "Job 33:18",
              "text": "Kaniyang pinipigil ang kaniyang kaluluwa sa pagbulusok sa hukay, at ang kaniyang buhay sa pagkamatay sa pamamagitan ng tabak."
            },
            {
              "chapter": 33,
              "verse": 19,
              "name": "Job 33:19",
              "text": "Siya nama'y pinarurusahan ng sakit sa kaniyang higaan, at ng palaging antak sa kaniyang mga buto:"
            },
            {
              "chapter": 33,
              "verse": 20,
              "name": "Job 33:20",
              "text": "Na anopa't kinayayamutan ng kaniyang buhay ang tinapay, at ng kaniyang kaluluwa ang pagkaing pinakamasarap,"
            },
            {
              "chapter": 33,
              "verse": 21,
              "name": "Job 33:21",
              "text": "Ang kaniyang laman ay natutunaw, na hindi makita; at ang kaniyang mga buto na hindi nakita ay nangalilitaw."
            },
            {
              "chapter": 33,
              "verse": 22,
              "name": "Job 33:22",
              "text": "Oo, ang kaniyang kaluluwa ay nalalapit sa hukay, at ang kaniyang buhay sa mga mangwawasak."
            },
            {
              "chapter": 33,
              "verse": 23,
              "name": "Job 33:23",
              "text": "Kung doroong kasama niya ang isang anghel, isang tagapagpaaninaw, na isa sa gitna ng isang libo, upang ipakilala sa tao kung ano ang matuwid sa kaniya;"
            },
            {
              "chapter": 33,
              "verse": 24,
              "name": "Job 33:24",
              "text": "Kung magkagayo'y binibiyayaan niya siya at nagsasabi, Iligtas mo siya sa pagbaba sa hukay, ako'y nakasumpong ng katubusan."
            },
            {
              "chapter": 33,
              "verse": 25,
              "name": "Job 33:25",
              "text": "Ang kaniyang laman ay magiging sariwa kay sa laman ng isang bata; siya'y bumabalik sa mga kaarawan ng kaniyang kabataan:"
            },
            {
              "chapter": 33,
              "verse": 26,
              "name": "Job 33:26",
              "text": "Siya'y dumadalangin sa Dios, at nililingap niya siya: na anopa't kaniyang nakikita ang kaniyang mukha na may kagalakan: at kaniyang isinasa tao ang kaniyang katuwiran."
            },
            {
              "chapter": 33,
              "verse": 27,
              "name": "Job 33:27",
              "text": "Siya'y umaawit sa harap ng mga tao, at nagsasabi, Ako'y nagkasala, at sumira ng matuwid, at hindi ko napakinabangan:"
            },
            {
              "chapter": 33,
              "verse": 28,
              "name": "Job 33:28",
              "text": "Kaniyang tinubos ang aking kaluluwa sa pagyao sa hukay, at ang aking buhay ay makakakita ng liwanag."
            },
            {
              "chapter": 33,
              "verse": 29,
              "name": "Job 33:29",
              "text": "Narito, ang lahat ng mga bagay na ito ay gawa ng Dios, makalawa, oo, makaitlo sa tao,"
            },
            {
              "chapter": 33,
              "verse": 30,
              "name": "Job 33:30",
              "text": "Upang ibalik ang kaniyang kaluluwa mula sa hukay, upang siya'y maliwanagan ng liwanag ng buhay."
            },
            {
              "chapter": 33,
              "verse": 31,
              "name": "Job 33:31",
              "text": "Pansinin mong mabuti, Oh Job, dinggin mo ako: tumahimik ka, at ako'y magsasalita."
            },
            {
              "chapter": 33,
              "verse": 32,
              "name": "Job 33:32",
              "text": "Kung ikaw ay may anomang bagay na sasabihin, sagutin mo ako: ikaw ay magsalita, sapagka't ibig kong ariin kang ganap."
            },
            {
              "chapter": 33,
              "verse": 33,
              "name": "Job 33:33",
              "text": "Kung hindi, dinggin mo ako: tumahimik ka, at tuturuan kita ng karunungan."
            }
          ]
        },
        {
          "chapter": 34,
          "name": "Job 34",
          "verses": [
            {
              "chapter": 34,
              "verse": 1,
              "name": "Job 34:1",
              "text": "Bukod dito'y sumagot si Eliu, at nagsabi,"
            },
            {
              "chapter": 34,
              "verse": 2,
              "name": "Job 34:2",
              "text": "Dinggin ninyo ang aking mga salita, kayong mga pantas; at pakinggan ninyo ako, ninyong may kaalaman."
            },
            {
              "chapter": 34,
              "verse": 3,
              "name": "Job 34:3",
              "text": "Sapagka't ang pakinig ay tumitikim ng mga salita, gaya ng ngalangala na lumalasa ng pagkain."
            },
            {
              "chapter": 34,
              "verse": 4,
              "name": "Job 34:4",
              "text": "Ating piliin sa ganang atin ang matuwid: ating alamin sa gitna natin kung ano ang mabuti."
            },
            {
              "chapter": 34,
              "verse": 5,
              "name": "Job 34:5",
              "text": "Sapagka't sinabi ni Job, Ako'y matuwid, at inalis ng Dios ang aking katuwiran:"
            },
            {
              "chapter": 34,
              "verse": 6,
              "name": "Job 34:6",
              "text": "Gayon ma'y akong may matuwid ay nabilang akong sinungaling; at ang aking sugat ay walang kagamutan, bagaman ako'y walang pagsalangsang."
            },
            {
              "chapter": 34,
              "verse": 7,
              "name": "Job 34:7",
              "text": "Sinong tao ang gaya ni Job, na umiinom ng pagkaduwahagi na tila tubig,"
            },
            {
              "chapter": 34,
              "verse": 8,
              "name": "Job 34:8",
              "text": "Na yumayaon na kasama ng mga manggagawa ng kasamaan, at lumalakad na kasama ng mga masamang tao?"
            },
            {
              "chapter": 34,
              "verse": 9,
              "name": "Job 34:9",
              "text": "Sapagka't kaniyang sinabi, Walang napapakinabang ang tao na siya'y makapagpalugod sa Dios."
            },
            {
              "chapter": 34,
              "verse": 10,
              "name": "Job 34:10",
              "text": "Kaya't dinggin ninyo ako, ninyong mga lalaking may unawa: malayo nawa sa Dios na siya'y gumawa ng masama; at sa Makapangyarihan sa lahat, na siya'y magkamit ng kasamaan."
            },
            {
              "chapter": 34,
              "verse": 11,
              "name": "Job 34:11",
              "text": "Sapagka't ang gawa ng tao ay tutuusin niya sa kaniya, at ipatatagpo sa bawa't tao ang ayon sa kaniyang mga lakad."
            },
            {
              "chapter": 34,
              "verse": 12,
              "name": "Job 34:12",
              "text": "Oo, sa katotohanan, ang Dios ay hindi gagawa ng kasamaan, ni ang Makapangyarihan sa lahat ay sisira ng kahatulan."
            },
            {
              "chapter": 34,
              "verse": 13,
              "name": "Job 34:13",
              "text": "Sinong nagbigay sa kaniya ng bilin sa lupa? O sinong nagayos ng buong sanglibutan?"
            },
            {
              "chapter": 34,
              "verse": 14,
              "name": "Job 34:14",
              "text": "Kung kaniyang ilagak ang kaniyang puso sa tao, kung kaniyang pisanin sa kaniyang sarili ang kaniyang espiritu at ang kaniyang hininga;"
            },
            {
              "chapter": 34,
              "verse": 15,
              "name": "Job 34:15",
              "text": "Tanang laman ay mamamatay na magkakasama, at ang tao ay mababalik uli sa alabok."
            },
            {
              "chapter": 34,
              "verse": 16,
              "name": "Job 34:16",
              "text": "Kung ngayon ay mayroon kang unawa ay dinggin mo ito: Dinggin mo ang tinig ng aking mga salita."
            },
            {
              "chapter": 34,
              "verse": 17,
              "name": "Job 34:17",
              "text": "Mamamahala ba ang nagtatanim sa katuwiran? At iyo bang parurusahan siyang ganap at may kaya?"
            },
            {
              "chapter": 34,
              "verse": 18,
              "name": "Job 34:18",
              "text": "Siya na nagsabi sa isang hari: ikaw ay hamak? O sa mga mahal na tao: Kayo'y masasama?"
            },
            {
              "chapter": 34,
              "verse": 19,
              "name": "Job 34:19",
              "text": "Na hindi gumagalang sa mga pagkatao ng mga pangulo, ni nagpakundangan man sa mayaman ng higit kay sa mahirap; sapagka't silang lahat ay gawa ng kaniyang mga kamay."
            },
            {
              "chapter": 34,
              "verse": 20,
              "name": "Job 34:20",
              "text": "Sa isang sangdali ay nangamamatay sila, kahit sa hating gabi; ang bayan ay inuuga at nawawala, at inaalis ang may kaya ng wala man lamang kamay."
            },
            {
              "chapter": 34,
              "verse": 21,
              "name": "Job 34:21",
              "text": "Sapagka't ang kaniyang mga mata ay nangasa lakad ng tao, at nakikita niya ang lahat niyang pagyaon."
            },
            {
              "chapter": 34,
              "verse": 22,
              "name": "Job 34:22",
              "text": "Walang kadiliman, ni makapal man pangungulimlim, na mapagtataguan ng mga manggagawa ng kasamaan."
            },
            {
              "chapter": 34,
              "verse": 23,
              "name": "Job 34:23",
              "text": "Sapagka't hindi na niya pakukundanganan ang tao, upang siya'y humarap sa Dios sa kahatulan."
            },
            {
              "chapter": 34,
              "verse": 24,
              "name": "Job 34:24",
              "text": "Kaniyang niluluray ang mga makapangyarihang tao ng mga paraang di masayod, at naglalagay ng mga iba na kahalili nila."
            },
            {
              "chapter": 34,
              "verse": 25,
              "name": "Job 34:25",
              "text": "Kaya't siya'y kumukuhang kaalaman sa kanilang mga gawa; at kaniyang binabaligtad sila sa gabi, na anopa't sila'y nangalilipol."
            },
            {
              "chapter": 34,
              "verse": 26,
              "name": "Job 34:26",
              "text": "Kaniyang hinahampas sila na parang masasamang tao sa hayag na paningin ng mga iba,"
            },
            {
              "chapter": 34,
              "verse": 27,
              "name": "Job 34:27",
              "text": "Sapagka't sila'y nagsilihis ng pagsunod sa kaniya, at hindi binulay ang anoman sa kaniyang mga lakad:"
            },
            {
              "chapter": 34,
              "verse": 28,
              "name": "Job 34:28",
              "text": "Na anopa't kaniyang pinadating ang daing ng dukha sa kaniya, at dininig niya ang daing ng napipighati."
            },
            {
              "chapter": 34,
              "verse": 29,
              "name": "Job 34:29",
              "text": "Pagka siya'y nagbibigay ng katahimikan, sino ngang makahahatol? At pagka kaniyang ikinukubli ang kaniyang mukha, sinong makakakita sa kaniya? Maging gawin sa isang bansa, o sa isang tao:"
            },
            {
              "chapter": 34,
              "verse": 30,
              "name": "Job 34:30",
              "text": "Upang ang taong di banal ay huwag maghari, upang huwag maging silo sa bayan."
            },
            {
              "chapter": 34,
              "verse": 31,
              "name": "Job 34:31",
              "text": "Sapagka't may nagsabi ba sa Dios: Aking tinitiis ang parusa, hindi na ako magkakasala pa:"
            },
            {
              "chapter": 34,
              "verse": 32,
              "name": "Job 34:32",
              "text": "Yaong hindi ko nakikita ay ituro mo sa akin: kung ako'y nakagawa ng kasamaan hindi ko na ito gagawin pa?"
            },
            {
              "chapter": 34,
              "verse": 33,
              "name": "Job 34:33",
              "text": "Mangyayari pa ba ang kaniyang kagantihan na gaya ng iyong ibig na iyong tinatanggihan? Sapagka't ikaw ang marapat pumili at hindi ako: kaya't salitain mo kung ano ang iyong nalalaman."
            },
            {
              "chapter": 34,
              "verse": 34,
              "name": "Job 34:34",
              "text": "Mga taong may unawa ay magsasabi sa akin, Oo, bawa't pantas na taong nakakarinig sa akin:"
            },
            {
              "chapter": 34,
              "verse": 35,
              "name": "Job 34:35",
              "text": "Si Job ay nagsasalita ng walang kaalaman. At ang kaniyang mga salita ay walang karunungan."
            },
            {
              "chapter": 34,
              "verse": 36,
              "name": "Job 34:36",
              "text": "Si Job nawa'y subukin hanggang sa wakas, dahil sa ang kaniyang sagot ay gaya ng mga masamang tao."
            },
            {
              "chapter": 34,
              "verse": 37,
              "name": "Job 34:37",
              "text": "Sapagka't siya'y nagdadagdag ng panghihimagsik sa kaniyang kasalanan, kaniyang pinagagalaw ang kaniyang mga kamay sa gitna natin, at pinararami ang kaniyang mga salita laban sa Dios."
            }
          ]
        },
        {
          "chapter": 35,
          "name": "Job 35",
          "verses": [
            {
              "chapter": 35,
              "verse": 1,
              "name": "Job 35:1",
              "text": "Bukod dito'y sumagot si Eliu, at nagsabi,"
            },
            {
              "chapter": 35,
              "verse": 2,
              "name": "Job 35:2",
              "text": "Iniisip mo bang ito'y matuwid? O sinasabi mong: Ang aking katuwiran ay higit kay sa Dios,"
            },
            {
              "chapter": 35,
              "verse": 3,
              "name": "Job 35:3",
              "text": "Na iyong sinasabi, Anong pakinabang ang tatamuhin mo? At, anong pakinabang ang tataglayin kong higit kung ako'y nagkasala?"
            },
            {
              "chapter": 35,
              "verse": 4,
              "name": "Job 35:4",
              "text": "Sasagutin kita, at ang iyong mga kasamahang kasama mo."
            },
            {
              "chapter": 35,
              "verse": 5,
              "name": "Job 35:5",
              "text": "Tumingala ka sa mga langit at iyong tingnan; at masdan mo ang mga alapaap na lalong mataas kay sa iyo."
            },
            {
              "chapter": 35,
              "verse": 6,
              "name": "Job 35:6",
              "text": "Kung ikaw ay nagkasala, anong iyong ginagawa laban sa kaniya? At kung ang iyong mga pagsalangsang ay dumami, anong iyong ginagawa sa kaniya?"
            },
            {
              "chapter": 35,
              "verse": 7,
              "name": "Job 35:7",
              "text": "Kung ikaw ay matuwid anong ibinibigay mo sa kaniya? O anong tinatanggap niya sa iyong kamay?"
            },
            {
              "chapter": 35,
              "verse": 8,
              "name": "Job 35:8",
              "text": "Ang iyong kasamaan ay makapagpapahamak sa isang lalaking gaya mo; at ang iyong katuwiran ay makapagpapakinabang sa anak ng tao."
            },
            {
              "chapter": 35,
              "verse": 9,
              "name": "Job 35:9",
              "text": "Dahil sa karamihan ng mga kapighatian, sila'y humihiyaw: sila'y humihingi ng tulong dahil sa kamay ng makapangyarihan."
            },
            {
              "chapter": 35,
              "verse": 10,
              "name": "Job 35:10",
              "text": "Nguni't walang nagsasabing, Saan nandoon ang Dios na Maylalang sa akin, na siyang nagbibigay ng awit kung gabi;"
            },
            {
              "chapter": 35,
              "verse": 11,
              "name": "Job 35:11",
              "text": "Na siyang nagtuturo sa atin ng higit kay sa mga hayop sa lupa. At ginagawa tayong lalong pantas kay sa mga ibon sa himpapawid?"
            },
            {
              "chapter": 35,
              "verse": 12,
              "name": "Job 35:12",
              "text": "Doo'y tumatawag sila, nguni't walang sumasagot, dahil sa kapalaluan ng mga masamang tao."
            },
            {
              "chapter": 35,
              "verse": 13,
              "name": "Job 35:13",
              "text": "Tunay na hindi didinggin ng Dios ang walang kabuluhan, ni pakukundanganan man ito ng Makapangyarihan sa lahat."
            },
            {
              "chapter": 35,
              "verse": 14,
              "name": "Job 35:14",
              "text": "Gaano pa kaliit kung iyong sinasabing hindi mo nakikita siya. Ang usap ay nasa harap niya, at iyong hinihintay siya!"
            },
            {
              "chapter": 35,
              "verse": 15,
              "name": "Job 35:15",
              "text": "Nguni't ngayon sapagka't hindi niya dinalaw sa kaniyang galit, ni ginunita mang maigi;"
            },
            {
              "chapter": 35,
              "verse": 16,
              "name": "Job 35:16",
              "text": "Kaya't ibinubuka ni Job ang kaniyang bibig sa walang kabuluhan; siya'y nagpaparami ng mga salita na walang kaalaman."
            }
          ]
        },
        {
          "chapter": 36,
          "name": "Job 36",
          "verses": [
            {
              "chapter": 36,
              "verse": 1,
              "name": "Job 36:1",
              "text": "Si Eliu rin naman ay nagpatuloy at nagsabi,"
            },
            {
              "chapter": 36,
              "verse": 2,
              "name": "Job 36:2",
              "text": "Pagdalitaan mo akong sandali, at aking ipakikilala sa iyo; sapagka't mayroon pa akong masasalita sa pagsasanggalang sa Dios."
            },
            {
              "chapter": 36,
              "verse": 3,
              "name": "Job 36:3",
              "text": "Dadalhin ko ang aking kaalaman mula sa malayo, at aking itutungkol ang katuwiran sa Maylalang sa akin."
            },
            {
              "chapter": 36,
              "verse": 4,
              "name": "Job 36:4",
              "text": "Sapagka't tunay na ang aking mga salita ay hindi kabulaanan: Siyang sakdal sa kaalaman ay sumasaiyo."
            },
            {
              "chapter": 36,
              "verse": 5,
              "name": "Job 36:5",
              "text": "Narito ang Dios ay makapangyarihan, at hindi humahamak sa kanino man; siya'y makapangyarihan sa lakas ng unawa."
            },
            {
              "chapter": 36,
              "verse": 6,
              "name": "Job 36:6",
              "text": "Hindi niya pinanatili ang buhay ng masama: nguni't nagbibigay ng matuwid sa napipighati."
            },
            {
              "chapter": 36,
              "verse": 7,
              "name": "Job 36:7",
              "text": "Hindi niya inihihiwalay ang kaniyang mga mata sa matuwid: kundi kasama ng mga hari sa luklukan, kaniyang itinatatag sila magpakailan man, at sila'y natataas."
            },
            {
              "chapter": 36,
              "verse": 8,
              "name": "Job 36:8",
              "text": "At kung sila'y mapapangaw, at mapipigil sa mga panali ng kapighatian;"
            },
            {
              "chapter": 36,
              "verse": 9,
              "name": "Job 36:9",
              "text": "Itinuturo nga niya sa kanila ang kanilang gawa, at ang kanilang mga pagsalangsang na kanilang pinalalo."
            },
            {
              "chapter": 36,
              "verse": 10,
              "name": "Job 36:10",
              "text": "Ibinubuka rin naman niya ang kanilang pakinig sa turo, at iniuutos na sila'y magsihiwalay sa kasamaan."
            },
            {
              "chapter": 36,
              "verse": 11,
              "name": "Job 36:11",
              "text": "Kung sila'y makinig at maglingkod sa kaniya, kanilang gugugulin ang kanilang mga kaarawan sa kaginhawahan, at ang kanilang mga taon sa kasayahan."
            },
            {
              "chapter": 36,
              "verse": 12,
              "name": "Job 36:12",
              "text": "Nguni't kung hindi sila mangakinig, sila'y mangamamatay sa pamamagitan ng tabak, at sila'y mangamamatay na walang kaalaman."
            },
            {
              "chapter": 36,
              "verse": 13,
              "name": "Job 36:13",
              "text": "Nguni't ang di banal sa puso ay nagbubunton ng galit: hindi humihiyaw sila ng saklolo pagka tinatalian niya sila."
            },
            {
              "chapter": 36,
              "verse": 14,
              "name": "Job 36:14",
              "text": "Sila'y nangamamatay sa kabataan, at ang kanilang buhay ay napapahamak sa gitna ng marumi."
            },
            {
              "chapter": 36,
              "verse": 15,
              "name": "Job 36:15",
              "text": "Inililigtas niya ang mga dukha sa kanilang pagkapighati, at ibinubuka ang kanilang mga pakinig sa pagkapighati."
            },
            {
              "chapter": 36,
              "verse": 16,
              "name": "Job 36:16",
              "text": "Oo, hahanguin ka niya mula sa kagipitan, hanggang sa luwal na dako na walang kagipitan; at ang malalagay sa iyong dulang ay mapupuno ng katabaan."
            },
            {
              "chapter": 36,
              "verse": 17,
              "name": "Job 36:17",
              "text": "Nguni't ikaw ay puspos ng kahatulan ng masama: kahatulan at kaganapan ang humahawak sa iyo."
            },
            {
              "chapter": 36,
              "verse": 18,
              "name": "Job 36:18",
              "text": "Sapagka't may poot, magingat ka baka ikaw ay iligaw ng iyong kasiyahan; ni mailigaw ka man ng kalakhan ng katubusan."
            },
            {
              "chapter": 36,
              "verse": 19,
              "name": "Job 36:19",
              "text": "Mapapaari ba ang iyong sigaw na ikaw ay hindi mapapasa kapanglawan, O ang madlang lakas man ng iyong kalakasan?"
            },
            {
              "chapter": 36,
              "verse": 20,
              "name": "Job 36:20",
              "text": "Huwag mong nasain ang gabi, pagka ang mga bayan ay nangahiwalay sa kanilang kinaroroonang dako."
            },
            {
              "chapter": 36,
              "verse": 21,
              "name": "Job 36:21",
              "text": "Ikaw ay magingat, huwag mong lingunin ang kasamaan; sapagka't ito'y iyong pinili sa halip ng kadalamhatian."
            },
            {
              "chapter": 36,
              "verse": 22,
              "name": "Job 36:22",
              "text": "Narito, ang Dios ay gumagawa ng mainam sa kaniyang kapangyarihan: sinong tagapagturo ang gaya niya?"
            },
            {
              "chapter": 36,
              "verse": 23,
              "name": "Job 36:23",
              "text": "Sinong nagguhit sa kaniya ng kaniyang daan? O sinong makapagsasabi, ikaw ay gumawa ng kalikuan?"
            },
            {
              "chapter": 36,
              "verse": 24,
              "name": "Job 36:24",
              "text": "Alalahanin mo na iyong dinakila ang kaniyang gawa, na inawit ng mga tao."
            },
            {
              "chapter": 36,
              "verse": 25,
              "name": "Job 36:25",
              "text": "Lahat ng mga tao'y nakakita noon; makikita ito ng tao sa malayo."
            },
            {
              "chapter": 36,
              "verse": 26,
              "name": "Job 36:26",
              "text": "Narito, ang Dios ay dakila, at hindi natin nakikilala siya; hindi masayod ang bilang ng kaniyang mga taon."
            },
            {
              "chapter": 36,
              "verse": 27,
              "name": "Job 36:27",
              "text": "Sapagka't pinailanglang niya ang mga patak ng tubig, na nagiging ulan mula sa singaw na yaon:"
            },
            {
              "chapter": 36,
              "verse": 28,
              "name": "Job 36:28",
              "text": "Na ibinubuhos ng mga langit at ipinapatak na sagana sa tao."
            },
            {
              "chapter": 36,
              "verse": 29,
              "name": "Job 36:29",
              "text": "Oo, may makakaunawa ba ng paglaganap ng mga alapaap, ng mga kulog ng kaniyang kulandong?"
            },
            {
              "chapter": 36,
              "verse": 30,
              "name": "Job 36:30",
              "text": "Narito, pinalalaganap niya ang kaniyang liwanag sa palibot niya; at inaapawan ang kalaliman ng dagat."
            },
            {
              "chapter": 36,
              "verse": 31,
              "name": "Job 36:31",
              "text": "Sapagka't sa pamamagitan ng mga ito ay hinahatulan niya ang mga bayan; siya'y nagbibigay ng pagkaing sagana."
            },
            {
              "chapter": 36,
              "verse": 32,
              "name": "Job 36:32",
              "text": "Tinatakpan niya ang kaniyang mga kamay ng kidlat; at ibinilin sa kidlat na tumama sa pinakatanda."
            },
            {
              "chapter": 36,
              "verse": 33,
              "name": "Job 36:33",
              "text": "Ang hugong niyaon ay nagsasaysay ng tungkol sa kaniya, ang hayop nama'y ng tungkol sa bagyo na dumarating."
            }
          ]
        },
        {
          "chapter": 37,
          "name": "Job 37",
          "verses": [
            {
              "chapter": 37,
              "verse": 1,
              "name": "Job 37:1",
              "text": "Oo, dahil din dito'y nanginginig ang aking puso, at napapabago sa kaniyang kinaroroonang dako."
            },
            {
              "chapter": 37,
              "verse": 2,
              "name": "Job 37:2",
              "text": "Dinggin ninyo oh dinggin ang hiyaw ng kaniyang tinig, at ang sigaw na lumalabas sa kaniyang bibig."
            },
            {
              "chapter": 37,
              "verse": 3,
              "name": "Job 37:3",
              "text": "Kaniyang ipinadadala sa silong ng buong langit, at ang kidlat niya'y sa mga wakas ng lupa."
            },
            {
              "chapter": 37,
              "verse": 4,
              "name": "Job 37:4",
              "text": "Sumunod nito'y isang hugong na dumadagundong; siya'y kumukulog ng hugong ng kaniyang karilagan: at hindi tumitigil doon kung naririnig ang kaniyang tinig."
            },
            {
              "chapter": 37,
              "verse": 5,
              "name": "Job 37:5",
              "text": "Ang Dios ay kumukulog na kagilagilalas ng kaniyang tinig; dakilang mga bagay ang ginawa niya, na hindi natin matalastas."
            },
            {
              "chapter": 37,
              "verse": 6,
              "name": "Job 37:6",
              "text": "Sapagka't sinabi niya sa nieve, Lumagpak ka sa lupa; gayon din sa ambon, at sa bugso ng kaniyang malakas na ulan,"
            },
            {
              "chapter": 37,
              "verse": 7,
              "name": "Job 37:7",
              "text": "Tinatatakan niya ang kamay ng bawa't tao: upang maalaman ng lahat ng mga tao na kaniyang nilalang."
            },
            {
              "chapter": 37,
              "verse": 8,
              "name": "Job 37:8",
              "text": "Kung gayo'y nagsisipasok ang mga hayop sa mga lungga, at namamalagi sa kanilang mga tahanan."
            },
            {
              "chapter": 37,
              "verse": 9,
              "name": "Job 37:9",
              "text": "Mula sa timog nanggagaling ang bagyo: at ang ginaw ay mula sa hilagaan."
            },
            {
              "chapter": 37,
              "verse": 10,
              "name": "Job 37:10",
              "text": "Sa pamamagitan ng hinga ng Dios ay nayayari ang hielo: at ang kaluwangan ng tubig ay naiipit."
            },
            {
              "chapter": 37,
              "verse": 11,
              "name": "Job 37:11",
              "text": "Oo, kaniyang nilalagyan ang masinsing ulap ng halomigmig; kaniyang pinangangalat ang alapaap ng kaniyang kidlat:"
            },
            {
              "chapter": 37,
              "verse": 12,
              "name": "Job 37:12",
              "text": "At pumipihit sa palibot sa pamamagitan ng kaniyang patnubay, upang kanilang gawin ang anomang iutos niya sa kanila, sa ibabaw ng balat ng sanglibutang natatahanan:"
            },
            {
              "chapter": 37,
              "verse": 13,
              "name": "Job 37:13",
              "text": "Maging sa saway, o maging sa kaniyang lupain, o maging sa kaawaan ay pinalilitaw niya."
            },
            {
              "chapter": 37,
              "verse": 14,
              "name": "Job 37:14",
              "text": "Dinggin mo ito, Oh Job: Tumigil ka, at bulayin ang kagilagilalas na mga gawa ng Dios."
            },
            {
              "chapter": 37,
              "verse": 15,
              "name": "Job 37:15",
              "text": "Nalalaman mo ba kung paanong pinararatangan sila ng Dios, at pinasisilang ang kidlat ng kaniyang alapaap?"
            },
            {
              "chapter": 37,
              "verse": 16,
              "name": "Job 37:16",
              "text": "Nalalaman mo ba ang mga pagtitimbang ng mga alapaap, ang kagilagilalas na mga gawa niya na sakdal sa kaalaman?"
            },
            {
              "chapter": 37,
              "verse": 17,
              "name": "Job 37:17",
              "text": "Paanong umiinit ang inyong mga suot, pagka tumatahimik ang lupa sa pamamagitan ng hanging timugan?"
            },
            {
              "chapter": 37,
              "verse": 18,
              "name": "Job 37:18",
              "text": "Mailalatag mo ba na kasama niya ang langit, na matibay na gaya ng isang salaming binubo?"
            },
            {
              "chapter": 37,
              "verse": 19,
              "name": "Job 37:19",
              "text": "Ituro mo sa amin kung anong aming sasabihin sa kaniya; sapagka't hindi namin maayos ang aming pananalita dahil sa kadiliman."
            },
            {
              "chapter": 37,
              "verse": 20,
              "name": "Job 37:20",
              "text": "Sasaysayin ba sa kaniya na ako'y magsasalita? O iisipin ba ng isang tao na siya'y sasakmalin."
            },
            {
              "chapter": 37,
              "verse": 21,
              "name": "Job 37:21",
              "text": "At ngayo'y hindi nakikita ng mga tao ang makinang na liwanag na nasa mga langit: nguni't ang hangin ay dumadaan, at pinapalis ang mga yaon."
            },
            {
              "chapter": 37,
              "verse": 22,
              "name": "Job 37:22",
              "text": "Karilagang ginto ay nagmumula sa hilagaan; may taglay ang Dios na kakilakilabot na karilagan."
            },
            {
              "chapter": 37,
              "verse": 23,
              "name": "Job 37:23",
              "text": "Tungkol sa Makapangyarihan sa lahat, hindi natin mauunawa; siya'y marilag sa kapangyarihan; at sa kahatulan at saganang kaganapan siya'y hindi pipighati."
            },
            {
              "chapter": 37,
              "verse": 24,
              "name": "Job 37:24",
              "text": "Kinatatakutan nga siya ng mga tao: hindi niya binibigyang pitagan ang sinomang pantas sa puso."
            }
          ]
        },
        {
          "chapter": 38,
          "name": "Job 38",
          "verses": [
            {
              "chapter": 38,
              "verse": 1,
              "name": "Job 38:1",
              "text": "Nang magkagayo'y sumagot ang Panginoon kay Job mula sa ipoipo, at nagsabi,"
            },
            {
              "chapter": 38,
              "verse": 2,
              "name": "Job 38:2",
              "text": "Sino ito na nagpapadilim ng payo sa pamamagitan ng mga salita na walang kaalaman?"
            },
            {
              "chapter": 38,
              "verse": 3,
              "name": "Job 38:3",
              "text": "Bigkisan mo ngayon ang iyong mga balakang na parang lalake: sapagka't tatanungin kita at magpapahayag ka sa akin."
            },
            {
              "chapter": 38,
              "verse": 4,
              "name": "Job 38:4",
              "text": "Saan ka nandoon nang ilagay ko ang mga patibayan ng lupa? Ipahayag mo, kung mayroon kang unawa."
            },
            {
              "chapter": 38,
              "verse": 5,
              "name": "Job 38:5",
              "text": "Sinong naglagay ng mga sukat niyaon, kung iyong nalalaman? O sinong nagunat ng panukat diyan?"
            },
            {
              "chapter": 38,
              "verse": 6,
              "name": "Job 38:6",
              "text": "Sa ano nalagay ang kaniyang mga patibayan? O sinong naglagay ng batong panulok niyaon;"
            },
            {
              "chapter": 38,
              "verse": 7,
              "name": "Job 38:7",
              "text": "Nang magsiawit na magkakasama ang mga bituin pang-umaga. At ang lahat ng mga anak ng Dios ay naghihiyawan sa kagalakan?"
            },
            {
              "chapter": 38,
              "verse": 8,
              "name": "Job 38:8",
              "text": "O sinong nagsara ng mga pinto sa dagat, nang magpumiglas na gaya ng pagpiglas mula sa bahay-bata?"
            },
            {
              "chapter": 38,
              "verse": 9,
              "name": "Job 38:9",
              "text": "Nang gawin ko ang alapaap na bihisan niyaon, at ang salimuot na kadiliman na pinakabalot niyaon,"
            },
            {
              "chapter": 38,
              "verse": 10,
              "name": "Job 38:10",
              "text": "At aking itinatag doon ang aking pasiya, at nilagyan ko ng mga halang at mga pinto,"
            },
            {
              "chapter": 38,
              "verse": 11,
              "name": "Job 38:11",
              "text": "At aking sinabi, Hanggang dito ay darating ka, nguni't hindi ka na lalagpas: at dito'y titigil ang iyong mga palalong alon?"
            },
            {
              "chapter": 38,
              "verse": 12,
              "name": "Job 38:12",
              "text": "Nagutos ka ba sa umaga mula sa iyong mga kaarawan, at ipinabatid mo ba sa bukang liwayway ang kaniyang dako;"
            },
            {
              "chapter": 38,
              "verse": 13,
              "name": "Job 38:13",
              "text": "Upang humawak sa mga wakas ng lupa, at ang masasama ay maugoy doon?"
            },
            {
              "chapter": 38,
              "verse": 14,
              "name": "Job 38:14",
              "text": "Nababagong parang putik sa ilalim ng tatak; at lahat ng mga bagay ay nagiging gaya ng bihisan:"
            },
            {
              "chapter": 38,
              "verse": 15,
              "name": "Job 38:15",
              "text": "At sa masama ay inalis ang kanilang liwanag, at ang mataas na kamay ay mababali."
            },
            {
              "chapter": 38,
              "verse": 16,
              "name": "Job 38:16",
              "text": "Pumasok ka ba sa mga bukal ng dagat? O lumakad ka ba sa mga landas ng kalaliman?"
            },
            {
              "chapter": 38,
              "verse": 17,
              "name": "Job 38:17",
              "text": "Nangahayag ba sa iyo ang mga pintuan ng kamatayan? O nakita mo ba ang mga pinto ng anino ng kamatayan?"
            },
            {
              "chapter": 38,
              "verse": 18,
              "name": "Job 38:18",
              "text": "Iyo bang nabatid ang kaluwangan ng lupa? Ipahayag mo, kung iyong nalalamang lahat."
            },
            {
              "chapter": 38,
              "verse": 19,
              "name": "Job 38:19",
              "text": "Saan nandoon ang daan na patungo sa tahanan ng liwanag, at tungkol sa kadiliman, saan nandoon ang dako niyaon;"
            },
            {
              "chapter": 38,
              "verse": 20,
              "name": "Job 38:20",
              "text": "Upang iyong madala sa hangganan niyaon, at upang iyong gunitain ang mga landas hanggang sa bahay niyaon?"
            },
            {
              "chapter": 38,
              "verse": 21,
              "name": "Job 38:21",
              "text": "Marahil nalalaman mo, sapagka't ikaw nga'y ipinanganak noon, at ang bilang ng iyong mga kaarawan ay marami?"
            },
            {
              "chapter": 38,
              "verse": 22,
              "name": "Job 38:22",
              "text": "Pumasok ka ba sa mga tipunan ng nieve, o nakita mo ba ang mga tipunan ng granizo,"
            },
            {
              "chapter": 38,
              "verse": 23,
              "name": "Job 38:23",
              "text": "Na aking itinaan laban sa panahon ng kabagabagan, laban sa kaarawan ng pagbabaka at pagdidigma?"
            },
            {
              "chapter": 38,
              "verse": 24,
              "name": "Job 38:24",
              "text": "Sa aling daan naghiwalay ang liwanag, o sa hanging silanganan na lumalaganap sa ibabaw ng lupa?"
            },
            {
              "chapter": 38,
              "verse": 25,
              "name": "Job 38:25",
              "text": "Sinong humukay ng bangbang sa mga bugso ng tubig, o ng daanan ng kidlat ng kulog;"
            },
            {
              "chapter": 38,
              "verse": 26,
              "name": "Job 38:26",
              "text": "Upang magpaulan sa lupa, na hindi tinatahanan ng tao, sa ilang na doon ay walang tao."
            },
            {
              "chapter": 38,
              "verse": 27,
              "name": "Job 38:27",
              "text": "Upang busugin ang giba at sirang lupa; at upang pasibulin ang sariwang damo?"
            },
            {
              "chapter": 38,
              "verse": 28,
              "name": "Job 38:28",
              "text": "May ama ba ang ulan? O sinong nanganak sa mga patak ng hamog?"
            },
            {
              "chapter": 38,
              "verse": 29,
              "name": "Job 38:29",
              "text": "Sa kaninong bahay-bata nagmula ang hielo? At ang escarcha sa himpapawid, ay ipinanganak nino?"
            },
            {
              "chapter": 38,
              "verse": 30,
              "name": "Job 38:30",
              "text": "Ang mga tubig ay nakukubling gaya ng bato, at ang ibabaw ng kalaliman ay namumuno."
            },
            {
              "chapter": 38,
              "verse": 31,
              "name": "Job 38:31",
              "text": "Matatalian mo ba ang pagkakaumpukan ng mga bituin na Pleyade, o makakalagan ang tali ng mga bituin na Orion?"
            },
            {
              "chapter": 38,
              "verse": 32,
              "name": "Job 38:32",
              "text": "Mailalabas mo ba ang mga bituin na mga tanda ng Zodiaco sa kanilang kapanahunan? O mapapatnubayan mo ba ang Oso na kasama ng kaniyang mga anak?"
            },
            {
              "chapter": 38,
              "verse": 33,
              "name": "Job 38:33",
              "text": "Nalalaman mo ba ang mga alituntunin ng langit? Maitatatag mo ba ang kapangyarihan niyaon sa lupa?"
            },
            {
              "chapter": 38,
              "verse": 34,
              "name": "Job 38:34",
              "text": "Mailalakas mo ba ang iyong tinig hanggang sa mga alapaap, upang takpan ka ng saganang tubig?"
            },
            {
              "chapter": 38,
              "verse": 35,
              "name": "Job 38:35",
              "text": "Makapagsusugo ka ba ng mga kidlat, upang magsiyaon, at magsabi sa iyo: Nangarito kami?"
            },
            {
              "chapter": 38,
              "verse": 36,
              "name": "Job 38:36",
              "text": "Sinong naglagay ng karunungan sa mga pinakaloob na bahagi? O sinong nagbigay ng kaalaman sa pagiisip?"
            },
            {
              "chapter": 38,
              "verse": 37,
              "name": "Job 38:37",
              "text": "Sinong makabibilang ng mga alapaap sa pamamagitan ng karunungan? O sinong makatutuyo ng mga botelya ng langit,"
            },
            {
              "chapter": 38,
              "verse": 38,
              "name": "Job 38:38",
              "text": "Pagka ang alabok ay napuputik, at ang mga bugal ay nanganinikit na maigi?"
            },
            {
              "chapter": 38,
              "verse": 39,
              "name": "Job 38:39",
              "text": "Huhuli ka ba ng mahuhuli na ukol sa leong babae? O bubusugin mo baga ang kagutoman ng mga batang leon,"
            },
            {
              "chapter": 38,
              "verse": 40,
              "name": "Job 38:40",
              "text": "Pagka sila'y nagsisihilig sa kanilang mga lungga, at nagsisitahan sa guwang upang bumakay?"
            },
            {
              "chapter": 38,
              "verse": 41,
              "name": "Job 38:41",
              "text": "Sinong naghahanda sa uwak ng pagkain niya, pagka ang kaniyang mga inakay ay nagsisidaing sa Dios, at nagsisigala sa kakulangan ng pagkain."
            }
          ]
        },
        {
          "chapter": 39,
          "name": "Job 39",
          "verses": [
            {
              "chapter": 39,
              "verse": 1,
              "name": "Job 39:1",
              "text": "Nalalaman mo ba ang panahong ipinanganganak ng mga kambing bundok? O matatandaan mo ba ang mga pagdaramdam ng mga usa?"
            },
            {
              "chapter": 39,
              "verse": 2,
              "name": "Job 39:2",
              "text": "Mabibilang mo ba ang mga buwan ng kanilang kagampanan? O nalalaman mo ba ang panahong kanilang ipinanganak?"
            },
            {
              "chapter": 39,
              "verse": 3,
              "name": "Job 39:3",
              "text": "Sila'y nagsisiyuko, kanilang inilalabas ang kanilang mga anak, kaniyang iniwawaksi ang kanilang kapanglawan."
            },
            {
              "chapter": 39,
              "verse": 4,
              "name": "Job 39:4",
              "text": "Ang kanilang mga anak ay nagiging malakas, sila'y nagsisilaki sa kaparangan; sila'y nagsisiyao at hindi na nagsisibalik."
            },
            {
              "chapter": 39,
              "verse": 5,
              "name": "Job 39:5",
              "text": "Sinong nagpakawala sa mabangis na asno? O sinong nagkalag ng mga tali ng mailap na asno?"
            },
            {
              "chapter": 39,
              "verse": 6,
              "name": "Job 39:6",
              "text": "Na ginawa kong bahay niya ang ilang, at ang lupaing maasin na kaniyang tahanan."
            },
            {
              "chapter": 39,
              "verse": 7,
              "name": "Job 39:7",
              "text": "Kaniyang nililibak ang kaguluhan ng bayan. Ni hindi niya dinidinig ang sigaw ng nagpapatakbo ng hayop."
            },
            {
              "chapter": 39,
              "verse": 8,
              "name": "Job 39:8",
              "text": "Ang libot ng mga bundok ay kaniyang pastulan, at kaniyang sinasaliksik ang bawa't sariwang bagay."
            },
            {
              "chapter": 39,
              "verse": 9,
              "name": "Job 39:9",
              "text": "Matutuwa ba ang bakang gubat na maglingkod sa iyo? O matitira ba sa siping ng iyong pasabsaban?"
            },
            {
              "chapter": 39,
              "verse": 10,
              "name": "Job 39:10",
              "text": "Matatalian mo ba ang bakang gubat ng iyong panali sa pangbukid? O magbubusagsag ba ng mga libis sa likuran mo?"
            },
            {
              "chapter": 39,
              "verse": 11,
              "name": "Job 39:11",
              "text": "Aasa ka ba sa kaniya, dahil sa siya'y totoong malakas? O iiwan mo ba ang iyong gawain sa kaniya?"
            },
            {
              "chapter": 39,
              "verse": 12,
              "name": "Job 39:12",
              "text": "Ipagkakatiwala mo ba sa kaniya na iuuwi sa bahay ang iyong binhi, at pipisanin ang mga butil sa iyong giikan?"
            },
            {
              "chapter": 39,
              "verse": 13,
              "name": "Job 39:13",
              "text": "Ang pakpak ng avestruz ay nagagalak; nguni't may kagandahang loob ba ang kanilang mga pakpak at mga balahibo?"
            },
            {
              "chapter": 39,
              "verse": 14,
              "name": "Job 39:14",
              "text": "Sapagka't nagiiwan ng kaniyang mga itlog sa lupa, at pinaiinit ang mga yaon sa alabok,"
            },
            {
              "chapter": 39,
              "verse": 15,
              "name": "Job 39:15",
              "text": "At kinalilimutang mangapipisa ng paa, o mangayuyurakan ng mabangis na hayop."
            },
            {
              "chapter": 39,
              "verse": 16,
              "name": "Job 39:16",
              "text": "Siya'y nagmamatigas laban sa kaniyang mga sisiw na tila hindi kaniya: bagaman ang kaniyang gawa ay mawalang kabuluhan, hindi niya ikinatatakot;"
            },
            {
              "chapter": 39,
              "verse": 17,
              "name": "Job 39:17",
              "text": "Sapagka't binawian siya ng Dios ng karunungan, ni hindi siya binahaginan ng unawa."
            },
            {
              "chapter": 39,
              "verse": 18,
              "name": "Job 39:18",
              "text": "Anomang panahon na siya'y napaiitaas, hinahamak niya ang kabayo at ang sakay nito."
            },
            {
              "chapter": 39,
              "verse": 19,
              "name": "Job 39:19",
              "text": "Nagbigay ka ba sa kabayo ng kalakasan? Binihisan mo ba ang kaniyang leeg ng buhok na gumagalaw?"
            },
            {
              "chapter": 39,
              "verse": 20,
              "name": "Job 39:20",
              "text": "Pinalulukso mo ba siya na parang balang? Ang kaluwalhatian ng kaniyang bahin ay kakilakilabot."
            },
            {
              "chapter": 39,
              "verse": 21,
              "name": "Job 39:21",
              "text": "Siya'y kumukutkot sa libis, at nagagalak sa kaniyang kalakasan, siya'y sumasagupa sa mga taong may sandata."
            },
            {
              "chapter": 39,
              "verse": 22,
              "name": "Job 39:22",
              "text": "Tinutuya niya ang takot at hindi nanglulupaypay: ni hindi tinatalikuran ang tabak."
            },
            {
              "chapter": 39,
              "verse": 23,
              "name": "Job 39:23",
              "text": "Ang suksukan ng pana ay tumutunog laban sa kaniya, ang makintab na sibat at ang kalasag."
            },
            {
              "chapter": 39,
              "verse": 24,
              "name": "Job 39:24",
              "text": "Kaniyang sinasakmal ang lupa na may kabangisan at poot; ni hindi siya naniniwala na yao'y tunog ng pakakak."
            },
            {
              "chapter": 39,
              "verse": 25,
              "name": "Job 39:25",
              "text": "Kaniyang sinasabi sa tuwing tutunog ang mga pakakak: Aha! At kaniyang naaamoy ang pagbabaka sa malayo, ang sigaw ng mga kapitan at ang hiyaw."
            },
            {
              "chapter": 39,
              "verse": 26,
              "name": "Job 39:26",
              "text": "Lumilipad ba ang uwak sa pamamagitan ng inyong karunungan, at iniuunat ba ang kaniyang mga pakpak sa dakong timugan?"
            },
            {
              "chapter": 39,
              "verse": 27,
              "name": "Job 39:27",
              "text": "Napaiilanglang ba ang agila sa iyong utos, at gumagawa ba ng kaniyang pugad sa itaas?"
            },
            {
              "chapter": 39,
              "verse": 28,
              "name": "Job 39:28",
              "text": "Sila'y nananahan sa malaking bato, at doon tumitira, sa taluktok ng burol at sa katibayan,"
            },
            {
              "chapter": 39,
              "verse": 29,
              "name": "Job 39:29",
              "text": "Mula roo'y tumitingin siya ng madadagit; ang kaniyang mga mata ay tumatanaw sa malayo."
            },
            {
              "chapter": 39,
              "verse": 30,
              "name": "Job 39:30",
              "text": "Ang mga anak naman niya ay nagsisihitit ng dugo: at kung saan naroon ang pinatay ay naroon siya."
            }
          ]
        },
        {
          "chapter": 40,
          "name": "Job 40",
          "verses": [
            {
              "chapter": 40,
              "verse": 1,
              "name": "Job 40:1",
              "text": "Bukod dito'y sumagot ang Panginoon kay Job, at nagsabi,"
            },
            {
              "chapter": 40,
              "verse": 2,
              "name": "Job 40:2",
              "text": "Magmamatapang ba siya na makipagtalo sa Makapangyarihan sa lahat? Siyang nakikipagkatuwiranan sa Dios, ay sagutin niya ito."
            },
            {
              "chapter": 40,
              "verse": 3,
              "name": "Job 40:3",
              "text": "Nang magkagayo'y sumagot si Job sa Panginoon, at nagsabi,"
            },
            {
              "chapter": 40,
              "verse": 4,
              "name": "Job 40:4",
              "text": "Narito, ako'y walang kabuluhan; anong isasagot ko sa iyo? Aking inilalagay ang aking kamay sa aking bibig,"
            },
            {
              "chapter": 40,
              "verse": 5,
              "name": "Job 40:5",
              "text": "Minsan ay nagsalita ako, at hindi ako sasagot: Oo, makalawa, nguni't hindi ako magpapatuloy."
            },
            {
              "chapter": 40,
              "verse": 6,
              "name": "Job 40:6",
              "text": "Nang magkagayo'y sumagot ang Panginoon kay Job mula sa ipoipo, at nagsabi,"
            },
            {
              "chapter": 40,
              "verse": 7,
              "name": "Job 40:7",
              "text": "Magbigkis ka ng iyong mga balakang ngayon na parang lalake: ako'y magtatanong sa iyo at magpahayag ka sa akin."
            },
            {
              "chapter": 40,
              "verse": 8,
              "name": "Job 40:8",
              "text": "Iyo bang wawaling kabuluhan ang aking kahatulan? Iyo bang hahatulan ako, upang ikaw ay ariing ganap?"
            },
            {
              "chapter": 40,
              "verse": 9,
              "name": "Job 40:9",
              "text": "O mayroon ka bang kamay na parang Dios? At makakukulog ka ba ng tinig na gaya niya?"
            },
            {
              "chapter": 40,
              "verse": 10,
              "name": "Job 40:10",
              "text": "Magpakagayak ka ngayon ng karilagan at karapatan; at magbihis ka ng karangalan at kalakhan."
            },
            {
              "chapter": 40,
              "verse": 11,
              "name": "Job 40:11",
              "text": "Ibugso mo ang mga alab ng iyong galit: at tunghan mo ang bawa't palalo, at abain mo siya."
            },
            {
              "chapter": 40,
              "verse": 12,
              "name": "Job 40:12",
              "text": "Masdan mo ang bawa't palalo, at papangumbabain mo siya; at iyong tungtungan ang masama sa kaniyang tayuan."
            },
            {
              "chapter": 40,
              "verse": 13,
              "name": "Job 40:13",
              "text": "Ikubli mo sila sa alabok na magkakasama; talian mo ang kanilang mukha sa lihim na dako."
            },
            {
              "chapter": 40,
              "verse": 14,
              "name": "Job 40:14",
              "text": "Kung magkagayo'y ipahayag naman kita; na maililigtas ka ng iyong kanan."
            },
            {
              "chapter": 40,
              "verse": 15,
              "name": "Job 40:15",
              "text": "Narito ngayon, ang hayop na behemot na aking ginawang kasama mo: siya'y kumakain ng damo na gaya ng baka."
            },
            {
              "chapter": 40,
              "verse": 16,
              "name": "Job 40:16",
              "text": "Narito, ngayon, ang kaniyang lakas ay nasa kaniyang mga balakang, at ang kaniyang kalakasan ay nasa kalamnan ng kaniyang tiyan."
            },
            {
              "chapter": 40,
              "verse": 17,
              "name": "Job 40:17",
              "text": "Kaniyang iginagalaw ang kaniyang buntot na parang isang cedro: ang mga litid ng kaniyang mga hita ay nangagkakasabiran."
            },
            {
              "chapter": 40,
              "verse": 18,
              "name": "Job 40:18",
              "text": "Ang kaniyang mga buto ay parang mga tubong tanso; ang kaniyang mga paa ay parang mga halang na bakal."
            },
            {
              "chapter": 40,
              "verse": 19,
              "name": "Job 40:19",
              "text": "Siya ang pinakapangulo sa mga daan ng Dios: ang lumalang sa kaniya, ang makapaglalapit lamang ng tabak sa kaniya."
            },
            {
              "chapter": 40,
              "verse": 20,
              "name": "Job 40:20",
              "text": "Tunay na ang mga bundok ay naglalabas sa kaniya ng pagkain; na pinaglalaruan ng lahat ng mga hayop sa parang."
            },
            {
              "chapter": 40,
              "verse": 21,
              "name": "Job 40:21",
              "text": "Siya'y humihiga sa ilalim ng punong loto, sa puwang ng mga tambo, at mga lumbak."
            },
            {
              "chapter": 40,
              "verse": 22,
              "name": "Job 40:22",
              "text": "Nilililiman siya ng mga puno ng loto ng kanilang lilim; nililigid sa palibot ng mga sauce sa batis."
            },
            {
              "chapter": 40,
              "verse": 23,
              "name": "Job 40:23",
              "text": "Narito, kung bumubugso ang isang ilog hindi nanginginig: siya'y tiwasay bagaman umapaw ang Jordan hanggang sa kaniyang bunganga."
            },
            {
              "chapter": 40,
              "verse": 24,
              "name": "Job 40:24",
              "text": "May kukuha ba sa kaniya pag siya'y natatanod, o may tutuhog ba ng kaniyang ilong sa pamamagitan ng isang silo."
            }
          ]
        },
        {
          "chapter": 41,
          "name": "Job 41",
          "verses": [
            {
              "chapter": 41,
              "verse": 1,
              "name": "Job 41:1",
              "text": "Mahuhuli mo ba ang buwaya ng isang bingwit? O mailalabas mo ba ang kaniyang dila ng isang panali?"
            },
            {
              "chapter": 41,
              "verse": 2,
              "name": "Job 41:2",
              "text": "Makapaglalagay ka ba ng tali sa kaniyang ilong? O makabubutas sa kaniyang panga ng isang taga ng bingwit?"
            },
            {
              "chapter": 41,
              "verse": 3,
              "name": "Job 41:3",
              "text": "Mamamanhik ba siya ng marami sa iyo? O magsasalita ba siya ng mga malumanay na salita sa iyo?"
            },
            {
              "chapter": 41,
              "verse": 4,
              "name": "Job 41:4",
              "text": "Makikipagtipan ba siya sa iyo, upang ariin mo siyang alipin magpakailan man?"
            },
            {
              "chapter": 41,
              "verse": 5,
              "name": "Job 41:5",
              "text": "Makikipaglaro ka ba sa kaniya na gaya sa isang ibon? O iyong tatalian ba siya para sa iyong mga dalaga?"
            },
            {
              "chapter": 41,
              "verse": 6,
              "name": "Job 41:6",
              "text": "Makakalakal ba siya ng mga pulutong ng mangingisda? Mababahagi ba siya nila sa mga mangangalakal?"
            },
            {
              "chapter": 41,
              "verse": 7,
              "name": "Job 41:7",
              "text": "Mahihiwa mo ba ang kaniyang balat ng sundang na bakal, o ang kaniyang ulo ng panaksak ng isda?"
            },
            {
              "chapter": 41,
              "verse": 8,
              "name": "Job 41:8",
              "text": "Ipatong mo ang iyong kamay sa kaniya; alalahanin mo ang pagbabaka at huwag mo nang gawin."
            },
            {
              "chapter": 41,
              "verse": 9,
              "name": "Job 41:9",
              "text": "Narito, ang pagasa riyan ay walang kabuluhan: hindi ba malulugmok ang sinoman makita lamang yaon?"
            },
            {
              "chapter": 41,
              "verse": 10,
              "name": "Job 41:10",
              "text": "Walang malakas na makapangahas kumilos niyaon: sino ngang makatatayo sa harap ko?"
            },
            {
              "chapter": 41,
              "verse": 11,
              "name": "Job 41:11",
              "text": "Sinong naunang nagbigay sa akin upang aking bayaran siya? Anomang nasa silong ng buong langit ay akin."
            },
            {
              "chapter": 41,
              "verse": 12,
              "name": "Job 41:12",
              "text": "Hindi ako tatahimik tungkol sa kaniyang mga sangkap ng katawan, ni sa kaniya mang dakilang kapangyarihan, ni sa kaniya mang mainam na hugis."
            },
            {
              "chapter": 41,
              "verse": 13,
              "name": "Job 41:13",
              "text": "Sinong makapaglilitaw na karayagan ng kaniyang mga damit? Sinong makalalapit sa kaniyang magkasaping pangil?"
            },
            {
              "chapter": 41,
              "verse": 14,
              "name": "Job 41:14",
              "text": "Sinong makapagbubukas ng mga pinto ng kaniyang mukha? Sa palibot ng kaniyang ngipin ay kakilabutan."
            },
            {
              "chapter": 41,
              "verse": 15,
              "name": "Job 41:15",
              "text": "Ang kaniyang mga matibay na palikpik ay kaniyang kapalaluan, nangagkakadikit na maigi na gaya sa isang tatak na mahigpit."
            },
            {
              "chapter": 41,
              "verse": 16,
              "name": "Job 41:16",
              "text": "Nagkakadikit sa isa't isa, na ang hangin ay hindi makaraan sa pagitan sa mga yaon."
            },
            {
              "chapter": 41,
              "verse": 17,
              "name": "Job 41:17",
              "text": "Sila'y nagkakasugpongan sa isa't isa; Nagkakalakip na magkasama, na hindi maihihiwalay."
            },
            {
              "chapter": 41,
              "verse": 18,
              "name": "Job 41:18",
              "text": "Ang kanilang mga bahin ay kumikislap ng apoy, at ang kanilang mga mata ay gaya ng mga bukang liwayway kung umaga."
            },
            {
              "chapter": 41,
              "verse": 19,
              "name": "Job 41:19",
              "text": "Mula sa kaniyang bibig ay lumalabas ang nagliliyab na sulo, at mga alipatong apoy ay nagsisilabas."
            },
            {
              "chapter": 41,
              "verse": 20,
              "name": "Job 41:20",
              "text": "Mula sa kaniyang mga butas ng ilong ay lumalabas ang usok, na gaya ng isang kumukulong talyasi at nagniningas na mga talahib."
            },
            {
              "chapter": 41,
              "verse": 21,
              "name": "Job 41:21",
              "text": "Ang kaniyang hinga ay nagpapaningas ng mga baga, at isang alab ay lumalabas sa kaniyang bibig."
            },
            {
              "chapter": 41,
              "verse": 22,
              "name": "Job 41:22",
              "text": "Sa kaniyang leeg ay tumitira ang kalakasan, at ang kakilabutan ay sumasayaw sa harap niya."
            },
            {
              "chapter": 41,
              "verse": 23,
              "name": "Job 41:23",
              "text": "Ang mga kaliskis ng kaniyang laman ay nangagkakadikitan; nangagtutumibay sa kaniya; hindi magagalaw."
            },
            {
              "chapter": 41,
              "verse": 24,
              "name": "Job 41:24",
              "text": "Ang kaniyang puso ay matatag na gaya ng isang bato; Oo, matatag na gaya ng batong pangibaba ng gilingan."
            },
            {
              "chapter": 41,
              "verse": 25,
              "name": "Job 41:25",
              "text": "Pagka siya'y tumitindig ay natatakot ang makapangyarihan: dahil sa pagkagulat ay nangalilito sila."
            },
            {
              "chapter": 41,
              "verse": 26,
              "name": "Job 41:26",
              "text": "Kung siya'y tagain ninoman ng tabak ay hindi tumatalab; ni ng sibat man, ng pana, ni ng matalas na tulis man."
            },
            {
              "chapter": 41,
              "verse": 27,
              "name": "Job 41:27",
              "text": "Kaniyang ipinalalagay ang bakal na parang dayami, at ang tanso na parang lapok na kahoy."
            },
            {
              "chapter": 41,
              "verse": 28,
              "name": "Job 41:28",
              "text": "Hindi niya mapatakas ng palaso: ang mga batong panghilagpos ay nagiging sa kaniya'y parang pinagputulan ng trigo."
            },
            {
              "chapter": 41,
              "verse": 29,
              "name": "Job 41:29",
              "text": "Ang mga panakbat ay nangapapalagay na parang pinagputulan ng trigo: kaniyang tinatawanan ang galaw ng sibat."
            },
            {
              "chapter": 41,
              "verse": 30,
              "name": "Job 41:30",
              "text": "Ang kaniyang mga sangkap sa ibaba ay gaya ng mga matulis na bibinga: lumalaganap na tila saksak sa banlik."
            },
            {
              "chapter": 41,
              "verse": 31,
              "name": "Job 41:31",
              "text": "Kaniyang pinagpapakuluan ang kalaliman na parang palyok: kaniyang ginagawa ang dagat na parang pamahid."
            },
            {
              "chapter": 41,
              "verse": 32,
              "name": "Job 41:32",
              "text": "Kaniyang pinasisilang ang landas sa likuran niya; aakalain ng sinoman na mauban ang kalaliman."
            },
            {
              "chapter": 41,
              "verse": 33,
              "name": "Job 41:33",
              "text": "Sa ibabaw ng lupa ay walang gaya niya, na likhang walang takot."
            },
            {
              "chapter": 41,
              "verse": 34,
              "name": "Job 41:34",
              "text": "Kaniyang minamasdan ang bawa't mataas na bagay: siya'y hari sa lahat ng mga anak na palalo."
            }
          ]
        },
        {
          "chapter": 42,
          "name": "Job 42",
          "verses": [
            {
              "chapter": 42,
              "verse": 1,
              "name": "Job 42:1",
              "text": "Nang magkagayo'y sumagot si Job sa Panginoon, at nagsabi,"
            },
            {
              "chapter": 42,
              "verse": 2,
              "name": "Job 42:2",
              "text": "Nalalaman ko na magagawa mo ang lahat ng mga bagay, at wala kang akala na mapipigil."
            },
            {
              "chapter": 42,
              "verse": 3,
              "name": "Job 42:3",
              "text": "Sino itong nagkukubli ng payo na walang kaalaman? Kaya't aking sinambit na hindi ko nauunawa, mga bagay na totoong kagilagilalas sa akin na hindi ko nalalaman."
            },
            {
              "chapter": 42,
              "verse": 4,
              "name": "Job 42:4",
              "text": "Dinggin mo, isinasamo ko sa iyo, at ako'y magsasalita; ako'y magtatanong sa iyo, at magpahayag ka sa akin."
            },
            {
              "chapter": 42,
              "verse": 5,
              "name": "Job 42:5",
              "text": "Narinig kita sa pakikinig ng pakinig; nguni't ngayo'y nakikita ka ng aking mata,"
            },
            {
              "chapter": 42,
              "verse": 6,
              "name": "Job 42:6",
              "text": "Kaya't ako'y nayayamot sa sarili, at nagsisisi ako sa alabok at mga abo."
            },
            {
              "chapter": 42,
              "verse": 7,
              "name": "Job 42:7",
              "text": "At nangyari, na pagkatapos na masalita ng Panginoon ang mga salitang ito kay Job, sinabi ng Panginoon kay Eliphaz na Temanita, Ang aking poot ay nagaalab laban sa iyo, at laban sa iyong dalawang kaibigan: sapagka't hindi kayo nangagsalita tungkol sa akin ng bagay na matuwid, na gaya ng ginawa ng aking lingkod na si Job."
            },
            {
              "chapter": 42,
              "verse": 8,
              "name": "Job 42:8",
              "text": "Kaya't magsikuha kayo sa inyo ngayon ng pitong guyang baka, at pitong lalaking tupa, at magsiparoon kayo sa aking lingkod na kay Job, at ihandog ninyo sa ganang inyo na pinakahandog na susunugin: at idadalangin kayo ng aking lingkod na si Job: sapagka't siya'y aking tatanggapin, baka kayo'y aking gawan ng ayon sa inyong kamangmangan; sapagka't hindi kayo nangagsasalita tungkol sa akin ng bagay na matuwid, na gaya ng aking lingkod na si Job."
            },
            {
              "chapter": 42,
              "verse": 9,
              "name": "Job 42:9",
              "text": "Sa gayo'y nagsiyaon si Eliphaz na Temanita, at si Bildad na Suhita, at si Sophar na Naamatita, at ginawa ang ayon sa iniutos sa kanila ng Panginoon: at nilingap ng Panginoon si Job."
            },
            {
              "chapter": 42,
              "verse": 10,
              "name": "Job 42:10",
              "text": "At inalis ng Panginoon ang pagkabihag ni Job, nang kaniyang idalangin ang kaniyang mga kaibigan; at binigyan ng Panginoon si Job na makalawa ang higit ng dami kay sa tinatangkilik niya ng dati."
            },
            {
              "chapter": 42,
              "verse": 11,
              "name": "Job 42:11",
              "text": "Nang magkagayo'y nagsiparoon sa kaniya ang lahat niyang mga kapatid na lalake at babae, at lahat na naging kakilala niya ng una, at nagsikain ng tinapay na kasalo niya sa kaniyang bahay; at nakipagdamdam sa kaniya, at inaliw siya tungkol sa lahat na kasamaan na pinasapit sa kaniya ng Panginoon: bawa't tao nama'y nagbigay sa kaniya ng isang putol na salapi, at bawa't isa'y ng isang singsing na ginto."
            },
            {
              "chapter": 42,
              "verse": 12,
              "name": "Job 42:12",
              "text": "Sa gayo'y pinagpala ng Panginoon, ang huling wakas ni Job na higit kay sa kaniyang pasimula: at siya'y nagkaroon ng labing apat na libong tupa, at anim na libong kamelyo, at isang libong tuwang na baka, at isang libong asnong babae."
            },
            {
              "chapter": 42,
              "verse": 13,
              "name": "Job 42:13",
              "text": "Siya nama'y nagkaroon din ng pitong anak na lalake at tatlong anak na babae."
            },
            {
              "chapter": 42,
              "verse": 14,
              "name": "Job 42:14",
              "text": "At tinawag niya ang pangalan ng una na Jemima; at ang pangalan ng ikalawa, Cesiah, at ang pangalan ng ikatlo, Keren-hapuch."
            },
            {
              "chapter": 42,
              "verse": 15,
              "name": "Job 42:15",
              "text": "At sa buong lupain ay walang mga babaing masumpungan na totoong maganda na gaya ng mga anak na babae ni Job: at binigyan sila ng kanilang ama ng mana sa kasamahan ng kanilang mga kapatid."
            },
            {
              "chapter": 42,
              "verse": 16,
              "name": "Job 42:16",
              "text": "At pagkatapos nito'y nabuhay si Job na isang daan at apat na pung taon, at nakita niya ang kaniyang mga anak, at ang mga anak ng kaniyang mga anak, hanggang sa apat na saling lahi."
            },
            {
              "chapter": 42,
              "verse": 17,
              "name": "Job 42:17",
              "text": "Gayon namatay si Job, na matanda at puspos ng mga kaarawan."
            }
          ]
        }
      ]
    },
    {
      "nr": 19,
      "name": "Mga Awit",
      "chapters": [
        {
          "chapter": 1,
          "name": "Mga Awit 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Mga Awit 1:1",
              "text": "Mapalad ang tao na hindi lumalakad sa payo ng masama, ni tumatayo man sa daan ng mga makasalanan, ni nauupo man sa upuan ng mga manglilibak."
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Mga Awit 1:2",
              "text": "Kundi ang kaniyang kasayahan ay nasa kautusan ng Panginoon; at sa kautusan niya nagbubulaybulay siya araw at gabi."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Mga Awit 1:3",
              "text": "At siya'y magiging parang punong kahoy na itinanim sa siping ng mga agos ng tubig, na nagbubunga sa kaniyang kapanahunan, ang kaniyang dahon nama'y hindi malalanta; at anumang kaniyang gawin ay giginhawa."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Mga Awit 1:4",
              "text": "Ang masama ay hindi gayon; kundi parang ipa na itinataboy ng hangin."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Mga Awit 1:5",
              "text": "Kaya't ang masama ay hindi tatayo sa paghatol, ni ang mga makasalanan man sa kapisanan ng mga matuwid."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Mga Awit 1:6",
              "text": "Sapagka't nalalaman ng Panginoon ang lakad ng mga matuwid: nguni't ang lakad ng masama ay mapapahamak."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Mga Awit 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Mga Awit 2:1",
              "text": "Bakit ang mga bansa ay nangagugulo, at ang mga bayan ay nangagaakala ng walang kabuluhang bagay?"
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Mga Awit 2:2",
              "text": "Ang mga hari sa lupa ay nagsisihanda, at ang mga pinuno ay nagsasanggunian, Laban sa Panginoon at laban sa kaniyang pinahiran ng langis, na sinasabi:"
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Mga Awit 2:3",
              "text": "Lagutin natin ang kanilang tali, at ating iwaksi ang kanilang mga panali sa atin."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Mga Awit 2:4",
              "text": "Siyang nauupo sa kalangitan ay tatawa: ilalagay sila ng Panginoon sa kakutyaan."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Mga Awit 2:5",
              "text": "Kung magkagayo'y magsasalita siya sa kanila sa kaniyang poot, at babagabagin sila sa kaniyang malabis na sama ng loob:"
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Mga Awit 2:6",
              "text": "Gayon ma'y inilagay ko ang aking hari sa aking banal na bundok ng Sion."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Mga Awit 2:7",
              "text": "Aking sasaysayin ang tungkol sa pasiya: sinabi ng Panginoon sa akin, Ikaw ay aking anak; sa araw na ito ay ipinanganak kita."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Mga Awit 2:8",
              "text": "Humingi ka sa akin, at ibibigay ko sa iyo ang mga bansa na iyong pinakamana, at ang mga pinakadulong bahagi ng lupa ay iyong pinakaari."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Mga Awit 2:9",
              "text": "Sila'y iyong babaliin ng isang pamalong bakal; iyong dudurugin sila na parang isang sisidlan ng magpapalyok."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Mga Awit 2:10",
              "text": "Ngayon nga'y magpakapantas kayo, Oh kayong mga hari: mangatuto kayo, kayong mga hukom sa lupa."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Mga Awit 2:11",
              "text": "Kayo'y mangaglingkod sa Panginoon na may takot, at mangagalak na may panginginig."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Mga Awit 2:12",
              "text": "Hagkan ninyo ang anak, baka magalit siya, at kayo'y mangapahamak sa daan, sapagka't ang kaniyang poot ay madaling magalab. Mapapalad ang nanganganlong sa kaniya."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Mga Awit 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Mga Awit 3:1",
              "text": "Panginoon, ano't ang aking mga kaaway ay nagsisidami! Marami sila na nagsisibangon laban sa akin."
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Mga Awit 3:2",
              "text": "Marami ang nagsasabi sa aking kaluluwa: walang tulong sa kaniya ang Dios. (Selah)"
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Mga Awit 3:3",
              "text": "Nguni't ikaw, Oh Panginoon ay isang kalasag sa palibot ko: aking kaluwalhatian; at siyang tagapagtaas ng aking ulo."
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Mga Awit 3:4",
              "text": "Ako'y dumadaing ng aking tinig sa Panginoon, at sinasagot niya ako mula sa kaniyang banal na bundok. (Selah)"
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Mga Awit 3:5",
              "text": "Ako'y nahiga, at natulog; ako'y nagising; sapagka't inaalalayan ako ng Panginoon."
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Mga Awit 3:6",
              "text": "Ako'y hindi matatakot sa sangpung libo ng bayan, na nagsihanda laban sa akin sa buong palibot."
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Mga Awit 3:7",
              "text": "Bumangon ka, Oh Panginoon; iligtas mo ako, Oh aking Dios: sapagka't iyong sinampal ang lahat ng aking mga kaaway; iyong binungal ang mga ngipin ng masasama."
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Mga Awit 3:8",
              "text": "Pagliligtas ay ukol sa Panginoon: sumaiyong bayan nawa ang iyong pagpapala. (Selah)"
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Mga Awit 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Mga Awit 4:1",
              "text": "Sagutin mo ako, pagka tumatawag ako, Oh Dios ng aking katuwiran; inilagay mo ako sa kaluwagan, nang ako'y nasa kagipitan: maawa ka sa akin, at dinggin mo ang aking dalangin."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Mga Awit 4:2",
              "text": "Oh kayong mga anak ng tao, hanggang kailan magiging kasiraang puri ang aking kaluwalhatian? Gaano katagal iibigin ninyo ang walang kabuluhan, at hahanap sa kabulaanan? (Selah)"
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Mga Awit 4:3",
              "text": "Nguni't talastasin ninyo na ibinukod ng Panginoon sa ganang kaniyang sarili ang banal: didinggin ng Panginoon pagka ako'y tumawag sa kaniya."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Mga Awit 4:4",
              "text": "Kayo'y magsipanginig, at huwag mangagkasala: mangagbulaybulay kayo ng inyong puso sa inyong higaan, at kayo'y magsitahimik."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Mga Awit 4:5",
              "text": "Mangaghandog kayo ng mga hain ng katuwiran, at ilagak ninyo ang inyong tiwala sa Panginoon."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Mga Awit 4:6",
              "text": "Marami ang mangagsasabi, sinong magpapakita sa amin ng mabuti? Panginoon, pasilangin mo ang liwanag ng iyong mukha sa amin."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Mga Awit 4:7",
              "text": "Ikaw ay naglagay ng kasayahan sa aking puso, ng higit kay sa kanilang tinatangkilik nang ang kanilang butil, at kanilang alak ay magsidami."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Mga Awit 4:8",
              "text": "Payapa akong hihiga at gayon din matutulog: sapagka't ikaw, Panginoon, pinatatahan mo akong mag-isa sa katiwasayan."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Mga Awit 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Mga Awit 5:1",
              "text": "Pakinggan mo ang aking mga salita, Oh Panginoon, pakundanganan mo ang aking pagbubulaybulay."
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Mga Awit 5:2",
              "text": "Dinggin mo ang tinig ng aking daing, Hari ko, at Dios ko; sapagka't sa iyo'y dumadalangin ako."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Mga Awit 5:3",
              "text": "Oh Panginoon, sa kinaumagaha'y didinggin mo ang aking tinig; sa kinaumagahan ay aayusin ko ang aking dalangin sa iyo, at magbabantay ako."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Mga Awit 5:4",
              "text": "Sapagka't ikaw ay di isang Dios na may kaluguran sa kasamaan: ang masama ay hindi tatahang kasama mo."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Mga Awit 5:5",
              "text": "Ang hambog ay hindi tatayo sa iyong paningin: iyong kinapopootan ang lahat na mga manggagawa ng kalikuan."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Mga Awit 5:6",
              "text": "Iyong lilipulin sila na nangagsasalita ng mga kabulaanan: kinayayamutan ng Panginoon ang taong mabangis at magdaraya,"
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Mga Awit 5:7",
              "text": "Nguni't sa ganang akin, sa kasaganaan ng iyong kagandahang-loob ay papasok ako sa iyong bahay; sa takot sa iyo ay sasamba ako sa dako ng iyong banal na templo."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Mga Awit 5:8",
              "text": "Patnubayan mo ako, Oh Panginoon, sa iyong katuwiran dahil sa aking mga kaaway; patagin mo ang iyong daan sa harapan ko."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Mga Awit 5:9",
              "text": "Sapagka't walang pagtatapat sa kanilang bibig; ang kanilang kalooban ay tunay na kasamaan; ang kanilang lalamunan ay bukas na libingan; sila'y nanganunuya ng kanilang dila."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Mga Awit 5:10",
              "text": "Bigyan mong sala sila, Oh Dios; ibuwal mo sila sa kanilang sariling mga payo: palayasin mo sila sa karamihan ng kanilang mga pagsalangsang; Sapagka't sila'y nanganghimagsik laban sa iyo,"
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Mga Awit 5:11",
              "text": "Nguni't iyong pagalakin ang lahat na nagsisipagkanlong sa iyo, pahiyawin mo nawa sila sa kagalakan magpakailan man, sapagka't iyong ipinagsasanggalang sila: mangagalak nawa rin sa iyo ang nagsisiibig ng iyong pangalan."
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Mga Awit 5:12",
              "text": "Sapagka't iyong pagpapalain ang matuwid; Oh Panginoon, lilibirin mo siya ng paglingap na gaya ng isang kalasag."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Mga Awit 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Mga Awit 6:1",
              "text": "Oh Panginoon, huwag mo akong sawayin sa iyong galit, ni parusahan mo man ako sa iyong mahigpit na sama ng loob."
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Mga Awit 6:2",
              "text": "Maawa ka sa akin, Oh Panginoon; sapagka't ako'y naluluoy, Oh Panginoon, pagalingin mo ako; sapagka't ang aking mga buto ay nagsisipangalog."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Mga Awit 6:3",
              "text": "Ang akin ding kaluluwa ay nababagabag na mainam: at ikaw, Oh Panginoon, hanggang kailan?"
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Mga Awit 6:4",
              "text": "Bumalik ka, Oh Panginoon, palayain mo ang aking kaluluwa: iligtas mo ako alangalang sa iyong kagandahang-loob."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Mga Awit 6:5",
              "text": "Sapagka't sa kamatayan ay walang alaala sa iyo; sa Sheol ay sinong mangagpapasalamat sa iyo?"
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Mga Awit 6:6",
              "text": "Ako'y pagal ng aking pagdaing; gabigabi ay aking pinalalangoy ang aking higaan; Aking dinidilig ang aking hiligan ng aking mga luha."
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Mga Awit 6:7",
              "text": "Ang aking mga mata ay nangamumugto dahil sa kapanglawan; tumatanda ako dahil sa aking lahat na kaaway."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Mga Awit 6:8",
              "text": "Magsilayo kayo sa akin, kayong lahat na manggagawa ng kasamaan: sapagka't narinig ng Panginoon ang tinig ng aking pagtangis."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Mga Awit 6:9",
              "text": "Narinig ng Panginoon ang aking pananaing; tatanggapin ng Panginoon ang aking dalangin."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Mga Awit 6:10",
              "text": "Lahat ng kaaway ko'y mapapahiya, at mababagabag na mainam: sila'y magsisibalik, sila'y mangapapahiyang kagyat."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Mga Awit 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Mga Awit 7:1",
              "text": "Oh Panginoon kong Dios, sa iyo nanganganlong ako. Iligtas mo ako sa lahat na nagsisihabol sa akin, at palayain mo ako:"
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Mga Awit 7:2",
              "text": "Baka lurayin nila na gaya ng leon ang aking kaluluwa, na lurayin ito, habang walang magligtas."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Mga Awit 7:3",
              "text": "Oh Panginoon kong Dios, kung ginawa ko ito; kung may kasamaan sa aking mga kamay;"
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Mga Awit 7:4",
              "text": "Kung ako'y gumanti ng kasamaan sa kaniya na may kapayapaan sa akin; (Oo, aking pinawalan siya, na walang anomang kadahilanan ay naging aking kaaway:)"
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Mga Awit 7:5",
              "text": "Habulin ng kaaway ang aking kaluluwa, at abutan; Oo, yapakan niya ang aking kaluluwa sa lupa, at ilagay ang aking kaluwalhatian sa alabok. (Selah)"
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Mga Awit 7:6",
              "text": "Ikaw ay bumangon, Oh Panginoon, sa iyong galit, magpakataas ka laban sa poot ng aking mga kaaway; at gumising ka dahil sa akin; ikaw ay nagutos ng kahatulan."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Mga Awit 7:7",
              "text": "At ligirin ka ng kapisanan ng mga bayan sa palibot: at sila'y pihitan mong nasa mataas ka."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Mga Awit 7:8",
              "text": "Ang panginoo'y nangangasiwa ng kahatulan sa mga bayan: iyong hatulan ako, Oh Panginoon, ayon sa aking katuwiran, at sa aking pagtatapat na nasa akin."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Mga Awit 7:9",
              "text": "Oh wakasan ang kasamaan ng masama, nguni't itatag mo ang matuwid; sapagka't sinubok ng matuwid na Dios ang mga pagiisip at ang mga puso."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Mga Awit 7:10",
              "text": "Ang aking kalasag ay sa Dios. na nagliligtas ng matuwid sa puso."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Mga Awit 7:11",
              "text": "Ang Dios ay matuwid na hukom, Oo, Dios na may galit araw-araw."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Mga Awit 7:12",
              "text": "Kung ang tao ay hindi magbalik-loob, kaniyang ihahasa ang kaniyang tabak; kaniyang iniakma ang kaniyang busog, at inihanda."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Mga Awit 7:13",
              "text": "Inihanda rin naman niya ang mga kasangkapan ng kamatayan; kaniyang pinapagniningas ang kaniyang mga pana."
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Mga Awit 7:14",
              "text": "Narito, siya'y nagdaramdam ng kasamaan; Oo, siya'y naglihi ng kasamaan, at nanganak ng kabulaanan."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Mga Awit 7:15",
              "text": "Siya'y gumawa ng balon, at hinukay, at nahulog sa hukay na kaniyang ginawa."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Mga Awit 7:16",
              "text": "Ang kaniyang gawang masama ay magbabalik sa kaniyang sariling ulo, at ang kaniyang pangdadahas ay babagsak sa kaniyang sariling bunbunan."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Mga Awit 7:17",
              "text": "Ako'y magpapasalamat sa Panginoon, ayon sa kaniyang katuwiran: at aawit ng pagpupuri sa pangalan ng Panginoon na Kataastaasan."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Mga Awit 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Mga Awit 8:1",
              "text": "Oh Panginoon, aming Panginoon, pagkarilag ng iyong pangalan sa buong lupa! na siyang naglagay ng inyong kaluwalhatian sa mga langit."
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Mga Awit 8:2",
              "text": "Mula sa bibig ng mga sanggol at ng mga sumususo ay iyong itinatag ang kalakasan, dahil sa iyong mga kaaway, upang iyong patahimikin ang kaaway at ang manghihiganti."
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Mga Awit 8:3",
              "text": "Pagka binubulay ko ang iyong mga langit, ang gawa ng iyong mga daliri, ang buwan at ang mga bituin na iyong inayos;"
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Mga Awit 8:4",
              "text": "Ano ang tao upang iyong alalahanin siya? At ang anak ng tao, upang iyong dalawin siya?"
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Mga Awit 8:5",
              "text": "Sapagka't iyong ginawa siyang kaunting mababa lamang kay sa Dios, at pinaputungan mo siya ng kaluwalhatian at karangalan."
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Mga Awit 8:6",
              "text": "Iyong pinapagtataglay siya ng kapangyarihan sa mga gawa ng iyong mga kamay; iyong inilagay ang lahat ng mga bagay sa ilalim ng kaniyang mga paa:"
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Mga Awit 8:7",
              "text": "Lahat na tupa at baka, Oo, at ang mga hayop sa parang;"
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Mga Awit 8:8",
              "text": "Ang mga ibon sa himpapawid, at ang mga isda sa dagat, anomang nagdaraan sa mga kalaliman ng mga dagat."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Mga Awit 8:9",
              "text": "Oh Panginoon, aming Panginoon, pagkarilag ng iyong pangalan sa buong lupa!"
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Mga Awit 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Mga Awit 9:1",
              "text": "Ako'y magpapasalamat sa Panginoon ng aking buong puso; aking ipakikilala ang lahat na iyong kagilagilalas na mga gawa."
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Mga Awit 9:2",
              "text": "Ako'y magpapakasaya at magpapakagalak sa iyo: ako'y aawit ng pagpuri sa iyong pangalan, Oh ikaw na kataastaasan."
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Mga Awit 9:3",
              "text": "Pagka ang aking mga kaaway ay magsisibalik, sila'y matitisod at malilipol sa iyong harapan."
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Mga Awit 9:4",
              "text": "Sapagka't iyong inalalayan ang aking matuwid at ang aking usap; ikaw ay nauupo sa luklukan na humahatol na may katuwiran."
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Mga Awit 9:5",
              "text": "Iyong sinaway ang mga bansa, iyong nilipol ang masama, iyong pinawi ang kanilang pangalan magpakailan man."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Mga Awit 9:6",
              "text": "Ang kaaway ay dumating sa wakas, sila'y lipol magpakailan man; at ang mga siyudad na iyong dinaig, ang tanging alaala sa kanila ay napawi."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Mga Awit 9:7",
              "text": "Nguni't ang Panginoon ay nauupong hari magpakailan man: inihanda niya ang kaniyang luklukan para sa kahatulan."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Mga Awit 9:8",
              "text": "At hahatulan niya sa katuwiran ang sanglibutan, siya'y mangangasiwa ng karampatang kahatulan sa mga tao."
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Mga Awit 9:9",
              "text": "Ang Panginoon naman ay magiging matayog na moog sa napipighati, matayog na moog sa mga panahon ng kabagabagan;"
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Mga Awit 9:10",
              "text": "At silang nangakakaalam ng iyong pangalan ay maglalagak ng kanilang tiwala sa iyo; sapagka't ikaw, Panginoon, ay hindi mo pinabayaan sila na nagsisihanap sa iyo."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Mga Awit 9:11",
              "text": "Magsiawit kayo ng mga pagpuri sa Panginoon, na nagsisitahan sa Sion: ipahayag ninyo sa gitna ng bayan ang kaniyang mga gawa."
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Mga Awit 9:12",
              "text": "Sapagka't siyang nagsisiyasat ng dugo ay umaalaala sa kanila: hindi niya kinalilimutan ang daing ng dukha."
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Mga Awit 9:13",
              "text": "Maawa ka sa akin, Oh Panginoon; masdan mo ang kadalamhatian na aking tinitiis sa kanila na mangagtatanim sa akin, ikaw na nagtataas sa akin mula sa mga pintuan ng kamatayan;"
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Mga Awit 9:14",
              "text": "Upang aking maipakilala ang iyong buong kapurihan: sa mga pintuang-bayan ng anak na babae ng Sion, ako'y magagalak sa iyong pagliligtas."
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Mga Awit 9:15",
              "text": "Ang mga bansa ay nangahulog sa balon na kanilang ginawa: sa silo na kanilang ikinubli ay kanilang sariling paa ang nahuli."
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Mga Awit 9:16",
              "text": "Ang Panginoon ay napakilala, siya'y naglapat ng kahatulan: ang masama ay nasilo sa mga gawa ng kaniyang sariling mga kamay. (Higgaion. Selah)"
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Mga Awit 9:17",
              "text": "Ang masama ay mauuwi sa Sheol, pati ng lahat ng mga bansa na nagsisilimot sa Dios."
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Mga Awit 9:18",
              "text": "Sapagka't ang mapagkailangan ay hindi laging malilimutan, ni ang pagasa ng dukha ay mapapawi magpakailan man."
            },
            {
              "chapter": 9,
              "verse": 19,
              "name": "Mga Awit 9:19",
              "text": "Bumangon ka, Oh Panginoon; huwag manaig ang tao: mahatulan ang mga bansa sa iyong paningin."
            },
            {
              "chapter": 9,
              "verse": 20,
              "name": "Mga Awit 9:20",
              "text": "Ilagay mo sila sa katakutan Oh, Panginoon: ipakilala mo sa mga bansa na sila'y mga tao lamang. (Selah)"
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Mga Awit 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Mga Awit 10:1",
              "text": "Bakit ka tumatayong malayo, Oh Panginoon? Bakit ka nagtatago sa mga panahon ng kabagabagan?"
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Mga Awit 10:2",
              "text": "Sa kapalaluan ng masama ang dukha ay hinahabol na mainam; mahuli nawa sila sa mga lalang na kanilang inakala."
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Mga Awit 10:3",
              "text": "Sapagka't ang masama ay nagmamalaki sa nais ng kaniyang puso, at ang mapagimbot ay nagtatakuwil, oo, nagwawalang kabuluhan sa Panginoon."
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Mga Awit 10:4",
              "text": "Ang masama, sa kapalaluan ng kaniyang mukha, ay nagsasabi, hindi niya sisiyasatin. Lahat niyang pagiisip ay, walang Dios."
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Mga Awit 10:5",
              "text": "Ang kaniyang mga lakad ay panatag sa lahat ng panahon; ang iyong mga kahatulan ay malayong totoo sa kaniyang paningin: tungkol sa lahat niyang mga kaaway, tinutuya niya sila."
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Mga Awit 10:6",
              "text": "Sinasabi niya sa kaniyang puso, Hindi ako makikilos: sa lahat ng sali't saling lahi ay hindi ako malalagay sa karalitaan."
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Mga Awit 10:7",
              "text": "Ang kaniyang bibig ay puno ng panunungayaw, at pagdaraya, at pang-aapi: sa ilalim ng kaniyang dila ay kalikuan at kasamaan."
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Mga Awit 10:8",
              "text": "Siya'y nauupo sa mga pinakasulok na dako ng mga nayon: sa mga kubling dako ay pinapatay niya ang walang sala; ang kaniyang mga mata ay natititig laban sa walang nagkakandili."
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Mga Awit 10:9",
              "text": "Siya'y bumabakay sa kubli, na parang leon sa kaniyang lungga: siya'y nagaabang upang hulihin ang dukha: hinuhuli niya ang dukha, pagka kaniyang dinadala siya sa silo niya."
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Mga Awit 10:10",
              "text": "Siya'y naninibasib, siya'y nagpapakaliit, at ang mga walang nagkakandili ay nangahuhulog sa kaniyang mga malakas."
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Mga Awit 10:11",
              "text": "Sinasabi niya sa kaniyang puso: ang Dios ay nakalimot: kaniyang ikinukubli ang kaniyang mukha, hindi na niya makikita kailan man."
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Mga Awit 10:12",
              "text": "Bumangon ka, Oh Panginoon, Oh Dios, itaas mo ang iyong kamay: huwag mong kalimutan ang dukha."
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Mga Awit 10:13",
              "text": "Bakit sinusumpa ng masama ang Dios, at nagsasabi sa kaniyang puso: hindi mo sisiyasatin?"
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Mga Awit 10:14",
              "text": "Iyong nakita; sapagka't iyong minamasdan ang pahirap at pangduduwahagi upang mapasa iyong kamay: ang walang nagkakandili ay napakukupkop sa iyo; ikaw ay naging tagakandili sa ulila."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Mga Awit 10:15",
              "text": "Baliin mo ang bisig ng masama: at tungkol sa masamang tao, pag-usigin mo ang kaniyang kasamaan hanggang sa wala ka nang masumpungan."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Mga Awit 10:16",
              "text": "Ang Panginoon ay Hari magpakailan-kailan man. Ang mga bansa ay nalilipol sa kaniyang lupain."
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Mga Awit 10:17",
              "text": "Panginoon, iyong narinig ang nasa ng mga maamo: iyong ihahanda ang kanilang puso, iyong pakikinggan ng iyong pakinig:"
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Mga Awit 10:18",
              "text": "Upang hatulan ang ulila at ang napipighati, upang huwag nang makapangilabot ang tao na taga lupa."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Mga Awit 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Mga Awit 11:1",
              "text": "Sa Panginoon ay nanganganlong ako: ano't inyong sinasabi sa aking kaluluwa, tumakas ka na gaya ng isang ibon sa iyong bundok?"
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Mga Awit 11:2",
              "text": "Sapagka't, narito, binalantok ng masama ang busog, kanilang inihahanda ang kanilang palaso sa bagting, upang kanilang mapahilagpusan sa kadiliman ang matuwid sa puso,"
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Mga Awit 11:3",
              "text": "Kung ang mga patibayan ay masira, anong magagawa ng matuwid?"
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Mga Awit 11:4",
              "text": "Ang panginoon ay nasa kaniyang banal na templo, ang Panginoon, ang kaniyang luklukan ay nasa langit; ang kaniyang mga mata ay nagmamalas, ang kaniyang mga talukap-mata ay nagmamasid, sa mga anak ng mga tao."
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Mga Awit 11:5",
              "text": "Sinusubok ng Panginoon ang matuwid; nguni't ang masama at ang umiibig ng pangdadahas ay kinapopootan ng kaniyang kaluluwa."
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Mga Awit 11:6",
              "text": "Sa masama ay magpapaulan siya ng mga silo; apoy at azufre at nagaalab na hangin ay magiging bahagi ng kanilang saro."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Mga Awit 11:7",
              "text": "Sapagka't ang Panginoon ay matuwid; minamahal niya ang katuwiran: Mamasdan ng matuwid ang kaniyang mukha."
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Mga Awit 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Mga Awit 12:1",
              "text": "Tumulong ka, Panginoon, sapagka't ang banal na tao ay nalilipol; sapagka't nagkukulang ng tapat sa gitna ng mga anak ng mga tao."
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Mga Awit 12:2",
              "text": "Sila'y nangagsasalitaan bawa't isa ng kabulaanan, sa kanikaniyang kapuwa: na may mapanuyang labi, at may giring pulang puso na nangagsasalita."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Mga Awit 12:3",
              "text": "Ihihiwalay ng Panginoon, ang lahat na mapanuyang labi, ang dila na nagsasalita ng mga dakilang bagay:"
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Mga Awit 12:4",
              "text": "Na nagsipagsabi, sa pamamagitan ng aming dila ay magsisipanaig kami; ang aming mga labi ay aming sarili: sino ang panginoon sa amin?"
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Mga Awit 12:5",
              "text": "Dahil sa pagsamsam sa dukha, dahil sa buntong hininga ng mapagkailangan, titindig nga ako, sabi ng Panginoon; ilalagay ko siya sa kaligtasang kaniyang pinagmimithian."
            },
            {
              "chapter": 12,
              "verse": 6,
              "name": "Mga Awit 12:6",
              "text": "Ang mga salita ng Panginoon ay mga dalisay na salita; na gaya ng pilak na sinubok sa hurno sa lupa, na makapitong dinalisay."
            },
            {
              "chapter": 12,
              "verse": 7,
              "name": "Mga Awit 12:7",
              "text": "Iyong iingatan sila, Oh Panginoon, iyong pakaingatan sila mula sa lahing ito magpakailan man."
            },
            {
              "chapter": 12,
              "verse": 8,
              "name": "Mga Awit 12:8",
              "text": "Ang masama ay naggala saa't saan man. Pagka ang kapariwaraan ay natataas sa gitna ng mga anak ng mga tao."
            }
          ]
        },
        {
          "chapter": 13,
          "name": "Mga Awit 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "Mga Awit 13:1",
              "text": "Hanggang kailan, Oh Panginoon? iyong kalilimutan ako magpakailan man? Hanggang kailan ikukubli mo ang iyong mukha sa akin?"
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "Mga Awit 13:2",
              "text": "Hanggang kailan kukuhang payo ako sa aking kaluluwa, na may kalumbayan sa aking puso buong araw? Hanggang kailan magpapakataan ang aking kaaway sa akin?"
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "Mga Awit 13:3",
              "text": "Iyong bulayin, at sagutin mo ako, Oh Panginoon kong Dios: liwanagan mo ang aking mga mata, baka ako'y matulog ng tulog na kamatayan;"
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "Mga Awit 13:4",
              "text": "Baka sabihin ng aking kaaway, ako'y nanaig laban sa kaniya; baka ang aking mga kaaway ay mangagalak pagka ako'y nakilos."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "Mga Awit 13:5",
              "text": "Nguni't ako'y tumiwala sa iyong kagandahang-loob. Magagalak ang aking puso sa iyong pagliligtas:"
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "Mga Awit 13:6",
              "text": "Ako'y aawit sa Panginoon, sapagka't ginawan niya ako ng sagana."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "Mga Awit 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Mga Awit 14:1",
              "text": "Ang mangmang ay nagsabi sa kaniyang puso, walang Dios: sila'y nangapapahamak, sila'y nagsigawa ng kasuklamsuklam na mga gawa; walang gumagawa ng mabuti,"
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Mga Awit 14:2",
              "text": "Tinutunghan ng Panginoon ang mga anak ng mga tao mula sa langit, upang tingnan, kung may sinomang nakakaunawa, na hinahanap ng Dios."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Mga Awit 14:3",
              "text": "Silang lahat ay nagsihiwalay; sila'y magkakasama na naging kahalayhalay; walang gumagawa ng mabuti, wala, wala kahit isa."
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Mga Awit 14:4",
              "text": "Wala bang kaalaman ang lahat na manggagawa ng kasamaan? na siyang nagsisikain sa aking bayan na tila nagsisikain ng tinapay, at hindi nagsisitawag sa Panginoon."
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Mga Awit 14:5",
              "text": "Doo'y nangapasa malaking katakutan sila: sapagka't ang Dios ay nasa lahi ng matuwid."
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Mga Awit 14:6",
              "text": "Inyong inilalagay sa kahihiyan ang payo ng dukha, sapagka't ang Panginoon ang kaniyang kanlungan."
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Mga Awit 14:7",
              "text": "Oh kung ang kaligtasan ng Israel ay nanggagaling sa Sion! Kung ibabalik ng Panginoon ang nangabihag ng kaniyang bayan, magagalak nga ang Jacob, at masasayahan ang Israel."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "Mga Awit 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "Mga Awit 15:1",
              "text": "Panginoon, sinong makapanunuluyan sa iyong tabernakulo? Sinong tatahan sa iyong banal na bundok?"
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "Mga Awit 15:2",
              "text": "Siyang lumalakad na matuwid, at gumagawa ng katuwiran, at nagsasalita ng katotohanan sa kaniyang puso."
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "Mga Awit 15:3",
              "text": "Siyang hindi naninirang puri ng kaniyang dila, ni gumagawa man ng kasamaan sa kaniyang kaibigan, ni dumudusta man sa kaniyang kapuwa."
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "Mga Awit 15:4",
              "text": "Na sa mga mata niya ay nasisiphayo ang masama; kundi siyang nagbibigay puri sa mga natatakot sa Panginoon, siyang sumusumpa sa kaniyang sariling ikasasama at hindi nagbabago,"
            },
            {
              "chapter": 15,
              "verse": 5,
              "name": "Mga Awit 15:5",
              "text": "Siyang hindi naglalabas ng kaniyang salapi sa patubo, ni kumukuha man ng suhol laban sa walang sala. Siyang gumagawa ng mga bagay na ito ay hindi makikilos kailan man."
            }
          ]
        },
        {
          "chapter": 16,
          "name": "Mga Awit 16",
          "verses": [
            {
              "chapter": 16,
              "verse": 1,
              "name": "Mga Awit 16:1",
              "text": "Ingatan mo ako, Oh Dios; sapagka't sa iyo nanganganlong ako."
            },
            {
              "chapter": 16,
              "verse": 2,
              "name": "Mga Awit 16:2",
              "text": "Oh kaluluwa ko, iyong sinabi sa Panginoon, ikaw ay aking Panginoon: ako'y walang kabutihan liban sa iyo."
            },
            {
              "chapter": 16,
              "verse": 3,
              "name": "Mga Awit 16:3",
              "text": "Tungkol sa mga banal na nangasa lupa, sila ang maririlag na mga kinalulugdan kong lubos."
            },
            {
              "chapter": 16,
              "verse": 4,
              "name": "Mga Awit 16:4",
              "text": "Ang mga kalumbayan nila ay dadami, na nangaghahandog sa ibang dios: ang kanilang inuming handog na dugo ay hindi ko ihahandog, ni sasambitin man ang kanilang mga pangalan sa aking mga labi."
            },
            {
              "chapter": 16,
              "verse": 5,
              "name": "Mga Awit 16:5",
              "text": "Ang Panginoon ay siyang bahagi ng aking mana at ng aking saro: iyong inaalalayan ang aking kapalaran."
            },
            {
              "chapter": 16,
              "verse": 6,
              "name": "Mga Awit 16:6",
              "text": "Ang pising panukat ay nangahulog sa akin sa mga maligayang dako; Oo, ako'y may mainam na mana."
            },
            {
              "chapter": 16,
              "verse": 7,
              "name": "Mga Awit 16:7",
              "text": "Aking pupurihin ang Panginoon na nagbibigay sa akin ng payo: Oo, tinuturuan ako sa gabi ng aking puso."
            },
            {
              "chapter": 16,
              "verse": 8,
              "name": "Mga Awit 16:8",
              "text": "Aking inilagay na lagi ang Panginoon sa harap ko: sapagka't kung siya ay nasa aking kanan, hindi ako makikilos."
            },
            {
              "chapter": 16,
              "verse": 9,
              "name": "Mga Awit 16:9",
              "text": "Kaya't ang aking puso ay masaya, at ang aking kaluwalhatian ay nagagalak: ang akin namang katawan ay tatahang tiwasay."
            },
            {
              "chapter": 16,
              "verse": 10,
              "name": "Mga Awit 16:10",
              "text": "Sapagka't hindi mo iiwan ang aking kaluluwa sa Sheol; ni hindi mo man titiisin ang iyong banal ay makakita ng kabulukan."
            },
            {
              "chapter": 16,
              "verse": 11,
              "name": "Mga Awit 16:11",
              "text": "Iyong ituturo sa akin ang landas ng buhay: nasa iyong harapan ang kapuspusan ng kagalakan; sa iyong kanan ay may mga kasayahan magpakailan man."
            }
          ]
        },
        {
          "chapter": 17,
          "name": "Mga Awit 17",
          "verses": [
            {
              "chapter": 17,
              "verse": 1,
              "name": "Mga Awit 17:1",
              "text": "Dinggin mo ang matuwid, Oh Panginoon, pakinggan mo ang aking daing; ulinigin mo ang aking panalangin, na hindi lumalabas sa mga magdarayang labi."
            },
            {
              "chapter": 17,
              "verse": 2,
              "name": "Mga Awit 17:2",
              "text": "Manggaling sa iyong harapan ang aking kahatulan; masdan ng iyong mga mata ang karampatan."
            },
            {
              "chapter": 17,
              "verse": 3,
              "name": "Mga Awit 17:3",
              "text": "Iyong sinubok ang aking puso; iyong dinalaw ako sa kinagabihan; iyong nilitis ako, at wala kang nasumpungan; ako'y nagpasiya na ang aking bibig ay hindi sasalangsang."
            },
            {
              "chapter": 17,
              "verse": 4,
              "name": "Mga Awit 17:4",
              "text": "Tungkol sa mga gawa ng mga tao, sa pamamagitan ng salita ng iyong mga labi. Ako'y nagingat sa mga daan ng pangdadahas."
            },
            {
              "chapter": 17,
              "verse": 5,
              "name": "Mga Awit 17:5",
              "text": "Ang aking mga hakbang ay nagsipanatili sa iyong mga landas, ang aking mga paa ay hindi nangadulas."
            },
            {
              "chapter": 17,
              "verse": 6,
              "name": "Mga Awit 17:6",
              "text": "Ako'y tumawag sa iyo, sapagka't ikaw ay sasagot sa akin, Oh Dios: Ikiling mo ang iyong pakinig sa akin, at dinggin mo ang aking pananalita."
            },
            {
              "chapter": 17,
              "verse": 7,
              "name": "Mga Awit 17:7",
              "text": "Ipakita mo ang iyong mga kagilagilalas na kagandahang-loob, Oh ikaw na nagliligtas sa kanila na nagsisipagkanlong sa iyo. Sa nagsisibangon laban sa kanila, sa pamamagitan ng iyong kanan."
            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "Mga Awit 17:8",
              "text": "Ingatan mo ako na gaya ng itim ng mata, ikubli mo ako sa lilim ng iyong mga pakpak,"
            },
            {
              "chapter": 17,
              "verse": 9,
              "name": "Mga Awit 17:9",
              "text": "Sa masama na sumasamsam sa akin, sa aking mga kaaway na nagsisipatay, na nagsisikubkub sa akin."
            },
            {
              "chapter": 17,
              "verse": 10,
              "name": "Mga Awit 17:10",
              "text": "Sila'y nangabalot sa kanilang sariling taba: sila'y nangagsasalita ng kanilang bibig na may kapalaluan."
            },
            {
              "chapter": 17,
              "verse": 11,
              "name": "Mga Awit 17:11",
              "text": "Kanilang kinubkob nga kami sa aming mga hakbang: itinititig nila ang kanilang mga mata upang ibuwal kami sa lupa."
            },
            {
              "chapter": 17,
              "verse": 12,
              "name": "Mga Awit 17:12",
              "text": "Sila'y parang leon na masiba sa kaniyang huli, at parang batang leon na nanunubok sa mga lihim na dako."
            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "Mga Awit 17:13",
              "text": "Bumangon ka, Oh Panginoon, harapin mo siya, ilugmok mo siya: iligtas mo ang aking kaluluwa sa masama sa pamamagitan ng iyong tabak;"
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "Mga Awit 17:14",
              "text": "Sa mga tao, sa pamamagitan ng iyong kamay, Oh Panginoon, sa mga tao ng sanglibutan, na ang bahagi nila ay nasa buhay na ito, at ang tiyan nila'y pinupuno mo ng iyong kayamanan: kanilang binubusog ang kanilang mga anak, at iniiwan nila ang natira sa kanilang pag-aari sa kanilang sanggol."
            },
            {
              "chapter": 17,
              "verse": 15,
              "name": "Mga Awit 17:15",
              "text": "Tungkol sa akin, aking mamasdan ang iyong mukha sa katuwiran: ako'y masisiyahan pagka bumangon sa iyong wangis."
            }
          ]
        },
        {
          "chapter": 18,
          "name": "Mga Awit 18",
          "verses": [
            {
              "chapter": 18,
              "verse": 1,
              "name": "Mga Awit 18:1",
              "text": "Iniibig kita, Oh Panginoon, na aking kalakasan."
            },
            {
              "chapter": 18,
              "verse": 2,
              "name": "Mga Awit 18:2",
              "text": "Ang Panginoon ay aking malaking bato, at aking kuta, at aking tagapagligtas; aking Dios, aking malaking bato na sa kaniya'y manganganlong ako; aking kalasag, at siyang sungay ng aking kaligtasan, aking matayog na moog."
            },
            {
              "chapter": 18,
              "verse": 3,
              "name": "Mga Awit 18:3",
              "text": "Ako'y tatawag sa Panginoon, na marapat na purihin: sa gayo'y maliligtas ako sa aking mga kaaway."
            },
            {
              "chapter": 18,
              "verse": 4,
              "name": "Mga Awit 18:4",
              "text": "Pinamuluputan ako ng mga tali ng kamatayan, at tinakot ako ng mga baha ng kasamaan."
            },
            {
              "chapter": 18,
              "verse": 5,
              "name": "Mga Awit 18:5",
              "text": "Ang mga tali ng Sheol ay nasa buong palibot ko: ang mga silo ng kamatayan ay dumating sa akin."
            },
            {
              "chapter": 18,
              "verse": 6,
              "name": "Mga Awit 18:6",
              "text": "Sa aking kapanglawan ay tumawag ako sa Panginoon, at dumaing ako sa aking Dios: dininig niya ang aking tinig mula sa kaniyang templo, at ang aking daing sa harap niya ay dumating sa loob ng kaniyang mga pakinig."
            },
            {
              "chapter": 18,
              "verse": 7,
              "name": "Mga Awit 18:7",
              "text": "Nang magkagayo'y nauga at nayanig ang lupa, ang mga patibayan naman ng mga bundok ay nakilos, at nauga, sapagka't siya'y napoot."
            },
            {
              "chapter": 18,
              "verse": 8,
              "name": "Mga Awit 18:8",
              "text": "Napailanglang ang usok mula sa kaniyang mga butas ng ilong, at apoy na mula sa kaniyang bibig ay sumupok: mga baga ay nangagalab sa pamamagitan niyaon."
            },
            {
              "chapter": 18,
              "verse": 9,
              "name": "Mga Awit 18:9",
              "text": "Kaniya namang iniyuko ang mga langit, at ibinaba; at salimuot na kadiliman ay nasa ilalim ng kaniyang mga paa."
            },
            {
              "chapter": 18,
              "verse": 10,
              "name": "Mga Awit 18:10",
              "text": "At siya'y sumakay sa isang querubin, at lumipad: Oo, siya'y lumipad na maliksi sa mga pakpak ng hangin."
            },
            {
              "chapter": 18,
              "verse": 11,
              "name": "Mga Awit 18:11",
              "text": "Ginawa niya ang kadiliman na kaniyang kublihang dako, ang kaniyang kulandong sa buong palibot niya; mga kadiliman ng tubig, masinsing mga alapaap sa langit."
            },
            {
              "chapter": 18,
              "verse": 12,
              "name": "Mga Awit 18:12",
              "text": "Sa kakinangan sa harap niya ay dumaan ang kaniyang mga masinsing alapaap, mga granizo at mga bagang apoy."
            },
            {
              "chapter": 18,
              "verse": 13,
              "name": "Mga Awit 18:13",
              "text": "Ang Panginoon naman ay kumulog sa mga langit, at pinatunog ng Kataastaasan ang kaniyang tinig; mga granizo, at mga bagang apoy."
            },
            {
              "chapter": 18,
              "verse": 14,
              "name": "Mga Awit 18:14",
              "text": "At kaniyang inihilagpos ang kaniyang mga pana, at pinapangalat sila; Oo, mga kidlat na di masayod at ginulo sila."
            },
            {
              "chapter": 18,
              "verse": 15,
              "name": "Mga Awit 18:15",
              "text": "Nang magkagayo'y nagsilitaw ang mga lagusan ng tubig, at ang mga patibayan ng sanglibutan ay nangahubdan, sa iyong pagsaway, Oh Panginoon, sa hihip ng hinga ng iyong mga butas ng ilong."
            },
            {
              "chapter": 18,
              "verse": 16,
              "name": "Mga Awit 18:16",
              "text": "Siya'y nagsugo mula sa itaas, kinuha niya ako; sinagip niya ako sa maraming tubig."
            },
            {
              "chapter": 18,
              "verse": 17,
              "name": "Mga Awit 18:17",
              "text": "Iniligtas niya ako sa aking malakas na kaaway, At sa mga nangagtatanim sa akin, sapagka't sila'y totoong makapangyarihan sa ganang akin."
            },
            {
              "chapter": 18,
              "verse": 18,
              "name": "Mga Awit 18:18",
              "text": "Sila'y nagsidating sa akin sa kaarawan ng aking kasakunaan, nguni't ang Panginoon ay siyang aking gabay."
            },
            {
              "chapter": 18,
              "verse": 19,
              "name": "Mga Awit 18:19",
              "text": "Inilabas naman niya ako sa maluwag na dako; iniligtas niya ako, sapagka't siya'y nalulugod sa akin."
            },
            {
              "chapter": 18,
              "verse": 20,
              "name": "Mga Awit 18:20",
              "text": "Ginanting-pala ako ng Panginoon ayon sa aking katuwiran; ayon sa kalinisan ng aking mga kamay ay ginanting-pala niya ako."
            },
            {
              "chapter": 18,
              "verse": 21,
              "name": "Mga Awit 18:21",
              "text": "Sapagka't aking iningatan ang mga daan ng Panginoon, at hindi ako humiwalay ng masama sa aking Dios."
            },
            {
              "chapter": 18,
              "verse": 22,
              "name": "Mga Awit 18:22",
              "text": "Sapagka't lahat niyang mga kahatulan ay nangasa harap ko, at hindi ko inihiwalay ang kaniyang mga palatuntunan sa akin."
            },
            {
              "chapter": 18,
              "verse": 23,
              "name": "Mga Awit 18:23",
              "text": "Ako rin nama'y sakdal sa kaniya, at ako'y nagingat ng aking sarili sa aking kasamaan."
            },
            {
              "chapter": 18,
              "verse": 24,
              "name": "Mga Awit 18:24",
              "text": "Kaya't ginanting-pala ako ng Panginoon ayon sa aking katuwiran, ayon sa kalinisan ng aking mga kamay sa kaniyang paningin."
            },
            {
              "chapter": 18,
              "verse": 25,
              "name": "Mga Awit 18:25",
              "text": "Sa mahabagin ay pakikilala kang mahabagin; sa sakdal na tao ay pakikilala kang sakdal;"
            },
            {
              "chapter": 18,
              "verse": 26,
              "name": "Mga Awit 18:26",
              "text": "Sa dalisay ay pakikilala kang dalisay; at sa matigas na loob ay pakikilala kang mapagmatigas."
            },
            {
              "chapter": 18,
              "verse": 27,
              "name": "Mga Awit 18:27",
              "text": "Sapagka't iyong ililigtas ang napipighating bayan: nguni't ang mga mapagmataas na mata ay iyong ibababa."
            },
            {
              "chapter": 18,
              "verse": 28,
              "name": "Mga Awit 18:28",
              "text": "Sapagka't iyong papagniningasin ang aking ilawan; liliwanagan ng Panginoon kong Dios ang aking kadiliman."
            },
            {
              "chapter": 18,
              "verse": 29,
              "name": "Mga Awit 18:29",
              "text": "Sapagka't sa pamamagitan mo ay dadaluhungin ko ang isang hukbo; at sa pamamagitan ng aking Dios ay lulukso ako sa kuta."
            },
            {
              "chapter": 18,
              "verse": 30,
              "name": "Mga Awit 18:30",
              "text": "Tungkol sa Dios ang kaniyang lakad ay sakdal: ang salita ng Panginoon ay subok; siya'y kalasag ng lahat na nanganganlong sa kaniya,"
            },
            {
              "chapter": 18,
              "verse": 31,
              "name": "Mga Awit 18:31",
              "text": "Sapagka't sino ang Dios, liban sa Panginoon? At sino ang malaking bato maliban sa ating Dios?"
            },
            {
              "chapter": 18,
              "verse": 32,
              "name": "Mga Awit 18:32",
              "text": "Ang Dios na nagbibigkis sa akin ng kalakasan, at nagpapasakdal sa aking lakad."
            },
            {
              "chapter": 18,
              "verse": 33,
              "name": "Mga Awit 18:33",
              "text": "Kaniyang ginagawa ang aking mga paa na gaya ng mga paa ng mga usa: at inilalagay niya ako sa aking mga mataas na dako."
            },
            {
              "chapter": 18,
              "verse": 34,
              "name": "Mga Awit 18:34",
              "text": "Kaniyang tinuturuan ang aking mga kamay na makipagdigma, na anopa't ang aking mga kamay ay bumabali ng busog na tanso."
            },
            {
              "chapter": 18,
              "verse": 35,
              "name": "Mga Awit 18:35",
              "text": "Iyo namang ibinigay sa akin ang kalasag na iyong pangligtas: at inalalayan ako ng iyong kanan, at pinadakila ako ng iyong kahinahunan."
            },
            {
              "chapter": 18,
              "verse": 36,
              "name": "Mga Awit 18:36",
              "text": "Iyong pinalaki ang aking mga hakbang sa ilalim ko, at ang aking mga paa ay hindi nangadulas."
            },
            {
              "chapter": 18,
              "verse": 37,
              "name": "Mga Awit 18:37",
              "text": "Aking hahabulin ang aking mga kaaway, at aabutan ko sila: hindi man ako babalik hanggang sa sila'y malipol."
            },
            {
              "chapter": 18,
              "verse": 38,
              "name": "Mga Awit 18:38",
              "text": "Aking sasaktan sila, na anopa't sila'y huwag makatayo: sila'y mangalulugmok sa ilalim ng aking mga paa."
            },
            {
              "chapter": 18,
              "verse": 39,
              "name": "Mga Awit 18:39",
              "text": "Sapagka't iyong binigkisan ako ng kalakasan sa pagbabaka: iyong pinasuko sa akin yaong nagsisibangon laban sa akin."
            },
            {
              "chapter": 18,
              "verse": 40,
              "name": "Mga Awit 18:40",
              "text": "Iyo rin namang pinatatalikod sa akin ang aking mga kaaway, upang aking maihiwalay silang nangagtatanim sa akin."
            },
            {
              "chapter": 18,
              "verse": 41,
              "name": "Mga Awit 18:41",
              "text": "Sila'y nagsihiyaw, nguni't walang magligtas: pati sa Panginoon, nguni't hindi niya sinagot sila."
            },
            {
              "chapter": 18,
              "verse": 42,
              "name": "Mga Awit 18:42",
              "text": "Nang magkagayo'y aking dinurog sila na gaya ng alabok sa harap ng hangin: aking inihagis sila na gaya ng putik sa mga lansangan."
            },
            {
              "chapter": 18,
              "verse": 43,
              "name": "Mga Awit 18:43",
              "text": "Iniligtas mo ako sa mga pakikipagtalo sa bayan; iyong ginawa ako na pangulo ng mga bansa: isang bayan na hindi ko nakilala ay maglilingkod sa akin."
            },
            {
              "chapter": 18,
              "verse": 44,
              "name": "Mga Awit 18:44",
              "text": "Pagkarinig nila sa akin ay tatalimahin nila ako; ang mga taga ibang lupa ay magsisisuko sa akin."
            },
            {
              "chapter": 18,
              "verse": 45,
              "name": "Mga Awit 18:45",
              "text": "Ang mga taga ibang lupa ay manganghihiluka, at sila'y magsisilabas na nanganginginig mula sa kanilang mga taguang dako."
            },
            {
              "chapter": 18,
              "verse": 46,
              "name": "Mga Awit 18:46",
              "text": "Mabuhay nawa ang Panginoon at maging mapalad nawa ang aking malaking bato; at dakilain ang Dios ng aking kaligtasan:"
            },
            {
              "chapter": 18,
              "verse": 47,
              "name": "Mga Awit 18:47",
              "text": "Sa makatuwid baga'y ang Dios na ipinanghihiganti ako, at nagpapasuko ng mga bayan sa akin."
            },
            {
              "chapter": 18,
              "verse": 48,
              "name": "Mga Awit 18:48",
              "text": "Kaniyang inililigtas ako sa aking mga kaaway: Oo, itinataas mo ako sa nagsisibangon laban sa akin: iyong inililigtas ako sa mangdadahas na tao."
            },
            {
              "chapter": 18,
              "verse": 49,
              "name": "Mga Awit 18:49",
              "text": "Kaya't ako'y magpapasalamat sa iyo, Oh Panginoon, sa gitna ng mga bansa, at aawit ako ng mga pagpupuri sa iyong pangalan."
            },
            {
              "chapter": 18,
              "verse": 50,
              "name": "Mga Awit 18:50",
              "text": "Dakilang kaligtasan ay ibinibigay niya sa kaniyang hari; at nagpapakita ng kagandahang-loob sa kaniyang pinahiran ng langis. Kay David at sa kaniyang binhi magpakailan man."
            }
          ]
        },
        {
          "chapter": 19,
          "name": "Mga Awit 19",
          "verses": [
            {
              "chapter": 19,
              "verse": 1,
              "name": "Mga Awit 19:1",
              "text": "Ang kalangitan ay nagpapahayag ng kaluwalhatian ng Dios; at ipinakikilala ng kalawakan ang gawa ng kaniyang kamay."
            },
            {
              "chapter": 19,
              "verse": 2,
              "name": "Mga Awit 19:2",
              "text": "Sa araw-araw ay nagbabadya ng pananalita, at sa gabi-gabi ay nagpapakilala ng kaalaman."
            },
            {
              "chapter": 19,
              "verse": 3,
              "name": "Mga Awit 19:3",
              "text": "Walang pananalita o wika man; ang kanilang tinig ay hindi marinig."
            },
            {
              "chapter": 19,
              "verse": 4,
              "name": "Mga Awit 19:4",
              "text": "Ang kanilang pangungusap ay lumaganap sa buong lupa, at ang kanilang mga salita ay hanggang sa wakas ng sanglibutan. Sa kanila inilagay niya ang tabernakulo na ukol sa araw,"
            },
            {
              "chapter": 19,
              "verse": 5,
              "name": "Mga Awit 19:5",
              "text": "Na gaya ng kasintahang lalake na lumalabas mula sa kaniyang silid. At nagagalak na gaya ng malakas na tao na tatakbo ng kaniyang takbo."
            },
            {
              "chapter": 19,
              "verse": 6,
              "name": "Mga Awit 19:6",
              "text": "Ang kaniyang labasan ay mula sa wakas ng mga langit, at ang kaniyang ligid ay sa mga wakas niyaon: at walang bagay na nakukubli sa pagiinit niyaon."
            },
            {
              "chapter": 19,
              "verse": 7,
              "name": "Mga Awit 19:7",
              "text": "Ang kautusan ng Panginoon ay sakdal, na nagsasauli ng kaluluwa: ang patotoo ng Panginoon ay tunay, na nagpapapantas sa hangal."
            },
            {
              "chapter": 19,
              "verse": 8,
              "name": "Mga Awit 19:8",
              "text": "Ang mga tuntunin ng Panginoon ay matuwid, na nagpapagalak sa puso: ang utos ng Panginoon ay dalisay, na nagpapaliwanag ng mga mata."
            },
            {
              "chapter": 19,
              "verse": 9,
              "name": "Mga Awit 19:9",
              "text": "Ang takot sa Panginoon ay malinis, na nananatili magpakailan man: ang mga kahatulan ng Panginoon ay katotohanan, at lubos na matuwid."
            },
            {
              "chapter": 19,
              "verse": 10,
              "name": "Mga Awit 19:10",
              "text": "Mga pinipitang higit kay sa ginto, oo, higit kay sa maraming dalisay na ginto: lalong mainam kay sa pulot, at sa pulot-pukyutan."
            },
            {
              "chapter": 19,
              "verse": 11,
              "name": "Mga Awit 19:11",
              "text": "Higit dito'y sa pamamagitan ng mga iyo'y mapagpapaunahan ang iyong lingkod: sa pagiingat ng mga yaon ay may dakilang ganting-pala."
            },
            {
              "chapter": 19,
              "verse": 12,
              "name": "Mga Awit 19:12",
              "text": "Sinong makasisiyasat ng kaniyang mga kamalian? Paliwanagan mo ako sa mga kubling kamalian."
            },
            {
              "chapter": 19,
              "verse": 13,
              "name": "Mga Awit 19:13",
              "text": "Italikod mo rin ang iyong lingkod sa mga kapalaluang sala: huwag mong papagtaglayin ang mga yaon ng kapangyarihan sa akin: kung magkagayo'y magiging matuwid ako, at magiging malinis ako sa malaking pagsalangsang."
            },
            {
              "chapter": 19,
              "verse": 14,
              "name": "Mga Awit 19:14",
              "text": "Maging kalugodlugod nawa ang mga salita ng aking bibig, at ang pagbubulay ng aking puso sa iyong paningin, Oh Panginoon, na aking malaking bato, at aking manunubos."
            }
          ]
        },
        {
          "chapter": 20,
          "name": "Mga Awit 20",
          "verses": [
            {
              "chapter": 20,
              "verse": 1,
              "name": "Mga Awit 20:1",
              "text": "Ang Panginoon ay sumasagot sa iyo sa araw ng kabagabagan; itaas ka sa mataas ng pangalan ng Dios ni Jacob;"
            },
            {
              "chapter": 20,
              "verse": 2,
              "name": "Mga Awit 20:2",
              "text": "Saklolohan ka mula sa santuario, at palakasin ka mula sa Sion;"
            },
            {
              "chapter": 20,
              "verse": 3,
              "name": "Mga Awit 20:3",
              "text": "Alalahanin nawa ang lahat ng iyong mga handog, at tanggapin niya ang iyong mga haing sinunog; (Selah)"
            },
            {
              "chapter": 20,
              "verse": 4,
              "name": "Mga Awit 20:4",
              "text": "Pagkalooban ka nawa ng nais ng iyong puso, at tuparin ang lahat ng iyong payo."
            },
            {
              "chapter": 20,
              "verse": 5,
              "name": "Mga Awit 20:5",
              "text": "Kami ay magtatagumpay sa iyong pagliligtas, at sa pangalan ng aming Dios ay aming itataas ang aming mga watawat: ganapin nawa ng Panginoon ang lahat ng iyong mga hingi."
            },
            {
              "chapter": 20,
              "verse": 6,
              "name": "Mga Awit 20:6",
              "text": "Talastas ko ngayon na inililigtas ng Panginoon ang kaniyang pinahiran ng langis; sasagutin niya siya mula sa kaniyang banal na langit ng pangligtas na kalakasan ng kaniyang kanang kamay."
            },
            {
              "chapter": 20,
              "verse": 7,
              "name": "Mga Awit 20:7",
              "text": "Ang iba ay tumitiwala sa mga karo, at ang iba ay sa mga kabayo: nguni't babanggitin namin ang pangalan ng Panginoon naming Dios."
            },
            {
              "chapter": 20,
              "verse": 8,
              "name": "Mga Awit 20:8",
              "text": "Sila'y nangakasubsob at buwal: nguni't kami ay nakatindig at nakatayo na matuwid."
            },
            {
              "chapter": 20,
              "verse": 9,
              "name": "Mga Awit 20:9",
              "text": "Magligtas ka, Panginoon: sagutin nawa kami ng Hari pagka kami ay nagsisitawag."
            }
          ]
        },
        {
          "chapter": 21,
          "name": "Mga Awit 21",
          "verses": [
            {
              "chapter": 21,
              "verse": 1,
              "name": "Mga Awit 21:1",
              "text": "Ang hari ay magagalak sa iyong kalakasan, Oh Panginoon; at sa iyong pagliligtas gaano kalaki ang ikagagalak niya!"
            },
            {
              "chapter": 21,
              "verse": 2,
              "name": "Mga Awit 21:2",
              "text": "Ibinigay mo sa kaniya ang nais ng kaniyang puso, at hindi mo ikinait ang hiling ng kaniyang mga labi. (Selah)"
            },
            {
              "chapter": 21,
              "verse": 3,
              "name": "Mga Awit 21:3",
              "text": "Sapagka't iyong sinalubong siya ng mga kapalaran na kabutihan: iyong pinuputungan ng isang putong na dalisay na ginto ang kaniyang ulo."
            },
            {
              "chapter": 21,
              "verse": 4,
              "name": "Mga Awit 21:4",
              "text": "Siya'y humingi ng buhay sa iyo, iyong binigyan siya; pati ng kahabaan ng mga kaarawan magpakailan pa man."
            },
            {
              "chapter": 21,
              "verse": 5,
              "name": "Mga Awit 21:5",
              "text": "Ang kaniyang kaluwalhatian ay dakila sa iyong pagliligtas: karangalan at kamahalan ay inilalagay mo sa kaniya."
            },
            {
              "chapter": 21,
              "verse": 6,
              "name": "Mga Awit 21:6",
              "text": "Sapagka't ginagawa mo siyang pinakamapalad magpakailan man: iyong pinasasaya siya ng kagalakan sa iyong harapan."
            },
            {
              "chapter": 21,
              "verse": 7,
              "name": "Mga Awit 21:7",
              "text": "Sapagka't ang hari ay tumitiwala sa Panginoon, at sa kagandahang-loob ng Kataastaasan ay hindi siya makikilos."
            },
            {
              "chapter": 21,
              "verse": 8,
              "name": "Mga Awit 21:8",
              "text": "Masusumpungan ng iyong kamay ang lahat ng iyong mga kaaway: masusumpungan ng iyong kanan yaong mga nangagtatanim sa iyo."
            },
            {
              "chapter": 21,
              "verse": 9,
              "name": "Mga Awit 21:9",
              "text": "Iyong gagawin sila na gaya ng mainit na hurno sa panahon ng iyong galit. Sasakmalin sila ng Panginoon sa kaniyang poot, at susupukin sila ng apoy."
            },
            {
              "chapter": 21,
              "verse": 10,
              "name": "Mga Awit 21:10",
              "text": "Ang kanilang bunga ay iyong lilipulin mula sa lupa, at ang kanilang binhi ay mula sa gitna ng mga anak ng mga tao."
            },
            {
              "chapter": 21,
              "verse": 11,
              "name": "Mga Awit 21:11",
              "text": "Sapagka't sila'y nagakala ng kasamaan laban sa iyo: sila'y nagpanukala ng lalang na hindi nila maisasagawa."
            },
            {
              "chapter": 21,
              "verse": 12,
              "name": "Mga Awit 21:12",
              "text": "Sapagka't iyong patatalikurin sila, ikaw ay maghahanda ng iyong mga bagting ng busog laban sa mukha nila."
            },
            {
              "chapter": 21,
              "verse": 13,
              "name": "Mga Awit 21:13",
              "text": "Mataas ka, Oh Panginoon, sa iyong kalakasan: sa gayo'y aming aawitin at pupurihin ang iyong kapangyarihan."
            }
          ]
        },
        {
          "chapter": 22,
          "name": "Mga Awit 22",
          "verses": [
            {
              "chapter": 22,
              "verse": 1,
              "name": "Mga Awit 22:1",
              "text": "Dios ko, Dios ko, bakit mo ako pinabayaan? Bakit ka napaka layo sa pagtulong sa akin, at sa mga salita ng aking pagangal?"
            },
            {
              "chapter": 22,
              "verse": 2,
              "name": "Mga Awit 22:2",
              "text": "Oh Dios ko, ako'y humihiyaw sa araw, nguni't hindi ka sumasagot: at sa gabi, at hindi ako tahimik."
            },
            {
              "chapter": 22,
              "verse": 3,
              "name": "Mga Awit 22:3",
              "text": "Nguni't ikaw ay banal, Oh ikaw na tumatahan sa mga pagpuri ng Israel."
            },
            {
              "chapter": 22,
              "verse": 4,
              "name": "Mga Awit 22:4",
              "text": "Ang aming mga magulang ay nagsitiwala sa iyo: sila'y nagsitiwala, at iyong iniligtas sila."
            },
            {
              "chapter": 22,
              "verse": 5,
              "name": "Mga Awit 22:5",
              "text": "Sila'y nagsidaing sa iyo at nangaligtas: sila'y nagsitiwala sa iyo, at hindi nangapahiya."
            },
            {
              "chapter": 22,
              "verse": 6,
              "name": "Mga Awit 22:6",
              "text": "Nguni't ako'y uod at hindi tao; duwahagi sa mga tao, at hinamak ng bayan."
            },
            {
              "chapter": 22,
              "verse": 7,
              "name": "Mga Awit 22:7",
              "text": "Silang lahat na nangakakita sa akin ay tinatawanang mainam ako: inilalawit nila ang labi, iginagalaw nila ang ulo, na sinasabi,"
            },
            {
              "chapter": 22,
              "verse": 8,
              "name": "Mga Awit 22:8",
              "text": "Magpakatiwala ka sa Panginoon; iligtas niya siya: iligtas niya siya yamang kinaluluguran niya siya:"
            },
            {
              "chapter": 22,
              "verse": 9,
              "name": "Mga Awit 22:9",
              "text": "Nguni't ikaw ang naglabas sa akin sa bahay-bata: Pinatiwala mo ako nang ako'y nasa mga suso ng aking ina."
            },
            {
              "chapter": 22,
              "verse": 10,
              "name": "Mga Awit 22:10",
              "text": "Ako'y nahagis sa iyo mula sa bahay-bata: ikaw ay aking Dios mulang dalhin ako sa tiyan ng aking ina."
            },
            {
              "chapter": 22,
              "verse": 11,
              "name": "Mga Awit 22:11",
              "text": "Huwag mo akong layuan; sapagka't kabagabagan ay malapit; sapagka't walang tumulong."
            },
            {
              "chapter": 22,
              "verse": 12,
              "name": "Mga Awit 22:12",
              "text": "Niligid ako ng maraming toro; mga malakas na toro ng Basan ay kumulong sa akin."
            },
            {
              "chapter": 22,
              "verse": 13,
              "name": "Mga Awit 22:13",
              "text": "Sila'y magbubuka sa akin ng kanilang bibig, na gaya ng sumasakmal at umuungal na leon."
            },
            {
              "chapter": 22,
              "verse": 14,
              "name": "Mga Awit 22:14",
              "text": "Ako'y nabuhos na parang tubig, at lahat ng aking mga buto ay nangapapalinsad: ang aking puso ay parang pagkit; natutunaw ito sa loob ko."
            },
            {
              "chapter": 22,
              "verse": 15,
              "name": "Mga Awit 22:15",
              "text": "Ang aking kalakasan ay natuyo na parang bibinga; at ang aking dila ay dumidikit sa aking ngalangala; at dinala mo ako sa alabok ng kamatayan."
            },
            {
              "chapter": 22,
              "verse": 16,
              "name": "Mga Awit 22:16",
              "text": "Sapagka't niligid ako ng mga aso: kinulong ako ng pulutong ng mga manggagawa ng masama; binutasan nila ang aking mga kamay at ang aking mga paa."
            },
            {
              "chapter": 22,
              "verse": 17,
              "name": "Mga Awit 22:17",
              "text": "Aking maisasaysay ang lahat ng aking mga buto; kanilang minamasdan, at pinapansin ako:"
            },
            {
              "chapter": 22,
              "verse": 18,
              "name": "Mga Awit 22:18",
              "text": "Hinapak nila ang aking mga kasuutan sa gitna nila, at kanilang pinagsapalaran ang aking kasuutan."
            },
            {
              "chapter": 22,
              "verse": 19,
              "name": "Mga Awit 22:19",
              "text": "Nguni't huwag kang lumayo, Oh Panginoon: Oh ikaw na aking saklolo, magmadali kang tulungan mo ako."
            },
            {
              "chapter": 22,
              "verse": 20,
              "name": "Mga Awit 22:20",
              "text": "Iligtas mo ang aking kaluluwa sa tabak; ang aking minamahal sa kapangyarihan ng aso."
            },
            {
              "chapter": 22,
              "verse": 21,
              "name": "Mga Awit 22:21",
              "text": "Iligtas mo ako sa bibig ng leon; Oo, mula sa mga sungay ng torong gubat ay sinagot mo ako."
            },
            {
              "chapter": 22,
              "verse": 22,
              "name": "Mga Awit 22:22",
              "text": "Aking ipahahayag ang iyong pangalan sa aking mga kapatid: sa gitna ng kapulungan ay pupurihin kita."
            },
            {
              "chapter": 22,
              "verse": 23,
              "name": "Mga Awit 22:23",
              "text": "Kayong nangatatakot sa Panginoon ay magsipuri sa kaniya: kayong lahat na binhi ni Jacob ay lumuwalhati sa kaniya; at magsitayong may takot sa kaniya, kayong lahat na binhi ni Israel."
            },
            {
              "chapter": 22,
              "verse": 24,
              "name": "Mga Awit 22:24",
              "text": "Sapagka't hindi niya hinamak o pinagtaniman man ang kadalamhatian ng nagdadalamhati; ni ikinubli man niya ang kaniyang mukha sa kaniya; kundi nang siya'y dumaing sa kaniya, ay kaniyang dininig."
            },
            {
              "chapter": 22,
              "verse": 25,
              "name": "Mga Awit 22:25",
              "text": "Sa iyo nanggagaling ang pagpuri sa akin sa dakilang kapisanan: aking tutuparin ang aking mga panata sa harap nila na nangatatakot sa kaniya."
            },
            {
              "chapter": 22,
              "verse": 26,
              "name": "Mga Awit 22:26",
              "text": "Ang maamo ay kakain at mabubusog: kanilang pupurihin ang Panginoon na humanap sa kaniya; mabuhay nawa ang iyong puso magpakailan man."
            },
            {
              "chapter": 22,
              "verse": 27,
              "name": "Mga Awit 22:27",
              "text": "Lahat ng mga wakas ng lupa ay makakaalaala, at magsisipanumbalik sa Panginoon: at lahat ng mga angkan ng mga bansa ay magsisisamba sa harap mo."
            },
            {
              "chapter": 22,
              "verse": 28,
              "name": "Mga Awit 22:28",
              "text": "Sapagka't ang kaharian ay sa Panginoon: at siya ang puno sa mga bansa."
            },
            {
              "chapter": 22,
              "verse": 29,
              "name": "Mga Awit 22:29",
              "text": "Lahat na matataba sa lupa ay magsisikain, at magsisisamba: silang lahat na nagsisibaba sa alabok ay magsisiyukod sa harap niya, sa makatuwid baga'y ang hindi makapagingat na buhay ng kaniyang kaluluwa."
            },
            {
              "chapter": 22,
              "verse": 30,
              "name": "Mga Awit 22:30",
              "text": "Isang binhi ay maglilingkod sa kaniya, sasaysayin ang Panginoon sa susunod na salin ng lahi,"
            },
            {
              "chapter": 22,
              "verse": 31,
              "name": "Mga Awit 22:31",
              "text": "Sila'y magsisiparoon at mangaghahayag ng kaniyang katuwiran, sa bayan na ipanganganak ay ibabalita, yaong kaniyang ginawa."
            }
          ]
        },
        {
          "chapter": 23,
          "name": "Mga Awit 23",
          "verses": [
            {
              "chapter": 23,
              "verse": 1,
              "name": "Mga Awit 23:1",
              "text": "Ang Panginoon ay aking pastor; hindi ako mangangailangan."
            },
            {
              "chapter": 23,
              "verse": 2,
              "name": "Mga Awit 23:2",
              "text": "Kaniyang pinahihiga ako sa sariwang pastulan: pinapatnubayan niya ako sa siping ng mga tubig na pahingahan,"
            },
            {
              "chapter": 23,
              "verse": 3,
              "name": "Mga Awit 23:3",
              "text": "Kaniyang pinapananauli ang aking kaluluwa: pinapatnubayan niya ako sa mga landas ng katuwiran alangalang sa kaniyang pangalan."
            },
            {
              "chapter": 23,
              "verse": 4,
              "name": "Mga Awit 23:4",
              "text": "Oo, bagaman ako'y lumalakad sa libis ng lilim ng kamatayan, wala akong katatakutang kasamaan; sapagka't ikaw ay sumasa akin: ang iyong pamalo at ang iyong tungkod, ay nagsisialiw sa akin."
            },
            {
              "chapter": 23,
              "verse": 5,
              "name": "Mga Awit 23:5",
              "text": "Iyong pinaghahandaan ako ng dulang sa harap ko sa harapan ng aking mga kaaway: iyong pinahiran ang aking ulo ng langis; ang aking saro ay inaapawan."
            },
            {
              "chapter": 23,
              "verse": 6,
              "name": "Mga Awit 23:6",
              "text": "Tunay na ang kabutihan at kaawaan ay susunod sa akin sa lahat ng mga kaarawan ng aking buhay: at ako'y tatahan sa bahay ng Panginoon magpakailan man."
            }
          ]
        },
        {
          "chapter": 24,
          "name": "Mga Awit 24",
          "verses": [
            {
              "chapter": 24,
              "verse": 1,
              "name": "Mga Awit 24:1",
              "text": "Ang lupa ay sa Panginoon at ang buong narito; ang sanglibutan, at silang nagsisitahan dito."
            },
            {
              "chapter": 24,
              "verse": 2,
              "name": "Mga Awit 24:2",
              "text": "Sapagka't itinatag niya sa ibabaw ng mga dagat, at itinatayo sa ibabaw ng mga baha."
            },
            {
              "chapter": 24,
              "verse": 3,
              "name": "Mga Awit 24:3",
              "text": "Sinong aahon sa bundok ng Panginoon? At sinong tatayo sa kaniyang dakong banal?"
            },
            {
              "chapter": 24,
              "verse": 4,
              "name": "Mga Awit 24:4",
              "text": "Siyang may malinis na mga kamay at may dalisay na puso; na hindi nagmataas ang kaniyang kaluluwa sa walang kabuluhan, at hindi sumumpa na may kabulaanan."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "Mga Awit 24:5",
              "text": "Siya'y tatanggap ng pagpapala sa Panginoon, at ng katuwiran sa Dios ng kaniyang kaligtasan."
            },
            {
              "chapter": 24,
              "verse": 6,
              "name": "Mga Awit 24:6",
              "text": "Ito ang lahi ng mga nagsisihanap sa kaniya, na nagsisihanap ng iyong mukha, sa makatuwid baga'y Jacob. (Selah)"
            },
            {
              "chapter": 24,
              "verse": 7,
              "name": "Mga Awit 24:7",
              "text": "Itaas ninyo ang inyong mga ulo, Oh kayong mga pintuang-bayan; at kayo'y mangataas, kayong mga walang hanggang pintuan: at ang hari ng kaluwalhatian ay papasok."
            },
            {
              "chapter": 24,
              "verse": 8,
              "name": "Mga Awit 24:8",
              "text": "Sino ang Hari ng kaluwalhatian? Ang Panginoong malakas at makapangyarihan, ang Panginoong makapangyarihan sa pagbabaka."
            },
            {
              "chapter": 24,
              "verse": 9,
              "name": "Mga Awit 24:9",
              "text": "Itaas ninyo ang inyong mga ulo, Oh kayong mga pintuang-bayan; Oo, magsitaas kayo, kayong mga walang hanggang pintuan: at ang hari ng kaluwalhatian ay papasok."
            },
            {
              "chapter": 24,
              "verse": 10,
              "name": "Mga Awit 24:10",
              "text": "Sino itong Hari ng kaluwalhatian? Ang Panginoon ng mga hukbo, siya ang Hari ng kaluwalhatian. (Selah)"
            }
          ]
        },
        {
          "chapter": 25,
          "name": "Mga Awit 25",
          "verses": [
            {
              "chapter": 25,
              "verse": 1,
              "name": "Mga Awit 25:1",
              "text": "Sa iyo, Oh Panginoon, iginagawad ko ang aking kaluluwa."
            },
            {
              "chapter": 25,
              "verse": 2,
              "name": "Mga Awit 25:2",
              "text": "Oh Dios ko sa iyo'y tumiwala ako, huwag nawa akong mapahiya; huwag nawang magtagumpay sa akin ang aking mga kaaway."
            },
            {
              "chapter": 25,
              "verse": 3,
              "name": "Mga Awit 25:3",
              "text": "Oo, walang naghihintay sa iyo na mapapahiya; sila'y mangapapahiya na nagsisigawa ng karayaan ng walang kadahilanan,"
            },
            {
              "chapter": 25,
              "verse": 4,
              "name": "Mga Awit 25:4",
              "text": "Ituro mo sa akin ang iyong mga daan, Oh Panginoon; ituro mo sa akin ang iyong mga landas."
            },
            {
              "chapter": 25,
              "verse": 5,
              "name": "Mga Awit 25:5",
              "text": "Patnubayan mo ako sa iyong katotohanan, at ituro mo sa akin; sapagka't ikaw ay Dios ng aking kaligtasan; sa iyo'y naghihintay ako buong araw."
            },
            {
              "chapter": 25,
              "verse": 6,
              "name": "Mga Awit 25:6",
              "text": "Iyong alalahanin, Oh Panginoon, ang iyong malumanay na mga kaawaan, at ang iyong mga kagandahang-loob; sapagka't magpakailan man mula ng una."
            },
            {
              "chapter": 25,
              "verse": 7,
              "name": "Mga Awit 25:7",
              "text": "Huwag mong alalahanin ang mga kasalanan ng aking kabataan, ni ang aking mga pagsalangsang: ayon sa iyong kagandahang-loob ay alalahanin mo ako, dahil sa iyong kabutihan, Oh Panginoon."
            },
            {
              "chapter": 25,
              "verse": 8,
              "name": "Mga Awit 25:8",
              "text": "Mabuti at matuwid ang Panginoon: kaya't tuturuan niya ang mga makasalanan sa daan."
            },
            {
              "chapter": 25,
              "verse": 9,
              "name": "Mga Awit 25:9",
              "text": "Ang maamo ay papatnubayan niya sa kahatulan: at ituturo niya sa maamo ang daan niya."
            },
            {
              "chapter": 25,
              "verse": 10,
              "name": "Mga Awit 25:10",
              "text": "Lahat na landas ng Panginoon ay kagandahang-loob at katotohanan sa mga gayon na nangagiingat ng kaniyang tipan at kaniyang mga patotoo."
            },
            {
              "chapter": 25,
              "verse": 11,
              "name": "Mga Awit 25:11",
              "text": "Dahil sa iyong pangalan, Oh Panginoon, iyong ipatawad ang aking kasamaan, sapagka't malaki."
            },
            {
              "chapter": 25,
              "verse": 12,
              "name": "Mga Awit 25:12",
              "text": "Anong tao siya na natatakot sa Panginoon? Siya ang tuturuan niya ng daan na kaniyang pipiliin."
            },
            {
              "chapter": 25,
              "verse": 13,
              "name": "Mga Awit 25:13",
              "text": "Ang kaniyang kaluluwa ay tatahan sa kaginhawahan; at mamanahin ng kaniyang binhi ang lupain."
            },
            {
              "chapter": 25,
              "verse": 14,
              "name": "Mga Awit 25:14",
              "text": "Ang pakikipagibigan ng Panginoon ay nasa nangatatakot sa kaniya; at ipakikilala niya sa kanila ang kaniyang tipan."
            },
            {
              "chapter": 25,
              "verse": 15,
              "name": "Mga Awit 25:15",
              "text": "Ang aking mga mata ay palaging na sa Panginoon; sapagka't huhugutin niya ang aking mga paa sa silo."
            },
            {
              "chapter": 25,
              "verse": 16,
              "name": "Mga Awit 25:16",
              "text": "Panumbalikan mo ako, at maawa ka sa akin; sapagka't ako'y nag-iisa at nagdadalamhati."
            },
            {
              "chapter": 25,
              "verse": 17,
              "name": "Mga Awit 25:17",
              "text": "Ang kabagabagan ng aking puso ay lumaki: Oh hanguin mo ako sa aking kapanglawan."
            },
            {
              "chapter": 25,
              "verse": 18,
              "name": "Mga Awit 25:18",
              "text": "Gunitain mo ang aking pagkapighati at aking damdam; at ipatawad mo ang lahat kong mga kasalanan."
            },
            {
              "chapter": 25,
              "verse": 19,
              "name": "Mga Awit 25:19",
              "text": "Masdan mo ang aking mga kaaway, sapagka't sila'y marami; at pinagtataniman nila ako ng mabagsik na pagkagalit."
            },
            {
              "chapter": 25,
              "verse": 20,
              "name": "Mga Awit 25:20",
              "text": "Oh ingatan mo ang aking kaluluwa, at iyong iligtas ako: huwag nawa akong mapahiya, sapagka't nanganganlong ako sa iyo."
            },
            {
              "chapter": 25,
              "verse": 21,
              "name": "Mga Awit 25:21",
              "text": "Magingat sa akin ang pagtatapat at katuwiran, sapagka't hinihintay kita."
            },
            {
              "chapter": 25,
              "verse": 22,
              "name": "Mga Awit 25:22",
              "text": "Tubusin mo ang Israel, Oh Dios, mula sa lahat na kaniyang kabagabagan."
            }
          ]
        },
        {
          "chapter": 26,
          "name": "Mga Awit 26",
          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Mga Awit 26:1",
              "text": "Iyong hatulan ako Oh Panginoon, sapagka't ako'y lumakad sa aking pagtatapat: ako naman ay tumiwala sa Panginoon, na walang bulay-bulay."
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Mga Awit 26:2",
              "text": "Siyasatin mo ako, Oh Panginoon, at iyong subukin ako; subukin mo ang aking puso at ang aking isip."
            },
            {
              "chapter": 26,
              "verse": 3,
              "name": "Mga Awit 26:3",
              "text": "Sapagka't ang iyong kagandahang-loob ay nasa harap ng aking mga mata: at ako'y lumakad sa iyong katotohanan."
            },
            {
              "chapter": 26,
              "verse": 4,
              "name": "Mga Awit 26:4",
              "text": "Hindi ako naupo na kasama ng mga walang kabuluhang tao; ni papasok man ako na kasama ng mga mapagpakunwari."
            },
            {
              "chapter": 26,
              "verse": 5,
              "name": "Mga Awit 26:5",
              "text": "Aking pinagtataniman ang kapisanan ng mga manggagawa ng kasamaan, at hindi ako uupo na kaumpok ng masama."
            },
            {
              "chapter": 26,
              "verse": 6,
              "name": "Mga Awit 26:6",
              "text": "Aking huhugasan ang aking mga kamay sa pagkawalang sala; sa gayo'y aking lilibirin ang iyong dambana, Oh Panginoon:"
            },
            {
              "chapter": 26,
              "verse": 7,
              "name": "Mga Awit 26:7",
              "text": "Upang aking maiparinig ang tinig ng pagpapasalamat, at maisaysay ang lahat na iyong kagilagilalas na gawa."
            },
            {
              "chapter": 26,
              "verse": 8,
              "name": "Mga Awit 26:8",
              "text": "Panginoon, aking iniibig ang tahanan ng iyong bahay, at ang dako na tinatahanan ng iyong kaluwalhatian."
            },
            {
              "chapter": 26,
              "verse": 9,
              "name": "Mga Awit 26:9",
              "text": "Huwag mong isama ang aking kaluluwa sa mga makasalanan, ni ang aking buhay man sa mga mabagsik na tao:"
            },
            {
              "chapter": 26,
              "verse": 10,
              "name": "Mga Awit 26:10",
              "text": "Na ang mga kamay ay kinaroroonan ng kasamaan, at ang kanilang kanan ay puno ng mga suhol."
            },
            {
              "chapter": 26,
              "verse": 11,
              "name": "Mga Awit 26:11",
              "text": "Nguni't tungkol sa akin ay lalakad ako sa aking pagtatapat: iyong tubusin ako, at mahabag ka sa akin."
            },
            {
              "chapter": 26,
              "verse": 12,
              "name": "Mga Awit 26:12",
              "text": "Ang aking paa ay nakatayo sa isang panatag na dako: sa mga kapisanan ay pupurihin ko ang Panginoon."
            }
          ]
        },
        {
          "chapter": 27,
          "name": "Mga Awit 27",
          "verses": [
            {
              "chapter": 27,
              "verse": 1,
              "name": "Mga Awit 27:1",
              "text": "Ang Panginoon ay aking liwanag, at aking kaligtasan: kanino ako matatakot? Ang Panginoon, ay katibayan ng aking buhay; kanino ako masisindak?"
            },
            {
              "chapter": 27,
              "verse": 2,
              "name": "Mga Awit 27:2",
              "text": "Nang dumating sa akin ang mga manggagawa ng kasamaan upang kanin ang aking laman, ang aking mga kaaway at aking mga kaalit, sila'y nangatisod at nangarapa."
            },
            {
              "chapter": 27,
              "verse": 3,
              "name": "Mga Awit 27:3",
              "text": "Bagaman ang isang hukbo ay humantong laban sa akin, hindi matatakot ang aking puso: bagaman magbangon ang pagdidigma laban sa akin, gayon ma'y titiwala rin ako."
            },
            {
              "chapter": 27,
              "verse": 4,
              "name": "Mga Awit 27:4",
              "text": "Isang bagay ang hiningi ko sa Panginoon, na aking hahanapin; na ako'y makatahan sa bahay ng Panginoon, lahat ng mga kaarawan ng aking buhay, upang malasin ang kagandahan ng Panginoon, at magusisa sa kaniyang templo."
            },
            {
              "chapter": 27,
              "verse": 5,
              "name": "Mga Awit 27:5",
              "text": "Sapagka't sa kaarawan ng kabagabagan ay iingatan niya ako na lihim sa kaniyang kulandong: sa kublihan ng kaniyang tabernakulo ay ikukubli niya ako; Kaniyang itataas ako sa ibabaw ng isang malaking bato."
            },
            {
              "chapter": 27,
              "verse": 6,
              "name": "Mga Awit 27:6",
              "text": "At ngayo'y matataas ang aking ulo sa aking mga kaaway sa palibot ko; at ako'y maghahandog sa kaniyang tabernakulo ng mga hain ng kagalakan; ako'y aawit, oo, ako'y aawit ng mga pagpuri sa Panginoon."
            },
            {
              "chapter": 27,
              "verse": 7,
              "name": "Mga Awit 27:7",
              "text": "Dinggin mo, Oh Panginoon, pagka ako'y sumisigaw ng aking tinig: maawa ka rin sa akin, at sagutin mo ako."
            },
            {
              "chapter": 27,
              "verse": 8,
              "name": "Mga Awit 27:8",
              "text": "Nang iyong sabihin, hanapin ninyo ang aking mukha; ang aking puso ay nagsabi sa iyo, ang iyong mukha, Panginoon, ay hahanapin ko."
            },
            {
              "chapter": 27,
              "verse": 9,
              "name": "Mga Awit 27:9",
              "text": "Huwag mong ikubli ang iyong mukha sa akin; huwag mong ihiwalay ang iyong lingkod ng dahil sa galit: ikaw ay naging aking saklolo; huwag mo akong itakuwil, o pabayaan man, Oh Dios ng aking kaligtasan."
            },
            {
              "chapter": 27,
              "verse": 10,
              "name": "Mga Awit 27:10",
              "text": "Bagaman pabayaan ako ng aking ama at ng aking ina, gayon ma'y dadamputin ako ng Panginoon."
            },
            {
              "chapter": 27,
              "verse": 11,
              "name": "Mga Awit 27:11",
              "text": "Ituro mo sa akin ang iyong daan, Oh Panginoon: at patnubayan mo ako sa patag na landas, dahil sa aking mga kaaway."
            },
            {
              "chapter": 27,
              "verse": 12,
              "name": "Mga Awit 27:12",
              "text": "Huwag mo akong ibigay sa kalooban ng aking mga kaaway: sapagka't mga sinungaling na saksi ay nagsibangon laban sa akin, at ang nagsisihinga ng kabagsikan."
            },
            {
              "chapter": 27,
              "verse": 13,
              "name": "Mga Awit 27:13",
              "text": "Ako sana'y nanglupaypay kundi ko pinaniwalaang makita ang kabutihan ng Panginoon. Sa lupain ng may buhay."
            },
            {
              "chapter": 27,
              "verse": 14,
              "name": "Mga Awit 27:14",
              "text": "Magantay ka sa Panginoon: ikaw ay magpakalakas, at magdalang tapang ang iyong puso; Oo, umasa ka sa Panginoon."
            }
          ]
        },
        {
          "chapter": 28,
          "name": "Mga Awit 28",
          "verses": [
            {
              "chapter": 28,
              "verse": 1,
              "name": "Mga Awit 28:1",
              "text": "Sa iyo, Oh Panginoon, tatawag ako; bato ko, huwag kang magpakabingi sa akin: baka kung ikaw ay tumahimik sa akin, ako'y maging gaya nila na bumaba sa hukay."
            },
            {
              "chapter": 28,
              "verse": 2,
              "name": "Mga Awit 28:2",
              "text": "Dinggin mo ang tinig ng aking mga pananaing, pagka ako'y dumadaing sa iyo, pagka aking iginagawad ang aking mga kamay sa dako ng banal na sanggunian sa iyo."
            },
            {
              "chapter": 28,
              "verse": 3,
              "name": "Mga Awit 28:3",
              "text": "Huwag mo akong agawin na kasama ng mga masama, at ng mga manggagawa ng kasamaan; na nangagsasalita ng kapayapaan sa kanilang mga kapuwa, Nguni't kasamaan ay nasa kanilang mga puso."
            },
            {
              "chapter": 28,
              "verse": 4,
              "name": "Mga Awit 28:4",
              "text": "Bigyan mo sila ng ayon sa kanilang gawa, at ng ayon sa kasamaan ng kanilang mga gawain: gantihin mo sila ng ayon sa kilos ng kanilang mga kamay. Bayaran mo sila ng ukol sa kanila,"
            },
            {
              "chapter": 28,
              "verse": 5,
              "name": "Mga Awit 28:5",
              "text": "Sapagka't ayaw nilang pakundanganan ang mga gawa ng Panginoon, ni ang kilos man ng kaniyang mga kamay, kaniyang ibabagsak sila, at hindi sila itatayo."
            },
            {
              "chapter": 28,
              "verse": 6,
              "name": "Mga Awit 28:6",
              "text": "Purihin ang Panginoon, sapagka't dininig niya ang tinig ng aking mga pananaing."
            },
            {
              "chapter": 28,
              "verse": 7,
              "name": "Mga Awit 28:7",
              "text": "Ang Panginoon ay aking kalakasan at aking kalasag; ang aking puso ay tumiwala sa kaniya, at ako'y nasaklolohan: kaya't ang aking puso ay nagagalak na mainam; at aking pupurihin siya ng aking awit."
            },
            {
              "chapter": 28,
              "verse": 8,
              "name": "Mga Awit 28:8",
              "text": "Ang Panginoon ay kanilang kalakasan, at siya'y kuta ng kaligtasan sa kaniyang pinahiran ng langis."
            },
            {
              "chapter": 28,
              "verse": 9,
              "name": "Mga Awit 28:9",
              "text": "Iligtas mo ang iyong bayan, at pagpalain mo ang iyong pamana: naging pastor ka rin naman nila, at alalayan mo sila magpakailan man."
            }
          ]
        },
        {
          "chapter": 29,
          "name": "Mga Awit 29",
          "verses": [
            {
              "chapter": 29,
              "verse": 1,
              "name": "Mga Awit 29:1",
              "text": "Mangagbigay kayo sa Panginoon, Oh kayong mga anak ng makapangyarihan, mangagbigay kayo sa Panginoon ng kaluwalhatian at kalakasan."
            },
            {
              "chapter": 29,
              "verse": 2,
              "name": "Mga Awit 29:2",
              "text": "Ibigay ninyo sa Panginoon ang kaluwalhatiang marapat sa kaniyang pangalan: inyong sambahin ang Panginoon sa kagandahan ng kabanalan."
            },
            {
              "chapter": 29,
              "verse": 3,
              "name": "Mga Awit 29:3",
              "text": "Ang tinig ng Panginoon ay nasa ibabaw ng tubig: ang Dios ng kaluwalhatian ay kumukulog, sa makatuwid baga'y ang Panginoon sa ibabaw ng maraming tubig."
            },
            {
              "chapter": 29,
              "verse": 4,
              "name": "Mga Awit 29:4",
              "text": "Ang tinig ng Panginoon ay makapangyarihan; ang tinig ng Panginoon ay puspos ng kamahalan."
            },
            {
              "chapter": 29,
              "verse": 5,
              "name": "Mga Awit 29:5",
              "text": "Ang tinig ng Panginoon ay bumabali ng mga cedro; Oo, pinagpuputolputol ng Panginoon ang mga cedro ng Libano."
            },
            {
              "chapter": 29,
              "verse": 6,
              "name": "Mga Awit 29:6",
              "text": "Kaniya namang pinalulukso na gaya ng guya: ang Libano at Sirion na gaya ng mailap na guyang baka."
            },
            {
              "chapter": 29,
              "verse": 7,
              "name": "Mga Awit 29:7",
              "text": "Humahawi ng liyab ng apoy ang tinig ng Panginoon."
            },
            {
              "chapter": 29,
              "verse": 8,
              "name": "Mga Awit 29:8",
              "text": "Niyayanig ng tinig ng Panginoon ang ilang: niyayanig ng Panginoon ang ilang ng Kades."
            },
            {
              "chapter": 29,
              "verse": 9,
              "name": "Mga Awit 29:9",
              "text": "Pinapanganganak ng tinig ng Panginoon ang mga usa, at hinuhubdan ang mga gubat: at sa kaniyang templo ay nagsasabi ang bawa't bagay: kaluwalhatian."
            },
            {
              "chapter": 29,
              "verse": 10,
              "name": "Mga Awit 29:10",
              "text": "Ang Panginoon ay naupo sa baha na parang Hari; Oo, ang Panginoon ay nauupong parang Hari magpakailan man."
            },
            {
              "chapter": 29,
              "verse": 11,
              "name": "Mga Awit 29:11",
              "text": "Ang Panginoon ay magbibigay ng kalakasan sa kaniyang bayan; pagpapalain ng Panginoon ang kaniyang bayan ng kapayapaan."
            }
          ]
        },
        {
          "chapter": 30,
          "name": "Mga Awit 30",
          "verses": [
            {
              "chapter": 30,
              "verse": 1,
              "name": "Mga Awit 30:1",
              "text": "Dadakilain kita, Oh Panginoon; sapagka't itinindig mo ako, at hindi mo pinagalak sa akin ang aking mga kaaway."
            },
            {
              "chapter": 30,
              "verse": 2,
              "name": "Mga Awit 30:2",
              "text": "Oh Panginoon kong Dios, dumaing ako sa iyo, at ako'y pinagaling mo."
            },
            {
              "chapter": 30,
              "verse": 3,
              "name": "Mga Awit 30:3",
              "text": "Oh Panginoon, iyong isinampa ang aking kaluluwa mula sa Sheol: iyong iningatan akong buhay, upang huwag akong bumaba sa hukay."
            },
            {
              "chapter": 30,
              "verse": 4,
              "name": "Mga Awit 30:4",
              "text": "Magsiawit kayo ng pagpuri sa Panginoon, Oh kayong mga banal niya, at mangagpasalamat kayo sa kaniyang banal na pangalan."
            },
            {
              "chapter": 30,
              "verse": 5,
              "name": "Mga Awit 30:5",
              "text": "Sapagka't ang kaniyang galit ay sangdali lamang; ang kaniyang paglingap ay habang buhay: pagiyak ay magtatagal ng magdamag, nguni't kagalakan ay dumarating sa kinaumagahan."
            },
            {
              "chapter": 30,
              "verse": 6,
              "name": "Mga Awit 30:6",
              "text": "Tungkol sa akin, sinabi ko sa aking kaginhawahan: hindi ako makikilos kailan man."
            },
            {
              "chapter": 30,
              "verse": 7,
              "name": "Mga Awit 30:7",
              "text": "Ikaw, Panginoon, sa iyong paglingap ay pinatayo mong matibay ang aking bundok: iyong ikinubli ang iyong mukha; ako'y nabagabag."
            },
            {
              "chapter": 30,
              "verse": 8,
              "name": "Mga Awit 30:8",
              "text": "Ako'y dumaing sa iyo, Oh Panginoon; at sa Panginoon ay gumawa ako ng pamanhik:"
            },
            {
              "chapter": 30,
              "verse": 9,
              "name": "Mga Awit 30:9",
              "text": "Anong pakinabang magkakaroon sa aking dugo, pagka ako'y mababa sa hukay? Pupuri ba sa iyo ang alabok? magsasaysay ba ito ng iyong katotohanan?"
            },
            {
              "chapter": 30,
              "verse": 10,
              "name": "Mga Awit 30:10",
              "text": "Iyong dinggin, Oh Panginoon, at maawa ka sa akin: Panginoon, maging saklolo nawa kita."
            },
            {
              "chapter": 30,
              "verse": 11,
              "name": "Mga Awit 30:11",
              "text": "Iyong pinapaging sayaw sa akin ang aking tangis; iyong kinalag ang aking kayong magaspang, at binigkisan mo ako ng kasayahan:"
            },
            {
              "chapter": 30,
              "verse": 12,
              "name": "Mga Awit 30:12",
              "text": "Upang ang pagluwalhati ko ay umawit na pagpupuri sa iyo at huwag maging tahimik: Oh Panginoon kong Dios, ako'y magpapasalamat sa iyo magpakailan man."
            }
          ]
        },
        {
          "chapter": 31,
          "name": "Mga Awit 31",
          "verses": [
            {
              "chapter": 31,
              "verse": 1,
              "name": "Mga Awit 31:1",
              "text": "Sa iyo, Oh Panginoon, nanganganlong ako; huwag akong mapahiya kailan man; palayain mo ako sa iyong katuwiran."
            },
            {
              "chapter": 31,
              "verse": 2,
              "name": "Mga Awit 31:2",
              "text": "Ikiling mo ang iyong pakinig sa akin; iligtas mo akong madali: maging matibay na kanlungan ka nawa sa akin, bahay na sanggalangan upang iligtas ako."
            },
            {
              "chapter": 31,
              "verse": 3,
              "name": "Mga Awit 31:3",
              "text": "Sapagka't ikaw ang aking malaking bato, at aking kuta; alangalang nga sa iyong pangalan ay pangunahan mo ako, at patnubayan mo ako."
            },
            {
              "chapter": 31,
              "verse": 4,
              "name": "Mga Awit 31:4",
              "text": "Hugutin mo ako sa silo na kanilang inilagay na lihim ukol sa akin; sapagka't ikaw ang aking katibayan."
            },
            {
              "chapter": 31,
              "verse": 5,
              "name": "Mga Awit 31:5",
              "text": "Sa iyong kamay ay inihabilin ko ang aking diwa; iyong tinubos ako, Oh Panginoon, ikaw na Dios ng katotohanan."
            },
            {
              "chapter": 31,
              "verse": 6,
              "name": "Mga Awit 31:6",
              "text": "Aking pinagtataniman ang nangagmamasid ng mga walang kabuluhang karayaan: nguni't tumitiwala ako sa Panginoon."
            },
            {
              "chapter": 31,
              "verse": 7,
              "name": "Mga Awit 31:7",
              "text": "Ako'y matutuwa at magagalak sa iyong kagandahang-loob: sapagka't iyong nakita ang aking kadalamhatian: iyong nakilala ang aking kaluluwa sa mga kasakunaan:"
            },
            {
              "chapter": 31,
              "verse": 8,
              "name": "Mga Awit 31:8",
              "text": "At hindi mo kinulong sa kamay ng kaaway; iyong inilagay ang aking mga paa sa maluwag na dako."
            },
            {
              "chapter": 31,
              "verse": 9,
              "name": "Mga Awit 31:9",
              "text": "Maawa ka sa akin, Oh Panginoon, sapagka't ako'y nasa kahirapan: ang aking mata ay namumugto sa kapanglawan, oo, ang aking kaluluwa, at aking katawan."
            },
            {
              "chapter": 31,
              "verse": 10,
              "name": "Mga Awit 31:10",
              "text": "Sapagka't ang aking buhay ay napupugnaw sa kapanglawan, at ang aking mga taon ay sa pagbubuntong hininga: ang aking lakas ay nanglulupaypay dahil sa aking kasamaan, at ang aking mga buto ay nangangatog."
            },
            {
              "chapter": 31,
              "verse": 11,
              "name": "Mga Awit 31:11",
              "text": "Dahil sa lahat ng aking mga kaaway ay naging kaduwahagihan ako, Oo, lubha nga sa aking mga kapuwa, at takot sa aking mga kakilala: silang nangakakita sa akin sa labas ay tinakasan ako."
            },
            {
              "chapter": 31,
              "verse": 12,
              "name": "Mga Awit 31:12",
              "text": "Ako'y nilimot sa pagiisip na parang patay na tao: Ako'y parang basag na sisidlan."
            },
            {
              "chapter": 31,
              "verse": 13,
              "name": "Mga Awit 31:13",
              "text": "Sapagka't aking narinig ang paninirang puri ng marami, kakilabutan sa bawa't dako. Samantalang sila'y nagsasangguniang magkakasama laban sa akin, kanilang pinagsisikapang alisin ang aking buhay."
            },
            {
              "chapter": 31,
              "verse": 14,
              "name": "Mga Awit 31:14",
              "text": "Nguni't tumiwala ako sa iyo, Oh Panginoon: aking sinabi: Ikaw ay aking Dios."
            },
            {
              "chapter": 31,
              "verse": 15,
              "name": "Mga Awit 31:15",
              "text": "Ang aking mga kapanahunan ay nasa iyong kamay: iligtas mo ako sa kamay ng aking mga kaaway, at sa mga nagsisiusig sa akin."
            },
            {
              "chapter": 31,
              "verse": 16,
              "name": "Mga Awit 31:16",
              "text": "Iyong pasilangin ang iyong mukha sa iyong lingkod: iligtas mo ako ng iyong kagandahang-loob."
            },
            {
              "chapter": 31,
              "verse": 17,
              "name": "Mga Awit 31:17",
              "text": "Huwag nawa akong mapahiya, Oh Panginoon; sapagka't ako'y tumawag sa iyo: mapahiya nawa ang masama, magsitahimik nawa sila sa Sheol."
            },
            {
              "chapter": 31,
              "verse": 18,
              "name": "Mga Awit 31:18",
              "text": "Matahimik nawa ang mga sinungaling na labi; na nangagsasalita laban sa matuwid ng kalasuwaan, ng kapalaluan at paghamak."
            },
            {
              "chapter": 31,
              "verse": 19,
              "name": "Mga Awit 31:19",
              "text": "Oh pagkadakila ng iyong kabutihan, na iyong iningatan para sa kanila na nangatatakot sa iyo, na iyong ginawa sa kanila na nagsisipagkanlong sa iyo, sa harap ng mga anak ng mga tao!"
            },
            {
              "chapter": 31,
              "verse": 20,
              "name": "Mga Awit 31:20",
              "text": "Sa lihim ng iyong harapan ay iyong ikukubli sila sa mga banta ng mga tao: iyong iingatan silang lihim sa kulandong mula sa mga talas ng mga dila."
            },
            {
              "chapter": 31,
              "verse": 21,
              "name": "Mga Awit 31:21",
              "text": "Purihin ang Panginoon: sapagka't ipinakilala niya sa akin ang kaniyang kagilagilalas na kagandahang-loob sa isang matibay na bayan."
            },
            {
              "chapter": 31,
              "verse": 22,
              "name": "Mga Awit 31:22",
              "text": "Tungkol sa akin, sinabi ko sa aking pagmamadali, nahiwalay ako sa harap ng iyong mga mata: gayon ma'y dininig mo ang tinig ng aking mga pamanhik, nang ako'y dumaing sa iyo."
            },
            {
              "chapter": 31,
              "verse": 23,
              "name": "Mga Awit 31:23",
              "text": "Oh ibigin ninyo ang Panginoon, ninyong lahat na mga banal niya: pinalalagi ng Panginoon ang tapat, at pinanghihigantihang lubos ang manggagawang palalo."
            },
            {
              "chapter": 31,
              "verse": 24,
              "name": "Mga Awit 31:24",
              "text": "Kayo'y mangagpakalakas, at mangagdalang tapang ang inyong puso, kayong lahat na nagsisiasa sa Panginoon."
            }
          ]
        },
        {
          "chapter": 32,
          "name": "Mga Awit 32",
          "verses": [
            {
              "chapter": 32,
              "verse": 1,
              "name": "Mga Awit 32:1",
              "text": "Mapalad siyang pinatawad ng pagsalangsang, na tinakpan ang kasalanan."
            },
            {
              "chapter": 32,
              "verse": 2,
              "name": "Mga Awit 32:2",
              "text": "Mapalad ang tao na hindi paratangan ng kasamaan ng Panginoon, at walang pagdaraya ang diwa niya."
            },
            {
              "chapter": 32,
              "verse": 3,
              "name": "Mga Awit 32:3",
              "text": "Nang ako'y tumahimik, ay nanglumo ang aking mga buto dahil sa aking pagangal buong araw."
            },
            {
              "chapter": 32,
              "verse": 4,
              "name": "Mga Awit 32:4",
              "text": "Sapagka't araw at gabi ay mabigat sa akin ang iyong kamay: ang aking lamig ng katawan ay naging katuyuan ng taginit. (Selah)"
            },
            {
              "chapter": 32,
              "verse": 5,
              "name": "Mga Awit 32:5",
              "text": "Aking kinilala ang aking kasalanan sa iyo, at ang aking kasamaan ay hindi ko ikinubli: aking sinabi, aking ipahahayag ang aking pagsalangsang sa Panginoon; at iyong ipinatawad ang kasamaan ng aking kasalanan."
            },
            {
              "chapter": 32,
              "verse": 6,
              "name": "Mga Awit 32:6",
              "text": "Dahil dito'y dalanginan ka nawa ng bawa't isa na banal sa panahong masusumpungan ka: tunay na pagka ang mga malaking tubig ay nagsisiapaw ay hindi aabutan nila siya."
            },
            {
              "chapter": 32,
              "verse": 7,
              "name": "Mga Awit 32:7",
              "text": "Ikaw ay aking kublihang dako; iyong iingatan ako sa kabagabagan; iyong kukulungin ako sa palibot ng mga awit ng kaligtasan. (Selah)"
            },
            {
              "chapter": 32,
              "verse": 8,
              "name": "Mga Awit 32:8",
              "text": "Aking ipaaalam sa iyo at ituturo sa iyo ang daan na iyong lalakaran: papayuhan kita na ang aking mga mata, ay nakatitig sa iyo."
            },
            {
              "chapter": 32,
              "verse": 9,
              "name": "Mga Awit 32:9",
              "text": "Huwag nawa kayong maging gaya ng kabayo, o gaya ng mula na walang unawa: na marapat igayak ng busal at ng paningkaw upang ipangpigil sa kanila, na kung dili'y hindi sila magsisilapit sa iyo."
            },
            {
              "chapter": 32,
              "verse": 10,
              "name": "Mga Awit 32:10",
              "text": "Maraming kapanglawan ay sasapit sa masama: nguni't siyang tumitiwala sa Panginoon, kagandahang-loob ang liligid sa kaniya sa palibot."
            },
            {
              "chapter": 32,
              "verse": 11,
              "name": "Mga Awit 32:11",
              "text": "Kayo'y mangatuwa sa Panginoon, at mangagalak kayo, kayong mga matuwid: at magsihiyaw kayo ng dahil sa kagalakan kayong lahat na matuwid sa puso."
            }
          ]
        },
        {
          "chapter": 33,
          "name": "Mga Awit 33",
          "verses": [
            {
              "chapter": 33,
              "verse": 1,
              "name": "Mga Awit 33:1",
              "text": "Mangagalak kayo sa Panginoon, Oh kayong mga matuwid: pagpuri ay maganda sa ganang matuwid."
            },
            {
              "chapter": 33,
              "verse": 2,
              "name": "Mga Awit 33:2",
              "text": "Kayo'y mangagpasalamat sa Panginoon na may alpa: magsiawit kayo ng mga pagpuri sa kaniya na may salterio na sangpung kuerdas."
            },
            {
              "chapter": 33,
              "verse": 3,
              "name": "Mga Awit 33:3",
              "text": "Magsiawit kayo sa kaniya ng bagong awit; magsitugtog kayong matalino na may malaking ingay."
            },
            {
              "chapter": 33,
              "verse": 4,
              "name": "Mga Awit 33:4",
              "text": "Sapagka't ang salita ng Panginoon ay matuwid; at lahat niyang gawa ay ginawa sa pagtatapat."
            },
            {
              "chapter": 33,
              "verse": 5,
              "name": "Mga Awit 33:5",
              "text": "Iniibig niya ang katuwiran at kahatulan: ang lupa ay puno ng kagandahang-loob ng Panginoon."
            },
            {
              "chapter": 33,
              "verse": 6,
              "name": "Mga Awit 33:6",
              "text": "Sa pamamagitan ng salita ng Panginoon ay nayari ang mga langit; at lahat ng natatanaw roon ay sa pamamagitan ng hinga ng kaniyang bibig."
            },
            {
              "chapter": 33,
              "verse": 7,
              "name": "Mga Awit 33:7",
              "text": "Kaniyang pinipisan ang tubig ng dagat na parang isang bunton: inilalagay niya ang mga kalaliman sa mga kalawakan."
            },
            {
              "chapter": 33,
              "verse": 8,
              "name": "Mga Awit 33:8",
              "text": "Matakot nawa ang buong lupa sa Panginoon: magsitayo nawang may takot ang lahat ng taga sanglibutan sa kaniya."
            },
            {
              "chapter": 33,
              "verse": 9,
              "name": "Mga Awit 33:9",
              "text": "Sapagka't siya'y nagsalita, at nangyari; siya'y nagutos, at tumayong matatag."
            },
            {
              "chapter": 33,
              "verse": 10,
              "name": "Mga Awit 33:10",
              "text": "Dinadala ng Panginoon sa wala ang payo ng mga bansa: kaniyang niwawalang halaga ang mga pagiisip ng mga bayan."
            },
            {
              "chapter": 33,
              "verse": 11,
              "name": "Mga Awit 33:11",
              "text": "Ang payo ng Panginoon ay nanganayong matibay magpakailan man, ang mga pagiisip ng kaniyang puso sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 33,
              "verse": 12,
              "name": "Mga Awit 33:12",
              "text": "Mapalad ang bansa na ang Dios ay ang Panginoon; ang bayan na kaniyang pinili sa ganang kaniyang sariling mana."
            },
            {
              "chapter": 33,
              "verse": 13,
              "name": "Mga Awit 33:13",
              "text": "Ang Panginoon ay tumitingin mula sa langit; kaniyang minamasdan ang lahat na anak ng mga tao;"
            },
            {
              "chapter": 33,
              "verse": 14,
              "name": "Mga Awit 33:14",
              "text": "Mula sa dakong kaniyang tahanan ay tumitingin siya sa lahat na nangananahan sa lupa;"
            },
            {
              "chapter": 33,
              "verse": 15,
              "name": "Mga Awit 33:15",
              "text": "Siyang naghuhugis ng mga puso nilang lahat, na nagmamasid sa lahat nilang mga gawa."
            },
            {
              "chapter": 33,
              "verse": 16,
              "name": "Mga Awit 33:16",
              "text": "Walang hari na nakaliligtas sa pamamagitan ng karamihan ng hukbo: ang makapangyarihang tao ay hindi naliligtas sa pamamagitan ng malaking kalakasan."
            },
            {
              "chapter": 33,
              "verse": 17,
              "name": "Mga Awit 33:17",
              "text": "Ang kabayo ay walang kabuluhang bagay sa pagliligtas: ni hindi niya iniligtas ang sinoman sa pamamagitan ng kaniyang malaking kalakasan;"
            },
            {
              "chapter": 33,
              "verse": 18,
              "name": "Mga Awit 33:18",
              "text": "Narito, ang mata ng Panginoon ay nasa kanila na nangatatakot sa kaniya, sa kanila na nagsisiasa sa kaniyang kagandahang-loob;"
            },
            {
              "chapter": 33,
              "verse": 19,
              "name": "Mga Awit 33:19",
              "text": "Upang iligtas ang kaniyang kaluluwa sa kamatayan, at upang ingatan silang buhay sa kagutom."
            },
            {
              "chapter": 33,
              "verse": 20,
              "name": "Mga Awit 33:20",
              "text": "Hinintay ng aming kaluluwa ang Panginoon: siya'y aming saklolo at aming kalasag."
            },
            {
              "chapter": 33,
              "verse": 21,
              "name": "Mga Awit 33:21",
              "text": "Sapagka't ang aming puso ay magagalak sa kaniya, sapagka't kami ay nagsitiwala sa kaniyang banal na pangalan."
            },
            {
              "chapter": 33,
              "verse": 22,
              "name": "Mga Awit 33:22",
              "text": "Sumaamin nawa ang iyong kagandahang-loob, Oh Panginoon, ayon sa aming pagasa sa iyo."
            }
          ]
        },
        {
          "chapter": 34,
          "name": "Mga Awit 34",
          "verses": [
            {
              "chapter": 34,
              "verse": 1,
              "name": "Mga Awit 34:1",
              "text": "Aking pupurihin ang Panginoon sa buong panahon: ang pagpuri sa kaniya ay laging sasa aking bibig."
            },
            {
              "chapter": 34,
              "verse": 2,
              "name": "Mga Awit 34:2",
              "text": "Ang aking kaluluwa ay maghahambog sa Panginoon: maririnig ng maamo at masasayahan."
            },
            {
              "chapter": 34,
              "verse": 3,
              "name": "Mga Awit 34:3",
              "text": "Oh dakilain ninyo na kasama ko ang Panginoon, at tayo'y mangagbunyi na magkakasama ng kaniyang pangalan."
            },
            {
              "chapter": 34,
              "verse": 4,
              "name": "Mga Awit 34:4",
              "text": "Aking hinanap ang Panginoon, at sinagot niya ako, at iniligtas niya ako sa lahat ng aking mga katakutan."
            },
            {
              "chapter": 34,
              "verse": 5,
              "name": "Mga Awit 34:5",
              "text": "Sila'y nagsitingin sa kaniya, at nangaliwanagan: at ang kanilang mukha ay hindi malilito kailan man."
            },
            {
              "chapter": 34,
              "verse": 6,
              "name": "Mga Awit 34:6",
              "text": "Itong abang tao'y dumaing, at dininig siya ng Panginoon. At iniligtas siya sa lahat niyang mga kabagabagan."
            },
            {
              "chapter": 34,
              "verse": 7,
              "name": "Mga Awit 34:7",
              "text": "Ang anghel ng Panginoon ay humahantong sa buong palibot ng nangatatakot sa kaniya, at ipinagsasanggalang sila."
            },
            {
              "chapter": 34,
              "verse": 8,
              "name": "Mga Awit 34:8",
              "text": "Oh inyong tikman at tingnan ninyo na ang Panginoon ay mabuti: mapalad ang tao na nanganganlong sa kaniya."
            },
            {
              "chapter": 34,
              "verse": 9,
              "name": "Mga Awit 34:9",
              "text": "Oh mangatakot kayo sa Panginoon, kayong mga banal niya: sapagka't walang kakulangan sa kanila na nangatatakot sa kaniya."
            },
            {
              "chapter": 34,
              "verse": 10,
              "name": "Mga Awit 34:10",
              "text": "Ang mga batang leon ay kinakapos at nagtitiis ng gutom. Nguni't silang nagsisihanap sa Panginoon ay hindi kukulangin ng anomang mabuting bagay."
            },
            {
              "chapter": 34,
              "verse": 11,
              "name": "Mga Awit 34:11",
              "text": "Magsiparito kayo, kayong mga anak, dinggin ninyo ako: aking tuturuan kayo ng pagkatakot sa Panginoon."
            },
            {
              "chapter": 34,
              "verse": 12,
              "name": "Mga Awit 34:12",
              "text": "Sinong tao ang nagnanasa ng buhay, at umiibig sa maraming kaarawan upang makakita siya ng mabuti?"
            },
            {
              "chapter": 34,
              "verse": 13,
              "name": "Mga Awit 34:13",
              "text": "Ingatan mo ang iyong dila mula sa masama. At ang iyong mga labi sa pagsasalita ng karayaan."
            },
            {
              "chapter": 34,
              "verse": 14,
              "name": "Mga Awit 34:14",
              "text": "Lumayo ka sa kasamaan, at gumawa ka ng mabuti; hanapin mo ang kapayapaan at habulin mo."
            },
            {
              "chapter": 34,
              "verse": 15,
              "name": "Mga Awit 34:15",
              "text": "Ang mga mata ng Panginoon ay nakatitig sa mga matuwid, at ang kaniyang mga pakinig ay nakabukas sa kanilang daing."
            },
            {
              "chapter": 34,
              "verse": 16,
              "name": "Mga Awit 34:16",
              "text": "Ang mukha ng Panginoon ay laban sa kanila na nagsisigawa ng kasamaan, upang ihiwalay ang alaala sa kanila sa lupa."
            },
            {
              "chapter": 34,
              "verse": 17,
              "name": "Mga Awit 34:17",
              "text": "Ang matuwid ay nagsidaing, at dininig ng Panginoon, at iniligtas sila sa lahat nilang mga kabagabagan."
            },
            {
              "chapter": 34,
              "verse": 18,
              "name": "Mga Awit 34:18",
              "text": "Ang Panginoon ay malapit sa kanila na may bagbag na puso, at inililigtas ang mga may pagsisising diwa."
            },
            {
              "chapter": 34,
              "verse": 19,
              "name": "Mga Awit 34:19",
              "text": "Marami ang kadalamhatian ng matuwid; nguni't inililigtas ng Panginoon sa lahat."
            },
            {
              "chapter": 34,
              "verse": 20,
              "name": "Mga Awit 34:20",
              "text": "Kaniyang iniingatan ang lahat niyang mga buto: wala isa man sa mga yaon na nababali."
            },
            {
              "chapter": 34,
              "verse": 21,
              "name": "Mga Awit 34:21",
              "text": "Papatayin ng kasamaan ang masama: at silang nangagagalit sa matuwid na tao ay kikilanling may sala."
            },
            {
              "chapter": 34,
              "verse": 22,
              "name": "Mga Awit 34:22",
              "text": "Tinutubos ng Panginoon ang kaluluwa ng kaniyang mga lingkod: at wala sa nagsisipagkanlong sa kaniya ay kikilanling may sala."
            }
          ]
        },
        {
          "chapter": 35,
          "name": "Mga Awit 35",
          "verses": [
            {
              "chapter": 35,
              "verse": 1,
              "name": "Mga Awit 35:1",
              "text": "Awayin mo, Oh Panginoon, silang nagsisiaway sa akin: lumaban ka sa kanila na nagsisilaban sa akin."
            },
            {
              "chapter": 35,
              "verse": 2,
              "name": "Mga Awit 35:2",
              "text": "Humawak ka ng kalasag at ng longki, at tumayo ka na pinaka tulong sa akin."
            },
            {
              "chapter": 35,
              "verse": 3,
              "name": "Mga Awit 35:3",
              "text": "Kumuha ka rin naman ng sibat, at tumigil ka sa daan laban sa kanila na nagsisihabol sa akin: sabihin mo sa aking kaluluwa, Ako'y iyong kaligtasan."
            },
            {
              "chapter": 35,
              "verse": 4,
              "name": "Mga Awit 35:4",
              "text": "Mangahiya nawa sila, at madala sa kasiraang puri ang nagsisiusig sa aking kaluluwa: mangapabalik sila, at mangalito silang nagsisikatha ng aking kapahamakan."
            },
            {
              "chapter": 35,
              "verse": 5,
              "name": "Mga Awit 35:5",
              "text": "Maging gaya nawa sila ng ipa sa unahan ng hangin, at itaboy sila ng anghel ng Panginoon."
            },
            {
              "chapter": 35,
              "verse": 6,
              "name": "Mga Awit 35:6",
              "text": "Maging madilim nawa, at madulas ang kanilang daan, at habulin sila ng anghel ng Panginoon."
            },
            {
              "chapter": 35,
              "verse": 7,
              "name": "Mga Awit 35:7",
              "text": "Sapagka't walang kadahilanan ay ipinagkubli nila ako ng kanilang silo sa hukay, walang kadahilanan ay nagsihukay sila para sa aking kaluluwa."
            },
            {
              "chapter": 35,
              "verse": 8,
              "name": "Mga Awit 35:8",
              "text": "Dumating nawa sa kaniya ng walang anoano ang pagkapahamak; at hulihin nawa siya ng kaniyang silo na kaniyang ikinubli: mahulog nawa siya sa ikapapahamak niya."
            },
            {
              "chapter": 35,
              "verse": 9,
              "name": "Mga Awit 35:9",
              "text": "At ang aking kaluluwa ay magagalak sa Panginoon: magagalak na mainam sa kaniyang pagliligtas."
            },
            {
              "chapter": 35,
              "verse": 10,
              "name": "Mga Awit 35:10",
              "text": "Lahat ng aking mga buto ay magsasabi, Panginoon, sino ang gaya mo, na inililigtas ang dukha doon sa totoong malakas kay sa kaniya, Oo, ang dukha at ang mapagkailangan sa sumasamsam sa kaniya?"
            },
            {
              "chapter": 35,
              "verse": 11,
              "name": "Mga Awit 35:11",
              "text": "Mga saksing masasama ay nagsisitayo; sila'y nangagtatanong sa akin ng mga bagay na di ko nalalaman."
            },
            {
              "chapter": 35,
              "verse": 12,
              "name": "Mga Awit 35:12",
              "text": "Iginaganti nila sa akin ay kasamaan sa mabuti, sa pagpapaulila ng aking kaluluwa."
            },
            {
              "chapter": 35,
              "verse": 13,
              "name": "Mga Awit 35:13",
              "text": "Nguni't tungkol sa akin, nang sila'y may sakit, ang aking suot ay magaspang na kayo: aking pinagdalamhati ang aking kaluluwa ng pagaayuno; at ang aking dalangin ay nagbabalik sa aking sariling sinapupunan."
            },
            {
              "chapter": 35,
              "verse": 14,
              "name": "Mga Awit 35:14",
              "text": "Ako'y nagasal na tila aking kaibigan o aking kapatid: ako'y yumuyukong tumatangis na tila iniiyakan ang kaniyang ina."
            },
            {
              "chapter": 35,
              "verse": 15,
              "name": "Mga Awit 35:15",
              "text": "Nguni't pagka ako'y natisod sila'y nangagagalak, at nagpipisan: ang mga uslak ay nagpipisan laban sa akin, at hindi ko nalaman;"
            },
            {
              "chapter": 35,
              "verse": 16,
              "name": "Mga Awit 35:16",
              "text": "Gaya ng mga nanunuyang suwail sa mga kapistahan, kanilang pinagngangalit sa akin ang kanilang mga ngipin."
            },
            {
              "chapter": 35,
              "verse": 17,
              "name": "Mga Awit 35:17",
              "text": "Panginoon, hanggang kailan titingin ka? Iligtas mo ang aking kaluluwa sa kanilang mga pagsira, ang aking sinta mula sa mga leon."
            },
            {
              "chapter": 35,
              "verse": 18,
              "name": "Mga Awit 35:18",
              "text": "Ako'y magpapasalamat sa iyo sa dakilang kapisanan: aking pupurihin ka sa gitna ng maraming tao."
            },
            {
              "chapter": 35,
              "verse": 19,
              "name": "Mga Awit 35:19",
              "text": "Huwag magalak sa akin na may kamalian ang aking mga kaaway; ni magkindat man ng mata ang nangagtatanim sa akin ng walang kadahilanan."
            },
            {
              "chapter": 35,
              "verse": 20,
              "name": "Mga Awit 35:20",
              "text": "Sapagka't sila'y hindi nangagsasalita ng kapayapaan: kundi sila'y nagsisikatha ng mga magdarayang salita laban sa mga tahimik sa lupain."
            },
            {
              "chapter": 35,
              "verse": 21,
              "name": "Mga Awit 35:21",
              "text": "Oo, kanilang ibinuka ng maluwang ang kanilang bibig laban sa akin; kanilang sinasabi: Aha, aha, nakita ng aming mata."
            },
            {
              "chapter": 35,
              "verse": 22,
              "name": "Mga Awit 35:22",
              "text": "Iyong nakita ito, Oh Panginoon; huwag kang tumahimik, Oh Panginoon, huwag kang lumayo sa akin."
            },
            {
              "chapter": 35,
              "verse": 23,
              "name": "Mga Awit 35:23",
              "text": "Kumilos ka, at ikaw ay gumising upang gawan ako ng kahatulan, sa aking usap, Dios ko at Panginoon ko."
            },
            {
              "chapter": 35,
              "verse": 24,
              "name": "Mga Awit 35:24",
              "text": "Hatulan mo ako, Oh Panginoon kong Dios, ayon sa iyong katuwiran; at huwag mo silang pagalakin sa akin."
            },
            {
              "chapter": 35,
              "verse": 25,
              "name": "Mga Awit 35:25",
              "text": "Huwag silang magsabi sa kanilang sarili: Aha, nasa namin: huwag silang magsabi: Aming sinakmal siya."
            },
            {
              "chapter": 35,
              "verse": 26,
              "name": "Mga Awit 35:26",
              "text": "Mangapahiya nawa sila, at mangalito na magkakasama ang mga nangagalak sa aking pagkapahamak: manganamit nawa ng kahihiyan at kasiraang puri ang nangagmamalaki laban sa akin."
            },
            {
              "chapter": 35,
              "verse": 27,
              "name": "Mga Awit 35:27",
              "text": "Magsihiyaw nawa ng kagalakan, at mangasayahan, ang nagsisilingap ng aking katuwiran: Oo, mangagsabi nawa silang palagi: Dakilain ang Panginoon, na nalulugod sa kaginhawahan ng kaniyang lingkod."
            },
            {
              "chapter": 35,
              "verse": 28,
              "name": "Mga Awit 35:28",
              "text": "At ang aking dila ay mangungusap ng iyong katuwiran, at ng pagpuri sa iyo sa buong araw."
            }
          ]
        },
        {
          "chapter": 36,
          "name": "Mga Awit 36",
          "verses": [
            {
              "chapter": 36,
              "verse": 1,
              "name": "Mga Awit 36:1",
              "text": "Ang pagsalangsang ng masama ay nagsasabi sa loob ng aking puso: walang takot sa Dios sa harap ng kaniyang mga mata."
            },
            {
              "chapter": 36,
              "verse": 2,
              "name": "Mga Awit 36:2",
              "text": "Sapagka't siya'y nanghihibo ng kaniyang sariling mga mata, na ang kaniyang kasamaan ay hindi masusumpungan at pagtataniman."
            },
            {
              "chapter": 36,
              "verse": 3,
              "name": "Mga Awit 36:3",
              "text": "Ang mga salita ng kaniyang bibig ay kasamaan at karayaan: iniwan niya ang pagkapantas at paggawa ng mabuti."
            },
            {
              "chapter": 36,
              "verse": 4,
              "name": "Mga Awit 36:4",
              "text": "Siya'y kumakatha ng kasamaan sa kaniyang higaan; siya'y lumagay sa isang daan na hindi mabuti; hindi niya kinayayamutan ang kasamaan."
            },
            {
              "chapter": 36,
              "verse": 5,
              "name": "Mga Awit 36:5",
              "text": "Ang iyong kagandahang-loob, Oh Panginoon, ay nasa mga langit: ang iyong pagtatapat ay umaabot hanggang sa langit."
            },
            {
              "chapter": 36,
              "verse": 6,
              "name": "Mga Awit 36:6",
              "text": "Ang iyong katuwiran ay gaya ng mga bundok ng Dios: ang iyong mga kahatulan ay dakilang kalaliman: Oh Panginoon, iyong iniingatan ang tao at hayop."
            },
            {
              "chapter": 36,
              "verse": 7,
              "name": "Mga Awit 36:7",
              "text": "Napaka mahalaga ng iyong kagandahang-loob, Oh Dios! At ang mga anak ng mga tao ay nanganganlong sa ilalim ng iyong mga pakpak."
            },
            {
              "chapter": 36,
              "verse": 8,
              "name": "Mga Awit 36:8",
              "text": "Sila'y nangabubusog ng sagana ng katabaan ng iyong bahay; at iyong paiinumin sila sa ilog ng iyong kaluguran."
            },
            {
              "chapter": 36,
              "verse": 9,
              "name": "Mga Awit 36:9",
              "text": "Sapagka't nasa iyo ang bukal ng buhay: sa iyong liwanag makakakita kami ng liwanag."
            },
            {
              "chapter": 36,
              "verse": 10,
              "name": "Mga Awit 36:10",
              "text": "Oh, ilagi mo nawa ang iyong kagandahang-loob sa kanila na nangakakakilala sa iyo: at ang iyong katuwiran sa matuwid sa puso."
            },
            {
              "chapter": 36,
              "verse": 11,
              "name": "Mga Awit 36:11",
              "text": "Huwag nawang dumating laban sa akin ang paa ng kapalaluan, at huwag nawa akong itaboy ng kamay ng masama."
            },
            {
              "chapter": 36,
              "verse": 12,
              "name": "Mga Awit 36:12",
              "text": "Doo'y nangabuwal ang mga manggagawa ng kasamaan: sila'y nangalugmok at hindi makakatindig."
            }
          ]
        },
        {
          "chapter": 37,
          "name": "Mga Awit 37",
          "verses": [
            {
              "chapter": 37,
              "verse": 1,
              "name": "Mga Awit 37:1",
              "text": "Huwag kang mabalisa dahil sa mga manggagawa ng kasamaan, ni managhili ka man sa kanila na nagsisigawa ng kalikuan."
            },
            {
              "chapter": 37,
              "verse": 2,
              "name": "Mga Awit 37:2",
              "text": "Sapagka't sila'y madaling puputuling gaya ng damo, at matutuyong gaya ng sariwang damo."
            },
            {
              "chapter": 37,
              "verse": 3,
              "name": "Mga Awit 37:3",
              "text": "Tumiwala ka sa Panginoon, at gumawa ka ng mabuti; tumahan ka sa lupain, at gawin mong kumain sa kaniyang pagkatapat."
            },
            {
              "chapter": 37,
              "verse": 4,
              "name": "Mga Awit 37:4",
              "text": "Magpakaligaya ka naman sa Panginoon; at bibigyan ka niya ng nasa ng iyong puso."
            },
            {
              "chapter": 37,
              "verse": 5,
              "name": "Mga Awit 37:5",
              "text": "Ihabilin mo ang iyong lakad sa Panginoon; tumiwala ka rin naman sa kaniya, at kaniyang papangyayarihin."
            },
            {
              "chapter": 37,
              "verse": 6,
              "name": "Mga Awit 37:6",
              "text": "At kaniyang palalabasing gaya ng liwanag ang iyong katuwiran, at ang iyong kahatulan ay gaya ng katanghaliang tapat."
            },
            {
              "chapter": 37,
              "verse": 7,
              "name": "Mga Awit 37:7",
              "text": "Ikaw ay magpahinga sa Panginoon, at maghintay kang may pagtitiis sa kaniya: huwag kang mabalisa ng dahil sa kaniya na gumiginhawa sa kaniyang lakad, dahil sa lalake na nagpapangyari ng mga masamang katha."
            },
            {
              "chapter": 37,
              "verse": 8,
              "name": "Mga Awit 37:8",
              "text": "Maglikat ka ng pagkagalit, at bayaan mo ang poot: huwag kang mabalisa, iya'y maghahatid lamang sa paggawa ng kasamaan."
            },
            {
              "chapter": 37,
              "verse": 9,
              "name": "Mga Awit 37:9",
              "text": "Sapagka't ang mga manggagawa ng kasamaan ay mangahihiwalay: nguni't yaong nagsipaghintay sa Panginoon, ay mangagmamana sila ng lupain."
            },
            {
              "chapter": 37,
              "verse": 10,
              "name": "Mga Awit 37:10",
              "text": "Sapagka't sangdali na lamang, at ang masama ay mawawala na: Oo, iyong uusisaing mainam ang kaniyang dako, at siya'y mawawala na."
            },
            {
              "chapter": 37,
              "verse": 11,
              "name": "Mga Awit 37:11",
              "text": "Nguni't ang maamo ay magmamana ng lupain, at masasayahan sa kasaganaan ng kapayapaan."
            },
            {
              "chapter": 37,
              "verse": 12,
              "name": "Mga Awit 37:12",
              "text": "Ang masama ay kumakatha laban sa ganap, at pinagngangalit sa kaniya ang kaniyang mga ngipin."
            },
            {
              "chapter": 37,
              "verse": 13,
              "name": "Mga Awit 37:13",
              "text": "Tatawanan siya ng Panginoon: sapagka't kaniyang nakikita na ang kaniyang kaarawan ay dumarating."
            },
            {
              "chapter": 37,
              "verse": 14,
              "name": "Mga Awit 37:14",
              "text": "Hinugot ng masama ang tabak, at inihanda ang kanilang busog: upang ilugmok ang dukha at mapagkailangan, upang patayin ang matuwid sa paglakad:"
            },
            {
              "chapter": 37,
              "verse": 15,
              "name": "Mga Awit 37:15",
              "text": "Ang kanilang tabak ay masasaksak sa kanilang sariling puso, at ang kanilang busog ay mababali."
            },
            {
              "chapter": 37,
              "verse": 16,
              "name": "Mga Awit 37:16",
              "text": "Mainam ang kaunti na tinatangkilik ng matuwid, kay sa kasaganaan ng maraming masama."
            },
            {
              "chapter": 37,
              "verse": 17,
              "name": "Mga Awit 37:17",
              "text": "Sapagka't ang mga bisig ng masasama ay mangababali: nguni't inaalalayan ng Panginoon ang matuwid."
            },
            {
              "chapter": 37,
              "verse": 18,
              "name": "Mga Awit 37:18",
              "text": "Nalalaman ng Panginoon ang kaarawan ng sakdal: at ang kanilang mana ay magiging sa magpakailan man."
            },
            {
              "chapter": 37,
              "verse": 19,
              "name": "Mga Awit 37:19",
              "text": "Hindi sila mangapapahiya sa panahon ng kasamaan: at sa mga kaarawan ng kagutom ay mangabubusog sila."
            },
            {
              "chapter": 37,
              "verse": 20,
              "name": "Mga Awit 37:20",
              "text": "Nguni't ang masama ay mamamatay, at ang mga kaaway ng Panginoon ay magiging gaya ng taba ng mga kordero: sila'y mangapupugnaw: sa usok mangapupugnaw sila."
            },
            {
              "chapter": 37,
              "verse": 21,
              "name": "Mga Awit 37:21",
              "text": "Ang masama ay humihiram, at hindi nagsasauli: nguni't ang matuwid ay nahahabag, at nagbibigay."
            },
            {
              "chapter": 37,
              "verse": 22,
              "name": "Mga Awit 37:22",
              "text": "Sapagka't ang mga gayong pinagpala ng Panginoon ay mangagmamana ng lupain; at silang sinumpa niya ay mahihiwalay."
            },
            {
              "chapter": 37,
              "verse": 23,
              "name": "Mga Awit 37:23",
              "text": "Ang lakad ng tao ay itinatag ng Panginoon; at siya'y nasasayahan sa kaniyang lakad."
            },
            {
              "chapter": 37,
              "verse": 24,
              "name": "Mga Awit 37:24",
              "text": "Bagaman siya'y mabuwal, hindi siya lubos na mapapahiga: Sapagka't inaalalayan siya ng Panginoon ng kaniyang kamay."
            },
            {
              "chapter": 37,
              "verse": 25,
              "name": "Mga Awit 37:25",
              "text": "Ako'y naging bata, at ngayo'y matanda; gayon ma'y hindi ko nakita ang matuwid na pinabayaan, ni ang kaniyang lahi man ay nagpapalimos ng tinapay."
            },
            {
              "chapter": 37,
              "verse": 26,
              "name": "Mga Awit 37:26",
              "text": "Lahat ng araw ay nahahabag, at nagpapahiram; at ang kaniyang lahi ay pinagpapala."
            },
            {
              "chapter": 37,
              "verse": 27,
              "name": "Mga Awit 37:27",
              "text": "Ikaw ay humiwalay sa kasamaan, at gumawa ka ng mabuti; at manahan ka magpakailan man."
            },
            {
              "chapter": 37,
              "verse": 28,
              "name": "Mga Awit 37:28",
              "text": "Sapagka't iniibig ng Panginoon ang kahatulan, at hindi pinababayaan ang kaniyang mga banal; sila'y iniingatan magpakailan man: nguni't ang lahi ng masama ay mahihiwalay."
            },
            {
              "chapter": 37,
              "verse": 29,
              "name": "Mga Awit 37:29",
              "text": "Mamanahin ng matuwid ang lupain, at tatahan doon magpakailan man."
            },
            {
              "chapter": 37,
              "verse": 30,
              "name": "Mga Awit 37:30",
              "text": "Ang bibig ng matuwid ay nangungusap ng karunungan, at ang kaniyang dila ay nagsasalita ng kahatulan."
            },
            {
              "chapter": 37,
              "verse": 31,
              "name": "Mga Awit 37:31",
              "text": "Ang kautusan ng kaniyang Dios ay nasa kaniyang puso, walang madudulas sa kaniyang mga hakbang."
            },
            {
              "chapter": 37,
              "verse": 32,
              "name": "Mga Awit 37:32",
              "text": "Inaabatan ng masama ang matuwid, at pinagsisikapang patayin niya siya."
            },
            {
              "chapter": 37,
              "verse": 33,
              "name": "Mga Awit 37:33",
              "text": "Hindi siya iiwan ng Panginoon sa kaniyang kamay, ni parurusahan man siya pagka siya'y nahatulan."
            },
            {
              "chapter": 37,
              "verse": 34,
              "name": "Mga Awit 37:34",
              "text": "Hintayin mo ang Panginoon, at ingatan mo ang kaniyang daan, at ibubunyi ka upang manahin mo ang lupain: pagka nahiwalay ang masama, iyong makikita."
            },
            {
              "chapter": 37,
              "verse": 35,
              "name": "Mga Awit 37:35",
              "text": "Aking nakita ang masama sa malaking kapangyarihan, at lumalaganap na gaya ng sariwang punong kahoy sa kaniyang lupang tinubuan."
            },
            {
              "chapter": 37,
              "verse": 36,
              "name": "Mga Awit 37:36",
              "text": "Nguni't may dumaan at, narito, wala na siya: Oo, hinanap ko siya, nguni't hindi siya masumpungan."
            },
            {
              "chapter": 37,
              "verse": 37,
              "name": "Mga Awit 37:37",
              "text": "Tandaan mo ang sakdal na tao, at masdan mo ang matuwid: sapagka't may isang maligayang wakas sa taong may kapayapaan."
            },
            {
              "chapter": 37,
              "verse": 38,
              "name": "Mga Awit 37:38",
              "text": "Tungkol sa mga mananalangsang, mangalilipol silang magkakasama: ang huling wakas ng masama ay mahihiwalay."
            },
            {
              "chapter": 37,
              "verse": 39,
              "name": "Mga Awit 37:39",
              "text": "Nguni't ang kaligtasan ng matuwid ay sa Panginoon: siya'y ang kanilang kuta sa panahon ng kabagabagan."
            },
            {
              "chapter": 37,
              "verse": 40,
              "name": "Mga Awit 37:40",
              "text": "At sila'y tinutulungan ng Panginoon, at sinasagip sila: sinasagip niya sila sa masama, at inililigtas sila. Sapagka't sila'y nagsipagkanlong sa kaniya."
            }
          ]
        },
        {
          "chapter": 38,
          "name": "Mga Awit 38",
          "verses": [
            {
              "chapter": 38,
              "verse": 1,
              "name": "Mga Awit 38:1",
              "text": "Oh Panginoon, huwag mo akong sawayin sa iyong pag-iinit: ni parusahan mo man ako sa iyong mahigpit na sama ng loob."
            },
            {
              "chapter": 38,
              "verse": 2,
              "name": "Mga Awit 38:2",
              "text": "Sapagka't ang iyong mga pana ay nagsitimo sa akin, at pinipisil akong mainam ng iyong kamay."
            },
            {
              "chapter": 38,
              "verse": 3,
              "name": "Mga Awit 38:3",
              "text": "Walang kagalingan sa aking laman dahil sa iyong pagkagalit; ni may kaginhawahan man sa aking mga buto dahil sa aking kasalanan."
            },
            {
              "chapter": 38,
              "verse": 4,
              "name": "Mga Awit 38:4",
              "text": "Sapagka't ang aking mga kasamaan ay nagsidaan sa ibabaw ng aking ulo: gaya ng isang pasang mabigat ay napakabigat sa akin."
            },
            {
              "chapter": 38,
              "verse": 5,
              "name": "Mga Awit 38:5",
              "text": "Ang aking mga sugat ay mabaho, at putokputok, dahil sa aking kamangmangan."
            },
            {
              "chapter": 38,
              "verse": 6,
              "name": "Mga Awit 38:6",
              "text": "Ako'y nahirapan at ako'y nahukot; ako'y tumatangis buong araw."
            },
            {
              "chapter": 38,
              "verse": 7,
              "name": "Mga Awit 38:7",
              "text": "Sapagka't ang aking mga balakang ay lipos ng hirap; at walang kagalingan sa aking laman."
            },
            {
              "chapter": 38,
              "verse": 8,
              "name": "Mga Awit 38:8",
              "text": "Ako'y nanglalata, at bugbog na mainam: ako'y umangal dahil sa kaba ng aking loob."
            },
            {
              "chapter": 38,
              "verse": 9,
              "name": "Mga Awit 38:9",
              "text": "Panginoon, lahat ng aking nais ay nasa harap mo; at ang aking hibik ay hindi lingid sa iyo."
            },
            {
              "chapter": 38,
              "verse": 10,
              "name": "Mga Awit 38:10",
              "text": "Ang aking loob ay kakabakaba, ang aking kalakasan ay nanglalata: tungkol sa liwanag ng aking mga mata, ay napawi rin ito sa akin."
            },
            {
              "chapter": 38,
              "verse": 11,
              "name": "Mga Awit 38:11",
              "text": "Ang mga mangliligaw at mga kaibigan ko ay nangatayong malayo sa aking paghihirap; at ang aking mga kamaganak ay nakalayo."
            },
            {
              "chapter": 38,
              "verse": 12,
              "name": "Mga Awit 38:12",
              "text": "Sila namang nangaguusig ng aking buhay ay nangaglagay ng mga silo na ukol sa akin; at silang nagsisihanap ng aking ikapapahamak ay nangagsasalita ng mga masasamang bagay, at nangagiisip ng pagdaraya buong araw."
            },
            {
              "chapter": 38,
              "verse": 13,
              "name": "Mga Awit 38:13",
              "text": "Nguni't ako'y gaya ng binging tao, na hindi nakakarinig; at ako'y gaya ng piping tao, na hindi ibinubuka ang kaniyang bibig."
            },
            {
              "chapter": 38,
              "verse": 14,
              "name": "Mga Awit 38:14",
              "text": "Oo, ako'y gaya ng tao na hindi nakakarinig, at sa kaniyang bibig ay walang mga kasawayan."
            },
            {
              "chapter": 38,
              "verse": 15,
              "name": "Mga Awit 38:15",
              "text": "Sapagka't sa iyo, Oh Panginoon ay umaasa ako: ikaw ay sasagot, Oh Panginoon kong Dios."
            },
            {
              "chapter": 38,
              "verse": 16,
              "name": "Mga Awit 38:16",
              "text": "Sapagka't aking sinabi: Baka ako'y kagalakan nila: pagka ang aking paa ay nadudulas, ay nagsisipagmataas sila laban sa akin."
            },
            {
              "chapter": 38,
              "verse": 17,
              "name": "Mga Awit 38:17",
              "text": "Sapagka't ako'y madali ng mahulog, at ang aking kapanglawan ay laging nasa harap ko."
            },
            {
              "chapter": 38,
              "verse": 18,
              "name": "Mga Awit 38:18",
              "text": "Sapagka't aking ipahahayag ang aking kasamaan; aking ikamamanglaw ang aking kasalanan."
            },
            {
              "chapter": 38,
              "verse": 19,
              "name": "Mga Awit 38:19",
              "text": "Nguni't ang aking mga kaaway ay buhay at malalakas: at silang nangagtatanim sa akin na may kamalian ay dumami."
            },
            {
              "chapter": 38,
              "verse": 20,
              "name": "Mga Awit 38:20",
              "text": "Sila namang nangagbabayad ng kasamaan sa mabuti ay mga kaaway ko, sapagka't aking sinunod ang bagay na mabuti."
            },
            {
              "chapter": 38,
              "verse": 21,
              "name": "Mga Awit 38:21",
              "text": "Huwag mo akong pabayaan, Oh Panginoon: Oh Dios ko, huwag kang lumayo sa akin."
            },
            {
              "chapter": 38,
              "verse": 22,
              "name": "Mga Awit 38:22",
              "text": "Magmadali kang tulungan mo ako, Oh Panginoon na aking kaligtasan."
            }
          ]
        },
        {
          "chapter": 39,
          "name": "Mga Awit 39",
          "verses": [
            {
              "chapter": 39,
              "verse": 1,
              "name": "Mga Awit 39:1",
              "text": "Aking sinabi, ako'y magiingat sa aking mga lakad, upang huwag akong magkasala ng aking dila: aking iingatan ang aking dila ng paningkaw, samantalang ang masama ay nasa harap ko."
            },
            {
              "chapter": 39,
              "verse": 2,
              "name": "Mga Awit 39:2",
              "text": "Ako'y napipi ng pagtahimik, ako'y tumahimik pati sa mabuti; at ang aking kalungkutan ay lumubha."
            },
            {
              "chapter": 39,
              "verse": 3,
              "name": "Mga Awit 39:3",
              "text": "Ang aking puso ay mainit sa loob ko; habang ako'y nagbubulaybulay ay nagalab ang apoy: nang magkagayo'y nagsalita ako ng aking dila:"
            },
            {
              "chapter": 39,
              "verse": 4,
              "name": "Mga Awit 39:4",
              "text": "Panginoon, ipakilala mo sa akin ang aking wakas, at ang sukat ng aking mga kaarawan, kung ano; ipakilala mo sa akin kung gaano kahina ako."
            },
            {
              "chapter": 39,
              "verse": 5,
              "name": "Mga Awit 39:5",
              "text": "Narito, gaya ng mga dangkal ginawa mo ang aking mga kaarawan; at ang aking gulang ay tila wala sa harap mo: tunay na bawa't tao sa kaniyang mainam na kalagayan ay pawang walang kabuluhan. (Selah)"
            },
            {
              "chapter": 39,
              "verse": 6,
              "name": "Mga Awit 39:6",
              "text": "Tunay na bawa't tao ay lumalakad sa walang kabuluhang lilim: tunay na sila'y nagugulo ng walang kabuluhan: kaniyang ibinubunton ang mga kayamanan, at hindi nalalaman kung sinong nagsisipulot."
            },
            {
              "chapter": 39,
              "verse": 7,
              "name": "Mga Awit 39:7",
              "text": "At ngayon, Panginoon, ano pa ang aking hinihintay? Ang aking pagasa ay nasa iyo."
            },
            {
              "chapter": 39,
              "verse": 8,
              "name": "Mga Awit 39:8",
              "text": "Iligtas mo ako sa lahat ng aking mga pagsalangsang: huwag mo akong gawing katuyaan ng hangal."
            },
            {
              "chapter": 39,
              "verse": 9,
              "name": "Mga Awit 39:9",
              "text": "Ako'y pipi, hindi ko ibinuka ang aking bibig; sapagka't ikaw ang gumawa."
            },
            {
              "chapter": 39,
              "verse": 10,
              "name": "Mga Awit 39:10",
              "text": "Iurong mo sa akin ang iyong suntok: ako'y bugbog na sa suntok ng iyong kamay."
            },
            {
              "chapter": 39,
              "verse": 11,
              "name": "Mga Awit 39:11",
              "text": "Pagka sa pamamagitan ng mga parusa dahil sa kasamaan ay iyong sinasaway ang tao, iyong sinisira ang kaniyang kagandahan na parang pagsira ng tanga: tunay na bawa't tao ay walang kabuluhan. (Selah)"
            },
            {
              "chapter": 39,
              "verse": 12,
              "name": "Mga Awit 39:12",
              "text": "Iyong dinggin ang aking dalangin, Oh Panginoon, at pakinggan mo ang aking daing: huwag kang tumahimik sa aking mga luha: sapagka't ako'y taga ibang lupa na kasama mo; nakikipamayan na gaya ng lahat na aking mga magulang."
            },
            {
              "chapter": 39,
              "verse": 13,
              "name": "Mga Awit 39:13",
              "text": "Oh tulungan mo ako, upang ako'y magbawing lakas, Bago ako manaw, at mawala."
            }
          ]
        },
        {
          "chapter": 40,
          "name": "Mga Awit 40",
          "verses": [
            {
              "chapter": 40,
              "verse": 1,
              "name": "Mga Awit 40:1",
              "text": "Aking hinintay na may pagtitiis ang Panginoon; at siya'y kumiling sa akin, at dininig ang aking daing."
            },
            {
              "chapter": 40,
              "verse": 2,
              "name": "Mga Awit 40:2",
              "text": "Isinampa naman niya ako mula sa isang kakilakilabot na balon, mula sa balahong malagkit; at itinuntong niya ang aking mga paa sa isang malaking bato, at itinatag ang aking mga paglakad."
            },
            {
              "chapter": 40,
              "verse": 3,
              "name": "Mga Awit 40:3",
              "text": "At siya'y naglagay ng bagong awit sa aking bibig, sa makatuwid baga'y pagpuri sa aming Dios: marami ang mangakakakita at mangatatakot, at magsisitiwala sa Panginoon."
            },
            {
              "chapter": 40,
              "verse": 4,
              "name": "Mga Awit 40:4",
              "text": "Mapalad ang tao na ginagawang kaniyang tiwala ang Panginoon, at hindi iginagalang ang palalo, ni ang mga naliligaw man sa pagsunod sa mga kabulaanan."
            },
            {
              "chapter": 40,
              "verse": 5,
              "name": "Mga Awit 40:5",
              "text": "Marami, Oh Panginoon kong Dios, ang mga kagilagilalas na mga gawa na iyong ginawa, at ang iyong mga pagiisip sa amin: hindi malalagay na maayos sa harap mo; kung ako'y magpapahayag at sasalitain ko sila, sila'y higit kay sa mabibilang."
            },
            {
              "chapter": 40,
              "verse": 6,
              "name": "Mga Awit 40:6",
              "text": "Hain at handog ay hindi mo kinaluluguran; ang aking pakinig ay iyong binuksan: handog na susunugin, at handog tungkol sa kasalanan ay hindi mo hiningi."
            },
            {
              "chapter": 40,
              "verse": 7,
              "name": "Mga Awit 40:7",
              "text": "Nang magkagayo'y sinabi ko: Narito, dumating ako; sa balumbon ng aklat ay nakasulat tungkol sa akin:"
            },
            {
              "chapter": 40,
              "verse": 8,
              "name": "Mga Awit 40:8",
              "text": "Aking kinalulugurang sundin ang iyong kalooban, Oh Dios ko; Oo, ang iyong kautusan ay nasa loob ng aking puso."
            },
            {
              "chapter": 40,
              "verse": 9,
              "name": "Mga Awit 40:9",
              "text": "Ako'y nagpahayag ng mabuting balita ng katuwiran sa dakilang kapisanan; narito, hindi ko pipigilin ang aking mga labi, Oh Panginoon, iyong nalalaman."
            },
            {
              "chapter": 40,
              "verse": 10,
              "name": "Mga Awit 40:10",
              "text": "Hindi ko ikinubli ang iyong katuwiran sa loob ng aking puso; aking ibinalita ang iyong pagtatapat, at ang iyong pagliligtas: hindi ko inilihim ang iyong kagandahang-loob at ang iyong katotohanan sa dakilang kapisanan."
            },
            {
              "chapter": 40,
              "verse": 11,
              "name": "Mga Awit 40:11",
              "text": "Huwag mong pigilin sa akin ang iyong mga malumanay na kaawaan, Oh Panginoon: panatilihin mong lagi sa akin ang iyong kagandahang-loob at ang iyong katotohanan."
            },
            {
              "chapter": 40,
              "verse": 12,
              "name": "Mga Awit 40:12",
              "text": "Sapagka't kinulong ako ng walang bilang na kasamaan. Ang mga kasamaan ko ay umabot sa akin, na anopa't hindi ako makatingin; sila'y higit kay sa mga buhok ng aking ulo, at ang aking puso ay nagpalata sa akin."
            },
            {
              "chapter": 40,
              "verse": 13,
              "name": "Mga Awit 40:13",
              "text": "Kalugdan mo nawa, Oh Panginoon, na iligtas ako: Ikaw ay magmadaling tulungan mo ako, Oh Panginoon."
            },
            {
              "chapter": 40,
              "verse": 14,
              "name": "Mga Awit 40:14",
              "text": "Sila'y mangapahiya nawa at mangatulig na magkakasama na nagsisiusig ng aking kaluluwa upang ipahamak: Sila nawa'y mangapaurong at mangadala sa kasiraang puri na nangalulugod sa aking kapahamakan."
            },
            {
              "chapter": 40,
              "verse": 15,
              "name": "Mga Awit 40:15",
              "text": "Mangapahamak nawa sila dahil sa kanilang kahihiyan na nangagsasabi sa akin, Aha, aha."
            },
            {
              "chapter": 40,
              "verse": 16,
              "name": "Mga Awit 40:16",
              "text": "Mangagalak at mangatuwa nawa sa iyo ang lahat na nagsisihanap sa iyo: yaong nangagiibig ng iyong kaligtasan ay mangagsabi nawang palagi, Ang Panginoon ay dakilain."
            },
            {
              "chapter": 40,
              "verse": 17,
              "name": "Mga Awit 40:17",
              "text": "Nguni't ako'y dukha at mapagkailangan; Gayon ma'y inalaala ako ng Panginoon: Ikaw ang aking saklolo at aking tagapagligtas; huwag kang magluwat, Oh Dios ko."
            }
          ]
        },
        {
          "chapter": 41,
          "name": "Mga Awit 41",
          "verses": [
            {
              "chapter": 41,
              "verse": 1,
              "name": "Mga Awit 41:1",
              "text": "Mapalad siya na nagpapakundangan sa dukha: ililigtas siya ng Panginoon sa panahon ng kaligaligan."
            },
            {
              "chapter": 41,
              "verse": 2,
              "name": "Mga Awit 41:2",
              "text": "Pananatilihin siya, at iingatan siyang buhay ng Panginoon, at siya'y pagpapalain sa ibabaw ng lupa; at huwag mong ibigay siya sa kalooban ng kaniyang mga kaaway."
            },
            {
              "chapter": 41,
              "verse": 3,
              "name": "Mga Awit 41:3",
              "text": "Aalalayan siya ng Panginoon sa hiligan ng panghihina: iyong inaayos ang buo niyang higaan sa kaniyang pagkakasakit."
            },
            {
              "chapter": 41,
              "verse": 4,
              "name": "Mga Awit 41:4",
              "text": "Aking sinabi, Oh Panginoon, maawa ka sa akin: pagalingin mo ang aking kaluluwa; sapagka't ako'y nagkasala laban sa iyo."
            },
            {
              "chapter": 41,
              "verse": 5,
              "name": "Mga Awit 41:5",
              "text": "Ang aking mga kaaway ay nangagsasalita ng kasamaan laban sa akin, na nangagsasabi, kailan siya mamamatay, at mapapawi ang kaniyang pangalan?"
            },
            {
              "chapter": 41,
              "verse": 6,
              "name": "Mga Awit 41:6",
              "text": "At kung siya'y pumaritong tingnang ako siya'y nagsasalita ng walang kabuluhan; ang kaniyang puso ay nagpipisan ng kasamaan sa kaniyang sarili; pagka siya'y lumabas, isinasaysay niya."
            },
            {
              "chapter": 41,
              "verse": 7,
              "name": "Mga Awit 41:7",
              "text": "Yaong lahat na nangagtatanim sa akin ay nangagbubulong-bulungan laban sa akin: laban sa akin ay nagsisikatha ng panghamak."
            },
            {
              "chapter": 41,
              "verse": 8,
              "name": "Mga Awit 41:8",
              "text": "Isang masamang sakit, wika nila, ay kumapit na madali sa kaniya; at ngayon siyang nahihiga ay hindi na babangon pa."
            },
            {
              "chapter": 41,
              "verse": 9,
              "name": "Mga Awit 41:9",
              "text": "Oo, ang aking kasamasamang kaibigan, na aking tiniwalaan, na kumain ng aking tinapay, nagtaas ng kaniyang sakong laban sa akin."
            },
            {
              "chapter": 41,
              "verse": 10,
              "name": "Mga Awit 41:10",
              "text": "Nguni't ikaw, Oh Panginoon, maawa ka sa akin, at ibangon mo ako, upang aking magantihan sila."
            },
            {
              "chapter": 41,
              "verse": 11,
              "name": "Mga Awit 41:11",
              "text": "Sa pamamagitan nito ay natatalastas ko na nalulugod ka sa akin, sapagka't ang aking kaaway ay hindi nagtatagumpay sa akin."
            },
            {
              "chapter": 41,
              "verse": 12,
              "name": "Mga Awit 41:12",
              "text": "At tungkol sa akin, iyong inaalalayan ako sa aking pagtatapat, at inilalagay mo ako sa harap ng iyong mukha magpakailan man."
            },
            {
              "chapter": 41,
              "verse": 13,
              "name": "Mga Awit 41:13",
              "text": "Purihin ang Panginoon, ang Dios ng Israel, mula sa walang pasimula at hanggang sa walang hanggan. Siya nawa, at Siya nawa."
            }
          ]
        },
        {
          "chapter": 42,
          "name": "Mga Awit 42",
          "verses": [
            {
              "chapter": 42,
              "verse": 1,
              "name": "Mga Awit 42:1",
              "text": "Kung paanong humihingal ang usa sa pagkauhaw sa tubig ng mga batis, gayon humihingal ang aking kaluluwa sa pagkasabik sa iyo, Oh Dios."
            },
            {
              "chapter": 42,
              "verse": 2,
              "name": "Mga Awit 42:2",
              "text": "Kinauuhawan ng aking kaluluwa ang Dios, ang buhay na Dios: kailan ako paririto, at haharap sa Dios?"
            },
            {
              "chapter": 42,
              "verse": 3,
              "name": "Mga Awit 42:3",
              "text": "Ang aking mga luha ay naging aking pagkain araw at gabi, Habang kanilang sinasabing lagi sa akin, saan nandoon ang iyong Dios?"
            },
            {
              "chapter": 42,
              "verse": 4,
              "name": "Mga Awit 42:4",
              "text": "Ang mga bagay na ito ay aking naaalaala, at nanglulumo ang aking kaluluwa sa loob ko, kung paanong ako'y nagpatuloy sa karamihan, at pinatnubayan ko sila sa bahay ng Dios, na may tinig ng kagalakan at pagpupuri, na isang karamihan na nagdidiwang ng kapistahan."
            },
            {
              "chapter": 42,
              "verse": 5,
              "name": "Mga Awit 42:5",
              "text": "Bakit ka nanglulumo, Oh kaluluwa ko? At bakit ka nababagabag sa loob ko? Umasa ka sa Dios: sapagka't pupuri pa ako sa kaniya dahil sa kagalingan ng kaniyang mukha."
            },
            {
              "chapter": 42,
              "verse": 6,
              "name": "Mga Awit 42:6",
              "text": "Oh Dios ko, ang aking kaluluwa ay nanglulumo sa loob ko; kaya't aking inaalaala ka mula sa lupain ng Jordan, at ng Hermonitas, mula sa burol ng Mizhar."
            },
            {
              "chapter": 42,
              "verse": 7,
              "name": "Mga Awit 42:7",
              "text": "Kalaliman ay tumatawag sa kalaliman sa hugong ng iyong mga baha: lahat ng iyong alon at ang iyong malaking alon ay nagsitabon sa akin."
            },
            {
              "chapter": 42,
              "verse": 8,
              "name": "Mga Awit 42:8",
              "text": "Gayon ma'y uutusan ng Panginoon ang kaniyang kagandahang-loob sa araw, at sa gabi ay sasa akin ang awit sa kaniya, sa makatuwid baga'y isang dalangin sa Dios ng aking buhay."
            },
            {
              "chapter": 42,
              "verse": 9,
              "name": "Mga Awit 42:9",
              "text": "Aking sasabihin sa Dios na aking malaking bato, bakit mo ako kinalimutan? Bakit ako'y yayaong tumatangis dahil sa pagpighati ng kaaway?"
            },
            {
              "chapter": 42,
              "verse": 10,
              "name": "Mga Awit 42:10",
              "text": "Na wari tabak sa aking mga buto, na tinutuya ako ng aking mga kaaway; habang sinasabi nilang lagi sa akin, saan nandoon ang iyong Dios?"
            },
            {
              "chapter": 42,
              "verse": 11,
              "name": "Mga Awit 42:11",
              "text": "Bakit ka nanglulumo, Oh kaluluwa ko? At bakit ka nababagabag sa loob ko? Umasa ka sa Dios: sapagka't pupuri pa ako sa kaniya, na siyang kagalingan ng aking mukha, at aking Dios."
            }
          ]
        },
        {
          "chapter": 43,
          "name": "Mga Awit 43",
          "verses": [
            {
              "chapter": 43,
              "verse": 1,
              "name": "Mga Awit 43:1",
              "text": "Hatulan mo ako, Oh Dios, at ipagsanggalang mo ang aking usap laban sa masamang bansa: Oh iligtas mo ako sa magdaraya at hindi ganap na tao."
            },
            {
              "chapter": 43,
              "verse": 2,
              "name": "Mga Awit 43:2",
              "text": "Sapagka't ikaw ang Dios ng aking kalakasan; bakit mo ako itinakuwil? Bakit ako yumayaong tumatangis dahil sa pagpighati ng kaaway?"
            },
            {
              "chapter": 43,
              "verse": 3,
              "name": "Mga Awit 43:3",
              "text": "Oh suguin mo ang iyong liwanag at ang iyong katotohanan; patnubayan nawa nila ako: dalhin nawa nila ako sa iyong banal na bundok, at sa iyong mga tabernakulo."
            },
            {
              "chapter": 43,
              "verse": 4,
              "name": "Mga Awit 43:4",
              "text": "Kung magkagayo'y paparoon ako sa dambana ng Dios, sa Dios na aking malabis na kagalakan: at sa alpa ay pupuri ako sa iyo, Oh Dios, aking Dios."
            },
            {
              "chapter": 43,
              "verse": 5,
              "name": "Mga Awit 43:5",
              "text": "Bakit ka nanglulumo, Oh kaluluwa ko? At bakit ka nababagabag sa loob ko? Umasa ka sa Dios: sapagka't pupuri pa ako sa kaniya, na siyang kagalingan ng aking mukha, at aking Dios."
            }
          ]
        },
        {
          "chapter": 44,
          "name": "Mga Awit 44",
          "verses": [
            {
              "chapter": 44,
              "verse": 1,
              "name": "Mga Awit 44:1",
              "text": "Narinig namin ng aming mga pakinig, Oh Dios, isinaysay sa amin ng aming mga magulang, kung anong gawa ang iyong ginawa sa kanilang mga kaarawan, ng mga kaarawan ng una."
            },
            {
              "chapter": 44,
              "verse": 2,
              "name": "Mga Awit 44:2",
              "text": "Iyong itinaboy ng iyong kamay ang mga bansa, nguni't itinatag mo sila; iyong dinalamhati ang mga bayan, nguni't iyong pinangalat sila."
            },
            {
              "chapter": 44,
              "verse": 3,
              "name": "Mga Awit 44:3",
              "text": "Sapagka't hindi nila tinamo ang lupain na pinakaari sa pamamagitan ng kanilang sariling tabak, ni iniligtas man sila ng kanilang sariling kamay: kundi ng iyong kanan, at ng iyong bisig, at ng liwanag ng iyong mukha, sapagka't iyong nilingap sila."
            },
            {
              "chapter": 44,
              "verse": 4,
              "name": "Mga Awit 44:4",
              "text": "Ikaw ang aking Hari, Oh Dios: magutos ka ng kaligtasan sa Jacob."
            },
            {
              "chapter": 44,
              "verse": 5,
              "name": "Mga Awit 44:5",
              "text": "Dahil sa iyo'y itutulak namin ang aming mga kaaway: sa iyong pangalan ay yayapakan namin sila na nagsisibangon laban sa amin."
            },
            {
              "chapter": 44,
              "verse": 6,
              "name": "Mga Awit 44:6",
              "text": "Sapagka't hindi ako titiwala sa aking busog, ni ililigtas man ako ng aking tabak."
            },
            {
              "chapter": 44,
              "verse": 7,
              "name": "Mga Awit 44:7",
              "text": "Nguni't iniligtas mo kami sa aming mga kaaway, at inilagay mo sila sa kahihiyan na nangagtatanim sa amin."
            },
            {
              "chapter": 44,
              "verse": 8,
              "name": "Mga Awit 44:8",
              "text": "Sa Dios ay naghahambog kami buong araw, at mangagpapasalamat kami sa iyong pangalan magpakailan man. (Selah)"
            },
            {
              "chapter": 44,
              "verse": 9,
              "name": "Mga Awit 44:9",
              "text": "Nguni't ngayo'y itinakuwil mo kami, at inilagay mo kami sa kasiraang puri; at hindi ka lumalabas na kasama ng aming mga hukbo."
            },
            {
              "chapter": 44,
              "verse": 10,
              "name": "Mga Awit 44:10",
              "text": "Iyong pinatatalikod kami sa kaaway: at silang nangagtatanim sa amin ay nagsisisamsam ng sa ganang kanilang sarili."
            },
            {
              "chapter": 44,
              "verse": 11,
              "name": "Mga Awit 44:11",
              "text": "Iyong ibinigay kaming gaya ng mga tupa na pinaka pagkain; at pinangalat mo kami sa mga bansa."
            },
            {
              "chapter": 44,
              "verse": 12,
              "name": "Mga Awit 44:12",
              "text": "Iyong ipinagbibili ang iyong bayan na walang bayad, at hindi mo pinalago ang iyong kayamanan sa pamamagitan ng kanilang halaga."
            },
            {
              "chapter": 44,
              "verse": 13,
              "name": "Mga Awit 44:13",
              "text": "Ginawa mo kaming katuyaan sa aming mga kapuwa, isang kasabihan at kadustaan nila na nangasa palibot namin."
            },
            {
              "chapter": 44,
              "verse": 14,
              "name": "Mga Awit 44:14",
              "text": "Iyong ginawa kaming kawikaan sa gitna ng mga bansa, at kaugaan ng ulo sa gitna ng mga bayan."
            },
            {
              "chapter": 44,
              "verse": 15,
              "name": "Mga Awit 44:15",
              "text": "Buong araw ay nasa harap ko ang aking kasiraang puri, at ang kahihiyan ng aking mukha ay tumakip sa akin,"
            },
            {
              "chapter": 44,
              "verse": 16,
              "name": "Mga Awit 44:16",
              "text": "Dahil sa tinig niya na dumuduwahagi at tumutungayaw; dahil sa kaaway at sa manghihiganti."
            },
            {
              "chapter": 44,
              "verse": 17,
              "name": "Mga Awit 44:17",
              "text": "Lahat ng ito'y dumating sa amin; gayon ma'y hindi namin kinalimutan ka, ni gumawa man kami na may karayaan sa iyong tipan."
            },
            {
              "chapter": 44,
              "verse": 18,
              "name": "Mga Awit 44:18",
              "text": "Ang aming puso ay hindi tumalikod, ni ang amin mang mga hakbang ay humiwalay sa iyong daan;"
            },
            {
              "chapter": 44,
              "verse": 19,
              "name": "Mga Awit 44:19",
              "text": "Na kami ay iyong lubhang nilansag sa dako ng mga chakal, at tinakpan mo kami ng lilim ng kamatayan."
            },
            {
              "chapter": 44,
              "verse": 20,
              "name": "Mga Awit 44:20",
              "text": "Kung aming nilimot ang pangalan ng aming Dios, O aming iniunat ang aming mga kamay sa ibang dios;"
            },
            {
              "chapter": 44,
              "verse": 21,
              "name": "Mga Awit 44:21",
              "text": "Hindi ba sisiyasatin ito ng Dios? Sapagka't nalalaman niya ang mga lihim ng puso."
            },
            {
              "chapter": 44,
              "verse": 22,
              "name": "Mga Awit 44:22",
              "text": "Oo, dahil sa iyo ay pinapatay kami buong araw; kami ay nabilang na parang mga tupa sa patayan."
            },
            {
              "chapter": 44,
              "verse": 23,
              "name": "Mga Awit 44:23",
              "text": "Ikaw ay gumising, bakit ka natutulog, Oh Panginoon? Ikaw ay bumangon, huwag mo kaming itakuwil magpakailan man."
            },
            {
              "chapter": 44,
              "verse": 24,
              "name": "Mga Awit 44:24",
              "text": "Bakit mo ikinukubli ang iyong mukha, at kinalilimutan mo ang aming kadalamhatian at aming kapighatian?"
            },
            {
              "chapter": 44,
              "verse": 25,
              "name": "Mga Awit 44:25",
              "text": "Sapagka't ang aming kaluluwa ay nakasubsob sa alabok: ang aming katawan ay nadidikit sa lupa."
            },
            {
              "chapter": 44,
              "verse": 26,
              "name": "Mga Awit 44:26",
              "text": "Ikaw ay bumangon upang kami ay tulungan, at tubusin mo kami dahil sa iyong kagandahang-loob."
            }
          ]
        },
        {
          "chapter": 45,
          "name": "Mga Awit 45",
          "verses": [
            {
              "chapter": 45,
              "verse": 1,
              "name": "Mga Awit 45:1",
              "text": "Ang aking puso ay nananagana sa isang mainam na bagay: aking sinasalita ang mga bagay na aking ginawa tungkol sa hari: ang aking dila ay panulat ng bihasang manunulat."
            },
            {
              "chapter": 45,
              "verse": 2,
              "name": "Mga Awit 45:2",
              "text": "Ikaw ay maganda kay sa mga anak ng mga tao; biyaya ay nabubuhos sa iyong mga labi: kaya't pinagpala ka ng Dios magpakailan man."
            },
            {
              "chapter": 45,
              "verse": 3,
              "name": "Mga Awit 45:3",
              "text": "Ibigkis mo ang iyong tabak sa iyong hita, Oh makapangyarihan, kalakip ang iyong kaluwalhatian at ang iyong kamahalan."
            },
            {
              "chapter": 45,
              "verse": 4,
              "name": "Mga Awit 45:4",
              "text": "At sa iyong kamahalan ay sumakay kang may kaginhawahan, dahil sa katotohanan, at sa kaamuan, at sa katuwiran: at ang iyong kanan ay magtuturo sa iyo ng kakilakilabot na mga bagay."
            },
            {
              "chapter": 45,
              "verse": 5,
              "name": "Mga Awit 45:5",
              "text": "Ang iyong mga palaso ay matulis; ang mga bayan ay nangabubuwal sa ilalim mo: sila'y nangasa puso ng mga kaaway ng hari."
            },
            {
              "chapter": 45,
              "verse": 6,
              "name": "Mga Awit 45:6",
              "text": "Ang iyong luklukan, Oh Dios, ay magpakailan-kailan man: cetro ng kaganapan ang cetro ng iyong kaharian."
            },
            {
              "chapter": 45,
              "verse": 7,
              "name": "Mga Awit 45:7",
              "text": "Iyong iniibig ang katuwiran, at pinagtataniman ang kasamaan: kaya't ang Dios, ang iyong Dios, ay nagpahid sa iyo ng langis, ng langis ng kasayahan na higit kay sa iyong mga kasama."
            },
            {
              "chapter": 45,
              "verse": 8,
              "name": "Mga Awit 45:8",
              "text": "Ang lahat ng iyong mga damit ay amoy mira, at aloe, at kasia: mula sa bahay-haring garing ay pinasasaya ka ng mga panugtog na kawad."
            },
            {
              "chapter": 45,
              "verse": 9,
              "name": "Mga Awit 45:9",
              "text": "Ang mga anak na babae ng hari ay nangasa gitna ng iyong mga marangal na babae: sa iyong kanan ay nakatayo ang reyna na may ginto sa Ophir."
            },
            {
              "chapter": 45,
              "verse": 10,
              "name": "Mga Awit 45:10",
              "text": "Iyong dinggin, Oh anak na babae, at iyong pakundanganan, at ikiling mo ang iyong pakinig; kalimutan mo naman ang iyong sariling bayan, at ang bahay ng iyong magulang;"
            },
            {
              "chapter": 45,
              "verse": 11,
              "name": "Mga Awit 45:11",
              "text": "Sa gayo'y nanasain ng hari ang iyong kagandahan; sapagka't siya'y iyong panginoon; at sumamba ka sa kaniya."
            },
            {
              "chapter": 45,
              "verse": 12,
              "name": "Mga Awit 45:12",
              "text": "At ang anak na babae ng Tiro ay dodoon na may kaloob; pati ng mayaman sa gitna ng iyong bayan ay mamamanhik ng iyong lingap."
            },
            {
              "chapter": 45,
              "verse": 13,
              "name": "Mga Awit 45:13",
              "text": "Ang anak na babae ng hari ay totoong maluwalhati sa bahay-hari. Ang kaniyang suot ay yaring may ginto."
            },
            {
              "chapter": 45,
              "verse": 14,
              "name": "Mga Awit 45:14",
              "text": "Siya'y ihahatid sa hari na may suot na bordado: ang mga dalaga, na kaniyang mga kasama na nagsisisunod sa kaniya, ay dadalhin sa iyo."
            },
            {
              "chapter": 45,
              "verse": 15,
              "name": "Mga Awit 45:15",
              "text": "May kasayahan at kagalakan na ihahatid sila: sila'y magsisipasok sa bahay-hari."
            },
            {
              "chapter": 45,
              "verse": 16,
              "name": "Mga Awit 45:16",
              "text": "Sa halip ng iyong mga magulang ay ang iyong mga anak, na siya mong gagawing mga pangulo sa buong lupa."
            },
            {
              "chapter": 45,
              "verse": 17,
              "name": "Mga Awit 45:17",
              "text": "Aking ipaaalaala ang iyong pangalan sa lahat ng sali't saling lahi: kaya't ang mga bayan ay mangagpapasalamat sa iyo magpakailan-kailan man."
            }
          ]
        },
        {
          "chapter": 46,
          "name": "Mga Awit 46",
          "verses": [
            {
              "chapter": 46,
              "verse": 1,
              "name": "Mga Awit 46:1",
              "text": "Ang Dios ay ating ampunan at kalakasan, handang saklolo sa kabagabagan."
            },
            {
              "chapter": 46,
              "verse": 2,
              "name": "Mga Awit 46:2",
              "text": "Kaya't hindi tayo matatakot bagaman ang lupa ay mabago, at bagaman ang mga bundok ay mangaglipat sa kagitnaan ng mga dagat;"
            },
            {
              "chapter": 46,
              "verse": 3,
              "name": "Mga Awit 46:3",
              "text": "Bagaman ang tubig niyaon ay magsihugong at mabagabag. Bagaman ang mga bundok ay mangauga dahil sa unos niyaon. (Selah)"
            },
            {
              "chapter": 46,
              "verse": 4,
              "name": "Mga Awit 46:4",
              "text": "May isang ilog, na ang mga agos ay nagpapasaya sa bayan ng Dios. Sa banal na dako ng mga tabernakulo ng Kataastaasan."
            },
            {
              "chapter": 46,
              "verse": 5,
              "name": "Mga Awit 46:5",
              "text": "Ang Dios ay nasa gitna niya; siya'y hindi makikilos: tutulungan siya ng Dios na maaga."
            },
            {
              "chapter": 46,
              "verse": 6,
              "name": "Mga Awit 46:6",
              "text": "Ang mga bansa ay nangagkagulo, ang mga kaharian ay nangakilos: inihiyaw niya ang kaniyang tinig, ang lupa ay natunaw."
            },
            {
              "chapter": 46,
              "verse": 7,
              "name": "Mga Awit 46:7",
              "text": "Ang Panginoon ng mga hukbo ay sumasa atin; ang Dios ni Jacob ay ating kanlungan. (Selah)"
            },
            {
              "chapter": 46,
              "verse": 8,
              "name": "Mga Awit 46:8",
              "text": "Kayo'y parito, inyong masdan ang mga gawa ng Panginoon, kung anong mga kagibaan ang kaniyang ginawa sa lupa."
            },
            {
              "chapter": 46,
              "verse": 9,
              "name": "Mga Awit 46:9",
              "text": "Kaniyang pinapaglilikat ang mga pagdidigma sa wakas ng lupa; kaniyang binabali ang busog, at pinuputol ang sibat; kaniyang sinusunog ang mga karo sa apoy."
            },
            {
              "chapter": 46,
              "verse": 10,
              "name": "Mga Awit 46:10",
              "text": "Kayo ay magsitigil at kilalanin ninyo na ako ang Dios: ako'y mabubunyi sa gitna ng mga bansa, ako'y mabubunyi sa lupa."
            },
            {
              "chapter": 46,
              "verse": 11,
              "name": "Mga Awit 46:11",
              "text": "Ang Panginoon ng mga hukbo ay sumasa atin; ang Dios ni Jacob ay ating kanlungan."
            }
          ]
        },
        {
          "chapter": 47,
          "name": "Mga Awit 47",
          "verses": [
            {
              "chapter": 47,
              "verse": 1,
              "name": "Mga Awit 47:1",
              "text": "Oh ipakpak ang inyong mga kamay ninyong lahat na mga bayan; magsihiyaw kayo sa Dios ng tinig ng pagtatagumpay."
            },
            {
              "chapter": 47,
              "verse": 2,
              "name": "Mga Awit 47:2",
              "text": "Sapagka't ang Panginoong kataastaasan ay kakilakilabot; siya'y dakilang Hari sa buong lupa."
            },
            {
              "chapter": 47,
              "verse": 3,
              "name": "Mga Awit 47:3",
              "text": "Kaniyang pasusukuin ang mga bayan sa ilalim natin, at ang mga bansa sa ilalim ng ating mga paa."
            },
            {
              "chapter": 47,
              "verse": 4,
              "name": "Mga Awit 47:4",
              "text": "Kaniyang ipipili tayo ng ating mana, ang karilagan ni Jacob na kaniyang minahal. (Selah)"
            },
            {
              "chapter": 47,
              "verse": 5,
              "name": "Mga Awit 47:5",
              "text": "Ang Dios ay napailanglang na may hiyawan, ang Panginoon na may tunog ng pakakak."
            },
            {
              "chapter": 47,
              "verse": 6,
              "name": "Mga Awit 47:6",
              "text": "Kayo'y magsiawit ng mga pagpuri sa Dios, kayo'y magsiawit ng mga pagpuri: kayo'y magsiawit ng mga pagpuri sa ating Hari, kayo'y magsiawit ng mga pagpuri."
            },
            {
              "chapter": 47,
              "verse": 7,
              "name": "Mga Awit 47:7",
              "text": "Sapagka't ang Dios ay Hari ng buong lupa: magsiawit kayo ng mga pagpuri na may pagunawa."
            },
            {
              "chapter": 47,
              "verse": 8,
              "name": "Mga Awit 47:8",
              "text": "Ang Dios ay naghahari sa mga bansa: ang Dios ay nauupo sa kaniyang banal na luklukan."
            },
            {
              "chapter": 47,
              "verse": 9,
              "name": "Mga Awit 47:9",
              "text": "Ang mga pangulo ng mga bayan ay nangapipisan upang maging bayan ng Dios ni Abraham; sapagka't ang mga kalasag ng lupa ay ukol sa Dios; siya'y totoong bunyi."
            }
          ]
        },
        {
          "chapter": 48,
          "name": "Mga Awit 48",
          "verses": [
            {
              "chapter": 48,
              "verse": 1,
              "name": "Mga Awit 48:1",
              "text": "Dakila ang Panginoon, at marapat pakapurihin, sa bayan ng aming Dios, sa kaniyang banal na bundok."
            },
            {
              "chapter": 48,
              "verse": 2,
              "name": "Mga Awit 48:2",
              "text": "Maganda sa kataasan, ang kagalakan ng buong lupa, siyang bundok ng Sion, sa mga dako ng hilagaan, na bayan ng dakilang Hari."
            },
            {
              "chapter": 48,
              "verse": 3,
              "name": "Mga Awit 48:3",
              "text": "Ang Dios ay napakilala sa kaniyang mga bahay-hari, na pinakakanlungan."
            },
            {
              "chapter": 48,
              "verse": 4,
              "name": "Mga Awit 48:4",
              "text": "Sapagka't narito, ang mga hari ay nagpupulong, sila'y nagsidaang magkakasama."
            },
            {
              "chapter": 48,
              "verse": 5,
              "name": "Mga Awit 48:5",
              "text": "Kanilang nakita, nagsipanggilalas nga sila; sila'y nanganglupaypay, sila'y nangagmadaling tumakas."
            },
            {
              "chapter": 48,
              "verse": 6,
              "name": "Mga Awit 48:6",
              "text": "Panginginig ay humawak sa kanila roon; sakit, gaya ng sa isang babae sa pagdaramdam."
            },
            {
              "chapter": 48,
              "verse": 7,
              "name": "Mga Awit 48:7",
              "text": "Sa pamamagitan ng hanging silanganan iyong binabasag ang mga sasakyan sa Tharsis."
            },
            {
              "chapter": 48,
              "verse": 8,
              "name": "Mga Awit 48:8",
              "text": "Kung ano ang aming narinig, ay gayon ang aming nakita sa bayan ng Panginoon ng mga hukbo, sa bayan ng aming Dios: itatatag ito ng Dios magpakailan man. (Selah)"
            },
            {
              "chapter": 48,
              "verse": 9,
              "name": "Mga Awit 48:9",
              "text": "Aming inaalaala ang iyong kagandahang-loob, Oh Dios, sa gitna ng iyong templo."
            },
            {
              "chapter": 48,
              "verse": 10,
              "name": "Mga Awit 48:10",
              "text": "Kung ano ang iyong pangalan, Oh Dios, gayon ang pagpuri sa iyo hanggang sa mga wakas ng lupa; ang iyong kanan ay puspos ng katuwiran."
            },
            {
              "chapter": 48,
              "verse": 11,
              "name": "Mga Awit 48:11",
              "text": "Matuwa ka bundok ng Sion, magalak ang mga anak na babae ng Juda, dahil sa iyong mga kahatulan."
            },
            {
              "chapter": 48,
              "verse": 12,
              "name": "Mga Awit 48:12",
              "text": "Libutin ninyo ang Sion, at inyong ligirin siya: inyong saysayin ang mga moog niyaon."
            },
            {
              "chapter": 48,
              "verse": 13,
              "name": "Mga Awit 48:13",
              "text": "Tandaan ninyong mabuti ang kaniyang mga kuta, inyong masdan ang kaniyang mga bahay-hari; upang inyong maisaysay ito sa susunod na lahi."
            },
            {
              "chapter": 48,
              "verse": 14,
              "name": "Mga Awit 48:14",
              "text": "Sapagka't ang Dios na ito ay ating Dios magpakailan-kailan man: siya'y magiging ating patnubay hanggang sa kamatayan."
            }
          ]
        },
        {
          "chapter": 49,
          "name": "Mga Awit 49",
          "verses": [
            {
              "chapter": 49,
              "verse": 1,
              "name": "Mga Awit 49:1",
              "text": "Dinggin ninyo ito, ninyong lahat na mga bayan; pakinggan ninyo, ninyong lahat na nananahan sa daigdig:"
            },
            {
              "chapter": 49,
              "verse": 2,
              "name": "Mga Awit 49:2",
              "text": "Ng mababa at gayon din ng mataas, ng mayaman at ng dukha na magkasama."
            },
            {
              "chapter": 49,
              "verse": 3,
              "name": "Mga Awit 49:3",
              "text": "Ang aking bibig ay magsasalita ng karunungan; at ang pagbubulay ng aking puso ay magiging sa pagunawa."
            },
            {
              "chapter": 49,
              "verse": 4,
              "name": "Mga Awit 49:4",
              "text": "Ikikiling ko ang aking panig sa talinghaga: ibubuka ko ang aking malabong sabi sa alpa."
            },
            {
              "chapter": 49,
              "verse": 5,
              "name": "Mga Awit 49:5",
              "text": "Bakit ako matatakot sa mga kaarawan ng kasamaan, pagka kinukulong ako ng kasamaan sa aking mga sakong?"
            },
            {
              "chapter": 49,
              "verse": 6,
              "name": "Mga Awit 49:6",
              "text": "Silang nagsisitiwala sa kanilang kayamanan, at nangaghahambog sa karamihan ng kanilang mga kayamanan;"
            },
            {
              "chapter": 49,
              "verse": 7,
              "name": "Mga Awit 49:7",
              "text": "Wala sa kaniyang makatutubos sa ano pa mang paraan sa kaniyang kapatid, ni magbibigay man sa Dios ng pangtubos sa kaniya:"
            },
            {
              "chapter": 49,
              "verse": 8,
              "name": "Mga Awit 49:8",
              "text": "(Sapagka't ang katubusan ng kanilang kaluluwa ay mahal, at ito'y naglilikat magpakailan man:)"
            },
            {
              "chapter": 49,
              "verse": 9,
              "name": "Mga Awit 49:9",
              "text": "Upang siya'y mabuhay na lagi, upang siya'y huwag makakita ng kabulukan."
            },
            {
              "chapter": 49,
              "verse": 10,
              "name": "Mga Awit 49:10",
              "text": "Sapagka't nakikita niya na ang mga pantas ay nangamamatay, ang mangmang at gayon din ang hangal ay nililipol, at iniiwanan ang kanilang kayamanan sa mga iba."
            },
            {
              "chapter": 49,
              "verse": 11,
              "name": "Mga Awit 49:11",
              "text": "Ang kanilang pagiisip sa loob ay, na ang kanilang mga bahay ay mananatili magpakailan man, at ang kanilang mga tahanang dako ay sa lahat ng sali't saling lahi; tinatawag nila ang kanilang mga lupain ayon sa kanilang sariling mga pangalan."
            },
            {
              "chapter": 49,
              "verse": 12,
              "name": "Mga Awit 49:12",
              "text": "Nguni't ang tao'y hindi lalagi sa karangalan: siya'y gaya ng mga hayop na nangamamatay."
            },
            {
              "chapter": 49,
              "verse": 13,
              "name": "Mga Awit 49:13",
              "text": "Itong kanilang lakad ay kanilang kamangmangan: gayon ma'y pagkatapos nila ay sinasangayunan ng mga tao ang kanilang mga kasabihan. (Selah)"
            },
            {
              "chapter": 49,
              "verse": 14,
              "name": "Mga Awit 49:14",
              "text": "Sila'y nangatakda sa Sheol na parang kawan; kamatayan ay magiging pastor sa kanila: at ang matuwid ay magtataglay ng kapangyarihan sa kanila sa kinaumagahan; at ang kanilang kagandahan ay mapapasa Sheol upang matunaw, upang mawalan ng tahanan."
            },
            {
              "chapter": 49,
              "verse": 15,
              "name": "Mga Awit 49:15",
              "text": "Nguni't tutubusin ng Dios ang aking kaluluwa sa kapangyarihan ng Sheol: sapagka't tatanggapin niya ako. (Selah)"
            },
            {
              "chapter": 49,
              "verse": 16,
              "name": "Mga Awit 49:16",
              "text": "Huwag kang matakot pagka may yumaman. Pagka ang kaluwalhatian ng kaniyang bahay ay lumago:"
            },
            {
              "chapter": 49,
              "verse": 17,
              "name": "Mga Awit 49:17",
              "text": "Sapagka't pagka siya'y namatay ay wala siyang dadalhin; ang kaniyang kaluwalhatian ay hindi bababang susunod sa kaniya."
            },
            {
              "chapter": 49,
              "verse": 18,
              "name": "Mga Awit 49:18",
              "text": "Bagaman habang siya'y nabuhay ay kaniyang pinagpala ang kaniyang kaluluwa, (at pinupuri ka ng mga tao pagka gumagawa ka ng mabuti sa iyong sarili),"
            },
            {
              "chapter": 49,
              "verse": 19,
              "name": "Mga Awit 49:19",
              "text": "Siya'y paroroon sa lahi ng kaniyang mga magulang; hindi sila makakakita kailan man ng liwanag."
            },
            {
              "chapter": 49,
              "verse": 20,
              "name": "Mga Awit 49:20",
              "text": "Taong nasa karangalan, at hindi nakakaunawa, ay gaya ng mga hayop na namamatay."
            }
          ]
        },
        {
          "chapter": 50,
          "name": "Mga Awit 50",
          "verses": [
            {
              "chapter": 50,
              "verse": 1,
              "name": "Mga Awit 50:1",
              "text": "Ang makapangyarihang Dios, ang Dios na Panginoon, ay nagsalita, at tinawag ang lupa mula sa pagsikat ng araw hanggang sa paglubog niyaon."
            },
            {
              "chapter": 50,
              "verse": 2,
              "name": "Mga Awit 50:2",
              "text": "Mula sa Sion na kasakdalan ng kagandahan, sumilang ang Dios."
            },
            {
              "chapter": 50,
              "verse": 3,
              "name": "Mga Awit 50:3",
              "text": "Ang aming Dios ay darating at hindi tatahimik; isang apoy na mamumugnaw sa harap niya, at magiging totoong malaking bagyo sa palibot niya."
            },
            {
              "chapter": 50,
              "verse": 4,
              "name": "Mga Awit 50:4",
              "text": "Siya'y tatawag sa langit sa itaas, at sa lupa upang mahatulan niya ang kaniyang bayan:"
            },
            {
              "chapter": 50,
              "verse": 5,
              "name": "Mga Awit 50:5",
              "text": "Pisanin mo ang aking mga banal sa akin; yaong nangakikipagtipan sa akin sa pamamagitan ng hain."
            },
            {
              "chapter": 50,
              "verse": 6,
              "name": "Mga Awit 50:6",
              "text": "At ipahahayag ng langit ang kaniyang katuwiran; sapagka't ang Dios ay siyang hukom. (Selah)"
            },
            {
              "chapter": 50,
              "verse": 7,
              "name": "Mga Awit 50:7",
              "text": "Iyong dinggin, Oh aking bayan, at ako'y magsasalita; Oh Israel, at ako'y magpapatotoo sa iyo: Ako'y Dios, iyong Dios."
            },
            {
              "chapter": 50,
              "verse": 8,
              "name": "Mga Awit 50:8",
              "text": "Hindi kita sasawayin dahil sa iyong mga hain; at ang iyong mga handog na susunugin ay laging nangasa harap ko."
            },
            {
              "chapter": 50,
              "verse": 9,
              "name": "Mga Awit 50:9",
              "text": "Hindi ako kukuha ng baka sa iyong bahay, ni ng kambing na lalake sa iyong mga kawan."
            },
            {
              "chapter": 50,
              "verse": 10,
              "name": "Mga Awit 50:10",
              "text": "Sapagka't bawa't hayop sa gubat ay akin, at ang hayop sa libong burol."
            },
            {
              "chapter": 50,
              "verse": 11,
              "name": "Mga Awit 50:11",
              "text": "Nakikilala ko ang lahat ng mga ibon sa mga bundok: at ang mga mabangis na hayop sa parang ay akin."
            },
            {
              "chapter": 50,
              "verse": 12,
              "name": "Mga Awit 50:12",
              "text": "Kung ako'y magutom ay hindi ko sasaysayin sa iyo: sapagka't ang sanglibutan ay akin, at ang buong narito."
            },
            {
              "chapter": 50,
              "verse": 13,
              "name": "Mga Awit 50:13",
              "text": "Kakanin ko ba ang laman ng mga toro, o iinumin ang dugo ng mga kambing?"
            },
            {
              "chapter": 50,
              "verse": 14,
              "name": "Mga Awit 50:14",
              "text": "Ihandog mo sa Dios ang haing pasasalamat: at tuparin mo ang iyong mga panata sa Kataastaasan:"
            },
            {
              "chapter": 50,
              "verse": 15,
              "name": "Mga Awit 50:15",
              "text": "At tumawag ka sa akin sa kaarawan ng kabagabagan; ililigtas kita, at iyong luluwalhatiin ako."
            },
            {
              "chapter": 50,
              "verse": 16,
              "name": "Mga Awit 50:16",
              "text": "Nguni't sa masama ay sinasabi ng Dios, Anong iyong gagawin upang ipahayag ang aking mga palatuntunan, at iyong kinuha ang aking tipan sa iyong bibig?"
            },
            {
              "chapter": 50,
              "verse": 17,
              "name": "Mga Awit 50:17",
              "text": "Palibhasa't iyong kinapopootan ang pagtuturo, at iyong iniwawaksi ang aking mga salita sa likuran mo."
            },
            {
              "chapter": 50,
              "verse": 18,
              "name": "Mga Awit 50:18",
              "text": "Pagka nakakita ka ng magnanakaw, pumipisan ka sa kaniya, at naging kabahagi ka ng mga mapangalunya."
            },
            {
              "chapter": 50,
              "verse": 19,
              "name": "Mga Awit 50:19",
              "text": "Iyong ibinubuka ang iyong bibig sa kasamaan, at ang iyong dila ay kumakatha ng karayaan."
            },
            {
              "chapter": 50,
              "verse": 20,
              "name": "Mga Awit 50:20",
              "text": "Ikaw ay nauupo, at nagsasalita laban sa iyong kapatid; iyong dinudusta ang anak ng iyong sariling ina."
            },
            {
              "chapter": 50,
              "verse": 21,
              "name": "Mga Awit 50:21",
              "text": "Ang mga bagay na ito ay iyong ginawa, at ako'y tumahimik; iyong inisip na tunay na ako'y gayong gaya mo: nguni't sasawayin kita, at aking isasaayos sa harap ng iyong mga mata."
            },
            {
              "chapter": 50,
              "verse": 22,
              "name": "Mga Awit 50:22",
              "text": "Gunitain nga ninyo ito, ninyong nangakalilimot sa Dios, baka kayo'y aking pagluraylurayin at walang magligtas:"
            },
            {
              "chapter": 50,
              "verse": 23,
              "name": "Mga Awit 50:23",
              "text": "Ang naghahandog ng haing pasasalamat ay lumuluwalhati sa akin; at sa kaniya na nagaayos ng kaniyang pakikipagusap aking ipakikita ang pagliligtas ng Dios."
            }
          ]
        },
        {
          "chapter": 51,
          "name": "Mga Awit 51",
          "verses": [
            {
              "chapter": 51,
              "verse": 1,
              "name": "Mga Awit 51:1",
              "text": "Maawa ka sa akin, Oh Dios, ayon sa iyong kagandahang-loob: ayon sa karamihan ng iyong malumanay na mga kaawaan ay pinawi mo ang aking mga pagsalangsang."
            },
            {
              "chapter": 51,
              "verse": 2,
              "name": "Mga Awit 51:2",
              "text": "Hugasan mo akong lubos sa aking kasamaan, at linisin mo ako sa aking kasalanan."
            },
            {
              "chapter": 51,
              "verse": 3,
              "name": "Mga Awit 51:3",
              "text": "Sapagka't kinikilala ko ang aking mga pagsalangsang: at ang aking kasalanan ay laging nasa harap ko."
            },
            {
              "chapter": 51,
              "verse": 4,
              "name": "Mga Awit 51:4",
              "text": "Laban sa iyo, sa iyo lamang ako nagkasala, at nakagawa ng kasamaan sa iyong paningin: upang ikaw ay ariing ganap pag nagsasalita ka, at maging malinis pag humahatol ka."
            },
            {
              "chapter": 51,
              "verse": 5,
              "name": "Mga Awit 51:5",
              "text": "Narito, ako'y inanyuan sa kasamaan; at sa kasalanan ay ipinaglihi ako ng aking ina,"
            },
            {
              "chapter": 51,
              "verse": 6,
              "name": "Mga Awit 51:6",
              "text": "Narito, ikaw ay nagnanasa ng katotohanan sa mga loob na sangkap; at sa kubling bahagi ay iyong ipakikilala sa akin ang karunungan."
            },
            {
              "chapter": 51,
              "verse": 7,
              "name": "Mga Awit 51:7",
              "text": "Linisin mo ako ng hisopo, at ako'y magiging malinis: hugasan mo ako at ako'y magiging lalong maputi kay sa nieve."
            },
            {
              "chapter": 51,
              "verse": 8,
              "name": "Mga Awit 51:8",
              "text": "Pagparinggan mo ako ng kagalakan at kasayahan; upang ang mga buto na iyong binali ay mangagalak."
            },
            {
              "chapter": 51,
              "verse": 9,
              "name": "Mga Awit 51:9",
              "text": "Ikubli mo ang iyong mukha sa aking mga kasalanan, at pawiin mo ang aking lahat na mga kasamaan."
            },
            {
              "chapter": 51,
              "verse": 10,
              "name": "Mga Awit 51:10",
              "text": "Likhaan mo ako ng isang malinis na puso, Oh Dios; at magbago ka ng isang matuwid na espiritu sa loob ko."
            },
            {
              "chapter": 51,
              "verse": 11,
              "name": "Mga Awit 51:11",
              "text": "Huwag mo akong paalisin sa iyong harapan; at huwag mong bawiin ang iyong santong Espiritu sa akin."
            },
            {
              "chapter": 51,
              "verse": 12,
              "name": "Mga Awit 51:12",
              "text": "Ibalik mo sa akin ang kagalakan ng iyong pagliligtas: at alalayan ako ng kusang espiritu."
            },
            {
              "chapter": 51,
              "verse": 13,
              "name": "Mga Awit 51:13",
              "text": "Kung magkagayo'y ituturo ko sa mga mananalangsang ang iyong mga lakad; at ang mga makasalanan ay mangahihikayat sa iyo."
            },
            {
              "chapter": 51,
              "verse": 14,
              "name": "Mga Awit 51:14",
              "text": "Iligtas mo ako sa salang pagbububo ng dugo, Oh Dios, ikaw na Dios ng aking kaligtasan; at ang aking dila ay aawit ng malakas tungkol sa iyong katuwiran."
            },
            {
              "chapter": 51,
              "verse": 15,
              "name": "Mga Awit 51:15",
              "text": "Oh Panginoon, bukhin mo ang aking mga labi; at ang aking bibig ay magsasaysay ng iyong kapurihan."
            },
            {
              "chapter": 51,
              "verse": 16,
              "name": "Mga Awit 51:16",
              "text": "Sapagka't hindi ka nalulugod sa hain; na kung dili ay bibigyan kita: wala kang kaluguran sa handog na susunugin."
            },
            {
              "chapter": 51,
              "verse": 17,
              "name": "Mga Awit 51:17",
              "text": "Ang mga hain sa Dios ay bagbag na loob: isang bagbag at may pagsisising puso, Oh Dios, ay hindi mo wawaling kabuluhan."
            },
            {
              "chapter": 51,
              "verse": 18,
              "name": "Mga Awit 51:18",
              "text": "Gawan mo ng mabuti ang iyong mabuting kasayahan sa Sion: itayo mo ang mga kuta ng Jerusalem."
            },
            {
              "chapter": 51,
              "verse": 19,
              "name": "Mga Awit 51:19",
              "text": "Kung magkagayo'y malulugod ka sa mga hain ng katuwiran, sa handog na susunugin at sa handog na susunuging buo: kung magkagayo'y mangaghahandog sila ng mga toro sa iyong dambana."
            }
          ]
        },
        {
          "chapter": 52,
          "name": "Mga Awit 52",
          "verses": [
            {
              "chapter": 52,
              "verse": 1,
              "name": "Mga Awit 52:1",
              "text": "Bakit ka naghahambog sa kasamaan, Oh makapangyarihang tao? Ang kagandahang-loob ng Dios ay palagi."
            },
            {
              "chapter": 52,
              "verse": 2,
              "name": "Mga Awit 52:2",
              "text": "Ang dila mo'y kumakatha ng totoong masama; gaya ng matalas na pangahit, na gumagawang may karayaan."
            },
            {
              "chapter": 52,
              "verse": 3,
              "name": "Mga Awit 52:3",
              "text": "Iniibig mo ang kasamaan ng higit kay sa kabutihan; at ang pagsisinungaling kay sa pagsasalita ng katuwiran. (Selah)"
            },
            {
              "chapter": 52,
              "verse": 4,
              "name": "Mga Awit 52:4",
              "text": "Iniibig mo ang lahat na mananakmal na salita, Oh ikaw na magdarayang dila."
            },
            {
              "chapter": 52,
              "verse": 5,
              "name": "Mga Awit 52:5",
              "text": "Ilulugmok ka ring gayon ng Dios magpakailan man, itataas ka niya, at ilalabas ka sa iyong tolda, at bubunutin ka niya sa lupain ng may buhay. (Selah)"
            },
            {
              "chapter": 52,
              "verse": 6,
              "name": "Mga Awit 52:6",
              "text": "Makikita naman ng matuwid, at matatakot, at tatawa sa kaniya, na magsasabi,"
            },
            {
              "chapter": 52,
              "verse": 7,
              "name": "Mga Awit 52:7",
              "text": "Narito, ito ang tao na hindi ginawang kaniyang katibayan, ang Dios; kundi tumiwala sa kasaganaan ng kaniyang mga kayamanan, at nagpakalakas sa kaniyang kasamaan."
            },
            {
              "chapter": 52,
              "verse": 8,
              "name": "Mga Awit 52:8",
              "text": "Nguni't tungkol sa akin, ay gaya ako ng sariwang punong kahoy ng olibo sa bahay ng Dios: tumitiwala ako sa kagandahang-loob ng Dios magpakailan-kailan man."
            },
            {
              "chapter": 52,
              "verse": 9,
              "name": "Mga Awit 52:9",
              "text": "Ako'y magpapasalamat sa iyo magpakailan man, sapagka't iyong ginawa: at ako'y maghihintay sa iyong pangalan sapagka't mabuti, sa harapan ng iyong mga banal."
            }
          ]
        },
        {
          "chapter": 53,
          "name": "Mga Awit 53",
          "verses": [
            {
              "chapter": 53,
              "verse": 1,
              "name": "Mga Awit 53:1",
              "text": "Ang mangmang ay nagsabi sa puso niya, Walang Dios. Nangapahamak sila, at nagsigawa ng kasuklamsuklam na kasamaan; walang gumawa ng mabuti."
            },
            {
              "chapter": 53,
              "verse": 2,
              "name": "Mga Awit 53:2",
              "text": "Tinunghan ng Dios ang mga anak ng mga tao mula sa langit, upang tignan kung may sinomang nakakaunawa, na humanap sa Dios."
            },
            {
              "chapter": 53,
              "verse": 3,
              "name": "Mga Awit 53:3",
              "text": "Bawa't isa sa kanila ay tumalikod: sila'y magkakasamang naging mahahalay; walang gumawa ng mabuti, wala, wala kahit isa."
            },
            {
              "chapter": 53,
              "verse": 4,
              "name": "Mga Awit 53:4",
              "text": "Wala bang kaalaman ang mga manggagawa ng kasamaan? na siyang kumakain ng aking bayan na tila kumakain ng tinapay, at hindi nagsisitawag sa Dios."
            },
            {
              "chapter": 53,
              "verse": 5,
              "name": "Mga Awit 53:5",
              "text": "Doo'y nangapasa malaking katakutan sila na hindi kinaroroonan ng takot: sapagka't pinangalat ng Dios ang mga buto niya na humahantong laban sa iyo; iyong inilagay sila sa kahihiyan, sapagka't itinakuwil sila ng Dios."
            },
            {
              "chapter": 53,
              "verse": 6,
              "name": "Mga Awit 53:6",
              "text": "Oh kung ang kaligtasan ng Israel ay lumabas sa Sion. Pagka ibabalik ng Dios ang nangabihag ng kaniyang bayan, magagalak nga ang Jacob at matutuwa ang Israel."
            }
          ]
        },
        {
          "chapter": 54,
          "name": "Mga Awit 54",
          "verses": [
            {
              "chapter": 54,
              "verse": 1,
              "name": "Mga Awit 54:1",
              "text": "Iligtas mo ako, Oh Dios, sa pamamagitan ng iyong pangalan. At hatulan mo ako sa iyong kapangyarihan."
            },
            {
              "chapter": 54,
              "verse": 2,
              "name": "Mga Awit 54:2",
              "text": "Dinggin mo ang aking dalangin, Oh Dios; pakinggan mo ang mga salita ng aking bibig."
            },
            {
              "chapter": 54,
              "verse": 3,
              "name": "Mga Awit 54:3",
              "text": "Sapagka't ang mga tagaibang lupa ay nagsibangon laban sa akin, at ang mga mangdadahas na tao ay nagsisiusig ng aking kaluluwa: hindi nila inilagay ang Dios sa harap nila. (Selah)"
            },
            {
              "chapter": 54,
              "verse": 4,
              "name": "Mga Awit 54:4",
              "text": "Narito, ang Dios ay aking katulong: ang Panginoon ay sa kanila na nagsisialalay ng aking kaluluwa."
            },
            {
              "chapter": 54,
              "verse": 5,
              "name": "Mga Awit 54:5",
              "text": "Kaniyang ibabalik ang kasamaan sa aking mga kaaway: gibain mo sila sa iyong katotohanan."
            },
            {
              "chapter": 54,
              "verse": 6,
              "name": "Mga Awit 54:6",
              "text": "Ako'y maghahain sa iyo ng kusang handog: ako'y magpapasalamat sa iyong pangalan, Oh Panginoon, sapagka't mabuti."
            },
            {
              "chapter": 54,
              "verse": 7,
              "name": "Mga Awit 54:7",
              "text": "Sapagka't iniligtas niya ako sa lahat ng kabagabagan; at nakita ng aking mata ang aking nasa sa aking mga kaaway."
            }
          ]
        },
        {
          "chapter": 55,
          "name": "Mga Awit 55",
          "verses": [
            {
              "chapter": 55,
              "verse": 1,
              "name": "Mga Awit 55:1",
              "text": "Dinggin mo ang aking dalangin, Oh Dios; at huwag kang magkubli sa aking pananaing."
            },
            {
              "chapter": 55,
              "verse": 2,
              "name": "Mga Awit 55:2",
              "text": "Pakinggan mo ako, at iyong sagutin ako: ako'y walang katiwasayan sa aking pagdaramdam, at ako'y dumadaing;"
            },
            {
              "chapter": 55,
              "verse": 3,
              "name": "Mga Awit 55:3",
              "text": "Dahil sa tinig ng kaaway, dahil sa pagpighati ng masama; sapagka't sila'y naghagis ng kasamaan sa akin, at sa galit ay inuusig nila ako."
            },
            {
              "chapter": 55,
              "verse": 4,
              "name": "Mga Awit 55:4",
              "text": "Ang aking puso ay nagdaramdam na mainam sa loob ko: at ang mga kakilabutan ng kamatayan ay nahulog sa akin."
            },
            {
              "chapter": 55,
              "verse": 5,
              "name": "Mga Awit 55:5",
              "text": "Katakutan at panginginig ay dumating sa akin, at tinakpan ako ng kakilabutan."
            },
            {
              "chapter": 55,
              "verse": 6,
              "name": "Mga Awit 55:6",
              "text": "At aking sinabi, Oh kung ako'y nagkaroon ng mga pakpak na gaya ng kalapati! Lilipad nga ako, at magpapahinga."
            },
            {
              "chapter": 55,
              "verse": 7,
              "name": "Mga Awit 55:7",
              "text": "Narito, kung magkagayo'y gagala ako sa malayo, ako'y titigil sa ilang. (Selah)"
            },
            {
              "chapter": 55,
              "verse": 8,
              "name": "Mga Awit 55:8",
              "text": "Ako'y magmamadaling sisilong mula sa malakas na hangin at bagyo."
            },
            {
              "chapter": 55,
              "verse": 9,
              "name": "Mga Awit 55:9",
              "text": "Ipahamak mo, Oh Panginoon, at guluhin mo ang kanilang wika: sapagka't ako'y nakakita ng pangdadahas at pagaaway sa bayan."
            },
            {
              "chapter": 55,
              "verse": 10,
              "name": "Mga Awit 55:10",
              "text": "Araw at gabi ay nagsisiligid sila sa mga kuta niyaon: kasamaan man at kahirapan ay nangasa gitna rin niyaon."
            },
            {
              "chapter": 55,
              "verse": 11,
              "name": "Mga Awit 55:11",
              "text": "Kasamaan ay nasa gitna niyaon; ang pagpighati at pagdaraya ay hindi humihiwalay sa kaniyang mga lansangan."
            },
            {
              "chapter": 55,
              "verse": 12,
              "name": "Mga Awit 55:12",
              "text": "Sapagka't hindi kaaway ang dumuwahagi sa akin; akin nga sanang nabata: ni hindi rin ang nagtatanim sa akin ang nagmamalaki laban sa akin; nagtago nga sana ako sa kaniya:"
            },
            {
              "chapter": 55,
              "verse": 13,
              "name": "Mga Awit 55:13",
              "text": "Kundi ikaw, lalake na kagaya ko, aking kasama at aking kaibigang matalik."
            },
            {
              "chapter": 55,
              "verse": 14,
              "name": "Mga Awit 55:14",
              "text": "Tayo ay maligayang nagpapayuhang magkasama, tayo'y lumalakad na magkaakbay sa bahay ng Dios."
            },
            {
              "chapter": 55,
              "verse": 15,
              "name": "Mga Awit 55:15",
              "text": "Dumating nawang bigla sa kanila ang kamatayan, mababa nawa silang buhay sa Sheol: sapagka't kasamaan ay nasa kanilang tahanan, sa gitna nila."
            },
            {
              "chapter": 55,
              "verse": 16,
              "name": "Mga Awit 55:16",
              "text": "Tungkol sa akin, ay tatawag ako sa Dios; at ililigtas ako ng Panginoon."
            },
            {
              "chapter": 55,
              "verse": 17,
              "name": "Mga Awit 55:17",
              "text": "Sa hapon at sa umaga, at sa katanghaliang tapat, ako'y dadaing at hihibik: at kaniyang didinggin ang aking tinig."
            },
            {
              "chapter": 55,
              "verse": 18,
              "name": "Mga Awit 55:18",
              "text": "Kaniyang tinubos ang aking kaluluwa sa kapayapaan mula sa pagbabaka laban sa akin: Sapagka't sila'y marami na nakikipaglaban sa akin."
            },
            {
              "chapter": 55,
              "verse": 19,
              "name": "Mga Awit 55:19",
              "text": "Didinggin ng Dios, at paghihigantihan sila, siyang tumatahan ng una. (Selah)"
            },
            {
              "chapter": 55,
              "verse": 20,
              "name": "Mga Awit 55:20",
              "text": "Kaniyang iniunat ang kaniyang mga kamay laban sa gayon na nasa kapayapaan sa kaniya: kaniyang nilapastangan ang kaniyang tipan."
            },
            {
              "chapter": 55,
              "verse": 21,
              "name": "Mga Awit 55:21",
              "text": "Ang kaniyang bibig ay malambot na parang mantekilya: nguni't ang kaniyang puso ay pakikidigma: ang kaniyang mga salita ay lalong mabanayad kay sa langis, gayon ma'y mga bunot na tabak."
            },
            {
              "chapter": 55,
              "verse": 22,
              "name": "Mga Awit 55:22",
              "text": "Ilagay mo ang iyong pasan sa Panginoon, at kaniyang aalalayan ka: hindi niya titiising makilos kailan man ang matuwid."
            },
            {
              "chapter": 55,
              "verse": 23,
              "name": "Mga Awit 55:23",
              "text": "Nguni't ikaw, Oh Dios, ibababa mo sila sa hukay ng kapahamakan: mga mabagsik at magdarayang tao ay hindi darating sa kalahati ng kanilang mga kaarawan; nguni't titiwala ako sa iyo."
            }
          ]
        },
        {
          "chapter": 56,
          "name": "Mga Awit 56",
          "verses": [
            {
              "chapter": 56,
              "verse": 1,
              "name": "Mga Awit 56:1",
              "text": "Maawa ka sa akin, Oh Dios: sapagka't sasakmalin ako ng tao: buong araw ay nangbababag siya na pinipighati ako."
            },
            {
              "chapter": 56,
              "verse": 2,
              "name": "Mga Awit 56:2",
              "text": "Ibig akong sakmalin ng aking mga kaaway buong araw: sapagka't sila'y maraming may kapalaluan na nagsisilaban sa akin."
            },
            {
              "chapter": 56,
              "verse": 3,
              "name": "Mga Awit 56:3",
              "text": "Sa panahong ako'y matakot, aking ilalagak ang aking tiwala sa iyo."
            },
            {
              "chapter": 56,
              "verse": 4,
              "name": "Mga Awit 56:4",
              "text": "Sa Dios (ay pupuri ako ng kaniyang salita), sa Dios ay inilagak ko ang aking tiwala, hindi ako matatakot; anong magagawa ng laman sa akin?"
            },
            {
              "chapter": 56,
              "verse": 5,
              "name": "Mga Awit 56:5",
              "text": "Buong araw ay binabaligtad nila ang aking mga salita: lahat ng kanilang mga pagiisip ay laban sa akin sa ikasasama."
            },
            {
              "chapter": 56,
              "verse": 6,
              "name": "Mga Awit 56:6",
              "text": "Sila'y nagpipisan, sila'y nagsisipagkubli, kanilang tinatandaan ang aking mga hakbang, gaya ng kanilang pagaabang sa aking kaluluwa."
            },
            {
              "chapter": 56,
              "verse": 7,
              "name": "Mga Awit 56:7",
              "text": "Tatakas ba sila sa pamamagitan ng masama? Sa galit ay ilugmok mo ang mga bayan, Oh Dios."
            },
            {
              "chapter": 56,
              "verse": 8,
              "name": "Mga Awit 56:8",
              "text": "Iyong isinasaysay ang aking mga paggagala: ilagay mo ang aking mga luha sa iyong botelya; wala ba sila sa iyong aklat?"
            },
            {
              "chapter": 56,
              "verse": 9,
              "name": "Mga Awit 56:9",
              "text": "Tatalikod nga ang aking mga kaaway sa kaarawan na ako'y tumawag: ito'y nalalaman ko, sapagka't ang Dios ay kakampi ko."
            },
            {
              "chapter": 56,
              "verse": 10,
              "name": "Mga Awit 56:10",
              "text": "Sa Dios (ay pupuri ako ng salita), sa Panginoon (ay pupuri ako ng salita),"
            },
            {
              "chapter": 56,
              "verse": 11,
              "name": "Mga Awit 56:11",
              "text": "Sa Dios ay inilagak ko ang aking tiwala, hindi ako matatakot; anong magagawa ng tao sa akin?"
            },
            {
              "chapter": 56,
              "verse": 12,
              "name": "Mga Awit 56:12",
              "text": "Ang iyong mga panata ay sa akin, Oh Dios: ako'y magbabayad ng mga handog na pasalamat sa iyo."
            },
            {
              "chapter": 56,
              "verse": 13,
              "name": "Mga Awit 56:13",
              "text": "Sapagka't iniligtas mo ang aking kaluluwa sa kamatayan: hindi mo ba iniligtas ang aking mga paa sa pagkahulog? upang ako'y makalakad sa harap ng Dios sa liwanag ng buhay."
            }
          ]
        },
        {
          "chapter": 57,
          "name": "Mga Awit 57",
          "verses": [
            {
              "chapter": 57,
              "verse": 1,
              "name": "Mga Awit 57:1",
              "text": "Maawa ka sa akin, Oh Dios, maawa ka sa akin; sapagka't ang aking kaluluwa ay nanganganlong sa iyo. Oo, sa lilim ng iyong mga pakpak ay manganganlong ako, hanggang sa makaraan ang mga kasakunaang ito."
            },
            {
              "chapter": 57,
              "verse": 2,
              "name": "Mga Awit 57:2",
              "text": "Ako'y dadaing sa Dios na Kataastaasan; sa Dios na nagsagawa ng lahat na mga bagay sa akin."
            },
            {
              "chapter": 57,
              "verse": 3,
              "name": "Mga Awit 57:3",
              "text": "Siya'y magsusugo mula sa langit, at ililigtas ako, pagka yaong lulunok sa akin ay dumuduwahagi; (Selah) susuguin ng Dios ang kaniyang kagandahang-loob at ang kaniyang katotohanan."
            },
            {
              "chapter": 57,
              "verse": 4,
              "name": "Mga Awit 57:4",
              "text": "Ang aking kaluluwa ay nasa gitna ng mga leon: ako'y nahihiga sa gitna niyaong mga pinaningasan ng apoy, sa mga anak ng tao, na ang mga ngipin ay sibat at mga pana, at ang kanilang dila ay matalas na tabak."
            },
            {
              "chapter": 57,
              "verse": 5,
              "name": "Mga Awit 57:5",
              "text": "Mabunyi ka, Oh Dios, sa itaas ng mga langit; mataas ang iyong kaluwalhatian sa buong lupa."
            },
            {
              "chapter": 57,
              "verse": 6,
              "name": "Mga Awit 57:6",
              "text": "Kanilang hinandaan ng silo ang aking mga hakbang. Ang aking kaluluwa ay nakayuko: sila'y nagsihukay ng isang lungaw sa harap ko. Sila'y nangahulog sa gitna niyaon. (Selah)"
            },
            {
              "chapter": 57,
              "verse": 7,
              "name": "Mga Awit 57:7",
              "text": "Ang aking puso ay matatag, Oh Dios, ang aking puso ay matatag: ako'y aawit, oo, ako'y aawit ng mga pagpuri."
            },
            {
              "chapter": 57,
              "verse": 8,
              "name": "Mga Awit 57:8",
              "text": "Gumising ka, kaluwalhatian ko; gumising ka, salterio at alpa: ako'y gigising na maaga."
            },
            {
              "chapter": 57,
              "verse": 9,
              "name": "Mga Awit 57:9",
              "text": "Ako'y magpapasalamat sa iyo, Oh Panginoon, sa gitna ng mga bayan: ako'y aawit sa iyo ng mga pagpuri sa gitna ng mga bansa."
            },
            {
              "chapter": 57,
              "verse": 10,
              "name": "Mga Awit 57:10",
              "text": "Sapagka't ang iyong kagandahang-loob ay dakila hanggang sa mga langit, at ang iyong katotohanan hanggang sa mga alapaap."
            },
            {
              "chapter": 57,
              "verse": 11,
              "name": "Mga Awit 57:11",
              "text": "Mabunyi ka, Oh Dios, sa itaas ng mga langit; mataas ang iyong kaluwalhatian sa buong lupa."
            }
          ]
        },
        {
          "chapter": 58,
          "name": "Mga Awit 58",
          "verses": [
            {
              "chapter": 58,
              "verse": 1,
              "name": "Mga Awit 58:1",
              "text": "Tunay bang kayo'y nangagsasalita ng katuwiran Oh kayong mga makapangyarihan? Nagsisihatol ba kayo ng matuwid, Oh kayong mga anak ng mga tao?"
            },
            {
              "chapter": 58,
              "verse": 2,
              "name": "Mga Awit 58:2",
              "text": "Oo, sa puso ay nagsisigawa kayo ng kasamaan; inyong tinitimbang ang pangdadahas ng inyong mga kamay sa lupa."
            },
            {
              "chapter": 58,
              "verse": 3,
              "name": "Mga Awit 58:3",
              "text": "Ang masama ay naliligaw mula sa bahay-bata: sila'y naliligaw pagkapanganak sa kanila, na nagsasalita ng mga kasinungalingan."
            },
            {
              "chapter": 58,
              "verse": 4,
              "name": "Mga Awit 58:4",
              "text": "Ang kanilang kamandag ay parang kamandag ng ahas: sila'y gaya ng binging ahas na nagtatakip ng kaniyang pakinig;"
            },
            {
              "chapter": 58,
              "verse": 5,
              "name": "Mga Awit 58:5",
              "text": "At hindi nakakarinig ng tinig ng mga enkantador, na kailan man ay hindi umeenkanto ng gayon na may karunungan."
            },
            {
              "chapter": 58,
              "verse": 6,
              "name": "Mga Awit 58:6",
              "text": "Iyong bungalin ang kanilang mga ngipin, Oh Dios, sa kanilang bibig: iyong bungalin ang mga malaking ngipin ng mga batang leon, Oh Panginoon."
            },
            {
              "chapter": 58,
              "verse": 7,
              "name": "Mga Awit 58:7",
              "text": "Mangatunaw nawa silang parang tubig na umaagos: pagka inihilagpos niya ang kaniyang mga palaso, maging gaya nawa ng nangaluray."
            },
            {
              "chapter": 58,
              "verse": 8,
              "name": "Mga Awit 58:8",
              "text": "Maging gaya nawa ng laman ng laman ng suso na natutunaw at napapawi: na gaya ng naagas sa babae na hindi nakakita ng araw."
            },
            {
              "chapter": 58,
              "verse": 9,
              "name": "Mga Awit 58:9",
              "text": "Bago makaramdam ang inyong mga palyok ng mga dawag na panggatong, kaniyang kukunin ang mga yaon ng ipoipo, ang sariwa at gayon din ang nagniningas."
            },
            {
              "chapter": 58,
              "verse": 10,
              "name": "Mga Awit 58:10",
              "text": "Magagalak ang matuwid pagka nakita niya ang higanti: kaniyang huhugasan ang kaniyang mga paa sa dugo ng masama."
            },
            {
              "chapter": 58,
              "verse": 11,
              "name": "Mga Awit 58:11",
              "text": "Na anopa't sasabihin ng mga tao, Katotohanang may kagantihan sa matuwid: katotohanang may Dios na humahatol sa lupa."
            }
          ]
        },
        {
          "chapter": 59,
          "name": "Mga Awit 59",
          "verses": [
            {
              "chapter": 59,
              "verse": 1,
              "name": "Mga Awit 59:1",
              "text": "Iligtas mo ako sa aking mga kaaway, Oh Dios ko: ilagay mo ako sa mataas sa kanila na nagsisibangon laban sa akin."
            },
            {
              "chapter": 59,
              "verse": 2,
              "name": "Mga Awit 59:2",
              "text": "Iligtas mo ako sa mga manggagawa ng kasamaan, at iligtas mo ako sa mga mabagsik na tao."
            },
            {
              "chapter": 59,
              "verse": 3,
              "name": "Mga Awit 59:3",
              "text": "Sapagka't narito, kanilang binabakayan ang aking kaluluwa; ang mga makapangyarihan ay nagpipisan laban sa akin: hindi dahil sa aking pagsalangsang, o sa aking kasalanan man, Oh Panginoon."
            },
            {
              "chapter": 59,
              "verse": 4,
              "name": "Mga Awit 59:4",
              "text": "Sila'y nagsisitakbo at nagsisihanda na wala akong sala: ikaw ay gumising na tulungan mo ako, at masdan mo."
            },
            {
              "chapter": 59,
              "verse": 5,
              "name": "Mga Awit 59:5",
              "text": "Sa makatuwid baga'y ikaw, Oh Panginoong Dios ng mga hukbo, na Dios ng Israel, ikaw ay bumangon upang iyong dalawin ang lahat ng mga bansa: huwag kang maawa sa kanino mang masamang mananalangsang. (Selah)"
            },
            {
              "chapter": 59,
              "verse": 6,
              "name": "Mga Awit 59:6",
              "text": "Sila'y nagsibalik sa kinahapunan, sila'y nagsitahol na parang aso, at nililigid ang bayan."
            },
            {
              "chapter": 59,
              "verse": 7,
              "name": "Mga Awit 59:7",
              "text": "Narito, sila'y nanunungayaw ng kanilang bibig; mga tabak ay nangasa kanilang mga labi: sapagka't sino, sabi nila, ang nakikinig?"
            },
            {
              "chapter": 59,
              "verse": 8,
              "name": "Mga Awit 59:8",
              "text": "Nguni't ikaw, Oh Panginoon, tatawa sa kanila; iyong tutuyain ang lahat ng mga bansa."
            },
            {
              "chapter": 59,
              "verse": 9,
              "name": "Mga Awit 59:9",
              "text": "Dahil sa kaniyang kalakasan, didinggin kita; sapagka't ang Dios ay aking matayog na moog."
            },
            {
              "chapter": 59,
              "verse": 10,
              "name": "Mga Awit 59:10",
              "text": "Ang aking Dios pati ng kaniyang kagandahang-loob ay sasalubong sa akin: ipakikita ng Dios sa akin ang aking nasa sa aking mga kaaway."
            },
            {
              "chapter": 59,
              "verse": 11,
              "name": "Mga Awit 59:11",
              "text": "Huwag mo silang patayin, baka makalimot ang aking bayan; pangalatin mo sila ng iyong kapangyarihan, at ibaba mo sila, Oh Panginoon na kalasag namin."
            },
            {
              "chapter": 59,
              "verse": 12,
              "name": "Mga Awit 59:12",
              "text": "Dahil sa kasalanan ng kanilang bibig, at sa mga salita ng kanilang mga labi, makuha nawa sila sa kanilang kapalaluan, at dahil sa sumpa at pagsisinungaling na kanilang sinalita."
            },
            {
              "chapter": 59,
              "verse": 13,
              "name": "Mga Awit 59:13",
              "text": "Pugnawin mo sila sa poot, pugnawin mo sila, upang sila'y mawala: at ipakilala mo sa kanila na ang Dios ay nagpupuno sa Jacob, hanggang sa mga wakas ng lupa. (Selah)"
            },
            {
              "chapter": 59,
              "verse": 14,
              "name": "Mga Awit 59:14",
              "text": "At sa kinahapunan ay papagbalikin mo sila, pahagulhulin mo silang parang aso, at libutin nila ang bayan."
            },
            {
              "chapter": 59,
              "verse": 15,
              "name": "Mga Awit 59:15",
              "text": "Sila'y gagala na magmamanhik-manaog dahil sa pagkain, at maghihintay buong gabi kung hindi sila mabusog."
            },
            {
              "chapter": 59,
              "verse": 16,
              "name": "Mga Awit 59:16",
              "text": "Nguni't aking aawitin ang iyong kalakasan; Oo, aking aawiting malakas ang iyong kagandahang-loob sa kinaumagahan: sapagka't ikaw ay naging aking matayog na moog, at kanlungan sa kaarawan ng aking kabagabagan."
            },
            {
              "chapter": 59,
              "verse": 17,
              "name": "Mga Awit 59:17",
              "text": "Sa iyo, Oh kalakasan ko, aawit ako ng mga pagpuri: sapagka't ang Dios ay aking matayog na moog, ang Dios ng aking kaawaan."
            }
          ]
        },
        {
          "chapter": 60,
          "name": "Mga Awit 60",
          "verses": [
            {
              "chapter": 60,
              "verse": 1,
              "name": "Mga Awit 60:1",
              "text": "Oh Dios, iniwaksi mo kami, ibinagsak mo kami; ikaw ay nagalit; Oh papanauliin mo kami."
            },
            {
              "chapter": 60,
              "verse": 2,
              "name": "Mga Awit 60:2",
              "text": "Iyong niyanig ang lupain; iyong pinabuka: pagalingin mo ang mga sira niyaon: sapagka't umuuga."
            },
            {
              "chapter": 60,
              "verse": 3,
              "name": "Mga Awit 60:3",
              "text": "Nagpakita ka sa iyong bayan ng mahihirap na bagay: iyong ipinainom sa amin ang alak na pangpagiray."
            },
            {
              "chapter": 60,
              "verse": 4,
              "name": "Mga Awit 60:4",
              "text": "Nagbigay ka ng watawat sa nangatatakot sa iyo, upang maiwagayway dahil sa katotohanan. (Selah)"
            },
            {
              "chapter": 60,
              "verse": 5,
              "name": "Mga Awit 60:5",
              "text": "Upang ang iyong minamahal ay makaligtas, magligtas ka ng iyong kanan, at sagutin mo kami."
            },
            {
              "chapter": 60,
              "verse": 6,
              "name": "Mga Awit 60:6",
              "text": "Nagsalita ang Dios sa kaniyang kabanalan; ako'y magsasaya: aking hahatiin ang Sichem, at aking susukatin ang libis ng Succoth,"
            },
            {
              "chapter": 60,
              "verse": 7,
              "name": "Mga Awit 60:7",
              "text": "Galaad ay akin, at Manases ay akin; Ephraim naman ay sanggalang ng aking ulo; Juda ay aking setro."
            },
            {
              "chapter": 60,
              "verse": 8,
              "name": "Mga Awit 60:8",
              "text": "Moab ay aking hugasan; sa Edom ay aking ihahagis ang aking panyapak; Filistia, humiyaw ka dahil sa akin."
            },
            {
              "chapter": 60,
              "verse": 9,
              "name": "Mga Awit 60:9",
              "text": "Sinong magdadala sa akin sa matibay na bayan? Sinong papatnubay sa akin hanggang sa Edom?"
            },
            {
              "chapter": 60,
              "verse": 10,
              "name": "Mga Awit 60:10",
              "text": "Hindi mo ba kami iniwaksi, Oh Dios? At hindi ka lumalabas, Oh Dios, na kasama ng aming mga hukbo."
            },
            {
              "chapter": 60,
              "verse": 11,
              "name": "Mga Awit 60:11",
              "text": "Tulungan mo kami laban sa kaaway; sapagka't walang kabuluhan ang tulong ng tao."
            },
            {
              "chapter": 60,
              "verse": 12,
              "name": "Mga Awit 60:12",
              "text": "Sa pamamagitan ng Dios ay gagawa kaming may katapangan: sapagka't siya ang yumayapak sa aming mga kaaway."
            }
          ]
        },
        {
          "chapter": 61,
          "name": "Mga Awit 61",
          "verses": [
            {
              "chapter": 61,
              "verse": 1,
              "name": "Mga Awit 61:1",
              "text": "Dinggin mo ang aking daing, Oh Dios; pakinggan mo ang aking dalangin."
            },
            {
              "chapter": 61,
              "verse": 2,
              "name": "Mga Awit 61:2",
              "text": "Mula sa wakas ng lupa ay tatawag ako sa iyo, pagka nanglupaypay ang aking puso: patnubayan mo ako sa malaking bato na lalong mataas kay sa akin."
            },
            {
              "chapter": 61,
              "verse": 3,
              "name": "Mga Awit 61:3",
              "text": "Sapagka't ikaw ay naging aking kanlungan, matibay na moog sa kaaway."
            },
            {
              "chapter": 61,
              "verse": 4,
              "name": "Mga Awit 61:4",
              "text": "Ako'y tatahan sa iyong tabernakulo magpakailan man: ako'y manganganlong sa lilim ng iyong mga pakpak. (Selah)"
            },
            {
              "chapter": 61,
              "verse": 5,
              "name": "Mga Awit 61:5",
              "text": "Sapagka't dininig mo, Oh Dios, ang aking mga panata: ibinigay mo ang mana sa nangatatakot sa iyong pangalan."
            },
            {
              "chapter": 61,
              "verse": 6,
              "name": "Mga Awit 61:6",
              "text": "Iyong pahahabain ang buhay ng hari: Ang kaniyang mga taon ay magiging parang malaong panahon."
            },
            {
              "chapter": 61,
              "verse": 7,
              "name": "Mga Awit 61:7",
              "text": "Siya'y tatahan sa harap ng Dios magpakailan man: Oh maghanda ka ng kagandahang-loob at katotohanan, upang mapalagi siya."
            },
            {
              "chapter": 61,
              "verse": 8,
              "name": "Mga Awit 61:8",
              "text": "Sa gayo'y aawit ako ng pagpuri sa iyong pangalan magpakailan man. Upang maisagawa ko araw-araw ang aking mga panata."
            }
          ]
        },
        {
          "chapter": 62,
          "name": "Mga Awit 62",
          "verses": [
            {
              "chapter": 62,
              "verse": 1,
              "name": "Mga Awit 62:1",
              "text": "Sa Dios lamang naghihintay ng tahimik ang aking kaluluwa: sa kaniya galing ang aking kaligtasan."
            },
            {
              "chapter": 62,
              "verse": 2,
              "name": "Mga Awit 62:2",
              "text": "Siya lamang ang aking kanlungan at aking kaligtasan: siya ang aking matayog na moog; hindi ako lubhang makikilos."
            },
            {
              "chapter": 62,
              "verse": 3,
              "name": "Mga Awit 62:3",
              "text": "Hanggang kailan maghahaka kayo ng masama laban sa isang tao. Upang patayin siya ninyong lahat, na gaya ng pader na tumagilid, o bakod na nabubuwal?"
            },
            {
              "chapter": 62,
              "verse": 4,
              "name": "Mga Awit 62:4",
              "text": "Sila'y nagsisisangguni lamang upang ibagsak siya sa kaniyang karilagan; sila'y natutuwa sa mga kasinungalingan: sila'y nagsisibasbas ng kanilang bibig, nguni't nanganunumpa sa loob. (Selah)"
            },
            {
              "chapter": 62,
              "verse": 5,
              "name": "Mga Awit 62:5",
              "text": "Kaluluwa ko, maghintay kang tahimik sa Dios lamang; sapagka't ang aking pagasa ay mula sa kaniya."
            },
            {
              "chapter": 62,
              "verse": 6,
              "name": "Mga Awit 62:6",
              "text": "Siya lamang ang aking malaking bato at aking kaligtasan: siya'y aking matayog na moog; hindi ako makikilos."
            },
            {
              "chapter": 62,
              "verse": 7,
              "name": "Mga Awit 62:7",
              "text": "Nasa Dios ang aking kaligtasan at aking kaluwalhatian; ang malaking bato ng aking kalakasan, at ang kanlungan ko'y nasa Dios."
            },
            {
              "chapter": 62,
              "verse": 8,
              "name": "Mga Awit 62:8",
              "text": "Magsitiwala kayo sa kaniya buong panahon, kayong mga bayan; buksan ninyo ang inyong dibdib sa harap niya; Dios ay kanlungan sa atin. (Selah)"
            },
            {
              "chapter": 62,
              "verse": 9,
              "name": "Mga Awit 62:9",
              "text": "Tunay na walang kabuluhan ang mga taong may mababang kalagayan, at ang mga taong may mataas na kalagayan ay kabulaanan: sa mga timbangan ay sasampa sila; silang magkakasama ay lalong magaan kay sa walang kabuluhan."
            },
            {
              "chapter": 62,
              "verse": 10,
              "name": "Mga Awit 62:10",
              "text": "Huwag kang tumiwala sa kapighatian, at huwag maging walang kabuluhan sa pagnanakaw: kung ang mga kayamanan ay lumago, huwag ninyong paglalagakan ng inyong puso."
            },
            {
              "chapter": 62,
              "verse": 11,
              "name": "Mga Awit 62:11",
              "text": "Ang Dios ay nagsalitang minsan, makalawang aking narinig ito; na ang kapangyarihan ay ukol sa Dios:"
            },
            {
              "chapter": 62,
              "verse": 12,
              "name": "Mga Awit 62:12",
              "text": "Sa iyo naman, Oh Panginoon, ukol ang kagandahang-loob: sapagka't ikaw ay nagbabayad sa bawa't tao ayon sa kaniyang gawa."
            }
          ]
        },
        {
          "chapter": 63,
          "name": "Mga Awit 63",
          "verses": [
            {
              "chapter": 63,
              "verse": 1,
              "name": "Mga Awit 63:1",
              "text": "Oh Dios, ikaw ay Dios ko; hahanapin kitang maaga: kinauuhawan ka ng aking kaluluwa, pinananabikan ka ng aking laman, sa isang tuyo at uhaw na lupa na walang tubig."
            },
            {
              "chapter": 63,
              "verse": 2,
              "name": "Mga Awit 63:2",
              "text": "Sa gayo'y tumingin ako sa iyo sa santuario. Upang tanawin ang iyong kapangyarihan at ang iyong kaluwalhatian."
            },
            {
              "chapter": 63,
              "verse": 3,
              "name": "Mga Awit 63:3",
              "text": "Sapagka't ang iyong kagandahang-loob ay mainam kay sa buhay: pupurihin ka ng aking mga labi."
            },
            {
              "chapter": 63,
              "verse": 4,
              "name": "Mga Awit 63:4",
              "text": "Sa gayo'y pupurihin kita habang ako'y nabubuhay: igagawad ko ang aking mga kamay sa iyong pangalan."
            },
            {
              "chapter": 63,
              "verse": 5,
              "name": "Mga Awit 63:5",
              "text": "Ang kaluluwa ko'y matutuwa na gaya sa utak at taba; at ang bibig ko'y pupuri sa iyo ng masayang mga labi;"
            },
            {
              "chapter": 63,
              "verse": 6,
              "name": "Mga Awit 63:6",
              "text": "Pagka naaalaala kita sa aking higaan, at ginugunita kita sa pagbabantay sa gabi."
            },
            {
              "chapter": 63,
              "verse": 7,
              "name": "Mga Awit 63:7",
              "text": "Sapagka't naging katulong kita, at sa lilim ng mga pakpak mo'y magagalak ako."
            },
            {
              "chapter": 63,
              "verse": 8,
              "name": "Mga Awit 63:8",
              "text": "Ang kaluluwa ko'y nanununod na mainam sa iyo: inaalalayan ako ng iyong kanan."
            },
            {
              "chapter": 63,
              "verse": 9,
              "name": "Mga Awit 63:9",
              "text": "Nguni't ang nagsisihanap ng kaluluwa ko, upang ipahamak, magsisilusong sa mga lalong mababang bahagi ng lupa."
            },
            {
              "chapter": 63,
              "verse": 10,
              "name": "Mga Awit 63:10",
              "text": "Sila'y mangahuhulog sa kapangyarihan ng tabak: sila'y magiging pagkain sa mga zorra."
            },
            {
              "chapter": 63,
              "verse": 11,
              "name": "Mga Awit 63:11",
              "text": "Nguni't ang hari ay magagalak sa Dios: bawa't sumusumpa sa pamamagitan niya ay luluwalhati; sapagka't ang bibig nila na nagsasalita ng mga kasinungalingan ay patitigilin."
            }
          ]
        },
        {
          "chapter": 64,
          "name": "Mga Awit 64",
          "verses": [
            {
              "chapter": 64,
              "verse": 1,
              "name": "Mga Awit 64:1",
              "text": "Dinggin mo ang tinig ko, Oh Dios, sa aking hibik: ingatan mo ang buhay ko sa pagkatakot sa kaaway."
            },
            {
              "chapter": 64,
              "verse": 2,
              "name": "Mga Awit 64:2",
              "text": "Ikubli mo ako sa lihim na payo ng mga manggagawa ng kasamaan; sa panggugulo ng mga manggagawa ng kasamaan:"
            },
            {
              "chapter": 64,
              "verse": 3,
              "name": "Mga Awit 64:3",
              "text": "Na siyang nangaghasa ng kanilang dila na parang tabak, at pinahilagpos ang kanilang mga palaso, sa makatuwid baga'y ang masasakit na salita:"
            },
            {
              "chapter": 64,
              "verse": 4,
              "name": "Mga Awit 64:4",
              "text": "Upang kanilang maihilagpos sa sakdal sa mga lihim na dako: biglang inihihilagpos nila sa kaniya at hindi natatakot."
            },
            {
              "chapter": 64,
              "verse": 5,
              "name": "Mga Awit 64:5",
              "text": "Sila'y nagpapakatapang sa masamang akala; sila'y nagsasangusapan ng paglalagay ng lihim na silo; Sinasabi nila, Sinong makakakita?"
            },
            {
              "chapter": 64,
              "verse": 6,
              "name": "Mga Awit 64:6",
              "text": "Sila'y nagsisipagsiyasat ng mga kasamaan; aming naganap, sabi nila, ang masikap na pagsiyasat; at ang pagiisip sa loob ng bawa't isa, at ang puso ay malalim."
            },
            {
              "chapter": 64,
              "verse": 7,
              "name": "Mga Awit 64:7",
              "text": "Nguni't pahihilagpusan sila ng Dios; sila'y masusugatang bigla ng isang palaso."
            },
            {
              "chapter": 64,
              "verse": 8,
              "name": "Mga Awit 64:8",
              "text": "Sa gayo'y sila'y matitisod palibhasa't ang kanilang sariling dila ay laban sa kanila: ang lahat na makakita sa kanila ay mangaguuga ng ulo."
            },
            {
              "chapter": 64,
              "verse": 9,
              "name": "Mga Awit 64:9",
              "text": "At lahat ng mga tao ay mangatatakot; at kanilang ipahahayag ang salita ng Dios, at may karunungang kanilang bubuhayin ang kanilang gawa."
            },
            {
              "chapter": 64,
              "verse": 10,
              "name": "Mga Awit 64:10",
              "text": "Ang matuwid ay matutuwa sa Panginoon, at manganganlong sa kaniya; at lahat ng mga matuwid sa puso ay magsisiluwalhati."
            }
          ]
        },
        {
          "chapter": 65,
          "name": "Mga Awit 65",
          "verses": [
            {
              "chapter": 65,
              "verse": 1,
              "name": "Mga Awit 65:1",
              "text": "Ang kapurihan ay naghihintay sa iyo, Oh Dios, sa Sion: at sa iyo'y maisasagawa ang panata."
            },
            {
              "chapter": 65,
              "verse": 2,
              "name": "Mga Awit 65:2",
              "text": "Oh ikaw na dumidinig ng dalangin, sa iyo'y paroroon ang lahat ng laman."
            },
            {
              "chapter": 65,
              "verse": 3,
              "name": "Mga Awit 65:3",
              "text": "Mga kasamaan ay nangananaig laban sa akin: tungkol sa aming pagsalangsang, ay lilinisin mo."
            },
            {
              "chapter": 65,
              "verse": 4,
              "name": "Mga Awit 65:4",
              "text": "Mapalad ang tao na iyong pinipili, at pinalalapit mo sa iyo, upang siya'y makatahan sa iyong mga looban: kami ay mangasisiyahan sa kabutihan ng iyong bahay, ng iyong banal na templo."
            },
            {
              "chapter": 65,
              "verse": 5,
              "name": "Mga Awit 65:5",
              "text": "Sasagutin mo kami sa katuwiran sa pamamagitan ng mga kakilakilabot na bagay, Oh Dios ng aming kaligtasan; ikaw na katiwalaan ng lahat na wakas ng lupa, at nila na malayo sa dagat:"
            },
            {
              "chapter": 65,
              "verse": 6,
              "name": "Mga Awit 65:6",
              "text": "Na naglalagay na matibay ng mga bundok sa pamamagitan ng kaniyang kalakasan; palibhasa't nabibigkisan sa palibot ng kapangyarihan:"
            },
            {
              "chapter": 65,
              "verse": 7,
              "name": "Mga Awit 65:7",
              "text": "Na nagpapatigil ng hugong ng mga dagat, ng hugong ng kanilang mga alon, at ng kaingay ng mga bayan."
            },
            {
              "chapter": 65,
              "verse": 8,
              "name": "Mga Awit 65:8",
              "text": "Sila naman na nagsisitahan sa mga pinakadulong bahagi ay nangatatakot sa iyong mga tanda: ikaw ang nagbibigay galak sa pagbubukang liwayway at pagtatakip-silim."
            },
            {
              "chapter": 65,
              "verse": 9,
              "name": "Mga Awit 65:9",
              "text": "Iyong dinadalaw ang lupa, at dinidilig mo, iyong pinayayamang mainam; ang ilog ng Dios ay puno ng tubig: iyong pinagtataanan sila ng trigo, pagka't inihanda mo ang lupa."
            },
            {
              "chapter": 65,
              "verse": 10,
              "name": "Mga Awit 65:10",
              "text": "Iyong dinidilig ang kaniyang bungkal ng sagana; iyong pinapantay ang kaniyang mga bungkal; iyong mga pinalalambot ng ambon; iyong pinagpapala ang pagsibol niyaon."
            },
            {
              "chapter": 65,
              "verse": 11,
              "name": "Mga Awit 65:11",
              "text": "Iyong dinudulutan ang taon ng iyong kabutihan; at ang iyong mga landas ay pumapatak ng katabaan."
            },
            {
              "chapter": 65,
              "verse": 12,
              "name": "Mga Awit 65:12",
              "text": "Nagsisipatak sa mga pastulan sa ilang; at ang mga burol ay nabibigkisan ng kagalakan."
            },
            {
              "chapter": 65,
              "verse": 13,
              "name": "Mga Awit 65:13",
              "text": "Ang mga pastulan ay nangabihisan ng mga kawan; ang mga libis naman ay nangatatakpan ng trigo; sila'y magsisihiyaw sa kagalakan, sila naman ay nagsisiawit."
            }
          ]
        },
        {
          "chapter": 66,
          "name": "Mga Awit 66",
          "verses": [
            {
              "chapter": 66,
              "verse": 1,
              "name": "Mga Awit 66:1",
              "text": "Magkaingay kayong may kagalakan sa Dios, buong lupa."
            },
            {
              "chapter": 66,
              "verse": 2,
              "name": "Mga Awit 66:2",
              "text": "Awitin ninyo ang kaluwalhatian ng kaniyang pangalan: paluwalhatiin ninyo ang pagpuri sa kaniya."
            },
            {
              "chapter": 66,
              "verse": 3,
              "name": "Mga Awit 66:3",
              "text": "Inyong sabihin sa Dios, napaka kakilakilabot ng iyong mga gawa! Sa kadakilaan ng iyong kapangyarihan ay magsisuko ang iyong mga kaaway sa iyo."
            },
            {
              "chapter": 66,
              "verse": 4,
              "name": "Mga Awit 66:4",
              "text": "Buong lupa ay sasamba sa iyo, at aawit sa iyo; sila'y magsisiawit sa iyong pangalan. (Selah)"
            },
            {
              "chapter": 66,
              "verse": 5,
              "name": "Mga Awit 66:5",
              "text": "Kayo ay magsiparito, at tingnan ninyo ang mga gawa ng Dios; siya'y kakilakilabot sa kaniyang gawain sa mga anak ng mga tao."
            },
            {
              "chapter": 66,
              "verse": 6,
              "name": "Mga Awit 66:6",
              "text": "Kaniyang pinagiging tuyong lupa ang dagat: sila'y nagsidaan ng paa sa ilog: doo'y nangagalak kami sa kaniya."
            },
            {
              "chapter": 66,
              "verse": 7,
              "name": "Mga Awit 66:7",
              "text": "Siya'y nagpupuno ng kaniyang kapangyarihan magpakailan man: papansinin ng kaniyang mga mata ang mga bansa: huwag mangagpakabunyi ang mga manghihimagsik. (Selah)"
            },
            {
              "chapter": 66,
              "verse": 8,
              "name": "Mga Awit 66:8",
              "text": "Oh purihin ninyo ang ating Dios, ninyong mga bayan, at iparinig ninyo ang tinig ng kaniyang kapurihan:"
            },
            {
              "chapter": 66,
              "verse": 9,
              "name": "Mga Awit 66:9",
              "text": "Na umaalalay sa ating kaluluwa sa buhay, at hindi tumitiis na makilos ang ating mga paa."
            },
            {
              "chapter": 66,
              "verse": 10,
              "name": "Mga Awit 66:10",
              "text": "Sapagka't ikaw, Oh Dios, tinikman mo kami: Iyong sinubok kami na para ng pagsubok sa pilak."
            },
            {
              "chapter": 66,
              "verse": 11,
              "name": "Mga Awit 66:11",
              "text": "Iyong isinuot kami sa silo; ikaw ay naglagay ng mainam na pasan sa aming mga balakang."
            },
            {
              "chapter": 66,
              "verse": 12,
              "name": "Mga Awit 66:12",
              "text": "Iyong pinasakay ang mga tao sa aming mga ulo; kami ay nangagdaan sa apoy at sa tubig; nguni't dinala mo kami sa saganang dako."
            },
            {
              "chapter": 66,
              "verse": 13,
              "name": "Mga Awit 66:13",
              "text": "Ako'y papasok sa iyong bahay na may mga handog na susunugin, aking babayaran sa iyo ang mga panata ko,"
            },
            {
              "chapter": 66,
              "verse": 14,
              "name": "Mga Awit 66:14",
              "text": "Na sinambit ng aking mga labi, at sinalita ng aking bibig, nang ako'y nasa kadalamhatian."
            },
            {
              "chapter": 66,
              "verse": 15,
              "name": "Mga Awit 66:15",
              "text": "Ako'y maghahandog sa iyo ng mga matabang handog na susunugin, na may haing mga tupa; ako'y maghahandog ng mga toro na kasama ng mga kambing. (Selah)"
            },
            {
              "chapter": 66,
              "verse": 16,
              "name": "Mga Awit 66:16",
              "text": "Kayo'y magsiparito at dinggin ninyo, ninyong lahat na nangatatakot sa Dios, at ipahahayag ko kung ano ang kaniyang ginawa sa aking kaluluwa."
            },
            {
              "chapter": 66,
              "verse": 17,
              "name": "Mga Awit 66:17",
              "text": "Ako'y dumaing sa kaniya ng aking bibig, at siya'y ibinunyi ng aking dila."
            },
            {
              "chapter": 66,
              "verse": 18,
              "name": "Mga Awit 66:18",
              "text": "Kung pinakundanganan ko ang kasamaan sa aking puso, hindi ako didinggin ng Panginoon:"
            },
            {
              "chapter": 66,
              "verse": 19,
              "name": "Mga Awit 66:19",
              "text": "Nguni't katotohanang dininig ako ng Dios; kaniyang pinakinggan ang tinig ng aking dalangin."
            },
            {
              "chapter": 66,
              "verse": 20,
              "name": "Mga Awit 66:20",
              "text": "Purihin ang Dios, na hindi iniwaksi ang aking dalangin, ni ang kaniyang kagandahang-loob sa akin."
            }
          ]
        },
        {
          "chapter": 67,
          "name": "Mga Awit 67",
          "verses": [
            {
              "chapter": 67,
              "verse": 1,
              "name": "Mga Awit 67:1",
              "text": "Dios maawa ka sa amin, at pagpalain mo kami, at pasilangin nawa niya ang kaniyang mukha sa amin; (Selah)"
            },
            {
              "chapter": 67,
              "verse": 2,
              "name": "Mga Awit 67:2",
              "text": "Upang ang iyong daan ay maalaman sa lupa, ang iyong pangligtas na kagalingan sa lahat ng mga bansa."
            },
            {
              "chapter": 67,
              "verse": 3,
              "name": "Mga Awit 67:3",
              "text": "Purihin ka ng mga bayan, Oh Dios; purihin ka ng lahat ng mga bayan."
            },
            {
              "chapter": 67,
              "verse": 4,
              "name": "Mga Awit 67:4",
              "text": "Oh mangatuwa at magsiawit sa kasayahan ang mga bansa: sapagka't iyong hahatulan ang mga bayan ng karampatan, at iyong pamamahalaan ang mga bansa sa lupa. (Selah)"
            },
            {
              "chapter": 67,
              "verse": 5,
              "name": "Mga Awit 67:5",
              "text": "Purihin ka ng mga bayan, Oh Dios; purihin ka ng lahat ng mga bayan."
            },
            {
              "chapter": 67,
              "verse": 6,
              "name": "Mga Awit 67:6",
              "text": "Isinibol ng lupa ang kaniyang bunga: ang Dios ang sarili naming Dios ay pagpapalain kami."
            },
            {
              "chapter": 67,
              "verse": 7,
              "name": "Mga Awit 67:7",
              "text": "Pagpapalain kami ng Dios: at lahat ng mga wakas ng lupa ay mangatatakot sa kaniya."
            }
          ]
        },
        {
          "chapter": 68,
          "name": "Mga Awit 68",
          "verses": [
            {
              "chapter": 68,
              "verse": 1,
              "name": "Mga Awit 68:1",
              "text": "Bumangon nawa ang Dios, mangalat ang kaniyang mga kaaway; sila namang nangagtatanim sa kaniya ay magsitakas sa harap niya."
            },
            {
              "chapter": 68,
              "verse": 2,
              "name": "Mga Awit 68:2",
              "text": "Kung paanong napaparam ang usok ay gayon nangapaparam sila. Kung paanong natutunaw ang pagkit sa harap ng apoy, gayon mamatay ang masama sa harapan ng Dios."
            },
            {
              "chapter": 68,
              "verse": 3,
              "name": "Mga Awit 68:3",
              "text": "Nguni't mangatuwa ang matuwid; mangagalak sila sa harap ng Dios: Oo, mangagalak sila ng kasayahan."
            },
            {
              "chapter": 68,
              "verse": 4,
              "name": "Mga Awit 68:4",
              "text": "Kayo'y magsiawit sa Dios, kayo'y magsiawit ng kapurihan sa kaniyang pangalan: ipaghanda ninyo ng maluwang na lansangan siya na nangangabayo sa mga ilang; ang kaniyang pangalan ay JAH; at mangagalak kayo sa harap niya."
            },
            {
              "chapter": 68,
              "verse": 5,
              "name": "Mga Awit 68:5",
              "text": "Ama ng mga ulila, at hukom ng mga babaing bao, ang Dios sa kaniyang banal na tahanan."
            },
            {
              "chapter": 68,
              "verse": 6,
              "name": "Mga Awit 68:6",
              "text": "Pinapagmamaganak ng Dios ang mga nagiisa: kaniyang inilalabas sa kaginhawahan ang mga bilanggo: nguni't ang mga mapanghimagsik ay magsisitahan sa tuyong lupa."
            },
            {
              "chapter": 68,
              "verse": 7,
              "name": "Mga Awit 68:7",
              "text": "Oh Dios, nang ikaw ay lumabas sa harap ng iyong bayan, nang ikaw ay lumakad sa ilang; (Selah)"
            },
            {
              "chapter": 68,
              "verse": 8,
              "name": "Mga Awit 68:8",
              "text": "Ang lupa ay nayanig, ang mga langit naman ay tumulo sa harapan ng Dios: ang Sinai na yaon ay nayanig sa harapan ng Dios, ng Dios ng Israel."
            },
            {
              "chapter": 68,
              "verse": 9,
              "name": "Mga Awit 68:9",
              "text": "Ikaw, Oh Dios, naglagpak ng saganang ulan, iyong pinatibay ang iyong mana, noong ito'y mahina."
            },
            {
              "chapter": 68,
              "verse": 10,
              "name": "Mga Awit 68:10",
              "text": "Ang iyong kapisanan ay tumahan doon: ikaw, Oh Dios, ipinaghanda mo ng iyong kabutihan ang dukha."
            },
            {
              "chapter": 68,
              "verse": 11,
              "name": "Mga Awit 68:11",
              "text": "Nagbibigay ng salita ang Panginoon: ang mga babaing nangaghahayag ng mga balita ay malaking hukbo."
            },
            {
              "chapter": 68,
              "verse": 12,
              "name": "Mga Awit 68:12",
              "text": "Mga hari ng mga hukbo ay nagsisitakas, sila'y nagsisitakas: at nangamamahagi ng samsam ang naiwan sa bahay."
            },
            {
              "chapter": 68,
              "verse": 13,
              "name": "Mga Awit 68:13",
              "text": "Mahihiga ba kayo sa gitna ng mga kulungan ng mga kawan, na parang mga pakpak ng kalapati na natatakpan ng pilak, at ng kaniyang balahibo ng gintong madilaw?"
            },
            {
              "chapter": 68,
              "verse": 14,
              "name": "Mga Awit 68:14",
              "text": "Nang ang Makapangyarihan sa lahat ay magkalat ng mga hari roon, ay tila nagka nieve sa Salmon."
            },
            {
              "chapter": 68,
              "verse": 15,
              "name": "Mga Awit 68:15",
              "text": "Bundok ng Dios ay ang bundok ng Basan; mataas na bundok ang bundok ng Basan."
            },
            {
              "chapter": 68,
              "verse": 16,
              "name": "Mga Awit 68:16",
              "text": "Bakit kayo'y nagsisiirap, kayong matataas na mga bundok, sa bundok na ninasa ng Dios na maging kaniyang tahanan? Oo, tatahan doon ang Panginoon magpakailan man."
            },
            {
              "chapter": 68,
              "verse": 17,
              "name": "Mga Awit 68:17",
              "text": "Ang mga karo ng Dios ay dalawang pung libo sa makatuwid baga'y libolibo: ang Panginoon ay nasa gitna nila, kung paano sa Sinai, gayon sa santuario."
            },
            {
              "chapter": 68,
              "verse": 18,
              "name": "Mga Awit 68:18",
              "text": "Sumampa ka sa mataas, pinatnubayan mo ang iyong bihag sa pagkabihag; tumanggap ka ng mga kaloob sa gitna ng mga tao, Oo, pati sa mga mapanghimagsik, upang makatahang kasama nila ang Panginoong Dios."
            },
            {
              "chapter": 68,
              "verse": 19,
              "name": "Mga Awit 68:19",
              "text": "Purihin ang Panginoon na nagpapasan araw-araw ng aming pasan, sa makatuwid baga'y ang Dios na siyang aming kaligtasan. (Selah)"
            },
            {
              "chapter": 68,
              "verse": 20,
              "name": "Mga Awit 68:20",
              "text": "Ang Dios sa amin ay Dios ng mga kaligtasan; at kay Jehova na Panginoon ukol ang pagpapalaya sa kamatayan."
            },
            {
              "chapter": 68,
              "verse": 21,
              "name": "Mga Awit 68:21",
              "text": "Nguni't sasaktan ng Dios ang ulo ng kaniyang mga kaaway. Ang bunbunang mabuhok ng nagpapatuloy sa kaniyang sala."
            },
            {
              "chapter": 68,
              "verse": 22,
              "name": "Mga Awit 68:22",
              "text": "Sinabi ng Panginoon, ibabalik ko uli mula sa Basan, ibabalik ko uli sila mula sa mga kalaliman ng dagat:"
            },
            {
              "chapter": 68,
              "verse": 23,
              "name": "Mga Awit 68:23",
              "text": "Upang madurog mo sila, na nalulubog ang iyong paa sa dugo, upang ang dila ng iyong mga aso ay magkaroon ng kaniyang pagkain sa iyong mga kaaway."
            },
            {
              "chapter": 68,
              "verse": 24,
              "name": "Mga Awit 68:24",
              "text": "Kanilang nakita ang iyong mga lakad, Oh Dios, sa makatuwid baga'y ang lakad ng aking Dios, ng aking Hari, sa loob ng santuario."
            },
            {
              "chapter": 68,
              "verse": 25,
              "name": "Mga Awit 68:25",
              "text": "Ang mga mangaawit ay nangagpauna, ang mga manunugtog ay nagsisunod, sa gitna ng mga dalaga na nagtutugtugan ng mga pandereta."
            },
            {
              "chapter": 68,
              "verse": 26,
              "name": "Mga Awit 68:26",
              "text": "Purihin ninyo ang Dios sa mga kapisanan, sa makatuwid baga'y ang Panginoon, ninyong mga sa bukal ng lahi ng Israel."
            },
            {
              "chapter": 68,
              "verse": 27,
              "name": "Mga Awit 68:27",
              "text": "Doo'y ang munting Benjamin ay siyang kanilang puno, ang mga pangulo ng Juda at ang kanilang pulong, ang mga pangulo ng Zabulon, ang mga pangulo ng Nephtali."
            },
            {
              "chapter": 68,
              "verse": 28,
              "name": "Mga Awit 68:28",
              "text": "Ang Dios mo'y nagutos ng iyong kalakasan: patibayin mo, Oh Dios, ang ginawa mo sa amin."
            },
            {
              "chapter": 68,
              "verse": 29,
              "name": "Mga Awit 68:29",
              "text": "Dahil sa iyong templo sa Jerusalem mga hari ay mangagdadala ng mga kaloob sa iyo."
            },
            {
              "chapter": 68,
              "verse": 30,
              "name": "Mga Awit 68:30",
              "text": "Sawayin mo ang mga mailap na hayop sa mga puno ng tambo, ang karamihan ng mga toro na kasama ng mga guya ng mga bayan, na niyayapakan sa ilalim ng paa ang mga putol ng pilak; iyong pinangalat ang mga bayan na nangagagalak sa pagdidigma."
            },
            {
              "chapter": 68,
              "verse": 31,
              "name": "Mga Awit 68:31",
              "text": "Mga pangulo ay magsisilabas sa Egipto; magmamadali ang Etiopia na igawad ang kaniyang mga kamay sa Dios."
            },
            {
              "chapter": 68,
              "verse": 32,
              "name": "Mga Awit 68:32",
              "text": "Magsiawit kayo sa Dios, kayong mga kaharian sa lupa; Oh magsiawit kayo ng mga pagpuri sa Panginoon."
            },
            {
              "chapter": 68,
              "verse": 33,
              "name": "Mga Awit 68:33",
              "text": "Sa kaniya na sumasakay sa langit ng mga langit, na noon pang una: narito, binibigkas niya ang kaniyang tinig, na makapangyarihang tinig,"
            },
            {
              "chapter": 68,
              "verse": 34,
              "name": "Mga Awit 68:34",
              "text": "Inyong isa Dios ang kalakasan: ang kaniyang karilagan ay nasa Israel, at ang kaniyang kalakasan ay nasa mga langit."
            },
            {
              "chapter": 68,
              "verse": 35,
              "name": "Mga Awit 68:35",
              "text": "Oh Dios, ikaw ay kakilakilabot mula sa iyong mga dakong banal: ang Dios ng Israel, ay nagbibigay ng kalakasan at kapangyarihan sa kaniyang bayan. Purihin ang Panginoon."
            }
          ]
        },
        {
          "chapter": 69,
          "name": "Mga Awit 69",
          "verses": [
            {
              "chapter": 69,
              "verse": 1,
              "name": "Mga Awit 69:1",
              "text": "Iligtas mo ako, Oh Dios; sapagka't ang tubig ay tumabon sa aking kaluluwa."
            },
            {
              "chapter": 69,
              "verse": 2,
              "name": "Mga Awit 69:2",
              "text": "Ako'y lumulubog sa malalim na burak na walang tayuan: ako'y lumulubog sa malalim na tubig, na tinatabunan ako ng agos."
            },
            {
              "chapter": 69,
              "verse": 3,
              "name": "Mga Awit 69:3",
              "text": "Ako'y hapo sa aking daing; ang lalamunan ko'y tuyo: ang mga mata ko'y nangangalumata habang hinihintay ko ang aking Dios."
            },
            {
              "chapter": 69,
              "verse": 4,
              "name": "Mga Awit 69:4",
              "text": "Silang nangagtatanim sa akin ng walang anomang kadahilanan ay higit kay sa mga buhok ng aking ulo: silang ibig maghiwalay sa akin, na mga kaaway kong may kamalian, ay mga makapangyarihan: akin ngang isinauli ang hindi ko kinuha."
            },
            {
              "chapter": 69,
              "verse": 5,
              "name": "Mga Awit 69:5",
              "text": "Oh Dios, kilala mo ang kamangmangan ko; at ang mga kasalanan ko'y hindi lihim sa iyo."
            },
            {
              "chapter": 69,
              "verse": 6,
              "name": "Mga Awit 69:6",
              "text": "Huwag mangapahiya dahil sa akin ang nangaghihintay sa iyo, Oh Panginoong Dios ng mga hukbo: huwag mangalagay sa kasiraang puri dahil sa akin ang nagsisihanap sa iyo, Oh Dios ng Israel."
            },
            {
              "chapter": 69,
              "verse": 7,
              "name": "Mga Awit 69:7",
              "text": "Sapagka't dahil sa iyo ay nagdala ako ng kadustaan; kahihiyan ay tumakip sa aking mukha."
            },
            {
              "chapter": 69,
              "verse": 8,
              "name": "Mga Awit 69:8",
              "text": "Ako'y naging iba sa aking mga kapatid, at taga ibang lupa sa mga anak ng aking ina."
            },
            {
              "chapter": 69,
              "verse": 9,
              "name": "Mga Awit 69:9",
              "text": "Sapagka't napuspos ako ng sikap sa iyong bahay; at ang mga pagduwahagi nila na nagsisiduwahagi sa iyo ay nangahulog sa akin."
            },
            {
              "chapter": 69,
              "verse": 10,
              "name": "Mga Awit 69:10",
              "text": "Pag umiiyak ako at pinarurusahan ko ng pagaayuno ang aking kaluluwa, yao'y pagkaduwahagi sa akin."
            },
            {
              "chapter": 69,
              "verse": 11,
              "name": "Mga Awit 69:11",
              "text": "Nang magsuot ako ng kayong magaspang, ay naging kawikaan ako sa kanila."
            },
            {
              "chapter": 69,
              "verse": 12,
              "name": "Mga Awit 69:12",
              "text": "Pinag-uusapan ako nilang nangauupo sa pintuang-bayan; at ako ang awit ng mga lango."
            },
            {
              "chapter": 69,
              "verse": 13,
              "name": "Mga Awit 69:13",
              "text": "Nguni't tungkol sa akin, ang dalangin ko'y sa iyo, Oh Panginoon, sa isang kalugodlugod na panahon: Oh Dios, sa karamihan ng iyong kagandahang-loob,"
            },
            {
              "chapter": 69,
              "verse": 14,
              "name": "Mga Awit 69:14",
              "text": "Iligtas mo ako sa burak, at huwag mo akong ilubog: maligtas ako sa kanila na nangagtatanim sa akin, at sa malalim na tubig."
            },
            {
              "chapter": 69,
              "verse": 15,
              "name": "Mga Awit 69:15",
              "text": "Huwag akong tangayin ng baha, ni lamunin man ako ng kalaliman: at huwag takpan ng hukay ang kaniyang bunganga sa akin."
            },
            {
              "chapter": 69,
              "verse": 16,
              "name": "Mga Awit 69:16",
              "text": "Sagutin mo ako, Oh Panginoon; sapagka't ang iyong kagandahang-loob ay mabuti: ayon sa karamihan ng iyong mga malumanay na kaawaan ay bumalik ka sa akin."
            },
            {
              "chapter": 69,
              "verse": 17,
              "name": "Mga Awit 69:17",
              "text": "At huwag mong ikubli ang iyong mukha sa iyong lingkod; sapagka't ako'y nasa kahirapan; sagutin mo akong madali."
            },
            {
              "chapter": 69,
              "verse": 18,
              "name": "Mga Awit 69:18",
              "text": "Lumapit ka sa aking kaluluwa, at tubusin mo: Iligtas mo ako dahil sa aking mga kaaway."
            },
            {
              "chapter": 69,
              "verse": 19,
              "name": "Mga Awit 69:19",
              "text": "Talastas mo ang aking kadustaan, at ang aking kahihiyan, at ang aking kasiraang puri: ang aking mga kaaway, ay pawang nangasa harap mo."
            },
            {
              "chapter": 69,
              "verse": 20,
              "name": "Mga Awit 69:20",
              "text": "Kaduwahagihan ay sumira ng aking puso; at ako'y lipos ng kabigatan ng loob: at ako'y naghintay na may maawa sa akin, nguni't wala; at mga mangaaliw, nguni't wala akong masumpungan."
            },
            {
              "chapter": 69,
              "verse": 21,
              "name": "Mga Awit 69:21",
              "text": "Binigyan naman nila ako ng pagkaing mapait; at sa aking kauhawan ay binigyan nila ako ng suka na mainom."
            },
            {
              "chapter": 69,
              "verse": 22,
              "name": "Mga Awit 69:22",
              "text": "Maging lalang sa harap nila ang kanilang dulang; at maging isang silo kung sila'y nasa kapayapaan."
            },
            {
              "chapter": 69,
              "verse": 23,
              "name": "Mga Awit 69:23",
              "text": "Manglabo ang kanilang mga mata, na sila'y huwag makakita; at papanginigin mong palagi ang kanilang mga balakang."
            },
            {
              "chapter": 69,
              "verse": 24,
              "name": "Mga Awit 69:24",
              "text": "Ibugso mo ang iyong galit sa kanila, at datnan sila ng kabangisan ng iyong galit."
            },
            {
              "chapter": 69,
              "verse": 25,
              "name": "Mga Awit 69:25",
              "text": "Magiba ang tahanan nila; walang tumahan sa kanilang mga tolda."
            },
            {
              "chapter": 69,
              "verse": 26,
              "name": "Mga Awit 69:26",
              "text": "Sapagka't kanilang hinabol siya na iyong sinaktan, at sinaysay nila ang damdam niyaong iyong sinugatan."
            },
            {
              "chapter": 69,
              "verse": 27,
              "name": "Mga Awit 69:27",
              "text": "At dagdagan mo ng kasamaan ang kanilang kasamaan: at huwag silang masok sa iyong katuwiran."
            },
            {
              "chapter": 69,
              "verse": 28,
              "name": "Mga Awit 69:28",
              "text": "Mapawi sila sa aklat ng buhay, at huwag masulat na kasama ng matuwid."
            },
            {
              "chapter": 69,
              "verse": 29,
              "name": "Mga Awit 69:29",
              "text": "Nguni't ako'y dukha at mapanglaw: sa pamamagitan ng pagliligtas mo, Oh Dios, ay iahon mo nawa ako."
            },
            {
              "chapter": 69,
              "verse": 30,
              "name": "Mga Awit 69:30",
              "text": "Aking pupurihin ng awit ang pangalan ng Dios, at dadakilain ko siya ng pasalamat."
            },
            {
              "chapter": 69,
              "verse": 31,
              "name": "Mga Awit 69:31",
              "text": "At kalulugdan ng Panginoon na higit kay sa isang baka, o sa toro na may mga sungay at mga paa."
            },
            {
              "chapter": 69,
              "verse": 32,
              "name": "Mga Awit 69:32",
              "text": "Nakita ng mga maamo, at nangatuwa: mabuhay ang puso, ninyong nagsisihanap sa Dios."
            },
            {
              "chapter": 69,
              "verse": 33,
              "name": "Mga Awit 69:33",
              "text": "Sapagka't dinidinig ng Panginoon ang mapagkailangan, at hindi hinahamak ang kaniyang mga bilanggo."
            },
            {
              "chapter": 69,
              "verse": 34,
              "name": "Mga Awit 69:34",
              "text": "Purihin siya ng langit at lupa, ng mga dagat, at ng bawa't bagay na gumagalaw roon."
            },
            {
              "chapter": 69,
              "verse": 35,
              "name": "Mga Awit 69:35",
              "text": "Sapagka't ililigtas ng Dios ang Sion, at itatayo ang mga bayan ng Juda; at sila'y magsisitahan doon, at tatangkilikin nila na pinakaari."
            },
            {
              "chapter": 69,
              "verse": 36,
              "name": "Mga Awit 69:36",
              "text": "Mamanahin naman ng binhi ng kaniyang mga lingkod; at silang nagsisiibig ng kaniyang pangalan ay magsisitahan doon."
            }
          ]
        },
        {
          "chapter": 70,
          "name": "Mga Awit 70",
          "verses": [
            {
              "chapter": 70,
              "verse": 1,
              "name": "Mga Awit 70:1",
              "text": "Magmadali ka, Oh Dios, na iligtas mo ako; magmadali ka na tulungan mo ako, Oh Panginoon."
            },
            {
              "chapter": 70,
              "verse": 2,
              "name": "Mga Awit 70:2",
              "text": "Mangapahiya at mangalito sila, na nagsisiusig ng aking kaluluwa: mangapatalikod sila at mangadala sa kasiraang puri. Silang nangaliligaya sa aking kapahamakan."
            },
            {
              "chapter": 70,
              "verse": 3,
              "name": "Mga Awit 70:3",
              "text": "Mangapatalikod sila dahil sa kanilang kahihiyan. Silang nangagsasabi, Aha, aha."
            },
            {
              "chapter": 70,
              "verse": 4,
              "name": "Mga Awit 70:4",
              "text": "Mangagalak at mangatuwa sa iyo ang lahat na nagsisihanap sa iyo; at magsabing lagi yaong umiibig ng iyong kaligtasan: Dakilain ang Dios."
            },
            {
              "chapter": 70,
              "verse": 5,
              "name": "Mga Awit 70:5",
              "text": "Nguni't ako'y dukha at mapagkailangan; magmadali ka sa akin, Oh Dios: ikaw ay aking katulong at aking tagapagligtas; Oh Panginoon, huwag kang magluwat."
            }
          ]
        },
        {
          "chapter": 71,
          "name": "Mga Awit 71",
          "verses": [
            {
              "chapter": 71,
              "verse": 1,
              "name": "Mga Awit 71:1",
              "text": "Sa iyo Oh Panginoon, nanganganlong ako: huwag akong mapahiya kailan man."
            },
            {
              "chapter": 71,
              "verse": 2,
              "name": "Mga Awit 71:2",
              "text": "Iligtas mo ako sa iyong katuwiran, at sagipin mo ako: ikiling mo ang iyong pakinig sa akin, at iligtas mo ako,"
            },
            {
              "chapter": 71,
              "verse": 3,
              "name": "Mga Awit 71:3",
              "text": "Ikaw ay maging kanlungan ng aking tahanan, na aking kapaparunang lagi: ikaw ay nagbigay utos na iligtas ako; sapagka't ikaw ay aking malaking bato at aking kuta."
            },
            {
              "chapter": 71,
              "verse": 4,
              "name": "Mga Awit 71:4",
              "text": "Sagipin mo ako, Oh aking Dios, sa kamay ng masama, sa kamay ng liko at mabagsik na tao."
            },
            {
              "chapter": 71,
              "verse": 5,
              "name": "Mga Awit 71:5",
              "text": "Sapagka't ikaw ay aking pagasa, Oh Panginoong Dios: ikaw ay aking tiwala mula sa aking kabataan."
            },
            {
              "chapter": 71,
              "verse": 6,
              "name": "Mga Awit 71:6",
              "text": "Sa pamamagitan mo ay naalalayan ako mula sa bahay-bata: ikaw ang kumuha sa akin sa tiyan ng aking ina: ang pagpuri ko'y magiging laging sa iyo."
            },
            {
              "chapter": 71,
              "verse": 7,
              "name": "Mga Awit 71:7",
              "text": "Ako'y naging isang kagilagilalas sa marami; nguni't ikaw ang matibay kong kanlungan."
            },
            {
              "chapter": 71,
              "verse": 8,
              "name": "Mga Awit 71:8",
              "text": "Ang bibig ko'y mapupuno ng pagpuri sa iyo, at ng iyong karangalan buong araw."
            },
            {
              "chapter": 71,
              "verse": 9,
              "name": "Mga Awit 71:9",
              "text": "Huwag mo akong itakuwil sa katandaan; huwag mo akong pabayaan pagka ang aking kalakasan ay nanglulupaypay."
            },
            {
              "chapter": 71,
              "verse": 10,
              "name": "Mga Awit 71:10",
              "text": "Sapagka't ang mga kaaway ko'y nangagsasalita tungkol sa akin: at silang nagsisibakay ng aking kaluluwa ay nangagsasanggunian,"
            },
            {
              "chapter": 71,
              "verse": 11,
              "name": "Mga Awit 71:11",
              "text": "Na nangagsasabi, pinabayaan siya ng Dios: iyong habulin at hulihin siya; sapagka't walang magligtas."
            },
            {
              "chapter": 71,
              "verse": 12,
              "name": "Mga Awit 71:12",
              "text": "Oh Dios, huwag kang lumayo sa akin: Oh Dios ko, magmadali kang tulungan mo ako."
            },
            {
              "chapter": 71,
              "verse": 13,
              "name": "Mga Awit 71:13",
              "text": "Mangapahiya at mangalipol sila na mga kaaway ng aking kaluluwa; mangatakpan ng pagkaduwahagi at kasiraang puri sila, na nagsisihanap ng aking kapahamakan."
            },
            {
              "chapter": 71,
              "verse": 14,
              "name": "Mga Awit 71:14",
              "text": "Nguni't ako'y maghihintay na palagi, at pupuri pa ako sa iyo ng higit at higit."
            },
            {
              "chapter": 71,
              "verse": 15,
              "name": "Mga Awit 71:15",
              "text": "Ang bibig ko'y magsasaysay ng iyong katuwiran, at ng iyong pagliligtas buong araw; sapagka't hindi ko nalalaman ang mga bilang."
            },
            {
              "chapter": 71,
              "verse": 16,
              "name": "Mga Awit 71:16",
              "text": "Ako'y yayao na may mga makapangyarihang gawa ng Panginoong Dios: aking babanggitin ang iyong katuwiran, sa makatuwid baga'y ang iyo lamang."
            },
            {
              "chapter": 71,
              "verse": 17,
              "name": "Mga Awit 71:17",
              "text": "Oh Dios, iyong tinuruan ako mula sa aking kabataan; at hanggang ngayon ay aking inihahayag ang iyong kagilagilalas na mga gawa."
            },
            {
              "chapter": 71,
              "verse": 18,
              "name": "Mga Awit 71:18",
              "text": "Oo, pag ako'y tumanda at may uban, Oh Dios, huwag mo akong pabayaan; hanggang sa aking maipahayag ang iyong kalakasan sa sumusunod na lahi, ang iyong kapangyarihan sa bawa't isa na darating."
            },
            {
              "chapter": 71,
              "verse": 19,
              "name": "Mga Awit 71:19",
              "text": "Ang iyo ring katuwiran, Oh Dios, ay totoong mataas; ikaw na gumawa ng dakilang mga bagay, Oh Dios, sino ang gaya mo."
            },
            {
              "chapter": 71,
              "verse": 20,
              "name": "Mga Awit 71:20",
              "text": "Ikaw na nagpakita sa amin ng marami at lubhang kabagabagan, bubuhayin mo uli kami, at ibabangon mo uli kami mula sa mga kalaliman ng lupa."
            },
            {
              "chapter": 71,
              "verse": 21,
              "name": "Mga Awit 71:21",
              "text": "Palaguin mo ang aking kadakilaan, at bumalik ka uli, at aliwin mo ako."
            },
            {
              "chapter": 71,
              "verse": 22,
              "name": "Mga Awit 71:22",
              "text": "Pupurihin din kita ng salterio, ang iyong katotohanan, Oh Dios ko; sa iyo'y aawit ako ng mga kapurihan sa pamamagitan ng alpa, Oh ikaw na Banal ng Israel."
            },
            {
              "chapter": 71,
              "verse": 23,
              "name": "Mga Awit 71:23",
              "text": "Ang mga labi ko'y mangagagalak na mainam pagka ako'y umaawit ng mga pagpuri sa iyo; at ang kaluluwa ko, na iyong tinubos."
            },
            {
              "chapter": 71,
              "verse": 24,
              "name": "Mga Awit 71:24",
              "text": "Ang dila ko naman ay magsasalita ng iyong katuwiran buong araw: sapagka't sila'y nangapahiya, sila'y nangalito, na nagsisihanap ng aking kapahamakan."
            }
          ]
        },
        {
          "chapter": 72,
          "name": "Mga Awit 72",
          "verses": [
            {
              "chapter": 72,
              "verse": 1,
              "name": "Mga Awit 72:1",
              "text": "Ibigay mo sa hari ang iyong mga kahatulan, Oh Dios, at ang iyong katuwiran sa anak na lalake ng hari."
            },
            {
              "chapter": 72,
              "verse": 2,
              "name": "Mga Awit 72:2",
              "text": "Kaniyang hahatulan ang iyong bayan, ng katuwiran, at ang iyong dukha, ng kahatulan."
            },
            {
              "chapter": 72,
              "verse": 3,
              "name": "Mga Awit 72:3",
              "text": "Ang mga bundok ay magtataglay ng kapayapaan sa bayan, at ang mga gulod, sa katuwiran."
            },
            {
              "chapter": 72,
              "verse": 4,
              "name": "Mga Awit 72:4",
              "text": "Kaniyang hahatulan ang dukha sa bayan, kaniyang ililigtas ang mga anak ng mapagkailangan, at pagwawaraywarayin ang mangaapi."
            },
            {
              "chapter": 72,
              "verse": 5,
              "name": "Mga Awit 72:5",
              "text": "Sila'y mangatatakot sa iyo habang nananatili ang araw, at habang sumisilang ang buwan, sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 72,
              "verse": 6,
              "name": "Mga Awit 72:6",
              "text": "Siya'y babagsak na parang ulan sa tuyong damo: gaya ng ambon na dumidilig sa lupa."
            },
            {
              "chapter": 72,
              "verse": 7,
              "name": "Mga Awit 72:7",
              "text": "Sa kaniyang mga kaarawan ay giginhawa ang mga matuwid; at saganang kapayapaan, hanggang sa mawala ang buwan."
            },
            {
              "chapter": 72,
              "verse": 8,
              "name": "Mga Awit 72:8",
              "text": "Siya naman ay magtataglay ng pagpapakapanginoon sa dagat at dagat, at mula sa ilog hanggang sa mga wakas ng lupa."
            },
            {
              "chapter": 72,
              "verse": 9,
              "name": "Mga Awit 72:9",
              "text": "Silang nagsisitahan sa ilang ay magsisiyukod sa kaniya; at hihimuran ng kaniyang mga kaaway ang alabok."
            },
            {
              "chapter": 72,
              "verse": 10,
              "name": "Mga Awit 72:10",
              "text": "Ang mga hari ng Tharsis, at sa mga pulo ay mangagdadala ng mga kaloob; ang mga hari sa Sheba at Seba ay mangaghahandog ng mga kaloob."
            },
            {
              "chapter": 72,
              "verse": 11,
              "name": "Mga Awit 72:11",
              "text": "Oo, lahat ng mga hari ay magsisiyukod sa harap niya: lahat ng mga bansa ay mangaglilingkod sa kaniya."
            },
            {
              "chapter": 72,
              "verse": 12,
              "name": "Mga Awit 72:12",
              "text": "Sapagka't kaniyang ililigtas ang mapagkailangan pagka dumadaing; at ang dukha na walang katulong."
            },
            {
              "chapter": 72,
              "verse": 13,
              "name": "Mga Awit 72:13",
              "text": "Siya'y maaawa sa dukha at mapagkailangan, at ang mga kaluluwa ng mga mapagkailangan ay kaniyang ililigtas."
            },
            {
              "chapter": 72,
              "verse": 14,
              "name": "Mga Awit 72:14",
              "text": "Tutubusin niya ang kanilang kaluluwa sa kapighatian at karahasan; at magiging mahalaga ang kanilang dugo sa kaniyang paningin:"
            },
            {
              "chapter": 72,
              "verse": 15,
              "name": "Mga Awit 72:15",
              "text": "At siya'y mabubuhay at sa kaniya'y ibibigay ang ginto ng Sheba: at dadalanginang lagi siya ng mga tao: pupurihin nila siya buong araw."
            },
            {
              "chapter": 72,
              "verse": 16,
              "name": "Mga Awit 72:16",
              "text": "Magkakaroon ng saganang trigo sa lupa sa taluktok ng mga bundok; ang bunga niyao'y uugang gaya ng Libano: at silang sa bayan ay giginhawa na parang damo sa lupa."
            },
            {
              "chapter": 72,
              "verse": 17,
              "name": "Mga Awit 72:17",
              "text": "Ang kaniyang pangalan ay mananatili kailan man; ang kaniyang pangalan ay magluluwat na gaya ng araw: at ang mga tao ay pagpapalain sa kaniya; tatawagin siyang maginhawa ng lahat ng mga bansa."
            },
            {
              "chapter": 72,
              "verse": 18,
              "name": "Mga Awit 72:18",
              "text": "Purihin ang Panginoong Dios, ang Dios ng Israel, na siya lamang gumagawa ng mga kababalaghang bagay:"
            },
            {
              "chapter": 72,
              "verse": 19,
              "name": "Mga Awit 72:19",
              "text": "At purihin ang kaniyang maluwalhating pangalan magpakailan man; at mapuno ang buong lupa ng kaniyang kaluwalhatian. Siya nawa, at Siya nawa."
            },
            {
              "chapter": 72,
              "verse": 20,
              "name": "Mga Awit 72:20",
              "text": "Ang mga dalangin ni David na anak ni Isai ay nangatapos."
            }
          ]
        },
        {
          "chapter": 73,
          "name": "Mga Awit 73",
          "verses": [
            {
              "chapter": 73,
              "verse": 1,
              "name": "Mga Awit 73:1",
              "text": "Tunay na ang Dios ay mabuti sa Israel. Sa mga malilinis sa puso."
            },
            {
              "chapter": 73,
              "verse": 2,
              "name": "Mga Awit 73:2",
              "text": "Nguni't tungkol sa akin, ang mga paa ko'y halos nahiwalay: ang mga hakbang ko'y kamunti nang nangadulas."
            },
            {
              "chapter": 73,
              "verse": 3,
              "name": "Mga Awit 73:3",
              "text": "Sapagka't ako'y nanaghili sa hambog, nang aking makita ang kaginhawahan ng masama."
            },
            {
              "chapter": 73,
              "verse": 4,
              "name": "Mga Awit 73:4",
              "text": "Sapagka't walang mga tali sa kanilang kamatayan: kundi ang kanilang kalakasan ay matatag."
            },
            {
              "chapter": 73,
              "verse": 5,
              "name": "Mga Awit 73:5",
              "text": "Sila'y wala sa kabagabagan na gaya ng ibang mga tao; na hindi man sila nangasasalot na gaya ng ibang mga tao."
            },
            {
              "chapter": 73,
              "verse": 6,
              "name": "Mga Awit 73:6",
              "text": "Kaya't kapalalua'y gaya ng kuwintas sa kanilang leeg: tinatakpan sila ng karahasan na gaya ng bihisan."
            },
            {
              "chapter": 73,
              "verse": 7,
              "name": "Mga Awit 73:7",
              "text": "Ang kanilang mga mata ay lumuluwa sa katabaan: sila'y mayroong higit kay sa mananasa ng puso."
            },
            {
              "chapter": 73,
              "verse": 8,
              "name": "Mga Awit 73:8",
              "text": "Sila'y manganunuya, at sa kasamaan ay nanunungayaw ng pagpighati: sila'y nangagsasalitang may kataasan."
            },
            {
              "chapter": 73,
              "verse": 9,
              "name": "Mga Awit 73:9",
              "text": "Kanilang inilagay ang kanilang bibig sa mga langit, at ang kanilang dila ay lumalakad sa lupa."
            },
            {
              "chapter": 73,
              "verse": 10,
              "name": "Mga Awit 73:10",
              "text": "Kaya't ibinabalik dito ang kaniyang bayan: at tubig ng punong saro ay nilalagok nila."
            },
            {
              "chapter": 73,
              "verse": 11,
              "name": "Mga Awit 73:11",
              "text": "At kanilang sinasabi, Paanong nalalaman ng Dios? At may kaalaman ba sa Kataastaasan?"
            },
            {
              "chapter": 73,
              "verse": 12,
              "name": "Mga Awit 73:12",
              "text": "Narito, ang mga ito ang masama; at palibhasa'y laging tiwasay nagsisilago sa mga kayamanan,"
            },
            {
              "chapter": 73,
              "verse": 13,
              "name": "Mga Awit 73:13",
              "text": "Tunay na sa walang kabuluhan ay nilinis ko ang aking puso, at hinugasan ko ang aking mga kamay sa kawalaang sala;"
            },
            {
              "chapter": 73,
              "verse": 14,
              "name": "Mga Awit 73:14",
              "text": "Sapagka't buong araw ay nasalot ako, at naparusahan tuwing umaga."
            },
            {
              "chapter": 73,
              "verse": 15,
              "name": "Mga Awit 73:15",
              "text": "Kung aking sinabi, Ako'y magsasalita ng ganito; narito, ako'y gagawang may karayaan sa lahi ng iyong mga anak."
            },
            {
              "chapter": 73,
              "verse": 16,
              "name": "Mga Awit 73:16",
              "text": "Nang aking isipin kung paanong aking malalaman ito, ay napakahirap sa ganang akin;"
            },
            {
              "chapter": 73,
              "verse": 17,
              "name": "Mga Awit 73:17",
              "text": "Hanggang sa ako'y pumasok sa santuario ng Dios, at aking nagunita ang kanilang huling wakas,"
            },
            {
              "chapter": 73,
              "verse": 18,
              "name": "Mga Awit 73:18",
              "text": "Tunay na iyong inilagay sila sa mga madulas na dako: iyong inilugmok sila sa kapahamakan."
            },
            {
              "chapter": 73,
              "verse": 19,
              "name": "Mga Awit 73:19",
              "text": "Kung paanong naging kapahamakan sila sa isang sandali! Sila'y nilipol na lubos ng mga kakilabutan."
            },
            {
              "chapter": 73,
              "verse": 20,
              "name": "Mga Awit 73:20",
              "text": "Ang panaginip sa pagkagising: sa gayon, Oh Panginoon, pag gumising ka, iyong hahamakin ang kanilang larawan."
            },
            {
              "chapter": 73,
              "verse": 21,
              "name": "Mga Awit 73:21",
              "text": "Sapagka't ang puso ko'y namanglaw, at sa aking kalooban ay nasaktan ako:"
            },
            {
              "chapter": 73,
              "verse": 22,
              "name": "Mga Awit 73:22",
              "text": "Sa gayo'y naging walang muwang ako, at musmos; ako'y naging gaya ng hayop sa harap mo."
            },
            {
              "chapter": 73,
              "verse": 23,
              "name": "Mga Awit 73:23",
              "text": "Gayon ma'y laging sumasaiyo ako: iyong inalalayan ang aking kanan."
            },
            {
              "chapter": 73,
              "verse": 24,
              "name": "Mga Awit 73:24",
              "text": "Iyong papatnubayan ako ng iyong payo, at pagkatapos ay tatanggapin mo ako sa kaluwalhatian."
            },
            {
              "chapter": 73,
              "verse": 25,
              "name": "Mga Awit 73:25",
              "text": "Sinong kumakasi sa akin sa langit kundi ikaw? At walang ninanasa ako sa lupa liban sa iyo."
            },
            {
              "chapter": 73,
              "verse": 26,
              "name": "Mga Awit 73:26",
              "text": "Ang aking laman at ang aking puso ay nanglulupaypay: nguni't ang Dios ay kalakasan ng aking puso, at bahagi ko magpakailan man."
            },
            {
              "chapter": 73,
              "verse": 27,
              "name": "Mga Awit 73:27",
              "text": "Sapagka't narito, silang malayo sa iyo ay mangalilipol: iyong ibinuwal silang lahat, na nangakikiapid, na nagsisihiwalay sa iyo."
            },
            {
              "chapter": 73,
              "verse": 28,
              "name": "Mga Awit 73:28",
              "text": "Nguni't mabuti sa akin na lumapit sa Dios; ginawa kong aking kanlungan ang Panginoong Dios, upang aking maisaysay ang lahat ng iyong mga gawa."
            }
          ]
        },
        {
          "chapter": 74,
          "name": "Mga Awit 74",
          "verses": [
            {
              "chapter": 74,
              "verse": 1,
              "name": "Mga Awit 74:1",
              "text": "Oh Dios, bakit mo itinakuwil kami magpakailan man? Bakit ang iyong galit ay umuusok laban sa mga tupa ng iyong pastulan?"
            },
            {
              "chapter": 74,
              "verse": 2,
              "name": "Mga Awit 74:2",
              "text": "Alalahanin mo ang iyong kapisanan na iyong binili ng una, na iyong tinubos upang maging lipi ng iyong mana; at ang bundok ng Sion na iyong tinahanan."
            },
            {
              "chapter": 74,
              "verse": 3,
              "name": "Mga Awit 74:3",
              "text": "Itaas mo ang iyong mga paa sa mga walang hanggang guho, ang lahat na kasamaang ginawa ng kaaway sa santuario."
            },
            {
              "chapter": 74,
              "verse": 4,
              "name": "Mga Awit 74:4",
              "text": "Ang mga kaaway mo'y nagsisiangal sa gitna ng iyong kapulungan; kanilang itinaas ang kanilang mga watawat na pinakatanda."
            },
            {
              "chapter": 74,
              "verse": 5,
              "name": "Mga Awit 74:5",
              "text": "Sila'y tila mga tao na nangagtaas ng mga palakol sa mga kakahuyan."
            },
            {
              "chapter": 74,
              "verse": 6,
              "name": "Mga Awit 74:6",
              "text": "At ngayo'y lahat ng gawang inanyuan doon. Kanilang pinagputolputol ng palakol at ng mga pamukpok."
            },
            {
              "chapter": 74,
              "verse": 7,
              "name": "Mga Awit 74:7",
              "text": "Kanilang sinilaban ng apoy ang iyong santuario; kanilang dinumhan ang tahanang dako ng iyong pangalan hanggang sa lupa."
            },
            {
              "chapter": 74,
              "verse": 8,
              "name": "Mga Awit 74:8",
              "text": "Kanilang sinabi sa kanilang puso, ating gibaing paminsan: kanilang sinunog ang lahat na sinagoga ng Dios sa lupain."
            },
            {
              "chapter": 74,
              "verse": 9,
              "name": "Mga Awit 74:9",
              "text": "Hindi namin nakikita ang aming mga tanda: Wala nang propeta pa; at wala mang sinoman sa amin na nakakaalam kung hanggang kailan."
            },
            {
              "chapter": 74,
              "verse": 10,
              "name": "Mga Awit 74:10",
              "text": "Hanggang kailan, Oh Dios, mangduduwahagi ang kaaway? Lalapastanganin ba ng kaaway ang iyong pangalan magpakailan man?"
            },
            {
              "chapter": 74,
              "verse": 11,
              "name": "Mga Awit 74:11",
              "text": "Bakit mo iniuurong ang iyong kamay, ang iyong kanan? Ilabas mo sa iyong sinapupunan, at iyong lipulin sila."
            },
            {
              "chapter": 74,
              "verse": 12,
              "name": "Mga Awit 74:12",
              "text": "Gayon ma'y ang Dios ay aking Hari ng una, na nagliligtas sa gitna ng lupa."
            },
            {
              "chapter": 74,
              "verse": 13,
              "name": "Mga Awit 74:13",
              "text": "Iyong hinawi ang dagat sa iyong kalakasan: iyong pinagbasag ang mga ulo ng mga buwaya sa mga tubig."
            },
            {
              "chapter": 74,
              "verse": 14,
              "name": "Mga Awit 74:14",
              "text": "Iyong pinagputolputol ang mga ulo ng leviatan, ibinigay mo siya na pagkain sa bayan na tumatahan sa ilang."
            },
            {
              "chapter": 74,
              "verse": 15,
              "name": "Mga Awit 74:15",
              "text": "Ikaw ay nagbukas ng bukal at ilog: iyong tinutuyo ang mga malaking ilog."
            },
            {
              "chapter": 74,
              "verse": 16,
              "name": "Mga Awit 74:16",
              "text": "Ang araw ay iyo, ang gabi ay iyo rin: iyong inihanda ang liwanag at ang araw."
            },
            {
              "chapter": 74,
              "verse": 17,
              "name": "Mga Awit 74:17",
              "text": "Iyong inilagay ang lahat ng mga hangganan ng lupa: iyong ginawa ang taginit at taginaw."
            },
            {
              "chapter": 74,
              "verse": 18,
              "name": "Mga Awit 74:18",
              "text": "Iyong alalahanin ito, na nangduwahagi ang kaaway, Oh Panginoon, at nilapastangan ng mangmang na bayan ang iyong pangalan."
            },
            {
              "chapter": 74,
              "verse": 19,
              "name": "Mga Awit 74:19",
              "text": "Oh huwag mong ibigay ang kaluluwa ng inakay ng iyong kalapati sa mabangis na hayop: huwag mong kalimutan ang buhay ng iyong dukha magpakailan man."
            },
            {
              "chapter": 74,
              "verse": 20,
              "name": "Mga Awit 74:20",
              "text": "Magkaroong pitagan ka sa tipan: sapagka't ang mga madilim na dako ng lupa ay puno ng mga tahanan ng karahasan."
            },
            {
              "chapter": 74,
              "verse": 21,
              "name": "Mga Awit 74:21",
              "text": "Oh huwag bumalik na may kahihiyan ang naaapi: pupurihin ng dukha at mapagkailangan ang iyong pangalan."
            },
            {
              "chapter": 74,
              "verse": 22,
              "name": "Mga Awit 74:22",
              "text": "Bumangon ka, Oh Dios, ipaglaban mo ang iyong sariling usap: alalahanin mo kung paanong dinuduwahagi ka ng mangmang buong araw."
            },
            {
              "chapter": 74,
              "verse": 23,
              "name": "Mga Awit 74:23",
              "text": "Huwag mong kalimutan ang tinig ng iyong mga kaaway: ang ingay niyaong nagsisibangon laban sa iyo ay patuloy na lumalala."
            }
          ]
        },
        {
          "chapter": 75,
          "name": "Mga Awit 75",
          "verses": [
            {
              "chapter": 75,
              "verse": 1,
              "name": "Mga Awit 75:1",
              "text": "Kami ay nagpapasalamat sa iyo, Oh Dios: kami ay nagpapasalamat, sapagka't ang iyong pangalan ay malapit: isinasaysay ng mga tao ang iyong mga kagilagilalas na gawa."
            },
            {
              "chapter": 75,
              "verse": 2,
              "name": "Mga Awit 75:2",
              "text": "Pagka aking nakamtan ang takdang kapanahunan, hahatol ako ng matuwid."
            },
            {
              "chapter": 75,
              "verse": 3,
              "name": "Mga Awit 75:3",
              "text": "Ang lupa at lahat na tagarito ay natutunaw: aking itinayo ang mga haligi niyaon. (Selah)"
            },
            {
              "chapter": 75,
              "verse": 4,
              "name": "Mga Awit 75:4",
              "text": "Aking sinabi sa hambog, Huwag kang gumawang may kahambugan: at sa masama, Huwag kang magtaas ng sungay:"
            },
            {
              "chapter": 75,
              "verse": 5,
              "name": "Mga Awit 75:5",
              "text": "Huwag mong itaas ang iyong sungay ng mataas; huwag kang magsalitang may matigas na ulo."
            },
            {
              "chapter": 75,
              "verse": 6,
              "name": "Mga Awit 75:6",
              "text": "Sapagka't hindi man mula sa silanganan, o mula man sa kalunuran, o mula man sa timugan, ang pagkataas."
            },
            {
              "chapter": 75,
              "verse": 7,
              "name": "Mga Awit 75:7",
              "text": "Kundi ang Dios ay siyang hukom: kaniyang ibinababa ang isa, at itinataas ang isa."
            },
            {
              "chapter": 75,
              "verse": 8,
              "name": "Mga Awit 75:8",
              "text": "Sapagka't sa kamay ng Panginoon ay may isang saro, at ang alak ay bumubula; puno ng pagkakahalohalo, at kaniyang inililiguwak din: tunay na ibubuhos ng lahat na masama sa lupa ang latak, at iinumin."
            },
            {
              "chapter": 75,
              "verse": 9,
              "name": "Mga Awit 75:9",
              "text": "Nguni't aking ipahahayag magpakailan man, ako'y aawit ng mga kapurihan sa Dios ni Jacob."
            },
            {
              "chapter": 75,
              "verse": 10,
              "name": "Mga Awit 75:10",
              "text": "Lahat ng mga sungay naman ng masama ay aking ihihiwalay; nguni't ang mga sungay ng matuwid ay matataas."
            }
          ]
        },
        {
          "chapter": 76,
          "name": "Mga Awit 76",
          "verses": [
            {
              "chapter": 76,
              "verse": 1,
              "name": "Mga Awit 76:1",
              "text": "Sa Juda ay kilala ang Dios: ang kaniyang pangalan ay dakila sa Israel."
            },
            {
              "chapter": 76,
              "verse": 2,
              "name": "Mga Awit 76:2",
              "text": "Nasa Salem naman ang kaniyang tabernakulo, at ang kaniyang dakong tahanan ay sa Sion."
            },
            {
              "chapter": 76,
              "verse": 3,
              "name": "Mga Awit 76:3",
              "text": "Doo'y binali niya ang mga pana ng busog; at kalasag, at ang tabak, at ang pagbabaka. (Selah)"
            },
            {
              "chapter": 76,
              "verse": 4,
              "name": "Mga Awit 76:4",
              "text": "Maluwalhati ka at marilag, mula sa mga bundok na hulihan."
            },
            {
              "chapter": 76,
              "verse": 5,
              "name": "Mga Awit 76:5",
              "text": "Ang mga puso na matapang ay nasamsaman, sila'y nangatulog ng kanilang pagtulog; at wala sa mga lalaking makapangyarihan na nakasumpong ng kanilang mga kamay."
            },
            {
              "chapter": 76,
              "verse": 6,
              "name": "Mga Awit 76:6",
              "text": "Sa iyong saway Oh Dios ni Jacob, ang karo at gayon din ang kabayo ay nahandusay sa mahimbing na pagkakatulog."
            },
            {
              "chapter": 76,
              "verse": 7,
              "name": "Mga Awit 76:7",
              "text": "Ikaw, ikaw ay katatakutan: at sinong makatatayo sa iyong paningin, sa minsang ikaw ay magalit?"
            },
            {
              "chapter": 76,
              "verse": 8,
              "name": "Mga Awit 76:8",
              "text": "Iyong ipinarinig ang hatol mula sa langit; ang lupa ay natakot, at tumahimik,"
            },
            {
              "chapter": 76,
              "verse": 9,
              "name": "Mga Awit 76:9",
              "text": "Nang ang Dios ay bumangon sa paghatol, upang iligtas ang lahat ng maamo sa lupa. (Selah)"
            },
            {
              "chapter": 76,
              "verse": 10,
              "name": "Mga Awit 76:10",
              "text": "Tunay na pupurihin ka ng poot ng tao: ang nalabi sa poot ay ibibigkis mo sa iyo."
            },
            {
              "chapter": 76,
              "verse": 11,
              "name": "Mga Awit 76:11",
              "text": "Manata ka at tuparin mo sa Panginoon mong Dios: magdala ng mga kaloob sa kaniya na marapat katakutan, yaong lahat na nangasa buong palibot niya."
            },
            {
              "chapter": 76,
              "verse": 12,
              "name": "Mga Awit 76:12",
              "text": "Kaniyang ihihiwalay ang diwa ng mga pangulo: siya'y kakilakilabot sa mga hari sa lupa."
            }
          ]
        },
        {
          "chapter": 77,
          "name": "Mga Awit 77",
          "verses": [
            {
              "chapter": 77,
              "verse": 1,
              "name": "Mga Awit 77:1",
              "text": "Ako'y dadaing ng aking tinig sa Dios; sa Dios ng aking tinig; at kaniyang didinggin ako."
            },
            {
              "chapter": 77,
              "verse": 2,
              "name": "Mga Awit 77:2",
              "text": "Sa kaarawan ng aking kabagabagan ay hinahanap ko ang Panginoon: ang kamay ko'y nakaunat sa gabi, at hindi nangangalay; tumatangging maaliw ang kaluluwa ko."
            },
            {
              "chapter": 77,
              "verse": 3,
              "name": "Mga Awit 77:3",
              "text": "Naaalaala ko ang Dios, at ako'y nababalisa: ako'y nagdaramdam, at ang diwa ko'y nanglulupaypay. (Selah)"
            },
            {
              "chapter": 77,
              "verse": 4,
              "name": "Mga Awit 77:4",
              "text": "Iyong pinupuyat ang mga mata ko: ako'y totoong nababagabag na hindi ako makapagsalita."
            },
            {
              "chapter": 77,
              "verse": 5,
              "name": "Mga Awit 77:5",
              "text": "Aking ginunita ang mga araw ng una, ang mga taon ng dating mga panahon."
            },
            {
              "chapter": 77,
              "verse": 6,
              "name": "Mga Awit 77:6",
              "text": "Aking inaalaala ang awit ko sa gabi: sumasangguni ako sa aking sariling puso; at ang diwa ko'y masikap na nagsiyasat."
            },
            {
              "chapter": 77,
              "verse": 7,
              "name": "Mga Awit 77:7",
              "text": "Magtatakuwil ba ang Panginoon magpakailan man? At hindi na baga siya lilingap pa?"
            },
            {
              "chapter": 77,
              "verse": 8,
              "name": "Mga Awit 77:8",
              "text": "Ang kaniya bang kagandahang-loob ay lubos na nawala magpakailan man? Natapos na bang walang hanggan ang kaniyang pangako?"
            },
            {
              "chapter": 77,
              "verse": 9,
              "name": "Mga Awit 77:9",
              "text": "Nakalimot na ba ang Dios na magmaawain? Kaniya bang tinakpan ng kagalitan ang kaniyang malumanay na mga kaawaan? (Selah)"
            },
            {
              "chapter": 77,
              "verse": 10,
              "name": "Mga Awit 77:10",
              "text": "At aking sinabi, Ito ang sakit ko; nguni't aalalahanin ko ang mga taon ng kanan ng Kataastaasan."
            },
            {
              "chapter": 77,
              "verse": 11,
              "name": "Mga Awit 77:11",
              "text": "Babanggitin ko ang mga gawa ng Panginoon; sapagka't aalalahanin ko ang mga kabagabagan mo ng una."
            },
            {
              "chapter": 77,
              "verse": 12,
              "name": "Mga Awit 77:12",
              "text": "Bubulayin ko ang lahat ng iyong gawa, at magmumuni tungkol sa iyong mga gawa."
            },
            {
              "chapter": 77,
              "verse": 13,
              "name": "Mga Awit 77:13",
              "text": "Ang iyong daan, Oh Dios, ay nasa santuario: sino ang dakilang dios na gaya ng Dios?"
            },
            {
              "chapter": 77,
              "verse": 14,
              "name": "Mga Awit 77:14",
              "text": "Ikaw ay Dios na gumagawa ng mga kagilagilalas: iyong ipinakilala ang kalakasan mo sa gitna ng mga tao."
            },
            {
              "chapter": 77,
              "verse": 15,
              "name": "Mga Awit 77:15",
              "text": "Iyong tinubos ng kamay mo ang iyong bayan, ang mga anak ng Jacob at ng Jose. (Selah)"
            },
            {
              "chapter": 77,
              "verse": 16,
              "name": "Mga Awit 77:16",
              "text": "Nakita ka ng tubig, Oh Dios; nakita ka ng tubig, sila'y nangatakot: ang mga kalaliman din naman ay nanginig."
            },
            {
              "chapter": 77,
              "verse": 17,
              "name": "Mga Awit 77:17",
              "text": "Ang mga alapaap ay nangaglagpak ng tubig; ang langit ay humugong: ang mga pana mo naman ay nagsihilagpos."
            },
            {
              "chapter": 77,
              "verse": 18,
              "name": "Mga Awit 77:18",
              "text": "Ang tinig ng iyong kulog, ay nasa ipoipo; tinanglawan ng mga kidlat ang sanglibutan: ang lupa ay nayanig at umuga."
            },
            {
              "chapter": 77,
              "verse": 19,
              "name": "Mga Awit 77:19",
              "text": "Ang daan mo'y nasa dagat, at ang mga landas mo'y nasa malalawak na tubig, at ang bakas mo'y hindi nakilala."
            },
            {
              "chapter": 77,
              "verse": 20,
              "name": "Mga Awit 77:20",
              "text": "Iyong pinapatnubayan ang iyong bayan na parang kawan, sa pamamagitan ng kamay ni Moises at ni Aaron."
            }
          ]
        },
        {
          "chapter": 78,
          "name": "Mga Awit 78",
          "verses": [
            {
              "chapter": 78,
              "verse": 1,
              "name": "Mga Awit 78:1",
              "text": "Makinig kayo, Oh bayan ko, sa aking kautusan: ikiling ninyo ang inyong mga pakinig sa mga salita ng aking bibig."
            },
            {
              "chapter": 78,
              "verse": 2,
              "name": "Mga Awit 78:2",
              "text": "Aking bubukhin ang aking bibig sa isang talinghaga; ako'y magsasalita ng mga malabong sabi ng una:"
            },
            {
              "chapter": 78,
              "verse": 3,
              "name": "Mga Awit 78:3",
              "text": "Na aming narinig at naalaman, at isinaysay sa amin ng aming mga magulang."
            },
            {
              "chapter": 78,
              "verse": 4,
              "name": "Mga Awit 78:4",
              "text": "Hindi namin ikukubli sa kanilang mga anak, na isasaysay sa salin ng lahing darating ang mga pagpuri sa Panginoon, at ang kaniyang kalakasan, at ang kaniyang mga kagilagilalas na mga gawa na kaniyang ginawa."
            },
            {
              "chapter": 78,
              "verse": 5,
              "name": "Mga Awit 78:5",
              "text": "Sapagka't siya'y nagtatag ng patotoo sa Jacob, at nagtakda ng kautusan sa Israel, na kaniyang iniutos sa aming mga magulang, na kanilang ipabatid sa kanilang mga anak:"
            },
            {
              "chapter": 78,
              "verse": 6,
              "name": "Mga Awit 78:6",
              "text": "Upang maalaman ng lahing darating, sa makatuwid baga'y ng mga anak na ipanganganak; na siyang magsisibangon, at mangagsasaysay sa kanilang mga anak:"
            },
            {
              "chapter": 78,
              "verse": 7,
              "name": "Mga Awit 78:7",
              "text": "Upang kanilang mailagak ang kanilang pagasa sa Dios, at huwag kalimutan ang mga gawa ng Dios, Kundi ingatan ang kaniyang mga utos:"
            },
            {
              "chapter": 78,
              "verse": 8,
              "name": "Mga Awit 78:8",
              "text": "At huwag maging gaya ng kanilang mga magulang, may matigas na ulo at mapanghimagsik na lahi; isang lahing di naglagay sa matuwid ng kanilang puso, at ang kanilang diwa ay hindi tapat sa Dios,"
            },
            {
              "chapter": 78,
              "verse": 9,
              "name": "Mga Awit 78:9",
              "text": "Ang mga anak ni Ephraim, gayong may sakbat at may dalang mga busog, at nagsitalikod sa kaarawan ng pagbabaka."
            },
            {
              "chapter": 78,
              "verse": 10,
              "name": "Mga Awit 78:10",
              "text": "Hindi nila tinupad ang tipan ng Dios, at nagsitangging magsilakad sa kaniyang kautusan;"
            },
            {
              "chapter": 78,
              "verse": 11,
              "name": "Mga Awit 78:11",
              "text": "At kanilang kinalimutan ang kaniyang mga gawa, at ang kaniyang mga kagilagilalas na mga gawa na kaniyang ipinakita sa kanila."
            },
            {
              "chapter": 78,
              "verse": 12,
              "name": "Mga Awit 78:12",
              "text": "Mga kagilagilalas na mga bagay ay ginawa niya sa paningin ng kanilang mga magulang, sa lupain ng Egipto, sa parang ng Zoan."
            },
            {
              "chapter": 78,
              "verse": 13,
              "name": "Mga Awit 78:13",
              "text": "Hinawi niya ang dagat, at pinaraan niya sila; at kaniyang pinatayo ang tubig na parang bunton."
            },
            {
              "chapter": 78,
              "verse": 14,
              "name": "Mga Awit 78:14",
              "text": "Sa araw naman ay kaniyang pinatnubayan sila sa pamamagitan ng isang ulap, at buong gabi ay sa pamamagitan ng tanglaw na apoy."
            },
            {
              "chapter": 78,
              "verse": 15,
              "name": "Mga Awit 78:15",
              "text": "Kaniyang pinuwangan ang mga bato sa ilang, at pinainom niya sila ng sagana na gaya ng mula sa mga kalaliman."
            },
            {
              "chapter": 78,
              "verse": 16,
              "name": "Mga Awit 78:16",
              "text": "Nagpabukal naman siya mula sa bato. At nagpababa ng tubig na parang mga ilog."
            },
            {
              "chapter": 78,
              "verse": 17,
              "name": "Mga Awit 78:17",
              "text": "Gayon ma'y nagkasala uli sila laban sa kaniya, upang manghimagsik laban sa Kataastaasan sa ilang."
            },
            {
              "chapter": 78,
              "verse": 18,
              "name": "Mga Awit 78:18",
              "text": "At kanilang tinukso ang Dios sa kanilang puso, sa paghingi ng pagkain sa kanilang pita."
            },
            {
              "chapter": 78,
              "verse": 19,
              "name": "Mga Awit 78:19",
              "text": "Oo, sila'y nagsalita laban sa Dios; kanilang sinabi, Makapaghahanda ba ang Dios ng dulang sa ilang?"
            },
            {
              "chapter": 78,
              "verse": 20,
              "name": "Mga Awit 78:20",
              "text": "Narito, kaniyang pinalo ang bato, na ang mga tubig ay bumubuluwak, at mga bukal ay nagsisiapaw; makapagbibigay ba siya ng tinapay naman? Ipaghahanda ba niya ng karne ang kaniyang bayan?"
            },
            {
              "chapter": 78,
              "verse": 21,
              "name": "Mga Awit 78:21",
              "text": "Kaya't narinig ng Panginoon, at napoot: at isang apoy ay nagalab laban sa Jacob, at galit naman ay napailanglang laban sa Israel;"
            },
            {
              "chapter": 78,
              "verse": 22,
              "name": "Mga Awit 78:22",
              "text": "Sapagka't sila'y hindi nagsisampalataya sa Dios, at hindi nagsitiwala sa kaniyang pagliligtas."
            },
            {
              "chapter": 78,
              "verse": 23,
              "name": "Mga Awit 78:23",
              "text": "Gayon ma'y nagutos siya sa mga langit sa itaas, at binuksan ang mga pintuan ng langit;"
            },
            {
              "chapter": 78,
              "verse": 24,
              "name": "Mga Awit 78:24",
              "text": "At pinaulanan niya sila ng mana upang makain. At binigyan sila ng trigo ng langit."
            },
            {
              "chapter": 78,
              "verse": 25,
              "name": "Mga Awit 78:25",
              "text": "Kumain ang tao ng tinapay ng makapangyarihan: pinadalhan niya sila ng pagkain hanggang sa nangabusog."
            },
            {
              "chapter": 78,
              "verse": 26,
              "name": "Mga Awit 78:26",
              "text": "Kaniyang pinahihip ang hanging silanganan sa mga langit: at sa pamamagitan ng kaniyang kapangyarihan ay pinatnubayan niya ang hanging timugan."
            },
            {
              "chapter": 78,
              "verse": 27,
              "name": "Mga Awit 78:27",
              "text": "Pinaulanan naman niya sila ng karne na parang alabok, at ng mga ibong parang buhangin sa mga dagat:"
            },
            {
              "chapter": 78,
              "verse": 28,
              "name": "Mga Awit 78:28",
              "text": "At pinalagpak niya sa gitna ng kanilang kampamento, sa palibot ng kanilang mga tahanan."
            },
            {
              "chapter": 78,
              "verse": 29,
              "name": "Mga Awit 78:29",
              "text": "Sa gayo'y nagsikain sila, at nangabusog na mabuti; at ibinigay niya sa kanila ang kanilang pita."
            },
            {
              "chapter": 78,
              "verse": 30,
              "name": "Mga Awit 78:30",
              "text": "Hindi sila nagsihiwalay sa kanilang pita, ang kanilang pagkain ay nasa kanila pang mga bibig,"
            },
            {
              "chapter": 78,
              "verse": 31,
              "name": "Mga Awit 78:31",
              "text": "Nang ang galit ng Dios ay paitaas laban sa kanila, at pumatay sa mga pinakamataba sa kanila, at sinaktan ang mga binata sa Israel."
            },
            {
              "chapter": 78,
              "verse": 32,
              "name": "Mga Awit 78:32",
              "text": "Sa lahat ng ito ay nangagkasala pa sila, at hindi naniwala sa kaniyang kagilagilalas na mga gawa."
            },
            {
              "chapter": 78,
              "verse": 33,
              "name": "Mga Awit 78:33",
              "text": "Kaya't kaniyang pinaram ang kanilang mga kaarawan sa walang kabuluhan, at ang kanilang mga taon ay sa mga kakilabutan."
            },
            {
              "chapter": 78,
              "verse": 34,
              "name": "Mga Awit 78:34",
              "text": "Nang kaniyang patayin sila, sila'y nangagusisa sa kaniya: at sila'y nagsibalik, at nagsihanap ng tapat sa Dios."
            },
            {
              "chapter": 78,
              "verse": 35,
              "name": "Mga Awit 78:35",
              "text": "At kanilang naalaala na ang Dios ay kanilang malaking bato, at ang Kataastaasang Dios ay kanilang manunubos."
            },
            {
              "chapter": 78,
              "verse": 36,
              "name": "Mga Awit 78:36",
              "text": "Nguni't tinutuya nila siya ng kanilang bibig, at pinagbubulaanan nila siya ng kanilang dila."
            },
            {
              "chapter": 78,
              "verse": 37,
              "name": "Mga Awit 78:37",
              "text": "Sapagka't ang kanilang puso ay hindi matuwid sa kaniya, ni tapat man sila sa kaniyang tipan."
            },
            {
              "chapter": 78,
              "verse": 38,
              "name": "Mga Awit 78:38",
              "text": "Nguni't siya, palibhasa'y puspos ng kaawaan, ay pinatawad ang kanilang kasamaan at hindi sila nilipol: Oo, madalas na inihiwalay ang kaniyang galit, at hindi pinukaw ang buo niyang poot."
            },
            {
              "chapter": 78,
              "verse": 39,
              "name": "Mga Awit 78:39",
              "text": "At naalaala niyang sila'y laman lamang; hanging dumadaan, at hindi bumabalik."
            },
            {
              "chapter": 78,
              "verse": 40,
              "name": "Mga Awit 78:40",
              "text": "Kay dalas na nanghimagsik nila laban sa kaniya sa ilang, at pinapanglaw nila siya sa ilang!"
            },
            {
              "chapter": 78,
              "verse": 41,
              "name": "Mga Awit 78:41",
              "text": "At sila'y nagsibalik uli, at tinukso ang Dios, at minungkahi ang Banal ng Israel."
            },
            {
              "chapter": 78,
              "verse": 42,
              "name": "Mga Awit 78:42",
              "text": "Hindi nila inalaala ang kaniyang kamay, ni ang araw man nang kaniyang tubusin sila sa kaaway."
            },
            {
              "chapter": 78,
              "verse": 43,
              "name": "Mga Awit 78:43",
              "text": "Kung paanong kaniyang inilagay ang kaniyang mga tanda sa Egipto, at ang kaniyang mga kababalaghan sa parang ng Zoan;"
            },
            {
              "chapter": 78,
              "verse": 44,
              "name": "Mga Awit 78:44",
              "text": "At pinapaging dugo ang kanilang mga ilog, at ang kanilang mga bukal, na anopa't hindi sila makainom."
            },
            {
              "chapter": 78,
              "verse": 45,
              "name": "Mga Awit 78:45",
              "text": "Nagsugo rin siya sa gitna nila ng mga pulutong ng mga bangaw na lumamon sa kanila; at mga palaka, na nagsigiba sa kanila."
            },
            {
              "chapter": 78,
              "verse": 46,
              "name": "Mga Awit 78:46",
              "text": "Ibinigay rin niya ang kanilang bunga sa tipaklong, at ang kanilang pakinabang sa balang."
            },
            {
              "chapter": 78,
              "verse": 47,
              "name": "Mga Awit 78:47",
              "text": "Sinira niya ang kanilang ubasan ng granizo, at ang mga puno nila ng sikomoro ng escarcha."
            },
            {
              "chapter": 78,
              "verse": 48,
              "name": "Mga Awit 78:48",
              "text": "Ibinigay rin naman niya ang kanilang mga hayop sa granizo, at sa mga lintik ang kanilang mga kawan."
            },
            {
              "chapter": 78,
              "verse": 49,
              "name": "Mga Awit 78:49",
              "text": "Ibinugso niya sa kanila ang kabangisan ng kaniyang galit, poot at galit, at kabagabagan, pulutong ng mga anghel ng kasamaan."
            },
            {
              "chapter": 78,
              "verse": 50,
              "name": "Mga Awit 78:50",
              "text": "Kaniyang iginawa ng landas ang kaniyang galit; hindi niya pinigil ang kanilang buhay sa kamatayan, kundi ibinigay ang kanilang buhay sa pagkapuksa;"
            },
            {
              "chapter": 78,
              "verse": 51,
              "name": "Mga Awit 78:51",
              "text": "At sinaktan ang lahat na panganay sa Egipto, ang panguna ng kanilang kalakasan sa mga tolda ni Cham:"
            },
            {
              "chapter": 78,
              "verse": 52,
              "name": "Mga Awit 78:52",
              "text": "Nguni't kaniyang pinayaon ang kaniyang sariling bayan na parang mga tupa, at pinatnubayan sila sa ilang na parang kawan."
            },
            {
              "chapter": 78,
              "verse": 53,
              "name": "Mga Awit 78:53",
              "text": "At inihatid niya silang tiwasay, na anopa't hindi sila nangatakot: nguni't tinakpan ng dagat ang kanilang mga kaaway."
            },
            {
              "chapter": 78,
              "verse": 54,
              "name": "Mga Awit 78:54",
              "text": "At dinala niya sila sa hangganan ng kaniyang santuario, sa bundok na ito na binili ng kaniyang kanang kamay."
            },
            {
              "chapter": 78,
              "verse": 55,
              "name": "Mga Awit 78:55",
              "text": "Pinalayas din niya ang mga bansa sa harap nila, at binahagi sa kanila na pinakamana sa pamamagitan ng pising panukat, at pinatahan ang mga lipi ng Israel sa kanilang mga tolda."
            },
            {
              "chapter": 78,
              "verse": 56,
              "name": "Mga Awit 78:56",
              "text": "Gayon ma'y nanukso at nanghimagsik sila laban sa Kataastaasang Dios, at hindi iningatan ang kaniyang mga patotoo;"
            },
            {
              "chapter": 78,
              "verse": 57,
              "name": "Mga Awit 78:57",
              "text": "Kundi nagsitalikod, at nagsigawang may paglililo na gaya ng kanilang mga magulang: sila'y nagsilisyang parang magdarayang busog."
            },
            {
              "chapter": 78,
              "verse": 58,
              "name": "Mga Awit 78:58",
              "text": "Sapagka't minungkahi nila siya sa galit ng kanilang mga mataas na dako, at kinilos nila siya sa panibugho ng kanilang mga larawang inanyuan."
            },
            {
              "chapter": 78,
              "verse": 59,
              "name": "Mga Awit 78:59",
              "text": "Nang marinig ito ng Dios, ay napoot, at kinayamutang lubha ang Israel:"
            },
            {
              "chapter": 78,
              "verse": 60,
              "name": "Mga Awit 78:60",
              "text": "Sa gayo'y kaniyang pinabayaan ang tabernakulo ng Silo, ang tolda na kaniyang inilagay sa gitna ng mga tao;"
            },
            {
              "chapter": 78,
              "verse": 61,
              "name": "Mga Awit 78:61",
              "text": "At ibinigay ang kaniyang kalakasan sa pagkabihag, at ang kaniyang kaluwalhatian ay sa kamay ng kaaway."
            },
            {
              "chapter": 78,
              "verse": 62,
              "name": "Mga Awit 78:62",
              "text": "Ibinigay rin niya ang kaniyang bayan sa tabak; at napoot sa kaniyang mana."
            },
            {
              "chapter": 78,
              "verse": 63,
              "name": "Mga Awit 78:63",
              "text": "Nilamon ng apoy ang kanilang mga binata; at ang mga dalaga nila'y hindi nagkaroon ng awit ng pagaasawa."
            },
            {
              "chapter": 78,
              "verse": 64,
              "name": "Mga Awit 78:64",
              "text": "Ang mga saserdote nila'y nabuwal sa pamamagitan ng tabak; at ang mga bao nila'y hindi nanganaghoy."
            },
            {
              "chapter": 78,
              "verse": 65,
              "name": "Mga Awit 78:65",
              "text": "Nang magkagayo'y gumising ang Panginoon na gaya ng mula sa pagkakatulog, gaya ng malakas na tao na humihiyaw dahil sa alak."
            },
            {
              "chapter": 78,
              "verse": 66,
              "name": "Mga Awit 78:66",
              "text": "At sinaktan niya sa likod ang kaniyang mga kaaway: inilagay niya sila sa laging kadustaan."
            },
            {
              "chapter": 78,
              "verse": 67,
              "name": "Mga Awit 78:67",
              "text": "Bukod dito'y tinanggihan niya ang tolda ng Jose, at hindi pinili ang lipi ni Ephraim;"
            },
            {
              "chapter": 78,
              "verse": 68,
              "name": "Mga Awit 78:68",
              "text": "Kundi pinili ang lipi ni Juda, ang bundok ng Zion na kaniyang inibig."
            },
            {
              "chapter": 78,
              "verse": 69,
              "name": "Mga Awit 78:69",
              "text": "At itinayo niya ang kaniyang santuario na parang mga kataasan, parang lupa na kaniyang itinatag magpakailan man."
            },
            {
              "chapter": 78,
              "verse": 70,
              "name": "Mga Awit 78:70",
              "text": "Pinili naman niya si David na kaniyang lingkod, at kinuha niya siya mula sa kulungan ng mga tupa:"
            },
            {
              "chapter": 78,
              "verse": 71,
              "name": "Mga Awit 78:71",
              "text": "Dinala niya siya na mula sa pagsunod sa mga tupa ng nagpapasuso, upang maging pastor ng Jacob na kaniyang bayan, at ang Israel na kaniyang mana."
            },
            {
              "chapter": 78,
              "verse": 72,
              "name": "Mga Awit 78:72",
              "text": "Sa gayo'y siya ang kanilang pastor ayon sa pagtatapat ng kaniyang puso; at pinatnubayan niya sila sa pamamagitan ng kabihasahan ng kaniyang mga kamay."
            }
          ]
        },
        {
          "chapter": 79,
          "name": "Mga Awit 79",
          "verses": [
            {
              "chapter": 79,
              "verse": 1,
              "name": "Mga Awit 79:1",
              "text": "Oh Dios, ang mga bansa ay dumating sa iyong mana; ang iyong banal na templo ay kanilang nilapastangan; kanilang pinapaging bunton ang Jerusalem."
            },
            {
              "chapter": 79,
              "verse": 2,
              "name": "Mga Awit 79:2",
              "text": "Ang mga bangkay ng iyong mga lingkod ay ibinigay nila na pagkain sa mga ibon sa himpapawid, ang laman ng iyong mga banal ay sa mga hayop sa lupa."
            },
            {
              "chapter": 79,
              "verse": 3,
              "name": "Mga Awit 79:3",
              "text": "Ang kanilang dugo ay ibinubo nila na parang tubig sa palibot ng Jerusalem; at walang naglibing sa kanila."
            },
            {
              "chapter": 79,
              "verse": 4,
              "name": "Mga Awit 79:4",
              "text": "Kami ay naging kadustaan sa aming kalapit, kasabihan at kakutyaan nilang nangasa palibot namin."
            },
            {
              "chapter": 79,
              "verse": 5,
              "name": "Mga Awit 79:5",
              "text": "Hanggang kailan, Oh Panginoon, magagalit ka magpakailan man? Magaalab ba ang iyong paninibugho na parang apoy?"
            },
            {
              "chapter": 79,
              "verse": 6,
              "name": "Mga Awit 79:6",
              "text": "Ibugso mo ang iyong pagiinit sa mga bansa na hindi nangakakakilala sa iyo, at sa mga kaharian na hindi nagsisitawag sa iyong pangalan."
            },
            {
              "chapter": 79,
              "verse": 7,
              "name": "Mga Awit 79:7",
              "text": "Sapagka't kanilang nilamon ang Jacob, at inilagay na sira ang kaniyang tahanan."
            },
            {
              "chapter": 79,
              "verse": 8,
              "name": "Mga Awit 79:8",
              "text": "Huwag mong alalahanin laban sa amin ang kasamaan ng aming mga magulang: magmadali ang iyong mga malumanay na kaawaan na tulungan kami: sapagka't kami ay totoong hinamak."
            },
            {
              "chapter": 79,
              "verse": 9,
              "name": "Mga Awit 79:9",
              "text": "Iyong tulungan kami, Oh Dios ng aming kaligtasan, dahil sa kaluwalhatian ng iyong pangalan: at iyong iligtas kami, at linisin mo ang aming mga kasalanan, dahil sa iyong pangalan."
            },
            {
              "chapter": 79,
              "verse": 10,
              "name": "Mga Awit 79:10",
              "text": "Bakit sasabihin ng mga bansa, Saan nandoon ang kanilang Dios? Ang kagantihan sa dugo na nabubo sa iyong mga lingkod maalaman nawa ng mga bansa sa aming paningin."
            },
            {
              "chapter": 79,
              "verse": 11,
              "name": "Mga Awit 79:11",
              "text": "Dumating nawa sa harap mo ang buntong-hininga ng bihag; ayon sa kadakilaan ng iyong kapangyarihan ay palagiin mo yaong nangatakda sa kamatayan:"
            },
            {
              "chapter": 79,
              "verse": 12,
              "name": "Mga Awit 79:12",
              "text": "At ibalik mo sa aming mga kalapit-bansa sa makapito sa kanilang sinapupunan, ang kanilang pagduwahagi na kanilang idinuwahagi sa iyo, Oh Panginoon."
            },
            {
              "chapter": 79,
              "verse": 13,
              "name": "Mga Awit 79:13",
              "text": "Sa gayo'y kaming iyong bayan at mga tupa sa pastulan mo mangagpapasalamat sa iyo magpakailan man: aming ipakikilala ang iyong kapurihan sa lahat ng mga lahi."
            }
          ]
        },
        {
          "chapter": 80,
          "name": "Mga Awit 80",
          "verses": [
            {
              "chapter": 80,
              "verse": 1,
              "name": "Mga Awit 80:1",
              "text": "Dinggin mo, Oh Pastor ng Israel, ikaw na pumapatnubay sa Jose na parang kawan; ikaw na nauupo sa ibabaw ng mga querubin, sumilang ka."
            },
            {
              "chapter": 80,
              "verse": 2,
              "name": "Mga Awit 80:2",
              "text": "Sa harap ng Ephraim, ng Benjamin at ng Manases, ay mapukaw nawa ang kapangyarihan mo, at parito kang iligtas mo kami."
            },
            {
              "chapter": 80,
              "verse": 3,
              "name": "Mga Awit 80:3",
              "text": "Papanumbalikin mo kami, Oh Dios; at pasilangin mo ang iyong mukha, at maliligtas kami."
            },
            {
              "chapter": 80,
              "verse": 4,
              "name": "Mga Awit 80:4",
              "text": "Oh Panginoong Dios ng mga hukbo, hanggang kailan magagalit ka laban sa dalangin ng iyong bayan?"
            },
            {
              "chapter": 80,
              "verse": 5,
              "name": "Mga Awit 80:5",
              "text": "Iyong pinakain sila ng tinapay na mga luha, at binigyan mo sila ng mga luha upang inumin ng sagana."
            },
            {
              "chapter": 80,
              "verse": 6,
              "name": "Mga Awit 80:6",
              "text": "Iyong ginawa kaming kaalitan sa aming mga kalapit bansa: at ang mga kaaway namin ay nagtatawanan."
            },
            {
              "chapter": 80,
              "verse": 7,
              "name": "Mga Awit 80:7",
              "text": "Ibalik mo kami, Oh Dios ng mga hukbo; at pasilangin mo ang iyong mukha at kami ay maliligtas."
            },
            {
              "chapter": 80,
              "verse": 8,
              "name": "Mga Awit 80:8",
              "text": "Ikaw ay nagdala ng isang puno ng ubas mula sa Egipto; iyong pinalayas ang mga bansa, at itinanim mo yaon."
            },
            {
              "chapter": 80,
              "verse": 9,
              "name": "Mga Awit 80:9",
              "text": "Ikaw ay naghanda ng dako sa harap niya, at napailalim ang ugat, at pinuno ang lupain."
            },
            {
              "chapter": 80,
              "verse": 10,
              "name": "Mga Awit 80:10",
              "text": "Ang mga bundok ay natakpan ng lilim niyaon, at ang mga sanga niyaon ay gaya ng mga sedro ng Dios."
            },
            {
              "chapter": 80,
              "verse": 11,
              "name": "Mga Awit 80:11",
              "text": "Kaniyang pinaabot ang kaniyang mga sanga hanggang sa dagat, at ang kaniyang mga suwi hanggang sa ilog."
            },
            {
              "chapter": 80,
              "verse": 12,
              "name": "Mga Awit 80:12",
              "text": "Bakit mo ibinagsak ang kaniyang mga bakod, na anopa't siya'y binubunot nilang lahat na nangagdadaan?"
            },
            {
              "chapter": 80,
              "verse": 13,
              "name": "Mga Awit 80:13",
              "text": "Sinisira ng baboy-ramo, at sinasabsab ng mailap na hayop sa parang."
            },
            {
              "chapter": 80,
              "verse": 14,
              "name": "Mga Awit 80:14",
              "text": "Bumalik ka uli, isinasamo ko sa iyo, Oh Dios ng mga hukbo: tumungo ka mula sa langit, at iyong masdan, at dalawin mo ang puno ng ubas na ito,"
            },
            {
              "chapter": 80,
              "verse": 15,
              "name": "Mga Awit 80:15",
              "text": "At ang ubasan na itinanim ng iyong kanan, at ang suwi na iyong pinalakas para sa iyong sarili."
            },
            {
              "chapter": 80,
              "verse": 16,
              "name": "Mga Awit 80:16",
              "text": "Nasunog ng apoy, at naputol: sila'y nalipol sa saway ng iyong mukha."
            },
            {
              "chapter": 80,
              "verse": 17,
              "name": "Mga Awit 80:17",
              "text": "Mapatong nawa ang iyong kamay sa tao na iyong kinakanan. Sa anak ng tao na iyong pinalakas sa iyong sarili."
            },
            {
              "chapter": 80,
              "verse": 18,
              "name": "Mga Awit 80:18",
              "text": "Sa gayo'y hindi kami magsisitalikod sa iyo: buhayin mo kami, at tatawagan namin ang iyong pangalan."
            },
            {
              "chapter": 80,
              "verse": 19,
              "name": "Mga Awit 80:19",
              "text": "Papanumbalikin mo kami, Oh Panginoong Dios ng mga hukbo; pasilangin mo ang iyong mukha at maliligtas kami."
            }
          ]
        },
        {
          "chapter": 81,
          "name": "Mga Awit 81",
          "verses": [
            {
              "chapter": 81,
              "verse": 1,
              "name": "Mga Awit 81:1",
              "text": "Magsiawit kayo ng malakas sa Dios na ating kalakasan: mangagkaingay kayo na may kagalakan sa Dios ni Jacob,"
            },
            {
              "chapter": 81,
              "verse": 2,
              "name": "Mga Awit 81:2",
              "text": "Magsiawit kayo at dalhin ninyo rito ang pandereta, ang masayang alpa sangpu ng salterio."
            },
            {
              "chapter": 81,
              "verse": 3,
              "name": "Mga Awit 81:3",
              "text": "Magsihihip kayo ng pakakak sa bagong buwan, sa kabilugan ng buwan, sa ating dakilang kapistahan."
            },
            {
              "chapter": 81,
              "verse": 4,
              "name": "Mga Awit 81:4",
              "text": "Sapagka't pinakapalatuntunan sa Israel, ayos ng Dios ni Jacob."
            },
            {
              "chapter": 81,
              "verse": 5,
              "name": "Mga Awit 81:5",
              "text": "Kaniyang inilagay na pinakapatotoo sa Jose, nang siya'y lumabas na maglakbay sa lupain ng Egipto: na aking kinaringgan ng wika na di ko nauunawa."
            },
            {
              "chapter": 81,
              "verse": 6,
              "name": "Mga Awit 81:6",
              "text": "Aking inihiwalay ang kaniyang balikat sa pasan: ang mga kamay niya'y napabitiw sa luwelang."
            },
            {
              "chapter": 81,
              "verse": 7,
              "name": "Mga Awit 81:7",
              "text": "Ikaw ay tumawag sa kabagabagan, at iniligtas kita; sinagot kita sa lihim na dako ng kulog; sinubok kita sa tubig ng Meriba. (Selah)"
            },
            {
              "chapter": 81,
              "verse": 8,
              "name": "Mga Awit 81:8",
              "text": "Dinggin mo, Oh bayan ko, at ako'y sasaksi sa iyo: Oh Israel, kung ikaw ay makikinig sa akin!"
            },
            {
              "chapter": 81,
              "verse": 9,
              "name": "Mga Awit 81:9",
              "text": "Hindi magkakaroon ng ibang dios sa iyo; at hindi ka man sasamba sa anomang ibang dios."
            },
            {
              "chapter": 81,
              "verse": 10,
              "name": "Mga Awit 81:10",
              "text": "Ako ang Panginoon mong Dios, na naglabas sa iyo mula sa lupain ng Egipto: bukhin mong maluwang ang iyong bibig, at aking pupunuin."
            },
            {
              "chapter": 81,
              "verse": 11,
              "name": "Mga Awit 81:11",
              "text": "Nguni't hindi nakinig sa aking tinig ang bayan ko; at hindi ako sinunod ng Israel."
            },
            {
              "chapter": 81,
              "verse": 12,
              "name": "Mga Awit 81:12",
              "text": "Sa gayo'y aking pinasunod sa pagmamatigas ng kanilang puso, upang sila'y makalakad sa kanilang sariling mga payo."
            },
            {
              "chapter": 81,
              "verse": 13,
              "name": "Mga Awit 81:13",
              "text": "Oh kung ako'y didinggin ng aking bayan, kung ang Israel ay lalakad sa aking mga daan!"
            },
            {
              "chapter": 81,
              "verse": 14,
              "name": "Mga Awit 81:14",
              "text": "Aking pasusukuing madali ang kanilang mga kaaway, at ibabalik ko ang aking kamay laban sa kanilang mga kaaway."
            },
            {
              "chapter": 81,
              "verse": 15,
              "name": "Mga Awit 81:15",
              "text": "Ang mga mapagtanim sa Panginoon ay magsisisuko sa kaniya: nguni't ang kanilang panahon ay mananatili kailan man,"
            },
            {
              "chapter": 81,
              "verse": 16,
              "name": "Mga Awit 81:16",
              "text": "Kaniya ring pakakanin sila ng katabaan ng trigo: at ng pulot na mula sa bato ay bubusugin kita."
            }
          ]
        },
        {
          "chapter": 82,
          "name": "Mga Awit 82",
          "verses": [
            {
              "chapter": 82,
              "verse": 1,
              "name": "Mga Awit 82:1",
              "text": "Ang Dios ay tumatayo sa kapisanan ng Dios; siya'y humahatol sa gitna ng mga dios."
            },
            {
              "chapter": 82,
              "verse": 2,
              "name": "Mga Awit 82:2",
              "text": "Hanggang kailan magsisihatol kayo ng kalikuan, at magsisigalang sa mga pagkatao ng masama? (Selah)"
            },
            {
              "chapter": 82,
              "verse": 3,
              "name": "Mga Awit 82:3",
              "text": "Hatulan mo ang dukha at ulila: gawan mo ng kaganapan ang napipighati at walang nagkakandili."
            },
            {
              "chapter": 82,
              "verse": 4,
              "name": "Mga Awit 82:4",
              "text": "Sagipin mo ang dukha at mapagkailangan: iligtas ninyo sila sa kamay ng masama,"
            },
            {
              "chapter": 82,
              "verse": 5,
              "name": "Mga Awit 82:5",
              "text": "Hindi nila nalalaman, ni nauunawa man; sila'y nagsisilakad na paroo't parito sa kadiliman: lahat ng patibayan ng lupa ay nangakilos."
            },
            {
              "chapter": 82,
              "verse": 6,
              "name": "Mga Awit 82:6",
              "text": "Aking sinabi, Kayo'y mga dios, at kayong lahat ay mga anak ng Kataastaasan."
            },
            {
              "chapter": 82,
              "verse": 7,
              "name": "Mga Awit 82:7",
              "text": "Gayon ma'y mangamamatay kayong parang mga tao, at mangabubuwal na parang isa sa mga pangulo."
            },
            {
              "chapter": 82,
              "verse": 8,
              "name": "Mga Awit 82:8",
              "text": "Bumangon ka, O Dios, hatulan mo ang lupa: sapagka't iyong mamanahin ang lahat ng mga bansa."
            }
          ]
        },
        {
          "chapter": 83,
          "name": "Mga Awit 83",
          "verses": [
            {
              "chapter": 83,
              "verse": 1,
              "name": "Mga Awit 83:1",
              "text": "Oh Dios, huwag kang tumahimik: huwag kang mapayapa, at tumiwasay, Oh Dios."
            },
            {
              "chapter": 83,
              "verse": 2,
              "name": "Mga Awit 83:2",
              "text": "Sapagka't narito, ang mga kaaway mo'y nanggugulo: at silang nangagtatanim sa iyo ay nangagtaas ng ulo."
            },
            {
              "chapter": 83,
              "verse": 3,
              "name": "Mga Awit 83:3",
              "text": "Sila'y nagsisitanggap ng payong may katusuhan laban sa iyong bayan, at nangagsanggunian laban sa iyong nangakakubli."
            },
            {
              "chapter": 83,
              "verse": 4,
              "name": "Mga Awit 83:4",
              "text": "Kanilang sinabi, Kayo'y parito, at atin silang ihiwalay sa pagkabansa; upang ang pangalan ng Israel ay huwag nang maalaala pa."
            },
            {
              "chapter": 83,
              "verse": 5,
              "name": "Mga Awit 83:5",
              "text": "Sapagka't sila'y nangagsangguniang magkakasama na may isang pagkakaayon; laban sa iyo ay nangagtitipanan:"
            },
            {
              "chapter": 83,
              "verse": 6,
              "name": "Mga Awit 83:6",
              "text": "Ang mga tolda ng Edom at ng mga Ismaelita; ang Moab at ang mga Agareno;"
            },
            {
              "chapter": 83,
              "verse": 7,
              "name": "Mga Awit 83:7",
              "text": "Ang Gebal, at ang Ammon, at ang Amalec; ang Filisteo na kasama ng mga taga Tiro:"
            },
            {
              "chapter": 83,
              "verse": 8,
              "name": "Mga Awit 83:8",
              "text": "Pati ng Asiria ay nalalakip sa kanila; kanilang tinulungan ang mga anak ni Lot."
            },
            {
              "chapter": 83,
              "verse": 9,
              "name": "Mga Awit 83:9",
              "text": "Gumawa ka sa kanila ng gaya sa Madianita; gaya kay Sisara, gaya kay Jabin, sa ilog ng Cison:"
            },
            {
              "chapter": 83,
              "verse": 10,
              "name": "Mga Awit 83:10",
              "text": "Na nangamatay sa Endor; sila'y naging parang dumi sa lupa."
            },
            {
              "chapter": 83,
              "verse": 11,
              "name": "Mga Awit 83:11",
              "text": "Gawin mo ang kanilang mga maginoo na gaya ni Oreb at ni Zeeb; Oo, lahat nilang mga pangulo ay gaya ni Zeba at ni Zalmuna;"
            },
            {
              "chapter": 83,
              "verse": 12,
              "name": "Mga Awit 83:12",
              "text": "Na siyang nagsipagsabi, kunin natin para sa atin na pinakaari ang mga tahanan ng Dios."
            },
            {
              "chapter": 83,
              "verse": 13,
              "name": "Mga Awit 83:13",
              "text": "Oh Dios ko, gawin mo silang parang ipoipong alabok; Parang dayami sa harap ng hangin."
            },
            {
              "chapter": 83,
              "verse": 14,
              "name": "Mga Awit 83:14",
              "text": "Parang apoy na sumusunog ng gubat, at parang liyab na nanunupok ng mga bundok;"
            },
            {
              "chapter": 83,
              "verse": 15,
              "name": "Mga Awit 83:15",
              "text": "Kaya't habulin mo sila ng iyong bagyo, at pangilabutin mo sila ng iyong unos."
            },
            {
              "chapter": 83,
              "verse": 16,
              "name": "Mga Awit 83:16",
              "text": "Lipusin mo ang kanilang mga mukha ng kahihiyan; upang hanapin nila ang iyong pangalan, Oh Panginoon."
            },
            {
              "chapter": 83,
              "verse": 17,
              "name": "Mga Awit 83:17",
              "text": "Mangapahiya sila at manganglupaypay magpakailan man; Oo, mangahiya sila at mangalipol:"
            },
            {
              "chapter": 83,
              "verse": 18,
              "name": "Mga Awit 83:18",
              "text": "Upang kanilang maalaman na ikaw lamang, na ang pangalan ay JEHOVA, ay Kataastaasan sa buong lupa."
            }
          ]
        },
        {
          "chapter": 84,
          "name": "Mga Awit 84",
          "verses": [
            {
              "chapter": 84,
              "verse": 1,
              "name": "Mga Awit 84:1",
              "text": "Kay iinam ng iyong mga tabernakulo, Oh Panginoon ng mga hukbo!"
            },
            {
              "chapter": 84,
              "verse": 2,
              "name": "Mga Awit 84:2",
              "text": "Ang kaluluwa ko'y aasamasam, oo, nanglulupaypay sa mga looban ng Panginoon; ang puso ko't laman ay dumadaing sa buhay na Dios."
            },
            {
              "chapter": 84,
              "verse": 3,
              "name": "Mga Awit 84:3",
              "text": "Oo, ang maya ay nakasumpong ng bahay, at ang langaylangayan ay nagpugad para sa kaniya, na mapaglalapagan niya ng kaniyang inakay, sa makatuwid baga'y iyong mga dambana, Oh Panginoon ng mga hukbo, Hari ko, at Dios ko."
            },
            {
              "chapter": 84,
              "verse": 4,
              "name": "Mga Awit 84:4",
              "text": "Mapalad silang nagsisitahan sa iyong bahay: kanilang pupurihin kang palagi. (Selah)"
            },
            {
              "chapter": 84,
              "verse": 5,
              "name": "Mga Awit 84:5",
              "text": "Mapalad ang tao na ang kalakasan ay nasa iyo; na may mga daan sa kaniyang puso na tungo sa Sion."
            },
            {
              "chapter": 84,
              "verse": 6,
              "name": "Mga Awit 84:6",
              "text": "Na nagdaraan sa libis ng iyak na ginagawa nilang dako ng mga bukal; Oo, tinatakpan ng pagpapala ng maagang ulan."
            },
            {
              "chapter": 84,
              "verse": 7,
              "name": "Mga Awit 84:7",
              "text": "Sila'y nagsisiyaon sa kalakasa't kalakasan, bawa't isa sa kanila ay napakikita sa harap ng Dios sa Sion."
            },
            {
              "chapter": 84,
              "verse": 8,
              "name": "Mga Awit 84:8",
              "text": "Oh Panginoong Dios ng mga hukbo, dinggin mo ang aking dalangin: pakinggan mo, Oh Dios ni Jacob. (Selah)"
            },
            {
              "chapter": 84,
              "verse": 9,
              "name": "Mga Awit 84:9",
              "text": "Masdan mo, Oh Dios na aming kalasag, at tingnan mo ang mukha ng iyong pinahiran ng langis."
            },
            {
              "chapter": 84,
              "verse": 10,
              "name": "Mga Awit 84:10",
              "text": "Sapagka't isang araw sa iyong mga looban ay mabuti kay sa isang libo. Aking minagaling na maging tagatanod-pinto sa bahay ng aking Dios, kay sa tumahan sa mga tolda ng kasamaan."
            },
            {
              "chapter": 84,
              "verse": 11,
              "name": "Mga Awit 84:11",
              "text": "Sapagka't ang Panginoong Dios ay araw at kalasag: ang Panginoo'y magbibigay ng biyaya at kaluwalhatian: hindi siya magkakait ng anomang mabuting bagay sa nagsisilakad ng matuwid."
            },
            {
              "chapter": 84,
              "verse": 12,
              "name": "Mga Awit 84:12",
              "text": "Oh Panginoon ng mga hukbo, mapalad ang tao na tumitiwala sa iyo."
            }
          ]
        },
        {
          "chapter": 85,
          "name": "Mga Awit 85",
          "verses": [
            {
              "chapter": 85,
              "verse": 1,
              "name": "Mga Awit 85:1",
              "text": "Panginoon, ikaw ay naging lingap sa iyong lupain: iyong ibinalik ang nangabihag ng Jacob."
            },
            {
              "chapter": 85,
              "verse": 2,
              "name": "Mga Awit 85:2",
              "text": "Iyong pinatawad ang kasamaan ng iyong bayan, iyong tinakpan ang lahat nilang kasalanan, (Selah)"
            },
            {
              "chapter": 85,
              "verse": 3,
              "name": "Mga Awit 85:3",
              "text": "Iyong pinawi ang buong poot mo: iyong tinalikdan ang kabangisan ng iyong galit."
            },
            {
              "chapter": 85,
              "verse": 4,
              "name": "Mga Awit 85:4",
              "text": "Ibalik mo kami, Oh Dios ng aming kaligtasan, at papaglikatin mo ang iyong galit sa amin."
            },
            {
              "chapter": 85,
              "verse": 5,
              "name": "Mga Awit 85:5",
              "text": "Magagalit ka ba sa amin magpakailan man? Iyo bang ipagpapatuloy ang iyong galit sa lahat ng sali't saling lahi?"
            },
            {
              "chapter": 85,
              "verse": 6,
              "name": "Mga Awit 85:6",
              "text": "Hindi mo ba kami bubuhayin uli: upang ang iyong bayan ay magalak sa iyo?"
            },
            {
              "chapter": 85,
              "verse": 7,
              "name": "Mga Awit 85:7",
              "text": "Ipakita mo sa amin ang iyong kagandahang-loob, Oh Panginoon, at ipagkaloob mo sa amin ang iyong pagliligtas."
            },
            {
              "chapter": 85,
              "verse": 8,
              "name": "Mga Awit 85:8",
              "text": "Aking pakikinggan kung ano ang sasalitain ng Dios na Panginoon: sapagka't siya'y magsasalita ng kapayapaan sa kaniyang bayan at sa kaniyang mga banal: nguni't huwag silang manumbalik uli sa kaululan."
            },
            {
              "chapter": 85,
              "verse": 9,
              "name": "Mga Awit 85:9",
              "text": "Tunay na ang kaniyang pagliligtas ay malapit sa kanila na nangatatakot sa kaniya; upang ang kaluwalhatian ay tumahan sa aming lupain."
            },
            {
              "chapter": 85,
              "verse": 10,
              "name": "Mga Awit 85:10",
              "text": "Kaawaan at katotohanan ay nagsalubong; katuwiran at kapayapaan ay naghalikan."
            },
            {
              "chapter": 85,
              "verse": 11,
              "name": "Mga Awit 85:11",
              "text": "Katotohanan ay bumubukal sa lupa; at ang katuwiran ay tumungo mula sa langit."
            },
            {
              "chapter": 85,
              "verse": 12,
              "name": "Mga Awit 85:12",
              "text": "Oo, ibibigay ng Panginoon ang mabuti; at ang ating lupain ay maguunlad ng kaniyang bunga."
            },
            {
              "chapter": 85,
              "verse": 13,
              "name": "Mga Awit 85:13",
              "text": "Katuwira'y mangunguna sa kaniya; at gagawing daan ang kaniyang mga bakas."
            }
          ]
        },
        {
          "chapter": 86,
          "name": "Mga Awit 86",
          "verses": [
            {
              "chapter": 86,
              "verse": 1,
              "name": "Mga Awit 86:1",
              "text": "Ikiling mo ang iyong pakinig, Oh Panginoon, at sagutin mo ako; sapagka't ako'y dukha at mapagkailangan."
            },
            {
              "chapter": 86,
              "verse": 2,
              "name": "Mga Awit 86:2",
              "text": "Ingatan mo ang aking kaluluwa; sapagka't ako'y banal: Oh ikaw na Dios ko, iligtas mo ang iyong lingkod na tumitiwala sa iyo."
            },
            {
              "chapter": 86,
              "verse": 3,
              "name": "Mga Awit 86:3",
              "text": "Maawa ka sa akin, Oh Panginoon, sapagka't sa iyo'y dumadaing ako buong araw."
            },
            {
              "chapter": 86,
              "verse": 4,
              "name": "Mga Awit 86:4",
              "text": "Bigyan mong galak ang kaluluwa ng iyong lingkod; sapagka't sa iyo, Oh Panginoon, itinataas ko ang aking kaluluwa."
            },
            {
              "chapter": 86,
              "verse": 5,
              "name": "Mga Awit 86:5",
              "text": "Sapagka't ikaw, Panginoon, ay mabuti, at mapagpatawad, at sagana sa kagandahang-loob sa lahat na tumatawag sa iyo."
            },
            {
              "chapter": 86,
              "verse": 6,
              "name": "Mga Awit 86:6",
              "text": "Dinggin mo, Oh Panginoon, ang aking dalangin; at pakinggan mo ang tinig ng aking mga pananaing."
            },
            {
              "chapter": 86,
              "verse": 7,
              "name": "Mga Awit 86:7",
              "text": "Sa kaarawan ng aking kabagabagan ay tatawag ako sa iyo; sapagka't iyong sasagutin ako."
            },
            {
              "chapter": 86,
              "verse": 8,
              "name": "Mga Awit 86:8",
              "text": "Walang gaya mo sa gitna ng mga dios, Oh Panginoon; wala mang mga gawang gaya ng iyong mga gawa."
            },
            {
              "chapter": 86,
              "verse": 9,
              "name": "Mga Awit 86:9",
              "text": "Lahat ng mga bansa na iyong nilalang ay magsisiparito, at magsisisamba sa harap mo, Oh Panginoon; at kanilang luluwalhatiin ang iyong pangalan."
            },
            {
              "chapter": 86,
              "verse": 10,
              "name": "Mga Awit 86:10",
              "text": "Sapagka't ikaw ay dakila, at gumagawa ng kagilagilalas na mga bagay: ikaw na magisa ang Dios."
            },
            {
              "chapter": 86,
              "verse": 11,
              "name": "Mga Awit 86:11",
              "text": "Ituro mo sa akin ang iyong daan, Oh Panginoon; lalakad ako sa iyong katotohanan: ilakip mo ang aking puso sa pagkatakot sa iyong pangalan."
            },
            {
              "chapter": 86,
              "verse": 12,
              "name": "Mga Awit 86:12",
              "text": "Pupurihin kita, Oh Panginoon kong Dios ng aking buong puso; at luluwalhatiin ko ang iyong pangalan magpakailan man."
            },
            {
              "chapter": 86,
              "verse": 13,
              "name": "Mga Awit 86:13",
              "text": "Sapagka't dakila ang iyong kagandahang-loob sa akin; at iyong iniligtas ang aking kaluluwa sa pinakamalalim na Sheol."
            },
            {
              "chapter": 86,
              "verse": 14,
              "name": "Mga Awit 86:14",
              "text": "Oh Dios, ang palalo ay bumangon laban sa akin, at ang kapisanan ng mga marahas na tao ay umusig ng aking kaluluwa, at hindi inilagay ka sa harap nila."
            },
            {
              "chapter": 86,
              "verse": 15,
              "name": "Mga Awit 86:15",
              "text": "Nguni't ikaw, Oh Panginoon, ay Dios na puspos ng kahabagan at mapagbiyaya, banayad sa pagkagalit, at sagana sa kagandahang-loob at katotohanan."
            },
            {
              "chapter": 86,
              "verse": 16,
              "name": "Mga Awit 86:16",
              "text": "Oh bumalik ka sa akin, at maawa ka sa akin; ibigay mo ang lakas mo sa iyong lingkod. At iligtas mo ang anak ng iyong lingkod na babae."
            },
            {
              "chapter": 86,
              "verse": 17,
              "name": "Mga Awit 86:17",
              "text": "Pagpakitaan mo ako ng tanda sa ikabubuti: upang mangakita nilang nangagtatanim sa akin, at mangapahiya, sapagka't ikaw, Panginoon, ay tumulong sa akin, at umaliw sa akin."
            }
          ]
        },
        {
          "chapter": 87,
          "name": "Mga Awit 87",
          "verses": [
            {
              "chapter": 87,
              "verse": 1,
              "name": "Mga Awit 87:1",
              "text": "Ang kaniyang patibayan ay nasa mga banal na bundok."
            },
            {
              "chapter": 87,
              "verse": 2,
              "name": "Mga Awit 87:2",
              "text": "Minahal ng Panginoon ang mga pintuang-bayan ng Sion, ng higit kay sa lahat na tahanan ng Jacob."
            },
            {
              "chapter": 87,
              "verse": 3,
              "name": "Mga Awit 87:3",
              "text": "Maluwalhating mga bagay ang sinalita tungkol sa iyo, Oh bayan ng Dios. (Selah)"
            },
            {
              "chapter": 87,
              "verse": 4,
              "name": "Mga Awit 87:4",
              "text": "Aking babanggitin ang Rahab at ang Babilonia na kasama ng mga nakakakilala sa akin: narito, ang Filistia at ang Tiro, pati ng Etiopia; ang isang ito ay ipinanganak diyan."
            },
            {
              "chapter": 87,
              "verse": 5,
              "name": "Mga Awit 87:5",
              "text": "Oo, tungkol sa Sion ay sasabihin, ang isang ito at ang isang yaon ay ipinanganak sa kaniya; at itatatag siya ng Kataastaasan."
            },
            {
              "chapter": 87,
              "verse": 6,
              "name": "Mga Awit 87:6",
              "text": "Sasalaysayin ng Panginoon, pagka kaniyang isinulat ang mga bayan, ang isang ito ay ipinanganak diyan. (Selah)"
            },
            {
              "chapter": 87,
              "verse": 7,
              "name": "Mga Awit 87:7",
              "text": "Silang nagsisiawit na gaya ng nagsisisayaw ay mangagsasabi, lahat ng aking mga bukal ay nangasa iyo."
            }
          ]
        },
        {
          "chapter": 88,
          "name": "Mga Awit 88",
          "verses": [
            {
              "chapter": 88,
              "verse": 1,
              "name": "Mga Awit 88:1",
              "text": "Oh Panginoon, na Dios ng aking kaligtasan, ako'y dumaing araw at gabi sa harap mo:"
            },
            {
              "chapter": 88,
              "verse": 2,
              "name": "Mga Awit 88:2",
              "text": "Masok ang aking dalangin sa iyong harapan: ikiling mo ang iyong pakinig sa aking daing:"
            },
            {
              "chapter": 88,
              "verse": 3,
              "name": "Mga Awit 88:3",
              "text": "Sapagka't ang aking kaluluwa ay lipos ng mga kabagabagan, at ang aking buhay ay nalalapit sa Sheol,"
            },
            {
              "chapter": 88,
              "verse": 4,
              "name": "Mga Awit 88:4",
              "text": "Ako'y nabilang sa kanila na nagsisibaba sa hukay; ako'y parang taong walang lakas:"
            },
            {
              "chapter": 88,
              "verse": 5,
              "name": "Mga Awit 88:5",
              "text": "Nakahagis sa gitna ng mga patay, gaya ng napatay na nakahiga sa libingan, na hindi mo na inaalaala; at sila'y mangahiwalay sa iyong kamay."
            },
            {
              "chapter": 88,
              "verse": 6,
              "name": "Mga Awit 88:6",
              "text": "Iyong inilapag ako sa pinakamalalim na hukay, sa mga madilim na dako, sa mga kalaliman."
            },
            {
              "chapter": 88,
              "verse": 7,
              "name": "Mga Awit 88:7",
              "text": "Lubhang idinidiin ako ng iyong poot, at iyong pinighati ako ng lahat mong mga alon. (Selah)"
            },
            {
              "chapter": 88,
              "verse": 8,
              "name": "Mga Awit 88:8",
              "text": "Iyong inilayo sa akin ang kakilala ko; iyong ginawa akong kasuklamsuklam sa kanila: ako'y nakulong at hindi ako makalabas,"
            },
            {
              "chapter": 88,
              "verse": 9,
              "name": "Mga Awit 88:9",
              "text": "Ang mata ko'y nangangalumata dahil sa kadalamhatian: ako'y tumawag araw-araw sa iyo, Oh Panginoon, aking iginawad ang mga kamay ko sa iyo."
            },
            {
              "chapter": 88,
              "verse": 10,
              "name": "Mga Awit 88:10",
              "text": "Magpapakita ka ba ng mga kababalaghan sa mga patay? Sila bang mga patay ay magsisibangon, at magsisipuri sa iyo? (Selah)"
            },
            {
              "chapter": 88,
              "verse": 11,
              "name": "Mga Awit 88:11",
              "text": "Ang iyo bang kagandahang-loob ay ipahahayag sa libingan? O ang iyong pagtatapat sa kagibaan?"
            },
            {
              "chapter": 88,
              "verse": 12,
              "name": "Mga Awit 88:12",
              "text": "Malalaman ba ang mga kababalaghan mo sa dilim? At ang katuwiran mo sa lupain ng pagkalimot?"
            },
            {
              "chapter": 88,
              "verse": 13,
              "name": "Mga Awit 88:13",
              "text": "Nguni't sa iyo, Oh Panginoon, dumaing ako, at sa kinaumagahan ay darating ang dalangin ko sa harap mo."
            },
            {
              "chapter": 88,
              "verse": 14,
              "name": "Mga Awit 88:14",
              "text": "Panginoon, bakit mo itinatakuwil ang kaluluwa ko? Bakit mo ikinukubli ang iyong mukha sa akin?"
            },
            {
              "chapter": 88,
              "verse": 15,
              "name": "Mga Awit 88:15",
              "text": "Ako'y nadadalamhati, at handang mamatay mula sa aking kabataan: habang aking tinitiis ang iyong mga kakilakilabot na bagay ay nakakalingat ako."
            },
            {
              "chapter": 88,
              "verse": 16,
              "name": "Mga Awit 88:16",
              "text": "Ang iyong mabangis na poot ay dumaan sa akin; inihiwalay ako ng iyong mga kakilakilabot na bagay."
            },
            {
              "chapter": 88,
              "verse": 17,
              "name": "Mga Awit 88:17",
              "text": "Kanilang kinulong ako na parang tubig buong araw; kinubkob ako nilang magkakasama."
            },
            {
              "chapter": 88,
              "verse": 18,
              "name": "Mga Awit 88:18",
              "text": "Mangliligaw at kaibigan ay inilayo mo sa akin, at ang aking kakilala ay sa dilim."
            }
          ]
        },
        {
          "chapter": 89,
          "name": "Mga Awit 89",
          "verses": [
            {
              "chapter": 89,
              "verse": 1,
              "name": "Mga Awit 89:1",
              "text": "Aking aawitin ang kagandahang-loob ng Panginoon magpakailan man: aking ipababatid ng aking bibig ang iyong pagtatapat sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 89,
              "verse": 2,
              "name": "Mga Awit 89:2",
              "text": "Sapagka't aking sinabi, Kaawaan ay matatayo magpakailan man: ang pagtatapat mo'y iyong itatatag sa mga kalangitlangitan."
            },
            {
              "chapter": 89,
              "verse": 3,
              "name": "Mga Awit 89:3",
              "text": "Ako'y nakipagtipan sa aking hirang, aking isinumpa kay David na aking lingkod;"
            },
            {
              "chapter": 89,
              "verse": 4,
              "name": "Mga Awit 89:4",
              "text": "Ang binhi mo'y itatatag ko magpakailan man, at aking itatayo ang luklukan mo sa lahat ng sali't saling lahi. (Selah)"
            },
            {
              "chapter": 89,
              "verse": 5,
              "name": "Mga Awit 89:5",
              "text": "At pupurihin ng langit ang iyong mga kababalaghan, Oh Panginoon; ang pagtatapat mo naman sa kapulungan ng mga banal."
            },
            {
              "chapter": 89,
              "verse": 6,
              "name": "Mga Awit 89:6",
              "text": "Sapagka't sino sa langit ang maitutulad sa Panginoon? Sino sa gitna ng mga anak ng makapangyarihan ang gaya ng Panginoon,"
            },
            {
              "chapter": 89,
              "verse": 7,
              "name": "Mga Awit 89:7",
              "text": "Isang Dios na kakilakilabot sa kapulungan ng mga banal, at kinatatakutan ng higit sa lahat na nangasa palibot niya?"
            },
            {
              "chapter": 89,
              "verse": 8,
              "name": "Mga Awit 89:8",
              "text": "Oh Panginoong Dios ng mga hukbo, sino ang makapangyarihang gaya mo, Oh JAH? At ang pagtatapat mo'y nasa palibot mo."
            },
            {
              "chapter": 89,
              "verse": 9,
              "name": "Mga Awit 89:9",
              "text": "Iyong pinagpupunuan ang kapalaluan sa dagat: pagka nagsisibangon ang mga alon niyaon ay pinatatahimik mo."
            },
            {
              "chapter": 89,
              "verse": 10,
              "name": "Mga Awit 89:10",
              "text": "Iyong pinagwaraywaray ang Rahab na parang napatay; iyong pinangalat ang iyong mga kaaway ng bisig ng iyong kalakasan."
            },
            {
              "chapter": 89,
              "verse": 11,
              "name": "Mga Awit 89:11",
              "text": "Ang langit ay iyo, ang lupa ay iyo rin: ang sanglibutan at ang buong narito ay iyong itinatag,"
            },
            {
              "chapter": 89,
              "verse": 12,
              "name": "Mga Awit 89:12",
              "text": "Ang hilagaan at ang timugan ay iyong nilikha; ang Tabor at ang Hermon ay nangagagalak sa iyong pangalan."
            },
            {
              "chapter": 89,
              "verse": 13,
              "name": "Mga Awit 89:13",
              "text": "Ikaw ay may makapangyarihang bisig: malakas ang iyong kamay, at mataas ang iyong kanang kamay."
            },
            {
              "chapter": 89,
              "verse": 14,
              "name": "Mga Awit 89:14",
              "text": "Katuwiran at kahatulan ay patibayan ng iyong luklukan: kagandahang-loob at katotohanan ay nagpapauna sa iyong mukha."
            },
            {
              "chapter": 89,
              "verse": 15,
              "name": "Mga Awit 89:15",
              "text": "Mapalad ang bayan na nakakaalam ng masayang tunog: sila'y nagsisilakad, Oh Panginoon, sa liwanag ng iyong mukha."
            },
            {
              "chapter": 89,
              "verse": 16,
              "name": "Mga Awit 89:16",
              "text": "Sa iyong pangalan ay nangagagalak sila buong araw: at sa iyong katuwiran ay nangatataas sila."
            },
            {
              "chapter": 89,
              "verse": 17,
              "name": "Mga Awit 89:17",
              "text": "Sapagka't ikaw ang kaluwalhatian ng kanilang kalakasan: at sa iyong lingap ay matataas ang aming sungay."
            },
            {
              "chapter": 89,
              "verse": 18,
              "name": "Mga Awit 89:18",
              "text": "Sapagka't ang aming kalasag ay ukol sa Panginoon; at ang aming hari ay sa banal ng Israel."
            },
            {
              "chapter": 89,
              "verse": 19,
              "name": "Mga Awit 89:19",
              "text": "Nang magkagayo'y nagsalita ka sa pangitain sa iyong mga banal, at iyong sinabi, Aking ipinagkatiwala ang saklolo sa isang makapangyarihan; Aking itinaas ang isang hirang mula sa bayan."
            },
            {
              "chapter": 89,
              "verse": 20,
              "name": "Mga Awit 89:20",
              "text": "Aking nasumpungan si David na aking lingkod; Aking pinahiran siya ng aking banal na langis:"
            },
            {
              "chapter": 89,
              "verse": 21,
              "name": "Mga Awit 89:21",
              "text": "Na siyang itatatag ng aking kamay; palakasin naman siya ng aking bisig."
            },
            {
              "chapter": 89,
              "verse": 22,
              "name": "Mga Awit 89:22",
              "text": "Hindi dadahas sa kaniya ang kaaway; ni dadalamhatiin man siya ng anak ng kasamaan."
            },
            {
              "chapter": 89,
              "verse": 23,
              "name": "Mga Awit 89:23",
              "text": "At ibubuwal ko ang kaniyang mga kaaway sa harap niya, at sasaktan ko ang nangagtatanim sa kaniya."
            },
            {
              "chapter": 89,
              "verse": 24,
              "name": "Mga Awit 89:24",
              "text": "Nguni't ang pagtatapat ko at ang kagandahang-loob ko ay sasa kaniya; at sa pangalan ko'y matataas ang kaniyang sungay."
            },
            {
              "chapter": 89,
              "verse": 25,
              "name": "Mga Awit 89:25",
              "text": "Akin namang ilalapag ang kaniyang kamay sa dagat, at ang kaniyang kanan ay sa mga ilog."
            },
            {
              "chapter": 89,
              "verse": 26,
              "name": "Mga Awit 89:26",
              "text": "Siya'y dadaing sa akin, Ikaw ay Ama ko, Dios ko, at malaking bato ng aking kaligtasan."
            },
            {
              "chapter": 89,
              "verse": 27,
              "name": "Mga Awit 89:27",
              "text": "Akin namang gagawin siyang panganay ko, na pinakamataas sa mga hari sa lupa."
            },
            {
              "chapter": 89,
              "verse": 28,
              "name": "Mga Awit 89:28",
              "text": "Ang kagandahang-loob ko'y aking iingatan sa kaniya magpakailan man, at ang tipan ko'y mananayong matibay sa kaniya."
            },
            {
              "chapter": 89,
              "verse": 29,
              "name": "Mga Awit 89:29",
              "text": "Ang kaniya namang binhi ay pananatilihin ko magpakailan man, at ang luklukan niya'y parang mga araw ng langit."
            },
            {
              "chapter": 89,
              "verse": 30,
              "name": "Mga Awit 89:30",
              "text": "Kung pabayaan ng kaniyang mga anak ang kautusan ko, at hindi magsilakad sa aking mga kahatulan;"
            },
            {
              "chapter": 89,
              "verse": 31,
              "name": "Mga Awit 89:31",
              "text": "Kung kanilang salangsangin ang mga palatuntunan ko, at hindi ingatan ang mga utos ko;"
            },
            {
              "chapter": 89,
              "verse": 32,
              "name": "Mga Awit 89:32",
              "text": "Kung magkagayo'y aking dadalawin ng pamalo ang kanilang mga pagsalangsang, at ng mga hampas ang kanilang kasamaan."
            },
            {
              "chapter": 89,
              "verse": 33,
              "name": "Mga Awit 89:33",
              "text": "Nguni't ang aking kagandahang-loob ay hindi ko lubos na aalisin sa kaniya, ni akin mang titiisin na ang pagtatapat ko'y magkulang."
            },
            {
              "chapter": 89,
              "verse": 34,
              "name": "Mga Awit 89:34",
              "text": "Ang tipan ko'y hindi ko sisirain, ni akin mang babaguhin ang bagay na lumabas sa aking mga labi."
            },
            {
              "chapter": 89,
              "verse": 35,
              "name": "Mga Awit 89:35",
              "text": "Minsan ay sumampa ako sa pamamagitan ng aking kabanalan. Hindi ako magbubulaan kay David;"
            },
            {
              "chapter": 89,
              "verse": 36,
              "name": "Mga Awit 89:36",
              "text": "Ang kaniyang binhi ay mananatili magpakailan man; at ang kaniyang luklukan ay parang araw sa harap ko."
            },
            {
              "chapter": 89,
              "verse": 37,
              "name": "Mga Awit 89:37",
              "text": "Matatatag magpakailan man na parang buwan, at tapat na saksi sa langit. (Selah)"
            },
            {
              "chapter": 89,
              "verse": 38,
              "name": "Mga Awit 89:38",
              "text": "Nguni't iyong itinakuwil at tinanggihan, ikaw ay napoot sa iyong pinahiran ng langis."
            },
            {
              "chapter": 89,
              "verse": 39,
              "name": "Mga Awit 89:39",
              "text": "Iyong kinayamutan ang tipan ng iyong lingkod: iyong nilapastangan ang kaniyang putong sa pagtatapon sa lupa."
            },
            {
              "chapter": 89,
              "verse": 40,
              "name": "Mga Awit 89:40",
              "text": "Iyong ibinuwal ang lahat niyang mga bakod: iyong dinala sa pagkaguho ang kaniyang mga katibayan."
            },
            {
              "chapter": 89,
              "verse": 41,
              "name": "Mga Awit 89:41",
              "text": "Lahat na nagsisidaan sa lansangan ay nagsisisamsam sa kaniya. Siya'y naging kadustaan sa kaniyang mga kalapit."
            },
            {
              "chapter": 89,
              "verse": 42,
              "name": "Mga Awit 89:42",
              "text": "Iyong itinaas ang kanan ng kaniyang mga kaaway; iyong pinagalak ang lahat niyang mga kaaway."
            },
            {
              "chapter": 89,
              "verse": 43,
              "name": "Mga Awit 89:43",
              "text": "Oo, iyong ibinaligtad ang talim ng kaniyang tabak, at hindi mo itinayo siya sa pakikibaka."
            },
            {
              "chapter": 89,
              "verse": 44,
              "name": "Mga Awit 89:44",
              "text": "Iyong pinapaglikat ang kaniyang kakinangan. At iyong ibinagsak ang kaniyang luklukan sa lupa."
            },
            {
              "chapter": 89,
              "verse": 45,
              "name": "Mga Awit 89:45",
              "text": "Iyong pinaikli ang mga kaarawan ng kaniyang kabinataan: iyong tinakpan siya ng kahihiyan. (Selah)"
            },
            {
              "chapter": 89,
              "verse": 46,
              "name": "Mga Awit 89:46",
              "text": "Hanggang kailan, Oh Panginoon, magkukubli ka magpakailan man? Hanggang kailan magniningas ang iyong poot na parang apoy?"
            },
            {
              "chapter": 89,
              "verse": 47,
              "name": "Mga Awit 89:47",
              "text": "Oh alalahanin mo kung gaano kaikli ang aking panahon: sa anong pagkawalang kabuluhan nilalang mo ang lahat ng mga anak ng mga tao."
            },
            {
              "chapter": 89,
              "verse": 48,
              "name": "Mga Awit 89:48",
              "text": "Sinong tao ang mabubuhay at hindi makakakita ng kamatayan, na magliligtas ng kaniyang kaluluwa sa kapangyarihan ng Sheol? (Selah)"
            },
            {
              "chapter": 89,
              "verse": 49,
              "name": "Mga Awit 89:49",
              "text": "Panginoon, saan nandoon ang iyong dating mga kagandahang-loob, na iyong isinumpa kay David sa iyong pagtatapat?"
            },
            {
              "chapter": 89,
              "verse": 50,
              "name": "Mga Awit 89:50",
              "text": "Alalahanin mo Panginoon, ang kadustaan ng iyong mga lingkod; kung paanong taglay ko sa aking sinapupunan ang pagdusta ng lahat na makapangyarihang bayan;"
            },
            {
              "chapter": 89,
              "verse": 51,
              "name": "Mga Awit 89:51",
              "text": "Na idinusta ng iyong mga kaaway, Oh Panginoon, na kanilang idinusta sa mga bakas ng iyong pinahiran ng langis."
            },
            {
              "chapter": 89,
              "verse": 52,
              "name": "Mga Awit 89:52",
              "text": "Purihin ang Panginoon, magpakailan man. Siya nawa, at Siya nawa."
            }
          ]
        },
        {
          "chapter": 90,
          "name": "Mga Awit 90",
          "verses": [
            {
              "chapter": 90,
              "verse": 1,
              "name": "Mga Awit 90:1",
              "text": "Panginoon, ikaw ay naging tahanang dako namin sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 90,
              "verse": 2,
              "name": "Mga Awit 90:2",
              "text": "Bago nalabas ang mga bundok, O bago mo nilikha ang lupa at ang sanglibutan, mula nga ng walang pasimula hanggang sa walang hanggan, ikaw ang Dios."
            },
            {
              "chapter": 90,
              "verse": 3,
              "name": "Mga Awit 90:3",
              "text": "Iyong pinapagiging kapahamakan ang tao; at iyong sinasabi, Magsipanumbalik kayo, kayong mga anak ng mga tao."
            },
            {
              "chapter": 90,
              "verse": 4,
              "name": "Mga Awit 90:4",
              "text": "Sapagka't isang libong taon sa iyong paningin ay parang kahapon lamang nang makaraan, at parang pagpupuyat sa gabi."
            },
            {
              "chapter": 90,
              "verse": 5,
              "name": "Mga Awit 90:5",
              "text": "Iyong dinadala sila na parang baha; sila'y parang pagkakatulog: sa kinaumagahan ay parang damo sila na tumutubo."
            },
            {
              "chapter": 90,
              "verse": 6,
              "name": "Mga Awit 90:6",
              "text": "Sa kinaumagahan ay namumulaklak at lumalago; sa kinahapunan ay pinuputol at natutuyo."
            },
            {
              "chapter": 90,
              "verse": 7,
              "name": "Mga Awit 90:7",
              "text": "Sapagka't kami ay nangasupok sa iyong galit, at sa iyong poot ay nangabagabag kami."
            },
            {
              "chapter": 90,
              "verse": 8,
              "name": "Mga Awit 90:8",
              "text": "Iyong inilagay ang aming kasamaan sa harap mo, ang aming lihim na mga kasalanan sa liwanag ng iyong mukha."
            },
            {
              "chapter": 90,
              "verse": 9,
              "name": "Mga Awit 90:9",
              "text": "Sapagka't lahat naming kaarawan ay dumaan sa iyong poot: aming niwawakasan ang aming mga taon na parang isang buntong hininga."
            },
            {
              "chapter": 90,
              "verse": 10,
              "name": "Mga Awit 90:10",
              "text": "Ang mga kaarawan ng aming mga taon ay pitong pung taon, o kung dahil sa kalakasan ay umaabot ng walong pung taon; gayon ma'y ang kanilang kapalaluan ay hirap at kapanglawan lamang; sapagka't madaling napapawi, at kami ay nagsisilipad."
            },
            {
              "chapter": 90,
              "verse": 11,
              "name": "Mga Awit 90:11",
              "text": "Sinong nakakaalam ng kapangyarihan ng iyong galit, at ng iyong poot ayon sa katakutan na marapat sa iyo?"
            },
            {
              "chapter": 90,
              "verse": 12,
              "name": "Mga Awit 90:12",
              "text": "Kaya ituro mo sa amin ang pagbilang ng aming mga kaarawan, upang kami ay mangagtamo sa amin ng pusong may karunungan."
            },
            {
              "chapter": 90,
              "verse": 13,
              "name": "Mga Awit 90:13",
              "text": "Manumbalik ka, Oh Panginoon; hanggang kailan pa? At iyong papagsisihin ang tungkol sa mga lingkod mo."
            },
            {
              "chapter": 90,
              "verse": 14,
              "name": "Mga Awit 90:14",
              "text": "Oh busugin mo kami sa kinaumagahan ng iyong kagandahang-loob; upang kami ay mangagalak at mangatuwa sa lahat ng kaarawan namin."
            },
            {
              "chapter": 90,
              "verse": 15,
              "name": "Mga Awit 90:15",
              "text": "Pasayahin mo kami ayon sa mga kaarawan na iyong idinalamhati sa amin, at sa mga taon na aming ikinakita ng kasamaan."
            },
            {
              "chapter": 90,
              "verse": 16,
              "name": "Mga Awit 90:16",
              "text": "Mahayag nawa ang iyong gawa sa iyong mga lingkod, at ang kaluwalhatian mo sa kanilang mga anak."
            },
            {
              "chapter": 90,
              "verse": 17,
              "name": "Mga Awit 90:17",
              "text": "At sumaamin nawa ang kagandahan ng Panginoong aming Dios: at iyong itatag sa amin ang gawa ng aming mga kamay; Oo, ang gawa ng aming mga kamay ay itatag mo."
            }
          ]
        },
        {
          "chapter": 91,
          "name": "Mga Awit 91",
          "verses": [
            {
              "chapter": 91,
              "verse": 1,
              "name": "Mga Awit 91:1",
              "text": "Siyang tumatahan sa lihim na dako ng Kataastaasan. Ay mananatili sa lilim ng Makapangyarihan sa lahat."
            },
            {
              "chapter": 91,
              "verse": 2,
              "name": "Mga Awit 91:2",
              "text": "Aking sasabihin tungkol sa Panginoon, siya'y aking kanlungan at aking katibayan, ang Dios ko na siyang aking tinitiwalaan."
            },
            {
              "chapter": 91,
              "verse": 3,
              "name": "Mga Awit 91:3",
              "text": "Sapagka't kaniyang ililigtas ka sa silo ng paninilo, at sa mapamuksang salot."
            },
            {
              "chapter": 91,
              "verse": 4,
              "name": "Mga Awit 91:4",
              "text": "Kaniyang tatakpan ka ng kaniyang mga bagwis, at sa ilalim ng kaniyang mga pakpak ay manganganlong ka: ang kaniyang katotohanan ay kalasag at baluti."
            },
            {
              "chapter": 91,
              "verse": 5,
              "name": "Mga Awit 91:5",
              "text": "Ikaw ay hindi matatakot sa kakilabutan sa gabi, ni sa pana man na humihilagpos kung araw;"
            },
            {
              "chapter": 91,
              "verse": 6,
              "name": "Mga Awit 91:6",
              "text": "Dahil sa salot na dumarating sa kadiliman, ni dahil sa paggiba man na sumisira sa katanghaliang tapat."
            },
            {
              "chapter": 91,
              "verse": 7,
              "name": "Mga Awit 91:7",
              "text": "Isang libo ay mabubuwal sa iyong siping, at sangpung libo sa iyong kanan; nguni't hindi lalapit sa iyo."
            },
            {
              "chapter": 91,
              "verse": 8,
              "name": "Mga Awit 91:8",
              "text": "Iyong mamamasdan lamang ng iyong mga mata, at iyong makikita ang ganti sa masama."
            },
            {
              "chapter": 91,
              "verse": 9,
              "name": "Mga Awit 91:9",
              "text": "Sapagka't ikaw, Oh Panginoon, ay aking kanlungan! Iyong ginawa ang Kataastaasan na iyong tahanan;"
            },
            {
              "chapter": 91,
              "verse": 10,
              "name": "Mga Awit 91:10",
              "text": "Walang kasamaang mangyayari sa iyo, ni anomang salot ay lalapit sa iyong tolda."
            },
            {
              "chapter": 91,
              "verse": 11,
              "name": "Mga Awit 91:11",
              "text": "Sapagka't siya'y magbibilin sa kaniyang mga anghel tungkol sa iyo, upang ingatan ka sa lahat ng iyong mga lakad."
            },
            {
              "chapter": 91,
              "verse": 12,
              "name": "Mga Awit 91:12",
              "text": "Kanilang dadalhin ka sa kanilang mga kamay, baka matisod ka ng iyong paa sa isang bato."
            },
            {
              "chapter": 91,
              "verse": 13,
              "name": "Mga Awit 91:13",
              "text": "Iyong yayapakan ang leon at ang ulupong: ang batang leon at ang ahas ay yuyurakan mo ng iyong mga paa."
            },
            {
              "chapter": 91,
              "verse": 14,
              "name": "Mga Awit 91:14",
              "text": "Sapagka't kaniyang inilagak ang kaniyang pagibig sa akin, kaya't iniligtas ko siya: aking ilalagay siya sa mataas, sapagka't kaniyang naalaman ang pangalan ko."
            },
            {
              "chapter": 91,
              "verse": 15,
              "name": "Mga Awit 91:15",
              "text": "Siya'y tatawag sa akin, at sasagutin ko siya; ako'y sasa kaniya sa kabagabagan: aking ililigtas siya, at pararangalan siya."
            },
            {
              "chapter": 91,
              "verse": 16,
              "name": "Mga Awit 91:16",
              "text": "Aking bubusugin siya ng mahabang buhay, at ipakikita ko sa kaniya ang aking pagliligtas."
            }
          ]
        },
        {
          "chapter": 92,
          "name": "Mga Awit 92",
          "verses": [
            {
              "chapter": 92,
              "verse": 1,
              "name": "Mga Awit 92:1",
              "text": "Isang mabuting bagay ang magpapasalamat sa Panginoon, at umawit ng mga pagpuri sa iyong pangalan, Oh Kataastaasan:"
            },
            {
              "chapter": 92,
              "verse": 2,
              "name": "Mga Awit 92:2",
              "text": "Upang magpakilala ng iyong kagandahang-loob sa umaga, at ng iyong pagtatapat gabigabi."
            },
            {
              "chapter": 92,
              "verse": 3,
              "name": "Mga Awit 92:3",
              "text": "Na may panugtog na may sangpung kawad, at may salterio; na may dakilang tunog na alpa."
            },
            {
              "chapter": 92,
              "verse": 4,
              "name": "Mga Awit 92:4",
              "text": "Sapagka't ikaw, Panginoon, iyong pinasaya ako sa iyong gawa: ako'y magtatagumpay sa mga gawa ng iyong mga kamay."
            },
            {
              "chapter": 92,
              "verse": 5,
              "name": "Mga Awit 92:5",
              "text": "Kay dakila ng iyong mga gawa, Oh Panginoon! Ang iyong mga pagiisip ay totoong malalim."
            },
            {
              "chapter": 92,
              "verse": 6,
              "name": "Mga Awit 92:6",
              "text": "Ang taong hangal ay hindi nakakaalam; ni nauunawa man ito ng mangmang."
            },
            {
              "chapter": 92,
              "verse": 7,
              "name": "Mga Awit 92:7",
              "text": "Pagka ang masama ay lumilitaw na parang damo, at pagka gumiginhawa ang lahat na manggagawa ng kasamaan; ay upang mangalipol sila magpakailan man:"
            },
            {
              "chapter": 92,
              "verse": 8,
              "name": "Mga Awit 92:8",
              "text": "Nguni't ikaw, Oh Panginoon, ay mataas magpakailan man."
            },
            {
              "chapter": 92,
              "verse": 9,
              "name": "Mga Awit 92:9",
              "text": "Sapagka't, narito, ang mga kaaway mo, Oh Panginoon, sapagka't, narito, ang mga kaaway mo'y malilipol; lahat ng mga manggagawa ng kasamaan ay mangangalat."
            },
            {
              "chapter": 92,
              "verse": 10,
              "name": "Mga Awit 92:10",
              "text": "Nguni't ang sungay ko'y iyong pinataas na parang sungay ng mailap na toro: ako'y napahiran ng bagong langis."
            },
            {
              "chapter": 92,
              "verse": 11,
              "name": "Mga Awit 92:11",
              "text": "Nakita naman ng aking mata ang nasa ko sa aking mga kaaway, narinig ng aking pakinig ang nasa ko sa mga manggagawa ng kasamaan na nagsisibangon laban sa akin."
            },
            {
              "chapter": 92,
              "verse": 12,
              "name": "Mga Awit 92:12",
              "text": "Ang matuwid ay giginhawa na parang puno ng palma. Siya'y tutubo na parang cedro sa Libano."
            },
            {
              "chapter": 92,
              "verse": 13,
              "name": "Mga Awit 92:13",
              "text": "Sila'y nangatatag sa bahay ng Panginoon; sila'y giginhawa sa mga looban ng aming Dios."
            },
            {
              "chapter": 92,
              "verse": 14,
              "name": "Mga Awit 92:14",
              "text": "Sila'y mangagbubunga sa katandaan; sila'y mapupuspos ng katas at kasariwaan:"
            },
            {
              "chapter": 92,
              "verse": 15,
              "name": "Mga Awit 92:15",
              "text": "Upang ipakilala na ang Panginoon ay matuwid; siya'y aking malaking bato, at walang kalikuan sa kaniya."
            }
          ]
        },
        {
          "chapter": 93,
          "name": "Mga Awit 93",
          "verses": [
            {
              "chapter": 93,
              "verse": 1,
              "name": "Mga Awit 93:1",
              "text": "Ang Panginoon ay naghahari; siya'y nananamit ng karilagan; ang Panginoon ay nananamit ng kalakasan; siya'y nagbigkis niyaon: ang sanglibutan naman ay natatag, na hindi mababago."
            },
            {
              "chapter": 93,
              "verse": 2,
              "name": "Mga Awit 93:2",
              "text": "Ang luklukan mo'y natatag ng una: ikaw ay mula sa walang pasimula."
            },
            {
              "chapter": 93,
              "verse": 3,
              "name": "Mga Awit 93:3",
              "text": "Ang mga baha ay nagtaas, Oh Panginoon, ang mga baha ay nagtaas ng kanilang hugong; ang mga baha ay nagtaas ng kanilang mga alon."
            },
            {
              "chapter": 93,
              "verse": 4,
              "name": "Mga Awit 93:4",
              "text": "Ng higit sa mga hugong ng maraming tubig, malalakas na hampas ng alon sa dagat, ang Panginoon sa itaas ay makapangyarihan."
            },
            {
              "chapter": 93,
              "verse": 5,
              "name": "Mga Awit 93:5",
              "text": "Ang iyong mga patotoo ay totoong tunay: ang kabanalan ay nararapat sa iyong bahay, Oh Panginoon, magpakailan man."
            }
          ]
        },
        {
          "chapter": 94,
          "name": "Mga Awit 94",
          "verses": [
            {
              "chapter": 94,
              "verse": 1,
              "name": "Mga Awit 94:1",
              "text": "Oh Panginoon, ikaw na Dios na kinauukulan ng panghihiganti, ikaw na Dios na kinauukulan ng panghihiganti, sumilang ka."
            },
            {
              "chapter": 94,
              "verse": 2,
              "name": "Mga Awit 94:2",
              "text": "Bumangon ka, ikaw na hukom ng lupa: ibigay mo sa palalo ang panghihiganti sa kanila."
            },
            {
              "chapter": 94,
              "verse": 3,
              "name": "Mga Awit 94:3",
              "text": "Panginoon, hanggang kailan ang masama, hanggang kailan magtatagumpay ang masama?"
            },
            {
              "chapter": 94,
              "verse": 4,
              "name": "Mga Awit 94:4",
              "text": "Sila'y dumadaldal, sila'y nagsasalita na may kapalaluan: lahat na manggagawa ng kasamaan ay nangagmamalaki."
            },
            {
              "chapter": 94,
              "verse": 5,
              "name": "Mga Awit 94:5",
              "text": "Kanilang pinagwawaraywaray ang iyong bayan, Oh Panginoon, at dinadalamhati ang iyong mana."
            },
            {
              "chapter": 94,
              "verse": 6,
              "name": "Mga Awit 94:6",
              "text": "Kanilang pinapatay ang bao at ang taga ibang lupa, at pinapatay ang ulila."
            },
            {
              "chapter": 94,
              "verse": 7,
              "name": "Mga Awit 94:7",
              "text": "At kanilang sinasabi, ang Panginoo'y hindi makakakita, ni pakukundanganan man ng Dios ni Jacob ito."
            },
            {
              "chapter": 94,
              "verse": 8,
              "name": "Mga Awit 94:8",
              "text": "Gunitain ninyo, ninyong mga hangal sa gitna ng bayan: at ninyong mga mangmang, kailan tayo magiging pantas?"
            },
            {
              "chapter": 94,
              "verse": 9,
              "name": "Mga Awit 94:9",
              "text": "Siyang lumikha ng pakinig, hindi ba siya makakarinig? Siyang lumikha ng mata, hindi ba siya makakakita?"
            },
            {
              "chapter": 94,
              "verse": 10,
              "name": "Mga Awit 94:10",
              "text": "Siyang nagpaparusa sa mga bansa, hindi ba siya sasaway, sa makatuwid baga'y siyang nagtuturo sa tao ng kaalaman?"
            },
            {
              "chapter": 94,
              "verse": 11,
              "name": "Mga Awit 94:11",
              "text": "Nalalaman ng Panginoon ang mga pagiisip ng tao, na sila'y pawang walang kabuluhan."
            },
            {
              "chapter": 94,
              "verse": 12,
              "name": "Mga Awit 94:12",
              "text": "Mapalad ang tao na iyong pinarurusahan, Oh Panginoon, at tinuturuan mo sa iyong kautusan."
            },
            {
              "chapter": 94,
              "verse": 13,
              "name": "Mga Awit 94:13",
              "text": "Upang iyong mabigyan ng kapahingahan sa mga kaarawan ng kasakunaan, hanggang sa mahukay ang hukay na ukol sa masama."
            },
            {
              "chapter": 94,
              "verse": 14,
              "name": "Mga Awit 94:14",
              "text": "Sapagka't hindi itatakuwil ng Panginoon ang kaniyang bayan, ni pababayaan man niya ang kaniyang mana."
            },
            {
              "chapter": 94,
              "verse": 15,
              "name": "Mga Awit 94:15",
              "text": "Sapagka't kahatulan ay babalik sa katuwiran: at susundan ng lahat na matuwid sa puso."
            },
            {
              "chapter": 94,
              "verse": 16,
              "name": "Mga Awit 94:16",
              "text": "Sino ang babangon dahil sa akin laban sa mga manggagawa ng kasamaan? Sinong tatayo dahil sa akin laban sa mga manggagawa ng kasamaan?"
            },
            {
              "chapter": 94,
              "verse": 17,
              "name": "Mga Awit 94:17",
              "text": "Kundi ang Panginoon ay naging aking katulong, ang kaluluwa ko'y tumahang madali sana sa katahimikan."
            },
            {
              "chapter": 94,
              "verse": 18,
              "name": "Mga Awit 94:18",
              "text": "Nang aking sabihin, Ang aking paa ay natitisod; inalalayan ako ng iyong kagandahang-loob, Oh Panginoon."
            },
            {
              "chapter": 94,
              "verse": 19,
              "name": "Mga Awit 94:19",
              "text": "Sa karamihan ng aking mga pagiisip sa loob ko ang iyong mga pagaliw ay nagbibigay lugod sa aking kaluluwa."
            },
            {
              "chapter": 94,
              "verse": 20,
              "name": "Mga Awit 94:20",
              "text": "Makikisama ba sa iyo ang luklukan ng kasamaan, na nagaanyo ng pagapi sa pamamagitan ng palatuntunan?"
            },
            {
              "chapter": 94,
              "verse": 21,
              "name": "Mga Awit 94:21",
              "text": "Sila'y nagpipisan laban sa kaluluwa ng matuwid, at pinarusahan nila ang walang salang dugo."
            },
            {
              "chapter": 94,
              "verse": 22,
              "name": "Mga Awit 94:22",
              "text": "Nguni't ang Panginoon ay naging aking matayog na moog; at ang Dios ko'y malaking bato na aking kanlungan."
            },
            {
              "chapter": 94,
              "verse": 23,
              "name": "Mga Awit 94:23",
              "text": "At dinala niya sa kanila ang kanilang sariling kasamaan, at ihihiwalay niya sila sa kanilang sariling kasamaan; ihihiwalay sila ng Panginoon naming Dios."
            }
          ]
        },
        {
          "chapter": 95,
          "name": "Mga Awit 95",
          "verses": [
            {
              "chapter": 95,
              "verse": 1,
              "name": "Mga Awit 95:1",
              "text": "Oh magsiparito kayo, tayo'y magsiawit sa Panginoon: tayo'y magkaingay na may kagalakan sa malaking bato na ating kaligtasan."
            },
            {
              "chapter": 95,
              "verse": 2,
              "name": "Mga Awit 95:2",
              "text": "Tayo'y magsiharap sa kaniyang harapan na may pagpapasalamat, tayo'y magkaingay na may kagalakan sa kaniya na may mga pagaawitan."
            },
            {
              "chapter": 95,
              "verse": 3,
              "name": "Mga Awit 95:3",
              "text": "Sapagka't ang Panginoon ay dakilang Dios, at dakilang Hari sa lahat ng mga dios,"
            },
            {
              "chapter": 95,
              "verse": 4,
              "name": "Mga Awit 95:4",
              "text": "Na sa kaniyang kamay ang mga malalim na dako ng lupa, ang mga kataasan ng mga bundok ay kaniya rin."
            },
            {
              "chapter": 95,
              "verse": 5,
              "name": "Mga Awit 95:5",
              "text": "Ang dagat ay kaniya, at kaniyang ginawa: at ang kaniyang mga kamay ay lumikha ng tuyong lupa."
            },
            {
              "chapter": 95,
              "verse": 6,
              "name": "Mga Awit 95:6",
              "text": "Oh magsiparito kayo, tayo'y magsisamba at magsiyukod; tayo'y magsiluhod sa harap ng Panginoon na May-lalang sa atin."
            },
            {
              "chapter": 95,
              "verse": 7,
              "name": "Mga Awit 95:7",
              "text": "Sapagka't siya'y ating Dios, at tayo'y bayan ng kaniyang pastulan, at mga tupa ng kaniyang kamay. Ngayon, kung inyong didinggin ang kaniyang tinig!"
            },
            {
              "chapter": 95,
              "verse": 8,
              "name": "Mga Awit 95:8",
              "text": "Huwag ninyong papagmatigasin ang inyong puso, gaya sa Meriba, gaya sa kaarawan ng Masa sa ilang:"
            },
            {
              "chapter": 95,
              "verse": 9,
              "name": "Mga Awit 95:9",
              "text": "Nang tuksuhin ako ng inyong mga magulang, tinikman ako, at nakita ang gawa ko."
            },
            {
              "chapter": 95,
              "verse": 10,
              "name": "Mga Awit 95:10",
              "text": "Apat na pung taong namanglaw ako sa lahing yaon, at aking sinabi, Bayan na nagkakamali sa kanilang puso. At hindi naalaman ang aking mga daan:"
            },
            {
              "chapter": 95,
              "verse": 11,
              "name": "Mga Awit 95:11",
              "text": "Kaya't ako'y sumumpa sa aking poot, na sila'y hindi magsisipasok sa aking kapahingahan."
            }
          ]
        },
        {
          "chapter": 96,
          "name": "Mga Awit 96",
          "verses": [
            {
              "chapter": 96,
              "verse": 1,
              "name": "Mga Awit 96:1",
              "text": "Oh magsiawit kayo sa Panginoon ng bagong awit: magsiawit kayo sa Panginoon, buong lupa."
            },
            {
              "chapter": 96,
              "verse": 2,
              "name": "Mga Awit 96:2",
              "text": "Magsiawit kayo sa Panginoon, purihin ninyo ang pangalan niya; ihayag ninyo ang kaniyang pagliligtas sa araw-araw."
            },
            {
              "chapter": 96,
              "verse": 3,
              "name": "Mga Awit 96:3",
              "text": "Ipahayag ninyo ang kaniyang kaluwalhatian sa mga bansa ang kagilagilalas niyang mga gawa sa lahat ng mga bayan."
            },
            {
              "chapter": 96,
              "verse": 4,
              "name": "Mga Awit 96:4",
              "text": "Sapagka't dakila ang Panginoon, at marapat na purihin: siya'y kinatatakutang higit kay sa lahat na dios."
            },
            {
              "chapter": 96,
              "verse": 5,
              "name": "Mga Awit 96:5",
              "text": "Sapagka't lahat ng mga dios sa mga bayan ay mga diosdiosan. Nguni't nilikha ng Panginoon ang langit."
            },
            {
              "chapter": 96,
              "verse": 6,
              "name": "Mga Awit 96:6",
              "text": "Karangalan at kamahalan ay nasa harap niya: kalakasan at kagandahan ay nasa kaniyang santuario."
            },
            {
              "chapter": 96,
              "verse": 7,
              "name": "Mga Awit 96:7",
              "text": "Magbigay kayo sa Panginoon, kayong mga angkan ng mga bayan, magbigay kayo sa Panginoon ng kaluwalhatian at kalakasan."
            },
            {
              "chapter": 96,
              "verse": 8,
              "name": "Mga Awit 96:8",
              "text": "Magbigay kayo sa Panginoon ng kaluwalhatiang ukol sa kaniyang pangalan; kayo'y mangagdala ng handog, at magsipasok kayo sa kaniyang mga looban."
            },
            {
              "chapter": 96,
              "verse": 9,
              "name": "Mga Awit 96:9",
              "text": "Oh sambahin ninyo ang Panginoon sa kagandahan ng kabanalan: manginig kayo sa harap niya, buong lupa."
            },
            {
              "chapter": 96,
              "verse": 10,
              "name": "Mga Awit 96:10",
              "text": "Sabihin ninyo sa gitna ng mga bansa, ang Panginoon ay naghahari: ang sanglibutan naman ay natatatag na hindi makikilos: kaniyang hahatulan ng karapatan ang mga bayan."
            },
            {
              "chapter": 96,
              "verse": 11,
              "name": "Mga Awit 96:11",
              "text": "Matuwa ang langit at magalak ang lupa; humugong ang dagat, at ang buong naroon;"
            },
            {
              "chapter": 96,
              "verse": 12,
              "name": "Mga Awit 96:12",
              "text": "Sumaya ang bukiran at lahat na nasa kaniya; kung magkagayo'y aawit dahil sa kagalakan, ang lahat na punong kahoy sa gubat;"
            },
            {
              "chapter": 96,
              "verse": 13,
              "name": "Mga Awit 96:13",
              "text": "Sa harap ng Panginoon; sapagka't siya'y dumarating: sapagka't siya'y dumarating upang hatulan ang lupa: kaniyang hahatulan ng katuwiran ang sanglibutan, at ng kaniyang katotohanan ang mga bayan."
            }
          ]
        },
        {
          "chapter": 97,
          "name": "Mga Awit 97",
          "verses": [
            {
              "chapter": 97,
              "verse": 1,
              "name": "Mga Awit 97:1",
              "text": "Ang Panginoon ay naghahari; magalak ang lupa; matuwa ang karamihan ng mga pulo."
            },
            {
              "chapter": 97,
              "verse": 2,
              "name": "Mga Awit 97:2",
              "text": "Mga ulap at kadiliman ay nasa palibot niya: katuwiran at kahatulan ay patibayin ng kaniyang luklukan."
            },
            {
              "chapter": 97,
              "verse": 3,
              "name": "Mga Awit 97:3",
              "text": "Apoy ay nagpapauna sa kaniya, at sinusunog ang kaniyang kaaway sa buong palibot."
            },
            {
              "chapter": 97,
              "verse": 4,
              "name": "Mga Awit 97:4",
              "text": "Tumatanglaw ang mga kidlat niya sa sanglibutan: nakita ng lupa, at niyanig."
            },
            {
              "chapter": 97,
              "verse": 5,
              "name": "Mga Awit 97:5",
              "text": "Ang mga bundok ay natunaw na parang pagkit sa harap ng Panginoon, sa harapan ng Panginoon ng buong lupa."
            },
            {
              "chapter": 97,
              "verse": 6,
              "name": "Mga Awit 97:6",
              "text": "Ipinahahayag ng langit ang kaniyang katuwiran, at nakita ng lahat na bayan ang kaniyang kaluwalhatian."
            },
            {
              "chapter": 97,
              "verse": 7,
              "name": "Mga Awit 97:7",
              "text": "Mangahiya silang lahat na nangaglilingkod sa mga larawan, nangaghahambog tungkol sa mga diosdiosan: kayo'y magsisamba sa kaniya kayong lahat na mga dios."
            },
            {
              "chapter": 97,
              "verse": 8,
              "name": "Mga Awit 97:8",
              "text": "Narinig ng Sion, at natuwa, at ang mga anak na babae ng Juda ay nangagalak; dahil sa iyong mga kahatulan, Oh Panginoon."
            },
            {
              "chapter": 97,
              "verse": 9,
              "name": "Mga Awit 97:9",
              "text": "Sapagka't ikaw, Oh Panginoon, ay kataastaasan sa buong lupa: ikaw ay nataas na totoong higit kay sa lahat na mga dios."
            },
            {
              "chapter": 97,
              "verse": 10,
              "name": "Mga Awit 97:10",
              "text": "Oh kayong nagsisiibig sa Panginoon, ipagtanim ninyo ang kasamaan. Kaniyang iniingatan ang mga kaluluwa ng kaniyang mga banal; kaniyang iniligtas sila sa kamay ng masama."
            },
            {
              "chapter": 97,
              "verse": 11,
              "name": "Mga Awit 97:11",
              "text": "Liwanag ang itinanim na ukol sa mga banal, at kasayahan ay sa may matuwid na puso."
            },
            {
              "chapter": 97,
              "verse": 12,
              "name": "Mga Awit 97:12",
              "text": "Mangatuwa kayo sa Panginoon, kayong mga matuwid; at mangagpasalamat sa kaniyang banal na pangalan."
            }
          ]
        },
        {
          "chapter": 98,
          "name": "Mga Awit 98",
          "verses": [
            {
              "chapter": 98,
              "verse": 1,
              "name": "Mga Awit 98:1",
              "text": "Oh magsiawit kayo sa Panginoon ng bagong awit; sapagka't siya'y gumawa ng mga kagilagilalas na bagay: ang kaniyang kanan at ang kaniyang banal na bisig ay gumawa ng kaligtasan para sa kaniya:"
            },
            {
              "chapter": 98,
              "verse": 2,
              "name": "Mga Awit 98:2",
              "text": "Ipinakilala ng Panginoon ang kaniyang pagliligtas: ang kaniyang katuwiran ay ipinakilala niyang lubos sa paningin ng mga bansa."
            },
            {
              "chapter": 98,
              "verse": 3,
              "name": "Mga Awit 98:3",
              "text": "Kaniyang inalaala ang kaniyang kagandahang-loob at ang kaniyang pagtatapat sa bahay ng Israel: nakita ng lahat ng mga wakas ng lupa ang pagliligtas ng aming Dios."
            },
            {
              "chapter": 98,
              "verse": 4,
              "name": "Mga Awit 98:4",
              "text": "Magkaingay kayo na may kagalakan sa Panginoon, buong lupa. Mangagpasimula at magsiawit dahil sa kagalakan, oo, magsiawit kayo ng mga pagpuri."
            },
            {
              "chapter": 98,
              "verse": 5,
              "name": "Mga Awit 98:5",
              "text": "Magsiawit kayo sa Panginoon ng mga pagpuri ng alpa; ng alpa at ng tinig na tugma."
            },
            {
              "chapter": 98,
              "verse": 6,
              "name": "Mga Awit 98:6",
              "text": "Ng mga pakakak at tunog ng corneta magkaingay kayo na may kagalakan sa harap ng Hari, ng Panginoon."
            },
            {
              "chapter": 98,
              "verse": 7,
              "name": "Mga Awit 98:7",
              "text": "Humugong ang dagat at ang buong naroon; ang sanglibutan at ang nagsisitahan doon;"
            },
            {
              "chapter": 98,
              "verse": 8,
              "name": "Mga Awit 98:8",
              "text": "Ipakpak ng mga baha ang kanilang mga kamay; magawitan ang mga burol dahil sa kagalakan;"
            },
            {
              "chapter": 98,
              "verse": 9,
              "name": "Mga Awit 98:9",
              "text": "Sa harap ng Panginoon, sapagka't siya'y dumarating upang hatulan ang lupa: kaniyang hahatulan ng katuwiran ang sanglibutan, at ng karapatan ang mga bayan."
            }
          ]
        },
        {
          "chapter": 99,
          "name": "Mga Awit 99",
          "verses": [
            {
              "chapter": 99,
              "verse": 1,
              "name": "Mga Awit 99:1",
              "text": "Ang Panginoon ay naghahari: manginig ang mga bayan. Siya'y nauupo sa mga querubin; makilos ang lupa."
            },
            {
              "chapter": 99,
              "verse": 2,
              "name": "Mga Awit 99:2",
              "text": "Ang Panginoon ay dakila sa Sion; at siya'y mataas na higit sa lahat ng mga bayan."
            },
            {
              "chapter": 99,
              "verse": 3,
              "name": "Mga Awit 99:3",
              "text": "Purihin nila ang iyong dakila at kakilakilabot na pangalan: siya'y banal."
            },
            {
              "chapter": 99,
              "verse": 4,
              "name": "Mga Awit 99:4",
              "text": "Ang lakas naman ng hari ay umiibig ng kahatulan; ikaw ay nagtatatag ng karampatan, ikaw ay nagsasagawa ng kahatulan at katuwiran sa Jacob."
            },
            {
              "chapter": 99,
              "verse": 5,
              "name": "Mga Awit 99:5",
              "text": "Ibunyi ninyo ang Panginoon nating Dios, at magsisamba kayo sa harap ng kaniyang tungtungan; siya'y banal."
            },
            {
              "chapter": 99,
              "verse": 6,
              "name": "Mga Awit 99:6",
              "text": "Si Moises at si Aaron sa gitna ng kaniyang mga saserdote, at si Samuel sa kanila na nagsisitawag sa kaniyang pangalan; sila'y nagsisitawag sa Panginoon, at siya'y sumasagot sa kanila."
            },
            {
              "chapter": 99,
              "verse": 7,
              "name": "Mga Awit 99:7",
              "text": "Siya'y nagsasalita sa kanila sa haliging ulap: kanilang iniingatan ang kaniyang mga patotoo, at ang palatuntunan na ibinigay niya sa kanila."
            },
            {
              "chapter": 99,
              "verse": 8,
              "name": "Mga Awit 99:8",
              "text": "Sumagot ka sa kanila, Oh Panginoon naming Dios; ikaw ay Dios na nagpatawad sa kanila, bagaman nanghiganti ka sa kanilang mga gawa."
            },
            {
              "chapter": 99,
              "verse": 9,
              "name": "Mga Awit 99:9",
              "text": "Ibunyi ninyo ang Panginoon nating Dios, at magsisamba kayo sa kaniyang banal na bundok; sapagka't ang Panginoon nating Dios ay banal."
            }
          ]
        },
        {
          "chapter": 100,
          "name": "Mga Awit 100",
          "verses": [
            {
              "chapter": 100,
              "verse": 1,
              "name": "Mga Awit 100:1",
              "text": "Magkaingay kayo na may kagalakan sa Panginoon, kayong lahat na lupain."
            },
            {
              "chapter": 100,
              "verse": 2,
              "name": "Mga Awit 100:2",
              "text": "Mangaglingkod kayo na may kasayahan sa Panginoon; magsilapit kayo sa kaniyang harapan na may awitan."
            },
            {
              "chapter": 100,
              "verse": 3,
              "name": "Mga Awit 100:3",
              "text": "Alamin ninyo na ang Panginoon ay siyang Dios; siya ang lumalang sa atin, at tayo'y kaniya: tayo'y kaniyang bayan, at mga tupa ng kaniyang pastulan."
            },
            {
              "chapter": 100,
              "verse": 4,
              "name": "Mga Awit 100:4",
              "text": "Magsipasok kayo sa kaniyang mga pintuang-daan na may pagpapasalamat, at sa kaniyang looban na may pagpupuri: mangagpasalamat kayo sa kaniya, at purihin ninyo ang kaniyang pangalan."
            },
            {
              "chapter": 100,
              "verse": 5,
              "name": "Mga Awit 100:5",
              "text": "Sapagka't ang Panginoon ay mabuti; ang kaniyang kagandahang-loob ay magpakailan man; at ang kaniyang pagtatapat ay sa lahat ng sali't saling lahi."
            }
          ]
        },
        {
          "chapter": 101,
          "name": "Mga Awit 101",
          "verses": [
            {
              "chapter": 101,
              "verse": 1,
              "name": "Mga Awit 101:1",
              "text": "Aking aawitin ang kagandahang-loob at kahatulan: sa iyo, Oh Panginoon, aawit ako ng mga pagpupuri."
            },
            {
              "chapter": 101,
              "verse": 2,
              "name": "Mga Awit 101:2",
              "text": "Ako'y magpapakapantas sa sakdal na lakad: Oh kailan ka pasasa akin? Ako'y lalakad sa loob ng aking bahay na may sakdal na puso."
            },
            {
              "chapter": 101,
              "verse": 3,
              "name": "Mga Awit 101:3",
              "text": "Hindi ako maglalagay ng hamak na bagay sa harap ng aking mga mata: aking ipinagtanim ang gawa nilang lisya: hindi kakapit sa akin."
            },
            {
              "chapter": 101,
              "verse": 4,
              "name": "Mga Awit 101:4",
              "text": "Ang suwail na puso ay hihiwalay sa akin: hindi ako makakaalam ng masamang bagay."
            },
            {
              "chapter": 101,
              "verse": 5,
              "name": "Mga Awit 101:5",
              "text": "Ang sumisirang puri na lihim sa kaniyang kapuwa ay aking ibubuwal: siya na may mapagmataas na tingin at may palalong puso ay hindi ko titiisin."
            },
            {
              "chapter": 101,
              "verse": 6,
              "name": "Mga Awit 101:6",
              "text": "Ang mga mata ko'y itititig ko sa mga tapat sa lupain, upang sila'y makatahan na kasama ko: siya na lumalakad sa sakdal na daan, siya'y mangangasiwa sa akin."
            },
            {
              "chapter": 101,
              "verse": 7,
              "name": "Mga Awit 101:7",
              "text": "Siyang gumagawa ng karayaan ay hindi tatahan sa loob ng aking bahay: siyang nagsasalita ng kabulaanan ay hindi matatatag sa harap ng aking mga mata."
            },
            {
              "chapter": 101,
              "verse": 8,
              "name": "Mga Awit 101:8",
              "text": "Tuwing umaga ay aking lilipulin ang lahat na masama sa lupain; upang ihiwalay ang lahat na manggagawa ng kasamaan sa bayan ng Panginoon."
            }
          ]
        },
        {
          "chapter": 102,
          "name": "Mga Awit 102",
          "verses": [
            {
              "chapter": 102,
              "verse": 1,
              "name": "Mga Awit 102:1",
              "text": "Dinggin mo ang dalangin ko, Oh Panginoon, at dumating nawa ang daing ko sa iyo."
            },
            {
              "chapter": 102,
              "verse": 2,
              "name": "Mga Awit 102:2",
              "text": "Huwag mong ikubli ang mukha mo sa akin sa kaarawan ng aking kahirapan: ikiling mo ang iyong pakinig sa akin; sa araw na ako'y tumawag, ay sagutin mo akong madali."
            },
            {
              "chapter": 102,
              "verse": 3,
              "name": "Mga Awit 102:3",
              "text": "Sapagka't ang mga kaarawan ko'y nangapapawi na parang usok, at ang mga buto ko'y nangasusunog na parang panggatong."
            },
            {
              "chapter": 102,
              "verse": 4,
              "name": "Mga Awit 102:4",
              "text": "Ang puso ko'y nasaktan na parang damo, at natuyo; sapagka't nalimutan kong kanin ang aking tinapay."
            },
            {
              "chapter": 102,
              "verse": 5,
              "name": "Mga Awit 102:5",
              "text": "Dahil sa tinig ng aking daing ang mga buto ko'y nagsisidikit sa aking laman."
            },
            {
              "chapter": 102,
              "verse": 6,
              "name": "Mga Awit 102:6",
              "text": "Ako'y parang pelikano sa ilang; ako'y naging parang kuwago sa kaparangan."
            },
            {
              "chapter": 102,
              "verse": 7,
              "name": "Mga Awit 102:7",
              "text": "Ako'y umaabang, at ako'y naging parang maya na nagiisa sa bubungan."
            },
            {
              "chapter": 102,
              "verse": 8,
              "name": "Mga Awit 102:8",
              "text": "Dinudusta ako ng aking mga kaaway buong araw; silang nangauulol laban sa akin ay nagsisisumpa sa akin."
            },
            {
              "chapter": 102,
              "verse": 9,
              "name": "Mga Awit 102:9",
              "text": "Sapagka't kinain ko ang mga abo na parang tinapay, at hinaluan ko ang aking inumin ng iyak."
            },
            {
              "chapter": 102,
              "verse": 10,
              "name": "Mga Awit 102:10",
              "text": "Dahil sa iyong galit at iyong poot: sapagka't ako'y iyong itinaas, at inihagis."
            },
            {
              "chapter": 102,
              "verse": 11,
              "name": "Mga Awit 102:11",
              "text": "Ang aking mga kaarawan ay parang lilim na kumikiling; at ako'y natuyo na parang damo."
            },
            {
              "chapter": 102,
              "verse": 12,
              "name": "Mga Awit 102:12",
              "text": "Nguni't ikaw, Oh Panginoon, ay mamamalagi magpakailan man; at ang alaala sa iyo ay sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 102,
              "verse": 13,
              "name": "Mga Awit 102:13",
              "text": "Ikaw ay babangon at maaawa sa Sion: sapagka't kapanahunan ng pagkaawa sa kaniya, Oo, ang takdang panahon ay dumating."
            },
            {
              "chapter": 102,
              "verse": 14,
              "name": "Mga Awit 102:14",
              "text": "Sapagka't nililigaya ang iyong mga lingkod sa kaniyang mga bato, at nanghihinayang sa kaniyang alabok."
            },
            {
              "chapter": 102,
              "verse": 15,
              "name": "Mga Awit 102:15",
              "text": "Sa gayo'y katatakutan ng mga bansa ang pangalan ng Panginoon. At ng lahat ng hari sa lupa ang iyong kaluwalhatian;"
            },
            {
              "chapter": 102,
              "verse": 16,
              "name": "Mga Awit 102:16",
              "text": "Sapagka't itinayo ng Panginoon ang Sion, siya'y napakita sa kaniyang kaluwalhatian;"
            },
            {
              "chapter": 102,
              "verse": 17,
              "name": "Mga Awit 102:17",
              "text": "Kaniyang dininig ang dalangin ng tapon, at hindi hinamak ang kanilang dalangin."
            },
            {
              "chapter": 102,
              "verse": 18,
              "name": "Mga Awit 102:18",
              "text": "Ito'y isusulat na ukol sa lahing susunod: at ang bayang lalalangin ay pupuri sa Panginoon."
            },
            {
              "chapter": 102,
              "verse": 19,
              "name": "Mga Awit 102:19",
              "text": "Sapagka't siya'y tumungo mula sa kaitaasan ng kaniyang santuario; tumingin ang Panginoon sa lupa mula sa langit;"
            },
            {
              "chapter": 102,
              "verse": 20,
              "name": "Mga Awit 102:20",
              "text": "Upang dinggin ang buntong hininga ng bilanggo: upang kalagan yaong nangaitakdang patayin;"
            },
            {
              "chapter": 102,
              "verse": 21,
              "name": "Mga Awit 102:21",
              "text": "Upang maipahayag ng mga tao ang pangalan ng Panginoon sa Sion, at ang kaniyang kapurihan sa Jerusalem;"
            },
            {
              "chapter": 102,
              "verse": 22,
              "name": "Mga Awit 102:22",
              "text": "Nang ang mga bayan ay mapisan, at ang mga kaharian, upang maglingkod sa Panginoon."
            },
            {
              "chapter": 102,
              "verse": 23,
              "name": "Mga Awit 102:23",
              "text": "Kaniyang pinahina ang aking kalakasan sa daan; kaniyang pinaikli ang mga kaarawan ko."
            },
            {
              "chapter": 102,
              "verse": 24,
              "name": "Mga Awit 102:24",
              "text": "Aking sinabi, Oh Dios ko, huwag mo akong kunin sa kalagitnaan ng aking mga kaarawan; ang mga taon mo'y lampas sa mga sali't saling lahi."
            },
            {
              "chapter": 102,
              "verse": 25,
              "name": "Mga Awit 102:25",
              "text": "Nang una ay inilagay mo ang patibayan ng lupa; at ang mga langit ay gawa ng iyong mga kamay."
            },
            {
              "chapter": 102,
              "verse": 26,
              "name": "Mga Awit 102:26",
              "text": "Sila'y uuwi sa wala, nguni't ikaw ay mananatili: Oo, silang lahat ay maluluma na parang bihisan; parang isang kasuutan na iyong mga papalitan, at sila'y mga mapapalitan:"
            },
            {
              "chapter": 102,
              "verse": 27,
              "name": "Mga Awit 102:27",
              "text": "Nguni't ikaw rin, at ang mga taon mo'y hindi magkakawakas."
            },
            {
              "chapter": 102,
              "verse": 28,
              "name": "Mga Awit 102:28",
              "text": "Ang mga anak ng iyong mga lingkod ay mangamamalagi, at ang kanilang binhi ay matatatag sa harap mo."
            }
          ]
        },
        {
          "chapter": 103,
          "name": "Mga Awit 103",
          "verses": [
            {
              "chapter": 103,
              "verse": 1,
              "name": "Mga Awit 103:1",
              "text": "Purihin mo ang Panginoon, Oh kaluluwa ko: at lahat na nangasa loob ko ay magsisipuri sa kaniyang banal na pangalan."
            },
            {
              "chapter": 103,
              "verse": 2,
              "name": "Mga Awit 103:2",
              "text": "Purihin mo ang Panginoon, Oh kaluluwa ko, at huwag mong kalimutan ang lahat niyang mabubuting gawa."
            },
            {
              "chapter": 103,
              "verse": 3,
              "name": "Mga Awit 103:3",
              "text": "Na siyang nagpapatawad ng iyong lahat na mga kasamaan; na siyang nagpapagaling ng iyong lahat na mga sakit;"
            },
            {
              "chapter": 103,
              "verse": 4,
              "name": "Mga Awit 103:4",
              "text": "Na siyang tumutubos ng iyong buhay sa pagkapahamak: na siyang nagpuputong sa iyo ng kagandahang-loob at malumanay na mga kaawaan:"
            },
            {
              "chapter": 103,
              "verse": 5,
              "name": "Mga Awit 103:5",
              "text": "Na siyang bumubusog sa iyong bibig ng mabuting bagay; Na anopa't ang iyong kabataan ay nababagong parang agila."
            },
            {
              "chapter": 103,
              "verse": 6,
              "name": "Mga Awit 103:6",
              "text": "Ang Panginoon ay nagsasagawa ng mga matuwid na gawa, at ng mga kahatulan na ukol sa lahat na naaapi."
            },
            {
              "chapter": 103,
              "verse": 7,
              "name": "Mga Awit 103:7",
              "text": "Kaniyang ipinabatid ang kaniyang mga daan kay Moises, ang kaniyang mga gawa sa mga anak ni Israel."
            },
            {
              "chapter": 103,
              "verse": 8,
              "name": "Mga Awit 103:8",
              "text": "Ang Panginoon ay puspos ng kahabagan at mapagbiyaya, banayad sa pagkagalit at sagana sa kagandahang-loob."
            },
            {
              "chapter": 103,
              "verse": 9,
              "name": "Mga Awit 103:9",
              "text": "Hindi siya makikipagkaalit na palagi; ni kaniya mang tataglayin ang kaniyang galit magpakailan man."
            },
            {
              "chapter": 103,
              "verse": 10,
              "name": "Mga Awit 103:10",
              "text": "Siya'y hindi gumawa sa atin ng ayon sa ating mga kasalanan, ni gumanti man sa atin ng ayon sa ating mga kasamaan."
            },
            {
              "chapter": 103,
              "verse": 11,
              "name": "Mga Awit 103:11",
              "text": "Sapagka't kung paanong ang mga langit ay mataas kay sa lupa, gayon kalaki ang kaniyang kagandahang-loob sa kanila na nangatatakot sa kaniya."
            },
            {
              "chapter": 103,
              "verse": 12,
              "name": "Mga Awit 103:12",
              "text": "Kung gaano ang layo ng silanganan sa kalunuran, gayon inilayo niya ang mga pagsalangsang natin sa atin."
            },
            {
              "chapter": 103,
              "verse": 13,
              "name": "Mga Awit 103:13",
              "text": "Kung paanong ang ama ay naaawa sa kaniyang mga anak, gayon naaawa ang Panginoon sa kanilang nangatatakot sa kaniya."
            },
            {
              "chapter": 103,
              "verse": 14,
              "name": "Mga Awit 103:14",
              "text": "Sapagka't nalalaman niya ang ating anyo; kaniyang inaalaala na tayo'y alabok."
            },
            {
              "chapter": 103,
              "verse": 15,
              "name": "Mga Awit 103:15",
              "text": "Tungkol sa tao, ang kaniyang mga kaarawan ay parang damo: kung paanong namumukadkad ang bulaklak sa parang ay gayon siya."
            },
            {
              "chapter": 103,
              "verse": 16,
              "name": "Mga Awit 103:16",
              "text": "Sapagka't dinadaanan ng hangin, at napaparam; at ang dako niyaon ay hindi na malalaman."
            },
            {
              "chapter": 103,
              "verse": 17,
              "name": "Mga Awit 103:17",
              "text": "Nguni't ang kagandahang-loob ng Panginoon ay mula ng walang pasimula hanggang sa walang hanggan sa nangatatakot sa kaniya, at ang kaniyang katuwiran ay hanggang sa mga anak ng mga anak;"
            },
            {
              "chapter": 103,
              "verse": 18,
              "name": "Mga Awit 103:18",
              "text": "Sa gayong nagiingat ng kaniyang tipan, at sa nagsisialaala ng kaniyang mga utos upang gawin,"
            },
            {
              "chapter": 103,
              "verse": 19,
              "name": "Mga Awit 103:19",
              "text": "Itinatag ng Panginoon ang kaniyang luklukan sa mga langit; at ang kaniyang kaharian ay nagpupuno sa lahat."
            },
            {
              "chapter": 103,
              "verse": 20,
              "name": "Mga Awit 103:20",
              "text": "Purihin ninyo ang Panginoon, ninyong mga anghel niya: ninyong makapangyarihan sa kalakasan na gumaganap ng kaniyang salita, na nakikinig sa tinig ng kaniyang salita."
            },
            {
              "chapter": 103,
              "verse": 21,
              "name": "Mga Awit 103:21",
              "text": "Purihin ninyo ang Panginoon, ninyong lahat na hukbo niya; ninyong mga ministro niya, na nagsisigawa ng kaniyang kasayahan."
            },
            {
              "chapter": 103,
              "verse": 22,
              "name": "Mga Awit 103:22",
              "text": "Purihin ninyo ang Panginoon, ninyong lahat na mga gawa niya, sa lahat na dako na kaniyang sakop; purihin mo ang Panginoon, Oh kaluluwa ko."
            }
          ]
        },
        {
          "chapter": 104,
          "name": "Mga Awit 104",
          "verses": [
            {
              "chapter": 104,
              "verse": 1,
              "name": "Mga Awit 104:1",
              "text": "Purihin mo ang Panginoon, Oh kaluluwa ko. Oh Panginoon kong Dios ikaw ay totoong dakila; ikaw ay nabibihisan ng karangalan at kamahalan."
            },
            {
              "chapter": 104,
              "verse": 2,
              "name": "Mga Awit 104:2",
              "text": "Na siyang nagbabalot sa iyo ng liwanag na parang bihisan; na siyang naguunat ng mga langit na parang tabing:"
            },
            {
              "chapter": 104,
              "verse": 3,
              "name": "Mga Awit 104:3",
              "text": "Na siyang naglalagay ng mga tahilan ng kaniyang mga silid sa tubig; na siyang gumagawa sa mga alapaap na kaniyang karro; na siyang lumalakad sa mga pakpak ng hangin:"
            },
            {
              "chapter": 104,
              "verse": 4,
              "name": "Mga Awit 104:4",
              "text": "Na siyang gumagawa sa mga hangin na mga sugo niya; ang kaniyang mga tagapangasiwa ay alab ng apoy:"
            },
            {
              "chapter": 104,
              "verse": 5,
              "name": "Mga Awit 104:5",
              "text": "Na siyang naglagay ng mga patibayan ng lupa, upang huwag makilos magpakailan man,"
            },
            {
              "chapter": 104,
              "verse": 6,
              "name": "Mga Awit 104:6",
              "text": "Iyong tinakpan ng kalaliman na tila isang bihisan; ang tubig ay tumatayo sa itaas ng mga bundok."
            },
            {
              "chapter": 104,
              "verse": 7,
              "name": "Mga Awit 104:7",
              "text": "Sa iyong pagsaway sila'y nagsitakas; sa hugong ng iyong kulog ay nagmadaling nagsialis sila;"
            },
            {
              "chapter": 104,
              "verse": 8,
              "name": "Mga Awit 104:8",
              "text": "Sila'y nagsiahon sa mga bundok, sila'y nagsilusong sa mga libis, sa dako mong itinatag ukol sa kanila."
            },
            {
              "chapter": 104,
              "verse": 9,
              "name": "Mga Awit 104:9",
              "text": "Ikaw ay naglagay ng hangganan upang sila'y huwag makaraan; upang sila'y huwag magsibalik na tumakip sa lupa."
            },
            {
              "chapter": 104,
              "verse": 10,
              "name": "Mga Awit 104:10",
              "text": "Siya'y nagsusugo ng mga bukal sa mga libis; nagsisiagos sa gitna ng mga bundok:"
            },
            {
              "chapter": 104,
              "verse": 11,
              "name": "Mga Awit 104:11",
              "text": "Sila'y nagpapainom sa bawa't hayop sa parang; nangagpapatid-uhaw ang mga mailap na asno."
            },
            {
              "chapter": 104,
              "verse": 12,
              "name": "Mga Awit 104:12",
              "text": "Sa tabi nila ay nagkaroon ng kanilang tahanan ang mga ibon sa himpapawid, sila'y nagsisiawit sa mga sanga."
            },
            {
              "chapter": 104,
              "verse": 13,
              "name": "Mga Awit 104:13",
              "text": "Kaniyang dinidilig ang mga bundok mula sa kaniyang mga silid: ang lupa'y busog sa bunga ng iyong mga gawa."
            },
            {
              "chapter": 104,
              "verse": 14,
              "name": "Mga Awit 104:14",
              "text": "Kaniyang pinatutubo ang damo para sa mga hayop, at ang gugulayin sa paglilingkod sa tao: upang siya'y maglabas ng pagkain sa lupa:"
            },
            {
              "chapter": 104,
              "verse": 15,
              "name": "Mga Awit 104:15",
              "text": "At ng alak na nagpapasaya sa puso ng tao, at ng langis upang pasilangin ang kaniyang mukha, at ng tinapay na nagpapalakas ng puso ng tao."
            },
            {
              "chapter": 104,
              "verse": 16,
              "name": "Mga Awit 104:16",
              "text": "Ang mga punong kahoy ng Panginoon ay busog; ang mga sedro sa Libano, na kaniyang itinanim;"
            },
            {
              "chapter": 104,
              "verse": 17,
              "name": "Mga Awit 104:17",
              "text": "Na pinamumugaran ng mga ibon: tungkol sa tagak, ang mga puno ng abeto ay kaniyang bahay."
            },
            {
              "chapter": 104,
              "verse": 18,
              "name": "Mga Awit 104:18",
              "text": "Ang mga mataas na bundok ay para sa mga mailap na kambing; ang mga malalaking bato ay kanlungan ng mga coneho."
            },
            {
              "chapter": 104,
              "verse": 19,
              "name": "Mga Awit 104:19",
              "text": "Kaniyang itinakda ang buwan sa mga panahon: nalalaman ng araw ang kaniyang paglubog."
            },
            {
              "chapter": 104,
              "verse": 20,
              "name": "Mga Awit 104:20",
              "text": "Iyong ginagawa ang kadiliman at nagiging gabi; na iginagalaw ng lahat na hayop sa gubat."
            },
            {
              "chapter": 104,
              "verse": 21,
              "name": "Mga Awit 104:21",
              "text": "Umuungal ang mga batang leon sa pagsunod sa mahuhuli nila, at hinahanap sa Dios ang kanilang pagkain."
            },
            {
              "chapter": 104,
              "verse": 22,
              "name": "Mga Awit 104:22",
              "text": "Ang araw ay sumisikat sila'y nagsisialis, at nangahihiga sa kanilang mga yungib."
            },
            {
              "chapter": 104,
              "verse": 23,
              "name": "Mga Awit 104:23",
              "text": "Lumalabas ang tao sa kaniyang gawain, at sa kaniyang gawa hanggang sa kinahapunan."
            },
            {
              "chapter": 104,
              "verse": 24,
              "name": "Mga Awit 104:24",
              "text": "Oh Panginoon, pagka sarisari ng iyong mga gawa! sa karunungan ay ginawa mo silang lahat: ang lupa ay puno ng iyong kayamanan."
            },
            {
              "chapter": 104,
              "verse": 25,
              "name": "Mga Awit 104:25",
              "text": "Nandoon ang dagat, na malaki at maluwang, na ginagalawan ng di mabilang na mga bagay, ng mga munti at ng mga malaking hayop din naman."
            },
            {
              "chapter": 104,
              "verse": 26,
              "name": "Mga Awit 104:26",
              "text": "Doo'y nagsisiyaon ang mga sasakyan: nandoon ang buwaya na iyong nilikha upang maglibang doon."
            },
            {
              "chapter": 104,
              "verse": 27,
              "name": "Mga Awit 104:27",
              "text": "Lahat ng ito ay nangaghihintay sa iyo, upang iyong mabigyan sila ng kanilang pagkain sa ukol na kapanahunan."
            },
            {
              "chapter": 104,
              "verse": 28,
              "name": "Mga Awit 104:28",
              "text": "Ang iyong ibinibigay sa kanila ay pinipisan nila; iyong ibinubukas ang iyong kamay, sila'y nangabubusog ng kabutihan."
            },
            {
              "chapter": 104,
              "verse": 29,
              "name": "Mga Awit 104:29",
              "text": "Iyong ikinukubli ang iyong mukha, sila'y nangababagabag; iyong inaalis ang kanilang hininga, sila'y nangamamatay, at nagsisibalik sa kanilang pagkaalabok."
            },
            {
              "chapter": 104,
              "verse": 30,
              "name": "Mga Awit 104:30",
              "text": "Iyong sinusugo ang iyong Espiritu, sila'y nangalalalang; at iyong binabago ang balat ng lupa."
            },
            {
              "chapter": 104,
              "verse": 31,
              "name": "Mga Awit 104:31",
              "text": "Manatili nawa ang kaluwalhatian ng Panginoon kailan man; magalak nawa ang Panginoon sa kaniyang mga gawa:"
            },
            {
              "chapter": 104,
              "verse": 32,
              "name": "Mga Awit 104:32",
              "text": "Na siyang tumitingin sa lupa at nayayanig: kaniyang hinihipo ang mga bundok at nagsisiusok."
            },
            {
              "chapter": 104,
              "verse": 33,
              "name": "Mga Awit 104:33",
              "text": "Aawit ako sa Panginoon habang ako'y nabubuhay: ako'y aawit ng pagpuri sa aking Dios, samantalang mayroon akong kabuhayan."
            },
            {
              "chapter": 104,
              "verse": 34,
              "name": "Mga Awit 104:34",
              "text": "Matamisin nawa niya ang aking pagbubulay: ako'y magagalak sa Panginoon."
            },
            {
              "chapter": 104,
              "verse": 35,
              "name": "Mga Awit 104:35",
              "text": "Malipol nawa ang mga makasalanan sa lupa, at mawala nawa ang masama. Purihin mo ang Panginoon, Oh kaluluwa ko. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 105,
          "name": "Mga Awit 105",
          "verses": [
            {
              "chapter": 105,
              "verse": 1,
              "name": "Mga Awit 105:1",
              "text": "Oh magpasalamat kayo sa Panginoon, kayo'y magsitawag sa kaniyang pangalan; ipabatid ninyo ang kaniyang mga gawain sa mga bayan."
            },
            {
              "chapter": 105,
              "verse": 2,
              "name": "Mga Awit 105:2",
              "text": "Magsiawit kayo sa kaniya, magsiawit kayo sa kaniya ng mga pagpuri; salitain ninyo ang lahat niyang kagilagilalas na mga gawa."
            },
            {
              "chapter": 105,
              "verse": 3,
              "name": "Mga Awit 105:3",
              "text": "Lumuwalhati kayo sa kaniyang banal na pangalan: mangagalak ang puso nila na nagsisihanap sa Panginoon."
            },
            {
              "chapter": 105,
              "verse": 4,
              "name": "Mga Awit 105:4",
              "text": "Hanapin ninyo ang Panginoon at ang kaniyang kalakasan; hanapin ninyo ang kaniyang mukha magpakailan man."
            },
            {
              "chapter": 105,
              "verse": 5,
              "name": "Mga Awit 105:5",
              "text": "Alalahanin ninyo ang kaniyang kagilagilalas na mga gawa na kaniyang ginawa: ang kaniyang mga kababalaghan at ang mga kahatulan ng kaniyang bibig;"
            },
            {
              "chapter": 105,
              "verse": 6,
              "name": "Mga Awit 105:6",
              "text": "Oh ninyong binhi ni Abraham na kaniyang lingkod, ninyong mga anak ni Jacob, na kaniyang mga hirang."
            },
            {
              "chapter": 105,
              "verse": 7,
              "name": "Mga Awit 105:7",
              "text": "Siya ang Panginoon nating Dios: ang kaniyang mga kahatulan ay nangasa buong lupa."
            },
            {
              "chapter": 105,
              "verse": 8,
              "name": "Mga Awit 105:8",
              "text": "Kaniyang inalaala ang kaniyang tipan magpakailan man, ang salita na kaniyang iniutos sa libong sali't saling lahi;"
            },
            {
              "chapter": 105,
              "verse": 9,
              "name": "Mga Awit 105:9",
              "text": "Ang tipan na kaniyang ginawa kay Abraham, at ang kaniyang sumpa kay Isaac;"
            },
            {
              "chapter": 105,
              "verse": 10,
              "name": "Mga Awit 105:10",
              "text": "At pinagtibay yaon kay Jacob na pinakapalatuntunan, sa Israel na pinakawalang hanggang tipan:"
            },
            {
              "chapter": 105,
              "verse": 11,
              "name": "Mga Awit 105:11",
              "text": "Na sinasabi, sa iyo'y ibibigay ko ang lupain ng Canaan, ang kapalaran na iyong mana;"
            },
            {
              "chapter": 105,
              "verse": 12,
              "name": "Mga Awit 105:12",
              "text": "Nang sila'y kaunti lamang tao sa bilang; Oo, totoong kaunti, at nangakikipamayan doon;"
            },
            {
              "chapter": 105,
              "verse": 13,
              "name": "Mga Awit 105:13",
              "text": "At sila'y nagsiyaon sa bansa at bansa, mula sa isang kaharian hanggang sa ibang bayan."
            },
            {
              "chapter": 105,
              "verse": 14,
              "name": "Mga Awit 105:14",
              "text": "Hindi niya tiniis ang sinomang tao na gawan sila ng kamalian; Oo, kaniyang sinaway ang mga hari dahil sa kanila;"
            },
            {
              "chapter": 105,
              "verse": 15,
              "name": "Mga Awit 105:15",
              "text": "Na sinasabi, Huwag ninyong galawin ang mga pinahiran ko ng langis. At huwag ninyong gawan ng masama ang mga propeta ko."
            },
            {
              "chapter": 105,
              "verse": 16,
              "name": "Mga Awit 105:16",
              "text": "At siya'y nagdala ng kagutom sa lupain; kaniyang binali ang buong tukod ng tinapay."
            },
            {
              "chapter": 105,
              "verse": 17,
              "name": "Mga Awit 105:17",
              "text": "Siya'y nagsugo ng isang lalake sa unahan nila; si Jose ay naipagbiling pinakaalipin:"
            },
            {
              "chapter": 105,
              "verse": 18,
              "name": "Mga Awit 105:18",
              "text": "Ang kaniyang mga paa ay sinaktan nila ng mga pangpangaw; siya'y nalagay sa mga tanikalang bakal:"
            },
            {
              "chapter": 105,
              "verse": 19,
              "name": "Mga Awit 105:19",
              "text": "Hanggang sa panahon na nangyari ang kaniyang salita; tinikman siya ng salita ng Panginoon."
            },
            {
              "chapter": 105,
              "verse": 20,
              "name": "Mga Awit 105:20",
              "text": "Ang hari ay nagsugo, at pinawalan siya; sa makatuwid baga'y ang pinuno ng mga bayan, at pinalaya niya siya."
            },
            {
              "chapter": 105,
              "verse": 21,
              "name": "Mga Awit 105:21",
              "text": "Ginawa niya siyang panginoon sa kaniyang bahay, at pinuno sa lahat niyang pag-aari:"
            },
            {
              "chapter": 105,
              "verse": 22,
              "name": "Mga Awit 105:22",
              "text": "Upang talian ang kaniyang mga pangulo sa kaniyang kaligayahan, at turuan ang kaniyang mga kasangguni ng karunungan."
            },
            {
              "chapter": 105,
              "verse": 23,
              "name": "Mga Awit 105:23",
              "text": "Si Israel naman ay nasok sa Egipto; at si Jacob ay nakipamayan sa lupain ng Cham."
            },
            {
              "chapter": 105,
              "verse": 24,
              "name": "Mga Awit 105:24",
              "text": "At kaniyang pinalagong mainam ang kaniyang bayan, at pinalakas sila kay sa kanilang mga kaaway."
            },
            {
              "chapter": 105,
              "verse": 25,
              "name": "Mga Awit 105:25",
              "text": "Kaniyang pinapanumbalik ang kanilang puso upang mangagtanim sa kaniyang bayan, upang magsigawang may katusuhan sa kaniyang mga lingkod."
            },
            {
              "chapter": 105,
              "verse": 26,
              "name": "Mga Awit 105:26",
              "text": "Kaniyang sinugo si Moises na kaniyang lingkod, at si Aaron na kaniyang hirang."
            },
            {
              "chapter": 105,
              "verse": 27,
              "name": "Mga Awit 105:27",
              "text": "Kanilang inilagay sa gitna nila ang kaniyang mga tanda, at mga kababalaghan sa lupain ng Cham."
            },
            {
              "chapter": 105,
              "verse": 28,
              "name": "Mga Awit 105:28",
              "text": "Siya'y nagsugo ng mga kadiliman, at nagpadilim; at sila'y hindi nagsipanghimagsik laban sa kaniyang mga salita."
            },
            {
              "chapter": 105,
              "verse": 29,
              "name": "Mga Awit 105:29",
              "text": "Kaniyang pinapaging dugo ang kanilang tubig, at pinatay ang kanilang mga isda."
            },
            {
              "chapter": 105,
              "verse": 30,
              "name": "Mga Awit 105:30",
              "text": "Ang kanilang lupain ay binukalan ng mga palaka, sa mga silid ng kanilang mga hari."
            },
            {
              "chapter": 105,
              "verse": 31,
              "name": "Mga Awit 105:31",
              "text": "Siya'y nagsalita, at dumating ang mga pulutong na mga langaw, at kuto sa lahat ng kanilang mga hangganan."
            },
            {
              "chapter": 105,
              "verse": 32,
              "name": "Mga Awit 105:32",
              "text": "Ibinigay niya sa kanila na pinakaulan ay graniso, at liyab ng apoy sa kanilang lupain."
            },
            {
              "chapter": 105,
              "verse": 33,
              "name": "Mga Awit 105:33",
              "text": "Sinaktan naman niya ang kanilang mga puno ng ubas, at ang kanilang mga puno ng higos; at binali ang mga punong kahoy ng kanilang mga hangganan."
            },
            {
              "chapter": 105,
              "verse": 34,
              "name": "Mga Awit 105:34",
              "text": "Siya'y nagsalita at ang mga balang ay nagsidating, at ang mga higad, ay yao'y walang bilang,"
            },
            {
              "chapter": 105,
              "verse": 35,
              "name": "Mga Awit 105:35",
              "text": "At kinain ang lahat na gugulayin sa kanilang lupain, at kinain ang bunga ng kanilang lupa."
            },
            {
              "chapter": 105,
              "verse": 36,
              "name": "Mga Awit 105:36",
              "text": "Sinaktan din niya ang lahat na panganay sa kanilang lupain, ang puno ng lahat nilang kalakasan."
            },
            {
              "chapter": 105,
              "verse": 37,
              "name": "Mga Awit 105:37",
              "text": "At kaniyang inilabas sila na may pilak at ginto: at hindi nagkaroon ng mahinang tao sa kaniyang mga lipi."
            },
            {
              "chapter": 105,
              "verse": 38,
              "name": "Mga Awit 105:38",
              "text": "Natuwa ang Egipto nang sila'y magsialis; sapagka't ang takot sa kanila ay nahulog sa kanila."
            },
            {
              "chapter": 105,
              "verse": 39,
              "name": "Mga Awit 105:39",
              "text": "Kaniyang inilatag ang ulap na pinakakubong; at apoy upang magbigay liwanag sa gabi,"
            },
            {
              "chapter": 105,
              "verse": 40,
              "name": "Mga Awit 105:40",
              "text": "Sila'y nagsihingi, at dinalhan niya ng mga pugo, at binusog niya sila ng pagkain na mula sa langit."
            },
            {
              "chapter": 105,
              "verse": 41,
              "name": "Mga Awit 105:41",
              "text": "Kaniyang ibinuka ang bato at binukalan ng tubig; nagsiagos sa tuyong mga dako na parang ilog."
            },
            {
              "chapter": 105,
              "verse": 42,
              "name": "Mga Awit 105:42",
              "text": "Sapagka't kaniyang naalaala ang kaniyang banal na salita, at si Abraham na kaniyang lingkod."
            },
            {
              "chapter": 105,
              "verse": 43,
              "name": "Mga Awit 105:43",
              "text": "At kaniyang inilabas ang kaniyang bayan na may kagalakan, at ang kaniyang hirang na may awitan."
            },
            {
              "chapter": 105,
              "verse": 44,
              "name": "Mga Awit 105:44",
              "text": "At ibinigay niya sa kanila ang mga lupain ng mga bansa; at kinuha nila ang gawa ng mga bayan na pinakaari:"
            },
            {
              "chapter": 105,
              "verse": 45,
              "name": "Mga Awit 105:45",
              "text": "Upang kanilang maingatan ang kaniyang mga palatuntunan, at sundin ang kaniyang mga kautusan. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 106,
          "name": "Mga Awit 106",
          "verses": [
            {
              "chapter": 106,
              "verse": 1,
              "name": "Mga Awit 106:1",
              "text": "Purihin ninyo ang Panginoon. Oh mangagpasalamat kayo sa Panginoon; sapagka't siya'y mabuti; sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 106,
              "verse": 2,
              "name": "Mga Awit 106:2",
              "text": "Sinong makapagbabadya ng mga makapangyarihang gawa ng Panginoon, o makapagpapakilala ng buo niyang kapurihan?"
            },
            {
              "chapter": 106,
              "verse": 3,
              "name": "Mga Awit 106:3",
              "text": "Mapalad silang nangagiingat ng kahatulan, at siyang gumagawa ng katuwiran sa buong panahon."
            },
            {
              "chapter": 106,
              "verse": 4,
              "name": "Mga Awit 106:4",
              "text": "Alalahanin mo ako, Oh Panginoon, ng lingap na iyong ipinagkaloob sa iyong bayan; Oh dalawin mo ako ng iyong pagliligtas:"
            },
            {
              "chapter": 106,
              "verse": 5,
              "name": "Mga Awit 106:5",
              "text": "Upang makita ko ang kaginhawahan ng iyong hirang, upang ako'y magalak sa kasayahan ng iyong bansa, upang ako'y lumuwalhati na kasama ng iyong mana."
            },
            {
              "chapter": 106,
              "verse": 6,
              "name": "Mga Awit 106:6",
              "text": "Kami ay nangagkasala na kasama ng aming mga magulang, kami ay nangakagawa ng kasamaan, kami ay nagsigawa ng masama."
            },
            {
              "chapter": 106,
              "verse": 7,
              "name": "Mga Awit 106:7",
              "text": "Hindi naunawa ng aming mga magulang ang iyong mga kababalaghan sa Egipto; hindi nila inalaala ang karamihan ng iyong mga kagandahang-loob, kundi naging mapanghimagsik sa dagat, sa makatuwid baga'y sa Dagat na Mapula."
            },
            {
              "chapter": 106,
              "verse": 8,
              "name": "Mga Awit 106:8",
              "text": "Gayon ma'y iniligtas niya sila dahil sa kaniyang pangalan, upang kaniyang maipabatid ang kaniyang matibay na kapangyarihan."
            },
            {
              "chapter": 106,
              "verse": 9,
              "name": "Mga Awit 106:9",
              "text": "Kaniyang sinaway naman ang Dagat na Mapula, at natuyo: sa gayo'y pinatnubayan niya sila sa mga kalaliman, na parang ilang."
            },
            {
              "chapter": 106,
              "verse": 10,
              "name": "Mga Awit 106:10",
              "text": "At iniligtas niya sila sa kamay ng nangagtatanim sa kanila, at tinubos niya sila sa kamay ng kaaway."
            },
            {
              "chapter": 106,
              "verse": 11,
              "name": "Mga Awit 106:11",
              "text": "At tinabunan ng tubig ang kanilang mga kaaway: walang nalabi sa kanila kahit isa."
            },
            {
              "chapter": 106,
              "verse": 12,
              "name": "Mga Awit 106:12",
              "text": "Nang magkagayo'y sinampalatayanan nila ang kaniyang mga salita; inawit nila ang kaniyang kapurihan."
            },
            {
              "chapter": 106,
              "verse": 13,
              "name": "Mga Awit 106:13",
              "text": "Nilimot nilang madali ang kaniyang mga gawa; hindi sila naghintay sa kaniyang payo:"
            },
            {
              "chapter": 106,
              "verse": 14,
              "name": "Mga Awit 106:14",
              "text": "Kundi nagnais ng di kawasa sa ilang, at tinukso ang Dios sa ilang."
            },
            {
              "chapter": 106,
              "verse": 15,
              "name": "Mga Awit 106:15",
              "text": "At binigyan niya sila ng kanilang hiling; nguni't pinangayayat ang kanilang kaluluwa."
            },
            {
              "chapter": 106,
              "verse": 16,
              "name": "Mga Awit 106:16",
              "text": "Kanilang pinanaghilian naman si Moises sa kampamento, at si Aaron na banal ng Panginoon."
            },
            {
              "chapter": 106,
              "verse": 17,
              "name": "Mga Awit 106:17",
              "text": "Ang lupa ay bumuka, at nilamon si Dathan, at tinakpan ang pulutong ni Abiram."
            },
            {
              "chapter": 106,
              "verse": 18,
              "name": "Mga Awit 106:18",
              "text": "At apoy ay nagningas sa kanilang pulutong; sinunog ng liyab ang mga masama,"
            },
            {
              "chapter": 106,
              "verse": 19,
              "name": "Mga Awit 106:19",
              "text": "Sila'y nagsigawa ng guya sa Horeb, at nagsisamba sa larawang binubo."
            },
            {
              "chapter": 106,
              "verse": 20,
              "name": "Mga Awit 106:20",
              "text": "Ganito nila pinapagbago ang kanilang kaluwalhatian sa wangis ng baka na kumakain ng damo."
            },
            {
              "chapter": 106,
              "verse": 21,
              "name": "Mga Awit 106:21",
              "text": "Nilimot nila ang Dios na kanilang tagapagligtas, na gumawa ng mga dakilang bagay sa Egipto;"
            },
            {
              "chapter": 106,
              "verse": 22,
              "name": "Mga Awit 106:22",
              "text": "Kagilagilalas na mga gawa sa lupain ng Cham, at kakilakilabot na mga bagay sa Dagat na Mapula."
            },
            {
              "chapter": 106,
              "verse": 23,
              "name": "Mga Awit 106:23",
              "text": "Kaya't sinabi niya, na kaniyang lilipulin sila, kung si Moises na kaniyang hirang ay hindi humarap sa kaniya sa bitak, upang pawiin ang kaniyang poot, upang huwag niyang lipulin sila."
            },
            {
              "chapter": 106,
              "verse": 24,
              "name": "Mga Awit 106:24",
              "text": "Oo, kanilang hinamak ang maligayang lupain, hindi nila sinampalatayanan ang kaniyang salita;"
            },
            {
              "chapter": 106,
              "verse": 25,
              "name": "Mga Awit 106:25",
              "text": "Kundi nangagsiungol sa kanilang mga tolda, at hindi nangakinig sa tinig ng Panginoon."
            },
            {
              "chapter": 106,
              "verse": 26,
              "name": "Mga Awit 106:26",
              "text": "Kaya't kaniyang isinumpa sa kanila, na kaniyang ibubulid sila sa ilang:"
            },
            {
              "chapter": 106,
              "verse": 27,
              "name": "Mga Awit 106:27",
              "text": "At kaniyang ibubulid ang kanilang binhi sa mga bansa, at pangalatin sila sa mga lupain."
            },
            {
              "chapter": 106,
              "verse": 28,
              "name": "Mga Awit 106:28",
              "text": "Sila'y nangakilakip naman sa diosdiosang Baal-peor, at nagsikain ng mga hain sa mga patay."
            },
            {
              "chapter": 106,
              "verse": 29,
              "name": "Mga Awit 106:29",
              "text": "Ganito minungkahi nila siya sa galit ng kanilang mga gawa; at ang salot ay lumitaw sa kanila."
            },
            {
              "chapter": 106,
              "verse": 30,
              "name": "Mga Awit 106:30",
              "text": "Nang magkagayo'y tumayo si Phinees, at gumawa ng kahatulan: at sa gayo'y tumigil ang salot."
            },
            {
              "chapter": 106,
              "verse": 31,
              "name": "Mga Awit 106:31",
              "text": "At nabilang sa kaniya na katuwiran, sa lahat ng sali't saling lahi magpakailan man."
            },
            {
              "chapter": 106,
              "verse": 32,
              "name": "Mga Awit 106:32",
              "text": "Kanilang ginalit din siya sa tubig ng Meriba, na anopa't naging masama kay Moises dahil sa kanila:"
            },
            {
              "chapter": 106,
              "verse": 33,
              "name": "Mga Awit 106:33",
              "text": "Sapagka't sila'y mapanghimagsik laban sa kaniyang diwa, at siya'y nagsalita ng walang pakundangan ng kaniyang mga labi."
            },
            {
              "chapter": 106,
              "verse": 34,
              "name": "Mga Awit 106:34",
              "text": "Hindi nila nilipol ang mga bayan, gaya ng iniutos ng Panginoon sa kanila;"
            },
            {
              "chapter": 106,
              "verse": 35,
              "name": "Mga Awit 106:35",
              "text": "Kundi nangakihalo sa mga bansa, at nangatuto ng kanilang mga gawa:"
            },
            {
              "chapter": 106,
              "verse": 36,
              "name": "Mga Awit 106:36",
              "text": "At sila'y nangaglingkod sa kanilang mga diosdiosan; na naging silo sa kanila:"
            },
            {
              "chapter": 106,
              "verse": 37,
              "name": "Mga Awit 106:37",
              "text": "Oo, kanilang inihain ang kanilang mga anak na lalake at babae sa mga demonio,"
            },
            {
              "chapter": 106,
              "verse": 38,
              "name": "Mga Awit 106:38",
              "text": "At nagbubo ng walang salang dugo, sa makatuwid baga'y ng dugo ng kanilang mga anak na lalake at babae, na kanilang inihain sa diosdiosan ng Canaan; at ang lupain ay nadumhan ng dugo."
            },
            {
              "chapter": 106,
              "verse": 39,
              "name": "Mga Awit 106:39",
              "text": "Ganito sila nagpakahawa sa kanilang mga gawa, at nagsiyaong nagpakarumi sa kanilang mga gawa."
            },
            {
              "chapter": 106,
              "verse": 40,
              "name": "Mga Awit 106:40",
              "text": "Kaya't nagalab ang pagiinit ng Panginoon laban sa kaniyang bayan, at kinayamutan niya ang kaniyang pamana."
            },
            {
              "chapter": 106,
              "verse": 41,
              "name": "Mga Awit 106:41",
              "text": "At ibinigay niya sila sa kamay ng mga bansa; at silang nangagtatanim sa kanila ay nangagpuno sa kanila."
            },
            {
              "chapter": 106,
              "verse": 42,
              "name": "Mga Awit 106:42",
              "text": "Pinighati naman sila ng kanilang mga kaaway, at sila'y nagsisuko sa kanilang kamay."
            },
            {
              "chapter": 106,
              "verse": 43,
              "name": "Mga Awit 106:43",
              "text": "Madalas na iligtas niya sila; nguni't sila'y mapanghimagsik sa kanilang payo, at nangababa sila sa kanilang kasamaan."
            },
            {
              "chapter": 106,
              "verse": 44,
              "name": "Mga Awit 106:44",
              "text": "Gayon ma'y nilingap niya ang kanilang kahirapan, nang kaniyang marinig ang kanilang daing:"
            },
            {
              "chapter": 106,
              "verse": 45,
              "name": "Mga Awit 106:45",
              "text": "At kaniyang inalaala sa kanila ang kaniyang tipan, at nagsisi ayon sa karamihan ng kaniyang mga kagandahang-loob."
            },
            {
              "chapter": 106,
              "verse": 46,
              "name": "Mga Awit 106:46",
              "text": "Ginawa naman niyang sila'y kaawaan niyaong lahat na nangagdalang bihag sa kanila."
            },
            {
              "chapter": 106,
              "verse": 47,
              "name": "Mga Awit 106:47",
              "text": "Iligtas mo kami, Oh Panginoon naming Dios, at pisanin mo kami na mula sa mga bansa, upang mangagpasalamat sa iyong banal na pangalan, at mangagtagumpay sa iyong kapurihan."
            },
            {
              "chapter": 106,
              "verse": 48,
              "name": "Mga Awit 106:48",
              "text": "Purihin ang Panginoon, ang Dios ng Israel, mula sa walang pasimula hanggang sa walang hanggan. At sabihin ng buong bayan, Siya nawa. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 107,
          "name": "Mga Awit 107",
          "verses": [
            {
              "chapter": 107,
              "verse": 1,
              "name": "Mga Awit 107:1",
              "text": "Oh mangagpasalamat kayo sa Panginoon; sapagka't siya'y mabuti: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 107,
              "verse": 2,
              "name": "Mga Awit 107:2",
              "text": "Sabihing gayon ng tinubos ng Panginoon, na kaniyang tinubos sa kamay ng kaaway;"
            },
            {
              "chapter": 107,
              "verse": 3,
              "name": "Mga Awit 107:3",
              "text": "At mga pinisan mula sa mga lupain, mula sa silanganan, at mula sa kalunuran, mula sa hilagaan at mula sa timugan."
            },
            {
              "chapter": 107,
              "verse": 4,
              "name": "Mga Awit 107:4",
              "text": "Sila'y nagsilaboy sa ilang, sa ulilang landas; sila'y hindi nakasumpong ng bayang tahanan."
            },
            {
              "chapter": 107,
              "verse": 5,
              "name": "Mga Awit 107:5",
              "text": "Gutom at uhaw, ang kanilang kaluluwa'y nanglupaypay sa kanila."
            },
            {
              "chapter": 107,
              "verse": 6,
              "name": "Mga Awit 107:6",
              "text": "Nang magkagayo'y nagsidaing sila sa Panginoon sa kanilang kabagabagan, at iniligtas niya sila sa kanilang kahirapan."
            },
            {
              "chapter": 107,
              "verse": 7,
              "name": "Mga Awit 107:7",
              "text": "Pinatnubayan naman niya sila sa matuwid na daan, upang sila'y magsiyaon sa bayang tahanan."
            },
            {
              "chapter": 107,
              "verse": 8,
              "name": "Mga Awit 107:8",
              "text": "Oh purihin ng mga tao ang Panginoon dahil sa kaniyang kagandahang-loob, at dahil sa kaniyang mga kagilagilalas na mga gawa sa mga anak ng mga tao!"
            },
            {
              "chapter": 107,
              "verse": 9,
              "name": "Mga Awit 107:9",
              "text": "Sapagka't kaniyang binigyang kasiyahan ang nananabik na kaluluwa, at ang gutom na kaluluwa ay binusog niya ng kabutihan."
            },
            {
              "chapter": 107,
              "verse": 10,
              "name": "Mga Awit 107:10",
              "text": "Ang gayong tumatahan sa kadiliman, at sa lilim ng kamatayan, na natatali sa dalamhati at pangaw;"
            },
            {
              "chapter": 107,
              "verse": 11,
              "name": "Mga Awit 107:11",
              "text": "Sapagka't sila'y nanghimagsik laban sa mga salita ng Dios, at hinamak ang payo ng Kataastaasan:"
            },
            {
              "chapter": 107,
              "verse": 12,
              "name": "Mga Awit 107:12",
              "text": "Kaya't kaniyang ibinaba ang kanilang puso na may hirap; sila'y nangabuwal, at walang sumaklolo."
            },
            {
              "chapter": 107,
              "verse": 13,
              "name": "Mga Awit 107:13",
              "text": "Nang magkagayo'y nagsidaing sila sa Panginoon sa kanilang kabagabagan, at iniligtas niya sila sa kanilang kahirapan."
            },
            {
              "chapter": 107,
              "verse": 14,
              "name": "Mga Awit 107:14",
              "text": "Inilabas niya sila sa kadiliman at sa lilim ng kamatayan, at pinatid ang kanilang mga tali."
            },
            {
              "chapter": 107,
              "verse": 15,
              "name": "Mga Awit 107:15",
              "text": "Oh purihin ng mga tao ang Panginoon dahil sa kaniyang kagandahang-loob, at dahil sa kaniyang mga kagilagilalas na mga gawa sa mga anak ng mga tao!"
            },
            {
              "chapter": 107,
              "verse": 16,
              "name": "Mga Awit 107:16",
              "text": "Sapagka't kaniyang sinira ang mga pintuang-bayan na tanso, at pinutol ang mga halang na bakal."
            },
            {
              "chapter": 107,
              "verse": 17,
              "name": "Mga Awit 107:17",
              "text": "Mga mangmang dahil sa kanilang mga pagsalangsang, at dahil sa kanilang mga kasamaan ay nadadalamhati."
            },
            {
              "chapter": 107,
              "verse": 18,
              "name": "Mga Awit 107:18",
              "text": "Kinayayamutan ng kanilang kaluluwa ang sarisaring pagkain; at sila'y nagsisilapit sa mga pintuan ng kamatayan,"
            },
            {
              "chapter": 107,
              "verse": 19,
              "name": "Mga Awit 107:19",
              "text": "Nang magkagayo'y nagsidaing sila sa Panginoon sa kanilang kabagabagan, at iniligtas niya sila sa kanilang kahirapan."
            },
            {
              "chapter": 107,
              "verse": 20,
              "name": "Mga Awit 107:20",
              "text": "Sinugo niya ang kaniyang salita, at pinagaling sila, at iniligtas sila sa kanilang mga ikapapahamak."
            },
            {
              "chapter": 107,
              "verse": 21,
              "name": "Mga Awit 107:21",
              "text": "Oh purihin ng mga tao ang Panginoon dahil sa kaniyang kagandahang-loob, at dahil sa kaniyang kagilagilalas na mga gawa sa mga anak ng mga tao!"
            },
            {
              "chapter": 107,
              "verse": 22,
              "name": "Mga Awit 107:22",
              "text": "At mangaghandog sila ng mga hain na pasalamat, at ipahayag ang kaniyang mga gawa na may awitan."
            },
            {
              "chapter": 107,
              "verse": 23,
              "name": "Mga Awit 107:23",
              "text": "Silang nagsisibaba sa dagat sa mga sasakyan, na nangangalakal sa mga malawak na tubig;"
            },
            {
              "chapter": 107,
              "verse": 24,
              "name": "Mga Awit 107:24",
              "text": "Ang mga ito'y nangakakakita ng mga gawa ng Panginoon, at ng kaniyang mga kababalaghan sa kalaliman."
            },
            {
              "chapter": 107,
              "verse": 25,
              "name": "Mga Awit 107:25",
              "text": "Sapagka't siya'y naguutos, at nagpapaunos, na nagbabangon ng mga alon niyaon."
            },
            {
              "chapter": 107,
              "verse": 26,
              "name": "Mga Awit 107:26",
              "text": "Nagsisitaas sa mga langit, nagsisibaba uli sa mga kalaliman: ang kanilang kaluluwa ay natutunaw dahil sa kabagabagan."
            },
            {
              "chapter": 107,
              "verse": 27,
              "name": "Mga Awit 107:27",
              "text": "Sila'y hahampashampas na paroo't parito, at gigiraygiray na parang lasing, at ang kanilang karunungan ay nawala."
            },
            {
              "chapter": 107,
              "verse": 28,
              "name": "Mga Awit 107:28",
              "text": "Nang magkagayo'y nagsidaing sila sa Panginoon sa kanilang kabagabagan, at inilabas niya sila sa kanilang kahirapan."
            },
            {
              "chapter": 107,
              "verse": 29,
              "name": "Mga Awit 107:29",
              "text": "Kaniyang pinahihimpil ang bagyo, na anopa't ang mga alon niyaon ay nagsisitahimik."
            },
            {
              "chapter": 107,
              "verse": 30,
              "name": "Mga Awit 107:30",
              "text": "Nang magkagayo'y natutuwa sila, dahil sa sila'y tiwasay. Sa gayo'y kaniyang dinadala sila sa daongang kanilang ibigin."
            },
            {
              "chapter": 107,
              "verse": 31,
              "name": "Mga Awit 107:31",
              "text": "Oh purihin ng mga tao ang Panginoon dahil sa kaniyang kagandahang-loob, at dahil sa kaniyang kagilagilalas na mga gawa sa mga anak ng mga tao!"
            },
            {
              "chapter": 107,
              "verse": 32,
              "name": "Mga Awit 107:32",
              "text": "Ibunyi rin naman nila siya sa kapulungan ng bayan, at purihin siya sa upuan ng mga matanda."
            },
            {
              "chapter": 107,
              "verse": 33,
              "name": "Mga Awit 107:33",
              "text": "Kaniyang pinapagiging ilang ang mga ilog, at uhaw na lupa ang mga bukal:"
            },
            {
              "chapter": 107,
              "verse": 34,
              "name": "Mga Awit 107:34",
              "text": "Na maalat na ilang ang mainam na lupain, dahil sa kasamaan nila na nagsisitahan doon."
            },
            {
              "chapter": 107,
              "verse": 35,
              "name": "Mga Awit 107:35",
              "text": "Kaniyang pinapagiging lawa ng mga tubig ang ilang, at mga bukal ang tuyong lupain."
            },
            {
              "chapter": 107,
              "verse": 36,
              "name": "Mga Awit 107:36",
              "text": "At kaniyang pinatatahan doon ang gutom, upang makapaghanda sila ng bayang tahanan;"
            },
            {
              "chapter": 107,
              "verse": 37,
              "name": "Mga Awit 107:37",
              "text": "At maghasik sa mga bukid, at magtanim ng mga ubasan, at magtamo ng mga bunga na pakinabang."
            },
            {
              "chapter": 107,
              "verse": 38,
              "name": "Mga Awit 107:38",
              "text": "Kaniya namang pinagpapala sila, na anopa't sila'y lubhang nagsisidami; at hindi tinitiis na ang kanilang kawan ay magkulang."
            },
            {
              "chapter": 107,
              "verse": 39,
              "name": "Mga Awit 107:39",
              "text": "Muli, sila'y nakulangan at nahapay sa kapighatian, kabagabagan, at kahirapan."
            },
            {
              "chapter": 107,
              "verse": 40,
              "name": "Mga Awit 107:40",
              "text": "Kaniyang ibinubugso ang kadustaan sa mga pangulo, at kaniyang pinagagala sila sa ilang na walang lansangan."
            },
            {
              "chapter": 107,
              "verse": 41,
              "name": "Mga Awit 107:41",
              "text": "Gayon ma'y iniuupo niya sa mataas ang mapagkailangan mula sa kadalamhatian, at ginagawan siya ng mga angkan na parang kawan."
            },
            {
              "chapter": 107,
              "verse": 42,
              "name": "Mga Awit 107:42",
              "text": "Makikita ng matuwid, at matutuwa; at titikumin ng lahat ng kasamaan ang kaniyang bibig."
            },
            {
              "chapter": 107,
              "verse": 43,
              "name": "Mga Awit 107:43",
              "text": "Kung sino ang pantas ay magbulay sa mga bagay na ito, at kanilang magugunita ang mga kagandahang-loob ng Panginoon."
            }
          ]
        },
        {
          "chapter": 108,
          "name": "Mga Awit 108",
          "verses": [
            {
              "chapter": 108,
              "verse": 1,
              "name": "Mga Awit 108:1",
              "text": "Ang aking puso'y matatag, Oh Dios; ako'y aawit, oo, ako'y aawit ng mga pagpuri, ng aking kaluwalhatian."
            },
            {
              "chapter": 108,
              "verse": 2,
              "name": "Mga Awit 108:2",
              "text": "Kayo'y gumising, salterio at alpa: ako ma'y gigising na maaga."
            },
            {
              "chapter": 108,
              "verse": 3,
              "name": "Mga Awit 108:3",
              "text": "Ako'y magpapasalamat sa iyo, Oh Panginoon, sa gitna ng mga bayan: at ako'y aawit ng mga pagpuri sa iyo sa gitna ng mga bansa."
            },
            {
              "chapter": 108,
              "verse": 4,
              "name": "Mga Awit 108:4",
              "text": "Sapagka't ang iyong kagandahang-loob ay dakila sa itaas sa mga langit, at ang iyong katotohanan ay umaabot sa mga alapaap."
            },
            {
              "chapter": 108,
              "verse": 5,
              "name": "Mga Awit 108:5",
              "text": "Mabunyi ka, Oh Dios, sa itaas sa mga langit: at ang iyong kaluwalhatian sa ibabaw ng buong lupa."
            },
            {
              "chapter": 108,
              "verse": 6,
              "name": "Mga Awit 108:6",
              "text": "Upang ang iyong minamahal ay maligtas, magligtas ka ng iyong kanan, at sagutin mo kami."
            },
            {
              "chapter": 108,
              "verse": 7,
              "name": "Mga Awit 108:7",
              "text": "Nagsalita ang Dios sa kaniyang kabanalan; ako'y magsasaya: aking hahatiin ang Sichem, at susukatin ko ang libis ng Sucoth."
            },
            {
              "chapter": 108,
              "verse": 8,
              "name": "Mga Awit 108:8",
              "text": "Galaad ay akin; Manases ay akin; ang Ephraim naman ay sanggalang ng aking ulo: Juda'y aking cetro."
            },
            {
              "chapter": 108,
              "verse": 9,
              "name": "Mga Awit 108:9",
              "text": "Moab ay aking hugasan; sa Edom ay ihahagis ko ang aking panyapak: sa Filistia ay hihiyaw ako."
            },
            {
              "chapter": 108,
              "verse": 10,
              "name": "Mga Awit 108:10",
              "text": "Sinong magpapasok sa akin sa bayang nakukutaan? Sinong papatnubay sa akin hanggang sa Edom?"
            },
            {
              "chapter": 108,
              "verse": 11,
              "name": "Mga Awit 108:11",
              "text": "Hindi ba ikaw Oh Dios na nagtakuwil sa amin, at hindi lumalabas, Oh Dios, na kasama ng aming mga hukbo?"
            },
            {
              "chapter": 108,
              "verse": 12,
              "name": "Mga Awit 108:12",
              "text": "Gawaran mo kami ng tulong laban sa kaaway; sapagka't walang kabuluhan ang tulong ng tao."
            },
            {
              "chapter": 108,
              "verse": 13,
              "name": "Mga Awit 108:13",
              "text": "Sa tulong ng Dios ay gagawa kaming may katapangan: sapagka't siya ang yayapak sa aming mga kaaway."
            }
          ]
        },
        {
          "chapter": 109,
          "name": "Mga Awit 109",
          "verses": [
            {
              "chapter": 109,
              "verse": 1,
              "name": "Mga Awit 109:1",
              "text": "Huwag kang mapayapa, Oh Dios na aking kapurihan;"
            },
            {
              "chapter": 109,
              "verse": 2,
              "name": "Mga Awit 109:2",
              "text": "Sapagka't ang bibig ng masama at ang bibig ng magdaraya ay ibinuka nila laban sa akin: sila'y nangagsalita sa akin na may sinungaling na dila."
            },
            {
              "chapter": 109,
              "verse": 3,
              "name": "Mga Awit 109:3",
              "text": "Kanilang kinulong ako sa palibot ng mga salitang pagtatanim, at nagsilaban sa akin ng walang kadahilanan."
            },
            {
              "chapter": 109,
              "verse": 4,
              "name": "Mga Awit 109:4",
              "text": "Sa kabayaran ng aking pagibig ay mga kaaway ko sila: nguni't ako'y tumatalaga sa dalangin."
            },
            {
              "chapter": 109,
              "verse": 5,
              "name": "Mga Awit 109:5",
              "text": "At iginanti nila sa akin ay kasamaan sa mabuti, at pagtatanim sa pagibig ko."
            },
            {
              "chapter": 109,
              "verse": 6,
              "name": "Mga Awit 109:6",
              "text": "Lagyan mo ng masamang tao siya: at tumayo nawa ang isang kaaway sa kaniyang kanan."
            },
            {
              "chapter": 109,
              "verse": 7,
              "name": "Mga Awit 109:7",
              "text": "Pagka siya'y nahatulan, lumabas nawa siyang salarin; at maging kasalanan nawa ang kaniyang dalangin."
            },
            {
              "chapter": 109,
              "verse": 8,
              "name": "Mga Awit 109:8",
              "text": "Maging kaunti nawa ang kaniyang mga kaarawan; at kunin nawa ng iba ang kaniyang katungkulan."
            },
            {
              "chapter": 109,
              "verse": 9,
              "name": "Mga Awit 109:9",
              "text": "Maulila nawa ang kaniyang mga anak, at mabao ang kaniyang asawa."
            },
            {
              "chapter": 109,
              "verse": 10,
              "name": "Mga Awit 109:10",
              "text": "Magsilaboy nawa ang kaniyang mga anak, at mangagpalimos; at hanapin nila ang kanilang pagkain sa kanilang mga dakong guho."
            },
            {
              "chapter": 109,
              "verse": 11,
              "name": "Mga Awit 109:11",
              "text": "Kunin nawa ng manglulupig ang lahat niyang tinatangkilik; at samsamin ng mga taga ibang lupa ang kaniyang mga gawa."
            },
            {
              "chapter": 109,
              "verse": 12,
              "name": "Mga Awit 109:12",
              "text": "Mawalan nawa ng maawa sa kaniya; at mawalan din ng maawa sa kaniyang mga anak na ulila."
            },
            {
              "chapter": 109,
              "verse": 13,
              "name": "Mga Awit 109:13",
              "text": "Mahiwalay nawa ang kaniyang kaapuapuhan; sa lahing darating ay mapawi ang kaniyang pangalan."
            },
            {
              "chapter": 109,
              "verse": 14,
              "name": "Mga Awit 109:14",
              "text": "Maalaala nawa ng Panginoon ang kasamaan ng kaniyang mga magulang; at huwag mapawi ang kasalanan ng kaniyang ina,"
            },
            {
              "chapter": 109,
              "verse": 15,
              "name": "Mga Awit 109:15",
              "text": "Mangalagay nawa silang lagi sa harap ng Panginoon, upang ihiwalay niya ang alaala sa kanila sa lupa."
            },
            {
              "chapter": 109,
              "verse": 16,
              "name": "Mga Awit 109:16",
              "text": "Sapagka't hindi niya naalaalang magpakita ng kaawaan, kundi hinabol ang dukha at mapagkailangan, at ang may bagbag na puso, upang patayin."
            },
            {
              "chapter": 109,
              "verse": 17,
              "name": "Mga Awit 109:17",
              "text": "Oo, kaniyang inibig ang sumpa, at dumating sa kaniya; at hindi siya nalulugod sa pagpapala, at malayo sa kaniya."
            },
            {
              "chapter": 109,
              "verse": 18,
              "name": "Mga Awit 109:18",
              "text": "Nagsusuot naman siya ng sumpa na parang kaniyang damit, at nasok sa kaniyang mga loob na bahagi na parang tubig, at parang langis sa kaniyang mga buto."
            },
            {
              "chapter": 109,
              "verse": 19,
              "name": "Mga Awit 109:19",
              "text": "Sa kaniya'y maging gaya nawa ng balabal na ibinabalabal, at gaya ng bigkis na ibinibigkis na lagi."
            },
            {
              "chapter": 109,
              "verse": 20,
              "name": "Mga Awit 109:20",
              "text": "Ito ang kagantihan sa aking mga kaaway na mula sa Panginoon, at sa kanilang nangagsasalita ng kasamaan laban sa aking kaluluwa."
            },
            {
              "chapter": 109,
              "verse": 21,
              "name": "Mga Awit 109:21",
              "text": "Nguni't gumawa kang kasama ko, Oh Dios na Panginoon, alang-alang sa iyong pangalan: sapagka't ang iyong kagandahang-loob ay mabuti, iligtas mo ako,"
            },
            {
              "chapter": 109,
              "verse": 22,
              "name": "Mga Awit 109:22",
              "text": "Sapagka't ako'y dukha at mapagkailangan, at ang aking puso ay nasaktan sa loob ko."
            },
            {
              "chapter": 109,
              "verse": 23,
              "name": "Mga Awit 109:23",
              "text": "Ako'y yumayaong gaya ng lilim pagka kumikiling: ako'y itinataas at ibinababa ng hangin na parang balang."
            },
            {
              "chapter": 109,
              "verse": 24,
              "name": "Mga Awit 109:24",
              "text": "Ang aking mga tuhod ay mahina sa pagaayuno, at ang aking laman ay nagkukulang ng katabaan."
            },
            {
              "chapter": 109,
              "verse": 25,
              "name": "Mga Awit 109:25",
              "text": "Ako nama'y naging kadustaan sa kanila: pagka kanilang nakikita ako, kanilang pinagagalawgalaw ang kanilang ulo."
            },
            {
              "chapter": 109,
              "verse": 26,
              "name": "Mga Awit 109:26",
              "text": "Tulungan mo ako, Oh Panginoon kong Dios; Oh iligtas mo ako ayon sa iyong kagandahang-loob:"
            },
            {
              "chapter": 109,
              "verse": 27,
              "name": "Mga Awit 109:27",
              "text": "Upang kanilang maalaman na ito'y iyong kamay; na ikaw, Panginoon, ang may gawa."
            },
            {
              "chapter": 109,
              "verse": 28,
              "name": "Mga Awit 109:28",
              "text": "Sumumpa sila, nguni't magpapala ka: pagka sila'y nagsibangon, sila'y mangapapahiya, nguni't ang iyong lingkod ay magagalak."
            },
            {
              "chapter": 109,
              "verse": 29,
              "name": "Mga Awit 109:29",
              "text": "Manamit ng kasiraang puri ang mga kaaway ko, at matakpan sila ng kanilang sariling kahihiyan na parang balabal."
            },
            {
              "chapter": 109,
              "verse": 30,
              "name": "Mga Awit 109:30",
              "text": "Ako'y magpapasalamat ng marami ng aking bibig sa Panginoon; Oo, aking pupurihin siya sa gitna ng karamihan."
            },
            {
              "chapter": 109,
              "verse": 31,
              "name": "Mga Awit 109:31",
              "text": "Sapagka't siya'y tatayo sa kanan ng mapagkailangan, upang iligtas sa kanilang nagsisihatol ng kaniyang kaluluwa."
            }
          ]
        },
        {
          "chapter": 110,
          "name": "Mga Awit 110",
          "verses": [
            {
              "chapter": 110,
              "verse": 1,
              "name": "Mga Awit 110:1",
              "text": "Sinabi ng Panginoon sa aking panginoon, umupo ka sa aking kanan, hanggang sa aking gawing tungtungan mo ang iyong mga kaaway."
            },
            {
              "chapter": 110,
              "verse": 2,
              "name": "Mga Awit 110:2",
              "text": "Pararatingin ng Panginoon ang setro ng iyong kalakasan mula sa Sion: magpuno ka sa gitna ng iyong mga kaaway."
            },
            {
              "chapter": 110,
              "verse": 3,
              "name": "Mga Awit 110:3",
              "text": "Ang bayan mo'y naghahandog na kusa sa kaarawan ng iyong kapangyarihan, sa kagandahan ng kabanalan: mula sa bukang liwayway ng umaga, ikaw ay may hamog ng iyong kabinataan."
            },
            {
              "chapter": 110,
              "verse": 4,
              "name": "Mga Awit 110:4",
              "text": "Sumumpa ang Panginoon, at hindi magsisisi, Ikaw ay saserdote magpakailan man ayon sa pagkasaserdote ni Melchisedech."
            },
            {
              "chapter": 110,
              "verse": 5,
              "name": "Mga Awit 110:5",
              "text": "Ang Panginoon sa iyong kanan ay hahampas sa mga hari sa kaarawan ng kaniyang poot."
            },
            {
              "chapter": 110,
              "verse": 6,
              "name": "Mga Awit 110:6",
              "text": "Siya'y hahatol sa gitna ng mga bansa, kaniyang pupunuin ng mga bangkay ang mga pook; siya'y manghahampas ng ulo sa maraming lupain."
            },
            {
              "chapter": 110,
              "verse": 7,
              "name": "Mga Awit 110:7",
              "text": "Siya'y iinom sa batis sa daan: kaya't siya'y magtataas ng ulo."
            }
          ]
        },
        {
          "chapter": 111,
          "name": "Mga Awit 111",
          "verses": [
            {
              "chapter": 111,
              "verse": 1,
              "name": "Mga Awit 111:1",
              "text": "Purihin ninyo ang Panginoon. Ako'y magpapasalamat sa Panginoon ng aking buong puso, sa kapulungan ng matuwid, at sa kapisanan."
            },
            {
              "chapter": 111,
              "verse": 2,
              "name": "Mga Awit 111:2",
              "text": "Ang mga gawa ng Panginoon ay dakila, siyasat ng lahat na nagtatamo ng kaligayahan diyan."
            },
            {
              "chapter": 111,
              "verse": 3,
              "name": "Mga Awit 111:3",
              "text": "Ang kaniyang gawa ay karangalan at kamahalan: at ang kaniyang katuwiran ay nananatili magpakailan man."
            },
            {
              "chapter": 111,
              "verse": 4,
              "name": "Mga Awit 111:4",
              "text": "Kaniyang ginawa ang kaniyang mga kababalaghang gawa upang alalahanin: ang Panginoon ay mapagbiyaya at puspos ng kahabagan."
            },
            {
              "chapter": 111,
              "verse": 5,
              "name": "Mga Awit 111:5",
              "text": "Siya'y nagbigay ng pagkain sa nangatatakot sa kaniya: kaniyang aalalahaning lagi ang kaniyang tipan."
            },
            {
              "chapter": 111,
              "verse": 6,
              "name": "Mga Awit 111:6",
              "text": "Kaniyang ipinakilala sa kaniyang bayan ang kapangyarihan ng kaniyang mga gawa, sa pagbibigay niya sa kanila ng mana ng mga bansa."
            },
            {
              "chapter": 111,
              "verse": 7,
              "name": "Mga Awit 111:7",
              "text": "Ang mga gawa ng kaniyang mga kamay ay katotohanan at kahatulan: lahat niyang mga tuntunin ay tunay."
            },
            {
              "chapter": 111,
              "verse": 8,
              "name": "Mga Awit 111:8",
              "text": "Nangatatatag magpakailan-kailan man, mga yari sa katotohanan at katuwiran."
            },
            {
              "chapter": 111,
              "verse": 9,
              "name": "Mga Awit 111:9",
              "text": "Siya'y nagsugo ng katubusan sa kaniyang bayan; kaniyang iniutos ang kaniyang tipan magpakailan man: banal at kagalanggalang ang kaniyang pangalan."
            },
            {
              "chapter": 111,
              "verse": 10,
              "name": "Mga Awit 111:10",
              "text": "Ang pagkatakot sa Panginoon ay pasimula ng karunungan; may mabuting pagkaunawa ang lahat na nagsisisunod ng kaniyang mga utos. Ang kaniyang kapurihan ay nananatili magpakailan man."
            }
          ]
        },
        {
          "chapter": 112,
          "name": "Mga Awit 112",
          "verses": [
            {
              "chapter": 112,
              "verse": 1,
              "name": "Mga Awit 112:1",
              "text": "Purihin ninyo ang Panginoon. Mapalad ang tao na natatakot sa Panginoon, na naliligayang mainam sa kaniyang mga utos."
            },
            {
              "chapter": 112,
              "verse": 2,
              "name": "Mga Awit 112:2",
              "text": "Ang kaniyang binhi ay magiging makapangyarihan sa lupa; ang lahi ng matuwid ay magiging mapalad."
            },
            {
              "chapter": 112,
              "verse": 3,
              "name": "Mga Awit 112:3",
              "text": "Kaginhawahan at kayamanan ay nasa kaniyang bahay: at ang kaniyang katuwiran ay nananatili magpakailan man."
            },
            {
              "chapter": 112,
              "verse": 4,
              "name": "Mga Awit 112:4",
              "text": "Sa matuwid ay bumabangon ang liwanag sa kadiliman: siya'y mapagbiyaya at puspos ng kahabagan, at matuwid."
            },
            {
              "chapter": 112,
              "verse": 5,
              "name": "Mga Awit 112:5",
              "text": "Ang ikabubuti ng taong mapagbiyaya at nagpapahiram, kaniyang aalalayan ang kaniyang usap sa kahatulan."
            },
            {
              "chapter": 112,
              "verse": 6,
              "name": "Mga Awit 112:6",
              "text": "Sapagka't siya'y hindi makikilos magpakailan man; ang matuwid ay maaalaalang walang hanggan."
            },
            {
              "chapter": 112,
              "verse": 7,
              "name": "Mga Awit 112:7",
              "text": "Siya'y hindi matatakot sa mga masamang balita: ang kaniyang puso ay matatag, na tumitiwala sa Panginoon."
            },
            {
              "chapter": 112,
              "verse": 8,
              "name": "Mga Awit 112:8",
              "text": "Ang kaniyang puso ay natatag, siya'y hindi matatakot, hanggang sa kaniyang makita ang nasa niya sa kaniyang mga kaaway."
            },
            {
              "chapter": 112,
              "verse": 9,
              "name": "Mga Awit 112:9",
              "text": "Kaniyang pinanabog, kaniyang ibinigay sa mapagkailangan; ang kaniyang katuwiran ay nananatili magpakailan man, ang kaniyang sungay ay matataas na may karangalan."
            },
            {
              "chapter": 112,
              "verse": 10,
              "name": "Mga Awit 112:10",
              "text": "Makikita ng masama, at mamamanglaw; siya'y magngangalit ng kaniyang mga ngipin, at matutunaw: ang nasa ng masama ay mapaparam."
            }
          ]
        },
        {
          "chapter": 113,
          "name": "Mga Awit 113",
          "verses": [
            {
              "chapter": 113,
              "verse": 1,
              "name": "Mga Awit 113:1",
              "text": "Purihin ninyo ang Panginoon. Purihin ninyo, Oh ninyong mga lingkod ng Panginoon, purihin ninyo ang pangalan ng Panginoon."
            },
            {
              "chapter": 113,
              "verse": 2,
              "name": "Mga Awit 113:2",
              "text": "Purihin ang pangalan ng Panginoon mula sa panahong ito at magpakailan man."
            },
            {
              "chapter": 113,
              "verse": 3,
              "name": "Mga Awit 113:3",
              "text": "Mula sa pagsikat ng araw hanggang sa paglubog niyaon ang pangalan ng Panginoon ay pupurihin,"
            },
            {
              "chapter": 113,
              "verse": 4,
              "name": "Mga Awit 113:4",
              "text": "Ang Panginoon ay mataas na higit sa lahat ng mga bansa, at ang kaniyang kaluwalhatian ay sa itaas ng mga langit."
            },
            {
              "chapter": 113,
              "verse": 5,
              "name": "Mga Awit 113:5",
              "text": "Sino ang gaya ng Panginoon nating Dios, na may kaniyang upuan sa itaas,"
            },
            {
              "chapter": 113,
              "verse": 6,
              "name": "Mga Awit 113:6",
              "text": "Na nagpapakababang tumitingin ng mga bagay na nangasa sa langit at sa lupa?"
            },
            {
              "chapter": 113,
              "verse": 7,
              "name": "Mga Awit 113:7",
              "text": "Kaniyang ibinabangon ang dukha mula sa alabok, at itinataas ang mapagkailangan mula sa dumi;"
            },
            {
              "chapter": 113,
              "verse": 8,
              "name": "Mga Awit 113:8",
              "text": "Upang maupo siya na kasama ng mga pangulo, sa makatuwid baga'y ng mga pangulo ng kaniyang bayan."
            },
            {
              "chapter": 113,
              "verse": 9,
              "name": "Mga Awit 113:9",
              "text": "Kaniyang pinapagiingat ng bahay ang baog na babae, at maging masayang ina ng mga anak. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 114,
          "name": "Mga Awit 114",
          "verses": [
            {
              "chapter": 114,
              "verse": 1,
              "name": "Mga Awit 114:1",
              "text": "Nang lumabas ang Israel sa Egipto, ang sangbahayan ni Jacob mula sa bayang may ibang wika;"
            },
            {
              "chapter": 114,
              "verse": 2,
              "name": "Mga Awit 114:2",
              "text": "Ang Juda ay naging kaniyang santuario, ang Israel ay kaniyang sakop."
            },
            {
              "chapter": 114,
              "verse": 3,
              "name": "Mga Awit 114:3",
              "text": "Nakita ng dagat, at tumakas; ang Jordan ay napaurong."
            },
            {
              "chapter": 114,
              "verse": 4,
              "name": "Mga Awit 114:4",
              "text": "Ang mga bundok ay nagsiluksong parang mga lalaking tupa, ang mga munting gulod na parang mga batang tupa."
            },
            {
              "chapter": 114,
              "verse": 5,
              "name": "Mga Awit 114:5",
              "text": "Anong ipakikialam ko sa iyo, Oh dagat, na ikaw ay tumatakas? sa iyo Jordan, na ikaw ay umuurong?"
            },
            {
              "chapter": 114,
              "verse": 6,
              "name": "Mga Awit 114:6",
              "text": "Sa inyo mga bundok, na kayo'y nagsisiluksong parang mga lalaking tupa; sa inyong mga munting gulod, na parang mga batang tupa?"
            },
            {
              "chapter": 114,
              "verse": 7,
              "name": "Mga Awit 114:7",
              "text": "Mayanig ka, ikaw na lupa, sa harapan ng Panginoon, sa harapan ng Dios ni Jacob;"
            },
            {
              "chapter": 114,
              "verse": 8,
              "name": "Mga Awit 114:8",
              "text": "Na pinapagiging tipunan ng tubig ang malaking bato. Na bukal ng tubig ang pingkiang bato."
            }
          ]
        },
        {
          "chapter": 115,
          "name": "Mga Awit 115",
          "verses": [
            {
              "chapter": 115,
              "verse": 1,
              "name": "Mga Awit 115:1",
              "text": "Huwag sa amin, Oh Panginoon, huwag sa amin, kundi sa iyong pangalan ay magbigay kang karangalan, dahil sa iyong kagandahang-loob, at dahil sa iyong katotohanan."
            },
            {
              "chapter": 115,
              "verse": 2,
              "name": "Mga Awit 115:2",
              "text": "Bakit sasabihin ng mga bansa, Saan nandoon ngayon ang kanilang Dios?"
            },
            {
              "chapter": 115,
              "verse": 3,
              "name": "Mga Awit 115:3",
              "text": "Nguni't ang aming Dios ay nasa mga langit: kaniyang ginagawa ang kaniyang ibigin."
            },
            {
              "chapter": 115,
              "verse": 4,
              "name": "Mga Awit 115:4",
              "text": "Ang kanilang mga diosdiosan ay pilak at ginto, yari ng mga kamay ng mga tao."
            },
            {
              "chapter": 115,
              "verse": 5,
              "name": "Mga Awit 115:5",
              "text": "Sila'y may mga bibig, nguni't sila'y hindi nangagsasalita; mga mata'y mayroon sila, nguni't hindi sila nangakakakita;"
            },
            {
              "chapter": 115,
              "verse": 6,
              "name": "Mga Awit 115:6",
              "text": "Sila'y may mga tainga, nguni't hindi sila nangakakarinig; mga ilong ay mayroon sila, nguni't hindi sila nangakakaamoy;"
            },
            {
              "chapter": 115,
              "verse": 7,
              "name": "Mga Awit 115:7",
              "text": "Mayroon silang mga kamay, nguni't hindi sila nangakatatangan; mga paa ay mayroon sila, nguni't hindi sila nangakalalakad; ni nangagsasalita man sila sa kanilang ngalangala."
            },
            {
              "chapter": 115,
              "verse": 8,
              "name": "Mga Awit 115:8",
              "text": "Ang nagsisigawa sa kanila ay magiging gaya nila; Oo, bawa't tumitiwala sa kanila."
            },
            {
              "chapter": 115,
              "verse": 9,
              "name": "Mga Awit 115:9",
              "text": "Oh Israel, tumiwala ka sa Panginoon: siya'y kanilang saklolo at kanilang kalasag."
            },
            {
              "chapter": 115,
              "verse": 10,
              "name": "Mga Awit 115:10",
              "text": "Oh sangbahayan ni Aaron, magsitiwala kayo sa Panginoon: siya'y kanilang saklolo at kanilang kalasag."
            },
            {
              "chapter": 115,
              "verse": 11,
              "name": "Mga Awit 115:11",
              "text": "Kayong nangatatakot sa Panginoon, magsitiwala kayo sa Panginoon; siya'y kanilang saklolo at kanilang kalasag."
            },
            {
              "chapter": 115,
              "verse": 12,
              "name": "Mga Awit 115:12",
              "text": "Inalaala tayo ng Panginoon; kaniyang pagpapalain tayo: kaniyang pagpapalain ang sangbahayan ni Israel, kaniyang pagpapalain ang sangbahayan ni Aaron."
            },
            {
              "chapter": 115,
              "verse": 13,
              "name": "Mga Awit 115:13",
              "text": "Kaniyang pagpapalain ang nangatatakot sa Panginoon, ang mababa at gayon ang mataas."
            },
            {
              "chapter": 115,
              "verse": 14,
              "name": "Mga Awit 115:14",
              "text": "Palalaguin kayo ng Panginoon ng higit at higit, kayo at ang inyong mga anak."
            },
            {
              "chapter": 115,
              "verse": 15,
              "name": "Mga Awit 115:15",
              "text": "Pinagpala kayo ng Panginoon, na gumawa ng langit at lupa."
            },
            {
              "chapter": 115,
              "verse": 16,
              "name": "Mga Awit 115:16",
              "text": "Ang mga langit ay mga langit ng Panginoon; nguni't ang lupa ay kaniyang ibinigay sa mga anak ng mga tao."
            },
            {
              "chapter": 115,
              "verse": 17,
              "name": "Mga Awit 115:17",
              "text": "Ang patay ay hindi pumupuri sa Panginoon, ni sinomang nabababa sa katahimikan;"
            },
            {
              "chapter": 115,
              "verse": 18,
              "name": "Mga Awit 115:18",
              "text": "Nguni't aming pupurihin ang Panginoon mula sa panahong ito hanggang sa walang hanggan. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 116,
          "name": "Mga Awit 116",
          "verses": [
            {
              "chapter": 116,
              "verse": 1,
              "name": "Mga Awit 116:1",
              "text": "Aking iniibig ang Panginoon, sapagka't kaniyang dininig ang aking tinig at aking mga hiling."
            },
            {
              "chapter": 116,
              "verse": 2,
              "name": "Mga Awit 116:2",
              "text": "Sapagka't kaniyang ikiniling ang kaniyang pakinig sa akin, kaya't ako'y tatawag sa kaniya habang ako'y nabubuhay."
            },
            {
              "chapter": 116,
              "verse": 3,
              "name": "Mga Awit 116:3",
              "text": "Ang tali ng kamatayan ay pumulupot sa akin, at ang mga sakit ng Sheol ay nagsihawak sa akin: aking nasumpungan ang kabagabagan at kapanglawan."
            },
            {
              "chapter": 116,
              "verse": 4,
              "name": "Mga Awit 116:4",
              "text": "Nang magkagayo'y tumawag ako sa pangalan ng Panginoon; Oh Panginoon, isinasamo ko sa iyo, iligtas mo ang aking kaluluwa."
            },
            {
              "chapter": 116,
              "verse": 5,
              "name": "Mga Awit 116:5",
              "text": "Mapagbiyaya ang Panginoon, at matuwid; Oo, ang Dios namin ay maawain."
            },
            {
              "chapter": 116,
              "verse": 6,
              "name": "Mga Awit 116:6",
              "text": "Pinalalagi ng Panginoon ang mga tapat na loob: ako'y nababa, at kaniyang iniligtas ako."
            },
            {
              "chapter": 116,
              "verse": 7,
              "name": "Mga Awit 116:7",
              "text": "Bumalik ka sa iyong kapahingahan, Oh kaluluwa ko; sapagka't ginawan ka ng mabuti ng Panginoon."
            },
            {
              "chapter": 116,
              "verse": 8,
              "name": "Mga Awit 116:8",
              "text": "Sapagka't iyong iniligtas ang kaluluwa ko sa kamatayan, at ang mga mata ko sa mga luha, at ang mga paa ko sa pagkabuwal."
            },
            {
              "chapter": 116,
              "verse": 9,
              "name": "Mga Awit 116:9",
              "text": "Ako'y lalakad sa harap ng Panginoon, sa lupain ng mga buhay."
            },
            {
              "chapter": 116,
              "verse": 10,
              "name": "Mga Awit 116:10",
              "text": "Ako'y sumasampalataya, sapagka't ako'y magsasalita: ako'y lubhang nagdalamhati:"
            },
            {
              "chapter": 116,
              "verse": 11,
              "name": "Mga Awit 116:11",
              "text": "Aking sinabi sa aking pagmamadali, lahat ng tao ay bulaan."
            },
            {
              "chapter": 116,
              "verse": 12,
              "name": "Mga Awit 116:12",
              "text": "Ano ang aking ibabayad sa Panginoon dahil sa lahat niyang kabutihan sa akin?"
            },
            {
              "chapter": 116,
              "verse": 13,
              "name": "Mga Awit 116:13",
              "text": "Aking kukunin ang saro ng kaligtasan, at tatawag ako sa pangalan ng Panginoon."
            },
            {
              "chapter": 116,
              "verse": 14,
              "name": "Mga Awit 116:14",
              "text": "Aking babayaran ang mga panata ko sa Panginoon, Oo, sa harapan ng buo niyang bayan."
            },
            {
              "chapter": 116,
              "verse": 15,
              "name": "Mga Awit 116:15",
              "text": "Mahalaga sa paningin ng Panginoon ang kamatayan ng kaniyang mga banal."
            },
            {
              "chapter": 116,
              "verse": 16,
              "name": "Mga Awit 116:16",
              "text": "Oh Panginoon, tunay na ako'y iyong lingkod; ako'y iyong lingkod, na anak ng iyong lingkod na babae; iyong kinalag ang aking mga tali."
            },
            {
              "chapter": 116,
              "verse": 17,
              "name": "Mga Awit 116:17",
              "text": "Aking ihahandog sa iyo ang hain na pasalamat, at tatawag ako sa pangalan ng Panginoon."
            },
            {
              "chapter": 116,
              "verse": 18,
              "name": "Mga Awit 116:18",
              "text": "Aking babayaran ang mga panata ko sa Panginoon, Oo, sa harapan ng buo niyang bayan;"
            },
            {
              "chapter": 116,
              "verse": 19,
              "name": "Mga Awit 116:19",
              "text": "Sa mga looban ng bahay ng Panginoon, sa gitna mo, Oh Jerusalem. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 117,
          "name": "Mga Awit 117",
          "verses": [
            {
              "chapter": 117,
              "verse": 1,
              "name": "Mga Awit 117:1",
              "text": "Oh purihin ninyo ang Panginoon, ninyong lahat na mga bansa: purihin ninyo siya, ninyong lahat na mga bayan."
            },
            {
              "chapter": 117,
              "verse": 2,
              "name": "Mga Awit 117:2",
              "text": "Sapagka't ang kaniyang kagandahang-loob ay dakila sa atin; at ang katotohanan ng Panginoon ay magpakailan man. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 118,
          "name": "Mga Awit 118",
          "verses": [
            {
              "chapter": 118,
              "verse": 1,
              "name": "Mga Awit 118:1",
              "text": "Oh mangagpasalamat kayo sa Panginoon; sapagka't siya'y mabuti: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 118,
              "verse": 2,
              "name": "Mga Awit 118:2",
              "text": "Magsabi ngayon ang Israel, na ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 118,
              "verse": 3,
              "name": "Mga Awit 118:3",
              "text": "Magsabi ngayon ang sangbahayan ni Aaron, na ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 118,
              "verse": 4,
              "name": "Mga Awit 118:4",
              "text": "Mangagsabi ngayon ang nangatatakot sa Panginoon, na ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 118,
              "verse": 5,
              "name": "Mga Awit 118:5",
              "text": "Sa aking kapanglawan ay tumawag ako sa Panginoon: sinagot ako ng Panginoon, at inilagay ako sa maluwag na dako."
            },
            {
              "chapter": 118,
              "verse": 6,
              "name": "Mga Awit 118:6",
              "text": "Ang Panginoon ay kakampi ko; hindi ako matatakot: anong magagawa ng tao sa akin?"
            },
            {
              "chapter": 118,
              "verse": 7,
              "name": "Mga Awit 118:7",
              "text": "Ang Panginoon ay kakampi ko sa gitna nila na nagsisitulong sa akin: kaya't makikita ko ang nasa ko sa kanila na nangagtatanim sa akin."
            },
            {
              "chapter": 118,
              "verse": 8,
              "name": "Mga Awit 118:8",
              "text": "Lalong mabuti ang manganlong sa Panginoon kay sa maglagak ng tiwala sa tao."
            },
            {
              "chapter": 118,
              "verse": 9,
              "name": "Mga Awit 118:9",
              "text": "Lalong mabuti ang manganlong sa Panginoon kay sa maglagak ng tiwala sa mga pangulo."
            },
            {
              "chapter": 118,
              "verse": 10,
              "name": "Mga Awit 118:10",
              "text": "Kinubkob ako ng lahat ng mga bansa sa palibot: sa pangalan ng Panginoon ay aking ihihiwalay sila."
            },
            {
              "chapter": 118,
              "verse": 11,
              "name": "Mga Awit 118:11",
              "text": "Kanilang kinubkob ako sa palibot; oo, kanilang kinubkob ako sa palibot: sa pangalan ng Panginoon ay aking ihihiwalay sila."
            },
            {
              "chapter": 118,
              "verse": 12,
              "name": "Mga Awit 118:12",
              "text": "Kanilang kinubkob ako sa palibot na parang mga pukyutan: sila'y nangamatay na parang apoy ng mga dawag: sa pangalan ng Panginoon ay aking ihihiwalay sila."
            },
            {
              "chapter": 118,
              "verse": 13,
              "name": "Mga Awit 118:13",
              "text": "Itinulak mo akong bigla upang ako'y mabuwal: nguni't tulungan ako ng Panginoon."
            },
            {
              "chapter": 118,
              "verse": 14,
              "name": "Mga Awit 118:14",
              "text": "Ang Panginoon ay aking kalakasan at awit; at siya'y naging aking kaligtasan."
            },
            {
              "chapter": 118,
              "verse": 15,
              "name": "Mga Awit 118:15",
              "text": "Ang tinig ng kagalakan at kaligtasan ay nasa mga tolda ng matuwid: ang kanan ng Panginoon ay gumagawang matapang."
            },
            {
              "chapter": 118,
              "verse": 16,
              "name": "Mga Awit 118:16",
              "text": "Ang kanan ng Panginoon ay nabunyi; ang kanan ng Panginoon ay gumagawang matapang."
            },
            {
              "chapter": 118,
              "verse": 17,
              "name": "Mga Awit 118:17",
              "text": "Hindi ako mamamatay, kundi mabubuhay, at magpapahayag ng mga gawa ng Panginoon."
            },
            {
              "chapter": 118,
              "verse": 18,
              "name": "Mga Awit 118:18",
              "text": "Pinarusahan akong mainam ng Panginoon; nguni't hindi niya ako ibinigay sa kamatayan."
            },
            {
              "chapter": 118,
              "verse": 19,
              "name": "Mga Awit 118:19",
              "text": "Buksan ninyo sa akin ang mga pintuan ng katuwiran; aking papasukan, ako'y magpapasalamat sa Panginoon."
            },
            {
              "chapter": 118,
              "verse": 20,
              "name": "Mga Awit 118:20",
              "text": "Ito'y siyang pintuan ng Panginoon; papasukan ng matuwid."
            },
            {
              "chapter": 118,
              "verse": 21,
              "name": "Mga Awit 118:21",
              "text": "Ako'y magpapasalamat sa iyo, sapagka't sinagot mo ako! At ikaw ay naging aking kaligtasan."
            },
            {
              "chapter": 118,
              "verse": 22,
              "name": "Mga Awit 118:22",
              "text": "Ang bato na itinakuwil ng nangagtayo ng bahay ay naging pangulo sa sulok."
            },
            {
              "chapter": 118,
              "verse": 23,
              "name": "Mga Awit 118:23",
              "text": "Ito ang gawa ng Panginoon: kagilagilalas sa harap ng ating mga mata."
            },
            {
              "chapter": 118,
              "verse": 24,
              "name": "Mga Awit 118:24",
              "text": "Ito ang araw na ginawa ng Panginoon; tayo'y mangagagalak at ating katutuwaan."
            },
            {
              "chapter": 118,
              "verse": 25,
              "name": "Mga Awit 118:25",
              "text": "Magligtas ka ngayon, isinasamo namin sa iyo, Oh Panginoon: Oh Panginoon, isinasamo namin sa iyo, magsugo ka ngayon ng kaginhawahan."
            },
            {
              "chapter": 118,
              "verse": 26,
              "name": "Mga Awit 118:26",
              "text": "Mapalad siya na dumarating sa pangalan ng Panginoon: aming pinuri kayo mula sa bahay ng Panginoon."
            },
            {
              "chapter": 118,
              "verse": 27,
              "name": "Mga Awit 118:27",
              "text": "Ang Panginoon ay Dios, at binigyan niya kami ng liwanag; talian ninyo ang hain ng mga panali, sa makatuwid baga'y sa mga tila sungay ng dambana."
            },
            {
              "chapter": 118,
              "verse": 28,
              "name": "Mga Awit 118:28",
              "text": "Ikaw ay aking Dios, at magpapasalamat ako sa iyo: ikaw ay aking Dios, aking ibubunyi ka."
            },
            {
              "chapter": 118,
              "verse": 29,
              "name": "Mga Awit 118:29",
              "text": "Oh mangagpasalamat kayo sa Panginoon, sapagka't siya'y mabuti: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            }
          ]
        },
        {
          "chapter": 119,
          "name": "Mga Awit 119",
          "verses": [
            {
              "chapter": 119,
              "verse": 1,
              "name": "Mga Awit 119:1",
              "text": "Mapalad silang sakdal sa lakad, na nagsisilakad sa kautusan ng Panginoon."
            },
            {
              "chapter": 119,
              "verse": 2,
              "name": "Mga Awit 119:2",
              "text": "Mapalad silang nangagiingat ng kaniyang mga patotoo, na nagsisihanap sa kaniya ng buong puso."
            },
            {
              "chapter": 119,
              "verse": 3,
              "name": "Mga Awit 119:3",
              "text": "Oo, silang hindi nagsisigawa ng kalikuan; sila'y nagsisilakad sa kaniyang mga daan."
            },
            {
              "chapter": 119,
              "verse": 4,
              "name": "Mga Awit 119:4",
              "text": "Iyong iniutos sa amin ang mga tuntunin mo, upang aming sunding masikap."
            },
            {
              "chapter": 119,
              "verse": 5,
              "name": "Mga Awit 119:5",
              "text": "Oh matatag nawa ang aking mga daan, upang sundin ang mga palatuntunan mo!"
            },
            {
              "chapter": 119,
              "verse": 6,
              "name": "Mga Awit 119:6",
              "text": "Hindi nga ako mapapahiya, pagka ako'y nagkaroon ng galang sa inyong lahat na mga utos."
            },
            {
              "chapter": 119,
              "verse": 7,
              "name": "Mga Awit 119:7",
              "text": "Ako'y magpapasalamat sa iyo sa pamamagitan ng katuwiran ng puso, pagka aking natutuhan ang mga matuwid mong kahatulan."
            },
            {
              "chapter": 119,
              "verse": 8,
              "name": "Mga Awit 119:8",
              "text": "Aking tutuparin ang mga palatuntunan mo: Oh huwag mo akong pabayaang lubos."
            },
            {
              "chapter": 119,
              "verse": 9,
              "name": "Mga Awit 119:9",
              "text": "Sa paano lilinisin ng isang binata ang kaniyang daan? Sa pagdinig doon ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 10,
              "name": "Mga Awit 119:10",
              "text": "Hinanap kita ng aking buong puso: Oh huwag nawa akong malihis sa iyong mga utos."
            },
            {
              "chapter": 119,
              "verse": 11,
              "name": "Mga Awit 119:11",
              "text": "Ang salita mo'y aking iningatan sa aking puso: upang huwag akong magkasala laban sa iyo."
            },
            {
              "chapter": 119,
              "verse": 12,
              "name": "Mga Awit 119:12",
              "text": "Mapalad ka, Oh Panginoon: ituro mo sa akin ang mga palatuntunan mo."
            },
            {
              "chapter": 119,
              "verse": 13,
              "name": "Mga Awit 119:13",
              "text": "Aking ipinahayag ng aking mga labi ang lahat ng mga kahatulan ng iyong bibig."
            },
            {
              "chapter": 119,
              "verse": 14,
              "name": "Mga Awit 119:14",
              "text": "Ako'y nagalak sa daan ng iyong mga patotoo, na gaya ng lahat na kayamanan."
            },
            {
              "chapter": 119,
              "verse": 15,
              "name": "Mga Awit 119:15",
              "text": "Ako'y magbubulay sa iyong mga tuntunin, at gagalang sa iyong mga daan."
            },
            {
              "chapter": 119,
              "verse": 16,
              "name": "Mga Awit 119:16",
              "text": "Ako'y magaaliw sa iyong mga palatuntunan: hindi ko kalilimutan ang iyong salita."
            },
            {
              "chapter": 119,
              "verse": 17,
              "name": "Mga Awit 119:17",
              "text": "Gawan ng mabuti ang iyong lingkod, upang ako'y mabuhay; sa gayo'y aking susundin ang iyong salita."
            },
            {
              "chapter": 119,
              "verse": 18,
              "name": "Mga Awit 119:18",
              "text": "Idilat mo ang aking mga mata, upang ako'y makakita ng kagilagilalas na mga bagay sa iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 19,
              "name": "Mga Awit 119:19",
              "text": "Ako'y nakikipamayan sa lupa: huwag mong ikubli ang mga utos mo sa akin."
            },
            {
              "chapter": 119,
              "verse": 20,
              "name": "Mga Awit 119:20",
              "text": "Ang puso ko'y nadudurog sa pananabik na tinatamo sa iyong mga kahatulan sa lahat ng panahon."
            },
            {
              "chapter": 119,
              "verse": 21,
              "name": "Mga Awit 119:21",
              "text": "Iyong sinaway ang mga palalong sinumpa, na nagsisihiwalay sa iyong mga utos."
            },
            {
              "chapter": 119,
              "verse": 22,
              "name": "Mga Awit 119:22",
              "text": "Alisin mo sa akin ang kadustaan at kakutyaan; sapagka't iningatan ko ang iyong mga patotoo."
            },
            {
              "chapter": 119,
              "verse": 23,
              "name": "Mga Awit 119:23",
              "text": "Mga pangulo naman ay nagsiupo, at naguusap ng laban sa akin; nguni't ang lingkod mo'y nagbulay sa iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 24,
              "name": "Mga Awit 119:24",
              "text": "Ang mga patotoo mo naman ay aking mga kaluguran at aking mga tagapayo."
            },
            {
              "chapter": 119,
              "verse": 25,
              "name": "Mga Awit 119:25",
              "text": "Ang kaluluwa ko'y dumidikit sa alabok: buhayin mo ako ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 26,
              "name": "Mga Awit 119:26",
              "text": "Aking ipinahayag ang mga lakad ko, at ikaw ay sumagot sa akin: ituro mo sa akin ang mga palatuntunan mo."
            },
            {
              "chapter": 119,
              "verse": 27,
              "name": "Mga Awit 119:27",
              "text": "Ipaunawa mo sa akin ang daan ng iyong mga tuntunin: sa gayo'y aking bubulayin ang iyong kagilagilalas na mga gawa."
            },
            {
              "chapter": 119,
              "verse": 28,
              "name": "Mga Awit 119:28",
              "text": "Ang kaluluwa ko'y natutunaw sa kabigatan ng loob: iyong palakasin ako ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 29,
              "name": "Mga Awit 119:29",
              "text": "Ilayo mo sa akin ang daan ng kasinungalingan: at ipagkaloob mo sa aking may pagbibiyaya ang iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 30,
              "name": "Mga Awit 119:30",
              "text": "Aking pinili ang daan ng pagtatapat: ang mga kahatulan mo'y inilagay ko sa harap ko."
            },
            {
              "chapter": 119,
              "verse": 31,
              "name": "Mga Awit 119:31",
              "text": "Ako'y kumapit sa iyong mga patotoo: Oh Panginoon, huwag mo akong ilagay sa kahihiyan."
            },
            {
              "chapter": 119,
              "verse": 32,
              "name": "Mga Awit 119:32",
              "text": "Aking tatakbuhan ang daan ng iyong mga utos, pagka iyong pinalaki ang aking puso."
            },
            {
              "chapter": 119,
              "verse": 33,
              "name": "Mga Awit 119:33",
              "text": "Ituro mo sa akin, Oh Panginoon, ang daan ng iyong mga palatuntunan; at aking iingatan hanggang sa wakas."
            },
            {
              "chapter": 119,
              "verse": 34,
              "name": "Mga Awit 119:34",
              "text": "Bigyan mo ako ng pagkaunawa at aking iingatan ang iyong kautusan; Oo, aking susundin ng aking buong puso."
            },
            {
              "chapter": 119,
              "verse": 35,
              "name": "Mga Awit 119:35",
              "text": "Payaunin mo ako sa landas ng iyong mga utos; sapagka't siya kong kinaaliwan."
            },
            {
              "chapter": 119,
              "verse": 36,
              "name": "Mga Awit 119:36",
              "text": "Ikiling mo ang aking puso sa iyong mga patotoo, at huwag sa kasakiman."
            },
            {
              "chapter": 119,
              "verse": 37,
              "name": "Mga Awit 119:37",
              "text": "Alisin mo ang aking mga mata sa pagtingin ng walang kabuluhan. At buhayin mo ako sa iyong mga daan."
            },
            {
              "chapter": 119,
              "verse": 38,
              "name": "Mga Awit 119:38",
              "text": "Papagtibayin mo ang iyong salita sa iyong lingkod, na ukol sa takot sa iyo."
            },
            {
              "chapter": 119,
              "verse": 39,
              "name": "Mga Awit 119:39",
              "text": "Alisin mo ang aking kadustaan na aking kinatatakutan: sapagka't ang mga kahatulan mo'y mabuti."
            },
            {
              "chapter": 119,
              "verse": 40,
              "name": "Mga Awit 119:40",
              "text": "Narito, ako'y nanabik sa iyong mga tuntunin; buhayin mo ako sa iyong katuwiran."
            },
            {
              "chapter": 119,
              "verse": 41,
              "name": "Mga Awit 119:41",
              "text": "Padatingin mo rin sa akin ang iyong mga kagandahang-loob, Oh Panginoon, sa makatuwid baga'y ang iyong kaligtasan, ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 42,
              "name": "Mga Awit 119:42",
              "text": "Sa gayo'y magkakaroon ako ng kasagutan sa kaniya na dumuduwahagi sa akin; sapagka't ako'y tumitiwala sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 43,
              "name": "Mga Awit 119:43",
              "text": "At huwag mong lubos na kunin ang salita ng katotohanan sa aking bibig; sapagka't ako'y umasa sa iyong mga kahatulan."
            },
            {
              "chapter": 119,
              "verse": 44,
              "name": "Mga Awit 119:44",
              "text": "Gayon ko susundin ang iyong kautusan na palagi magpakailan-kailan pa man."
            },
            {
              "chapter": 119,
              "verse": 45,
              "name": "Mga Awit 119:45",
              "text": "At lalakad ako sa kalayaan; sapagka't aking hinanap ang iyong mga tuntunin."
            },
            {
              "chapter": 119,
              "verse": 46,
              "name": "Mga Awit 119:46",
              "text": "Ako nama'y magsasalita ng iyong mga patotoo sa harap ng mga hari, at hindi ako mapapahiya."
            },
            {
              "chapter": 119,
              "verse": 47,
              "name": "Mga Awit 119:47",
              "text": "At ako'y maaaliw sa iyong mga utos, na aking iniibig."
            },
            {
              "chapter": 119,
              "verse": 48,
              "name": "Mga Awit 119:48",
              "text": "Akin namang itataas ang aking mga kamay sa iyong mga utos, na aking inibig; at ako'y magbubulay sa iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 49,
              "name": "Mga Awit 119:49",
              "text": "Iyong alalahanin ang salita sa iyong lingkod, na doo'y iyong pinaasa ako."
            },
            {
              "chapter": 119,
              "verse": 50,
              "name": "Mga Awit 119:50",
              "text": "Ito'y aking kaaliwan sa aking pagkapighati: sapagka't binuhay ako ng iyong salita."
            },
            {
              "chapter": 119,
              "verse": 51,
              "name": "Mga Awit 119:51",
              "text": "Ang palalo ay dumuwahaging mainam sa akin: gayon ma'y hindi ako hihiwalay sa iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 52,
              "name": "Mga Awit 119:52",
              "text": "Aking inalaala ang mga kahatulan mo ng una, Oh Panginoon, at ako'y nagaliw sa sarili."
            },
            {
              "chapter": 119,
              "verse": 53,
              "name": "Mga Awit 119:53",
              "text": "Maalab na galit ang humawak sa akin, dahil sa masama na nagpabaya ng iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 54,
              "name": "Mga Awit 119:54",
              "text": "Ang iyong mga palatuntunan ay naging aking mga awit sa bahay ng aking pangingibang bayan."
            },
            {
              "chapter": 119,
              "verse": 55,
              "name": "Mga Awit 119:55",
              "text": "Aking inalaala sa gabi ang pangalan mo, Oh Panginoon, at sinunod ko ang iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 56,
              "name": "Mga Awit 119:56",
              "text": "Ito ang tinamo ko, sapagka't aking iningatan ang mga tuntunin mo."
            },
            {
              "chapter": 119,
              "verse": 57,
              "name": "Mga Awit 119:57",
              "text": "Ang Panginoon ay aking bahagi: aking sinabi na aking tutuparin ang iyong mga salita."
            },
            {
              "chapter": 119,
              "verse": 58,
              "name": "Mga Awit 119:58",
              "text": "Aking hiniling ang iyong biyaya ng aking buong puso: magmahabagin ka sa akin ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 59,
              "name": "Mga Awit 119:59",
              "text": "Ako'y nagiisip sa aking mga lakad, at ibinalik ko ang aking mga paa sa iyong mga patotoo."
            },
            {
              "chapter": 119,
              "verse": 60,
              "name": "Mga Awit 119:60",
              "text": "Ako'y nagmadali, at hindi ako nagmakupad, na sundin ang iyong mga utos."
            },
            {
              "chapter": 119,
              "verse": 61,
              "name": "Mga Awit 119:61",
              "text": "Pinuluputan ako ng mga panali ng masama; nguni't hindi ko nilimot ang iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 62,
              "name": "Mga Awit 119:62",
              "text": "Sa hating gabi ay babangon ako upang magpasalamat sa iyo, dahil sa iyong mga matuwid na kahatulan."
            },
            {
              "chapter": 119,
              "verse": 63,
              "name": "Mga Awit 119:63",
              "text": "Ako'y kasama ng lahat na nangatatakot sa iyo, at ng nagsisitupad ng iyong mga tuntunin."
            },
            {
              "chapter": 119,
              "verse": 64,
              "name": "Mga Awit 119:64",
              "text": "Ang lupa, Oh Panginoon, ay puno ng iyong kagandahang-loob: ituro mo sa akin ang iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 65,
              "name": "Mga Awit 119:65",
              "text": "Ginawan mo ng mabuti ang iyong lingkod, Oh Panginoon, ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 66,
              "name": "Mga Awit 119:66",
              "text": "Turuan mo ako ng mabuting kahatulan at kaalaman; sapagka't ako'y sumampalataya sa iyong mga utos."
            },
            {
              "chapter": 119,
              "verse": 67,
              "name": "Mga Awit 119:67",
              "text": "Bago ako nagdalamhati ay naligaw ako; nguni't ngayo'y tinutupad ko ang iyong salita."
            },
            {
              "chapter": 119,
              "verse": 68,
              "name": "Mga Awit 119:68",
              "text": "Ikaw ay mabuti, at gumagawa ng mabuti; ituro mo sa akin ang iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 69,
              "name": "Mga Awit 119:69",
              "text": "Ang palalo ay kumatha ng kabulaanan laban sa akin: aking tutuparin ang iyong mga tuntunin ng buong puso ko."
            },
            {
              "chapter": 119,
              "verse": 70,
              "name": "Mga Awit 119:70",
              "text": "Ang puso nila ay matabang gaya ng sebo; nguni't ako'y naaaliw sa iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 71,
              "name": "Mga Awit 119:71",
              "text": "Mabuti sa akin na ako'y napighati; upang aking matutuhan ang mga palatuntunan mo."
            },
            {
              "chapter": 119,
              "verse": 72,
              "name": "Mga Awit 119:72",
              "text": "Ang kautusan ng iyong bibig ay lalong mabuti sa akin kay sa libong ginto at pilak."
            },
            {
              "chapter": 119,
              "verse": 73,
              "name": "Mga Awit 119:73",
              "text": "Ginawa ako at inanyuan ako ng iyong mga kamay: bigyan mo ako ng unawa, upang matutuhan ko ang iyong mga utos."
            },
            {
              "chapter": 119,
              "verse": 74,
              "name": "Mga Awit 119:74",
              "text": "Silang nangatatakot sa iyo ay makikita ako, at matutuwa; sapagka't ako'y umasa sa iyong salita;"
            },
            {
              "chapter": 119,
              "verse": 75,
              "name": "Mga Awit 119:75",
              "text": "Talastas ko, Oh Panginoon na ang mga kahatulan mo ay matuwid, at sa pagtatapat, iyo akong dinalamhati."
            },
            {
              "chapter": 119,
              "verse": 76,
              "name": "Mga Awit 119:76",
              "text": "Isinasamo ko sa iyo na maging kaaliwan ko ang iyong kagandahang-loob, ayon sa iyong salita sa iyong lingkod."
            },
            {
              "chapter": 119,
              "verse": 77,
              "name": "Mga Awit 119:77",
              "text": "Dumating nawa sa akin ang iyong malumanay na kaawaan upang ako'y mabuhay: sapagka't ang kautusan mo'y aking kaaliwan."
            },
            {
              "chapter": 119,
              "verse": 78,
              "name": "Mga Awit 119:78",
              "text": "Mahiya ang palalo; sapagka't dinaig nila ako ng walang kadahilanan: nguni't ako'y magbubulay sa iyong mga tuntunin."
            },
            {
              "chapter": 119,
              "verse": 79,
              "name": "Mga Awit 119:79",
              "text": "Bumalik nawa sa akin yaong nangatatakot sa iyo, at silang nangakakakilala ng iyong mga patotoo."
            },
            {
              "chapter": 119,
              "verse": 80,
              "name": "Mga Awit 119:80",
              "text": "Maging sakdal nawa ang aking puso sa iyong mga palatuntunan; upang huwag akong mapahiya."
            },
            {
              "chapter": 119,
              "verse": 81,
              "name": "Mga Awit 119:81",
              "text": "Pinanglulupaypayan ng aking kaluluwa ang iyong pagliligtas: nguni't umaasa ako sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 82,
              "name": "Mga Awit 119:82",
              "text": "Pinangangalumatahan ng aking mga mata ang iyong salita, samantalang aking sinasabi, Kailan mo ako aaliwin?"
            },
            {
              "chapter": 119,
              "verse": 83,
              "name": "Mga Awit 119:83",
              "text": "Sapagka't ako'y naging parang balat na lalagyan ng alak sa usok; gayon ma'y hindi ko kinalilimutan ang iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 84,
              "name": "Mga Awit 119:84",
              "text": "Gaano karami ang mga kaarawan ng iyong lingkod? Kailan ka gagawa ng kahatulan sa kanila na nagsisiusig sa akin?"
            },
            {
              "chapter": 119,
              "verse": 85,
              "name": "Mga Awit 119:85",
              "text": "Inihukay ako ng palalo ng mga lungaw na hindi mga ayon sa iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 86,
              "name": "Mga Awit 119:86",
              "text": "Lahat mong mga utos ay tapat. Kanilang inuusig ako na may kamalian; tulungan mo ako."
            },
            {
              "chapter": 119,
              "verse": 87,
              "name": "Mga Awit 119:87",
              "text": "Kanilang tinunaw ako halos sa ibabaw ng lupa; nguni't hindi ko pinabayaan ang mga tuntunin mo."
            },
            {
              "chapter": 119,
              "verse": 88,
              "name": "Mga Awit 119:88",
              "text": "Buhayin mo ako ayon sa iyong kagandahang-loob; sa gayo'y aking iingatan ang patotoo ng iyong bibig."
            },
            {
              "chapter": 119,
              "verse": 89,
              "name": "Mga Awit 119:89",
              "text": "Magpakailan man, Oh Panginoon, ang iyong salita ay natatag sa langit."
            },
            {
              "chapter": 119,
              "verse": 90,
              "name": "Mga Awit 119:90",
              "text": "Ang iyong pagtatapat ay sa lahat ng sali't saling lahi: iyong itinatag ang lupa, at lumalagi."
            },
            {
              "chapter": 119,
              "verse": 91,
              "name": "Mga Awit 119:91",
              "text": "Namamalagi sa araw na ito ayon sa iyong mga alituntunin; sapagka't lahat ng bagay ay mga lingkod mo."
            },
            {
              "chapter": 119,
              "verse": 92,
              "name": "Mga Awit 119:92",
              "text": "Kundi ang kautusan mo'y naging aking kaaliwan, namatay nga sana ako sa aking kadalamhatian."
            },
            {
              "chapter": 119,
              "verse": 93,
              "name": "Mga Awit 119:93",
              "text": "Hindi ko kalilimutan kailan man ang mga tuntunin mo; sapagka't sa pamamagitan ng mga yaon ay binuhay mo ako."
            },
            {
              "chapter": 119,
              "verse": 94,
              "name": "Mga Awit 119:94",
              "text": "Ako'y iyo, iligtas mo ako, sapagka't aking hinanap ang mga tuntunin mo,"
            },
            {
              "chapter": 119,
              "verse": 95,
              "name": "Mga Awit 119:95",
              "text": "Inabatan ako ng masama upang ako'y patayin; nguni't aking gugunitain ang iyong mga patotoo."
            },
            {
              "chapter": 119,
              "verse": 96,
              "name": "Mga Awit 119:96",
              "text": "Aking nakita ang wakas ng buong kasakdalan; nguni't ang utos mo'y totoong malawak."
            },
            {
              "chapter": 119,
              "verse": 97,
              "name": "Mga Awit 119:97",
              "text": "Oh gaanong iniibig ko ang iyong kautusan! Siya kong gunita buong araw."
            },
            {
              "chapter": 119,
              "verse": 98,
              "name": "Mga Awit 119:98",
              "text": "Pinarunong ako kay sa aking mga kaaway ng iyong mga utos; sapagka't mga laging sumasa akin."
            },
            {
              "chapter": 119,
              "verse": 99,
              "name": "Mga Awit 119:99",
              "text": "Ako'y may higit na unawa kay sa lahat ng tagapagturo sa akin; sapagka't ang iyong mga patotoo ay gunita ko."
            },
            {
              "chapter": 119,
              "verse": 100,
              "name": "Mga Awit 119:100",
              "text": "Ako'y nakakaunawa na higit kay sa may katandaan, sapagka't aking iningatan ang mga tuntunin mo."
            },
            {
              "chapter": 119,
              "verse": 101,
              "name": "Mga Awit 119:101",
              "text": "Aking pinigil ang mga paa ko sa lahat ng masamang lakad, upang aking masunod ang salita mo."
            },
            {
              "chapter": 119,
              "verse": 102,
              "name": "Mga Awit 119:102",
              "text": "Ako'y hindi lumihis sa iyong mga kahatulan; sapagka't iyong tinuruan ako."
            },
            {
              "chapter": 119,
              "verse": 103,
              "name": "Mga Awit 119:103",
              "text": "Pagkatamis ng iyong mga salita sa aking lasa! Oo, matamis kay sa pulot sa aking bibig!"
            },
            {
              "chapter": 119,
              "verse": 104,
              "name": "Mga Awit 119:104",
              "text": "Sa iyong mga tuntunin ay nagkakamit ako ng unawa: kaya't aking ipinagtatanim ang bawa't lakad na sinungaling."
            },
            {
              "chapter": 119,
              "verse": 105,
              "name": "Mga Awit 119:105",
              "text": "Ang salita mo'y ilawan sa aking mga paa, at liwanag sa aking landas."
            },
            {
              "chapter": 119,
              "verse": 106,
              "name": "Mga Awit 119:106",
              "text": "Ako'y sumumpa, at pinagtibay ko, na aking tutuparin ang mga matuwid mong kahatulan."
            },
            {
              "chapter": 119,
              "verse": 107,
              "name": "Mga Awit 119:107",
              "text": "Ako'y nagdadalamhating mainam: buhayin mo ako, Oh Panginoon, ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 108,
              "name": "Mga Awit 119:108",
              "text": "Tanggapin mo, isinasamo ko sa iyo, ang mga kusang handog ng aking bibig, Oh Panginoon, at ituro mo sa akin ang mga kahatulan mo."
            },
            {
              "chapter": 119,
              "verse": 109,
              "name": "Mga Awit 119:109",
              "text": "Ang kaluluwa ko'y laging nasa aking kamay; gayon ma'y hindi ko kinalilimutan ang kautusan mo."
            },
            {
              "chapter": 119,
              "verse": 110,
              "name": "Mga Awit 119:110",
              "text": "Ipinaglagay ako ng silo ng masama; gayon ma'y hindi ako lumihis sa iyong mga tuntunin."
            },
            {
              "chapter": 119,
              "verse": 111,
              "name": "Mga Awit 119:111",
              "text": "Ang mga patotoo mo'y inari kong pinakamana magpakailanman; sapagka't sila ang kagalakan ng aking puso."
            },
            {
              "chapter": 119,
              "verse": 112,
              "name": "Mga Awit 119:112",
              "text": "Ikiniling ko ang puso ko na ganapin ang mga palatuntunan mo, magpakailan man, sa makatuwid baga'y hanggang sa wakas."
            },
            {
              "chapter": 119,
              "verse": 113,
              "name": "Mga Awit 119:113",
              "text": "Ipinagtatanim ko sila na may salawahang pagiisip; nguni't ang iyong kautusan ay iniibig ko."
            },
            {
              "chapter": 119,
              "verse": 114,
              "name": "Mga Awit 119:114",
              "text": "Ikaw ang kublihan kong dako at kalasag ko: ako'y umaasa sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 115,
              "name": "Mga Awit 119:115",
              "text": "Magsihiwalay kayo sa akin, kayong mga manggagawa ng kasamaan; upang aking maingatan ang mga utos ng aking Dios."
            },
            {
              "chapter": 119,
              "verse": 116,
              "name": "Mga Awit 119:116",
              "text": "Alalayan mo ako ayon sa iyong salita, upang ako'y mabuhay; at huwag mo akong hiyain sa aking pagasa."
            },
            {
              "chapter": 119,
              "verse": 117,
              "name": "Mga Awit 119:117",
              "text": "Alalayan mo ako, at ako'y maliligtas, at magkakaroon ako ng laging pitagan sa iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 118,
              "name": "Mga Awit 119:118",
              "text": "Inilagay mo sa wala silang lahat na naliligaw sa iyong mga palatuntunan; sapagka't ang kanilang pagdaraya ay kasinungalingan."
            },
            {
              "chapter": 119,
              "verse": 119,
              "name": "Mga Awit 119:119",
              "text": "Inaalis mo ang lahat ng masama sa lupa na gaya ng taing bakal; kaya't iniibig ko ang mga patotoo mo."
            },
            {
              "chapter": 119,
              "verse": 120,
              "name": "Mga Awit 119:120",
              "text": "Ang laman ko'y nanginginig dahil sa takot sa iyo; at ako'y takot sa iyong mga kahatulan."
            },
            {
              "chapter": 119,
              "verse": 121,
              "name": "Mga Awit 119:121",
              "text": "Ako'y gumawa ng kahatulan at kaganapan: huwag mo akong iwan sa mga mangaapi sa akin."
            },
            {
              "chapter": 119,
              "verse": 122,
              "name": "Mga Awit 119:122",
              "text": "Maging tagapatnugot ka ng iyong lingkod sa ikabubuti: huwag mong ipapighati ako sa palalo."
            },
            {
              "chapter": 119,
              "verse": 123,
              "name": "Mga Awit 119:123",
              "text": "Pinangangalumatahan ng aking mga mata ang iyong pagliligtas, at ang iyong matuwid na salita."
            },
            {
              "chapter": 119,
              "verse": 124,
              "name": "Mga Awit 119:124",
              "text": "Gawan mo ang lingkod mo ng ayon sa iyong kagandahang-loob, at ituro mo sa akin ang mga palatuntunan mo."
            },
            {
              "chapter": 119,
              "verse": 125,
              "name": "Mga Awit 119:125",
              "text": "Ako'y lingkod mo; bigyan mo ako ng unawa; upang aking maalaman ang mga patotoo mo,"
            },
            {
              "chapter": 119,
              "verse": 126,
              "name": "Mga Awit 119:126",
              "text": "Kapanahunan sa Panginoon na gumawa; sapagka't kanilang niwalang kabuluhan ang kautusan mo."
            },
            {
              "chapter": 119,
              "verse": 127,
              "name": "Mga Awit 119:127",
              "text": "Kaya't aking iniibig ang mga utos mo ng higit sa ginto, oo, higit sa dalisay na ginto."
            },
            {
              "chapter": 119,
              "verse": 128,
              "name": "Mga Awit 119:128",
              "text": "Kaya't aking pinahahalagahan na matuwid ang lahat mong mga tuntunin tungkol sa lahat ng mga bagay; at ipinagtatanim ko ang bawa't sinungaling na lakad."
            },
            {
              "chapter": 119,
              "verse": 129,
              "name": "Mga Awit 119:129",
              "text": "Ang mga patotoo mo'y kagilagilalas; kayat sila'y iniingatan ng aking kaluluwa."
            },
            {
              "chapter": 119,
              "verse": 130,
              "name": "Mga Awit 119:130",
              "text": "Ang bukas ng iyong mga salita ay nagbibigay ng liwanag; nagbibigay ng unawa sa walang muwang."
            },
            {
              "chapter": 119,
              "verse": 131,
              "name": "Mga Awit 119:131",
              "text": "Aking binuka ng maluwang ang bibig ko, at ako'y nagbuntong-hininga; sapagka't aking pinanabikan ang mga utos mo."
            },
            {
              "chapter": 119,
              "verse": 132,
              "name": "Mga Awit 119:132",
              "text": "Manumbalik ka sa akin, at maawa ka sa akin, gaya ng iyong kinauugaliang gawin sa nagsisiibig ng iyong pangalan."
            },
            {
              "chapter": 119,
              "verse": 133,
              "name": "Mga Awit 119:133",
              "text": "Itatag mo ang mga hakbang ko sa iyong salita; at huwag magkaroon ng kapangyarihan sa akin ang anomang kasamaan."
            },
            {
              "chapter": 119,
              "verse": 134,
              "name": "Mga Awit 119:134",
              "text": "Tubusin mo ako sa pagpighati ng tao: sa gayo'y aking tutuparin ang mga tuntunin mo."
            },
            {
              "chapter": 119,
              "verse": 135,
              "name": "Mga Awit 119:135",
              "text": "Pasilangin mo ang mukha mo sa iyong lingkod; at ituro mo sa akin ang mga palatuntunan mo."
            },
            {
              "chapter": 119,
              "verse": 136,
              "name": "Mga Awit 119:136",
              "text": "Ang mga mata ko'y nagsisiagos ng mga ilog ng tubig; sapagka't hindi nila tinutupad ang kautusan mo."
            },
            {
              "chapter": 119,
              "verse": 137,
              "name": "Mga Awit 119:137",
              "text": "Matuwid ka, Oh Panginoon, at matuwid ang mga kahatulan mo."
            },
            {
              "chapter": 119,
              "verse": 138,
              "name": "Mga Awit 119:138",
              "text": "Iniutos mo ang mga patotoo mo sa katuwiran at totoong may pagtatapat."
            },
            {
              "chapter": 119,
              "verse": 139,
              "name": "Mga Awit 119:139",
              "text": "Tinunaw ako ng aking sikap, sapagka't kinalimutan ng aking mga kaaway ang mga salita mo."
            },
            {
              "chapter": 119,
              "verse": 140,
              "name": "Mga Awit 119:140",
              "text": "Ang salita mo'y totoong malinis; kaya't iniibig ito ng iyong lingkod."
            },
            {
              "chapter": 119,
              "verse": 141,
              "name": "Mga Awit 119:141",
              "text": "Ako'y maliit at hinahamak: gayon ma'y hindi ko kinalilimutan ang mga tuntunin mo."
            },
            {
              "chapter": 119,
              "verse": 142,
              "name": "Mga Awit 119:142",
              "text": "Ang katuwiran mo ay walang hanggang katuwiran, at ang kautusan mo'y katotohanan."
            },
            {
              "chapter": 119,
              "verse": 143,
              "name": "Mga Awit 119:143",
              "text": "Kabagabagan at kahirapan ay humawak sa akin: gayon ma'y ang mga utos mo'y aking kaaliwan."
            },
            {
              "chapter": 119,
              "verse": 144,
              "name": "Mga Awit 119:144",
              "text": "Ang mga patotoo mo'y matuwid magpakailan man: bigyan mo ako ng unawa at mabubuhay ako."
            },
            {
              "chapter": 119,
              "verse": 145,
              "name": "Mga Awit 119:145",
              "text": "Ako'y tumawag ng aking buong puso; sagutin mo ako, Oh Panginoon: iingatan ko ang iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 146,
              "name": "Mga Awit 119:146",
              "text": "Ako'y tumawag sa iyo; iligtas mo ako, at aking tutuparin ang mga patotoo mo."
            },
            {
              "chapter": 119,
              "verse": 147,
              "name": "Mga Awit 119:147",
              "text": "Ako'y nagpauna sa bukang-liwayway ng umaga, at dumaing ako: ako'y umasa sa iyong mga salita."
            },
            {
              "chapter": 119,
              "verse": 148,
              "name": "Mga Awit 119:148",
              "text": "Ang mga mata ko'y nanguna sa mga pagpupuyat sa gabi, upang aking magunita ang salita mo."
            },
            {
              "chapter": 119,
              "verse": 149,
              "name": "Mga Awit 119:149",
              "text": "Dinggin mo ang tinig ko ayon sa iyong kagandahang-loob: buhayin mo ako, Oh Panginoon, ayon sa iyong mga kahatulan."
            },
            {
              "chapter": 119,
              "verse": 150,
              "name": "Mga Awit 119:150",
              "text": "Silang nagsisisunod sa kasamaan ay nagsisilapit; sila'y malayo sa iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 151,
              "name": "Mga Awit 119:151",
              "text": "Ikaw ay malapit, Oh Panginoon; at lahat mong utos ay katotohanan."
            },
            {
              "chapter": 119,
              "verse": 152,
              "name": "Mga Awit 119:152",
              "text": "Nang una'y nakaunawa ako sa iyong mga patotoo, na iyong pinamalagi magpakailan man."
            },
            {
              "chapter": 119,
              "verse": 153,
              "name": "Mga Awit 119:153",
              "text": "Pakundanganan mo ang aking kadalamhatian at iligtas mo ako; sapagka't hindi ko kinalilimutan ang iyong kautusan."
            },
            {
              "chapter": 119,
              "verse": 154,
              "name": "Mga Awit 119:154",
              "text": "Ipaglaban mo ang aking usap, at iligtas mo ako: buhayin mo ako ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 155,
              "name": "Mga Awit 119:155",
              "text": "Kaligtasan ay malayo sa masama; sapagka't hindi nila hinahanap ang mga palatuntunan mo."
            },
            {
              "chapter": 119,
              "verse": 156,
              "name": "Mga Awit 119:156",
              "text": "Dakila ang mga malumanay mong kaawaan, Oh Panginoon: buhayin mo ako ayon sa iyong mga kahatulan."
            },
            {
              "chapter": 119,
              "verse": 157,
              "name": "Mga Awit 119:157",
              "text": "Marami ang mga manguusig sa akin at mga kaaway ko; gayon ma'y hindi ako humiwalay sa iyong mga patotoo."
            },
            {
              "chapter": 119,
              "verse": 158,
              "name": "Mga Awit 119:158",
              "text": "Aking namasdan ang mga magdarayang manggagawa at ako'y namanglaw; sapagka't hindi nila sinusunod ang salita mo."
            },
            {
              "chapter": 119,
              "verse": 159,
              "name": "Mga Awit 119:159",
              "text": "Dilidilihin mo kung gaano iniibig ko ang mga utos mo: buhayin mo ako, Oh Panginoon, ayon sa iyong kagandahang-loob."
            },
            {
              "chapter": 119,
              "verse": 160,
              "name": "Mga Awit 119:160",
              "text": "Ang kabuoan ng iyong salita ay katotohanan; at bawa't isa ng iyong matutuwid na kahatulan ay magpakailan man."
            },
            {
              "chapter": 119,
              "verse": 161,
              "name": "Mga Awit 119:161",
              "text": "Inusig ako ng mga pangulo ng walang kadahilanan; nguni't ang puso ko'y nanginginig sa iyong mga salita."
            },
            {
              "chapter": 119,
              "verse": 162,
              "name": "Mga Awit 119:162",
              "text": "Ako'y nagagalak sa iyong salita, na parang nakakasumpong ng malaking samsam."
            },
            {
              "chapter": 119,
              "verse": 163,
              "name": "Mga Awit 119:163",
              "text": "Aking pinagtataniman at kinasusuklaman ang pagsisinungaling; nguni't ang kautusan mo'y aking iniibig."
            },
            {
              "chapter": 119,
              "verse": 164,
              "name": "Mga Awit 119:164",
              "text": "Makapito sa isang araw na pumupuri ako sa iyo, dahil sa iyong matutuwid na kahatulan."
            },
            {
              "chapter": 119,
              "verse": 165,
              "name": "Mga Awit 119:165",
              "text": "Dakilang kapayapaan ang tinatamo nila na nagsisiibig ng iyong kautusan. At sila'y walang kadahilanang ikatitisod."
            },
            {
              "chapter": 119,
              "verse": 166,
              "name": "Mga Awit 119:166",
              "text": "Ako'y umasa sa iyong pagliligtas, Oh Panginoon. At ginawa ko ang mga utos mo."
            },
            {
              "chapter": 119,
              "verse": 167,
              "name": "Mga Awit 119:167",
              "text": "Sinunod ng aking kaluluwa ang mga patotoo mo; at iniibig kong mainam,"
            },
            {
              "chapter": 119,
              "verse": 168,
              "name": "Mga Awit 119:168",
              "text": "Aking tinupad ang iyong mga tuntunin at ang iyong mga patotoo; sapagka't lahat ng aking lakad ay nasa harap mo."
            },
            {
              "chapter": 119,
              "verse": 169,
              "name": "Mga Awit 119:169",
              "text": "Dumating nawa sa harap mo ang aking daing, Oh Panginoon: bigyan mo ako ng unawa ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 170,
              "name": "Mga Awit 119:170",
              "text": "Dumating nawa sa harap mo ang aking pamanhik: iligtas mo ako ayon sa iyong salita."
            },
            {
              "chapter": 119,
              "verse": 171,
              "name": "Mga Awit 119:171",
              "text": "Tulutang magbadya ng pagpuri ang aking mga labi; sapagka't itinuturo mo sa akin ang iyong mga palatuntunan."
            },
            {
              "chapter": 119,
              "verse": 172,
              "name": "Mga Awit 119:172",
              "text": "Awitin ng aking dila ang iyong salita; sapagka't lahat ng mga utos mo ay katuwiran."
            },
            {
              "chapter": 119,
              "verse": 173,
              "name": "Mga Awit 119:173",
              "text": "Magsihanda nawa ang iyong kamay na tulungan ako; sapagka't aking pinili ang iyong mga tuntunin."
            },
            {
              "chapter": 119,
              "verse": 174,
              "name": "Mga Awit 119:174",
              "text": "Aking pinanabikan ang iyong pagliligtas, Oh Panginoon: at ang iyong kautusan ay aking kaaliwan."
            },
            {
              "chapter": 119,
              "verse": 175,
              "name": "Mga Awit 119:175",
              "text": "Mabuhay nawa ang aking kaluluwa, at pupuri sa iyo; at tulungan nawa ako ng iyong mga kahatulan."
            },
            {
              "chapter": 119,
              "verse": 176,
              "name": "Mga Awit 119:176",
              "text": "Ako'y naligaw na parang tupang nawala; hanapin mo ang iyong lingkod; sapagka't hindi ko kinalilimutan ang iyong mga utos."
            }
          ]
        },
        {
          "chapter": 120,
          "name": "Mga Awit 120",
          "verses": [
            {
              "chapter": 120,
              "verse": 1,
              "name": "Mga Awit 120:1",
              "text": "Sa aking kahirapan ay dumaing ako sa Panginoon, at sinagot niya ako."
            },
            {
              "chapter": 120,
              "verse": 2,
              "name": "Mga Awit 120:2",
              "text": "Iligtas mo ang aking kaluluwa, Oh Panginoon, sa mga sinungaling na labi, at mula sa magdarayang dila."
            },
            {
              "chapter": 120,
              "verse": 3,
              "name": "Mga Awit 120:3",
              "text": "Anong maibibigay sa iyo, at anong magagawa pa sa iyo, ikaw na magdarayang dila?"
            },
            {
              "chapter": 120,
              "verse": 4,
              "name": "Mga Awit 120:4",
              "text": "Mga hasang pana ng makapangyarihan, at mga baga ng enebro."
            },
            {
              "chapter": 120,
              "verse": 5,
              "name": "Mga Awit 120:5",
              "text": "Sa aba ko, na nakikipamayan sa Mesech, na tumatahan ako sa mga tolda sa Kedar!"
            },
            {
              "chapter": 120,
              "verse": 6,
              "name": "Mga Awit 120:6",
              "text": "Malaon ng tinatahanan ng aking kaluluwa na kasama niyang nagtatanim sa kapayapaan."
            },
            {
              "chapter": 120,
              "verse": 7,
              "name": "Mga Awit 120:7",
              "text": "Ako'y sa kapayapaan: nguni't pagka ako'y nagsasalita, sila'y sa pakikidigma."
            }
          ]
        },
        {
          "chapter": 121,
          "name": "Mga Awit 121",
          "verses": [
            {
              "chapter": 121,
              "verse": 1,
              "name": "Mga Awit 121:1",
              "text": "Ititingin ko ang aking mga mata sa mga bundok; saan baga manggagaling ang aking saklolo?"
            },
            {
              "chapter": 121,
              "verse": 2,
              "name": "Mga Awit 121:2",
              "text": "Ang saklolo sa akin ay nanggagaling sa Panginoon, na gumawa ng langit at lupa."
            },
            {
              "chapter": 121,
              "verse": 3,
              "name": "Mga Awit 121:3",
              "text": "Hindi niya titiising ang paa mo'y makilos: siyang nagiingat sa iyo, ay hindi iidlip."
            },
            {
              "chapter": 121,
              "verse": 4,
              "name": "Mga Awit 121:4",
              "text": "Narito, siyang nagiingat ng Israel hindi iidlip ni matutulog man."
            },
            {
              "chapter": 121,
              "verse": 5,
              "name": "Mga Awit 121:5",
              "text": "Ang Panginoon ay tagapagingat sa iyo: ang Panginoon ay lilim mo sa iyong kanan."
            },
            {
              "chapter": 121,
              "verse": 6,
              "name": "Mga Awit 121:6",
              "text": "Hindi ka sasaktan ng araw sa araw, ni ng buwan man sa gabi."
            },
            {
              "chapter": 121,
              "verse": 7,
              "name": "Mga Awit 121:7",
              "text": "Iingatan ka ng Panginoon sa lahat ng kasamaan; kaniyang iingatan ang iyong kaluluwa."
            },
            {
              "chapter": 121,
              "verse": 8,
              "name": "Mga Awit 121:8",
              "text": "Iingatan ng Panginoon ang iyong paglabas at ang iyong pagpasok, mula sa panahong ito at sa magpakailan pa man."
            }
          ]
        },
        {
          "chapter": 122,
          "name": "Mga Awit 122",
          "verses": [
            {
              "chapter": 122,
              "verse": 1,
              "name": "Mga Awit 122:1",
              "text": "Ako'y natutuwa nang kanilang sabihin sa akin, tayo'y magsiparoon sa bahay ng Panginoon."
            },
            {
              "chapter": 122,
              "verse": 2,
              "name": "Mga Awit 122:2",
              "text": "Ang mga paa natin ay nagsisitayo sa loob ng iyong mga pintuang-bayan, Oh Jerusalem;"
            },
            {
              "chapter": 122,
              "verse": 3,
              "name": "Mga Awit 122:3",
              "text": "Jerusalem, na natayo na parang bayang siksikan:"
            },
            {
              "chapter": 122,
              "verse": 4,
              "name": "Mga Awit 122:4",
              "text": "Na inaahon ng mga lipi, sa makatuwid baga'y ng mga lipi ng Panginoon, na pinaka patotoo sa Israel, upang magpasalamat sa pangalan ng Panginoon."
            },
            {
              "chapter": 122,
              "verse": 5,
              "name": "Mga Awit 122:5",
              "text": "Sapagka't doo'y nalagay ang mga luklukan na ukol sa kahatulan, ang mga luklukan ng sangbahayan ni David."
            },
            {
              "chapter": 122,
              "verse": 6,
              "name": "Mga Awit 122:6",
              "text": "Idalangin ninyo ang kapayapaan ng Jerusalem: sila'y magsisiginhawa na nagsisiibig sa iyo."
            },
            {
              "chapter": 122,
              "verse": 7,
              "name": "Mga Awit 122:7",
              "text": "Kapayapaan nawa ang sumaloob ng inyong mga kuta, at kaginhawahan sa loob ng iyong mga palasio."
            },
            {
              "chapter": 122,
              "verse": 8,
              "name": "Mga Awit 122:8",
              "text": "Dahil sa aking mga kapatid at aking mga kasama, aking sasabihin ngayon, kapayapaan ang sumaiyong loob."
            },
            {
              "chapter": 122,
              "verse": 9,
              "name": "Mga Awit 122:9",
              "text": "Dahil sa bahay ng Panginoon nating Dios. Hahanapin ko ang iyong buti."
            }
          ]
        },
        {
          "chapter": 123,
          "name": "Mga Awit 123",
          "verses": [
            {
              "chapter": 123,
              "verse": 1,
              "name": "Mga Awit 123:1",
              "text": "Sa iyo'y aking itinitingin ang mga mata ko, Oh sa iyo na nauupo sa mga langit."
            },
            {
              "chapter": 123,
              "verse": 2,
              "name": "Mga Awit 123:2",
              "text": "Narito, kung paanong tumitingin ang mga mata ng mga alipin sa kamay ng kanilang panginoon, kung paano ang mga mata ng alilang babae sa kamay ng kaniyang panginoong babae; gayon tumitingin ang mga mata namin sa Panginoon naming Dios, hanggang sa siya'y maawa sa amin."
            },
            {
              "chapter": 123,
              "verse": 3,
              "name": "Mga Awit 123:3",
              "text": "Maawa ka sa amin, Oh Panginoon, maawa ka sa amin: sapagka't kami ay lubhang lipos ng kadustaan."
            },
            {
              "chapter": 123,
              "verse": 4,
              "name": "Mga Awit 123:4",
              "text": "Ang aming kaluluwa'y lubhang lipos ng duwahagi ng mga tiwasay. At ng paghamak ng palalo."
            }
          ]
        },
        {
          "chapter": 124,
          "name": "Mga Awit 124",
          "verses": [
            {
              "chapter": 124,
              "verse": 1,
              "name": "Mga Awit 124:1",
              "text": "Kung hindi ang Panginoon ay naging kakampi natin, sabihin ng Israel ngayon,"
            },
            {
              "chapter": 124,
              "verse": 2,
              "name": "Mga Awit 124:2",
              "text": "Kung hindi ang Panginoon ay naging kakampi natin, nang ang mga tao ay magsibangon laban sa atin:"
            },
            {
              "chapter": 124,
              "verse": 3,
              "name": "Mga Awit 124:3",
              "text": "Nilamon nga nila sana tayong buhay, nang ang kanilang poot ay mangagalab laban sa atin:"
            },
            {
              "chapter": 124,
              "verse": 4,
              "name": "Mga Awit 124:4",
              "text": "Tinabunan nga sana tayo ng tubig, dinaanan nga sana ang ating kaluluwa ng agos:"
            },
            {
              "chapter": 124,
              "verse": 5,
              "name": "Mga Awit 124:5",
              "text": "Dinaanan nga sana ang ating kaluluwa ng mga palalong tubig."
            },
            {
              "chapter": 124,
              "verse": 6,
              "name": "Mga Awit 124:6",
              "text": "Purihin ang Panginoon, na hindi tayo ibinigay na pinaka huli sa kanilang mga ngipin."
            },
            {
              "chapter": 124,
              "verse": 7,
              "name": "Mga Awit 124:7",
              "text": "Ang kaluluwa natin ay nakatanan na parang ibon sa silo ng mga manghuhuli: ang silo ay nasira, at tayo ay nakatanan."
            },
            {
              "chapter": 124,
              "verse": 8,
              "name": "Mga Awit 124:8",
              "text": "Ang saklolo natin ay nasa pangalan ng Panginoon, na siyang gumawa ng langit at lupa."
            }
          ]
        },
        {
          "chapter": 125,
          "name": "Mga Awit 125",
          "verses": [
            {
              "chapter": 125,
              "verse": 1,
              "name": "Mga Awit 125:1",
              "text": "Silang nagsisitiwala sa Panginoon ay parang bundok ng Sion, na hindi maaaring makilos, kundi nananatili magpakailan man."
            },
            {
              "chapter": 125,
              "verse": 2,
              "name": "Mga Awit 125:2",
              "text": "Kung paanong ang mga bundok na nangasa palibot ng Jerusalem, gayon ang Panginoon sa palibot ng kaniyang bayan, mula sa panahong ito at sa magpakailan man."
            },
            {
              "chapter": 125,
              "verse": 3,
              "name": "Mga Awit 125:3",
              "text": "Sapagka't ang cetro ng kasamaan ay hindi bubuhatin sa mga matuwid; upang huwag iunat ng mga matuwid ang kanilang mga kamay sa kasamaan."
            },
            {
              "chapter": 125,
              "verse": 4,
              "name": "Mga Awit 125:4",
              "text": "Gawan mo ng mabuti, Oh Panginoon, yaong mabubuti, at yaong matutuwid sa kanilang mga puso."
            },
            {
              "chapter": 125,
              "verse": 5,
              "name": "Mga Awit 125:5",
              "text": "Nguni't sa nagsisiliko sa kanilang mga likong lakad, ilalabas ng Panginoon na kasama ng mga manggagawa ng kasamaan. Kapayapaan nawa ay suma Israel."
            }
          ]
        },
        {
          "chapter": 126,
          "name": "Mga Awit 126",
          "verses": [
            {
              "chapter": 126,
              "verse": 1,
              "name": "Mga Awit 126:1",
              "text": "Nang dalhin muli ng Panginoon yaong nangagbalik sa Sion, tayo ay gaya niyaong nangananaginip."
            },
            {
              "chapter": 126,
              "verse": 2,
              "name": "Mga Awit 126:2",
              "text": "Nang magkagayo'y napuno ang bibig natin ng pagtawa, at ang dila natin ng awit: nang magkagayo'y sinabi nila sa gitna ng mga bansa, Ginawan sila ng Panginoon ng mga dakilang bagay."
            },
            {
              "chapter": 126,
              "verse": 3,
              "name": "Mga Awit 126:3",
              "text": "Ginawan tayo ng Panginoon ng mga dakilang bagay; na siyang ating ikinatutuwa."
            },
            {
              "chapter": 126,
              "verse": 4,
              "name": "Mga Awit 126:4",
              "text": "Papanumbalikin mo uli ang aming nangabihag, Oh Panginoon, na gaya ng mga batis sa Timugan."
            },
            {
              "chapter": 126,
              "verse": 5,
              "name": "Mga Awit 126:5",
              "text": "Sila na nagsisipaghasik na may luha ay magsisiani na may kagalakan."
            },
            {
              "chapter": 126,
              "verse": 6,
              "name": "Mga Awit 126:6",
              "text": "Siyang lumalabas at umiiyak, na nagdadala ng binhing itatanim; siya'y di sasalang babalik na may kagalakan, na dala ang kaniyang mga tangkas."
            }
          ]
        },
        {
          "chapter": 127,
          "name": "Mga Awit 127",
          "verses": [
            {
              "chapter": 127,
              "verse": 1,
              "name": "Mga Awit 127:1",
              "text": "Malibang itayo ng Panginoon ang bahay, walang kabuluhang nagsisigawa ang nagtatayo: malibang ingatan ng Panginoon ang bayan, walang kabuluhang gumigising ang bantay."
            },
            {
              "chapter": 127,
              "verse": 2,
              "name": "Mga Awit 127:2",
              "text": "Walang kabuluhan sa inyo na kayo'y magsibangong maaga, at magpahingang tanghali, at magsikain ng tinapay ng kapagalan: sapagka't binibigyan niyang gayon ng pagkakatulog ang kaniyang minamahal."
            },
            {
              "chapter": 127,
              "verse": 3,
              "name": "Mga Awit 127:3",
              "text": "Narito, ang mga anak ay mana na mula sa Panginoon: at ang bunga ng bahay-bata ay kaniyang ganting-pala."
            },
            {
              "chapter": 127,
              "verse": 4,
              "name": "Mga Awit 127:4",
              "text": "Kung paano ang mga pana sa kamay ng makapangyarihang lalake, gayon ang mga anak ng kabataan."
            },
            {
              "chapter": 127,
              "verse": 5,
              "name": "Mga Awit 127:5",
              "text": "Maginhawa ang lalake na pumuno ng kaniyang lalagyan ng pana ng mga yaon: sila'y hindi mapapahiya, pagka sila'y nakikipagsalitaan sa kanilang mga kaaway sa pintuang-bayan."
            }
          ]
        },
        {
          "chapter": 128,
          "name": "Mga Awit 128",
          "verses": [
            {
              "chapter": 128,
              "verse": 1,
              "name": "Mga Awit 128:1",
              "text": "Mapalad ang bawa't isa na natatakot sa Panginoon, na lumalakad sa kaniyang mga daan."
            },
            {
              "chapter": 128,
              "verse": 2,
              "name": "Mga Awit 128:2",
              "text": "Sapagka't iyong kakanin ang gawa ng iyong mga kamay: magiging maginhawa ka, at ikabubuti mo."
            },
            {
              "chapter": 128,
              "verse": 3,
              "name": "Mga Awit 128:3",
              "text": "Ang asawa mo'y magiging parang mabungang puno ng ubas, sa mga pinakaloob ng iyong bahay: ang mga anak mo'y parang mga puno ng olibo, sa palibot ng iyong dulang."
            },
            {
              "chapter": 128,
              "verse": 4,
              "name": "Mga Awit 128:4",
              "text": "Narito, na ganito nawa pagpalain ang tao, na natatakot sa Panginoon."
            },
            {
              "chapter": 128,
              "verse": 5,
              "name": "Mga Awit 128:5",
              "text": "Pagpapalain ka ng Panginoon mula sa Sion: at iyong makikita ang buti ng Jerusalem sa lahat na kaarawan ng iyong buhay."
            },
            {
              "chapter": 128,
              "verse": 6,
              "name": "Mga Awit 128:6",
              "text": "Oo, iyong makikita ang mga anak ng iyong mga anak. Kapayapaan nawa'y suma Israel."
            }
          ]
        },
        {
          "chapter": 129,
          "name": "Mga Awit 129",
          "verses": [
            {
              "chapter": 129,
              "verse": 1,
              "name": "Mga Awit 129:1",
              "text": "Madalas na ako'y dinalamhati nila mula sa aking kabataan, sabihin ngayon ng Israel,"
            },
            {
              "chapter": 129,
              "verse": 2,
              "name": "Mga Awit 129:2",
              "text": "Madalas na ako'y dinalamhati nila mula sa aking kabataan: gayon ma'y hindi sila nanganaig laban sa akin."
            },
            {
              "chapter": 129,
              "verse": 3,
              "name": "Mga Awit 129:3",
              "text": "Ang mga mangaararo ay nagsiararo sa aking likod; kanilang pinahaba ang kanilang bungkal."
            },
            {
              "chapter": 129,
              "verse": 4,
              "name": "Mga Awit 129:4",
              "text": "Ang Panginoon ay matuwid: kaniyang pinutol ang mga panali ng masama."
            },
            {
              "chapter": 129,
              "verse": 5,
              "name": "Mga Awit 129:5",
              "text": "Mapahiya sila at magsitalikod, silang lahat na nangagtatanim ng loob sa Sion."
            },
            {
              "chapter": 129,
              "verse": 6,
              "name": "Mga Awit 129:6",
              "text": "Sila'y maging parang damo sa mga bubungan, na natutuyo bago lumaki:"
            },
            {
              "chapter": 129,
              "verse": 7,
              "name": "Mga Awit 129:7",
              "text": "Na hindi pinupuno ng manggagapas ang kaniyang kamay niyaon, ni siyang nagtatali man ng mga bigkis, ang kaniyang sinapupunan."
            },
            {
              "chapter": 129,
              "verse": 8,
              "name": "Mga Awit 129:8",
              "text": "Hindi man sinasabi ng nagsisipagdaan, ang pagpapala ng Panginoon, ay sumainyo nawa; binabasbasan namin kayo sa pangalan ng Panginoon."
            }
          ]
        },
        {
          "chapter": 130,
          "name": "Mga Awit 130",
          "verses": [
            {
              "chapter": 130,
              "verse": 1,
              "name": "Mga Awit 130:1",
              "text": "Mula sa mga kalaliman ay dumaing ako sa iyo, Oh Panginoon."
            },
            {
              "chapter": 130,
              "verse": 2,
              "name": "Mga Awit 130:2",
              "text": "Panginoon, dinggin mo ang aking tinig: pakinggan ng iyong mga pakinig ang tinig ng aking mga pamanhik."
            },
            {
              "chapter": 130,
              "verse": 3,
              "name": "Mga Awit 130:3",
              "text": "Kung ikaw, Panginoon, magtatanda ng mga kasamaan, Oh Panginoon, sinong tatayo?"
            },
            {
              "chapter": 130,
              "verse": 4,
              "name": "Mga Awit 130:4",
              "text": "Nguni't may kapatawarang taglay ka, upang ikaw ay katakutan."
            },
            {
              "chapter": 130,
              "verse": 5,
              "name": "Mga Awit 130:5",
              "text": "Aking hinihintay ang Panginoon, hinihintay ng aking kaluluwa, at sa kaniyang salita ay umaasa ako."
            },
            {
              "chapter": 130,
              "verse": 6,
              "name": "Mga Awit 130:6",
              "text": "Hinihintay ng aking kaluluwa ang Panginoon, ng higit kay sa paghihintay ng bantay sa umaga; Oo, higit kay sa bantay sa umaga."
            },
            {
              "chapter": 130,
              "verse": 7,
              "name": "Mga Awit 130:7",
              "text": "Oh Israel, umasa ka sa Panginoon; sapagka't sa Panginoon ay may kagandahang-loob."
            },
            {
              "chapter": 130,
              "verse": 8,
              "name": "Mga Awit 130:8",
              "text": "At kaniyang tutubusin ang Israel sa lahat niyang kasamaan."
            }
          ]
        },
        {
          "chapter": 131,
          "name": "Mga Awit 131",
          "verses": [
            {
              "chapter": 131,
              "verse": 1,
              "name": "Mga Awit 131:1",
              "text": "Panginoon, hindi hambog ang aking puso, ni mayabang man ang aking mga mata; ni nagsasanay man ako sa mga dakilang bagay, o sa mga bagay na totoong kagilagilalas sa akin."
            },
            {
              "chapter": 131,
              "verse": 2,
              "name": "Mga Awit 131:2",
              "text": "Tunay na aking itiniwasay at itinahimik ang aking kaluluwa; parang batang inihiwalay sa suso sa kaniyang ina, ang kaluluwa ko ay parang inihiwalay na bata sa suso."
            },
            {
              "chapter": 131,
              "verse": 3,
              "name": "Mga Awit 131:3",
              "text": "Oh Israel, umasa ka sa Panginoon mula sa panahong ito at sa magpakailan pa man."
            }
          ]
        },
        {
          "chapter": 132,
          "name": "Mga Awit 132",
          "verses": [
            {
              "chapter": 132,
              "verse": 1,
              "name": "Mga Awit 132:1",
              "text": "Panginoon, alalahanin mo para kay David ang lahat niyang kadalamhatian;"
            },
            {
              "chapter": 132,
              "verse": 2,
              "name": "Mga Awit 132:2",
              "text": "Kung paanong sumumpa siya sa Panginoon, at nanata sa Makapangyarihan ni Jacob:"
            },
            {
              "chapter": 132,
              "verse": 3,
              "name": "Mga Awit 132:3",
              "text": "Tunay na hindi ako papasok sa tabernakulo ng aking bahay, ni sasampa man sa aking higaan,"
            },
            {
              "chapter": 132,
              "verse": 4,
              "name": "Mga Awit 132:4",
              "text": "Hindi ako magbibigay ng pagkakatulog sa aking mga mata, o magpapaidlip man sa aking mga talukap-mata;"
            },
            {
              "chapter": 132,
              "verse": 5,
              "name": "Mga Awit 132:5",
              "text": "Hanggang sa ako'y makasumpong ng dakong ukol sa Panginoon, ng tabernakulo ukol sa Makapangyarihan ni Jacob."
            },
            {
              "chapter": 132,
              "verse": 6,
              "name": "Mga Awit 132:6",
              "text": "Narito, narinig namin sa Ephrata: aming nasumpungan sa mga parang ng gubat."
            },
            {
              "chapter": 132,
              "verse": 7,
              "name": "Mga Awit 132:7",
              "text": "Kami ay magsisipasok sa kaniyang tabernakulo; kami ay magsisisamba sa harap ng kaniyang tungtungan."
            },
            {
              "chapter": 132,
              "verse": 8,
              "name": "Mga Awit 132:8",
              "text": "Bumangon ka, Oh Panginoon, sa iyong pahingahang dako: ikaw, at ang kaban ng iyong kalakasan."
            },
            {
              "chapter": 132,
              "verse": 9,
              "name": "Mga Awit 132:9",
              "text": "Magsipagsuot ang iyong mga saserdote ng katuwiran; at magsihiyaw ang iyong mga banal dahil sa kagalakan."
            },
            {
              "chapter": 132,
              "verse": 10,
              "name": "Mga Awit 132:10",
              "text": "Dahil sa iyong lingkod na kay David huwag mong ipihit ang mukha ng iyong pinahiran ng langis."
            },
            {
              "chapter": 132,
              "verse": 11,
              "name": "Mga Awit 132:11",
              "text": "Ang Panginoon ay sumumpa kay David sa katotohanan; hindi niya babaligtarin: ang bunga ng iyong katawan ay aking ilalagay sa iyong luklukan."
            },
            {
              "chapter": 132,
              "verse": 12,
              "name": "Mga Awit 132:12",
              "text": "Kung iingatan ng iyong mga anak ang aking tipan. At ang aking patotoo na aking ituturo, magsisiupo naman ang kanilang mga anak sa iyong luklukan magpakailan man."
            },
            {
              "chapter": 132,
              "verse": 13,
              "name": "Mga Awit 132:13",
              "text": "Sapagka't pinili ng Panginoon ang Sion; kaniyang ninasa na pinaka tahanan niya."
            },
            {
              "chapter": 132,
              "verse": 14,
              "name": "Mga Awit 132:14",
              "text": "Ito'y aking pahingahang dako magpakailan man. Dito ako tatahan; sapagka't aking ninasa."
            },
            {
              "chapter": 132,
              "verse": 15,
              "name": "Mga Awit 132:15",
              "text": "Aking pagpapalain siyang sagana sa pagkain; aking bubusugin ng pagkain ang kaniyang dukha."
            },
            {
              "chapter": 132,
              "verse": 16,
              "name": "Mga Awit 132:16",
              "text": "Ang kaniya namang mga saserdote ay susuutan ko ng kaligtasan: at ang kaniyang mga banal ay magsisihiyaw ng malakas sa kagalakan."
            },
            {
              "chapter": 132,
              "verse": 17,
              "name": "Mga Awit 132:17",
              "text": "Doo'y aking pamumukuhin ang sungay ni David: aking ipinaghanda ng ilawan ang aking pinahiran ng langis."
            },
            {
              "chapter": 132,
              "verse": 18,
              "name": "Mga Awit 132:18",
              "text": "Ang kaniyang mga kaaway ay susuutan ko ng kahihiyan: nguni't sa kaniya'y mamumulaklak ang kaniyang putong."
            }
          ]
        },
        {
          "chapter": 133,
          "name": "Mga Awit 133",
          "verses": [
            {
              "chapter": 133,
              "verse": 1,
              "name": "Mga Awit 133:1",
              "text": "Masdan ninyo, na pagkabuti at pagkaligaya sa mga magkakapatid na magsitahang magkakasama sa pagkakaisa!"
            },
            {
              "chapter": 133,
              "verse": 2,
              "name": "Mga Awit 133:2",
              "text": "Parang mahalagang langis sa ulo, na tumutulo sa balbas, sa makatuwid baga'y sa balbas ni Aaron. Na tumulo sa laylayan ng kaniyang mga suot;"
            },
            {
              "chapter": 133,
              "verse": 3,
              "name": "Mga Awit 133:3",
              "text": "Gaya ng hamog sa Hermon, na tumutulo sa mga bundok ng Sion: sapagka't doon pinarating ng Panginoon ang pagpapala, sa makatuwid baga'y ang buhay na magpakailan pa man."
            }
          ]
        },
        {
          "chapter": 134,
          "name": "Mga Awit 134",
          "verses": [
            {
              "chapter": 134,
              "verse": 1,
              "name": "Mga Awit 134:1",
              "text": "Narito, purihin ninyo ang Panginoon, ninyong lahat na lingkod ng Panginoon. Ninyong nagsisitayo sa kinagabihan sa bahay ng Panginoon."
            },
            {
              "chapter": 134,
              "verse": 2,
              "name": "Mga Awit 134:2",
              "text": "Itaas ninyo ang inyong mga kamay sa dakong santuario, at purihin ninyo ang Panginoon."
            },
            {
              "chapter": 134,
              "verse": 3,
              "name": "Mga Awit 134:3",
              "text": "Pagpalain ka nawa ng Panginoon mula sa Sion; sa makatuwid baga'y niyaong gumawa ng langit at lupa."
            }
          ]
        },
        {
          "chapter": 135,
          "name": "Mga Awit 135",
          "verses": [
            {
              "chapter": 135,
              "verse": 1,
              "name": "Mga Awit 135:1",
              "text": "Purihin ninyo ang Panginoon. Purihin ninyo ang pangalan ng Panginoon; purihin ninyo siya, Oh ninyong mga lingkod ng Panginoon:"
            },
            {
              "chapter": 135,
              "verse": 2,
              "name": "Mga Awit 135:2",
              "text": "Ninyong nagsisitayo sa bahay ng Panginoon. Sa mga looban ng bahay ng ating Dios."
            },
            {
              "chapter": 135,
              "verse": 3,
              "name": "Mga Awit 135:3",
              "text": "Purihin ninyo ang Panginoon; sapagka't ang Panginoon ay mabuti: magsiawit kayo ng mga pagpuri sa kaniyang pangalan; sapagka't maligaya."
            },
            {
              "chapter": 135,
              "verse": 4,
              "name": "Mga Awit 135:4",
              "text": "Sapagka't pinili ng Panginoon para sa kaniya si Jacob, at ang Israel na kaniyang pinakatanging kayamanan."
            },
            {
              "chapter": 135,
              "verse": 5,
              "name": "Mga Awit 135:5",
              "text": "Sapagka't nalalaman ko na ang Panginoon ay dakila, at ang ating Panginoon ay higit sa lahat na dios."
            },
            {
              "chapter": 135,
              "verse": 6,
              "name": "Mga Awit 135:6",
              "text": "Anomang kinalugdan ng Panginoon, ay kaniyang ginawa, sa langit at sa lupa, sa mga dagat, at sa lahat ng mga kalaliman."
            },
            {
              "chapter": 135,
              "verse": 7,
              "name": "Mga Awit 135:7",
              "text": "Kaniyang pinailanglang ang mga singaw na mula sa mga wakas ng lupa; kaniyang ginagawa ang mga kidlat na ukol sa ulan; kaniyang inilalabas ang hangin mula sa kaniyang mga ingatang-yaman."
            },
            {
              "chapter": 135,
              "verse": 8,
              "name": "Mga Awit 135:8",
              "text": "Na siyang sumakit sa mga panganay sa Egipto, sa tao at gayon din sa hayop."
            },
            {
              "chapter": 135,
              "verse": 9,
              "name": "Mga Awit 135:9",
              "text": "Siya'y nagsugo ng mga tanda at mga kababalaghan sa gitna mo, Oh Egipto, kay Faraon, at sa lahat niyang mga lingkod."
            },
            {
              "chapter": 135,
              "verse": 10,
              "name": "Mga Awit 135:10",
              "text": "Na siyang sumakit sa maraming bansa, at pumatay sa mga makapangyarihang hari;"
            },
            {
              "chapter": 135,
              "verse": 11,
              "name": "Mga Awit 135:11",
              "text": "Kay Sehon na hari ng mga Amorrheo, at kay Og na hari sa Basan, at sa lahat ng mga kaharian ng Canaan:"
            },
            {
              "chapter": 135,
              "verse": 12,
              "name": "Mga Awit 135:12",
              "text": "At ibinigay ang kanilang lupain na pinakamana, isang pinakamana sa Israel sa kaniyang bayan."
            },
            {
              "chapter": 135,
              "verse": 13,
              "name": "Mga Awit 135:13",
              "text": "Ang iyong pangalan, Oh Panginoon, ay magpakailan man; ang alaala sa iyo, Oh Panginoon, ay sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 135,
              "verse": 14,
              "name": "Mga Awit 135:14",
              "text": "Sapagka't hahatulan ng Panginoon ang kaniyang bayan, at magsisisi tungkol sa kaniyang mga lingkod."
            },
            {
              "chapter": 135,
              "verse": 15,
              "name": "Mga Awit 135:15",
              "text": "Ang mga diosdiosan ng mga bansa ay pilak at ginto, na gawa ng mga kamay ng mga tao."
            },
            {
              "chapter": 135,
              "verse": 16,
              "name": "Mga Awit 135:16",
              "text": "Sila'y may mga bibig, nguni't hindi sila nangagsasalita; mga mata ay mayroon sila, nguni't hindi sila nangakakakita;"
            },
            {
              "chapter": 135,
              "verse": 17,
              "name": "Mga Awit 135:17",
              "text": "Sila'y may mga tainga, nguni't hindi sila nangakakarinig; at wala mang anomang hinga sa kanilang mga bibig."
            },
            {
              "chapter": 135,
              "verse": 18,
              "name": "Mga Awit 135:18",
              "text": "Silang nagsisigawa sa kanila ay magiging gaya nila; Oo, bawa't tumitiwala sa kanila."
            },
            {
              "chapter": 135,
              "verse": 19,
              "name": "Mga Awit 135:19",
              "text": "Oh sangbahayan ni Israel, purihin ninyo ang Panginoon: Oh sangbahayan ni Aaron, purihin ninyo ang Panginoon:"
            },
            {
              "chapter": 135,
              "verse": 20,
              "name": "Mga Awit 135:20",
              "text": "Oh sangbahayan ni Levi, purihin ninyo ang Panginoon: ninyong nangatatakot sa Panginoon, purihin ninyo ang Panginoon."
            },
            {
              "chapter": 135,
              "verse": 21,
              "name": "Mga Awit 135:21",
              "text": "Purihin ang Panginoon mula sa Sion, na siyang tumatahan sa Jerusalem. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 136,
          "name": "Mga Awit 136",
          "verses": [
            {
              "chapter": 136,
              "verse": 1,
              "name": "Mga Awit 136:1",
              "text": "Oh mangagpasalamat kayo sa Panginoon; sapagka't siya'y mabuti: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 2,
              "name": "Mga Awit 136:2",
              "text": "Oh mangagpasalamat kayo sa Dios ng mga dios: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 3,
              "name": "Mga Awit 136:3",
              "text": "Oh mangagpasalamat kayo sa Panginoon ng mga panginoon: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 4,
              "name": "Mga Awit 136:4",
              "text": "Sa kaniya na gumagawang magisa ng mga dakilang kababalaghan: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 5,
              "name": "Mga Awit 136:5",
              "text": "Sa kaniya na gumawa ng mga langit sa pamamagitan ng unawa: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 6,
              "name": "Mga Awit 136:6",
              "text": "Sa kaniya na naglalatag ng lupa sa ibabaw ng tubig: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 7,
              "name": "Mga Awit 136:7",
              "text": "Sa kaniya na gumawa ng mga dakilang tanglaw; sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 8,
              "name": "Mga Awit 136:8",
              "text": "Ng araw upang magpuno sa araw: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 9,
              "name": "Mga Awit 136:9",
              "text": "Ng buwan at mga bituin upang magpuno sa gabi: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 10,
              "name": "Mga Awit 136:10",
              "text": "Sa kaniya na sumakit sa Egipto sa kanilang mga panganay: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 11,
              "name": "Mga Awit 136:11",
              "text": "At kinuha ang Israel sa kanila: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 12,
              "name": "Mga Awit 136:12",
              "text": "Sa pamamagitan ng malakas na kamay, at ng unat na bisig: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 13,
              "name": "Mga Awit 136:13",
              "text": "Sa kaniya na humawi ng Dagat na Mapula: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 14,
              "name": "Mga Awit 136:14",
              "text": "At nagparaan sa Israel sa gitna niyaon: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 15,
              "name": "Mga Awit 136:15",
              "text": "Nguni't tinabunan si Faraon at ang kaniyang hukbo sa Dagat na Mapula: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 16,
              "name": "Mga Awit 136:16",
              "text": "Sa kaniya na pumatnubay ng kaniyang bayan sa ilang: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 17,
              "name": "Mga Awit 136:17",
              "text": "Sa kaniya na sumakit sa mga dakilang hari: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 18,
              "name": "Mga Awit 136:18",
              "text": "At pumatay sa mga bantog na hari: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 19,
              "name": "Mga Awit 136:19",
              "text": "Kay Sehon na hari ng mga Amorrheo; sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 20,
              "name": "Mga Awit 136:20",
              "text": "At kay Og na hari sa Basan: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 21,
              "name": "Mga Awit 136:21",
              "text": "At ibinigay ang kanilang lupain na pinakamana. Sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 22,
              "name": "Mga Awit 136:22",
              "text": "Sa makatuwid baga'y pinakamana sa Israel na kaniyang lingkod: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 23,
              "name": "Mga Awit 136:23",
              "text": "Na siyang umalaala sa atin sa ating mababang kalagayan: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 24,
              "name": "Mga Awit 136:24",
              "text": "At iniligtas tayo sa ating mga kaaway: sapagka't ang kaniyang kagandahang-loob ay magpakailan man:"
            },
            {
              "chapter": 136,
              "verse": 25,
              "name": "Mga Awit 136:25",
              "text": "Siya'y nagbibigay ng pagkain sa lahat ng kinapal: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            },
            {
              "chapter": 136,
              "verse": 26,
              "name": "Mga Awit 136:26",
              "text": "Oh mangagpasalamat kayo sa Dios ng langit: sapagka't ang kaniyang kagandahang-loob ay magpakailan man."
            }
          ]
        },
        {
          "chapter": 137,
          "name": "Mga Awit 137",
          "verses": [
            {
              "chapter": 137,
              "verse": 1,
              "name": "Mga Awit 137:1",
              "text": "Sa tabi ng mga ilog ng Babilonia, doo'y nangaupo tayo, oo, nagiyak tayo, nang ating maalaala ang Sion."
            },
            {
              "chapter": 137,
              "verse": 2,
              "name": "Mga Awit 137:2",
              "text": "Sa mga punong sauce sa gitna niyaon ating ibinitin ang ating mga alpa."
            },
            {
              "chapter": 137,
              "verse": 3,
              "name": "Mga Awit 137:3",
              "text": "Sapagka't doo'y silang nagsibihag sa atin ay nagsihiling sa atin ng mga awit, at silang magpapahamak sa atin ay nagsihiling sa atin ng kasayahan, na nangagsasabi: Awitin ninyo sa amin ang sa mga awit ng Sion."
            },
            {
              "chapter": 137,
              "verse": 4,
              "name": "Mga Awit 137:4",
              "text": "Paanong aawitin namin ang awit sa Panginoon sa ibang lupain?"
            },
            {
              "chapter": 137,
              "verse": 5,
              "name": "Mga Awit 137:5",
              "text": "Kung kalimutan kita, Oh Jerusalem, kalimutan nawa ng aking kanan ang kaniyang kasanayan."
            },
            {
              "chapter": 137,
              "verse": 6,
              "name": "Mga Awit 137:6",
              "text": "Dumikit nawa ang aking dila sa ngalangala ng aking bibig, kung hindi kita alalahanin; kung hindi ko piliin ang Jerusalem ng higit sa aking pinakapangulong kagalakan."
            },
            {
              "chapter": 137,
              "verse": 7,
              "name": "Mga Awit 137:7",
              "text": "Alalahanin mo Oh Panginoon, laban sa mga anak ni Edom ang kaarawan ng Jerusalem; na nagsabi, Sirain, sirain, pati ng patibayan niyaon."
            },
            {
              "chapter": 137,
              "verse": 8,
              "name": "Mga Awit 137:8",
              "text": "Oh anak na babae ng Babilonia, na sira; magiging mapalad siya, na gumaganti sa iyo na gaya ng iyong ginawa sa amin."
            },
            {
              "chapter": 137,
              "verse": 9,
              "name": "Mga Awit 137:9",
              "text": "Magiging mapalad siya, na kukuha at maghahagis sa iyong mga bata sa malaking bato."
            }
          ]
        },
        {
          "chapter": 138,
          "name": "Mga Awit 138",
          "verses": [
            {
              "chapter": 138,
              "verse": 1,
              "name": "Mga Awit 138:1",
              "text": "Ako'y magpapasalamat sa iyo ng aking buong puso: sa harap ng mga dios ay aawit ako ng mga pagpuri sa iyo."
            },
            {
              "chapter": 138,
              "verse": 2,
              "name": "Mga Awit 138:2",
              "text": "Ako'y sasamba sa dako ng iyong banal na templo, at magpapasalamat sa iyong pangalan, dahil sa iyong kagandahang-loob at dahil sa iyong katotohanan: sapagka't iyong pinadakila ang iyong salita sa iyong buong pangalan."
            },
            {
              "chapter": 138,
              "verse": 3,
              "name": "Mga Awit 138:3",
              "text": "Nang araw na ako'y tumawag ay sinagot mo ako, iyong pinatapang ako ng kalakasan sa aking kaluluwa."
            },
            {
              "chapter": 138,
              "verse": 4,
              "name": "Mga Awit 138:4",
              "text": "Lahat ng mga hari sa lupa ay mangagpapasalamat sa iyo, Oh Panginoon, sapagka't kanilang narinig ang mga salita ng iyong bibig."
            },
            {
              "chapter": 138,
              "verse": 5,
              "name": "Mga Awit 138:5",
              "text": "Oo, sila'y magsisiawit tungkol sa mga daan ng Panginoon; sapagka't dakila ang kaluwalhatian ng Panginoon."
            },
            {
              "chapter": 138,
              "verse": 6,
              "name": "Mga Awit 138:6",
              "text": "Sapagka't bagaman ang Panginoon ay mataas, gumagalang din sa mababa: nguni't ang hambog ay nakikilala niya mula sa malayo."
            },
            {
              "chapter": 138,
              "verse": 7,
              "name": "Mga Awit 138:7",
              "text": "Bagaman ako'y lumakad sa gitna ng kabagabagan, iyong bubuhayin ako; iyong iuunat ang iyong kamay laban sa poot ng aking mga kaaway, at ililigtas ako ng iyong kanan."
            },
            {
              "chapter": 138,
              "verse": 8,
              "name": "Mga Awit 138:8",
              "text": "Pasasakdalin ng Panginoon ang tungkol sa akin: ang iyong kagandahang-loob, Oh Panginoon, ay magpakailan man; huwag mong pabayaan ang mga gawa ng iyong sariling mga kamay."
            }
          ]
        },
        {
          "chapter": 139,
          "name": "Mga Awit 139",
          "verses": [
            {
              "chapter": 139,
              "verse": 1,
              "name": "Mga Awit 139:1",
              "text": "Oh Panginoon, iyong siniyasat ako, at nakilala ako."
            },
            {
              "chapter": 139,
              "verse": 2,
              "name": "Mga Awit 139:2",
              "text": "Iyong nakikilala ang aking pag-upo at ang aking pagtindig, iyong nauunawa ang aking pagiisip sa malayo."
            },
            {
              "chapter": 139,
              "verse": 3,
              "name": "Mga Awit 139:3",
              "text": "Iyong siniyasat ang aking landas at ang aking higaan, at iyong kilala ang lahat kong mga lakad."
            },
            {
              "chapter": 139,
              "verse": 4,
              "name": "Mga Awit 139:4",
              "text": "Sapagka't wala pa ang salita sa aking dila, nguni't, narito, Oh Panginoon, natatalastas mo nang buo."
            },
            {
              "chapter": 139,
              "verse": 5,
              "name": "Mga Awit 139:5",
              "text": "Iyong kinulong ako sa likuran at sa harapan, at inilapag mo ang iyong kamay sa akin."
            },
            {
              "chapter": 139,
              "verse": 6,
              "name": "Mga Awit 139:6",
              "text": "Ang ganyang kaalaman ay totoong kagilagilalas sa akin; ito'y mataas, hindi ko maabot."
            },
            {
              "chapter": 139,
              "verse": 7,
              "name": "Mga Awit 139:7",
              "text": "Saan ako paroroon na mula sa iyong Espiritu? O saan ako tatakas na mula sa iyong harapan?"
            },
            {
              "chapter": 139,
              "verse": 8,
              "name": "Mga Awit 139:8",
              "text": "Kung sumampa ako sa langit, nandiyan ka: kung gawin ko ang aking higaan sa Sheol, narito, ikaw ay nandoon."
            },
            {
              "chapter": 139,
              "verse": 9,
              "name": "Mga Awit 139:9",
              "text": "Kung aking kunin ang mga pakpak ng umaga, at tumahan sa mga pinakadulong bahagi ng dagat;"
            },
            {
              "chapter": 139,
              "verse": 10,
              "name": "Mga Awit 139:10",
              "text": "Doon ma'y papatnubayan ako ng iyong kamay, at ang iyong kanang kamay ay hahawak sa akin."
            },
            {
              "chapter": 139,
              "verse": 11,
              "name": "Mga Awit 139:11",
              "text": "Kung aking sabihin, Tunay na tatakpan ako ng kadiliman, at ang liwanag sa palibot ko ay magiging gabi;"
            },
            {
              "chapter": 139,
              "verse": 12,
              "name": "Mga Awit 139:12",
              "text": "Ang kadiliman man ay hindi nakakukubli sa iyo, kundi ang gabi ay sumisilang na parang araw: ang kadiliman at kaliwanagan ay magkaparis sa iyo."
            },
            {
              "chapter": 139,
              "verse": 13,
              "name": "Mga Awit 139:13",
              "text": "Sapagka't iyong inanyo ang aking mga lamang loob: iyo akong tinakpan sa bahay-bata ng aking ina."
            },
            {
              "chapter": 139,
              "verse": 14,
              "name": "Mga Awit 139:14",
              "text": "Ako'y magpapasalamat sa iyo; sapagka't nilalang ako na kakilakilabot at kagilagilalas: kagilagilalas ang iyong mga gawa; at nalalamang mabuti ng aking kaluluwa."
            },
            {
              "chapter": 139,
              "verse": 15,
              "name": "Mga Awit 139:15",
              "text": "Ang katawan ko'y hindi nakubli sa iyo, nang ako'y gawin sa lihim, at yariing mainam sa mga pinakamababang bahagi sa lupa."
            },
            {
              "chapter": 139,
              "verse": 16,
              "name": "Mga Awit 139:16",
              "text": "Nakita ng iyong mga mata ang aking mga sangkap na di sakdal, at sa iyong aklat ay pawang nangasulat, kahit na ang mga araw na itinakda sa akin, nang wala pang anoman sa kanila,"
            },
            {
              "chapter": 139,
              "verse": 17,
              "name": "Mga Awit 139:17",
              "text": "Pagka mahalaga rin ng iyong mga pagiisip sa akin, Oh Dios! Pagka dakila ng kabuoan nila!"
            },
            {
              "chapter": 139,
              "verse": 18,
              "name": "Mga Awit 139:18",
              "text": "Kung aking bibilangin, higit sila sa bilang kay sa buhangin: pagka ako'y nagigising ay laging nasa iyo ako."
            },
            {
              "chapter": 139,
              "verse": 19,
              "name": "Mga Awit 139:19",
              "text": "Walang pagsalang iyong papatayin ang masama, Oh Dios: hiwalayan nga ninyo ako, Oh mga mabagsik na tao."
            },
            {
              "chapter": 139,
              "verse": 20,
              "name": "Mga Awit 139:20",
              "text": "Sapagka't sila'y nangagsasalita laban sa iyo ng kasamaan, at ginagamit ng iyong mga kaaway ang iyong pangalan sa walang kabuluhan."
            },
            {
              "chapter": 139,
              "verse": 21,
              "name": "Mga Awit 139:21",
              "text": "Hindi ko ba ipinagtatanim sila, Oh Panginoon, na nagtatanim sa iyo? At hindi ba kinapapanglawan ko ang mga yaon na nagsisibangon laban sa iyo?"
            },
            {
              "chapter": 139,
              "verse": 22,
              "name": "Mga Awit 139:22",
              "text": "Aking ipinagtatanim sila ng lubos na kapootan: sila'y naging mga kaaway ko."
            },
            {
              "chapter": 139,
              "verse": 23,
              "name": "Mga Awit 139:23",
              "text": "Siyasatin mo ako, Oh Dios, at alamin mo ang aking puso; subukin mo ako, at alamin mo ang aking mga pagiisip:"
            },
            {
              "chapter": 139,
              "verse": 24,
              "name": "Mga Awit 139:24",
              "text": "At tingnan mo kung may anomang lakad ng kasamaan sa akin, at patnubayan mo ako sa daang walang hanggan."
            }
          ]
        },
        {
          "chapter": 140,
          "name": "Mga Awit 140",
          "verses": [
            {
              "chapter": 140,
              "verse": 1,
              "name": "Mga Awit 140:1",
              "text": "Iligtas mo ako, Oh Panginoon, sa masamang tao; ingatan mo ako sa marahas na tao:"
            },
            {
              "chapter": 140,
              "verse": 2,
              "name": "Mga Awit 140:2",
              "text": "Na nagaakala ng kasamaan sa kanilang puso: laging nagpipipisan sila sa pagdidigma."
            },
            {
              "chapter": 140,
              "verse": 3,
              "name": "Mga Awit 140:3",
              "text": "Kanilang inihasa ang kanilang dila na parang ahas; kamandag ng mga ahas ay nasa kanilang mga labi. (Selah)"
            },
            {
              "chapter": 140,
              "verse": 4,
              "name": "Mga Awit 140:4",
              "text": "Ingatan mo ako, Oh Panginoon, sa mga kamay ng masama; ingatan mo ako sa marahas na tao: na nagakalang iligaw ang aking mga hakbang."
            },
            {
              "chapter": 140,
              "verse": 5,
              "name": "Mga Awit 140:5",
              "text": "Ipinagkubli ako ng palalo ng silo, at ng mga panali; kanilang ipinaglagay ako ng bating sa tabi ng daan; sila'y naglagay ng mga silo na ukol sa akin. (Selah)"
            },
            {
              "chapter": 140,
              "verse": 6,
              "name": "Mga Awit 140:6",
              "text": "Aking sinabi sa Panginoon. Ikaw ay Dios ko: Pakinggan mo ang tinig ng aking mga dalangin, Oh Panginoon."
            },
            {
              "chapter": 140,
              "verse": 7,
              "name": "Mga Awit 140:7",
              "text": "Oh Dios na Panginoon, na kalakasan ng aking kaligtasan, iyong tinakpan ang ulo ko sa kaarawan ng pagbabaka."
            },
            {
              "chapter": 140,
              "verse": 8,
              "name": "Mga Awit 140:8",
              "text": "Huwag mong ipagkaloob, Oh Panginoon, ang mga nasa ng masama; huwag mong papangyarihin ang kaniyang masamang haka; baka sila'y mangagmalaki. (Selah)"
            },
            {
              "chapter": 140,
              "verse": 9,
              "name": "Mga Awit 140:9",
              "text": "Tungkol sa ulo niyaong nagsisikubkob sa aking palibot, takpan sila ng kasamaan ng kanilang sariling mga labi."
            },
            {
              "chapter": 140,
              "verse": 10,
              "name": "Mga Awit 140:10",
              "text": "Mahulog sa kanila ang mga bagang nagniningas: mangahagis sila sa apoy; sa mga malalim na hukay, upang huwag na silang mangakabangon uli."
            },
            {
              "chapter": 140,
              "verse": 11,
              "name": "Mga Awit 140:11",
              "text": "Ang mapagsalita ng masama ay hindi matatatag sa lupa: huhulihin ng kasamaan ang marahas na lalake upang ibuwal siya."
            },
            {
              "chapter": 140,
              "verse": 12,
              "name": "Mga Awit 140:12",
              "text": "Nalalaman ko na aalalayan ng Panginoon ang usap ng nagdadalamhati, at ang matuwid ng mapagkailangan."
            },
            {
              "chapter": 140,
              "verse": 13,
              "name": "Mga Awit 140:13",
              "text": "Walang pagsalang ang matuwid ay magpapasalamat sa iyong pangalan: ang matuwid ay tatahan sa iyong harapan."
            }
          ]
        },
        {
          "chapter": 141,
          "name": "Mga Awit 141",
          "verses": [
            {
              "chapter": 141,
              "verse": 1,
              "name": "Mga Awit 141:1",
              "text": "Panginoon, ako'y tumawag sa iyo: magmadali ka sa akin: pakinggan mo ang tinig ko, pagka ako'y tumatawag sa iyo."
            },
            {
              "chapter": 141,
              "verse": 2,
              "name": "Mga Awit 141:2",
              "text": "Malagay ang aking dalangin na parang kamangyan sa harap mo; ang pagtataas ng aking mga kamay na parang hain sa kinahapunan."
            },
            {
              "chapter": 141,
              "verse": 3,
              "name": "Mga Awit 141:3",
              "text": "Maglagay ka ng bantay, Oh Panginoon, sa harap ng aking bibig; ingatan mo ang pintuan ng aking mga labi."
            },
            {
              "chapter": 141,
              "verse": 4,
              "name": "Mga Awit 141:4",
              "text": "Huwag mong ikiling ang aking puso sa anomang masamang bagay, na gumawa sa mga gawa ng kasamaan na kasama ng mga taong nagsisigawa ng kasamaan: at huwag mo akong pakanin ng kanilang mga masarap na pagkain."
            },
            {
              "chapter": 141,
              "verse": 5,
              "name": "Mga Awit 141:5",
              "text": "Sugatan ako ng matuwid, magiging kagandahan pa ng loob; at sawayin niya ako, magiging parang langis sa ulo; huwag tanggihan ng aking ulo: sapagka't sa kanilang kasamaan ay mamamalagi ang dalangin ko."
            },
            {
              "chapter": 141,
              "verse": 6,
              "name": "Mga Awit 141:6",
              "text": "Ang kanilang mga hukom ay nangahagis sa mga tabi ng malaking bato; at kanilang maririnig ang aking mga salita; sapagka't matatamis."
            },
            {
              "chapter": 141,
              "verse": 7,
              "name": "Mga Awit 141:7",
              "text": "Gaya ng kung inaararo at nabubungkal ang lupa, gayon ang aming mga buto ay nangangalat sa bibig ng Sheol."
            },
            {
              "chapter": 141,
              "verse": 8,
              "name": "Mga Awit 141:8",
              "text": "Sapagka't ang mga mata ko'y nangasa iyo, Oh Dios na Panginoon: sa iyo nanganganlong ako; huwag mong iwan ang aking kaluluwa sa walang magkandili."
            },
            {
              "chapter": 141,
              "verse": 9,
              "name": "Mga Awit 141:9",
              "text": "Iligtas mo ako sa silo na kanilang inilagay na ukol sa akin, at sa mga silo ng mga manggagawa ng kasamaan."
            },
            {
              "chapter": 141,
              "verse": 10,
              "name": "Mga Awit 141:10",
              "text": "Mahulog ang masama sa kanilang sariling mga bating. Habang ako'y nakatatanan."
            }
          ]
        },
        {
          "chapter": 142,
          "name": "Mga Awit 142",
          "verses": [
            {
              "chapter": 142,
              "verse": 1,
              "name": "Mga Awit 142:1",
              "text": "Ako'y dumadaing ng aking tinig sa Panginoon; ako'y namamanhik ng aking tinig sa Panginoon."
            },
            {
              "chapter": 142,
              "verse": 2,
              "name": "Mga Awit 142:2",
              "text": "Aking ibinubugso ang daing ko sa harap niya; aking ipinakilala sa harap niya ang kabagabagan ko."
            },
            {
              "chapter": 142,
              "verse": 3,
              "name": "Mga Awit 142:3",
              "text": "Nang nanglupaypay ang diwa ko sa loob ko, nalaman mo ang aking landas. Sa daan na aking nilalakaran ay pinagkukublihan nila ako ng silo."
            },
            {
              "chapter": 142,
              "verse": 4,
              "name": "Mga Awit 142:4",
              "text": "Tumingin ka sa aking kanan, at tingnan mo: sapagka't walang tao na nakakakilala sa akin: kanlungan ay kulang ako; walang taong lumilingap sa aking kaluluwa."
            },
            {
              "chapter": 142,
              "verse": 5,
              "name": "Mga Awit 142:5",
              "text": "Ako'y dumaing sa iyo, Oh Panginoon; aking sinabi: Ikaw ay aking kanlungan, aking bahagi sa lupain ng may buhay."
            },
            {
              "chapter": 142,
              "verse": 6,
              "name": "Mga Awit 142:6",
              "text": "Pakinggan mo ang aking daing; sapagka't ako'y totoong nababa: iligtas mo ako sa nagsisiusig sa akin; sapagka't sila'y malakas kay sa akin."
            },
            {
              "chapter": 142,
              "verse": 7,
              "name": "Mga Awit 142:7",
              "text": "Ilabas mo ang aking kaluluwa sa bilangguan, upang ako'y makapagpasalamat sa iyong pangalan: kubkubin ako ng matuwid; sapagka't ikaw ay gagawang may kagandahang-loob sa akin."
            }
          ]
        },
        {
          "chapter": 143,
          "name": "Mga Awit 143",
          "verses": [
            {
              "chapter": 143,
              "verse": 1,
              "name": "Mga Awit 143:1",
              "text": "Dinggin mo ang dalangin ko Oh Panginoon; pakinggan mo ang aking mga pamanhik: sa iyong pagtatapat ay sagutin mo ako, at sa iyong katuwiran."
            },
            {
              "chapter": 143,
              "verse": 2,
              "name": "Mga Awit 143:2",
              "text": "At huwag kang masok sa kahatulan na kasama ng iyong lingkod; sapagka't sa iyong paningin ay walang taong may buhay na aariing ganap."
            },
            {
              "chapter": 143,
              "verse": 3,
              "name": "Mga Awit 143:3",
              "text": "Sapagka't pinagusig ng kaaway ang kaluluwa ko; kaniyang sinaktan ang aking buhay ng lugmok sa lupa: kaniyang pinatahan ako sa mga madilim na dako, gaya ng mga namatay nang malaon."
            },
            {
              "chapter": 143,
              "verse": 4,
              "name": "Mga Awit 143:4",
              "text": "Kaya't ang aking diwa ay nanglulupaypay sa loob ko; ang puso ko sa loob ko ay bagbag."
            },
            {
              "chapter": 143,
              "verse": 5,
              "name": "Mga Awit 143:5",
              "text": "Aking naaalaala ang mga araw ng una; aking ginugunita ang lahat mong mga gawa: aking binubulay ang gawa ng iyong mga kamay."
            },
            {
              "chapter": 143,
              "verse": 6,
              "name": "Mga Awit 143:6",
              "text": "Iginawad ko ang aking mga kamay sa iyo: ang aking kaluluwa ay nananabik sa iyo, na parang uhaw na lupain. (Selah)"
            },
            {
              "chapter": 143,
              "verse": 7,
              "name": "Mga Awit 143:7",
              "text": "Magmadali kang sagutin mo ako, Oh Panginoon; ang diwa ko'y nanglulupaypay: huwag mong ikubli ang iyong mukha sa akin; baka ako'y maging gaya nila na nagsibaba sa hukay."
            },
            {
              "chapter": 143,
              "verse": 8,
              "name": "Mga Awit 143:8",
              "text": "Iparinig mo sa akin ang iyong kagandahang-loob sa kinaumagahan; sapagka't sa iyo ako tumitiwala: ipabatid mo sa akin ang daan na aking dapat lakaran; sapagka't itinaas ko ang aking kaluluwa sa iyo."
            },
            {
              "chapter": 143,
              "verse": 9,
              "name": "Mga Awit 143:9",
              "text": "Iligtas mo ako, Oh Panginoon, sa aking mga kaaway: tumatakas ako sa iyo upang ikubli mo ako."
            },
            {
              "chapter": 143,
              "verse": 10,
              "name": "Mga Awit 143:10",
              "text": "Turuan mo akong gumawa ng iyong kalooban; sapagka't ikaw ay aking Dios: ang iyong Espiritu ay mabuti; patnubayan mo ako sa lupain ng katuwiran."
            },
            {
              "chapter": 143,
              "verse": 11,
              "name": "Mga Awit 143:11",
              "text": "Buhayin mo ako, Oh Panginoon, dahil sa iyong pangalan: sa iyong katuwiran ay ilabas mo ang aking kaluluwa sa kabagabagan,"
            },
            {
              "chapter": 143,
              "verse": 12,
              "name": "Mga Awit 143:12",
              "text": "At sa iyong kagandahang-loob ay ihiwalay mo ang aking mga kaaway, at lipulin mo ang lahat na nagsisidalamhati sa aking kaluluwa; sapagka't ako'y iyong lingkod."
            }
          ]
        },
        {
          "chapter": 144,
          "name": "Mga Awit 144",
          "verses": [
            {
              "chapter": 144,
              "verse": 1,
              "name": "Mga Awit 144:1",
              "text": "Purihin ang Panginoon na aking malaking bato, na tinuturuan ang mga kamay ko na makipagdigma, at ang mga daliri ko na magsilaban:"
            },
            {
              "chapter": 144,
              "verse": 2,
              "name": "Mga Awit 144:2",
              "text": "Aking kagandahang-loob, at aking katibayan, aking matayog na moog, at aking tagapagligtas; aking kalasag, at siya na doon ako nanganganlong; na siyang nagpapasuko ng aking bayan sa akin."
            },
            {
              "chapter": 144,
              "verse": 3,
              "name": "Mga Awit 144:3",
              "text": "Panginoon, ano ang tao, upang iyong kilalanin siya? O ang anak ng tao, upang iyong pahalagahan siya?"
            },
            {
              "chapter": 144,
              "verse": 4,
              "name": "Mga Awit 144:4",
              "text": "Ang tao ay parang walang kabuluhan: ang kaniyang mga kaarawan ay parang lilim na napaparam."
            },
            {
              "chapter": 144,
              "verse": 5,
              "name": "Mga Awit 144:5",
              "text": "Ikiling mo ang iyong mga langit, Oh Panginoon, at bumaba ka: hipuin mo ang mga bundok, at magsisiusok."
            },
            {
              "chapter": 144,
              "verse": 6,
              "name": "Mga Awit 144:6",
              "text": "Maghagis ka ng kidlat, at pangalatin mo sila; suguin mo ang iyong mga pana, at lituhin mo sila,"
            },
            {
              "chapter": 144,
              "verse": 7,
              "name": "Mga Awit 144:7",
              "text": "Iunat mo ang iyong kamay mula sa itaas; sagipin mo ako, at iligtas mo ako sa malaking tubig, sa kamay ng mga taga ibang lupa;"
            },
            {
              "chapter": 144,
              "verse": 8,
              "name": "Mga Awit 144:8",
              "text": "Na ang bibig ay nagsasalita ng karayaan, at ang kanilang kanang kamay ay kanang kamay ng kabulaanan."
            },
            {
              "chapter": 144,
              "verse": 9,
              "name": "Mga Awit 144:9",
              "text": "Ako'y aawit ng bagong awit sa iyo, Oh Dios: sa salterio na may sangpung kawad ay aawit ako ng mga pagpuri sa iyo."
            },
            {
              "chapter": 144,
              "verse": 10,
              "name": "Mga Awit 144:10",
              "text": "Siya ang nagbibigay ng kaligtasan sa mga hari: na siyang nagligtas kay David na kaniyang lingkod sa manunugat na tabak."
            },
            {
              "chapter": 144,
              "verse": 11,
              "name": "Mga Awit 144:11",
              "text": "Sagipin mo ako, at iligtas mo ako sa kamay ng mga taga ibang lupa. Na ang bibig ay nagsasalita ng karayaan, at ang kanilang kanang kamay ay kanang kamay ng kabulaanan."
            },
            {
              "chapter": 144,
              "verse": 12,
              "name": "Mga Awit 144:12",
              "text": "Pagka ang aming mga anak na lalake ay magiging parang mga pananim na lumaki sa kanilang kabataan; at ang aming mga anak na babae ay parang mga panulok na bato na inanyuan ayon sa anyo ng isang palasio."
            },
            {
              "chapter": 144,
              "verse": 13,
              "name": "Mga Awit 144:13",
              "text": "Pagka ang mga kamalig namin ay puno, na may sarisaring bagay; at ang mga tupa namin ay nanganganak ng mga libo at mga sangpung libo sa aming mga parang;"
            },
            {
              "chapter": 144,
              "verse": 14,
              "name": "Mga Awit 144:14",
              "text": "Pagka ang mga baka namin ay napapasanang mabuti; pagka walang salot, at sakuna, at walang panaghoy sa aming mga lansangan;"
            },
            {
              "chapter": 144,
              "verse": 15,
              "name": "Mga Awit 144:15",
              "text": "Maginhawa ang bayan, na nasa gayong kalagayan: maginhawa ang bayan na ang Dios ay ang Panginoon."
            }
          ]
        },
        {
          "chapter": 145,
          "name": "Mga Awit 145",
          "verses": [
            {
              "chapter": 145,
              "verse": 1,
              "name": "Mga Awit 145:1",
              "text": "Ibubunyi kita, Dios ko, Oh Hari; at aking pupurihin ang pangalan mo magpakailan-kailan pa man."
            },
            {
              "chapter": 145,
              "verse": 2,
              "name": "Mga Awit 145:2",
              "text": "Araw-araw ay pupurihin kita; at aking pupurihin ang pangalan mo magpakailan-kailan pa man."
            },
            {
              "chapter": 145,
              "verse": 3,
              "name": "Mga Awit 145:3",
              "text": "Dakila ang Panginoon, at marapat na purihin; at ang kaniyang kadakilaan ay hindi masayod."
            },
            {
              "chapter": 145,
              "verse": 4,
              "name": "Mga Awit 145:4",
              "text": "Ang isang lahi ay pupuri ng iyong mga gawa sa isa. At ipahahayag ang iyong mga makapangyarihang gawa."
            },
            {
              "chapter": 145,
              "verse": 5,
              "name": "Mga Awit 145:5",
              "text": "Sa maluwalhating kamahalan ng iyong karangalan, at sa iyong mga kagilagilalas na mga gawa, magbubulay ako."
            },
            {
              "chapter": 145,
              "verse": 6,
              "name": "Mga Awit 145:6",
              "text": "At ang mga tao ay mangagsasalita ng kapangyarihan ng iyong kakilakilabot na mga gawa; at aking ipahahayag ang iyong kadakilaan."
            },
            {
              "chapter": 145,
              "verse": 7,
              "name": "Mga Awit 145:7",
              "text": "Kanilang sasambitin ang alaala sa iyong dakilang kabutihan, at aawitin nila ang iyong katuwiran."
            },
            {
              "chapter": 145,
              "verse": 8,
              "name": "Mga Awit 145:8",
              "text": "Ang Panginoon ay mapagbiyaya, at puspos ng kahabagan; banayad sa pagkagalit, at dakila sa kagandahang-loob."
            },
            {
              "chapter": 145,
              "verse": 9,
              "name": "Mga Awit 145:9",
              "text": "Ang Panginoon ay mabuti sa lahat; at ang kaniyang mga malumanay na kaawaan ay nasa lahat niyang mga gawa."
            },
            {
              "chapter": 145,
              "verse": 10,
              "name": "Mga Awit 145:10",
              "text": "Lahat mong mga gawa ay mangagpapasalamat sa iyo Oh Panginoon; at pupurihin ka ng iyong mga banal."
            },
            {
              "chapter": 145,
              "verse": 11,
              "name": "Mga Awit 145:11",
              "text": "Sila'y mangagsasalita ng kaluwalhatian ng iyong kaharian, at mangungusap ng iyong kapangyarihan;"
            },
            {
              "chapter": 145,
              "verse": 12,
              "name": "Mga Awit 145:12",
              "text": "Upang ipabatid sa mga anak ng mga tao ang kaniyang mga makapangyarihang gawa, at ang kaluwalhatian ng kamahalan ng kaniyang kaharian."
            },
            {
              "chapter": 145,
              "verse": 13,
              "name": "Mga Awit 145:13",
              "text": "Ang kaharian mo'y walang hanggang kaharian, at ang kapangyarihan mo'y sa lahat ng sali't saling lahi."
            },
            {
              "chapter": 145,
              "verse": 14,
              "name": "Mga Awit 145:14",
              "text": "Inaalalayan ng Panginoon ang lahat na nangabubuwal, at itinatayo yaong nangasusubasob."
            },
            {
              "chapter": 145,
              "verse": 15,
              "name": "Mga Awit 145:15",
              "text": "Ang mga mata ng lahat ay nangaghihintay sa iyo; at iyong ibinigay sa kanila ang kanilang pagkain sa ukol na panahon."
            },
            {
              "chapter": 145,
              "verse": 16,
              "name": "Mga Awit 145:16",
              "text": "Iyong binubuksan ang iyong kamay, at sinasapatan mo ang nasa ng bawa't bagay na may buhay."
            },
            {
              "chapter": 145,
              "verse": 17,
              "name": "Mga Awit 145:17",
              "text": "Ang Panginoon ay matuwid sa lahat niyang daan, at mapagbiyaya sa lahat niyang mga gawa."
            },
            {
              "chapter": 145,
              "verse": 18,
              "name": "Mga Awit 145:18",
              "text": "Ang Panginoon ay malapit sa lahat na nagsisitawag sa kaniya, sa lahat na nagsisitawag sa kaniya sa katotohanan."
            },
            {
              "chapter": 145,
              "verse": 19,
              "name": "Mga Awit 145:19",
              "text": "Kaniyang tutuparin ang nasa nila na nangatatakot sa kaniya; kaniya ring didinggin ang kanilang daing, at ililigtas sila."
            },
            {
              "chapter": 145,
              "verse": 20,
              "name": "Mga Awit 145:20",
              "text": "Iniingatan ng Panginoon ang lahat na nagsisiibig sa kaniya; nguni't lahat ng masama ay lilipulin niya."
            },
            {
              "chapter": 145,
              "verse": 21,
              "name": "Mga Awit 145:21",
              "text": "Ang aking bibig ay magsasalita ng kapurihan ng Panginoon; at purihin ng lahat na laman ang kaniyang banal na pangalan magpakailan-kailan pa man."
            }
          ]
        },
        {
          "chapter": 146,
          "name": "Mga Awit 146",
          "verses": [
            {
              "chapter": 146,
              "verse": 1,
              "name": "Mga Awit 146:1",
              "text": "Purihin ninyo ang Panginoon. Purihin mo ang Panginoon, Oh kaluluwa ko."
            },
            {
              "chapter": 146,
              "verse": 2,
              "name": "Mga Awit 146:2",
              "text": "Samantalang ako'y nabubuhay ay pupurihin ko ang Panginoon: ako'y aawit ng mga pagpuri sa aking Dios, samantalang ako'y may buhay."
            },
            {
              "chapter": 146,
              "verse": 3,
              "name": "Mga Awit 146:3",
              "text": "Huwag ninyong ilagak ang inyong tiwala sa mga pangulo, ni sa anak man ng tao, na walang pagsaklolo."
            },
            {
              "chapter": 146,
              "verse": 4,
              "name": "Mga Awit 146:4",
              "text": "Ang hininga niya ay pumapanaw, siya'y nanunumbalik sa kaniyang pagkalupa; sa araw ding yaon ay mawawala ang kaniyang pagiisip."
            },
            {
              "chapter": 146,
              "verse": 5,
              "name": "Mga Awit 146:5",
              "text": "Maginhawa ang may pinaka saklolo sa Dios ni Jacob, na ang pagasa ay nasa Panginoon niyang Dios:"
            },
            {
              "chapter": 146,
              "verse": 6,
              "name": "Mga Awit 146:6",
              "text": "Na gumawa ng langit at lupa, ng dagat, at ng lahat na nandoon; na nagiingat ng katotohanan magpakailan man:"
            },
            {
              "chapter": 146,
              "verse": 7,
              "name": "Mga Awit 146:7",
              "text": "Na nagsasagawa ng kahatulan sa napipighati; na nagbibigay ng pagkain sa gutom: pinawawalan ng Panginoon ang mga bilanggo;"
            },
            {
              "chapter": 146,
              "verse": 8,
              "name": "Mga Awit 146:8",
              "text": "Idinidilat ng Panginoon ang mga mata ng bulag; ibinabangon ng Panginoon ang mga nasusubasob; iniibig ng Panginoon ang matuwid;"
            },
            {
              "chapter": 146,
              "verse": 9,
              "name": "Mga Awit 146:9",
              "text": "Iniingatan ng Panginoon ang mga taga ibang lupa; kaniyang inaalalayan ang ulila at babaing bao; nguni't ang lakad ng masama ay kaniyang ibinabaligtad."
            },
            {
              "chapter": 146,
              "verse": 10,
              "name": "Mga Awit 146:10",
              "text": "Maghahari ang Panginoon magpakailan man. Ang iyong Dios, Oh Sion, sa lahat ng sali't saling lahi. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 147,
          "name": "Mga Awit 147",
          "verses": [
            {
              "chapter": 147,
              "verse": 1,
              "name": "Mga Awit 147:1",
              "text": "Purihin ninyo ang Panginoon; sapagka't mabuting umawit ng mga pagpuri sa ating Dios; sapagka't maligaya, at ang pagpuri ay nakalulugod."
            },
            {
              "chapter": 147,
              "verse": 2,
              "name": "Mga Awit 147:2",
              "text": "Itinatayo ng Panginoon ang Jerusalem; kaniyang pinipisan ang mga natapon na Israel."
            },
            {
              "chapter": 147,
              "verse": 3,
              "name": "Mga Awit 147:3",
              "text": "Kaniyang pinagagaling ang mga may bagbag na puso, at tinatalian niya ang kanilang mga sugat."
            },
            {
              "chapter": 147,
              "verse": 4,
              "name": "Mga Awit 147:4",
              "text": "Kaniyang sinasaysay ang bilang ng mga bituin; siya ang nagbibigay sa kanila ng lahat nilang pangalan."
            },
            {
              "chapter": 147,
              "verse": 5,
              "name": "Mga Awit 147:5",
              "text": "Dakila ang ating Panginoon, at makapangyarihan sa kapangyarihan; ang kaniyang unawa ay walang hanggan,"
            },
            {
              "chapter": 147,
              "verse": 6,
              "name": "Mga Awit 147:6",
              "text": "Inaalalayan ng Panginoon ang maamo: kaniyang inilulugmok sa lupa ang masama."
            },
            {
              "chapter": 147,
              "verse": 7,
              "name": "Mga Awit 147:7",
              "text": "Magsiawit kayo sa Panginoon ng pagpapasalamat; magsiawit kayo sa alpa ng mga pagpuri sa ating Dios:"
            },
            {
              "chapter": 147,
              "verse": 8,
              "name": "Mga Awit 147:8",
              "text": "Na nagtatakip sa mga langit ng mga alapaap. Na siyang naghahanda ng ulan sa lupa, na nagpapatubo ng damo sa mga bundok."
            },
            {
              "chapter": 147,
              "verse": 9,
              "name": "Mga Awit 147:9",
              "text": "Siya'y nagbibigay sa hayop ng kaniyang pagkain. At sa mga inakay na uwak na nagsisidaing."
            },
            {
              "chapter": 147,
              "verse": 10,
              "name": "Mga Awit 147:10",
              "text": "Siya'y hindi nalulugod sa lakas ng kabayo: siya'y hindi nasasayahan sa mga paa ng tao."
            },
            {
              "chapter": 147,
              "verse": 11,
              "name": "Mga Awit 147:11",
              "text": "Ang Panginoon ay naliligaya sa kanila na nangatatakot sa kaniya, sa nagsisiasa sa kaniyang kagandahang-loob."
            },
            {
              "chapter": 147,
              "verse": 12,
              "name": "Mga Awit 147:12",
              "text": "Purihin mo ang Panginoon, Oh Jerusalem; purihin mo ang iyong Dios, Oh Sion."
            },
            {
              "chapter": 147,
              "verse": 13,
              "name": "Mga Awit 147:13",
              "text": "Sapagka't kaniyang pinatibay ang mga halang ng iyong mga pintuang-bayan; kaniyang pinagpala ang iyong mga anak sa loob mo."
            },
            {
              "chapter": 147,
              "verse": 14,
              "name": "Mga Awit 147:14",
              "text": "Siya'y gumagawa ng kapayapaan sa iyong mga hangganan; kaniyang binubusog ka ng pinakamainam na trigo."
            },
            {
              "chapter": 147,
              "verse": 15,
              "name": "Mga Awit 147:15",
              "text": "Kaniyang sinusugo ang kaniyang utos sa lupa; ang kaniyang salita ay tumatakbong maliksi."
            },
            {
              "chapter": 147,
              "verse": 16,
              "name": "Mga Awit 147:16",
              "text": "Siya'y nagbibigay ng nieve na parang balahibo ng tupa; siya'y nagkakalat ng eskarcha na parang abo."
            },
            {
              "chapter": 147,
              "verse": 17,
              "name": "Mga Awit 147:17",
              "text": "Kaniyang inihahagis na parang putol na maliit ang kaniyang hielo: sinong makatatagal sa harap ng lamig niyaon?"
            },
            {
              "chapter": 147,
              "verse": 18,
              "name": "Mga Awit 147:18",
              "text": "Kaniyang pinahahatdan ng salita, at tinutunaw: kaniyang pinahihihip ang kaniyang hangin, at ang tubig ay pinaagos."
            },
            {
              "chapter": 147,
              "verse": 19,
              "name": "Mga Awit 147:19",
              "text": "Kaniyang ipinabatid ang kaniyang salita sa Jacob, ang kaniyang mga palatuntunan at mga kahatulan sa Israel."
            },
            {
              "chapter": 147,
              "verse": 20,
              "name": "Mga Awit 147:20",
              "text": "Siya'y hindi gumawa ng gayon sa alin mang bansa: at tungkol sa kaniyang mga kahatulan, hindi nila nalaman. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 148,
          "name": "Mga Awit 148",
          "verses": [
            {
              "chapter": 148,
              "verse": 1,
              "name": "Mga Awit 148:1",
              "text": "Purihin ninyo ang Panginoon. Purihin ninyo ang Panginoon mula sa mga langit: purihin ninyo siya sa mga kaitaasan."
            },
            {
              "chapter": 148,
              "verse": 2,
              "name": "Mga Awit 148:2",
              "text": "Purihin ninyo siya, ninyong lahat niyang mga anghel: purihin ninyo siya, buo niyang hukbo."
            },
            {
              "chapter": 148,
              "verse": 3,
              "name": "Mga Awit 148:3",
              "text": "Purihin ninyo siya, araw at buwan: purihin ninyo siya, ninyong lahat na mga bituing maliwanag."
            },
            {
              "chapter": 148,
              "verse": 4,
              "name": "Mga Awit 148:4",
              "text": "Purihin ninyo siya, ninyong mga langit ng mga langit, at ninyong tubig na nasa itaas ng mga langit."
            },
            {
              "chapter": 148,
              "verse": 5,
              "name": "Mga Awit 148:5",
              "text": "Purihin nila ang pangalan ng Panginoon: sapagka't siya'y nagutos, at sila'y nangalikha."
            },
            {
              "chapter": 148,
              "verse": 6,
              "name": "Mga Awit 148:6",
              "text": "Kaniya rin namang ipinagtatatag magpakailan-kailan man: siya'y gumawa ng pasiya na hindi mapapawi."
            },
            {
              "chapter": 148,
              "verse": 7,
              "name": "Mga Awit 148:7",
              "text": "Purihin ninyo ang Panginoon mula sa lupa, Ninyong mga buwaya, at lahat ng mga kalaliman:"
            },
            {
              "chapter": 148,
              "verse": 8,
              "name": "Mga Awit 148:8",
              "text": "Apoy at granizo, nieve at singaw; unos na hangin, na gumaganap ng kaniyang salita:"
            },
            {
              "chapter": 148,
              "verse": 9,
              "name": "Mga Awit 148:9",
              "text": "Mga bundok at lahat ng mga gulod; mga mabungang kahoy at lahat ng mga cedro:"
            },
            {
              "chapter": 148,
              "verse": 10,
              "name": "Mga Awit 148:10",
              "text": "Mga hayop at buong kawan; nagsisiusad na bagay at ibong lumilipad:"
            },
            {
              "chapter": 148,
              "verse": 11,
              "name": "Mga Awit 148:11",
              "text": "Mga hari sa lupa at lahat ng mga bayan; mga pangulo at lahat ng mga hukom sa lupa:"
            },
            {
              "chapter": 148,
              "verse": 12,
              "name": "Mga Awit 148:12",
              "text": "Mga binata at gayon din ng mga dalaga; mga matanda at mga bata:"
            },
            {
              "chapter": 148,
              "verse": 13,
              "name": "Mga Awit 148:13",
              "text": "Purihin nila ang pangalan ng Panginoon; sapagka't ang kaniyang pangalan magisa ay nabunyi: ang kaniyang kaluwalhatian ay nasa itaas ng lupa at mga langit."
            },
            {
              "chapter": 148,
              "verse": 14,
              "name": "Mga Awit 148:14",
              "text": "At itinaas niya ang sungay ng kaniyang bayan, ang papuri ng lahat niyang mga banal; sa makatuwid baga'y ng mga anak ni Israel, na bayang malapit sa kaniya. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 149,
          "name": "Mga Awit 149",
          "verses": [
            {
              "chapter": 149,
              "verse": 1,
              "name": "Mga Awit 149:1",
              "text": "Purihin ninyo ang Panginoon. Magsiawit kayo sa Panginoon ng bagong awit, at ng kaniyang kapurihan sa kapisanan ng mga banal."
            },
            {
              "chapter": 149,
              "verse": 2,
              "name": "Mga Awit 149:2",
              "text": "Magalak nawa ang Israel sa kaniya na lumalang sa kaniya: magalak nawa ang mga anak ng Sion sa kanilang Hari."
            },
            {
              "chapter": 149,
              "verse": 3,
              "name": "Mga Awit 149:3",
              "text": "Purihin nila ang kaniyang pangalan sa sayaw: magsiawit sila ng mga pagpuri sa kaniya na may pandereta at alpa."
            },
            {
              "chapter": 149,
              "verse": 4,
              "name": "Mga Awit 149:4",
              "text": "Sapagka't ang Panginoon ay nalulugod sa kaniyang bayan: kaniyang pagagandahin ng kaligtasan ang maamo."
            },
            {
              "chapter": 149,
              "verse": 5,
              "name": "Mga Awit 149:5",
              "text": "Pumuri nawa ang mga banal sa kaluwalhatian: magsiawit sila sa kagalakan sa kanilang mga higaan."
            },
            {
              "chapter": 149,
              "verse": 6,
              "name": "Mga Awit 149:6",
              "text": "Malagay nawa sa kanilang bibig ang pinakamataas na pagpuri sa Dios, at tabak na may dalawang talim sa kanilang kamay;"
            },
            {
              "chapter": 149,
              "verse": 7,
              "name": "Mga Awit 149:7",
              "text": "Upang magsagawa ng panghihiganti sa mga bansa, at mga parusa sa mga bayan;"
            },
            {
              "chapter": 149,
              "verse": 8,
              "name": "Mga Awit 149:8",
              "text": "Upang talian ang kanilang mga hari ng mga tanikala, at ang kanilang mga mahal na tao ng mga panaling bakal;"
            },
            {
              "chapter": 149,
              "verse": 9,
              "name": "Mga Awit 149:9",
              "text": "Upang magsagawa sa kanila ng hatol na nasusulat: mayroon ng karangalang ito ang lahat niyang mga banal. Purihin ninyo ang Panginoon."
            }
          ]
        },
        {
          "chapter": 150,
          "name": "Mga Awit 150",
          "verses": [
            {
              "chapter": 150,
              "verse": 1,
              "name": "Mga Awit 150:1",
              "text": "Purihin ninyo ang Panginoon. Purihin ninyo ang Dios sa kaniyang santuario: purihin ninyo siya sa langit ng kaniyang kapangyarihan."
            },
            {
              "chapter": 150,
              "verse": 2,
              "name": "Mga Awit 150:2",
              "text": "Purihin ninyo siya dahil sa kaniyang mga makapangyarihang gawa: purihin ninyo siya ayon sa kaniyang marilag na kadakilaan."
            },
            {
              "chapter": 150,
              "verse": 3,
              "name": "Mga Awit 150:3",
              "text": "Purihin ninyo siya ng tunog ng pakakak: purihin ninyo siya ng salterio at alpa."
            },
            {
              "chapter": 150,
              "verse": 4,
              "name": "Mga Awit 150:4",
              "text": "Purihin ninyo siya ng pandereta at sayaw: purihin ninyo siya ng mga panugtog na kawad at ng flauta."
            },
            {
              "chapter": 150,
              "verse": 5,
              "name": "Mga Awit 150:5",
              "text": "Purihin ninyo siya ng mga matunog na simbalo. Purihin ninyo siya sa pinaka matunog na mga simbalo."
            },
            {
              "chapter": 150,
              "verse": 6,
              "name": "Mga Awit 150:6",
              "text": "Purihin ng bawa't bagay na may hininga ang Panginoon. Purihin ninyo ang Panginoon."
            }
          ]
        }
      ]
    },
    {
      "nr": 20,
      "name": "Mga Kawikaan",
      "chapters": [
        {
          "chapter": 1,
          "name": "Mga Kawikaan 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Mga Kawikaan 1:1",
              "text": "Ang mga kawikaan ni Salomon na anak ni David na hari sa Israel:"
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Mga Kawikaan 1:2",
              "text": "Upang umalam ng karunungan at turo; upang bulayin ang mga salita ng pagkaunawa;"
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Mga Kawikaan 1:3",
              "text": "Upang tumanggap ng turo sa pantas na paguugali, sa katuwiran, at kahatulan, at karampatan;"
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Mga Kawikaan 1:4",
              "text": "Upang magbigay ng katalinuhan sa musmos. Kaalaman at pagbubulay sa kabataan:"
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Mga Kawikaan 1:5",
              "text": "Upang marinig ng pantas, at lumago sa ikatututo: at upang tamuhin ng taong may unawa ang magagaling na payo:"
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Mga Kawikaan 1:6",
              "text": "Upang umunawa ng kawikaan at ng kahulugan; ng mga salita ng pantas, at ng kanilang malalabong sabi."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Mga Kawikaan 1:7",
              "text": "Ang takot sa Panginoon ay pasimula ng kaalaman: nguni't ang mangmang ay humahamak sa karunungan at turo."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Mga Kawikaan 1:8",
              "text": "Anak ko, dinggin mo ang turo ng iyong ama, at huwag mong pabayaan ang kautusan ng iyong ina:"
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Mga Kawikaan 1:9",
              "text": "Sapagka't sila'y magiging tali ng biyaya sa iyong ulo, at mga kuwintas sa ligid ng iyong leeg."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Mga Kawikaan 1:10",
              "text": "Anak ko, kung ikaw ay hikayatin ng mga makasalanan, huwag mong tulutan."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Mga Kawikaan 1:11",
              "text": "Kung kanilang sabihin, sumama ka sa amin, tayo'y magsibakay sa pagbububo ng dugo, tayo'y mangagkubli ng silo na walang anomang kadahilanan sa walang sala;"
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Mga Kawikaan 1:12",
              "text": "Sila'y lamunin nating buhay na gaya ng Sheol. At buo, na gaya ng nagsibaba sa lungaw;"
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Mga Kawikaan 1:13",
              "text": "Tayo'y makakasumpong ng lahat na mahalagang pag-aari, ating pupunuin ang ating mga bahay ng samsam;"
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Mga Kawikaan 1:14",
              "text": "Ikaw ay makikipagsapalaran sa gitna namin; magkakaroon tayong lahat ng isang supot:"
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Mga Kawikaan 1:15",
              "text": "Anak ko, huwag kang lumakad sa daan na kasama nila; pigilin mo ang iyong paa sa kanilang landas:"
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Mga Kawikaan 1:16",
              "text": "Sapagka't ang kanilang mga paa ay nagsisitakbo sa kasamaan, at sila'y nangagmamadali sa pagbububo ng dugo."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Mga Kawikaan 1:17",
              "text": "Sapagka't walang kabuluhang naladlad ang silo, sa paningin ng alin mang ibon:"
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Mga Kawikaan 1:18",
              "text": "At binabakayan ng mga ito ang kanilang sariling dugo, kanilang ipinagkukubli ng silo ang kanilang sariling mga buhay."
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "Mga Kawikaan 1:19",
              "text": "Ganyan ang mga lakad ng bawa't sakim sa pakinabang; na nagaalis ng buhay ng mga may-ari niyaon."
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "Mga Kawikaan 1:20",
              "text": "Karunungan ay humihiyaw na malakas sa lansangan; kaniyang inilalakas ang kaniyang tinig sa mga luwal na dako;"
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "Mga Kawikaan 1:21",
              "text": "Siya'y humihiyaw sa mga pangulong dako na pinaglilipunan; sa pasukan ng mga pintuang-bayan, sa bayan, kaniyang binibigkas ang kaniyang mga salita:"
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "Mga Kawikaan 1:22",
              "text": "Hanggang kailan kayong mga musmos, magsisiibig sa inyong kamusmusan? At ang mga nanunuya ay maliligaya sa panunuya, at ang mga mangmang ay mangagtatanim sa kaalaman?"
            },
            {
              "chapter": 1,
              "verse": 23,
              "name": "Mga Kawikaan 1:23",
              "text": "Magsibalik kayo sa aking saway: narito, aking ibubuhos ang aking espiritu sa inyo."
            },
            {
              "chapter": 1,
              "verse": 24,
              "name": "Mga Kawikaan 1:24",
              "text": "Sapagka't ako'y tumawag, at kayo'y tumanggi: aking iniunat ang aking kamay, at walang makinig;"
            },
            {
              "chapter": 1,
              "verse": 25,
              "name": "Mga Kawikaan 1:25",
              "text": "Kundi inyong iniuwi sa wala ang buo kong payo, at hindi ninyo inibig ang aking saway:"
            },
            {
              "chapter": 1,
              "verse": 26,
              "name": "Mga Kawikaan 1:26",
              "text": "Ako naman ay tatawa sa kaarawan ng inyong kasakunaan: ako'y manunuya pagka ang inyong takot ay dumarating;"
            },
            {
              "chapter": 1,
              "verse": 27,
              "name": "Mga Kawikaan 1:27",
              "text": "Pagka ang iyong takot ay dumarating na parang bagyo. At ang inyong kasakunaan ay dumarating na parang ipoipo; pagka ang hirap at hapis ay dumating sa inyo."
            },
            {
              "chapter": 1,
              "verse": 28,
              "name": "Mga Kawikaan 1:28",
              "text": "Kung magkagayo'y tatawag sila sa akin, nguni't hindi ako sasagot; hahanapin nila akong masikap, nguni't hindi nila ako masusumpungan:"
            },
            {
              "chapter": 1,
              "verse": 29,
              "name": "Mga Kawikaan 1:29",
              "text": "Sapagka't kanilang ipinagtanim ang kaalaman, at hindi pinili ang takot sa Panginoon."
            },
            {
              "chapter": 1,
              "verse": 30,
              "name": "Mga Kawikaan 1:30",
              "text": "Ayaw sila ng aking payo; kanilang hinamak ang buo kong pagsaway:"
            },
            {
              "chapter": 1,
              "verse": 31,
              "name": "Mga Kawikaan 1:31",
              "text": "Kaya't sila'y magsisikain ng bunga ng kanilang sariling lakad, at mabubusog ng kanilang sariling mga kagagawan."
            },
            {
              "chapter": 1,
              "verse": 32,
              "name": "Mga Kawikaan 1:32",
              "text": "Sapagka't papatayin sila ng pagtalikod ng musmos, at ang pagkawalang balisa ng mga mangmang ay ang sisira sa kanila."
            },
            {
              "chapter": 1,
              "verse": 33,
              "name": "Mga Kawikaan 1:33",
              "text": "Nguni't ang nakikinig sa akin ay tatahang tiwasay. At tatahimik na walang takot sa kasamaan."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Mga Kawikaan 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Mga Kawikaan 2:1",
              "text": "Anak ko, kung iyong tatanggapin ang aking mga salita, at tataglayin mo ang aking mga utos;"
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Mga Kawikaan 2:2",
              "text": "Na anopa't iyong ikikiling ang iyong pakinig sa karunungan, at ihihilig mo ang iyong puso sa pagunawa;"
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Mga Kawikaan 2:3",
              "text": "Oo, kung ikaw ay dadaing ng pagbubulay, at itataas mo ang iyong tinig sa pagunawa;"
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Mga Kawikaan 2:4",
              "text": "Kung iyong hahanapin siya na parang pilak, at sasaliksikin mo siyang parang kayamanang natatago."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Mga Kawikaan 2:5",
              "text": "Kung magkagayo'y iyong mauunawa ang pagkatakot sa Panginoon, at masusumpungan mo ang kaalaman ng Dios."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Mga Kawikaan 2:6",
              "text": "Sapagka't ang Panginoon ay nagbibigay ng karunungan, sa kaniyang bibig nanggagaling ang kaalaman at kaunawaan:"
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Mga Kawikaan 2:7",
              "text": "Kaniyang pinapagtataglay ang matuwid ng magaling na karunungan, siya'y kalasag sa nagsisilakad sa pagtatapat;"
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Mga Kawikaan 2:8",
              "text": "Upang kaniyang mabantayan ang mga landas ng kahatulan, at maingatan ang daan ng kaniyang mga banal."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Mga Kawikaan 2:9",
              "text": "Kung magkagayo'y mauunawa mo ang katuwiran at ang kahatulan, at ang karampatan, oo, bawa't mabuting landas."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Mga Kawikaan 2:10",
              "text": "Sapagka't karunungan ay papasok sa iyong puso, at kaalaman ay magiging ligaya sa iyong kaluluwa;"
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Mga Kawikaan 2:11",
              "text": "Kabaitan ay magbabantay sa iyo, pagkaunawa ay magiingat sa iyo:"
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Mga Kawikaan 2:12",
              "text": "Upang iligtas ka sa daan ng kasamaan, sa mga taong nagsisipagsalita ng mga masamang bagay;"
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Mga Kawikaan 2:13",
              "text": "Na nagpapabaya ng mga landas ng katuwiran, upang magsilakad sa mga daan ng kadiliman;"
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Mga Kawikaan 2:14",
              "text": "Na nangagagalak na magsigawa ng kasamaan, at nangaaaliw sa mga karayaan ng kasamaan,"
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Mga Kawikaan 2:15",
              "text": "Na mga liko sa kanilang mga lakad, at mga suwail sa kanilang mga landas:"
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Mga Kawikaan 2:16",
              "text": "Upang iligtas ka sa masamang babae, sa makatuwid baga'y sa di kilala na nanghahalina ng kaniyang mga salita;"
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Mga Kawikaan 2:17",
              "text": "Na nagpapabaya sa kaibigan ng kaniyang kabataan, at lumilimot ng tipan ng kaniyang Dios:"
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "Mga Kawikaan 2:18",
              "text": "Sapagka't ang kaniyang bahay ay kumikiling sa kamatayan, at ang kaniyang mga landas na sa patay:"
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "Mga Kawikaan 2:19",
              "text": "Walang naparoroon sa kaniya na bumabalik uli, ni kanila mang tinatamo ang mga landas ng buhay:"
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "Mga Kawikaan 2:20",
              "text": "Upang ikaw ay makalakad ng lakad ng mabubuting tao, at maingatan ang mga landas ng matuwid."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "Mga Kawikaan 2:21",
              "text": "Sapagka't ang matuwid ay tatahan sa lupain, at ang sakdal ay mamamalagi roon."
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "Mga Kawikaan 2:22",
              "text": "Nguni't ang masama ay mahihiwalay sa lupain, at silang nagsisigawang may karayaan ay mangabubunot."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Mga Kawikaan 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Mga Kawikaan 3:1",
              "text": "Anak ko, huwag mong kalimutan ang aking kautusan; kundi ingatan ng iyong puso ang aking mga utos:"
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Mga Kawikaan 3:2",
              "text": "Sapagka't karamihan ng mga araw, at mga taon ng buhay, at kapayapaan, ay madadagdag sa iyo."
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Mga Kawikaan 3:3",
              "text": "Huwag kang pabayaan ng kaawaan at katotohanan: itali mo sa palibot ng iyong leeg; ikintal mo sa iyong puso:"
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Mga Kawikaan 3:4",
              "text": "Sa gayo'y makakasumpong ka ng lingap at mabuting kaunawaan, sa paningin ng Dios at ng tao."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Mga Kawikaan 3:5",
              "text": "Tumiwala ka sa Panginoon ng buong puso mo, at huwag kang manalig sa iyong sariling kaunawaan:"
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Mga Kawikaan 3:6",
              "text": "Kilalanin mo siya sa lahat ng iyong mga lakad, at kaniyang ituturo ang iyong mga landas."
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Mga Kawikaan 3:7",
              "text": "Huwag kang magpakapantas sa iyong sariling mga mata; matakot ka sa Panginoon, at humiwalay ka sa kasamaan:"
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Mga Kawikaan 3:8",
              "text": "Magiging kagalingan sa iyong pusod, at utak sa iyong mga buto."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Mga Kawikaan 3:9",
              "text": "Parangalin mo ang Panginoon ng iyong tinatangkilik, at ng mga unang bunga ng lahat mong ani:"
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Mga Kawikaan 3:10",
              "text": "Sa gayo'y mapupuno ang iyong mga kamalig ng sagana, at ang iyong mga alilisan ay aapawan ng bagong alak."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Mga Kawikaan 3:11",
              "text": "Anak ko, huwag mong hamakin ang parusa ng Panginoon; ni mayamot man sa kaniyang saway:"
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Mga Kawikaan 3:12",
              "text": "Sapagka't sinasaway ng Panginoon ang kaniyang iniibig: gaya ng ama sa anak na kaniyang kinaluluguran."
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Mga Kawikaan 3:13",
              "text": "Mapalad ang tao na nakakasumpong ng karunungan, at ang tao na nagtatamo ng kaunawaan."
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Mga Kawikaan 3:14",
              "text": "Sapagka't ang kalakal niya ay maigi kay sa kalakal na pilak, at ang pakinabang niyaon kay sa dalisay na ginto."
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Mga Kawikaan 3:15",
              "text": "Mahalaga nga kay sa mga rubi; at wala sa mga bagay na mananasa mo sa maihahalintulad sa kaniya,"
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Mga Kawikaan 3:16",
              "text": "Karamihan ng mga araw ay nasa kanang kamay niya, sa kaniyang kaliwang kamay ay mga kayamanan at karangalan."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Mga Kawikaan 3:17",
              "text": "Ang kaniyang mga daan ay mga daan ng kaligayahan, at lahat niyang mga landas ay kapayapaan."
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "Mga Kawikaan 3:18",
              "text": "Siya ay punong kahoy ng buhay sa mga nanghahawak sa kaniya: at mapalad ang bawa't isa na nangamamalagi sa kaniya."
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "Mga Kawikaan 3:19",
              "text": "Nilikha ng Panginoon ang lupa sa pamamagitan ng karunungan; itinatag niya ang langit sa pamamagitan ng kaunawaan."
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "Mga Kawikaan 3:20",
              "text": "Sa kaniyang kaalaman ay nabahagi ang mga kalaliman, at ang mga alapaap ay nagsipatak ng hamog."
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Mga Kawikaan 3:21",
              "text": "Anak ko, huwag silang mangahiwalay sa iyong mga mata; ingatan mo ang magaling na karunungan at ang kabaitan;"
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Mga Kawikaan 3:22",
              "text": "Sa gayo'y magiging buhay sila sa iyong kaluluwa, at biyaya sa iyong leeg."
            },
            {
              "chapter": 3,
              "verse": 23,
              "name": "Mga Kawikaan 3:23",
              "text": "Kung magkagayo'y lalakad ka ng iyong lakad na tiwasay, at ang iyong paa ay hindi matitisod."
            },
            {
              "chapter": 3,
              "verse": 24,
              "name": "Mga Kawikaan 3:24",
              "text": "Pagka ikaw ay nahihiga, hindi ka matatakot: Oo, ikaw ay mahihiga at ang iyong tulog ay magiging mahimbing."
            },
            {
              "chapter": 3,
              "verse": 25,
              "name": "Mga Kawikaan 3:25",
              "text": "Huwag kang matakot ng biglang pagkatakot, ni sa pagkabuwal man ng masama, pagka dumarating:"
            },
            {
              "chapter": 3,
              "verse": 26,
              "name": "Mga Kawikaan 3:26",
              "text": "Sapagka't ang Panginoon ay magiging iyong pagtitiwala, at iingatan ang iyong paa sa pagkahuli."
            },
            {
              "chapter": 3,
              "verse": 27,
              "name": "Mga Kawikaan 3:27",
              "text": "Huwag mong ikait ang mabuti sa kinauukulan, pagka nasa kapangyarihan ng iyong kamay na ito'y gawin."
            },
            {
              "chapter": 3,
              "verse": 28,
              "name": "Mga Kawikaan 3:28",
              "text": "Huwag mong sabihin sa iyong kapuwa, Yumaon ka, at bumalik uli, at bukas ay magbibigay ako; pagka ikaw ay mayroon."
            },
            {
              "chapter": 3,
              "verse": 29,
              "name": "Mga Kawikaan 3:29",
              "text": "Huwag kang kumatha ng kasamaan laban sa iyong kapuwa, na palibhasa't tumatahang tiwasay sa siping mo."
            },
            {
              "chapter": 3,
              "verse": 30,
              "name": "Mga Kawikaan 3:30",
              "text": "Huwag kang makipagusapin sa kanino man ng walang kadahilanan, kung hindi siya gumawa ng kasamaan sa iyo."
            },
            {
              "chapter": 3,
              "verse": 31,
              "name": "Mga Kawikaan 3:31",
              "text": "Huwag kang managhili sa taong marahas, at huwag kang pumili ng anoman sa kaniyang mga lakad."
            },
            {
              "chapter": 3,
              "verse": 32,
              "name": "Mga Kawikaan 3:32",
              "text": "Sapagka't ang suwail ay kasuklamsuklam sa Panginoon: nguni't ang kaniyang payo ay kasama ng matuwid."
            },
            {
              "chapter": 3,
              "verse": 33,
              "name": "Mga Kawikaan 3:33",
              "text": "Ang sumpa ng Panginoon ay nasa bahay ng masama; nguni't pinagpapala niya ang tahanan ng matuwid."
            },
            {
              "chapter": 3,
              "verse": 34,
              "name": "Mga Kawikaan 3:34",
              "text": "Tunay na kaniyang dinuduwahagi ang mga mangduduwahagi, nguni't binibigyan niya ng biyaya ang mababa."
            },
            {
              "chapter": 3,
              "verse": 35,
              "name": "Mga Kawikaan 3:35",
              "text": "Ang pantas ay magmamana ng kaluwalhatian; nguni't kahihiyan ay magiging ganti sa mga mangmang."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Mga Kawikaan 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Mga Kawikaan 4:1",
              "text": "Dinggin ninyo, mga anak ko, ang turo ng ama, at makinig kayo upang matuto ng kaunawaan:"
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Mga Kawikaan 4:2",
              "text": "Sapagka't bibigyan ko kayo ng mabuting aral; huwag ninyong bayaan ang aking kautusan."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Mga Kawikaan 4:3",
              "text": "Sapagka't ako'y anak sa aking ama, malumanay at bugtong sa paningin ng aking ina."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Mga Kawikaan 4:4",
              "text": "At tinuruan niya ako, at nagsabi sa akin: Pigilan ng iyong puso ang aking mga salita; ingatan mo ang aking mga utos, at mabuhay ka:"
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Mga Kawikaan 4:5",
              "text": "Magtamo ka ng karunungan, magtamo ka ng kaunawaan; huwag mong kalimutan, ni humiwalay man sa mga salita ng aking bibig:"
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Mga Kawikaan 4:6",
              "text": "Huwag mo siyang pabayaan at iingatan ka niya; ibigin mo siya at iingatan ka niya."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Mga Kawikaan 4:7",
              "text": "Karunungan ay pinaka pangulong bagay; kaya't kunin mo ang karunungan: Oo, sa lahat mong kukunin ay kunin mo ang unawa."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Mga Kawikaan 4:8",
              "text": "Iyong ibunyi siya, at kaniyang itataas ka: kaniyang dadalhin ka sa karangalan, pagka iyong niyakap siya."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Mga Kawikaan 4:9",
              "text": "Siya'y magbibigay sa iyong ulo ng pugong na biyaya: isang putong ng kagandahan ay kaniyang ibibigay sa iyo."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Mga Kawikaan 4:10",
              "text": "Dinggin mo, Oh anak ko, at iyong tanggapin ang aking mga sinasabi; at ang mga taon ng iyong buhay ay magiging marami."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Mga Kawikaan 4:11",
              "text": "Aking itinuro ka sa daan ng karunungan; aking pinatnubayan ka sa landas ng katuwiran."
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Mga Kawikaan 4:12",
              "text": "Pagka ikaw ay yumayaon hindi magigipit ang iyong mga hakbang; at kung ikaw ay tumatakbo, hindi ka matitisod."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Mga Kawikaan 4:13",
              "text": "Hawakan mong mahigpit ang turo; huwag mong bitawan: iyong ingatan; sapagka't siya'y iyong buhay."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Mga Kawikaan 4:14",
              "text": "Huwag kang pumasok sa landas ng masama, at huwag kang lumakad ng lakad ng mga masasamang tao."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Mga Kawikaan 4:15",
              "text": "Ilagan mo, huwag mong daanan; likuan mo, at magpatuloy ka."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Mga Kawikaan 4:16",
              "text": "Sapagka't hindi sila nangatutulog, malibang sila'y nakagawa ng kasamaan; at ang kanilang tulog ay napapawi, malibang sila'y makapagpabuwal."
            },
            {
              "chapter": 4,
              "verse": 17,
              "name": "Mga Kawikaan 4:17",
              "text": "Sapagka't sila'y nagsisikain ng tinapay ng kasamaan, at nagsisiinom ng alak ng karahasan."
            },
            {
              "chapter": 4,
              "verse": 18,
              "name": "Mga Kawikaan 4:18",
              "text": "Nguni't ang landas ng matuwid ay parang maliyab na liwanag, na sumisilang ng higit at higit sa sakdal na araw."
            },
            {
              "chapter": 4,
              "verse": 19,
              "name": "Mga Kawikaan 4:19",
              "text": "Ang lakad ng masama ay parang kadiliman: Hindi nila nalalaman kung ano ang kanilang kinatitisuran."
            },
            {
              "chapter": 4,
              "verse": 20,
              "name": "Mga Kawikaan 4:20",
              "text": "Anak ko, makinig ka sa aking mga salita; ikiling mo ang iyong pakinig sa aking mga sabi."
            },
            {
              "chapter": 4,
              "verse": 21,
              "name": "Mga Kawikaan 4:21",
              "text": "Huwag mangahiwalay sa iyong mga mata; Ingatan mo sa kaibuturan ng iyong puso."
            },
            {
              "chapter": 4,
              "verse": 22,
              "name": "Mga Kawikaan 4:22",
              "text": "Sapagka't buhay sa nangakakasumpong, at kagalingan sa buo nilang katawan."
            },
            {
              "chapter": 4,
              "verse": 23,
              "name": "Mga Kawikaan 4:23",
              "text": "Ingatan mo ang iyong puso ng buong sikap; sapagka't dinadaluyan ng buhay,"
            },
            {
              "chapter": 4,
              "verse": 24,
              "name": "Mga Kawikaan 4:24",
              "text": "Ihiwalay mo sa iyo ang masamang bibig, at ang mga suwail na labi ay ilayo mo sa iyo."
            },
            {
              "chapter": 4,
              "verse": 25,
              "name": "Mga Kawikaan 4:25",
              "text": "Tuminging matuwid ang iyong mga mata, at ang iyong mga talukap-mata ay tuminging matuwid sa harap mo."
            },
            {
              "chapter": 4,
              "verse": 26,
              "name": "Mga Kawikaan 4:26",
              "text": "Papanatagin mo ang landas ng iyong mga paa, at mangatatag ang lahat ng iyong lakad."
            },
            {
              "chapter": 4,
              "verse": 27,
              "name": "Mga Kawikaan 4:27",
              "text": "Huwag kang lumiko sa kanan o sa kaliwa man: ihiwalay mo ang iyong paa sa kasamaan."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Mga Kawikaan 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Mga Kawikaan 5:1",
              "text": "Anak ko, pakinggan mo ang aking karunungan; ikiling mo ang iyong pakinig sa aking unawa:"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Mga Kawikaan 5:2",
              "text": "Upang makapagingat ka ng kabaitan, at upang ang iyong mga labi ay makapagingat ng kaalaman."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Mga Kawikaan 5:3",
              "text": "Sapagka't ang mga labi ng masamang babae ay tumutulo ng pulot, at ang kaniyang bibig ay madulas kay sa langis:"
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Mga Kawikaan 5:4",
              "text": "Nguni't ang kaniyang huling wakas ay mapait kay sa ahenho, matalas na parang tabak na may talim sa magkabila."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Mga Kawikaan 5:5",
              "text": "Ang kaniyang mga paa ay nagsisibaba sa kamatayan; ang kaniyang mga hakbang ay nagsisihawak sa Sheol;"
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Mga Kawikaan 5:6",
              "text": "Na anopa't hindi niya nasusumpungan ang kapanatagan ng landas ng buhay; ang kaniyang mga lakad ay hindi panatag, at hindi niya nalalaman."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Mga Kawikaan 5:7",
              "text": "Ngayon nga, mga anak ko, dinggin ninyo ako, at huwag kayong magsihiwalay sa mga salita ng aking bibig."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Mga Kawikaan 5:8",
              "text": "Ilayo mo ang iyong lakad sa kaniya, at huwag kang lumapit sa pintuan ng kaniyang bahay:"
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Mga Kawikaan 5:9",
              "text": "Baka mo ibigay ang iyong karangalan sa iba, at ang iyong mga taon sa mga mabagsik:"
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Mga Kawikaan 5:10",
              "text": "Baka ang mga di kilalang babae ay mapuno ng iyong kalakasan; at ang iyong mga pinagpagalan ay mapasa bahay ng kaapid;"
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Mga Kawikaan 5:11",
              "text": "At ikaw ay manangis sa iyong huling wakas, pagka ang iyong laman at ang iyong katawan ay natunaw,"
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Mga Kawikaan 5:12",
              "text": "At iyong sabihin, bakit ko kinayamutan ang turo, at hinamak ng aking puso ang saway:"
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Mga Kawikaan 5:13",
              "text": "Ni hindi ko man sinunod ang tinig ng aking mga tagapagturo, O ikiling ko man ang aking pakinig sa kanila na mga nagturo sa akin!"
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Mga Kawikaan 5:14",
              "text": "Ako'y malapit sa lahat ng kasamaan sa gitna ng kapisanan at ng kapulungan."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Mga Kawikaan 5:15",
              "text": "Uminom ka ng tubig sa iyong sariling tipunan ng tubig, at sa nagsisiagos na tubig sa iyong sariling balon."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Mga Kawikaan 5:16",
              "text": "Mananabog ba ang iyong mga bukal sa kaluwangan, at mga agos ng tubig sa mga lansangan?"
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Mga Kawikaan 5:17",
              "text": "Maging iyong magisa, at huwag sa di kilala na kasama mo."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Mga Kawikaan 5:18",
              "text": "Pagpalain ang iyong bukal; at magalak ka sa asawa ng iyong kabataan."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Mga Kawikaan 5:19",
              "text": "Gaya ng maibiging usa at ng masayang usang babae, bigyan kang katiwasayan ng kaniyang dibdib sa buong panahon; at laging malugod ka sa kaniyang pagibig."
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Mga Kawikaan 5:20",
              "text": "Sapagka't bakit ka malulugod, anak ko, sa ibang babae, at yayakap sa sinapupunan ng di kilala?"
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Mga Kawikaan 5:21",
              "text": "Sapagka't ang mga lakad ng tao ay nasa harap ng mga mata ng Panginoon, at kaniyang pinapatag ang lahat niyang mga landas."
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Mga Kawikaan 5:22",
              "text": "Ang sarili niyang mga kasamaan ay kukuha sa masama. At siya'y matatalian ng mga panali ng kaniyang kasalanan."
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Mga Kawikaan 5:23",
              "text": "Siya'y mamamatay sa kakulangan ng turo; at sa kadahilanan ng kaniyang pagkaulol ay maliligaw siya."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Mga Kawikaan 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Mga Kawikaan 6:1",
              "text": "Anak ko, kung ikaw ay naging mananagot sa iyong kapuwa, kung iyong ikinamay ang iyong kamay sa di kilala,"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Mga Kawikaan 6:2",
              "text": "Ikaw ay nasilo ng mga salita ng iyong bibig, ikaw ay nahuli ng mga salita ng iyong bibig."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Mga Kawikaan 6:3",
              "text": "Gawin mo ito ngayon, anak ko, at lumigtas ka, yamang ikaw ay nahulog sa kamay ng iyong kapuwa: yumaon ka, magpakababa ka, at mangayupapa ka sa iyong kapuwa."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Mga Kawikaan 6:4",
              "text": "Huwag mong bigyan ng tulog ang iyong mga mata. O magpaidlip man sa iyong mga talukap-mata."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Mga Kawikaan 6:5",
              "text": "Lumigtas ka na parang usa sa kamay ng mangangaso, at parang ibon sa kamay ng mamimitag."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Mga Kawikaan 6:6",
              "text": "Pumaroon ka sa langgam, ikaw na tamad; masdan mo ang kaniyang mga lakad at magpakapantas ka:"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Mga Kawikaan 6:7",
              "text": "Na bagaman walang pangulo, tagapamahala, o pinuno,"
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Mga Kawikaan 6:8",
              "text": "Naghahanda ng kaniyang pagkain sa taginit, at pinipisan ang kaniyang pagkain sa pagaani."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Mga Kawikaan 6:9",
              "text": "Hanggang kailan matutulog ka, Oh tamad? Kailan ka babangon sa iyong pagkakatulog?"
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Mga Kawikaan 6:10",
              "text": "Kaunti pang pagkakatulog, kaunti pang pagkaidlip, kaunti pang paghahalukipkip ng mga kamay upang matulog:"
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Mga Kawikaan 6:11",
              "text": "Sa gayo'y ang iyong karalitaan ay darating na parang magnanakaw, at ang iyong kasalatan na parang lalaking may sandata."
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Mga Kawikaan 6:12",
              "text": "Taong walang kabuluhan, taong masama, ay siya na lumalakad na may masamang bibig;"
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Mga Kawikaan 6:13",
              "text": "Na kumikindat ng kaniyang mga mata, na nagsasalita ng kaniyang mga paa, na nagsasalita ng kaniyang mga daliri;"
            },
            {
              "chapter": 6,
              "verse": 14,
              "name": "Mga Kawikaan 6:14",
              "text": "Pagdaraya ay nasa kaniyang puso, siya'y laging kumakatha ng kasamaan; siya'y naghahasik ng pagtatalo."
            },
            {
              "chapter": 6,
              "verse": 15,
              "name": "Mga Kawikaan 6:15",
              "text": "Kaya't darating na bigla ang kaniyang kasakunaan; sa kabiglaanan ay mababasag siya, at walang kagamutan."
            },
            {
              "chapter": 6,
              "verse": 16,
              "name": "Mga Kawikaan 6:16",
              "text": "May anim na bagay na ipinagtatanim ng Panginoon; Oo, pito na mga kasuklamsuklam sa kaniya:"
            },
            {
              "chapter": 6,
              "verse": 17,
              "name": "Mga Kawikaan 6:17",
              "text": "Mga palalong mata, sinungaling na dila, at mga kamay na nagbububo ng walang salang dugo;"
            },
            {
              "chapter": 6,
              "verse": 18,
              "name": "Mga Kawikaan 6:18",
              "text": "Puso na kumakatha ng mga masamang akala, mga paa na matulin sa pagtakbo sa kasamaan;"
            },
            {
              "chapter": 6,
              "verse": 19,
              "name": "Mga Kawikaan 6:19",
              "text": "Sinungaling na saksi na nagsasalita ng kabulaanan, at ang naghahasik ng pagtatalo sa gitna ng magkakapatid."
            },
            {
              "chapter": 6,
              "verse": 20,
              "name": "Mga Kawikaan 6:20",
              "text": "Anak ko, ingatan mo ang utos ng iyong ama, at huwag mong kalimutan ang kautusan ng iyong ina:"
            },
            {
              "chapter": 6,
              "verse": 21,
              "name": "Mga Kawikaan 6:21",
              "text": "Ikintal mong lagi sa iyong puso, itali mo sa iyong leeg."
            },
            {
              "chapter": 6,
              "verse": 22,
              "name": "Mga Kawikaan 6:22",
              "text": "Pagka ikaw ay lumalakad, papatnubay sa iyo; pagka ikaw ay natutulog, babantay sa iyo; at pagka ikaw ay gumigising, makikipagusap sa iyo."
            },
            {
              "chapter": 6,
              "verse": 23,
              "name": "Mga Kawikaan 6:23",
              "text": "Sapagka't ang utos ay tanglaw; at ang kautusan ay liwanag; at ang mga saway na turo ay daan ng buhay:"
            },
            {
              "chapter": 6,
              "verse": 24,
              "name": "Mga Kawikaan 6:24",
              "text": "Upang ingatan ka sa masamang babae, Sa tabil ng dila ng di kilala."
            },
            {
              "chapter": 6,
              "verse": 25,
              "name": "Mga Kawikaan 6:25",
              "text": "Huwag mong pitahin ang kaniyang kagandahan sa iyong puso; at huwag ka mang hulihin niya ng kaniyang mga talukap-mata."
            },
            {
              "chapter": 6,
              "verse": 26,
              "name": "Mga Kawikaan 6:26",
              "text": "Sapagka't dahil sa isang masamang babae ay walang naiiwan sa lalake kundi isang putol na tinapay: at hinuhuli ng mangangalunya ang mahalagang buhay."
            },
            {
              "chapter": 6,
              "verse": 27,
              "name": "Mga Kawikaan 6:27",
              "text": "Makakukuha ba ng apoy ang tao sa kaniyang sinapupunan, at hindi masusunog ang kaniyang mga suot?"
            },
            {
              "chapter": 6,
              "verse": 28,
              "name": "Mga Kawikaan 6:28",
              "text": "O makalalakad ba ang sinoman sa mga mainit na baga, at ang kaniyang mga paa ay hindi mapapaso?"
            },
            {
              "chapter": 6,
              "verse": 29,
              "name": "Mga Kawikaan 6:29",
              "text": "Gayon ang sumisiping sa asawa ng kaniyang kapuwa; sinomang humipo ay hindi maaaring di parusahan."
            },
            {
              "chapter": 6,
              "verse": 30,
              "name": "Mga Kawikaan 6:30",
              "text": "Hindi hinahamak ng mga tao ang magnanakaw kung siya'y nagnanakaw, upang busugin siya pagka siya'y gutom:"
            },
            {
              "chapter": 6,
              "verse": 31,
              "name": "Mga Kawikaan 6:31",
              "text": "Nguni't kung siya'y masumpungan, isasauli niyang makapito; kaniyang ibibigay ang lahat na laman ng kaniyang bahay."
            },
            {
              "chapter": 6,
              "verse": 32,
              "name": "Mga Kawikaan 6:32",
              "text": "Siyang nagkakamit ng pangangalunya sa isang babae ay walang bait: ang gumagawa niyaon ay nagpapahamak sa kaniyang sariling kaluluwa."
            },
            {
              "chapter": 6,
              "verse": 33,
              "name": "Mga Kawikaan 6:33",
              "text": "Mga sugat at kasiraang puri ang tatamuhin niya; at ang kaniyang kapintasan ay hindi mapapawi."
            },
            {
              "chapter": 6,
              "verse": 34,
              "name": "Mga Kawikaan 6:34",
              "text": "Sapagka't ang paninibugho ay pagiinit ng tao; at hindi siya magpapatawad sa kaarawan ng panghihiganti."
            },
            {
              "chapter": 6,
              "verse": 35,
              "name": "Mga Kawikaan 6:35",
              "text": "Hindi niya pakukundanganan ang anomang tubos; ni magpapahinga man siyang tuwa, bagaman ikaw ay magbigay ng maraming suhol."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Mga Kawikaan 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Mga Kawikaan 7:1",
              "text": "Anak ko ingatan mo ang aking mga salita, at impukin mo sa iyo ang aking mga utos."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Mga Kawikaan 7:2",
              "text": "Ingatan mo ang aking mga utos at mabuhay ka; at ang aking kautusan na parang itim ng iyong mata."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Mga Kawikaan 7:3",
              "text": "Itali mo sa iyong mga daliri; ikintal mo sa iyong puso."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Mga Kawikaan 7:4",
              "text": "Sabihin mo sa karunungan, Ikaw ay aking kapatid na babae; at tawagin mong iyong kamaganak na babae ang unawa:"
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Mga Kawikaan 7:5",
              "text": "Upang kanilang maingatan ka sa babaing masama; sa babaing di kilala na nagtatabil ng kaniyang mga salita."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Mga Kawikaan 7:6",
              "text": "Sapagka't sa dungawan ng aking bahay tumitingin ako sa aking solihia;"
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Mga Kawikaan 7:7",
              "text": "At ako'y tumingin sa mga musmos, ako'y nagmasid sa mga may kabataan, sa may kabataang walang bait,"
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Mga Kawikaan 7:8",
              "text": "Na dumaraan sa lansangan na malapit sa kaniyang sulok, at siya'y yumaon sa daan na patungo sa kaniyang bahay;"
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Mga Kawikaan 7:9",
              "text": "Sa pagtatakip silim, sa kinagabihan ng araw, sa kalahatian ng gabi, at sa kadiliman."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Mga Kawikaan 7:10",
              "text": "At, narito, doo'y nasalubong niya ang isang babae na nakagayak ng tila isang patutot, at tuso sa puso."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Mga Kawikaan 7:11",
              "text": "Siya'y madaldal at matigas ang ulo; ang kaniyang mga paa ay hindi nagsisitahan sa kaniyang bahay:"
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Mga Kawikaan 7:12",
              "text": "Ngayo'y nasa mga lansangan siya, mamaya'y nasa mga luwal na dako siya, at nagaabang sa bawa't sulok,"
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Mga Kawikaan 7:13",
              "text": "Sa gayo'y hinahawakan niya siya at hinahagkan siya, at may mukhang walang hiya na nagsasabi siya sa kaniya:"
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Mga Kawikaan 7:14",
              "text": "Mga hain na mga handog tungkol sa kapayapaan ay sa akin; sa araw na ito ay tinupad ko ang aking mga panata."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Mga Kawikaan 7:15",
              "text": "Kaya't lumabas ako upang salubungin ka, hinanap kong masikap ang iyong mukha, at nasumpungan kita."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Mga Kawikaan 7:16",
              "text": "Aking inilatag ang aking higaan na may mga coltsong may burda, na yari sa guhitguhit na kayong lana sa Egipto."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Mga Kawikaan 7:17",
              "text": "At aking pinabanguhan ang aking higaan ng mira, mga oleo, at sinamomo."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Mga Kawikaan 7:18",
              "text": "Parito ka, tayo'y magpakasiya sa pagsisintahan hanggang sa kinaumagahan; magpakasaya tayo sa mga pagsisintahan."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Mga Kawikaan 7:19",
              "text": "Sapagka't ang lalake ay wala sa bahay, siya'y naglakbay sa malayo:"
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Mga Kawikaan 7:20",
              "text": "Siya'y nagdala ng supot ng salapi; siya'y uuwi sa bahay sa kabilugan ng buwan."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Mga Kawikaan 7:21",
              "text": "Kaniyang pinasusuko siya ng karamihan ng kaniyang mga matamis na salita, hinihila niya siya ng katabilan ng kaniyang mga labi."
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Mga Kawikaan 7:22",
              "text": "Pagdaka ay sumusunod siya sa kaniya, gaya ng toro na naparoroon sa patayan, O gaya ng sa mga tanikala sa sawayan sa mangmang;"
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Mga Kawikaan 7:23",
              "text": "Hanggang sa lagpasan ng isang palaso ang kaniyang atay; gaya ng ibong nagmamadali sa bitag, at hindi nakakaalam na yao'y sa kaniyang buhay."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Mga Kawikaan 7:24",
              "text": "Ngayon nga, mga anak ko, dinggin ninyo ako, at makinig kayo ng mga salita ng aking bibig."
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "Mga Kawikaan 7:25",
              "text": "Huwag humilig ang iyong puso sa kaniyang mga lakad, huwag kang lumiko sa kaniyang mga landas."
            },
            {
              "chapter": 7,
              "verse": 26,
              "name": "Mga Kawikaan 7:26",
              "text": "Sapagka't kaniyang inihiga ang maraming may sugat: Oo, lahat niyang pinatay ay isang makapangyarihang hukbo."
            },
            {
              "chapter": 7,
              "verse": 27,
              "name": "Mga Kawikaan 7:27",
              "text": "Ang kaniyang bahay ay daang patungo sa Sheol. Pababa sa mga silid ng kamatayan."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Mga Kawikaan 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Mga Kawikaan 8:1",
              "text": "Hindi ba umiiyak ang karunungan, at inilalabas ng unawa ang kaniyang tinig?"
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Mga Kawikaan 8:2",
              "text": "Sa taluktok ng mga mataas na dako sa tabi ng daan, sa mga salubungang landas, siya'y tumatayo;"
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Mga Kawikaan 8:3",
              "text": "Sa tabi ng mga pintuang-bayan sa pasukan ng bayan, sa pasukan sa mga pintuan siya'y humihiyaw ng malakas:"
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Mga Kawikaan 8:4",
              "text": "Sa inyo, Oh mga lalake, ako'y tumatawag; at ang aking tinig ay sa mga anak ng mga tao."
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Mga Kawikaan 8:5",
              "text": "Oh kayong mga musmos, magsiunawa kayo ng katalinuhan; at, kayong mga mangmang, makaunawa kayo sa puso."
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Mga Kawikaan 8:6",
              "text": "Kayo'y mangakinig, sapagka't magsasalita ako ng mga marilag na bagay; at ang buka ng aking mga labi ay magiging mga matuwid na bagay,"
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Mga Kawikaan 8:7",
              "text": "Sapagka't ang aking bibig ay sasambit ng katotohanan; at kasamaan ay karumaldumal sa aking mga labi."
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Mga Kawikaan 8:8",
              "text": "Lahat ng mga salita ng aking bibig ay sa katuwiran; walang bagay na liko o suwail sa kanila."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Mga Kawikaan 8:9",
              "text": "Pawang malilinaw sa kaniya na nakakaunawa, at matuwid sa kanila na nangakakasumpong ng kaalaman."
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Mga Kawikaan 8:10",
              "text": "Tanggapin mo ang aking turo at huwag pilak; at ang kaalaman na higit kay sa dalisay na ginto."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Mga Kawikaan 8:11",
              "text": "Sapagka't ang karunungan ay maigi kay sa mga rubi; at lahat ng mga bagay na mananasa ay hindi maitutulad sa kaniya."
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Mga Kawikaan 8:12",
              "text": "Akong karunungan ay tumatahan sa kabaitan, at aking nasusumpungan ang kaalaman at gunita."
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Mga Kawikaan 8:13",
              "text": "Ang pagkatakot sa Panginoon ay ipagtanim ang kasamaan; Kapalaluan, at kahambugan at masamang lakad, at ang masamang bibig ay aking ipinagtatanim."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Mga Kawikaan 8:14",
              "text": "Payo ay akin at magaling na kaalaman: ako'y kaunawaan; ako'y may kapangyarihan,"
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Mga Kawikaan 8:15",
              "text": "Sa pamamagitan ko ay naghahari ang mga hari, at nagpapasiya ng kaganapan ang mga pangulo."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Mga Kawikaan 8:16",
              "text": "Sa pamamagitan ko ay nagpupuno ang mga pangulo, at ang mga mahal na tao, sa makatuwid baga'y lahat ng mga hukom sa lupa."
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Mga Kawikaan 8:17",
              "text": "Aking iniibig sila na nagsisiibig sa akin; at yaong nagsisihanap na masikap sa akin ay masusumpungan ako."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "Mga Kawikaan 8:18",
              "text": "Mga kayamanan at karangalan ay nasa akin; Oo, lumalaging mga kayamanan at katuwiran."
            },
            {
              "chapter": 8,
              "verse": 19,
              "name": "Mga Kawikaan 8:19",
              "text": "Ang bunga ko ay maigi kay sa ginto, oo, kay sa dalisay na ginto; at ang pakinabang sa akin kay sa piling pilak."
            },
            {
              "chapter": 8,
              "verse": 20,
              "name": "Mga Kawikaan 8:20",
              "text": "Ako'y lumalakad sa daan ng katuwiran, sa gitna ng mga landas ng kahatulan:"
            },
            {
              "chapter": 8,
              "verse": 21,
              "name": "Mga Kawikaan 8:21",
              "text": "Upang aking papagmanahin ng pag-aari yaong nagsisiibig sa akin, at upang aking mapuno ang kanilang ingatang-yaman."
            },
            {
              "chapter": 8,
              "verse": 22,
              "name": "Mga Kawikaan 8:22",
              "text": "Inari ako ng Panginoon sa pasimula ng kaniyang lakad, bago pinasimulan ang kaniyang mga gawa ng una."
            },
            {
              "chapter": 8,
              "verse": 23,
              "name": "Mga Kawikaan 8:23",
              "text": "Ako'y nalagay mula noong araw mula ng walang pasimula, bago nalikha ang lupa."
            },
            {
              "chapter": 8,
              "verse": 24,
              "name": "Mga Kawikaan 8:24",
              "text": "Ako'y nailabas ng wala pang mga kalaliman; nang wala pang mga bukal na sagana ng tubig."
            },
            {
              "chapter": 8,
              "verse": 25,
              "name": "Mga Kawikaan 8:25",
              "text": "Bago ang mga bundok ay nalagay, bago ang mga burol ay ako'y nailabas:"
            },
            {
              "chapter": 8,
              "verse": 26,
              "name": "Mga Kawikaan 8:26",
              "text": "Samantalang hindi pa niya nililikha ang lupa, ni ang mga parang man, ni ang pasimula man ng alabok ng sanglibutan."
            },
            {
              "chapter": 8,
              "verse": 27,
              "name": "Mga Kawikaan 8:27",
              "text": "Nang kaniyang itatag ang langit nandoon ako: nang siya'y maglagay ng balantok sa balat ng kalaliman:"
            },
            {
              "chapter": 8,
              "verse": 28,
              "name": "Mga Kawikaan 8:28",
              "text": "Nang kaniyang pagtibayin ang langit sa itaas: nang maging matibay ang mga bukal ng kalaliman:"
            },
            {
              "chapter": 8,
              "verse": 29,
              "name": "Mga Kawikaan 8:29",
              "text": "Nang bigyan niya ang dagat ng kaniyang hangganan, upang huwag salangsangin ng tubig ang kaniyang utos: nang kaniyang iayos ang mga patibayan ng lupa:"
            },
            {
              "chapter": 8,
              "verse": 30,
              "name": "Mga Kawikaan 8:30",
              "text": "Nasa siping nga niya ako na gaya ng matalinong manggagawa: at ako ang kaniyang ligaya sa araw-araw, na nagagalak na lagi sa harap niya;"
            },
            {
              "chapter": 8,
              "verse": 31,
              "name": "Mga Kawikaan 8:31",
              "text": "Na nagagalak sa kaniyang tinatahanang lupa; at ang aking kaaliwan ay sa mga anak ng mga tao."
            },
            {
              "chapter": 8,
              "verse": 32,
              "name": "Mga Kawikaan 8:32",
              "text": "Ngayon nga, mga anak ko, dinggin ninyo ako: sapagka't mapalad ang nangagiingat ng aking mga daan."
            },
            {
              "chapter": 8,
              "verse": 33,
              "name": "Mga Kawikaan 8:33",
              "text": "Mangakinig kayo ng turo, at kayo'y magpakapantas, at huwag ninyong tanggihan."
            },
            {
              "chapter": 8,
              "verse": 34,
              "name": "Mga Kawikaan 8:34",
              "text": "Mapalad ang tao na nakikinig sa akin, na nagbabantay araw-araw sa aking mga pintuang-bayan, na naghihintay sa mga haligi ng aking mga pintuan."
            },
            {
              "chapter": 8,
              "verse": 35,
              "name": "Mga Kawikaan 8:35",
              "text": "Sapagka't sinomang nakakasumpong sa akin, ay nakakasumpong ng buhay. At magtatamo ng lingap ng Panginoon."
            },
            {
              "chapter": 8,
              "verse": 36,
              "name": "Mga Kawikaan 8:36",
              "text": "Nguni't siyang nagkakasala laban sa akin ay nagliligaw ng kaniyang sariling kaluluwa; silang lahat na nangagtatanim sa akin ay nagsisiibig ng kamatayan."
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Mga Kawikaan 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Mga Kawikaan 9:1",
              "text": "Itinayo ng karunungan ang kaniyang bahay, kaniyang tinabas ang kaniyang pitong haligi:"
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Mga Kawikaan 9:2",
              "text": "Pinatay niya ang kaniyang mga hayop: hinaluan niya ang kaniyang alak; kaniya namang ginayakan ang kaniyang dulang."
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Mga Kawikaan 9:3",
              "text": "Kaniya namang sinugo ang kaniyang mga alilang babae; siya'y sumisigaw sa mga pinakapantas na dako sa bayan:"
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Mga Kawikaan 9:4",
              "text": "Kung sinoma'y musmos, pumasok dito: tungkol sa kaniya na mapurol sa pagunawa, sinasabi niya sa kaniya:"
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Mga Kawikaan 9:5",
              "text": "Kayo'y magsiparito, magsikain kayo ng aking tinapay, at magsiinom kayo ng alak na aking hinaluan."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Mga Kawikaan 9:6",
              "text": "Iwan ninyo, ninyong mga musmos at kayo'y mabuhay; at kayo'y magsilakad sa daan ng kaunawaan."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Mga Kawikaan 9:7",
              "text": "Siyang sumasaway sa manglilibak ay nagtataglay ng kahihiyan sa kaniyang sarili: at siyang sumasaway sa masama ay nagtataglay ng pula sa kaniyang sarili."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Mga Kawikaan 9:8",
              "text": "Huwag mong sawayin ang manglilibak, baka ipagtanim ka niya: sawayin mo ang pantas, at kaniyang iibigin ka."
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Mga Kawikaan 9:9",
              "text": "Turuan mo ang pantas, at siya'y magiging lalong pantas pa: iyong turuan ang matuwid, at siya'y lalago sa pagkatuto."
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Mga Kawikaan 9:10",
              "text": "Ang pagkatakot sa Panginoon ay pasimula ng karunungan: at ang pagkakilala sa Banal ay kaunawaan."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Mga Kawikaan 9:11",
              "text": "Sapagka't sa pamamagitan ko ay dadami ang iyong mga kaarawan, at ang mga taon ng iyong buhay ay magsisidami."
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Mga Kawikaan 9:12",
              "text": "Kung ikaw ay pantas, ikaw ay pantas sa ganang iyong sarili: at kung ikaw ay manglilibak, ikaw na magisa ang magpapasan."
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Mga Kawikaan 9:13",
              "text": "Ang hangal na babae ay madaldal; siya'y musmos at walang nalalaman."
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Mga Kawikaan 9:14",
              "text": "At siya'y nauupo sa pintuan ng kaniyang bahay, sa isang upuan sa mga mataas na dako sa bayan,"
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Mga Kawikaan 9:15",
              "text": "Upang tawagin ang nangagdadaan, na nagsisiyaong matuwid ng kanilang mga lakad:"
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Mga Kawikaan 9:16",
              "text": "Sinomang musmos ay pumasok dito: at tungkol sa kaniya na mapurol sa pagunawa, sinasabi niya sa kaniya:"
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Mga Kawikaan 9:17",
              "text": "Ang mga nakaw na tubig ay matamis, at ang tinapay na kinakain sa lihim ay masarap."
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Mga Kawikaan 9:18",
              "text": "Nguni't hindi niya nalalaman na ang patay ay nandoon; na ang mga panauhin niya ay nangasa mga kalaliman ng Sheol."
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Mga Kawikaan 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Mga Kawikaan 10:1",
              "text": "Mga kawikaan ni Salomon. Ang pantas na anak ay nakapagpapasaya sa ama: nguni't ang mangmang na anak ay pasan ng kaniyang ina."
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Mga Kawikaan 10:2",
              "text": "Mga kayamanan ng kasamaan ay hindi napapakinabangan: nguni't ang katuwiran ay nagliligtas sa kamatayan."
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Mga Kawikaan 10:3",
              "text": "Hindi titiisin ng Panginoon na magutom ang kaluluwa ng matuwid: nguni't kaniyang itinatakuwil ang nasa ng masama."
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Mga Kawikaan 10:4",
              "text": "Siya'y nagiging dukha na gumagawa ng kamay na walang kasipagan: nguni't yumayaman ang kamay ng masipag."
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Mga Kawikaan 10:5",
              "text": "Siyang nagtitipon sa taginit ay pantas na anak: nguni't siyang natutulog sa pagaani ay anak na kahiyahiya."
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Mga Kawikaan 10:6",
              "text": "Mga pagpapala ay nangasa ulo ng matuwid: nguni't tinatakpan ng karahasan ang bibig ng masama."
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Mga Kawikaan 10:7",
              "text": "Ang alaala sa ganap ay pinagpapala: nguni't ang pangalan ng masama ay mapaparam."
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Mga Kawikaan 10:8",
              "text": "Ang pantas sa puso ay tatanggap ng mga utos: nguni't ang madaldal na musmos ay mabubuwal."
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Mga Kawikaan 10:9",
              "text": "Siyang lumalakad ng matuwid ay lumalakad na tiwasay: nguni't siyang sumisira ng kaniyang mga lakad ay makikilala."
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Mga Kawikaan 10:10",
              "text": "Siyang kumikindat ng mata ay nagpapapanglaw: nguni't ang madaldal na musmos ay mabubuwal."
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Mga Kawikaan 10:11",
              "text": "Ang bibig ng matuwid, ay bukal ng kabuhayan: nguni't tinatakpan ng karahasan ang bibig ng masama."
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Mga Kawikaan 10:12",
              "text": "Ang pagtatanim ay humihila ng mga kaalitan: nguni't tinatakpan ng pagibig ang lahat ng pagsalangsang."
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Mga Kawikaan 10:13",
              "text": "Nasusumpungan sa mga labi ng mabait ang karunungan: nguni't ang pamalo ay sa likod ng walang unawa."
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Mga Kawikaan 10:14",
              "text": "Ang mga pantas ay nagiimbak ng kaalaman: nguni't ang bibig ng mangmang ay kasalukuyang ikapapahamak."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Mga Kawikaan 10:15",
              "text": "Ang kayamanan ng mayaman ay ang kaniyang matibay na bayan: ang kapahamakan ng dukha ay ang kanilang karalitaan."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Mga Kawikaan 10:16",
              "text": "Ang gawa ng matuwid ay patungo sa buhay; ang bunga ng dukha ay sa pagkakasala."
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Mga Kawikaan 10:17",
              "text": "Nasa daan ng buhay siyang nakikinig ng saway: nguni't siyang nagpapabaya ng saway ay nagkakamali."
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Mga Kawikaan 10:18",
              "text": "Siyang nagkukubli ng mga pagtatanim ay sa mga magdarayang labi; at siyang nagpaparatang ay mangmang."
            },
            {
              "chapter": 10,
              "verse": 19,
              "name": "Mga Kawikaan 10:19",
              "text": "Sa karamihan ng mga salita ay hindi nagkukulang ng pagsalangsang: nguni't siyang nagpipigil ng kaniyang mga labi ay gumagawang may kapantasan."
            },
            {
              "chapter": 10,
              "verse": 20,
              "name": "Mga Kawikaan 10:20",
              "text": "Ang dila ng matuwid ay parang piling pilak: ang puso ng masama ay kaunti ang halaga."
            },
            {
              "chapter": 10,
              "verse": 21,
              "name": "Mga Kawikaan 10:21",
              "text": "Ang mga labi ng matuwid ay nagpapakain ng marami: nguni't ang mangmang ay namamatay sa kakulangan ng pagunawa."
            },
            {
              "chapter": 10,
              "verse": 22,
              "name": "Mga Kawikaan 10:22",
              "text": "Ang pagpapala ng Panginoon, ay nagpapayaman, at hindi niya idinadagdag ang kapanglawan."
            },
            {
              "chapter": 10,
              "verse": 23,
              "name": "Mga Kawikaan 10:23",
              "text": "Isang paglilibang sa mangmang ang paggawa ng kasamaan: at gayon ang karunungan sa taong naguunawa."
            },
            {
              "chapter": 10,
              "verse": 24,
              "name": "Mga Kawikaan 10:24",
              "text": "Ang takot ng masama ay darating sa kaniya: at ang nasa ng matuwid ay ipagkakaloob."
            },
            {
              "chapter": 10,
              "verse": 25,
              "name": "Mga Kawikaan 10:25",
              "text": "Pagka ang ipoipo ay dumadaan ay nawawala ang masama: nguni't ang matuwid ay walang hanggang patibayan."
            },
            {
              "chapter": 10,
              "verse": 26,
              "name": "Mga Kawikaan 10:26",
              "text": "Kung paano ang suka sa mga ngipin, at kung paano ang usok sa mata, gayon ang tamad sa mga nagsusugo sa kaniya."
            },
            {
              "chapter": 10,
              "verse": 27,
              "name": "Mga Kawikaan 10:27",
              "text": "Ang pagkatakot sa Panginoon ay nagpapalaon ng mga kaarawan: nguni't ang mga taon ng masama ay mangangaunti."
            },
            {
              "chapter": 10,
              "verse": 28,
              "name": "Mga Kawikaan 10:28",
              "text": "Ang pagasa ng matuwid ay magiging kasayahan: nguni't ang pagasa ng masama ay mawawala."
            },
            {
              "chapter": 10,
              "verse": 29,
              "name": "Mga Kawikaan 10:29",
              "text": "Ang daan ng Panginoon ay katibayan sa matuwid; nguni't kapahamakan sa mga manggagawa ng kasamaan."
            },
            {
              "chapter": 10,
              "verse": 30,
              "name": "Mga Kawikaan 10:30",
              "text": "Ang matuwid ay hindi makikilos kailan man: nguni't ang masama ay hindi tatahan sa lupain."
            },
            {
              "chapter": 10,
              "verse": 31,
              "name": "Mga Kawikaan 10:31",
              "text": "Ang bibig ng matuwid ay nagbibigay ng karunungan: nguni't ang magdarayang dila ay ihihiwalay."
            },
            {
              "chapter": 10,
              "verse": 32,
              "name": "Mga Kawikaan 10:32",
              "text": "Nalalaman ng mga labi ng matuwid ang nakalulugod: nguni't ang bibig ng masama ay nagsasalita ng karayaan."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Mga Kawikaan 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Mga Kawikaan 11:1",
              "text": "Ang marayang timbangan ay kasuklamsuklam sa Panginoon: nguni't ang ganap na timbangan ay kaniyang kaluguran."
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Mga Kawikaan 11:2",
              "text": "Pagka dumarating ang kapalaluan ay dumarating nga ang kahihiyan: nguni't nasa mababa ang karunungan."
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Mga Kawikaan 11:3",
              "text": "Ang pagtatapat ng mga matuwid ay papatnubay sa kanila: nguni't ang mga kasuwailan ng mga taksil ay papatay sa kanila."
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Mga Kawikaan 11:4",
              "text": "Ang mga kayamanan ay walang kabuluhan sa kaarawan ng poot: nguni't ang katuwiran ay nagliligtas sa kamatayan."
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Mga Kawikaan 11:5",
              "text": "Ang katuwiran ng sakdal ay magtuturo ng kaniyang lakad: nguni't mabubuwal ang masama dahil sa kaniyang sariling kasamaan."
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Mga Kawikaan 11:6",
              "text": "Ang katuwiran ng mga matuwid ay magliligtas sa kanila: nguni't silang gumagawang may karayaan ay madadakip sa kanilang sariling kasamaan."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Mga Kawikaan 11:7",
              "text": "Pagka ang masamang tao ay namamatay, ang kaniyang pag-asa ay mapapasa pagkapahamak; at ang pagasa ng masama ay nawawala."
            },
            {
              "chapter": 11,
              "verse": 8,
              "name": "Mga Kawikaan 11:8",
              "text": "Ang matuwid ay naliligtas sa kabagabagan, at ang masama ay dumarating na kahalili niya."
            },
            {
              "chapter": 11,
              "verse": 9,
              "name": "Mga Kawikaan 11:9",
              "text": "Pinapatay ng masama ng kaniyang bibig ang kaniyang kapuwa: nguni't sa kaalaman ay maliligtas ang matuwid."
            },
            {
              "chapter": 11,
              "verse": 10,
              "name": "Mga Kawikaan 11:10",
              "text": "Pagka napapabuti ang mga matuwid ang bayan ay nagagalak: at pagka ang masama ay namamatay, may hiyawan."
            },
            {
              "chapter": 11,
              "verse": 11,
              "name": "Mga Kawikaan 11:11",
              "text": "Nabubunyi ang bayan sa pamamagitan ng pagpapala ng matuwid: nguni't napapahamak sa pamamagitan ng bibig ng masama."
            },
            {
              "chapter": 11,
              "verse": 12,
              "name": "Mga Kawikaan 11:12",
              "text": "Siyang humahamak sa kaniyang kapuwa ay walang karunungan: nguni't ang taong naguunawa ay tumatahimik."
            },
            {
              "chapter": 11,
              "verse": 13,
              "name": "Mga Kawikaan 11:13",
              "text": "Siyang yumayaong mapaghatid dumapit ay naghahayag ng mga lihim: nguni't ang may diwang tapat ay nagtatakip ng bagay."
            },
            {
              "chapter": 11,
              "verse": 14,
              "name": "Mga Kawikaan 11:14",
              "text": "Kung saan walang pantas na pamamahala, ang bayan ay nababagsak: nguni't sa karamihan ng mga tagapayo ay may kagalingan."
            },
            {
              "chapter": 11,
              "verse": 15,
              "name": "Mga Kawikaan 11:15",
              "text": "Siyang nananagot sa di kilala, ay mapapariwara: nguni't siyang nagtatanim sa pananagot ay tiwasay."
            },
            {
              "chapter": 11,
              "verse": 16,
              "name": "Mga Kawikaan 11:16",
              "text": "Ang mapagbiyayang babae ay nagiimpok ng karangalan: at ang marahas na lalake ay pumipigil ng kayamanan."
            },
            {
              "chapter": 11,
              "verse": 17,
              "name": "Mga Kawikaan 11:17",
              "text": "Ang maawaing tao ay gumagawa ng mabuti sa kaniyang sariling kaluluwa: nguni't ang taksil ay bumabagabag sa kaniyang sariling laman."
            },
            {
              "chapter": 11,
              "verse": 18,
              "name": "Mga Kawikaan 11:18",
              "text": "Ang masama ay nakikinabang ng mga marayang sahod: nguni't ang naghahasik ng katuwiran ay nagtatamo ng tiwasay na ganting pala."
            },
            {
              "chapter": 11,
              "verse": 19,
              "name": "Mga Kawikaan 11:19",
              "text": "Siyang matatag sa katuwiran ay magtatamo ng buhay: at siyang humahabol ng kasamaan ay sa kaniyang sariling ikamamatay."
            },
            {
              "chapter": 11,
              "verse": 20,
              "name": "Mga Kawikaan 11:20",
              "text": "Silang suwail sa puso ay kasuklamsuklam sa Panginoon: nguni't ang gayong sakdal sa kanilang lakad ay kaniyang kaluguran."
            },
            {
              "chapter": 11,
              "verse": 21,
              "name": "Mga Kawikaan 11:21",
              "text": "Bagaman ang kamay ay makikikamay, ang masamang tao ay walang pagsalang parurusahan: nguni't ang binhi ng matuwid ay maliligtas."
            },
            {
              "chapter": 11,
              "verse": 22,
              "name": "Mga Kawikaan 11:22",
              "text": "Kung paano ang hiyas na ginto sa nguso ng baboy, gayon ang magandang babae na walang bait."
            },
            {
              "chapter": 11,
              "verse": 23,
              "name": "Mga Kawikaan 11:23",
              "text": "Ang nasa ng matuwid ay buti lamang: nguni't ang hintay ng masama ay poot."
            },
            {
              "chapter": 11,
              "verse": 24,
              "name": "Mga Kawikaan 11:24",
              "text": "May nagsasabog, at tumutubo pa, at may humahawak naman ng higit kay sa karampatan, nguni't nauuwi lamang sa pangangailangan."
            },
            {
              "chapter": 11,
              "verse": 25,
              "name": "Mga Kawikaan 11:25",
              "text": "Ang kaluluwang mapagbigay ay tataba: at siyang dumidilig ay madidilig din."
            },
            {
              "chapter": 11,
              "verse": 26,
              "name": "Mga Kawikaan 11:26",
              "text": "Siyang humahawak ng trigo ay susumpain siya ng bayan: nguni't kapurihan ay mapapasaulo niya na nagbibili niyaon."
            },
            {
              "chapter": 11,
              "verse": 27,
              "name": "Mga Kawikaan 11:27",
              "text": "Siyang humahanap na masikap ng mabuti ay humahanap ng lingap: nguni't siyang kumakatha ng sama ay sa kaniya lalagpak."
            },
            {
              "chapter": 11,
              "verse": 28,
              "name": "Mga Kawikaan 11:28",
              "text": "Siyang tumitiwala sa kaniyang mga kayamanan ay mabubuwal: nguni't ang matuwid ay mamumukadkad na parang sariwang dahon."
            },
            {
              "chapter": 11,
              "verse": 29,
              "name": "Mga Kawikaan 11:29",
              "text": "Siyang bumabagabag ng kaniyang sariling sangbahayan ay magmamana ng hangin: at ang mangmang ay magiging alipin ng pantas sa puso."
            },
            {
              "chapter": 11,
              "verse": 30,
              "name": "Mga Kawikaan 11:30",
              "text": "Ang bunga ng matuwid ay punong kahoy ng buhay; at siyang pantas ay humihikayat ng mga kaluluwa."
            },
            {
              "chapter": 11,
              "verse": 31,
              "name": "Mga Kawikaan 11:31",
              "text": "Narito, ang matuwid ay gagantihin sa lupa: gaano pa nga kaya ang masama at makasalanan!"
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Mga Kawikaan 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Mga Kawikaan 12:1",
              "text": "Sinomang umiibig ng kasawayan ay umiibig ng kaalaman: nguni't siyang nagtatanim sa kasawayan ay hangal."
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Mga Kawikaan 12:2",
              "text": "Ang mabuting tao ay magtatamo ng lingap ng Panginoon: nguni't kaniyang parurusahan ang taong may masasamang katha."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Mga Kawikaan 12:3",
              "text": "Ang tao ay hindi matatag sa pamamagitan ng kasamaan: nguni't ang ugat ng matuwid ay hindi makikilos."
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Mga Kawikaan 12:4",
              "text": "Ang mabait na babae ay putong sa kaniyang asawa: nguni't siyang nakahihiya ay parang kabulukan sa kaniyang mga buto."
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Mga Kawikaan 12:5",
              "text": "Ang mga pagiisip ng matuwid ay ganap: nguni't ang mga payo ng masama ay magdaraya."
            },
            {
              "chapter": 12,
              "verse": 6,
              "name": "Mga Kawikaan 12:6",
              "text": "Ang mga salita ng masama ay mga bakay sa dugo: nguni't ililigtas sila ng bibig ng matuwid."
            },
            {
              "chapter": 12,
              "verse": 7,
              "name": "Mga Kawikaan 12:7",
              "text": "Ang masama ay inilulugmok at nawawala: nguni't ang sangbahayan ng matuwid ay tatayo."
            },
            {
              "chapter": 12,
              "verse": 8,
              "name": "Mga Kawikaan 12:8",
              "text": "Pupurihin ang tao ayon sa kaniyang karunungan: nguni't ang masama sa puso ay hahamakin."
            },
            {
              "chapter": 12,
              "verse": 9,
              "name": "Mga Kawikaan 12:9",
              "text": "Maigi siyang pinahahalagahan ng kaunti, at may alipin, kay sa nagmamapuri, at kinukulang ng tinapay."
            },
            {
              "chapter": 12,
              "verse": 10,
              "name": "Mga Kawikaan 12:10",
              "text": "Ang matuwid ay nagpapakundangan sa buhay ng kaniyang hayop: nguni't ang mga kaawaan ng masama ay mabagsik."
            },
            {
              "chapter": 12,
              "verse": 11,
              "name": "Mga Kawikaan 12:11",
              "text": "Siyang bumubukid ng kaniyang lupain ay magkakaroon ng saganang tinapay: nguni't siyang sumusunod sa taong walang kabuluhan ay walang unawa."
            },
            {
              "chapter": 12,
              "verse": 12,
              "name": "Mga Kawikaan 12:12",
              "text": "Ninanasa ng masama ang lambat ng mga masamang tao: nguni't ang ugat ng matuwid ay nagbubunga."
            },
            {
              "chapter": 12,
              "verse": 13,
              "name": "Mga Kawikaan 12:13",
              "text": "Nasa pagsalangsang ng mga labi ang silo sa mga masamang tao: nguni't ang matuwid ay lalabas sa kabagabagan."
            },
            {
              "chapter": 12,
              "verse": 14,
              "name": "Mga Kawikaan 12:14",
              "text": "Ang tao ay masisiyahan ng buti sa pamamagitan ng bunga ng kaniyang bibig; at ang mga gawain ng mga kamay ng tao ay babayaran sa kaniya."
            },
            {
              "chapter": 12,
              "verse": 15,
              "name": "Mga Kawikaan 12:15",
              "text": "Ang lakad ng mangmang ay matuwid sa kaniyang sariling mga mata: nguni't siyang pantas ay nakikinig sa payo."
            },
            {
              "chapter": 12,
              "verse": 16,
              "name": "Mga Kawikaan 12:16",
              "text": "Ang yamot ng mangmang ay agad nakikilala: nguni't ang mabait na tao ay nagtatakip ng kahihiyan."
            },
            {
              "chapter": 12,
              "verse": 17,
              "name": "Mga Kawikaan 12:17",
              "text": "Ang nagbabadya ng katotohanan ay nagpapakilala ng katuwiran, nguni't ang sinungaling sa saksi ay nagdadaya."
            },
            {
              "chapter": 12,
              "verse": 18,
              "name": "Mga Kawikaan 12:18",
              "text": "May nagsasalitang madalas na parang saliwan ng tabak: nguni't ang dila ng pantas ay kagalingan."
            },
            {
              "chapter": 12,
              "verse": 19,
              "name": "Mga Kawikaan 12:19",
              "text": "Ang labi ng katotohanan ay matatatag kailan man. Nguni't ang sinungaling na dila ay sa sangdali lamang."
            },
            {
              "chapter": 12,
              "verse": 20,
              "name": "Mga Kawikaan 12:20",
              "text": "Pagdaraya ay nasa puso ng mga kumakatha ng kasamaan: nguni't sa mga tagapayo ng kapayapaan ay kagalakan."
            },
            {
              "chapter": 12,
              "verse": 21,
              "name": "Mga Kawikaan 12:21",
              "text": "Walang mangyayaring kapahamakan sa matuwid: nguni't ang masama ay mapupuno ng kasamaan."
            },
            {
              "chapter": 12,
              "verse": 22,
              "name": "Mga Kawikaan 12:22",
              "text": "Mga sinungaling na labi ay kasuklamsuklam sa Panginoon: nguni't ang nagsisigawang may katotohanan ay kaniyang kaluguran."
            },
            {
              "chapter": 12,
              "verse": 23,
              "name": "Mga Kawikaan 12:23",
              "text": "Ang taong mabait ay nagkukubli ng kaalaman: nguni't ang puso ng mga mangmang ay nagtatanyag ng kamangmangan."
            },
            {
              "chapter": 12,
              "verse": 24,
              "name": "Mga Kawikaan 12:24",
              "text": "Ang kamay ng masipag ay magpupuno: nguni't ang tamad ay malalagay sa pagatag."
            },
            {
              "chapter": 12,
              "verse": 25,
              "name": "Mga Kawikaan 12:25",
              "text": "Ang kabigatan sa puso ng tao ay nagpapahukot; nguni't ang mabuting salita ay nagpapasaya."
            },
            {
              "chapter": 12,
              "verse": 26,
              "name": "Mga Kawikaan 12:26",
              "text": "Ang matuwid ay patnubay sa kaniyang kapuwa: nguni't ang lakad ng masama ay nakapagpapaligaw."
            },
            {
              "chapter": 12,
              "verse": 27,
              "name": "Mga Kawikaan 12:27",
              "text": "Ang tamad ay hindi nagiihaw ng kahit kaniyang napapangasuhan; nguni't ang mahalagang pag-aari ng tao ay sa mga masisipag."
            },
            {
              "chapter": 12,
              "verse": 28,
              "name": "Mga Kawikaan 12:28",
              "text": "Nasa daan ng katuwiran ang buhay; at sa kaniyang landas ay walang kamatayan."
            }
          ]
        },
        {
          "chapter": 13,
          "name": "Mga Kawikaan 13",
          "verses": [
            {
              "chapter": 13,
              "verse": 1,
              "name": "Mga Kawikaan 13:1",
              "text": "Dinidinig ng pantas na anak ang turo ng kaniyang ama: nguni't hindi dinidinig ng mangduduwahagi ang saway."
            },
            {
              "chapter": 13,
              "verse": 2,
              "name": "Mga Kawikaan 13:2",
              "text": "Ang tao ay kakain ng mabuti ayon sa bunga ng kaniyang bibig: nguni't ang magdaraya ay kakain ng karahasan,"
            },
            {
              "chapter": 13,
              "verse": 3,
              "name": "Mga Kawikaan 13:3",
              "text": "Siyang nagiingat ng kaniyang bibig, nagiingat ng kaniyang buhay: nguni't siyang nagbubukang maluwang ng kaniyang mga labi ay magkakaroon ng kapahamakan."
            },
            {
              "chapter": 13,
              "verse": 4,
              "name": "Mga Kawikaan 13:4",
              "text": "Ang tamad ay nagnanasa, at walang anoman: nguni't ang kaluluwa ng masipag ay tataba."
            },
            {
              "chapter": 13,
              "verse": 5,
              "name": "Mga Kawikaan 13:5",
              "text": "Ang matuwid ay nagtatanim sa pagsisinungaling: nguni't ang masama ay kasuklamsuklam, at napapahiya."
            },
            {
              "chapter": 13,
              "verse": 6,
              "name": "Mga Kawikaan 13:6",
              "text": "Bumabantay ang katuwiran sa matuwid na lakad; nguni't inilulugmok ng kasamaan ang makasalanan."
            },
            {
              "chapter": 13,
              "verse": 7,
              "name": "Mga Kawikaan 13:7",
              "text": "May nagpapakayaman, gayon ma'y walang anoman: may nagpapakadukha, gayon ma'y may malaking kayamanan."
            },
            {
              "chapter": 13,
              "verse": 8,
              "name": "Mga Kawikaan 13:8",
              "text": "Ang katubusan sa buhay ng tao ay siyang kaniyang mga kayamanan: nguni't ang dukha ay hindi nakikinig sa banta."
            },
            {
              "chapter": 13,
              "verse": 9,
              "name": "Mga Kawikaan 13:9",
              "text": "Ang ilaw ng matuwid ay nagagalak: nguni't ang ilawan ng masama ay papatayin."
            },
            {
              "chapter": 13,
              "verse": 10,
              "name": "Mga Kawikaan 13:10",
              "text": "Sa kapalaluan, ang dumarating ay pagtatalo lamang: nguni't ang karunungan ay nangasa nangaturuang maigi."
            },
            {
              "chapter": 13,
              "verse": 11,
              "name": "Mga Kawikaan 13:11",
              "text": "Ang kayamanang tinangkilik sa walang kabuluhan ay huhupa: nguni't siyang nagpipisan sa paggawa ay mararagdagan."
            },
            {
              "chapter": 13,
              "verse": 12,
              "name": "Mga Kawikaan 13:12",
              "text": "Ang pagasa na nagluluwat ay nagpapasakit ng puso: nguni't pagka ang nasa ay dumarating ay punong kahoy ng buhay."
            },
            {
              "chapter": 13,
              "verse": 13,
              "name": "Mga Kawikaan 13:13",
              "text": "Sinomang humamak sa salita ay nagdadala ng kapahamakan sa sarili: nguni't siyang natatakot sa utos ay gagantihin."
            },
            {
              "chapter": 13,
              "verse": 14,
              "name": "Mga Kawikaan 13:14",
              "text": "Ang kautusan ng pantas ay bukal ng buhay, upang lumayo sa mga silo ng kamatayan."
            },
            {
              "chapter": 13,
              "verse": 15,
              "name": "Mga Kawikaan 13:15",
              "text": "Ang mabuting kaunawaan ay nagbibigay lingap: nguni't ang lakad ng mananalangsang ay mahirap."
            },
            {
              "chapter": 13,
              "verse": 16,
              "name": "Mga Kawikaan 13:16",
              "text": "Bawa't mabait na tao ay gumagawang may kaalaman: nguni't ang mangmang ay nagkakalat ng kamangmangan."
            },
            {
              "chapter": 13,
              "verse": 17,
              "name": "Mga Kawikaan 13:17",
              "text": "Ang masamang sugo ay nahuhulog sa kasamaan: nguni't ang tapat na sugo ay kagalingan."
            },
            {
              "chapter": 13,
              "verse": 18,
              "name": "Mga Kawikaan 13:18",
              "text": "Karalitaan at kahihiyan ang tatamuhin ng nagtatakuwil ng saway: nguni't siyang nakikinig ng saway ay magkakapuri."
            },
            {
              "chapter": 13,
              "verse": 19,
              "name": "Mga Kawikaan 13:19",
              "text": "Ang nasa na natupad ay matamis sa kaluluwa: nguni't kasuklamsuklam sa mga mangmang na humiwalay sa kasamaan."
            },
            {
              "chapter": 13,
              "verse": 20,
              "name": "Mga Kawikaan 13:20",
              "text": "Lumalakad ka na kasama ng mga pantas na tao, at ikaw ay magiging pantas; nguni't ang kasama ng mga mangmang ay mapapariwara."
            },
            {
              "chapter": 13,
              "verse": 21,
              "name": "Mga Kawikaan 13:21",
              "text": "Ang kasamaan ay humahabol sa mga makasalanan; nguni't ang matuwid ay gagantihan ng mabuti."
            },
            {
              "chapter": 13,
              "verse": 22,
              "name": "Mga Kawikaan 13:22",
              "text": "Ang mabuti ay nagiiwan ng mana sa mga anak ng kaniyang mga anak; at ang kayamanan ng makasalanan ay nalalagay na ukol sa matuwid."
            },
            {
              "chapter": 13,
              "verse": 23,
              "name": "Mga Kawikaan 13:23",
              "text": "Maraming pagkain ang nasa pagsasaka ng dukha: nguni't may napapahamak dahil sa kawalan ng kaganapan."
            },
            {
              "chapter": 13,
              "verse": 24,
              "name": "Mga Kawikaan 13:24",
              "text": "Siyang naguurong ng kaniyang pamalo ay napopoot sa kaniyang anak: nguni't siyang umiibig ay nagpaparusang maminsan-minsan."
            },
            {
              "chapter": 13,
              "verse": 25,
              "name": "Mga Kawikaan 13:25",
              "text": "Ang matuwid ay kumakain hanggang sa kabusugan ng kaniyang kaluluwa; nguni't ang tiyan ng masama ay mangangailangan."
            }
          ]
        },
        {
          "chapter": 14,
          "name": "Mga Kawikaan 14",
          "verses": [
            {
              "chapter": 14,
              "verse": 1,
              "name": "Mga Kawikaan 14:1",
              "text": "Bawa't pantas na babae ay nagtatayo ng kaniyang bahay: nguni't binubunot ng mangmang, ng kaniyang sariling mga kamay."
            },
            {
              "chapter": 14,
              "verse": 2,
              "name": "Mga Kawikaan 14:2",
              "text": "Siyang lumalakad sa kaniyang katuwiran ay natatakot sa Panginoon: nguni't siyang suwail sa kaniyang mga lakad ay humahamak sa kaniya."
            },
            {
              "chapter": 14,
              "verse": 3,
              "name": "Mga Kawikaan 14:3",
              "text": "Sa bibig ng mangmang ay may tungkod ng kapalaluan: nguni't ang mga labi ng pantas ay mangagiingat ng mga yaon."
            },
            {
              "chapter": 14,
              "verse": 4,
              "name": "Mga Kawikaan 14:4",
              "text": "Kung saan walang baka, ang bangan ay malinis: nguni't ang karamihan ng bunga ay nasa kalakasan ng baka."
            },
            {
              "chapter": 14,
              "verse": 5,
              "name": "Mga Kawikaan 14:5",
              "text": "Ang tapat na saksi ay hindi magbubulaan: nguni't ang sinungaling na saksi ay nagbabadya ng mga kasinungalingan."
            },
            {
              "chapter": 14,
              "verse": 6,
              "name": "Mga Kawikaan 14:6",
              "text": "Ang manglilibak ay humahanap ng karunungan at walang nasusumpungan: nguni't ang kaalaman ay madali sa kaniya na naguunawa."
            },
            {
              "chapter": 14,
              "verse": 7,
              "name": "Mga Kawikaan 14:7",
              "text": "Paroon ka sa harapan ng taong mangmang, at hindi mo mamamalas sa kaniya ang mga labi ng kaalaman:"
            },
            {
              "chapter": 14,
              "verse": 8,
              "name": "Mga Kawikaan 14:8",
              "text": "Ang karunungan ng mabait ay makaunawa ng kaniyang lakad: nguni't ang kamangmangan ng mga mangmang ay karayaan."
            },
            {
              "chapter": 14,
              "verse": 9,
              "name": "Mga Kawikaan 14:9",
              "text": "Ang mangmang ay tumutuya sa sala: nguni't sa matuwid ay may mabuting kalooban."
            },
            {
              "chapter": 14,
              "verse": 10,
              "name": "Mga Kawikaan 14:10",
              "text": "Nalalaman ng puso ang kaniyang sariling kapaitan; at ang tagaibang lupa ay hindi nakikialam ng kaniyang kagalakan."
            },
            {
              "chapter": 14,
              "verse": 11,
              "name": "Mga Kawikaan 14:11",
              "text": "Ang bahay ng masama ay mababagsak: nguni't ang tolda ng matuwid ay mamumukadkad."
            },
            {
              "chapter": 14,
              "verse": 12,
              "name": "Mga Kawikaan 14:12",
              "text": "May daan na tila matuwid sa isang tao, nguni't ang dulo niyaon ay mga daan ng kamatayan."
            },
            {
              "chapter": 14,
              "verse": 13,
              "name": "Mga Kawikaan 14:13",
              "text": "Maging sa pagtawa man ang puso ay nagiging mapanglaw; at ang wakas ng kasayahan ay kabigatan ng loob."
            },
            {
              "chapter": 14,
              "verse": 14,
              "name": "Mga Kawikaan 14:14",
              "text": "Ang tumatalikod ng kaniyang puso ay mabubusog ng kaniyang sariling mga lakad: at masisiyahang loob ang taong mabuti."
            },
            {
              "chapter": 14,
              "verse": 15,
              "name": "Mga Kawikaan 14:15",
              "text": "Pinaniniwalaan ng musmos ang bawa't salita: nguni't ang mabait ay tumitinging mabuti sa kaniyang paglakad."
            },
            {
              "chapter": 14,
              "verse": 16,
              "name": "Mga Kawikaan 14:16",
              "text": "Ang pantas ay natatakot at humihiwalay sa kasamaan: nguni't ang mangmang ay nagpapakilalang palalo, at timawa."
            },
            {
              "chapter": 14,
              "verse": 17,
              "name": "Mga Kawikaan 14:17",
              "text": "Siyang nagagalit na madali ay gagawang may kamangmangan: at ang taong may masamang katha ay ipagtatanim."
            },
            {
              "chapter": 14,
              "verse": 18,
              "name": "Mga Kawikaan 14:18",
              "text": "Ang musmos ay nagmamana ng kamangmangan: nguni't ang mabait ay puputungan ng kaalaman."
            },
            {
              "chapter": 14,
              "verse": 19,
              "name": "Mga Kawikaan 14:19",
              "text": "Ang masama ay yumuyukod sa harap ng mabuti; at ang masama ay sa mga pintuang-daan ng matuwid."
            },
            {
              "chapter": 14,
              "verse": 20,
              "name": "Mga Kawikaan 14:20",
              "text": "Ipinagtatanim ang dukha maging ng kaniyang kapuwa: nguni't ang mayaman ay maraming kaibigan."
            },
            {
              "chapter": 14,
              "verse": 21,
              "name": "Mga Kawikaan 14:21",
              "text": "Siyang humahamak sa kaniyang kapuwa ay nagkakasala: nguni't siyang naaawa sa dukha ay mapalad siya."
            },
            {
              "chapter": 14,
              "verse": 22,
              "name": "Mga Kawikaan 14:22",
              "text": "Hindi ba sila nagkakamali na kumakatha ng kasamaan? Nguni't kaawaan at katotohanan ay sasa kanila na nagsisikatha ng mabuti."
            },
            {
              "chapter": 14,
              "verse": 23,
              "name": "Mga Kawikaan 14:23",
              "text": "Sa lahat ng gawain ay may pakinabang: nguni't ang tabil ng mga labi ay naghahatid sa karalitaan."
            },
            {
              "chapter": 14,
              "verse": 24,
              "name": "Mga Kawikaan 14:24",
              "text": "Ang putong ng mga pantas ay ang kanilang mga kayamanan: nguni't ang kamangmangan ng mga mangmang ay kamangmangan lamang."
            },
            {
              "chapter": 14,
              "verse": 25,
              "name": "Mga Kawikaan 14:25",
              "text": "Ang tapat na saksi ay nagliligtas ng mga tao: nguni't siyang nagsasalita ng mga kasinungalingan ay nagdaraya."
            },
            {
              "chapter": 14,
              "verse": 26,
              "name": "Mga Kawikaan 14:26",
              "text": "Sa pagkatakot sa Panginoon ay may matibay na pagkakatiwala: at ang kaniyang mga anak ay magkakaroon ng dakong kanlungan."
            },
            {
              "chapter": 14,
              "verse": 27,
              "name": "Mga Kawikaan 14:27",
              "text": "Ang pagkatakot sa Panginoon ay bukal ng kabuhayan, upang humiwalay sa mga silo ng kamatayan."
            },
            {
              "chapter": 14,
              "verse": 28,
              "name": "Mga Kawikaan 14:28",
              "text": "Nasa karamihan ng bayan ang kaluwalhatian ng hari: nguni't na sa pangangailangan ng bayan ang kapahamakan ng pangulo."
            },
            {
              "chapter": 14,
              "verse": 29,
              "name": "Mga Kawikaan 14:29",
              "text": "Siyang makupad sa pagkagalit ay may dakilang paguunawa: nguni't siyang madaling magalit ay nagbubunyi ng kamangmangan."
            },
            {
              "chapter": 14,
              "verse": 30,
              "name": "Mga Kawikaan 14:30",
              "text": "Ang tiwasay na puso ay buhay ng katawan: nguni't ang kapanaghilian ay kabulukan ng mga buto."
            },
            {
              "chapter": 14,
              "verse": 31,
              "name": "Mga Kawikaan 14:31",
              "text": "Siyang pumipighati sa dukha ay humahamak sa Maylalang sa kaniya. Nguni't siyang naaawa sa mapagkailangan ay nagpaparangal sa kaniya."
            },
            {
              "chapter": 14,
              "verse": 32,
              "name": "Mga Kawikaan 14:32",
              "text": "Ang masama ay manahagis sa kaniyang masamang gawa: nguni't ang matuwid ay may kanlungan sa kaniyang kamatayan."
            },
            {
              "chapter": 14,
              "verse": 33,
              "name": "Mga Kawikaan 14:33",
              "text": "Karunungan ay nagpapahinga sa puso niya na may paguunawa: nguni't ang nasa loob ng mga mangmang ay nalalaman."
            },
            {
              "chapter": 14,
              "verse": 34,
              "name": "Mga Kawikaan 14:34",
              "text": "Ang katuwiran ay nagbubunyi ng bansa: nguni't ang kasalanan ay kakutyaan sa alinmang bayan."
            },
            {
              "chapter": 14,
              "verse": 35,
              "name": "Mga Kawikaan 14:35",
              "text": "Ang lingap ng hari ay sa lingkod na gumagawa na may kapantasan: nguni't ang kaniyang poot ay magiging laban sa nakahihiya."
            }
          ]
        },
        {
          "chapter": 15,
          "name": "Mga Kawikaan 15",
          "verses": [
            {
              "chapter": 15,
              "verse": 1,
              "name": "Mga Kawikaan 15:1",
              "text": "Ang malubay na sagot ay nakapapawi ng poot: nguni't ang mabigat na salita ay humihila ng galit."
            },
            {
              "chapter": 15,
              "verse": 2,
              "name": "Mga Kawikaan 15:2",
              "text": "Ang dila ng pantas ay nagbabadya ng tuos ng kaalaman: nguni't ang bibig ng mga mangmang ay nagbubugso ng kamangmangan."
            },
            {
              "chapter": 15,
              "verse": 3,
              "name": "Mga Kawikaan 15:3",
              "text": "Ang mga mata ng Panginoon ay nasa bawa't dako, na nagbabantay sa masama at sa mabuti."
            },
            {
              "chapter": 15,
              "verse": 4,
              "name": "Mga Kawikaan 15:4",
              "text": "Ang dilang magaling ay punong kahoy ng buhay: nguni't ang kalikuan niyaon ay kasiraan ng diwa."
            },
            {
              "chapter": 15,
              "verse": 5,
              "name": "Mga Kawikaan 15:5",
              "text": "Hinahamak ng mangmang ang saway ng kaniyang ama: nguni't siyang nagpapakundangan ng saway ay gumagawang may kabaitan."
            },
            {
              "chapter": 15,
              "verse": 6,
              "name": "Mga Kawikaan 15:6",
              "text": "Sa bahay ng matuwid ay maraming kayamanan: nguni't sa mga pakinabang ng masama ay kabagabagan."
            },
            {
              "chapter": 15,
              "verse": 7,
              "name": "Mga Kawikaan 15:7",
              "text": "Ang mga labi ng pantas ay nagsasabog ng kaalaman: nguni't ang puso ng mangmang ay hindi gayon."
            },
            {
              "chapter": 15,
              "verse": 8,
              "name": "Mga Kawikaan 15:8",
              "text": "Ang hain ng masama ay kasuklamsuklam sa Panginoon: nguni't ang dalangin ng matuwid ay kaniyang kaluguran."
            },
            {
              "chapter": 15,
              "verse": 9,
              "name": "Mga Kawikaan 15:9",
              "text": "Ang lakad ng masama ay kasuklamsuklam sa Panginoon: nguni't iniibig niya ang sumusunod sa katuwiran."
            },
            {
              "chapter": 15,
              "verse": 10,
              "name": "Mga Kawikaan 15:10",
              "text": "May mabigat na saway sa kaniya, na nagpapabaya ng lakad: at siyang nagtatanim sa saway ay mamamatay."
            },
            {
              "chapter": 15,
              "verse": 11,
              "name": "Mga Kawikaan 15:11",
              "text": "Sheol at kapahamakan ay nasa harap ng Panginoon: gaanong higit pa nga ang mga puso ng mga anak ng mga tao!"
            },
            {
              "chapter": 15,
              "verse": 12,
              "name": "Mga Kawikaan 15:12",
              "text": "Ayaw ang manglilibak na siya'y sawayin. Siya'y hindi paroroon sa pantas."
            },
            {
              "chapter": 15,
              "verse": 13,
              "name": "Mga Kawikaan 15:13",
              "text": "Ang masayang puso ay nagpapasaya ng mukha: nguni't sa kapanglawan ng puso ay nababagbag ang diwa."
            },
            {
              "chapter": 15,
              "verse": 14,
              "name": "Mga Kawikaan 15:14",
              "text": "Ang puso niyaong naguunawa ay humahanap ng kaalaman: nguni't ang bibig ng mga mangmang ay kumakain ng kamangmangan."
            },
            {
              "chapter": 15,
              "verse": 15,
              "name": "Mga Kawikaan 15:15",
              "text": "Lahat ng mga araw sa nagdadalamhati ay masama: nguni't siyang may masayang puso ay may laging kapistahan."
            },
            {
              "chapter": 15,
              "verse": 16,
              "name": "Mga Kawikaan 15:16",
              "text": "Maigi ang kaunti na may pagkatakot sa Panginoon, kay sa malaking kayamanan na may kabagabagan."
            },
            {
              "chapter": 15,
              "verse": 17,
              "name": "Mga Kawikaan 15:17",
              "text": "Maigi ang pagkaing gulay na may pagibig, kay sa matabang baka at may pagtataniman."
            },
            {
              "chapter": 15,
              "verse": 18,
              "name": "Mga Kawikaan 15:18",
              "text": "Ang mainiting tao ay humihila ng pagtatalo: nguni't siyang makupad sa galit ay pumapayapa ng kaalitan."
            },
            {
              "chapter": 15,
              "verse": 19,
              "name": "Mga Kawikaan 15:19",
              "text": "Ang daan ng tamad ay gaya ng bakuran na mga dawag: nguni't ang landas ng matuwid ay ginagawang maluwang na lansangan."
            },
            {
              "chapter": 15,
              "verse": 20,
              "name": "Mga Kawikaan 15:20",
              "text": "Ang pantas na anak ay nagpapasaya ng ama: nguni't hinahamak ng mangmang ang kaniyang ina."
            },
            {
              "chapter": 15,
              "verse": 21,
              "name": "Mga Kawikaan 15:21",
              "text": "Ang kamangmangan ay kagalakan sa walang bait: nguni't pinatutuwid ng maalam ang kaniyang lakad."
            },
            {
              "chapter": 15,
              "verse": 22,
              "name": "Mga Kawikaan 15:22",
              "text": "Kung saan walang payo ay nagugulo ang mga panukala: nguni't sa karamihan ng mga tagapayo ay nangatatatag."
            },
            {
              "chapter": 15,
              "verse": 23,
              "name": "Mga Kawikaan 15:23",
              "text": "Ang tao ay may kagalakan sa sagot ng kaniyang bibig: at ang salita sa ukol na panahon, ay anong pagkabuti!"
            },
            {
              "chapter": 15,
              "verse": 24,
              "name": "Mga Kawikaan 15:24",
              "text": "Sa pantas ay paitaas ang daan ng buhay, upang kaniyang mahiwalayan ang Sheol sa ibaba."
            },
            {
              "chapter": 15,
              "verse": 25,
              "name": "Mga Kawikaan 15:25",
              "text": "Bubunutin ng Panginoon ang bahay ng palalo: nguni't kaniyang itatatag ang hangganan ng babaing bao."
            },
            {
              "chapter": 15,
              "verse": 26,
              "name": "Mga Kawikaan 15:26",
              "text": "Ang mga masamang katha ay kasuklamsuklam sa Panginoon: nguni't ang mga maligayang salita ay dalisay."
            },
            {
              "chapter": 15,
              "verse": 27,
              "name": "Mga Kawikaan 15:27",
              "text": "Siyang sakim sa pakinabang ay bumabagabag ng kaniyang sariling sangbahayan: nguni't siyang nagtatanim sa mga suhol ay mabubuhay."
            },
            {
              "chapter": 15,
              "verse": 28,
              "name": "Mga Kawikaan 15:28",
              "text": "Ang puso ng matuwid ay nagbubulay ng isasagot: nguni't ang bibig ng masama ay nagbubugso ng mga masamang bagay."
            },
            {
              "chapter": 15,
              "verse": 29,
              "name": "Mga Kawikaan 15:29",
              "text": "Ang Panginoon ay malayo sa masama: nguni't kaniyang dinidinig ang dalangin ng matuwid."
            },
            {
              "chapter": 15,
              "verse": 30,
              "name": "Mga Kawikaan 15:30",
              "text": "Ang liwanag ng mga mata ay nagpapagalak ng puso: at ang mabubuting balita ay nagpapataba ng mga buto."
            },
            {
              "chapter": 15,
              "verse": 31,
              "name": "Mga Kawikaan 15:31",
              "text": "Ang taingang nakikinig sa saway ng buhay, ay tatahan sa gitna ng pantas."
            },
            {
              "chapter": 15,
              "verse": 32,
              "name": "Mga Kawikaan 15:32",
              "text": "Siyang tumatanggi sa saway ay humahamak sa kaniyang sariling kaluluwa: nguni't siyang nakikinig sa saway ay nagtatamo ng kaawaan."
            },
            {
              "chapter": 15,
              "verse": 33,
              "name": "Mga Kawikaan 15:33",
              "text": "Ang pagkatakot sa Panginoon ay turo ng karunungan; at sa unahan ng karangalan ay nagpapauna ang pagpapakumbaba."
            }
          ]
        },
        {
          "chapter": 16,
          "name": "Mga Kawikaan 16",
          "verses": [
            {
              "chapter": 16,
              "verse": 1,
              "name": "Mga Kawikaan 16:1",
              "text": "Ang mga paghahanda ng puso ay ukol sa tao: nguni't ang sagot ng dila ay mula sa Panginoon."
            },
            {
              "chapter": 16,
              "verse": 2,
              "name": "Mga Kawikaan 16:2",
              "text": "Ang lahat ng mga lakad ng tao ay malinis sa harap ng kaniyang sariling mga mata: nguni't tinitimbang ng Panginoon ang mga diwa."
            },
            {
              "chapter": 16,
              "verse": 3,
              "name": "Mga Kawikaan 16:3",
              "text": "Iukol mo sa Panginoon ang iyong mga gawa, at ang iyong mga panukala ay matatatag."
            },
            {
              "chapter": 16,
              "verse": 4,
              "name": "Mga Kawikaan 16:4",
              "text": "Ginawa ng Panginoon ang bawa't bagay na ukol sa kaniyang sariling wakas: Oo, pati ng masama na ukol sa kaarawan ng kasamaan."
            },
            {
              "chapter": 16,
              "verse": 5,
              "name": "Mga Kawikaan 16:5",
              "text": "Bawa't palalo sa puso ay kasuklamsuklam sa Panginoon: bagaman maghawakan sa kamay ay walang pagsalang parurusahan."
            },
            {
              "chapter": 16,
              "verse": 6,
              "name": "Mga Kawikaan 16:6",
              "text": "Sa pamamagitan ng kaawaan at katotohanan ay nalilinis ang kasamaan: at sa pamamagitan ng pagkatakot sa Panginoon ay humihiwalay ang mga tao sa kasamaan."
            },
            {
              "chapter": 16,
              "verse": 7,
              "name": "Mga Kawikaan 16:7",
              "text": "Pagka ang mga lakad ng tao ay nakapagpapalugod sa Panginoon, kaniyang tinitiwasay sa kaniya pati ng kaniyang mga kaaway."
            },
            {
              "chapter": 16,
              "verse": 8,
              "name": "Mga Kawikaan 16:8",
              "text": "Maigi ang kaunti na may katuwiran kay sa malalaking pakinabang na walang kaganapan."
            },
            {
              "chapter": 16,
              "verse": 9,
              "name": "Mga Kawikaan 16:9",
              "text": "Ang puso ng tao ay kumakatha ng kaniyang lakad: nguni't ang Panginoon ang nagtutuwid ng kaniyang mga hakbang."
            },
            {
              "chapter": 16,
              "verse": 10,
              "name": "Mga Kawikaan 16:10",
              "text": "Banal na hatol ay nasa mga labi ng hari: at kaniyang bibig ay hindi sasalangsang sa kahatulan."
            },
            {
              "chapter": 16,
              "verse": 11,
              "name": "Mga Kawikaan 16:11",
              "text": "Ang ganap na timbangan at panimbang ay sa Panginoon: lahat ng timbang na supot ay kaniyang gawa."
            },
            {
              "chapter": 16,
              "verse": 12,
              "name": "Mga Kawikaan 16:12",
              "text": "Kasuklamsuklam sa mga hari na gumawa ng kasamaan: sapagka't ang luklukan ay natatatag sa pamamagitan ng katuwiran."
            },
            {
              "chapter": 16,
              "verse": 13,
              "name": "Mga Kawikaan 16:13",
              "text": "Mga matuwid na labi ay kaluguran ng mga hari; at kanilang iniibig ang nagsasalita ng matuwid."
            },
            {
              "chapter": 16,
              "verse": 14,
              "name": "Mga Kawikaan 16:14",
              "text": "Ang poot ng hari ay gaya ng mga sugo ng kamatayan: nguni't papayapain ng pantas."
            },
            {
              "chapter": 16,
              "verse": 15,
              "name": "Mga Kawikaan 16:15",
              "text": "Nasa liwanag ng mukha ng hari ang buhay; at ang kaniyang lingap ay parang alapaap ng huling ulan."
            },
            {
              "chapter": 16,
              "verse": 16,
              "name": "Mga Kawikaan 16:16",
              "text": "Pagkaigi nga na magtamo ng karunungan kay sa ginto! Oo, magtamo ng kaunawaan ay maigi kay sa pumili ng pilak."
            },
            {
              "chapter": 16,
              "verse": 17,
              "name": "Mga Kawikaan 16:17",
              "text": "Ang maluwang na lansangan ng matuwid ay humiwalay sa kasamaan: siyang nagiingat ng kaniyang lakad ay nagiingat ng kaniyang kaluluwa."
            },
            {
              "chapter": 16,
              "verse": 18,
              "name": "Mga Kawikaan 16:18",
              "text": "Ang kapalaluan ay nagpapauna sa kapahamakan, at ang mapagmataas na diwa ay sa pagkabuwal."
            },
            {
              "chapter": 16,
              "verse": 19,
              "name": "Mga Kawikaan 16:19",
              "text": "Maigi ang magkaroon ng mapagpakumbabang loob na kasama ng dukha, kay sa bumahagi ng samsam na kasama ng palalo."
            },
            {
              "chapter": 16,
              "verse": 20,
              "name": "Mga Kawikaan 16:20",
              "text": "Siyang nagiingat sa salita ay makakasumpong ng mabuti: at ang nananalig sa Panginoon ay mapalad."
            },
            {
              "chapter": 16,
              "verse": 21,
              "name": "Mga Kawikaan 16:21",
              "text": "Ang pantas sa puso ay tatawaging mabait: at ang katamisan sa mga labi ay nagdaragdag ng katututuhan."
            },
            {
              "chapter": 16,
              "verse": 22,
              "name": "Mga Kawikaan 16:22",
              "text": "Ang kaunawaan ay bukal ng buhay sa nagtatamo: nguni't ang saway ng mga mangmang ay siyang kanilang kamangmangan."
            },
            {
              "chapter": 16,
              "verse": 23,
              "name": "Mga Kawikaan 16:23",
              "text": "Ang puso ng pantas ay nagtuturo sa kaniyang bibig, at nagdaragdag ng katututuhan sa kaniyang mga labi."
            },
            {
              "chapter": 16,
              "verse": 24,
              "name": "Mga Kawikaan 16:24",
              "text": "Mga maligayang salita ay parang pulot-pukyutan, matamis sa kaluluwa at kagalingan sa mga buto."
            },
            {
              "chapter": 16,
              "verse": 25,
              "name": "Mga Kawikaan 16:25",
              "text": "May daan na tila matuwid sa tao, nguni't ang dulo niyaon ay mga daan ng kamatayan."
            },
            {
              "chapter": 16,
              "verse": 26,
              "name": "Mga Kawikaan 16:26",
              "text": "Ang gana ng pagkain ng manggagawang tao ay nakagagaling sa kaniya; sapagka't kinasasabikan ng kaniyang bibig."
            },
            {
              "chapter": 16,
              "verse": 27,
              "name": "Mga Kawikaan 16:27",
              "text": "Ang walang kabuluhang tao ay kumakatha ng kahirapan: at sa kaniyang mga labi ay may masilakbong apoy."
            },
            {
              "chapter": 16,
              "verse": 28,
              "name": "Mga Kawikaan 16:28",
              "text": "Ang magdarayang tao ay nagkakalat ng pagtatalo: at ang mapaghatid-dumapit ay naghihiwalay ng magkakaibigang matalik."
            },
            {
              "chapter": 16,
              "verse": 29,
              "name": "Mga Kawikaan 16:29",
              "text": "Ang taong marahas ay dumadaya sa kaniyang kapuwa, at pinapatnubayan niya siya sa daang hindi mabuti."
            },
            {
              "chapter": 16,
              "verse": 30,
              "name": "Mga Kawikaan 16:30",
              "text": "Ikinikindat ang kaniyang mga mata, upang kumatha ng mga magdarayang bagay: siyang nangangagat labi ay nagpapangyari sa kasamaan."
            },
            {
              "chapter": 16,
              "verse": 31,
              "name": "Mga Kawikaan 16:31",
              "text": "Ang ulong may uban ay putong ng kaluwalhatian, masusumpungan sa daan ng katuwiran."
            },
            {
              "chapter": 16,
              "verse": 32,
              "name": "Mga Kawikaan 16:32",
              "text": "Siyang makupad sa pagkagalit ay maigi kay sa makapangyarihan; at siyang nagpupuno sa kaniyang diwa ay maigi kay sa sumasakop ng isang bayan."
            },
            {
              "chapter": 16,
              "verse": 33,
              "name": "Mga Kawikaan 16:33",
              "text": "Ginagawa ang pagsasapalaran sa kandungan; nguni't ang buong pasiya niyaon ay sa Panginoon."
            }
          ]
        },
        {
          "chapter": 17,
          "name": "Mga Kawikaan 17",
          "verses": [
            {
              "chapter": 17,
              "verse": 1,
              "name": "Mga Kawikaan 17:1",
              "text": "Maigi ang isang tuyong subo at may katahimikan, kay sa bahay na may laging pistahan na may kaalitan."
            },
            {
              "chapter": 17,
              "verse": 2,
              "name": "Mga Kawikaan 17:2",
              "text": "Ang lingkod na gumagawang may kapantasan ay nagpupuno sa anak na nakahihiya, at siya'y makakabahagi sa mana ng magkakapatid."
            },
            {
              "chapter": 17,
              "verse": 3,
              "name": "Mga Kawikaan 17:3",
              "text": "Ang dalisayan ay sa pilak, at ang hurno ay sa ginto: nguni't sinusubok ng Panginoon ang mga puso."
            },
            {
              "chapter": 17,
              "verse": 4,
              "name": "Mga Kawikaan 17:4",
              "text": "Ang manggagawa ng kasamaan ay nakikinig sa masasamang labi; at ang sinungaling ay nakikinig sa masamang dila."
            },
            {
              "chapter": 17,
              "verse": 5,
              "name": "Mga Kawikaan 17:5",
              "text": "Sinomang tumutuya sa dukha ay dumudusta sa Maylalang sa kaniya: at ang natutuwa sa kasakunaan ay walang pagsalang parurusahan."
            },
            {
              "chapter": 17,
              "verse": 6,
              "name": "Mga Kawikaan 17:6",
              "text": "Ang mga anak ng mga anak ay putong ng mga matatandang tao; at ang kaluwalhatian ng mga anak ay ang kanilang mga magulang."
            },
            {
              "chapter": 17,
              "verse": 7,
              "name": "Mga Kawikaan 17:7",
              "text": "Ang marilag na pananalita ay hindi nagiging mabuti sa mangmang: lalo na ang magdarayang mga labi, sa isang pangulo."
            },
            {
              "chapter": 17,
              "verse": 8,
              "name": "Mga Kawikaan 17:8",
              "text": "Ang suhol ay parang mahalagang bato sa mga mata ng nagtatamo: saan man pumihit ay gumiginhawa."
            },
            {
              "chapter": 17,
              "verse": 9,
              "name": "Mga Kawikaan 17:9",
              "text": "Ang nagtatakip ng pagsalangsang ay humahanap ng pagibig: nguni't ang nagdadadaldal tungkol sa anoman ay naghihiwalay ng magkakaibigang matalik."
            },
            {
              "chapter": 17,
              "verse": 10,
              "name": "Mga Kawikaan 17:10",
              "text": "Ang saway ay nanasok na taimtim sa isang naguunawa, kay sa isang daang hampas sa mangmang."
            },
            {
              "chapter": 17,
              "verse": 11,
              "name": "Mga Kawikaan 17:11",
              "text": "Ang hinahanap lamang ng masamang tao ay panghihimagsik; kaya't isang mabagsik na sugo ay susuguin laban sa kaniya."
            },
            {
              "chapter": 17,
              "verse": 12,
              "name": "Mga Kawikaan 17:12",
              "text": "Masalubong ang tao ng oso na nanakawan ng kaniyang mga anak, maigi kay sa mangmang sa kaniyang kamangmangan."
            },
            {
              "chapter": 17,
              "verse": 13,
              "name": "Mga Kawikaan 17:13",
              "text": "Sinomang gumaganti ng kasamaan sa mabuti, kasamaan ay hindi hihiwalay sa kaniyang bahay."
            },
            {
              "chapter": 17,
              "verse": 14,
              "name": "Mga Kawikaan 17:14",
              "text": "Ang pasimula ng pagkakaalit ay gaya ng pagbuga ng tubig: kaya't iwan ninyo ang pagtatalo, bago maginit sa pagkakaalit."
            },
            {
              "chapter": 17,
              "verse": 15,
              "name": "Mga Kawikaan 17:15",
              "text": "Siya na umaaring ganap sa masama, at siya na nagpaparusa sa matuwid, kapuwa sila kasuklamsuklam sa Panginoon."
            },
            {
              "chapter": 17,
              "verse": 16,
              "name": "Mga Kawikaan 17:16",
              "text": "Bakit may halaga sa kamay ng mangmang upang ibili ng karunungan, gayong wala siyang pagkaunawa?"
            },
            {
              "chapter": 17,
              "verse": 17,
              "name": "Mga Kawikaan 17:17",
              "text": "Ang kaibigan ay umiibig sa lahat ng panahon, at ang kapatid ay ipinanganak na ukol sa kasakunaan."
            },
            {
              "chapter": 17,
              "verse": 18,
              "name": "Mga Kawikaan 17:18",
              "text": "Ang taong walang unawa ay nakikikamay, at nagiging mananagot sa harapan ng kaniyang kapuwa."
            },
            {
              "chapter": 17,
              "verse": 19,
              "name": "Mga Kawikaan 17:19",
              "text": "Ang umiibig sa pagsalangsang ay umiibig sa pagkakaalit: ang nagtataas ng kaniyang pintuan ay humahanap ng kapahamakan."
            },
            {
              "chapter": 17,
              "verse": 20,
              "name": "Mga Kawikaan 17:20",
              "text": "Siyang may magdarayang puso ay hindi nakakasumpong ng mabuti: at siyang may suwail na dila ay nahuhulog sa karalitaan."
            },
            {
              "chapter": 17,
              "verse": 21,
              "name": "Mga Kawikaan 17:21",
              "text": "Ang nanganganak ng mangmang ay sa kaniyang kapanglawan: at ang ama ng mangmang ay walang kagalakan."
            },
            {
              "chapter": 17,
              "verse": 22,
              "name": "Mga Kawikaan 17:22",
              "text": "Ang masayang puso ay mabuting kagamutan: nguni't ang bagbag na diwa ay tumutuyo ng mga buto."
            },
            {
              "chapter": 17,
              "verse": 23,
              "name": "Mga Kawikaan 17:23",
              "text": "Ang masama ay tumatanggap ng suhol mula sa sinapupunan, upang ipahamak ang daan ng kahatulan."
            },
            {
              "chapter": 17,
              "verse": 24,
              "name": "Mga Kawikaan 17:24",
              "text": "Karunungan ay nasa harap ng mukha ng naguunawa: nguni't ang mga mata ng mangmang ay nasa mga wakas ng lupa."
            },
            {
              "chapter": 17,
              "verse": 25,
              "name": "Mga Kawikaan 17:25",
              "text": "Ang mangmang na anak ay hirap sa kaniyang ama, at kapaitan sa nanganak sa kaniya."
            },
            {
              "chapter": 17,
              "verse": 26,
              "name": "Mga Kawikaan 17:26",
              "text": "Parusahan naman ang matuwid ay hindi mabuti, ni saktan man ang mahal na tao dahil sa kanilang katuwiran."
            },
            {
              "chapter": 17,
              "verse": 27,
              "name": "Mga Kawikaan 17:27",
              "text": "Siyang nagtitipid ng kaniyang mga salita ay may kaalaman: at siyang may diwang malamig ay taong naguunawa."
            },
            {
              "chapter": 17,
              "verse": 28,
              "name": "Mga Kawikaan 17:28",
              "text": "Ang mangmang man, pagka siya'y tumatahimik, ay nabibilang na pantas: pagka kaniyang tinitikom ang kaniyang mga labi, ay inaari siyang mabait."
            }
          ]
        },
        {
          "chapter": 18,
          "name": "Mga Kawikaan 18",
          "verses": [
            {
              "chapter": 18,
              "verse": 1,
              "name": "Mga Kawikaan 18:1",
              "text": "Ang humihiwalay ay humahanap ng sarili niyang nasa, at nakikipagtalo laban sa lahat na magaling na karunungan."
            },
            {
              "chapter": 18,
              "verse": 2,
              "name": "Mga Kawikaan 18:2",
              "text": "Ang mangmang ay walang kaluguran sa paguunawa, kundi maihayag lamang ang kaniyang puso."
            },
            {
              "chapter": 18,
              "verse": 3,
              "name": "Mga Kawikaan 18:3",
              "text": "Pagka ang masama ay dumarating, dumarating din naman ang paghamak, at kasama ng kutya ang pagkaduwahagi."
            },
            {
              "chapter": 18,
              "verse": 4,
              "name": "Mga Kawikaan 18:4",
              "text": "Ang mga salita ng bibig ng tao ay parang malalim na tubig; ang bukal ng karunungan ay parang umaagos na batis."
            },
            {
              "chapter": 18,
              "verse": 5,
              "name": "Mga Kawikaan 18:5",
              "text": "Igalang ang pagkatao ng masama ay hindi mabuti, ni iligaw man ang matuwid sa kahatulan."
            },
            {
              "chapter": 18,
              "verse": 6,
              "name": "Mga Kawikaan 18:6",
              "text": "Ang mga labi ng mangmang ay nanasok sa pagkakaalit, at tinatawag ng kaniyang bibig ang mga hampas."
            },
            {
              "chapter": 18,
              "verse": 7,
              "name": "Mga Kawikaan 18:7",
              "text": "Ang bibig ng mangmang ay kaniyang kapahamakan, at ang kaniyang mga labi ay silo ng kaniyang kaluluwa."
            },
            {
              "chapter": 18,
              "verse": 8,
              "name": "Mga Kawikaan 18:8",
              "text": "Ang mga salita ng mga mapaghatid-dumapit ay parang mga masarap na subo, at nagsisibaba sa pinakaloob ng tiyan."
            },
            {
              "chapter": 18,
              "verse": 9,
              "name": "Mga Kawikaan 18:9",
              "text": "Siya mang walang bahala sa kaniyang gawain ay kapatid siya ng maninira."
            },
            {
              "chapter": 18,
              "verse": 10,
              "name": "Mga Kawikaan 18:10",
              "text": "Ang pangalan ng Panginoon ay matibay na moog: tinatakbuhan ng matuwid at naliligtas."
            },
            {
              "chapter": 18,
              "verse": 11,
              "name": "Mga Kawikaan 18:11",
              "text": "Ang yaman ng mayamang tao ay ang kaniyang matibay na bayan, at gaya ng matayog na kuta sa kaniyang sariling isip,"
            },
            {
              "chapter": 18,
              "verse": 12,
              "name": "Mga Kawikaan 18:12",
              "text": "Bago ang pagkapahamak ay pagmamalaki ng puso ng tao, at bago ang karangalan ang pagpapakumbaba."
            },
            {
              "chapter": 18,
              "verse": 13,
              "name": "Mga Kawikaan 18:13",
              "text": "Ang sumasagot bago makinig, ay kamangmangan at kahihiyan sa kaniya."
            },
            {
              "chapter": 18,
              "verse": 14,
              "name": "Mga Kawikaan 18:14",
              "text": "Aalalayan ng diwa ng tao ang kaniyang sakit; nguni't ang bagbag na diwa sinong nakapagdadala?"
            },
            {
              "chapter": 18,
              "verse": 15,
              "name": "Mga Kawikaan 18:15",
              "text": "Ang puso ng mabait ay nagtatamo ng kaalaman; at ang pakinig ng pantas ay humahanap ng kaalaman."
            },
            {
              "chapter": 18,
              "verse": 16,
              "name": "Mga Kawikaan 18:16",
              "text": "Ang kaloob ng tao ay nagbubukas ng daan sa kaniya, at dinadala siya sa harap ng mga dakilang tao."
            },
            {
              "chapter": 18,
              "verse": 17,
              "name": "Mga Kawikaan 18:17",
              "text": "Ang nakikipaglaban ng kaniyang usap na una ay tila ganap; nguni't dumarating ang kaniyang kapuwa at sinisiyasat siya."
            },
            {
              "chapter": 18,
              "verse": 18,
              "name": "Mga Kawikaan 18:18",
              "text": "Ang pagsasapalaran ay nagpapatigil ng mga pagtatalo, at naghihiwalay sa gitna ng mga makapangyarihan."
            },
            {
              "chapter": 18,
              "verse": 19,
              "name": "Mga Kawikaan 18:19",
              "text": "Ang kapatid na nasaktan sa kalooban ay mahirap mabawi kay sa matibay na bayan: at ang gayong mga pagtatalo ay parang mga halang ng isang kastilyo."
            },
            {
              "chapter": 18,
              "verse": 20,
              "name": "Mga Kawikaan 18:20",
              "text": "Ang tiyan ng tao ay mabubusog ng bunga ng kaniyang bibig; sa bunga ng kaniyang mga labi ay masisiyahan siya."
            },
            {
              "chapter": 18,
              "verse": 21,
              "name": "Mga Kawikaan 18:21",
              "text": "Kamatayan at buhay ay nasa kapangyarihan ng dila; at ang nagsisiibig sa kaniya ay magsisikain ng kaniyang bunga."
            },
            {
              "chapter": 18,
              "verse": 22,
              "name": "Mga Kawikaan 18:22",
              "text": "Sinomang lalaking nakakasumpong ng asawa ay nakasumpong ng mabuting bagay, at nagtatamo ng lingap ng Panginoon."
            },
            {
              "chapter": 18,
              "verse": 23,
              "name": "Mga Kawikaan 18:23",
              "text": "Ang dukha ay gumagamit ng mga pamanhik: nguni't ang mayaman ay sumasagot na may kagilasan."
            },
            {
              "chapter": 18,
              "verse": 24,
              "name": "Mga Kawikaan 18:24",
              "text": "Ang nagpaparami ng mga kaibigan ay sa kaniyang sariling kapahamakan: nguni't may kaibigan na mahigit kay sa isang kapatid."
            }
          ]
        },
        {
          "chapter": 19,
          "name": "Mga Kawikaan 19",
          "verses": [
            {
              "chapter": 19,
              "verse": 1,
              "name": "Mga Kawikaan 19:1",
              "text": "Maigi ang dukha na lumalakad sa kaniyang pagtatapat kay sa suwail sa kaniyang mga labi at mangmang."
            },
            {
              "chapter": 19,
              "verse": 2,
              "name": "Mga Kawikaan 19:2",
              "text": "Gayon din ang kaluluwa na walang kaalaman ay hindi mabuti; at siyang nagmamadali ng kaniyang mga paa ay nagkakasala."
            },
            {
              "chapter": 19,
              "verse": 3,
              "name": "Mga Kawikaan 19:3",
              "text": "Ang kamangmangan ng tao ay sumisira ng kaniyang lakad; at ang kaniyang puso ay nagagalit laban sa Panginoon."
            },
            {
              "chapter": 19,
              "verse": 4,
              "name": "Mga Kawikaan 19:4",
              "text": "Ang kayamanan ay nagdadagdag ng maraming kaibigan: nguni't ang dukha ay hiwalay sa kaniyang kaibigan."
            },
            {
              "chapter": 19,
              "verse": 5,
              "name": "Mga Kawikaan 19:5",
              "text": "Ang sinungaling na saksi ay walang pagsalang parurusahan; at ang nagsasalita ng mga kasinungalingan ay hindi makatatahan."
            },
            {
              "chapter": 19,
              "verse": 6,
              "name": "Mga Kawikaan 19:6",
              "text": "Marami ang mamamanhik ng lingap sa magandang-loob: at bawa't tao ay kaibigan ng nagbibigay ng mga kaloob."
            },
            {
              "chapter": 19,
              "verse": 7,
              "name": "Mga Kawikaan 19:7",
              "text": "Ipinagtatanim siya ng lahat ng kapatid ng dukha: gaano pa nga kaya ang ilalayo sa kaniya ng kaniyang mga kaibigan! Kaniyang hinahabol sila ng mga salita, nguni't wala na sila."
            },
            {
              "chapter": 19,
              "verse": 8,
              "name": "Mga Kawikaan 19:8",
              "text": "Siyang nagiimpok ng karunungan ay umiibig sa kaniyang sariling kaluluwa: siyang nagiingat ng pagunawa ay makakasumpong ng mabuti."
            },
            {
              "chapter": 19,
              "verse": 9,
              "name": "Mga Kawikaan 19:9",
              "text": "Ang sinungaling na saksi ay walang pagsalang parurusahan; at ang nagbabadya ng mga kasinungalingan ay mamamatay."
            },
            {
              "chapter": 19,
              "verse": 10,
              "name": "Mga Kawikaan 19:10",
              "text": "Maayos na pamumuhay ay hindi magaling sa mangmang; lalo na sa alipin na magpuno sa mga pangulo."
            },
            {
              "chapter": 19,
              "verse": 11,
              "name": "Mga Kawikaan 19:11",
              "text": "Ang bait ng tao ay nagpapakupad sa galit. At kaniyang kaluwalhatian na paraanin ang pagsalangsang."
            },
            {
              "chapter": 19,
              "verse": 12,
              "name": "Mga Kawikaan 19:12",
              "text": "Ang poot ng hari ay parang ungal ng leon; nguni't ang kaniyang lingap ay parang hamog sa damo."
            },
            {
              "chapter": 19,
              "verse": 13,
              "name": "Mga Kawikaan 19:13",
              "text": "Ang mangmang na anak ay kapanglawan ng kaniyang ama: at ang mga pakikipagtalo ng asawa ay walang likat na tulo."
            },
            {
              "chapter": 19,
              "verse": 14,
              "name": "Mga Kawikaan 19:14",
              "text": "Bahay at mga kayamanan ay minamana sa mga magulang: nguni't ang mabait na asawa ay galing sa Panginoon."
            },
            {
              "chapter": 19,
              "verse": 15,
              "name": "Mga Kawikaan 19:15",
              "text": "Katamaran ay nagbabaon sa mahimbing na pagkakatulog; at ang tamad na kaluluwa ay magugutom."
            },
            {
              "chapter": 19,
              "verse": 16,
              "name": "Mga Kawikaan 19:16",
              "text": "Ang nagiingat ng utos ay nagiingat ng kaniyang kaluluwa: nguni't ang walang babala sa kaniyang mga lakad ay mamamatay."
            },
            {
              "chapter": 19,
              "verse": 17,
              "name": "Mga Kawikaan 19:17",
              "text": "Ang naaawa sa dukha ay nagpapautang sa Panginoon, at ang kaniyang mabuting gawa ay babayaran sa kaniya uli."
            },
            {
              "chapter": 19,
              "verse": 18,
              "name": "Mga Kawikaan 19:18",
              "text": "Parusahan mo ang iyong anak, dangang may pagasa; at huwag mong ilagak ang iyong puso sa kaniyang ikapapahamak."
            },
            {
              "chapter": 19,
              "verse": 19,
              "name": "Mga Kawikaan 19:19",
              "text": "Ang taong may malaking poot ay magtataglay ng parusa: sapagka't kung iyong iligtas iyong marapat na gawin uli."
            },
            {
              "chapter": 19,
              "verse": 20,
              "name": "Mga Kawikaan 19:20",
              "text": "Makinig ka ng payo, at tumanggap ka ng turo, upang ikaw ay maging pantas sa iyong huling wakas."
            },
            {
              "chapter": 19,
              "verse": 21,
              "name": "Mga Kawikaan 19:21",
              "text": "May maraming katha sa puso ng tao; nguni't ang payo ng Panginoon, ay siyang tatayo."
            },
            {
              "chapter": 19,
              "verse": 22,
              "name": "Mga Kawikaan 19:22",
              "text": "Yaong nakagagawa sa isang tao upang siya'y maging kanaisnais ay ang kaniyang kagandahang-loob: at ang isang dukha ay maigi kay sa isang sinungaling."
            },
            {
              "chapter": 19,
              "verse": 23,
              "name": "Mga Kawikaan 19:23",
              "text": "Ang pagkatakot sa Panginoon ay patungo sa kabuhayan; at ang nagtatangkilik noon ay tatahang may kasiyahan: hindi siya dadalawin ng kasamaan."
            },
            {
              "chapter": 19,
              "verse": 24,
              "name": "Mga Kawikaan 19:24",
              "text": "Idinadampot ng tamad ang kaniyang kamay sa pinggan, at hindi na magsusubo pa sa kaniyang bibig uli."
            },
            {
              "chapter": 19,
              "verse": 25,
              "name": "Mga Kawikaan 19:25",
              "text": "Iyong saktan ang manglilibak, at ang musmos ay magaaral ng kabaitan: at iyong sawayin ang naguunawa, at siya'y makakaunawa ng kaalaman."
            },
            {
              "chapter": 19,
              "verse": 26,
              "name": "Mga Kawikaan 19:26",
              "text": "Ang sumasamsam sa kaniyang ama, at nagpapalayas sa kaniyang ina, ay anak na nakakahiya at nagdadala ng kakutyaan."
            },
            {
              "chapter": 19,
              "verse": 27,
              "name": "Mga Kawikaan 19:27",
              "text": "Magtigil ka, anak ko, sa pakikinig ng aral na nagliligaw lamang mula sa mga salita ng kaalaman."
            },
            {
              "chapter": 19,
              "verse": 28,
              "name": "Mga Kawikaan 19:28",
              "text": "Ang walang kabuluhang saksi ay lumilibak sa kahatulan: at ang bibig ng masama ay lumalamon ng kasamaan."
            },
            {
              "chapter": 19,
              "verse": 29,
              "name": "Mga Kawikaan 19:29",
              "text": "Ang mga kahatulan ay nahahanda sa mga manglilibak, at ang mga hampas ay sa mga likod ng mga mangmang."
            }
          ]
        },
        {
          "chapter": 20,
          "name": "Mga Kawikaan 20",
          "verses": [
            {
              "chapter": 20,
              "verse": 1,
              "name": "Mga Kawikaan 20:1",
              "text": "Ang alak ay manunuya, ang matapang na alak ay manggugulo; at sinomang napaliligaw sa kaniya ay hindi pantas."
            },
            {
              "chapter": 20,
              "verse": 2,
              "name": "Mga Kawikaan 20:2",
              "text": "Ang kakilabutan ng hari ay parang ungal ng leon: ang namumungkahi sa kaniya sa galit ay nagkakasala laban sa kaniyang sariling buhay."
            },
            {
              "chapter": 20,
              "verse": 3,
              "name": "Mga Kawikaan 20:3",
              "text": "Karangalan sa tao ang magingat sa pakikipagkaalit: nguni't bawa't mangmang ay magiging palaaway."
            },
            {
              "chapter": 20,
              "verse": 4,
              "name": "Mga Kawikaan 20:4",
              "text": "Ang tamad ay hindi magaararo dahil sa tagginaw; kaya't siya'y magpapalimos sa pagaani, at wala anoman."
            },
            {
              "chapter": 20,
              "verse": 5,
              "name": "Mga Kawikaan 20:5",
              "text": "Payo sa puso ng tao ay parang malalim na tubig; nguni't iibigin ng taong naguunawa."
            },
            {
              "chapter": 20,
              "verse": 6,
              "name": "Mga Kawikaan 20:6",
              "text": "Maraming tao ay magtatanyag bawa't isa ng kaniyang sariling kagandahang-loob: nguni't sinong makakasumpong sa taong tapat?"
            },
            {
              "chapter": 20,
              "verse": 7,
              "name": "Mga Kawikaan 20:7",
              "text": "Ang ganap na tao na lumalakad sa kaniyang pagtatapat, mapapalad ang kaniyang mga anak na susunod sa kaniya."
            },
            {
              "chapter": 20,
              "verse": 8,
              "name": "Mga Kawikaan 20:8",
              "text": "Ang hari na nauupo sa luklukan ng kahatulan pinananabog ng kaniyang mga mata ang lahat na kasamaan."
            },
            {
              "chapter": 20,
              "verse": 9,
              "name": "Mga Kawikaan 20:9",
              "text": "Sinong makapagsasabi, nilinis ko ang aking puso, ako'y dalisay sa aking kasalanan?"
            },
            {
              "chapter": 20,
              "verse": 10,
              "name": "Mga Kawikaan 20:10",
              "text": "Mga iba't ibang panimbang, at mga iba't ibang takalan, kapuwa mga karumaldumal sa Panginoon."
            },
            {
              "chapter": 20,
              "verse": 11,
              "name": "Mga Kawikaan 20:11",
              "text": "Ang bata man ay nagpapakilala sa kaniyang mga gawa, kung ang kaniyang gawa ay magiging malinis, at kung magiging matuwid."
            },
            {
              "chapter": 20,
              "verse": 12,
              "name": "Mga Kawikaan 20:12",
              "text": "Ang nakikinig na tainga, at ang nakakakitang mata, kapuwa ginawa ng Panginoon."
            },
            {
              "chapter": 20,
              "verse": 13,
              "name": "Mga Kawikaan 20:13",
              "text": "Huwag mong ibigin ang pagtulog, baka ka madukha; idilat mo ang iyong mga mata, at mabubusog ka ng tinapay."
            },
            {
              "chapter": 20,
              "verse": 14,
              "name": "Mga Kawikaan 20:14",
              "text": "Walang halaga, walang halaga, sabi ng mamimili: nguni't pagka nakalayo siya, naghahambog nga."
            },
            {
              "chapter": 20,
              "verse": 15,
              "name": "Mga Kawikaan 20:15",
              "text": "May ginto, at saganang mga rubi: nguni't ang mga labi ng kaalaman ay mahalagang hiyas."
            },
            {
              "chapter": 20,
              "verse": 16,
              "name": "Mga Kawikaan 20:16",
              "text": "Kunin mo ang kaniyang suot na nananagot sa di kilala; at tanggapan mo ng sanla ang nananagot sa mga di kilala."
            },
            {
              "chapter": 20,
              "verse": 17,
              "name": "Mga Kawikaan 20:17",
              "text": "Tinapay ng kasinungalingan ay matamis sa tao: nguni't pagkatapos ay mabubusog ang kaniyang bibig ng batong lapok."
            },
            {
              "chapter": 20,
              "verse": 18,
              "name": "Mga Kawikaan 20:18",
              "text": "Bawa't panukala ay natatatag sa pamamagitan ng payo: at sa pamamagitan ng pantas na pamamatnubay ay makikipagdigma ka."
            },
            {
              "chapter": 20,
              "verse": 19,
              "name": "Mga Kawikaan 20:19",
              "text": "Ang yumayaong mapaghatid-dumapit ay naghahayag ng mga lihim: kaya't huwag kang makisalamuha sa kaniya na nagbubukang maluwang ng kaniyang mga labi."
            },
            {
              "chapter": 20,
              "verse": 20,
              "name": "Mga Kawikaan 20:20",
              "text": "Siyang sumusumpa sa kaniyang ama o sa kaniyang ina, ang kaniyang ilawan ay papatayin sa salimuot na kadiliman."
            },
            {
              "chapter": 20,
              "verse": 21,
              "name": "Mga Kawikaan 20:21",
              "text": "Ang mana ay matatamong madali sa pasimula; nguni't ang wakas niyao'y hindi pagpapalain."
            },
            {
              "chapter": 20,
              "verse": 22,
              "name": "Mga Kawikaan 20:22",
              "text": "Huwag mong sabihin, ako'y gaganti ng kasamaan: maghintay ka sa Panginoon, at kaniyang ililigtas ka."
            },
            {
              "chapter": 20,
              "verse": 23,
              "name": "Mga Kawikaan 20:23",
              "text": "Mga iba't ibang panimbang ay karumaldumal sa Panginoon; at ang sinungaling na timbangan ay hindi mabuti."
            },
            {
              "chapter": 20,
              "verse": 24,
              "name": "Mga Kawikaan 20:24",
              "text": "Ang mga lakad ng tao ay sa Panginoon; paano ngang mauunawa ng tao ang kaniyang lakad?"
            },
            {
              "chapter": 20,
              "verse": 25,
              "name": "Mga Kawikaan 20:25",
              "text": "Silo nga sa tao ang magsabi ng walang pakundangan, banal nga, at magsiyasat pagkatapos ng mga panata."
            },
            {
              "chapter": 20,
              "verse": 26,
              "name": "Mga Kawikaan 20:26",
              "text": "Ang pantas na hari ay nagpapapanabog ng masama. At dinadala sa kanila ang gulong na panggiik."
            },
            {
              "chapter": 20,
              "verse": 27,
              "name": "Mga Kawikaan 20:27",
              "text": "Ang diwa ng tao ay ilawan ng Panginoon, na sumisiyasat ng mga pinakaloob na bahagi ng tiyan."
            },
            {
              "chapter": 20,
              "verse": 28,
              "name": "Mga Kawikaan 20:28",
              "text": "Kagandahang-loob at katotohanan ay nagpapalagi sa hari: at ang kaniyang luklukan ay inaalalayan ng kagandahang-loob."
            },
            {
              "chapter": 20,
              "verse": 29,
              "name": "Mga Kawikaan 20:29",
              "text": "Ang kaluwalhatian ng mga binata ay ang kanilang kalakasan: at ang kagandahan ng matanda ay ang ulong may uban."
            },
            {
              "chapter": 20,
              "verse": 30,
              "name": "Mga Kawikaan 20:30",
              "text": "Ang mga latay na sumasakit ay lumilinis ng kasamaan: at ang mga hampas ay dinaramdam sa mga pinakaloob na bahagi ng tiyan."
            }
          ]
        },
        {
          "chapter": 21,
          "name": "Mga Kawikaan 21",
          "verses": [
            {
              "chapter": 21,
              "verse": 1,
              "name": "Mga Kawikaan 21:1",
              "text": "Ang puso ng hari ay nasa kamay ng Panginoon na parang mga batis: kumikiling saan man niya ibigin."
            },
            {
              "chapter": 21,
              "verse": 2,
              "name": "Mga Kawikaan 21:2",
              "text": "Bawa't lakad ng tao ay matuwid sa kaniyang sariling mga mata: nguni't tinitimbang ng Panginoon ang mga puso."
            },
            {
              "chapter": 21,
              "verse": 3,
              "name": "Mga Kawikaan 21:3",
              "text": "Gumawa ng kaganapan at kahatulan ay lalong kalugodlugod sa Panginoon kay sa hain."
            },
            {
              "chapter": 21,
              "verse": 4,
              "name": "Mga Kawikaan 21:4",
              "text": "Ang mapagmataas na tingin, at ang palalong puso, siyang ilaw ng masama, ay kasalanan."
            },
            {
              "chapter": 21,
              "verse": 5,
              "name": "Mga Kawikaan 21:5",
              "text": "Ang mga pagiisip ng masipag ay patungo sa kasaganaan lamang: nguni't bawa't nagmamadali ay sa pangangailangan lamang."
            },
            {
              "chapter": 21,
              "verse": 6,
              "name": "Mga Kawikaan 21:6",
              "text": "Ang pagtatamo ng mga kayamanan sa pamamagitan ng sinungaling na dila ay singaw na tinatangay na paroo't parito noong nagsisihanap ng kamatayan."
            },
            {
              "chapter": 21,
              "verse": 7,
              "name": "Mga Kawikaan 21:7",
              "text": "Ang pangdadahas ng masama ay siya ring papalis sa kanila; sapagka't sila'y nagsitangging magsigawa ng kahatulan."
            },
            {
              "chapter": 21,
              "verse": 8,
              "name": "Mga Kawikaan 21:8",
              "text": "Ang lakad ng nagpapasan ng sala ay lubhang liko; nguni't tungkol sa malinis, ang kaniyang gawa ay matuwid."
            },
            {
              "chapter": 21,
              "verse": 9,
              "name": "Mga Kawikaan 21:9",
              "text": "Lalong maigi ang tumahan sa sulok ng bubungan, kay sa palatalong babae sa maluwang na bahay."
            },
            {
              "chapter": 21,
              "verse": 10,
              "name": "Mga Kawikaan 21:10",
              "text": "Ang kaluluwa ng masama ay nagnanasa ng kasamaan: ang kaniyang kapuwa ay hindi nakakasumpong ng lingap sa kaniyang mga mata."
            },
            {
              "chapter": 21,
              "verse": 11,
              "name": "Mga Kawikaan 21:11",
              "text": "Pagka ang mangduduwahagi ay pinarusahan, ang musmos ay nagiging pantas: at pagka ang pantas ay tinuturuan, siya'y tumatanggap ng kaalaman."
            },
            {
              "chapter": 21,
              "verse": 12,
              "name": "Mga Kawikaan 21:12",
              "text": "Pinagninilay ng matuwid ang bahay ng masama, kung paanong napapahamak ang masama sa kanilang pagkapariwara."
            },
            {
              "chapter": 21,
              "verse": 13,
              "name": "Mga Kawikaan 21:13",
              "text": "Ang nagtatakip ng kaniyang mga pakinig sa daing ng dukha, siya naman ay dadaing, nguni't hindi didinggin."
            },
            {
              "chapter": 21,
              "verse": 14,
              "name": "Mga Kawikaan 21:14",
              "text": "Ang kaloob na lihim ay nagpapatahimik ng galit, at ang alay sa sinapupunan, ay ng malaking poot."
            },
            {
              "chapter": 21,
              "verse": 15,
              "name": "Mga Kawikaan 21:15",
              "text": "Kagalakan sa matuwid ang gumawa ng kahatulan; nguni't kapahamakan sa mga manggagawa ng kasamaan."
            },
            {
              "chapter": 21,
              "verse": 16,
              "name": "Mga Kawikaan 21:16",
              "text": "Ang tao na gumagala sa labas ng daan ng kaunawaan, magpapahinga sa kapisanan ng patay."
            },
            {
              "chapter": 21,
              "verse": 17,
              "name": "Mga Kawikaan 21:17",
              "text": "Ang umiibig ng kalayawan ay magiging dukha: ang umiibig sa alak at langis ay hindi yayaman."
            },
            {
              "chapter": 21,
              "verse": 18,
              "name": "Mga Kawikaan 21:18",
              "text": "Ang masama ay isang katubusan para sa matuwid, at ang taksil ay sa lugar ng matuwid."
            },
            {
              "chapter": 21,
              "verse": 19,
              "name": "Mga Kawikaan 21:19",
              "text": "Lalong maigi ang tumahan sa ilang na lupain, kay sa makisama sa palatalo at magagaliting babae."
            },
            {
              "chapter": 21,
              "verse": 20,
              "name": "Mga Kawikaan 21:20",
              "text": "May mahalagang kayamanan at langis sa tahanan ng pantas; nguni't ito'y sinasakmal ng mangmang."
            },
            {
              "chapter": 21,
              "verse": 21,
              "name": "Mga Kawikaan 21:21",
              "text": "Ang sumusunod sa katuwiran at kagandahang-loob nakakasumpong ng buhay, katuwiran, at karangalan."
            },
            {
              "chapter": 21,
              "verse": 22,
              "name": "Mga Kawikaan 21:22",
              "text": "Sinasampa ng pantas ang bayan ng makapangyarihan, at ibinabagsak ang lakas ng pagkakatiwala niyaon."
            },
            {
              "chapter": 21,
              "verse": 23,
              "name": "Mga Kawikaan 21:23",
              "text": "Sinomang nagiingat ng kaniyang bibig at kaniyang dila nagiingat ng kaniyang kaluluwa mula sa mga kabagabagan."
            },
            {
              "chapter": 21,
              "verse": 24,
              "name": "Mga Kawikaan 21:24",
              "text": "Ang palalo at mapagmataas na tao, manglilibak ang kaniyang pangalan, siya'y gumagawa sa kahambugan ng kapalaluan."
            },
            {
              "chapter": 21,
              "verse": 25,
              "name": "Mga Kawikaan 21:25",
              "text": "Ang nasa ng tamad ay pumapatay sa kaniya; sapagka't tumatanggi ang kaniyang mga kamay sa paggawa."
            },
            {
              "chapter": 21,
              "verse": 26,
              "name": "Mga Kawikaan 21:26",
              "text": "May nagiimbot sa kasakiman buong araw: nguni't ang matuwid ay nagbibigay at hindi nagkakait."
            },
            {
              "chapter": 21,
              "verse": 27,
              "name": "Mga Kawikaan 21:27",
              "text": "Ang hain ng masama ay karumaldumal: gaano pa nga, pagka kaniyang dinadala na may masamang isip!"
            },
            {
              "chapter": 21,
              "verse": 28,
              "name": "Mga Kawikaan 21:28",
              "text": "Ang sinungaling na saksi ay mamamatay: nguni't ang taong nakikinig ay magsasalita upang mamalagi."
            },
            {
              "chapter": 21,
              "verse": 29,
              "name": "Mga Kawikaan 21:29",
              "text": "Ang masamang tao ay nagmamatigas ng kaniyang mukha; nguni't tungkol sa taong matuwid, nagaayos ng kaniyang mga lakad."
            },
            {
              "chapter": 21,
              "verse": 30,
              "name": "Mga Kawikaan 21:30",
              "text": "Walang karunungan, o kaunawaan man, O payo man laban sa Panginoon."
            },
            {
              "chapter": 21,
              "verse": 31,
              "name": "Mga Kawikaan 21:31",
              "text": "Ang kabayo ay handa laban sa kaarawan ng pagbabaka: nguni't ang pagtatagumpay ay sa Panginoon."
            }
          ]
        },
        {
          "chapter": 22,
          "name": "Mga Kawikaan 22",
          "verses": [
            {
              "chapter": 22,
              "verse": 1,
              "name": "Mga Kawikaan 22:1",
              "text": "Ang mabuting pangalan ay maiging piliin, kay sa malaking kayamanan, at ang magandang kalooban, kay sa pilak at ginto."
            },
            {
              "chapter": 22,
              "verse": 2,
              "name": "Mga Kawikaan 22:2",
              "text": "Ang mayaman at ang dukha ay nagkakasalubong kapuwa: ang Panginoon ang May-lalang sa kanilang lahat."
            },
            {
              "chapter": 22,
              "verse": 3,
              "name": "Mga Kawikaan 22:3",
              "text": "Ang mabait na tao ay nakakakita ng kasamaan at nagkukubli: nguni't dinadaanan ng musmos at nagtitiis."
            },
            {
              "chapter": 22,
              "verse": 4,
              "name": "Mga Kawikaan 22:4",
              "text": "Ang kagantihan sa kapakumbabaan at ang pagkatakot sa Panginoon ay kayamanan, at karangalan, at buhay."
            },
            {
              "chapter": 22,
              "verse": 5,
              "name": "Mga Kawikaan 22:5",
              "text": "Mga tinik at mga silo ay nangasa daan ng magdaraya: ang nagiingat ng kaniyang kaluluwa ay lalayo sa mga yaon."
            },
            {
              "chapter": 22,
              "verse": 6,
              "name": "Mga Kawikaan 22:6",
              "text": "Turuan mo ang bata sa daan na dapat niyang lakaran, at pagka tumanda man siya ay hindi niya hihiwalayan."
            },
            {
              "chapter": 22,
              "verse": 7,
              "name": "Mga Kawikaan 22:7",
              "text": "Ang mayaman ay magpupuno sa dukha, at ang manghihiram ay alipin ng nagpapahiram."
            },
            {
              "chapter": 22,
              "verse": 8,
              "name": "Mga Kawikaan 22:8",
              "text": "Siyang naghahasik ng kasamaan ay aani ng kapahamakan; at ang pamalo ng kaniyang poot ay maglilikat."
            },
            {
              "chapter": 22,
              "verse": 9,
              "name": "Mga Kawikaan 22:9",
              "text": "Ang may magandang-loob na mata ay pagpapalain: sapagka't nagbibigay ng kaniyang tinapay sa dukha."
            },
            {
              "chapter": 22,
              "verse": 10,
              "name": "Mga Kawikaan 22:10",
              "text": "Itaboy mo ang manglilibak, at ang pagtatalo ay maalis; Oo, ang pagkakaalit at pagduwahagi ay matitigil."
            },
            {
              "chapter": 22,
              "verse": 11,
              "name": "Mga Kawikaan 22:11",
              "text": "Siyang umiibig ng kalinisan ng puso, dahil sa biyaya ng kaniyang mga labi ay magiging kaniyang kaibigan ang hari."
            },
            {
              "chapter": 22,
              "verse": 12,
              "name": "Mga Kawikaan 22:12",
              "text": "Ang mga mata ng Panginoon ay nagiingat sa maalam: nguni't kaniyang ibinabagsak ang mga salita ng taksil."
            },
            {
              "chapter": 22,
              "verse": 13,
              "name": "Mga Kawikaan 22:13",
              "text": "Sinasabi ng tamad, may leon sa labas: mapapatay ako sa mga lansangan."
            },
            {
              "chapter": 22,
              "verse": 14,
              "name": "Mga Kawikaan 22:14",
              "text": "Ang bibig ng masasamang babae ay isang malalim na lungaw: siyang nayayamot sa Panginoon ay mabubuwal doon."
            },
            {
              "chapter": 22,
              "verse": 15,
              "name": "Mga Kawikaan 22:15",
              "text": "Ang kamangmangan ay nababalot sa puso ng bata; nguni't ilalayo sa kaniya ng pamalong pangsaway."
            },
            {
              "chapter": 22,
              "verse": 16,
              "name": "Mga Kawikaan 22:16",
              "text": "Ang pumipighati sa dukha upang magpalago ng kaniyang pakinabang, at ang nagbibigay sa mayaman, ay humahangga sa pangangailangan lamang."
            },
            {
              "chapter": 22,
              "verse": 17,
              "name": "Mga Kawikaan 22:17",
              "text": "Ikiling mo ang iyong pakinig, at iyong dinggin ang mga salita ng pantas, at ihilig mo ang iyong puso sa aking kaalaman."
            },
            {
              "chapter": 22,
              "verse": 18,
              "name": "Mga Kawikaan 22:18",
              "text": "Sapagka't maligayang bagay kung iyong ingatan sa loob mo, kung mangatatatag na magkakasama sa iyong mga labi."
            },
            {
              "chapter": 22,
              "verse": 19,
              "name": "Mga Kawikaan 22:19",
              "text": "Upang ang iyong tiwala ay malagak sa Panginoon, aking ipinakilala sa iyo sa kaarawang ito, oo, sa iyo."
            },
            {
              "chapter": 22,
              "verse": 20,
              "name": "Mga Kawikaan 22:20",
              "text": "Hindi ba ako sumulat sa iyo ng mga marilag na bagay na mga payo at kaalaman;"
            },
            {
              "chapter": 22,
              "verse": 21,
              "name": "Mga Kawikaan 22:21",
              "text": "Upang ipakilala sa iyo ang katunayan ng mga salitang katotohanan, upang iyong maibalik ang mga salita ng katotohanan sa kanila na nagsusugo sa iyo?"
            },
            {
              "chapter": 22,
              "verse": 22,
              "name": "Mga Kawikaan 22:22",
              "text": "Huwag kang magnakaw sa dukha, sapagka't siya'y dukha, ni pumighati man sa nagdadalamhati sa pintuang-bayan:"
            },
            {
              "chapter": 22,
              "verse": 23,
              "name": "Mga Kawikaan 22:23",
              "text": "Sapagka't ipakikipaglaban ng Panginoon ang kanilang usap, at sasamsaman ng buhay yaong nagsisisamsam sa kanila."
            },
            {
              "chapter": 22,
              "verse": 24,
              "name": "Mga Kawikaan 22:24",
              "text": "Huwag kang makipagkaibigan sa taong magagalitin; at sa mainiting tao ay huwag kang sasama:"
            },
            {
              "chapter": 22,
              "verse": 25,
              "name": "Mga Kawikaan 22:25",
              "text": "Baka ka matuto ng kaniyang mga lakad, at magtamo ng silo sa iyong kaluluwa."
            },
            {
              "chapter": 22,
              "verse": 26,
              "name": "Mga Kawikaan 22:26",
              "text": "Huwag kang maging isa sa kanila na nakikikamay, o sa kanila na mangananagot sa mga utang:"
            },
            {
              "chapter": 22,
              "verse": 27,
              "name": "Mga Kawikaan 22:27",
              "text": "Kung wala kang ikabayad, bakit kaniyang kukunin sa iyo ang iyong higaan?"
            },
            {
              "chapter": 22,
              "verse": 28,
              "name": "Mga Kawikaan 22:28",
              "text": "Huwag mong baguhin ang dating muhon ng lupa, na inilagay ng iyong mga magulang."
            },
            {
              "chapter": 22,
              "verse": 29,
              "name": "Mga Kawikaan 22:29",
              "text": "Nakikita mo ba ang taong masipag sa kaniyang gawain? siya'y tatayo sa harap ng mga hari: hindi siya tatayo sa harap ng mga taong hamak."
            }
          ]
        },
        {
          "chapter": 23,
          "name": "Mga Kawikaan 23",
          "verses": [
            {
              "chapter": 23,
              "verse": 1,
              "name": "Mga Kawikaan 23:1",
              "text": "Pagka ikaw ay nauupong kumain na kasalo ng isang pangulo, kilanlin mong maigi siya na nasa harap mo;"
            },
            {
              "chapter": 23,
              "verse": 2,
              "name": "Mga Kawikaan 23:2",
              "text": "At maglagay ka ng sundang sa iyong lalamunan, kung ikaw ay taong bigay sa pagkain."
            },
            {
              "chapter": 23,
              "verse": 3,
              "name": "Mga Kawikaan 23:3",
              "text": "Huwag kang mapagnais ng kaniyang mga masarap na pagkain; yamang mga marayang pagkain."
            },
            {
              "chapter": 23,
              "verse": 4,
              "name": "Mga Kawikaan 23:4",
              "text": "Huwag kang mainip sa pagyaman; tumigil ka sa iyong sariling karunungan."
            },
            {
              "chapter": 23,
              "verse": 5,
              "name": "Mga Kawikaan 23:5",
              "text": "Iyo bang itititig ang iyong mga mata sa wala? Sapagka't ang mga kayamanan, ay tunay na nagsisipagpakpak, gaya ng aguila na lumilipad sa dakong langit."
            },
            {
              "chapter": 23,
              "verse": 6,
              "name": "Mga Kawikaan 23:6",
              "text": "Huwag mong kanin ang tinapay niya na may masamang mata, ni nasain mo man ang kaniyang mga masarap na pagkain:"
            },
            {
              "chapter": 23,
              "verse": 7,
              "name": "Mga Kawikaan 23:7",
              "text": "Sapagka't kung ano ang iniisip niya sa loob niya, ay gayon siya: kumain ka at uminom ka, sabi niya sa iyo; nguni't ang puso niya ay hindi sumasaiyo."
            },
            {
              "chapter": 23,
              "verse": 8,
              "name": "Mga Kawikaan 23:8",
              "text": "Ang subo na iyong kinain ay iyong isusuka, at iyong iwawala ang iyong mga matamis na salita."
            },
            {
              "chapter": 23,
              "verse": 9,
              "name": "Mga Kawikaan 23:9",
              "text": "Huwag kang magsalita sa pakinig ng mangmang; sapagka't kaniyang hahamakin ang karunungan ng iyong mga salita."
            },
            {
              "chapter": 23,
              "verse": 10,
              "name": "Mga Kawikaan 23:10",
              "text": "Huwag mong baguhin ang dating muhon ng lupa; at huwag mong pasukin ang mga bukid ng ulila:"
            },
            {
              "chapter": 23,
              "verse": 11,
              "name": "Mga Kawikaan 23:11",
              "text": "Sapagka't ang kanilang Manunubos ay malakas; ipaglalaban niya ang kanilang usap sa iyo."
            },
            {
              "chapter": 23,
              "verse": 12,
              "name": "Mga Kawikaan 23:12",
              "text": "Ihilig mo ang iyong puso sa turo, at ang iyong mga pakinig sa mga salita ng kaalaman."
            },
            {
              "chapter": 23,
              "verse": 13,
              "name": "Mga Kawikaan 23:13",
              "text": "Huwag mong ipagkait ang saway sa bata: sapagka't kung iyong hampasin siya ng pamalo, siya'y hindi mamamatay."
            },
            {
              "chapter": 23,
              "verse": 14,
              "name": "Mga Kawikaan 23:14",
              "text": "Iyong hahampasin siya ng pamalo, at ililigtas mo ang kaniyang kaluluwa sa Sheol."
            },
            {
              "chapter": 23,
              "verse": 15,
              "name": "Mga Kawikaan 23:15",
              "text": "Anak ko, kung ang iyong puso ay magpakapantas, ang puso ko'y matutuwa sa makatuwid baga'y ang akin:"
            },
            {
              "chapter": 23,
              "verse": 16,
              "name": "Mga Kawikaan 23:16",
              "text": "Oo, ang aking puso ay magagalak pagka ang iyong mga labi ay nangagsasalita ng matuwid na mga bagay."
            },
            {
              "chapter": 23,
              "verse": 17,
              "name": "Mga Kawikaan 23:17",
              "text": "Huwag managhili ang iyong puso sa mga makasalanan: kundi lumagay ka sa Panginoon buong araw:"
            },
            {
              "chapter": 23,
              "verse": 18,
              "name": "Mga Kawikaan 23:18",
              "text": "Sapagka't tunay na may kagantihan; at ang iyong pagasa ay hindi mahihiwalay."
            },
            {
              "chapter": 23,
              "verse": 19,
              "name": "Mga Kawikaan 23:19",
              "text": "Makinig ka, anak ko, at ikaw ay magpakapantas, at patnubayan mo ang iyong puso sa daan."
            },
            {
              "chapter": 23,
              "verse": 20,
              "name": "Mga Kawikaan 23:20",
              "text": "Huwag kang mapasama sa mga mapaglango; sa mga mayamong mangangain ng karne:"
            },
            {
              "chapter": 23,
              "verse": 21,
              "name": "Mga Kawikaan 23:21",
              "text": "Sapagka't ang manglalasing at ang mayamo ay darating sa karalitaan: at ang antok ay magbibihis sa tao ng pagkapulubi."
            },
            {
              "chapter": 23,
              "verse": 22,
              "name": "Mga Kawikaan 23:22",
              "text": "Dinggin mo ang iyong ama na naging anak ka, at huwag mong hamakin ang iyong ina kung siya'y tumanda."
            },
            {
              "chapter": 23,
              "verse": 23,
              "name": "Mga Kawikaan 23:23",
              "text": "Bumili ka ng katotohanan at huwag mong ipagbili: Oo karunungan, at turo, at pag-uunawa."
            },
            {
              "chapter": 23,
              "verse": 24,
              "name": "Mga Kawikaan 23:24",
              "text": "Ang ama ng matuwid ay magagalak na lubos: at siyang nagkaanak ng pantas na anak ay magagalak sa kaniya."
            },
            {
              "chapter": 23,
              "verse": 25,
              "name": "Mga Kawikaan 23:25",
              "text": "Mangatuwa ang iyong ama at ang iyong ina, at magalak siyang nanganak sa iyo."
            },
            {
              "chapter": 23,
              "verse": 26,
              "name": "Mga Kawikaan 23:26",
              "text": "Anak ko, ibigay mo sa akin ang iyong puso, at malugod ang iyong mga mata sa aking mga daan."
            },
            {
              "chapter": 23,
              "verse": 27,
              "name": "Mga Kawikaan 23:27",
              "text": "Sapagka't ang isang patutot ay isang malalim na lubak; at ang babaing di kilala ay makipot na lungaw."
            },
            {
              "chapter": 23,
              "verse": 28,
              "name": "Mga Kawikaan 23:28",
              "text": "Oo, siya'y bumabakay na parang tulisan, at nagdaragdag ng mga magdaraya sa gitna ng mga tao."
            },
            {
              "chapter": 23,
              "verse": 29,
              "name": "Mga Kawikaan 23:29",
              "text": "Sinong may ay? sinong may kapanglawan? sinong may pakikipagtalo? sinong may daing? sino ang may sugat na walang kadahilanan? sino ang may maningas na mata?"
            },
            {
              "chapter": 23,
              "verse": 30,
              "name": "Mga Kawikaan 23:30",
              "text": "Silang nangaghihintay sa alak; silang nagsisiyaon upang humanap ng pinaghalong alak."
            },
            {
              "chapter": 23,
              "verse": 31,
              "name": "Mga Kawikaan 23:31",
              "text": "Huwag kang tumingin sa alak pagka mapula, pagka nagbibigay ng kaniyang kulay sa saro,"
            },
            {
              "chapter": 23,
              "verse": 32,
              "name": "Mga Kawikaan 23:32",
              "text": "Sa huli ay kumakagat ito na parang ahas, at tumutukang parang ulupong."
            },
            {
              "chapter": 23,
              "verse": 33,
              "name": "Mga Kawikaan 23:33",
              "text": "Ang iyong mga mata ay titingin ng mga katuwang bagay, at ang iyong puso ay nagbabadya ng mga magdarayang bagay."
            },
            {
              "chapter": 23,
              "verse": 34,
              "name": "Mga Kawikaan 23:34",
              "text": "Oo, ikaw ay magiging parang nahihiga sa gitna ng dagat, o parang nahihiga sa dulo ng isang palo ng sasakyan."
            },
            {
              "chapter": 23,
              "verse": 35,
              "name": "Mga Kawikaan 23:35",
              "text": "Kanilang pinalo ako, iyong sasalitain, at hindi ako nasaktan; kanilang hinampas ako, at hindi ko naramdaman: kailan gigising ako? aking hahanapin pa uli."
            }
          ]
        },
        {
          "chapter": 24,
          "name": "Mga Kawikaan 24",
          "verses": [
            {
              "chapter": 24,
              "verse": 1,
              "name": "Mga Kawikaan 24:1",
              "text": "Huwag kang mananaghili sa mga masamang tao, ni magnasa ka man na masama sa kanila:"
            },
            {
              "chapter": 24,
              "verse": 2,
              "name": "Mga Kawikaan 24:2",
              "text": "Sapagka't ang kanilang puso ay nagaaral ng pagpighati, at ang kanilang mga labi ay nagsasalita ng kalikuan."
            },
            {
              "chapter": 24,
              "verse": 3,
              "name": "Mga Kawikaan 24:3",
              "text": "Sa karunungan ay natatayo ang bahay; at sa pamamagitan ng unawa ay natatatag."
            },
            {
              "chapter": 24,
              "verse": 4,
              "name": "Mga Kawikaan 24:4",
              "text": "At sa pamamagitan ng kaalaman ay napupuno ang mga silid, ng lahat na mahalaga at maligayang mga kayamanan."
            },
            {
              "chapter": 24,
              "verse": 5,
              "name": "Mga Kawikaan 24:5",
              "text": "Ang pantas na tao ay malakas; Oo, ang taong maalam ay lumalago ang kapangyarihan."
            },
            {
              "chapter": 24,
              "verse": 6,
              "name": "Mga Kawikaan 24:6",
              "text": "Sapagka't sa pamamagitan ng pantas na pamamatnubay ay makikipagdigma ka: at sa karamihan ng mga tagapayo ay may kaligtasan."
            },
            {
              "chapter": 24,
              "verse": 7,
              "name": "Mga Kawikaan 24:7",
              "text": "Karunungan ay totoong mataas sa ganang mangmang: hindi niya ibinubuka ang kaniyang bibig sa pintuang-bayan."
            },
            {
              "chapter": 24,
              "verse": 8,
              "name": "Mga Kawikaan 24:8",
              "text": "Siyang kumakatha ng paggawa ng kasamaan, tatawagin siya ng mga tao na masamang tao."
            },
            {
              "chapter": 24,
              "verse": 9,
              "name": "Mga Kawikaan 24:9",
              "text": "Ang pagiisip ng kamangmangan ay kasalanan: at ang mangduduwahagi ay karumaldumal sa mga tao."
            },
            {
              "chapter": 24,
              "verse": 10,
              "name": "Mga Kawikaan 24:10",
              "text": "Kung ikaw ay manglupaypay sa kaarawan ng kasakunaan, ang iyong kalakasan ay munti."
            },
            {
              "chapter": 24,
              "verse": 11,
              "name": "Mga Kawikaan 24:11",
              "text": "Iligtas mo silang nangadala sa kamatayan, at ang mga handang papatayin, ay tingnan mo na iyong ibalik."
            },
            {
              "chapter": 24,
              "verse": 12,
              "name": "Mga Kawikaan 24:12",
              "text": "Kung iyong sinasabi, narito, hindi kami nakakaalam nito: hindi ba niya binubulay na tumitimbang ng mga puso? At siyang nagiingat ng iyong kaluluwa, hindi ba niya nalalaman? At hindi ba niya gagantihin ang bawa't tao ayon sa gawa niya?"
            },
            {
              "chapter": 24,
              "verse": 13,
              "name": "Mga Kawikaan 24:13",
              "text": "Anak ko, kumain ka ng pulot, sapagka't mabuti; at ng pulot-pukyutan na matamis sa iyong lasa:"
            },
            {
              "chapter": 24,
              "verse": 14,
              "name": "Mga Kawikaan 24:14",
              "text": "Sa gayo'y matututo ka ng karunungan na malalagay sa iyong kaluluwa: kung iyong nasumpungan ito, sa gayo'y magkakaroon ka nga ng kagantihan, at ang iyong pagasa ay hindi mahihiwalay."
            },
            {
              "chapter": 24,
              "verse": 15,
              "name": "Mga Kawikaan 24:15",
              "text": "Huwag kang bumakay, Oh masamang tao, sa tahanan ng matuwid; huwag mong sirain ang kaniyang dakong pahingahan:"
            },
            {
              "chapter": 24,
              "verse": 16,
              "name": "Mga Kawikaan 24:16",
              "text": "Sapagka't ang matuwid ay nabubuwal na makapito, at bumabangon uli: nguni't ang masama ay nabubuwal sa kasakunaan."
            },
            {
              "chapter": 24,
              "verse": 17,
              "name": "Mga Kawikaan 24:17",
              "text": "Huwag kang magalak pagka ang iyong kaaway ay nabubuwal, at huwag matuwa ang iyong puso pagka siya'y nabubuwal:"
            },
            {
              "chapter": 24,
              "verse": 18,
              "name": "Mga Kawikaan 24:18",
              "text": "Baka makita ng Panginoon, at ipagdamdam ng loob siya, at kaniyang ihiwalay ang poot niya sa kaniya."
            },
            {
              "chapter": 24,
              "verse": 19,
              "name": "Mga Kawikaan 24:19",
              "text": "Huwag kang mabalisa dahil sa mga manggagawa ng masama; ni maging mapanaghiliin ka man sa masama:"
            },
            {
              "chapter": 24,
              "verse": 20,
              "name": "Mga Kawikaan 24:20",
              "text": "Sapagka't hindi magkakaroon ng kagantihan sa masamang tao; ang ilawan ng masama ay papatayin."
            },
            {
              "chapter": 24,
              "verse": 21,
              "name": "Mga Kawikaan 24:21",
              "text": "Anak ko, matakot ka sa Panginoon at sa hari: at huwag kang makisalamuha sa kanila na mapagbago:"
            },
            {
              "chapter": 24,
              "verse": 22,
              "name": "Mga Kawikaan 24:22",
              "text": "Sapagka't ang kanilang kasakunaan ay darating na bigla; at sinong nakakaalam ng kasiraan nila kapuwa?"
            },
            {
              "chapter": 24,
              "verse": 23,
              "name": "Mga Kawikaan 24:23",
              "text": "Ang mga ito man ay sabi rin ng pantas. Magkaroon ng pagtangi ng mga pagkatao sa kahatulan, ay hindi mabuti."
            },
            {
              "chapter": 24,
              "verse": 24,
              "name": "Mga Kawikaan 24:24",
              "text": "Siyang nagsasabi sa masama, Ikaw ay matuwid; susumpain siya ng mga bayan, kayayamutan siya ng mga bansa:"
            },
            {
              "chapter": 24,
              "verse": 25,
              "name": "Mga Kawikaan 24:25",
              "text": "Nguni't silang nagsisisaway sa kaniya ay magkakaroon ng kaluguran, at ang mabuting pagpapala ay darating sa kanila."
            },
            {
              "chapter": 24,
              "verse": 26,
              "name": "Mga Kawikaan 24:26",
              "text": "Siya'y humahalik sa mga labi niyaong nagbibigay ng matuwid na sagot."
            },
            {
              "chapter": 24,
              "verse": 27,
              "name": "Mga Kawikaan 24:27",
              "text": "Ihanda mo ang iyong gawa sa labas, at ihanda mo sa iyo sa parang; at pagkatapos ay itayo mo ang iyong bahay."
            },
            {
              "chapter": 24,
              "verse": 28,
              "name": "Mga Kawikaan 24:28",
              "text": "Huwag kang sumaksi laban sa iyong kapuwa ng walang kadahilanan; at huwag kang magdaya ng iyong mga labi."
            },
            {
              "chapter": 24,
              "verse": 29,
              "name": "Mga Kawikaan 24:29",
              "text": "Huwag mong sabihin, gagawin kong gayon sa kaniya na gaya ng ginawa niya sa akin: aking ibibigay sa tao ang ayon sa kaniyang gawa."
            },
            {
              "chapter": 24,
              "verse": 30,
              "name": "Mga Kawikaan 24:30",
              "text": "Ako'y nagdaan sa tabi ng bukid ng tamad, at sa tabi ng ubasan ng taong salat sa unawa;"
            },
            {
              "chapter": 24,
              "verse": 31,
              "name": "Mga Kawikaan 24:31",
              "text": "At, narito, tinubuang lahat ng mga tinik, ang ibabaw niyaon ay natakpan ng mga dawag, at ang bakod na bato ay nabagsak."
            },
            {
              "chapter": 24,
              "verse": 32,
              "name": "Mga Kawikaan 24:32",
              "text": "Ako nga'y tumingin, at aking binulay na mabuti: aking nakita, at tumanggap ako ng turo."
            },
            {
              "chapter": 24,
              "verse": 33,
              "name": "Mga Kawikaan 24:33",
              "text": "Kaunti pang tulog, kaunti pang idlip, kaunti pang paghahalukipkip ng mga kamay upang matulog:"
            },
            {
              "chapter": 24,
              "verse": 34,
              "name": "Mga Kawikaan 24:34",
              "text": "Gayon darating ang iyong karalitaan na parang magnanakaw; at ang iyong kasalatan na parang nasasandatahang tao."
            }
          ]
        },
        {
          "chapter": 25,
          "name": "Mga Kawikaan 25",
          "verses": [
            {
              "chapter": 25,
              "verse": 1,
              "name": "Mga Kawikaan 25:1",
              "text": "Ang mga ito ay mga kawikaan din ni Salomon, na isinalin ng mga tao ni Hezekias na hari sa Juda."
            },
            {
              "chapter": 25,
              "verse": 2,
              "name": "Mga Kawikaan 25:2",
              "text": "Kaluwalhatian nga ng Dios na maglihim ng isang bagay: nguni't ang kaluwalhatian ng mga hari ay magusisa ng isang bagay."
            },
            {
              "chapter": 25,
              "verse": 3,
              "name": "Mga Kawikaan 25:3",
              "text": "Gaya ng langit sa kataasan, at ng lupa sa kalaliman, gayon ang puso ng mga hari ay di masayod."
            },
            {
              "chapter": 25,
              "verse": 4,
              "name": "Mga Kawikaan 25:4",
              "text": "Alisin ang dumi sa pilak, at lumalabas na isang kasangkapan sa ganang mangbububo:"
            },
            {
              "chapter": 25,
              "verse": 5,
              "name": "Mga Kawikaan 25:5",
              "text": "Alisin ang masama sa harap ng hari, at ang kaniyang luklukan ay matatatag sa katuwiran."
            },
            {
              "chapter": 25,
              "verse": 6,
              "name": "Mga Kawikaan 25:6",
              "text": "Huwag kang magpauna sa harapan ng hari, at huwag kang tumayo sa dako ng mga dakilang tao:"
            },
            {
              "chapter": 25,
              "verse": 7,
              "name": "Mga Kawikaan 25:7",
              "text": "Sapagka't maigi na sabihin sa iyo, sumampa ka rito: kay sa ibaba ka sa harapan ng pangulo, na nakita ng iyong mga mata."
            },
            {
              "chapter": 25,
              "verse": 8,
              "name": "Mga Kawikaan 25:8",
              "text": "Huwag kang makialam ng walang gunita sa pakikipagbabag, baka hindi mo maalaman kung ano ang gagawin sa wakas niyaon, pagka ikaw ay hiniya ng iyong kapuwa."
            },
            {
              "chapter": 25,
              "verse": 9,
              "name": "Mga Kawikaan 25:9",
              "text": "Ipaglaban mo ang iyong usap sa iyong kapuwa, at huwag mong ihayag ang lihim ng iba:"
            },
            {
              "chapter": 25,
              "verse": 10,
              "name": "Mga Kawikaan 25:10",
              "text": "Baka siyang nakakarinig ay umalipusta sa iyo, at ang iyong pagkadusta ay hindi maalis."
            },
            {
              "chapter": 25,
              "verse": 11,
              "name": "Mga Kawikaan 25:11",
              "text": "Salitang sinalita sa kaukulan ay gaya ng mga mansanang ginto sa mga bilaong pilak."
            },
            {
              "chapter": 25,
              "verse": 12,
              "name": "Mga Kawikaan 25:12",
              "text": "Kung paano ang hikaw na ginto, at kagayakang dalisay na ginto, gayon ang pantas na mananaway sa masunuring pakinig."
            },
            {
              "chapter": 25,
              "verse": 13,
              "name": "Mga Kawikaan 25:13",
              "text": "Kung paano ang lamig ng niebe sa panahon ng pagaani, gayon ang tapat na sugo sa kanila na nangagsugo sa kaniya; sapagka't kaniyang pinagiginhawa ang kaluluwa ng kaniyang mga panginoon."
            },
            {
              "chapter": 25,
              "verse": 14,
              "name": "Mga Kawikaan 25:14",
              "text": "Kung paano ang mga alapaap at hangin na walang ulan, gayon ang taong naghahambog ng kaniyang mga kaloob na walang katotohanan."
            },
            {
              "chapter": 25,
              "verse": 15,
              "name": "Mga Kawikaan 25:15",
              "text": "Sa pamamagitan ng pagpipigil ng loob ay napahihikayat ang pangulo, at ang malumanay na dila ay bumabasag ng buto."
            },
            {
              "chapter": 25,
              "verse": 16,
              "name": "Mga Kawikaan 25:16",
              "text": "Nakasumpong ka ba ng pulot? kumain ka ng sapat sa iyo; baka ka masuya, at iyong isuka."
            },
            {
              "chapter": 25,
              "verse": 17,
              "name": "Mga Kawikaan 25:17",
              "text": "Magdalang ang iyong paa sa bahay ng iyong kapuwa; baka siya'y mayamot sa iyo, at ipagtanim ka."
            },
            {
              "chapter": 25,
              "verse": 18,
              "name": "Mga Kawikaan 25:18",
              "text": "Ang tao na sumasaksi ng kasinungalingang saksi laban sa kaniyang kapuwa ay isang pangbayo at isang tabak, at isang matulis na pana."
            },
            {
              "chapter": 25,
              "verse": 19,
              "name": "Mga Kawikaan 25:19",
              "text": "Pagtiwala sa di tapat na tao sa panahon ng kabagabagan ay gaya ng baling ngipin, at ng nabaliang paa."
            },
            {
              "chapter": 25,
              "verse": 20,
              "name": "Mga Kawikaan 25:20",
              "text": "Kung paano ang nangaagaw ng kasuutan sa panahong tagginaw, at kung paano ang suka sa sosa, gayon siyang umaawit ng mga awit sa mabigat na puso."
            },
            {
              "chapter": 25,
              "verse": 21,
              "name": "Mga Kawikaan 25:21",
              "text": "Kung ang iyong kaaway ay magutom, bigyan mo siya ng pagkain na makakain; at kung siya'y mauhaw, bigyan mo siya ng tubig na maiinom:"
            },
            {
              "chapter": 25,
              "verse": 22,
              "name": "Mga Kawikaan 25:22",
              "text": "Sapagka't ikaw ay magbubunton ng baga ng apoy sa kaniyang ulo, at gagantihin ka ng Panginoon."
            },
            {
              "chapter": 25,
              "verse": 23,
              "name": "Mga Kawikaan 25:23",
              "text": "Ang hanging hilaga ay naglalabas ng ulan: gayon ang dilang maninirang puri ay nakagagalit."
            },
            {
              "chapter": 25,
              "verse": 24,
              "name": "Mga Kawikaan 25:24",
              "text": "Maigi ang tumahan sa sulok ng bubungan, kay sa kasama ng palaaway na babae sa maluwang na bahay."
            },
            {
              "chapter": 25,
              "verse": 25,
              "name": "Mga Kawikaan 25:25",
              "text": "Kung paano ang malamig na tubig sa uhaw na kaluluwa, gayon ang mga mabuting balita na mula sa malayong lupain."
            },
            {
              "chapter": 25,
              "verse": 26,
              "name": "Mga Kawikaan 25:26",
              "text": "Kung paano ang malabong balon, at ang bukal na nalabusaw, gayon ang matuwid na tao na nagbigay daan sa harap ng masama."
            },
            {
              "chapter": 25,
              "verse": 27,
              "name": "Mga Kawikaan 25:27",
              "text": "Hindi mabuting kumain ng maraming pulot: gayon ang paghanap ng tao ng kanilang sariling kaluwalhatian, ay hindi kaluwalhatian."
            },
            {
              "chapter": 25,
              "verse": 28,
              "name": "Mga Kawikaan 25:28",
              "text": "Siyang hindi pumipigil ng kaniyang sariling diwa ay parang bayang nabagsak at walang kuta."
            }
          ]
        },
        {
          "chapter": 26,
          "name": "Mga Kawikaan 26",
          "verses": [
            {
              "chapter": 26,
              "verse": 1,
              "name": "Mga Kawikaan 26:1",
              "text": "Kung paano ang niebe sa taginit, at kung paano ang ulan sa pagaani, gayon ang karangalan ay hindi nababagay sa mangmang."
            },
            {
              "chapter": 26,
              "verse": 2,
              "name": "Mga Kawikaan 26:2",
              "text": "Kung paano ang maya sa kaniyang paggagala, kung paano ang langaylangayan sa kaniyang paglipad, gayon ang sumpa na walang kadahilanan ay hindi tumatalab."
            },
            {
              "chapter": 26,
              "verse": 3,
              "name": "Mga Kawikaan 26:3",
              "text": "Ang paghagupit ay sa kabayo, ang paningkaw ay sa asno, at ang pamalo ay sa likod ng mga mangmang."
            },
            {
              "chapter": 26,
              "verse": 4,
              "name": "Mga Kawikaan 26:4",
              "text": "Huwag mong sagutin ang mangmang ng ayon sa kaniyang kamangmangan, baka ikaw man ay maging gaya rin niya."
            },
            {
              "chapter": 26,
              "verse": 5,
              "name": "Mga Kawikaan 26:5",
              "text": "Sagutin mo ang mangmang ayon sa kaniyang kamangmangan, baka siya'y maging pantas sa ganang kaniya."
            },
            {
              "chapter": 26,
              "verse": 6,
              "name": "Mga Kawikaan 26:6",
              "text": "Siyang nagsusugo ng pasugo sa pamamagitan ng kamay ng mangmang naghihiwalay ng kaniyang mga paa, at umiinom sa kasiraan."
            },
            {
              "chapter": 26,
              "verse": 7,
              "name": "Mga Kawikaan 26:7",
              "text": "Ang mga hita ng pilay ay nabibitin: gayon ang talinghaga sa bibig ng mga mangmang."
            },
            {
              "chapter": 26,
              "verse": 8,
              "name": "Mga Kawikaan 26:8",
              "text": "Kung paano ang isa'y nagbabalot ng isang bato sa isang lambanog, gayon ang nagbibigay ng karangalan sa mangmang."
            },
            {
              "chapter": 26,
              "verse": 9,
              "name": "Mga Kawikaan 26:9",
              "text": "Kung paano ang tinik na tumutusok sa kamay ng lango, gayon ang talinghaga sa bibig ng mga mangmang."
            },
            {
              "chapter": 26,
              "verse": 10,
              "name": "Mga Kawikaan 26:10",
              "text": "Kung paano ang mamamana sumusugat sa lahat, gayon ang umupa sa mangmang at umuupa sa pagayongayon."
            },
            {
              "chapter": 26,
              "verse": 11,
              "name": "Mga Kawikaan 26:11",
              "text": "Kung paano ang aso na bumabalik sa kaniyang suka, gayon ang mangmang na umuulit ng kaniyang kamangmangan."
            },
            {
              "chapter": 26,
              "verse": 12,
              "name": "Mga Kawikaan 26:12",
              "text": "Nakikita mo ba ang taong pantas sa ganang kaniyang sarili. May higit na pagasa sa mangmang kay sa kaniya."
            },
            {
              "chapter": 26,
              "verse": 13,
              "name": "Mga Kawikaan 26:13",
              "text": "Sinabi ng tamad, may leon sa daan; isang leon ay nasa mga lansangan."
            },
            {
              "chapter": 26,
              "verse": 14,
              "name": "Mga Kawikaan 26:14",
              "text": "Kung paano ang pintuan ay pumipihit sa kaniyang bisagra, gayon ang tamad sa kaniyang higaan."
            },
            {
              "chapter": 26,
              "verse": 15,
              "name": "Mga Kawikaan 26:15",
              "text": "Idinadampot ng tamad ang kaniyang kamay sa pinggan; napapagod siyang dalhin uli sa kaniyang bibig."
            },
            {
              "chapter": 26,
              "verse": 16,
              "name": "Mga Kawikaan 26:16",
              "text": "Ang tamad ay lalong pantas sa ganang kaniyang sarili kay sa pitong tao na makapagbibigay katuwiran."
            },
            {
              "chapter": 26,
              "verse": 17,
              "name": "Mga Kawikaan 26:17",
              "text": "Ang nagdaraan, at nakikialam sa pagaaway na hindi ukol sa kaniya, ay gaya ng humahawak ng aso sa mga tainga."
            },
            {
              "chapter": 26,
              "verse": 18,
              "name": "Mga Kawikaan 26:18",
              "text": "Kung paano ang taong ulol na naghahagis ng mga dupong na apoy, mga pana, at kamatayan;"
            },
            {
              "chapter": 26,
              "verse": 19,
              "name": "Mga Kawikaan 26:19",
              "text": "Gayon ang tao na nagdadaya sa kaniyang kapuwa, at nagsasabi, hindi ko ba ginagawa sa paglilibang?"
            },
            {
              "chapter": 26,
              "verse": 20,
              "name": "Mga Kawikaan 26:20",
              "text": "Sapagka't sa kakulangan ng gatong ay namamatay ang apoy: at kung saan walang mapaghatid-dumapit ay tumitigil ang pagkakaalit."
            },
            {
              "chapter": 26,
              "verse": 21,
              "name": "Mga Kawikaan 26:21",
              "text": "Kung paano ang mga uling sa mga baga, at ang kahoy sa apoy; gayon ang taong madaldal na nagpapaningas ng pagkakaalit."
            },
            {
              "chapter": 26,
              "verse": 22,
              "name": "Mga Kawikaan 26:22",
              "text": "Ang mga salita ng mapaghatid-dumapit ay parang mga masarap na subo, at nagsisibaba sa mga pinakaloob na bahagi ng tiyan."
            },
            {
              "chapter": 26,
              "verse": 23,
              "name": "Mga Kawikaan 26:23",
              "text": "Mga mapusok na labi at masamang puso ay parang sisidlang-lupa na nababalot ng dumi ng pilak."
            },
            {
              "chapter": 26,
              "verse": 24,
              "name": "Mga Kawikaan 26:24",
              "text": "Ang nagtatanim ay nagpapakunwari ng kaniyang mga labi, nguni't siya'y naglalagay ng pagdaraya sa loob niya:"
            },
            {
              "chapter": 26,
              "verse": 25,
              "name": "Mga Kawikaan 26:25",
              "text": "Pagka siya'y nagsasalitang mainam, huwag mo siyang paniwalaan; sapagka't may pitong karumaldumal sa kaniyang puso:"
            },
            {
              "chapter": 26,
              "verse": 26,
              "name": "Mga Kawikaan 26:26",
              "text": "Bagaman ang kaniyang pagtatanim ay magtakip ng karayaan, at ang kaniyang kasamaan ay lubos na makikilala sa harap ng kapisanan."
            },
            {
              "chapter": 26,
              "verse": 27,
              "name": "Mga Kawikaan 26:27",
              "text": "Ang humuhukay ng lungaw ay mabubuwal doon: at siyang nagpapagulong ng bato, ay babalikan nito siya."
            },
            {
              "chapter": 26,
              "verse": 28,
              "name": "Mga Kawikaan 26:28",
              "text": "Ang sinungaling na dila ay nagtatanim sa mga sinaktan niya; at ang bibig ng kunwang mapagpuri ay gumagawa ng kapahamakan."
            }
          ]
        },
        {
          "chapter": 27,
          "name": "Mga Kawikaan 27",
          "verses": [
            {
              "chapter": 27,
              "verse": 1,
              "name": "Mga Kawikaan 27:1",
              "text": "Huwag mong ipaghambog ang kinabukasan; Sapagka't hindi mo nalalaman kung ano ang ilalabas ng ibang araw."
            },
            {
              "chapter": 27,
              "verse": 2,
              "name": "Mga Kawikaan 27:2",
              "text": "Purihin ka ng ibang tao at huwag ng iyong sariling bibig; ng iba, at huwag ng iyong sariling mga labi."
            },
            {
              "chapter": 27,
              "verse": 3,
              "name": "Mga Kawikaan 27:3",
              "text": "Ang bato ay mabigat, at ang buhangin ay matimbang; nguni't ang galit ng mangmang ay lalong mabigat kay sa mga yaon."
            },
            {
              "chapter": 27,
              "verse": 4,
              "name": "Mga Kawikaan 27:4",
              "text": "Poot ay mabagsik, at ang galit ay mamumugnaw, nguni't sinong makatatayo sa harap ng paninibugho?"
            },
            {
              "chapter": 27,
              "verse": 5,
              "name": "Mga Kawikaan 27:5",
              "text": "Maigi ang saway na hayag kay sa pagibig na nakukubli."
            },
            {
              "chapter": 27,
              "verse": 6,
              "name": "Mga Kawikaan 27:6",
              "text": "Tapat ang mga sugat ng kaibigan: nguni't ang mga halik ng kaaway ay malabis."
            },
            {
              "chapter": 27,
              "verse": 7,
              "name": "Mga Kawikaan 27:7",
              "text": "Ang busog na tao ay umaayaw sa pulot-pukyutan: nguni't sa gutom na tao ay matamis ang bawa't mapait na bagay."
            },
            {
              "chapter": 27,
              "verse": 8,
              "name": "Mga Kawikaan 27:8",
              "text": "Kung paano ang ibon na gumagala mula sa kaniyang pugad, gayon ang tao na gumagala mula sa kaniyang dako."
            },
            {
              "chapter": 27,
              "verse": 9,
              "name": "Mga Kawikaan 27:9",
              "text": "Ang unguento at pabango ay nagpapagalak ng puso: gayon ang katamisan ng kaibigan ng tao na nagbubuhat sa maiging payo."
            },
            {
              "chapter": 27,
              "verse": 10,
              "name": "Mga Kawikaan 27:10",
              "text": "Ang iyong sariling kaibigan at ang kaibigan ng iyong ama, ay huwag mong pabayaan; at huwag kang pumaroon sa bahay ng iyong kapatid sa kaarawan ng iyong kasakunaan: maigi ang kapuwa na malapit kay sa kapatid na malayo."
            },
            {
              "chapter": 27,
              "verse": 11,
              "name": "Mga Kawikaan 27:11",
              "text": "Anak ko, ikaw ay magpakadunong, at iyong pasayahin ang aking puso, upang aking masagot siya na tumutuya sa akin."
            },
            {
              "chapter": 27,
              "verse": 12,
              "name": "Mga Kawikaan 27:12",
              "text": "Ang taong mabait ay nakakakita ng kasamaan, at nagkukubli: nguni't dinadaanan ng musmos, at naghihirap."
            },
            {
              "chapter": 27,
              "verse": 13,
              "name": "Mga Kawikaan 27:13",
              "text": "Kunin mo ang kaniyang kasuutan na nananagot sa di kilala; at tanggapan mo siya ng sanla na nananagot sa babaing di kilala."
            },
            {
              "chapter": 27,
              "verse": 14,
              "name": "Mga Kawikaan 27:14",
              "text": "Siyang nagpapala sa kaniyang kaibigan ng malakas na tinig, na bumabangong maaga sa kinaumagahan, mabibilang na sumpa sa kaniya."
            },
            {
              "chapter": 27,
              "verse": 15,
              "name": "Mga Kawikaan 27:15",
              "text": "Ang laging tulo sa araw na maulan at ang babaing palatalo ay magkahalintulad:"
            },
            {
              "chapter": 27,
              "verse": 16,
              "name": "Mga Kawikaan 27:16",
              "text": "Ang magibig pumigil sa kaniya, ay pumipigil sa hangin, at ang kaniyang kanan ay nakakasumpong ng langis."
            },
            {
              "chapter": 27,
              "verse": 17,
              "name": "Mga Kawikaan 27:17",
              "text": "Ang bakal ay nagpapatalas sa bakal; gayon ang tao ay nagpapatalas sa mukha ng kaniyang kaibigan."
            },
            {
              "chapter": 27,
              "verse": 18,
              "name": "Mga Kawikaan 27:18",
              "text": "Ang nagiingat ng puno ng higos ay kakain ng bunga niyaon; at ang naghihintay sa kaniyang panginoon ay pararangalin."
            },
            {
              "chapter": 27,
              "verse": 19,
              "name": "Mga Kawikaan 27:19",
              "text": "Kung paanong sa tubig ang mukha ay sumasagot sa mukha, gayon ang puso ng tao sa tao."
            },
            {
              "chapter": 27,
              "verse": 20,
              "name": "Mga Kawikaan 27:20",
              "text": "Ang Sheol at ang kapahamakan ay hindi nasisiyahan kailan man; at ang mga mata ng tao ay hindi nasisiyahan kailan man."
            },
            {
              "chapter": 27,
              "verse": 21,
              "name": "Mga Kawikaan 27:21",
              "text": "Ang sangagan ay sa pilak, at ang hurno ay sa ginto, at ang tao ay nasusubok sa pamamagitan ng kaniyang pagpuri."
            },
            {
              "chapter": 27,
              "verse": 22,
              "name": "Mga Kawikaan 27:22",
              "text": "Bagaman iyong piitin ang mangmang sa isang piitan na kasama ng pangbayo sa mga bayong trigo, gayon ma'y hindi hihiwalay ang kaniyang kamangmangan sa kaniya."
            },
            {
              "chapter": 27,
              "verse": 23,
              "name": "Mga Kawikaan 27:23",
              "text": "Magmasipag ka na alamin mo ang kalagayan ng iyong mga kawan, at tingnan mong mabuti ang iyong mga bakahan:"
            },
            {
              "chapter": 27,
              "verse": 24,
              "name": "Mga Kawikaan 27:24",
              "text": "Sapagka't ang mga kayamanan ay hindi magpakailan man: at namamalagi ba ang putong sa lahat ng sali't saling lahi?"
            },
            {
              "chapter": 27,
              "verse": 25,
              "name": "Mga Kawikaan 27:25",
              "text": "Ang tuyong damo ay pinupulot, at ang sariwang damo ay lumilitaw, at ang mga gugulayin sa mga bundok ay pinipisan."
            },
            {
              "chapter": 27,
              "verse": 26,
              "name": "Mga Kawikaan 27:26",
              "text": "Ang mga kordero ay ukol sa iyong kasuutan, at ang mga kambing ay siyang halaga ng bukid:"
            },
            {
              "chapter": 27,
              "verse": 27,
              "name": "Mga Kawikaan 27:27",
              "text": "At magkakaroon ng kasiyahang gatas ng kambing sa iyong pagkain, sa pagkain ng iyong sangbahayan; at pagkain sa iyong mga alilang babae."
            }
          ]
        },
        {
          "chapter": 28,
          "name": "Mga Kawikaan 28",
          "verses": [
            {
              "chapter": 28,
              "verse": 1,
              "name": "Mga Kawikaan 28:1",
              "text": "Ang masama ay tumatakas ng walang taong humahabol: nguni't ang matuwid ay matapang na parang leon."
            },
            {
              "chapter": 28,
              "verse": 2,
              "name": "Mga Kawikaan 28:2",
              "text": "Dahil sa pagsalangsang ng lupain ay marami ang kaniyang mga pangulo: nguni't sa naguunawa at matalino ay malalaon ang kalagayan niya."
            },
            {
              "chapter": 28,
              "verse": 3,
              "name": "Mga Kawikaan 28:3",
              "text": "Ang mapagkailangan na pumipighati sa dukha ay parang bugso ng ulan na hindi nagiiwan ng pagkain."
            },
            {
              "chapter": 28,
              "verse": 4,
              "name": "Mga Kawikaan 28:4",
              "text": "Silang nangagpapabaya sa kautusan ay nagsisipuri sa masama: nguni't ang nangagiingat ng kautusan ay nangakikipagkaalit sa kanila."
            },
            {
              "chapter": 28,
              "verse": 5,
              "name": "Mga Kawikaan 28:5",
              "text": "Ang masasamang tao ay hindi nangakakaunawa ng kahatulan: nguni't silang nagsisihanap sa Panginoon ay nangakakaunawa sa lahat ng mga bagay."
            },
            {
              "chapter": 28,
              "verse": 6,
              "name": "Mga Kawikaan 28:6",
              "text": "Maigi ang dukha na lumalakad sa kaniyang pagtatapat, kay sa suwail sa kaniyang mga lakad, bagaman siya'y mayaman."
            },
            {
              "chapter": 28,
              "verse": 7,
              "name": "Mga Kawikaan 28:7",
              "text": "Sinomang nagiingat ng kautusan ay pantas na anak: nguni't siyang kasama ng mga matakaw ay nagbibigay kahihiyan sa kaniyang ama."
            },
            {
              "chapter": 28,
              "verse": 8,
              "name": "Mga Kawikaan 28:8",
              "text": "Ang nagpapalago ng kaniyang yaman sa tubo at pakinabang, ay pumipisan sa ganang may awa sa dukha."
            },
            {
              "chapter": 28,
              "verse": 9,
              "name": "Mga Kawikaan 28:9",
              "text": "Siyang naglalayo ng kaniyang pakinig sa pakikinig ng kautusan, maging ang kaniyang dalangin ay karumaldumal."
            },
            {
              "chapter": 28,
              "verse": 10,
              "name": "Mga Kawikaan 28:10",
              "text": "Sinomang nagliligaw sa matuwid sa masamang daan, siya'y mahuhulog sa kaniyang sariling lungaw: nguni't ang sakdal ay magmamana ng mabuti."
            },
            {
              "chapter": 28,
              "verse": 11,
              "name": "Mga Kawikaan 28:11",
              "text": "Ang mayaman ay pantas sa ganang kaniyang sarili; nguni't ang dukha na naguunawa ay sumisiyasat."
            },
            {
              "chapter": 28,
              "verse": 12,
              "name": "Mga Kawikaan 28:12",
              "text": "Pagka ang matuwid ay nagtatagumpay, may dakilang kaluwalhatian: nguni't pagka ang masama ay bumabangon, nagsisipagtago ang mga tao."
            },
            {
              "chapter": 28,
              "verse": 13,
              "name": "Mga Kawikaan 28:13",
              "text": "Siyang nagtatakip ng kaniyang mga pagsalangsang ay hindi giginhawa: nguni't ang nagpapahayag at nagiiwan ng mga yaon ay magtatamo ng kaawaan."
            },
            {
              "chapter": 28,
              "verse": 14,
              "name": "Mga Kawikaan 28:14",
              "text": "Masaya ang tao na natatakot na lagi: nguni't siyang nagmamatigas ng kaniyang kalooban ay mahuhulog sa kahirapan."
            },
            {
              "chapter": 28,
              "verse": 15,
              "name": "Mga Kawikaan 28:15",
              "text": "Kung paano ang umuungal na leon at ang gutom na oso, gayon ang masamang pinuno sa maralitang bayan."
            },
            {
              "chapter": 28,
              "verse": 16,
              "name": "Mga Kawikaan 28:16",
              "text": "Ang pangulo na kulang sa paguunawa ay lubhang mamimighati rin: nguni't siyang nagtatanim sa kasakiman ay dadami ang kaniyang mga kaarawan."
            },
            {
              "chapter": 28,
              "verse": 17,
              "name": "Mga Kawikaan 28:17",
              "text": "Ang tao na nagpapasan ng dugo ng sinomang tao, tatakas sa lungaw; huwag siyang pigilin ng sinoman."
            },
            {
              "chapter": 28,
              "verse": 18,
              "name": "Mga Kawikaan 28:18",
              "text": "Ang lumalakad ng matuwid ay maliligtas: nguni't siyang masama sa kaniyang mga lakad ay mabubuwal na bigla."
            },
            {
              "chapter": 28,
              "verse": 19,
              "name": "Mga Kawikaan 28:19",
              "text": "Siyang bumubukid ng kaniyang lupain ay magkakaroon ng saganang tinapay: nguni't siyang sumusunod sa mga walang kabuluhang tao ay madudukhang mainam."
            },
            {
              "chapter": 28,
              "verse": 20,
              "name": "Mga Kawikaan 28:20",
              "text": "Ang tapat na tao ay mananagana sa pagpapala: nguni't siyang nagmamadali sa pagyaman ay walang pagsalang parurusahan."
            },
            {
              "chapter": 28,
              "verse": 21,
              "name": "Mga Kawikaan 28:21",
              "text": "Magkaroon ng pagtatangi sa mga pagkatao ay hindi mabuti: ni hindi man sasalangsang ang tao dahil sa isang putol na tinapay."
            },
            {
              "chapter": 28,
              "verse": 22,
              "name": "Mga Kawikaan 28:22",
              "text": "Siyang may masamang mata ay nagmamadali sa pagyaman, at hindi nakakaalam, na kasalatan ay darating sa kaniya."
            },
            {
              "chapter": 28,
              "verse": 23,
              "name": "Mga Kawikaan 28:23",
              "text": "Siyang sumasaway sa isang tao ay makakasumpong sa ibang araw ng higit na lingap kay sa doon sa kunwa'y pumupuri ng dila."
            },
            {
              "chapter": 28,
              "verse": 24,
              "name": "Mga Kawikaan 28:24",
              "text": "Ang nagnanakaw sa kaniyang ama o sa kaniyang ina, at nagsasabi, hindi ito pagsalangsang; Yao'y kasama rin ng maninira."
            },
            {
              "chapter": 28,
              "verse": 25,
              "name": "Mga Kawikaan 28:25",
              "text": "Siyang may sakim na diwa ay humihila ng kaalitan: nguni't siyang naglalagak ng kaniyang tiwala sa Panginoon ay tataba."
            },
            {
              "chapter": 28,
              "verse": 26,
              "name": "Mga Kawikaan 28:26",
              "text": "Siyang tumitiwala sa kaniyang sariling puso ay mangmang: nguni't ang lumakad na may kapantasan, ay maliligtas."
            },
            {
              "chapter": 28,
              "verse": 27,
              "name": "Mga Kawikaan 28:27",
              "text": "Siyang nagbibigay sa dukha ay hindi masasalat: nguni't siyang nagkukubli ng kaniyang mga mata ay magkakaroon ng maraming sumpa."
            },
            {
              "chapter": 28,
              "verse": 28,
              "name": "Mga Kawikaan 28:28",
              "text": "Pagka ang masama ay bumabangon, nagsisipagkubli ang mga tao; nguni't pagka sila'y nangamamatay, dumadami ang matuwid."
            }
          ]
        },
        {
          "chapter": 29,
          "name": "Mga Kawikaan 29",
          "verses": [
            {
              "chapter": 29,
              "verse": 1,
              "name": "Mga Kawikaan 29:1",
              "text": "Ang madalas na masaway na nagpapatigas ng kaniyang leeg, biglang mababali, at walang kagamutan."
            },
            {
              "chapter": 29,
              "verse": 2,
              "name": "Mga Kawikaan 29:2",
              "text": "Pagka ang matuwid ay dumadami, ang bayan ay nagagalak: nguni't pagka ang masama ay nagpupuno, ang bayan ay nagbubuntong-hininga."
            },
            {
              "chapter": 29,
              "verse": 3,
              "name": "Mga Kawikaan 29:3",
              "text": "Ang umiibig ng karunungan ay nagpapagalak sa kaniyang ama: nguni't ang nakikisama sa mga patutot ay sumisira ng kaniyang tinatangkilik."
            },
            {
              "chapter": 29,
              "verse": 4,
              "name": "Mga Kawikaan 29:4",
              "text": "Ang hari ay nagtatatag ng lupain sa pamamagitan ng kahatulan: nguni't ang humihingi ng suhol ay gumigiba."
            },
            {
              "chapter": 29,
              "verse": 5,
              "name": "Mga Kawikaan 29:5",
              "text": "Ang tao na kunwang pumupuri sa kaniyang kapuwa naglalagay ng bitag sa kaniyang mga hakbang."
            },
            {
              "chapter": 29,
              "verse": 6,
              "name": "Mga Kawikaan 29:6",
              "text": "Sa pagsalangsang ng masamang tao ay may silo: nguni't ang matuwid ay umaawit at nagagalak."
            },
            {
              "chapter": 29,
              "verse": 7,
              "name": "Mga Kawikaan 29:7",
              "text": "Ang matuwid ay kumukuhang alam sa bagay ng dukha: ang masama ay walang unawang makaalam."
            },
            {
              "chapter": 29,
              "verse": 8,
              "name": "Mga Kawikaan 29:8",
              "text": "Ang mga mangduduwahaging tao ay naglalagay ng bayan sa liyab: nguni't ang mga pantas na tao ay nagaalis ng poot."
            },
            {
              "chapter": 29,
              "verse": 9,
              "name": "Mga Kawikaan 29:9",
              "text": "Kung ang pantas ay magkaroon ng pakikipagtalo sa isang mangmang, magalit man o tumawa, ang mangmang ay hindi magkakaroon ng kapahingahan."
            },
            {
              "chapter": 29,
              "verse": 10,
              "name": "Mga Kawikaan 29:10",
              "text": "Ang mangbububo ng dugo ay nagtatanim sa sakdal: at tungkol sa matuwid, hinahanap nila ang kaniyang buhay."
            },
            {
              "chapter": 29,
              "verse": 11,
              "name": "Mga Kawikaan 29:11",
              "text": "Inihihinga ng mangmang ang buong galit niya: nguni't ang pantas ay nagpipigil at tumitiwasay."
            },
            {
              "chapter": 29,
              "verse": 12,
              "name": "Mga Kawikaan 29:12",
              "text": "Kung ang puno ay nakikinig sa kabulaanan, lahat niyang mga lingkod ay masasama."
            },
            {
              "chapter": 29,
              "verse": 13,
              "name": "Mga Kawikaan 29:13",
              "text": "Ang dukha at ang mamimighati ay nagsasalubong; pinapagniningas ng Panginoon ang mga mata nila kapuwa."
            },
            {
              "chapter": 29,
              "verse": 14,
              "name": "Mga Kawikaan 29:14",
              "text": "Ang hari na humahatol na tapat sa dukha, ang kaniyang luklukan ay matatatag magpakailan man."
            },
            {
              "chapter": 29,
              "verse": 15,
              "name": "Mga Kawikaan 29:15",
              "text": "Ang pamalo at saway ay nagbibigay karunungan: nguni't ang batang binabayaan ay humihiya sa kaniyang ina."
            },
            {
              "chapter": 29,
              "verse": 16,
              "name": "Mga Kawikaan 29:16",
              "text": "Pagka ang masama ay dumadami, pagsalangsang ay dumadami: nguni't mamamasdan ng matuwid ang kanilang pagkabuwal."
            },
            {
              "chapter": 29,
              "verse": 17,
              "name": "Mga Kawikaan 29:17",
              "text": "Sawayin mo ang iyong anak, at bibigyan ka niya ng kapahingahan; Oo, bibigyan niya ng kaluguran ang iyong kaluluwa."
            },
            {
              "chapter": 29,
              "verse": 18,
              "name": "Mga Kawikaan 29:18",
              "text": "Kung saan walang pangitain, ang bayan ay sumasama: nguni't siyang nagiingat ng kautusan ay maligaya siya."
            },
            {
              "chapter": 29,
              "verse": 19,
              "name": "Mga Kawikaan 29:19",
              "text": "Ang alipin ay hindi masasaway ng mga salita: sapagka't bagaman nalalaman niya ay hindi siya makikinig."
            },
            {
              "chapter": 29,
              "verse": 20,
              "name": "Mga Kawikaan 29:20",
              "text": "Nakikita mo ba ang tao, na nagmamadali sa kaniyang mga salita? May pagasa pa sa mangmang kay sa kaniya."
            },
            {
              "chapter": 29,
              "verse": 21,
              "name": "Mga Kawikaan 29:21",
              "text": "Siyang maingat na nagpalaki ng kaniyang lingkod mula sa pagkabata, magiging anak niya siya sa kawakasan."
            },
            {
              "chapter": 29,
              "verse": 22,
              "name": "Mga Kawikaan 29:22",
              "text": "Ang taong magagalitin ay humihila ng kaalitan, at ang mainiting tao ay nananagana sa pagsalangsang."
            },
            {
              "chapter": 29,
              "verse": 23,
              "name": "Mga Kawikaan 29:23",
              "text": "Ang kapalaluan ng tao ay magbababa sa kaniya: nguni't ang may mapagpakumbabang diwa ay magtatamo ng karangalan."
            },
            {
              "chapter": 29,
              "verse": 24,
              "name": "Mga Kawikaan 29:24",
              "text": "Ang nakikisama sa isang magnanakaw ay nagtatanim sa kaniyang sariling kaluluwa: siya'y nakakarinig ng sumpa at hindi umiimik."
            },
            {
              "chapter": 29,
              "verse": 25,
              "name": "Mga Kawikaan 29:25",
              "text": "Ang pagkatakot sa tao ay nagdadala ng silo: nguni't ang naglalagak ng kaniyang tiwala sa Panginoon ay maliligtas."
            },
            {
              "chapter": 29,
              "verse": 26,
              "name": "Mga Kawikaan 29:26",
              "text": "Marami ang nagsisihanap ng lingap ng pinuno: nguni't ang kahatulan ng tao ay nagmumula sa Panginoon."
            },
            {
              "chapter": 29,
              "verse": 27,
              "name": "Mga Kawikaan 29:27",
              "text": "Ang di ganap na tao ay karumaldumal sa matuwid: at ang matuwid sa lakad ay karumaldumal sa masama."
            }
          ]
        },
        {
          "chapter": 30,
          "name": "Mga Kawikaan 30",
          "verses": [
            {
              "chapter": 30,
              "verse": 1,
              "name": "Mga Kawikaan 30:1",
              "text": "Ang mga salita ni Agur na anak ni Jache; ang sanggunian. Sinabi ng lalake kay Ithiel, kay Ithiel, at kay Ucal:"
            },
            {
              "chapter": 30,
              "verse": 2,
              "name": "Mga Kawikaan 30:2",
              "text": "Tunay na ako'y hangal kay sa kaninoman, at walang kaunawaan ng isang tao:"
            },
            {
              "chapter": 30,
              "verse": 3,
              "name": "Mga Kawikaan 30:3",
              "text": "At hindi ako natuto ng karunungan, ni mayroon man ako ng kaalaman ng Banal."
            },
            {
              "chapter": 30,
              "verse": 4,
              "name": "Mga Kawikaan 30:4",
              "text": "Sino ang sumampa sa langit, at bumaba? Sino ang pumisan ng hangin sa kaniyang mga dakot? Sinong nagtali ng tubig sa kaniyang kasuutan? Sinong nagtatag ng lahat ng mga wakas ng lupa? Ano ang kaniyang pangalan, at ano ang pangalan ng kaniyang anak kung iyong nalalaman?"
            },
            {
              "chapter": 30,
              "verse": 5,
              "name": "Mga Kawikaan 30:5",
              "text": "Bawa't salita ng Dios ay subok: siya'y kalasag sa kanila, na nanganganlong sa kaniya."
            },
            {
              "chapter": 30,
              "verse": 6,
              "name": "Mga Kawikaan 30:6",
              "text": "Huwag kang magdagdag sa kaniyang mga salita, baka kaniyang sawayin ka, at masunduan kang sinungaling."
            },
            {
              "chapter": 30,
              "verse": 7,
              "name": "Mga Kawikaan 30:7",
              "text": "Dalawang bagay ang hiniling ko sa iyo; huwag mong ipagkait sa akin bago ako mamatay."
            },
            {
              "chapter": 30,
              "verse": 8,
              "name": "Mga Kawikaan 30:8",
              "text": "Ilayo mo sa akin ang walang kabuluhan at ang mga kasinungalingan: huwag mo akong bigyan ng kahit karalitaan o kayamanan man; pakanin mo ako ng pagkain na kailangan ko:"
            },
            {
              "chapter": 30,
              "verse": 9,
              "name": "Mga Kawikaan 30:9",
              "text": "Baka ako'y mabusog, at magkaila sa iyo, at magsabi, sino ang Panginoon? O baka ako'y maging dukha, at magnakaw ako, at gumamit ng paglapastangan sa pangalan ng aking Dios."
            },
            {
              "chapter": 30,
              "verse": 10,
              "name": "Mga Kawikaan 30:10",
              "text": "Huwag mong pawikaan ang alipin sa kaniyang panginoon, baka ka tungayawin niya, at ikaw ay maging salarin."
            },
            {
              "chapter": 30,
              "verse": 11,
              "name": "Mga Kawikaan 30:11",
              "text": "May lahi na tumutungayaw sa kanilang ama. At hindi pinagpapala ang kanilang ina."
            },
            {
              "chapter": 30,
              "verse": 12,
              "name": "Mga Kawikaan 30:12",
              "text": "May lahi na malinis sa harap ng kanilang sariling mga mata, at gayon man ay hindi hugas sa kanilang karumihan."
            },
            {
              "chapter": 30,
              "verse": 13,
              "name": "Mga Kawikaan 30:13",
              "text": "May lahi, Oh pagka mapagmataas ng kanilang mga mata! At ang kanilang mga talukap-mata ay nangakataas."
            },
            {
              "chapter": 30,
              "verse": 14,
              "name": "Mga Kawikaan 30:14",
              "text": "May lahi na ang mga ngipin ay parang mga tabak, at ang kanilang mga bagang ay parang mga sundang, upang lamunin ang dukha mula sa lupa, at ang mapagkailangan sa gitna ng mga tao."
            },
            {
              "chapter": 30,
              "verse": 15,
              "name": "Mga Kawikaan 30:15",
              "text": "Ang linga ay may dalawang anak, na sumisigaw, bigyan mo, bigyan mo. May tatlong bagay na kailan man ay hindi nasisiyahan, Oo, apat na hindi nagsasabi, siya na:"
            },
            {
              "chapter": 30,
              "verse": 16,
              "name": "Mga Kawikaan 30:16",
              "text": "Ang Sheol; at ang baog na bahay-bata; ang lupa na hindi napapatiranguhaw ng tubig; at ang apoy na hindi nagsasabi, siya na."
            },
            {
              "chapter": 30,
              "verse": 17,
              "name": "Mga Kawikaan 30:17",
              "text": "Ang mata na tumutuya sa kaniyang ama, at humahamak ng pagsunod sa kaniyang ina, tutukain ito ng mga uwak sa libis, at kakanin ito ng mga inakay na aguila."
            },
            {
              "chapter": 30,
              "verse": 18,
              "name": "Mga Kawikaan 30:18",
              "text": "May tatlong bagay na totoong kagilagilalas sa akin, Oo, apat na hindi ko nalalaman:"
            },
            {
              "chapter": 30,
              "verse": 19,
              "name": "Mga Kawikaan 30:19",
              "text": "Ang lipad ng aguila sa hangin; ang usad ng ahas sa ibabaw ng mga bato; ang lutang ng sasakyan sa gitna ng dagat; at ang lakad ng lalake na kasama ng isang dalaga."
            },
            {
              "chapter": 30,
              "verse": 20,
              "name": "Mga Kawikaan 30:20",
              "text": "Gayon ang lakad ng mangangalunyang babae; siya'y kumakain, at nagpapahid ng kaniyang bibig, at nagsasabi, hindi ako gumawa ng kasamaan."
            },
            {
              "chapter": 30,
              "verse": 21,
              "name": "Mga Kawikaan 30:21",
              "text": "Sa tatlong bagay ay nanginginig ang lupa, at sa apat na hindi niya madala:"
            },
            {
              "chapter": 30,
              "verse": 22,
              "name": "Mga Kawikaan 30:22",
              "text": "Sa isang alipin, pagka naghahari; at sa isang mangmang, pagka nabubusog ng pagkain;"
            },
            {
              "chapter": 30,
              "verse": 23,
              "name": "Mga Kawikaan 30:23",
              "text": "Sa isang babaing nakayayamot, pagka nagaasawa; at sa isang aliping babae, na nagmamana sa kaniyang panginoong babae."
            },
            {
              "chapter": 30,
              "verse": 24,
              "name": "Mga Kawikaan 30:24",
              "text": "May apat na bagay na maliit sa lupa, nguni't lubhang mga pantas:"
            },
            {
              "chapter": 30,
              "verse": 25,
              "name": "Mga Kawikaan 30:25",
              "text": "Ang mga langgam ay bayang hindi matibay, gayon ma'y nagiimbak ng kanilang pagkain sa taginit;"
            },
            {
              "chapter": 30,
              "verse": 26,
              "name": "Mga Kawikaan 30:26",
              "text": "Ang mga koneho ay hayop na mahina, gayon ma'y nagsisigawa sila ng kanilang mga bahay sa malalaking bato;"
            },
            {
              "chapter": 30,
              "verse": 27,
              "name": "Mga Kawikaan 30:27",
              "text": "Ang mga balang ay walang hari, gayon ma'y lumalabas silang lahat na pulupulutong;"
            },
            {
              "chapter": 30,
              "verse": 28,
              "name": "Mga Kawikaan 30:28",
              "text": "Ang butiki ay tumatangan ng kaniyang mga kamay, gayon ma'y nasa mga bahay ng mga hari siya."
            },
            {
              "chapter": 30,
              "verse": 29,
              "name": "Mga Kawikaan 30:29",
              "text": "May tatlong bagay na maganda sa kanilang lakad, Oo, apat na mainam sa lakad:"
            },
            {
              "chapter": 30,
              "verse": 30,
              "name": "Mga Kawikaan 30:30",
              "text": "Ang leon na pinaka matapang sa mga hayop, at hindi humihiwalay ng dahil sa kanino man;"
            },
            {
              "chapter": 30,
              "verse": 31,
              "name": "Mga Kawikaan 30:31",
              "text": "Ang asong matulin; ang kambing na lalake rin naman: at ang hari na hindi malalabanan."
            },
            {
              "chapter": 30,
              "verse": 32,
              "name": "Mga Kawikaan 30:32",
              "text": "Kung ikaw ay gumagawa ng kamangmangan sa pagmamataas, o kung ikaw ay umisip ng kasamaan, ilagay mo ang iyong kamay sa iyong bibig."
            },
            {
              "chapter": 30,
              "verse": 33,
              "name": "Mga Kawikaan 30:33",
              "text": "Sapagka't sa pagbati sa gatas ay naglalabas ng mantekilya, at sa pagsungalngal sa ilong ay lumalabas ang dugo: Gayon ang pamumungkahi sa poot ay naglalabas ng kaalitan."
            }
          ]
        },
        {
          "chapter": 31,
          "name": "Mga Kawikaan 31",
          "verses": [
            {
              "chapter": 31,
              "verse": 1,
              "name": "Mga Kawikaan 31:1",
              "text": "Ang mga salita ng haring Lemuel; ang sanggunian na itinuro sa kaniya ng kaniyang ina."
            },
            {
              "chapter": 31,
              "verse": 2,
              "name": "Mga Kawikaan 31:2",
              "text": "Ano anak ko? at ano, Oh anak ng aking bahay-bata? At ano, Oh anak ng aking mga panata?"
            },
            {
              "chapter": 31,
              "verse": 3,
              "name": "Mga Kawikaan 31:3",
              "text": "Huwag mong ibigay ang iyong kalakasan sa mga babae, o ang iyo mang mga lakad sa lumilipol ng mga hari."
            },
            {
              "chapter": 31,
              "verse": 4,
              "name": "Mga Kawikaan 31:4",
              "text": "Hindi sa mga hari, Oh Lemuel, hindi sa mga hari ang paginom ng alak; ni sa mga pangulo man, na magsabi, saan nandoon ang matapang na alak?"
            },
            {
              "chapter": 31,
              "verse": 5,
              "name": "Mga Kawikaan 31:5",
              "text": "Baka sila'y uminom, at makalimotan ang kautusan, at humamak ng kahatulan sa sinomang nagdadalamhati."
            },
            {
              "chapter": 31,
              "verse": 6,
              "name": "Mga Kawikaan 31:6",
              "text": "Bigyan mo ng matapang na inumin siya na handang manaw, at ng alak ang mapanglaw na loob."
            },
            {
              "chapter": 31,
              "verse": 7,
              "name": "Mga Kawikaan 31:7",
              "text": "Uminom siya at limutin niya ang kaniyang kahirapan, at huwag nang alalahanin pa ang kaniyang karalitaan."
            },
            {
              "chapter": 31,
              "verse": 8,
              "name": "Mga Kawikaan 31:8",
              "text": "Bukhin mo ang iyong bibig sa pipi, sa bagay ng lahat ng naiwang walang kandili."
            },
            {
              "chapter": 31,
              "verse": 9,
              "name": "Mga Kawikaan 31:9",
              "text": "Bukhin mo ang iyong bibig, humatol ka ng katuwiran, at mangasiwa ka ng kahatulan sa dukha at mapagkailangan."
            },
            {
              "chapter": 31,
              "verse": 10,
              "name": "Mga Kawikaan 31:10",
              "text": "Isang mabait na babae sinong makakasumpong? Sapagka't ang kaniyang halaga ay higit na makapupo kay sa mga rubi."
            },
            {
              "chapter": 31,
              "verse": 11,
              "name": "Mga Kawikaan 31:11",
              "text": "Ang puso ng kaniyang asawa ay tumitiwala sa kaniya, at siya'y hindi kukulangin ng pakinabang."
            },
            {
              "chapter": 31,
              "verse": 12,
              "name": "Mga Kawikaan 31:12",
              "text": "Gumagawa siya ng mabuti sa kaniya at hindi kasamaan lahat ng mga kaarawan ng kaniyang buhay."
            },
            {
              "chapter": 31,
              "verse": 13,
              "name": "Mga Kawikaan 31:13",
              "text": "Siya'y humahanap ng balahibo ng tupa at lino, at gumagawang kusa ng kaniyang mga kamay."
            },
            {
              "chapter": 31,
              "verse": 14,
              "name": "Mga Kawikaan 31:14",
              "text": "Siya'y parang mga sasakyang dagat ng kalakal; nagdadala siya ng kaniyang pagkain mula sa malayo."
            },
            {
              "chapter": 31,
              "verse": 15,
              "name": "Mga Kawikaan 31:15",
              "text": "Siya'y bumabangon naman samantalang gabi pa, at nagbibigay ng pagkain sa kaniyang sangbahayan, at ng kanilang gawain sa kaniyang alilang babae."
            },
            {
              "chapter": 31,
              "verse": 16,
              "name": "Mga Kawikaan 31:16",
              "text": "Kaniyang minamasdan ang bukid at binibili: sa pamamagitan ng kaniyang kamay ay nagtatanim siya ng ubasan."
            },
            {
              "chapter": 31,
              "verse": 17,
              "name": "Mga Kawikaan 31:17",
              "text": "Binibigkisan niya ang kaniyang mga balakang ng kalakasan, at nagpapalakas ng kaniyang mga bisig."
            },
            {
              "chapter": 31,
              "verse": 18,
              "name": "Mga Kawikaan 31:18",
              "text": "Kaniyang namamalas na ang kaniyang kalakal ay makikinabang: ang kaniyang ilaw ay hindi namamatay sa gabi."
            },
            {
              "chapter": 31,
              "verse": 19,
              "name": "Mga Kawikaan 31:19",
              "text": "Kaniyang itinangan ang kaniyang mga kamay sa panulid, at ang kaniyang mga kamay ay humahawak ng panghabi."
            },
            {
              "chapter": 31,
              "verse": 20,
              "name": "Mga Kawikaan 31:20",
              "text": "Iginagawad niya ang kaniyang kamay sa dukha: Oo, iniaabot niya ang kaniyang mga kamay sa mapagkailangan."
            },
            {
              "chapter": 31,
              "verse": 21,
              "name": "Mga Kawikaan 31:21",
              "text": "Hindi niya ikinatatakot ang kaniyang sangbahayan sa niebe; sapagka't ang boo niyang sangbahayan ay nakapanamit ng mapulang mapula."
            },
            {
              "chapter": 31,
              "verse": 22,
              "name": "Mga Kawikaan 31:22",
              "text": "Gumagawa siya sa ganang kaniya ng mga unang may burda; ang kaniyang pananamit ay mainam na kayong lino at ng kayong kulay ube."
            },
            {
              "chapter": 31,
              "verse": 23,
              "name": "Mga Kawikaan 31:23",
              "text": "Ang kaniyang asawa ay kilala sa mga pintuang-bayan, pagka siya'y nauupo sa kasamahan ng mga matanda ng lupain."
            },
            {
              "chapter": 31,
              "verse": 24,
              "name": "Mga Kawikaan 31:24",
              "text": "Gumagawa siya ng mga kasuutang kayong lino at ipinagbibili; at nagbibigay ng mga pamigkis sa mga mangangalakal."
            },
            {
              "chapter": 31,
              "verse": 25,
              "name": "Mga Kawikaan 31:25",
              "text": "Kalakasan at kamahalan ay siyang kaniyang suot. At kaniyang tinatawanan ang panahong darating."
            },
            {
              "chapter": 31,
              "verse": 26,
              "name": "Mga Kawikaan 31:26",
              "text": "Binubuka niya ang kaniyang bibig na may karunungan; at ang kautusan ng kagandahang-loob ay nasa kaniyang dila."
            },
            {
              "chapter": 31,
              "verse": 27,
              "name": "Mga Kawikaan 31:27",
              "text": "Kaniyang tinitignang mabuti ang mga lakad ng kaniyang sangbahayan, at hindi kumakain ng tinapay ng katamaran."
            },
            {
              "chapter": 31,
              "verse": 28,
              "name": "Mga Kawikaan 31:28",
              "text": "Nagsisibangon ang kaniyang mga anak, at tinatawag siyang mapalad; gayon din ang kaniyang asawa, at pinupuri siya niya, na sinasabi:"
            },
            {
              "chapter": 31,
              "verse": 29,
              "name": "Mga Kawikaan 31:29",
              "text": "Maraming anak na babae ay nagsisigawang may kabaitan, nguni't ikaw, ay humihigit sa kanilang lahat."
            },
            {
              "chapter": 31,
              "verse": 30,
              "name": "Mga Kawikaan 31:30",
              "text": "Ang lingap ay magdaraya, at ang kagandahan ay walang kabuluhan: nguni't ang babae na natatakot sa Panginoon, ay siya'y pupurihin."
            },
            {
              "chapter": 31,
              "verse": 31,
              "name": "Mga Kawikaan 31:31",
              "text": "Bigyan ninyo siya ng bunga ng kaniyang mga kamay; at purihin siya ng kaniyang mga gawa sa mga pintuang-bayan."
            }
          ]
        }
      ]
    },
    {
      "nr": 21,
      "name": "Mangangaral",
      "chapters": [
        {
          "chapter": 1,
          "name": "Mangangaral 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Mangangaral 1:1",
              "text": "Ang mga salita ng Mangangaral, na anak ni David, hari sa Jerusalem."
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Mangangaral 1:2",
              "text": "Walang kabuluhan ng mga walang kabuluhan, sabi ng Mangangaral; walang kabuluhan ng mga walang kabuluhan, lahat ay walang kabuluhan."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Mangangaral 1:3",
              "text": "Anong pakinabang mayroon ang tao sa lahat ng kaniyang gawa, na kaniyang ginagawa sa ilalim ng araw?"
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Mangangaral 1:4",
              "text": "Isang salin ng lahi ay yumayaon, at ibang salin ng lahi ay dumarating; nguni't ang lupa ay nananatili magpakailan man."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Mangangaral 1:5",
              "text": "Ang araw naman ay sumisikat, at ang araw ay lumulubog, at nagmamadali sa dakong sinisikatan nito."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Mangangaral 1:6",
              "text": "Ang hangin ay yumayaon sa dakong timugan, at pumipihit sa hilagaan: at laging pumipihit na patuloy, at ang hangin ay bumabalik uli ayon sa kaniyang pihit."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Mangangaral 1:7",
              "text": "Lahat ng mga ilog ay humuhugos sa dagat, gayon may hindi napupuno ang dagat; sa dakong hinuhugusan ng mga ilog, doon din nagsisihugos uli ang mga yaon."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Mangangaral 1:8",
              "text": "Lahat ng mga bagay ay puspos ng pagaalapaap; hindi maisasaysay ng tao: ang mata ay hindi nasisiyahan ng pagtingin, ni ang tainga man ay nasisiyahan sa pakikinig."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Mangangaral 1:9",
              "text": "Yaong nangyari ay siyang mangyayari; at yaong nagawa ay siyang magagawa: at walang bagong bagay sa ilalim ng araw."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Mangangaral 1:10",
              "text": "May bagay ba na masasabi ang mga tao, Tingnan mo, ito'y bago? nayari nga sa mga panahon na una sa atin."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Mangangaral 1:11",
              "text": "Walang alaala sa mga dating lahi; ni magkakaroon man ng alaala sa mga huling salin ng lahi na darating, sa mga yaon na darating pagkatapos."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Mangangaral 1:12",
              "text": "Akong Mangangaral ay naging hari sa Israel sa Jerusalem."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Mangangaral 1:13",
              "text": "At inihilig ko ang aking puso na hanapin at siyasatin sa pamamagitan ng karunungan ang lahat na nagawa sa silong ng langit: mahirap na pagdaramdam na ito ang ibinigay ng Dios sa mga anak ng mga tao, upang pagsanayan."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Mangangaral 1:14",
              "text": "Aking nakita ang lahat na gawa, na nagawa sa ilalim ng araw; at, narito, lahat ay walang kabuluhan at nauuwi sa wala."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Mangangaral 1:15",
              "text": "Ang baluktot ay hindi matutuwid: at ang kulang ay hindi mabibilang."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Mangangaral 1:16",
              "text": "Ako'y sumangguni sa aking sariling puso, na sinasabi ko, Narito, nagtamo ako sa akin ng malaking karunungan ng higit kay sa lahat na nauna sa akin sa Jerusalem: oo, ang puso ko'y nagtaglay ng malaking kabihasnan sa karunungan at kaalaman."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Mangangaral 1:17",
              "text": "At inihilig ko ang aking puso na makaalam ng karunungan, at makaalam ng kaululan at ng kamangmangan: aking nahalata na ito man ay nauuwi sa wala."
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Mangangaral 1:18",
              "text": "Sapagka't sa maraming karunungan at maraming kapanglawan: at siyang nananagana sa kaalaman ay nananagana sa kapanglawan."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Mangangaral 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Mangangaral 2:1",
              "text": "Sinabi ko sa aking puso: Pumarito ka ngayon, Susubukin kitang may kasayahan; kaya't magsawa ka sa kalayawan: at narito, ito rin ay walang kabuluhan."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Mangangaral 2:2",
              "text": "Aking sinabi tungkol sa tawa, Ito'y ulol: at sa kasayahan, Anong ginagawa nito?"
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Mangangaral 2:3",
              "text": "Aking siniyasat sa aking puso na kung paanong masasayahan ang aking katawan sa pamamagitan ng alak, pinapatnubayan pa ng karunungan ang aking puso at kung paanong hahawak sa kamangmangan, hanggang sa aking makita kung ano ang mabuti sa mga anak ng mga tao na marapat nilang gawin sa silong ng langit sa lahat ng mga kaarawan ng kanilang buhay."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Mangangaral 2:4",
              "text": "Gumawa ako sa ganang akin ng mga malaking gawa; nagtayo ako sa ganang akin ng mga bahay; nagtanim ako sa ganang akin ng mga ubasan;"
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Mangangaral 2:5",
              "text": "Gumawa ako sa ganang akin ng mga halamanan at mga liwasan, at aking tinamnan ng mga sarisaring puno ng kahoy na nagkakabunga:"
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Mangangaral 2:6",
              "text": "Gumawa ako sa ganang akin ng mga tipunan ng tubig, upang dumilig ng gubat na pagtatamnan ng mga puno ng kahoy:"
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Mangangaral 2:7",
              "text": "Ako'y bumili ng mga aliping lalake at babae, at nagkaroon ako ng mga aliping ipinanganak sa aking bahay; nagkaroon din naman ako ng mga malaking pag-aari na mga bakahan at mga kawan, ng higit kay sa lahat na nauna sa akin sa Jerusalem:"
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Mangangaral 2:8",
              "text": "Nagtipon din ako sa ganang akin ng pilak at ginto, at ng tanging kayamanan ng mga hari at ng mga lalawigan: nagtatangkilik ako sa akin ng mga lalaking mangaawit at mga babaing mangaawit, at ng mga kalayawan ng mga anak ng mga tao, mga sarisaring instrumento ng musiko iya'y totoong marami."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Mangangaral 2:9",
              "text": "Sa gayo'y naging dakila ako, at lumago ako ng higit kay sa lahat na nauna sa akin sa Jerusalem: ang akin namang karunungan ay namamalagi sa akin."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Mangangaral 2:10",
              "text": "At anomang ninasa ng aking mga mata ay hindi ko ipinagkait: hindi ko pinigil ang aking puso sa anomang kagalakan, sapagka't nagagalak ang aking puso dahil sa lahat kong gawain; at ito ang aking bahagi na mula sa lahat kong gawain."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Mangangaral 2:11",
              "text": "Nang magkagayo'y minasdan ko ang lahat ng mga gawa, na ginawa ng aking mga kamay, at ang gawain na aking pinagsikapang gawin; at, narito, lahat ay walang kabuluhan at nauuwi sa wala, at walang pakinabang sa ilalim ng araw."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Mangangaral 2:12",
              "text": "At ako'y pumihit upang masdan ang karunungan, at ang kaululan at ang kamangmangan; sapagka't ano ang magagawa ng tao na sumusunod sa hari? samakatuwid baga'y ang nagawa na laong panahon ng nakaraan."
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Mangangaral 2:13",
              "text": "Nang magkagayo'y aking nakita, na ang karunungan ay humihigit sa kamangmangan, na gaya ng liwanag na humihigit sa dilim."
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Mangangaral 2:14",
              "text": "Ang mga mata ng pantas ay na sa kaniyang ulo, at ang mangmang ay lumalakad sa kadiliman: at gayon ma'y aking namalas na isang pangyayari ang nangyari sa kanilang lahat."
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Mangangaral 2:15",
              "text": "Nang magkagayo'y sinabi ko sa puso ko, Kung ano ang nangyari sa mangmang gayon ang mangyayari sa akin; at bakit pa nga ako naging lalong pantas? Nang magkagayo'y sinabi ko sa puso ko, na ito man ay walang kabuluhan."
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Mangangaral 2:16",
              "text": "Sapagka't kung paano sa pantas ay gayon din sa mangmang, walang alaala magpakailan man; dangang sa mga araw na darating ay malilimutang lahat na. At kung paanong ang pantas ay namamatay ay gayon ang mangmang!"
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Mangangaral 2:17",
              "text": "Sa gayo'y ipinagtanim ko ang buhay; sapagka't ang gawa na ginawa sa ilalim ng araw ay mapanglaw sa akin: sapagka't lahat ay walang kabuluhan at nauuwi sa wala."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "Mangangaral 2:18",
              "text": "At ipinagtanim ko ang lahat kong gawa na aking ginawa sa ilalim ng araw: yamang marapat kong iwan sa tao na susunod sa akin."
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "Mangangaral 2:19",
              "text": "At sinong nakakaalam kung siya'y magiging isang pantas o isang mangmang? gayon ma'y magpupuno siya sa lahat ng aking gawa, na aking ginawa, at sa aking pinagpakitaan ng karunungan sa ilalim ng araw. Ito man ay walang kabuluhan."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "Mangangaral 2:20",
              "text": "Kaya't ako'y bumalik upang aking alisan ng pagasa ang aking puso tungkol sa lahat na gawa na aking ginawa sa ilalim ng araw."
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "Mangangaral 2:21",
              "text": "Sapagka't may tao, na ang gawa ay sa pamamagitan ng karunungan, at ng kaalaman, at ng kabihasnan; gayon ma'y sa tao na hindi gumawa niyaon ay iiwan niya na pinakabahagi niyaon. Ito man ay walang kabuluhan at malaking kasamaan."
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "Mangangaral 2:22",
              "text": "Sapagka't ano ang tinatamo ng tao sa lahat niyang gawa, at sa nais ng kaniyang puso na kaniyang iginawa sa ilalim ng araw?"
            },
            {
              "chapter": 2,
              "verse": 23,
              "name": "Mangangaral 2:23",
              "text": "Sapagka't lahat niyang kaarawan ay mga kapanglawan lamang, at ang kaniyang pagdaramdam ay hapis; oo, pati sa gabi ay hindi nagpapahinga ang kaniyang puso. Ito man ay walang kabuluhan."
            },
            {
              "chapter": 2,
              "verse": 24,
              "name": "Mangangaral 2:24",
              "text": "Walang maigi sa tao kundi ang kumain at uminom, at pagalaking mabuti ang kaniyang kaluluwa sa kaniyang gawa. Ito man ay aking nakita na mula sa kamay ng Dios."
            },
            {
              "chapter": 2,
              "verse": 25,
              "name": "Mangangaral 2:25",
              "text": "Sapagka't sinong makakakain, o sinong makapagtataglay ng kagalakang higit kay sa akin?"
            },
            {
              "chapter": 2,
              "verse": 26,
              "name": "Mangangaral 2:26",
              "text": "Sapagka't ang tao na kinaluluguran niya, binibigyan ng Dios ng karunungan, at kaalaman, at kagalakan: nguni't ang makasalanan ay binibigyan niya ng damdam, na magpisan at magbunton, upang maibigay sa kaniya na kinaluluguran ng Dios. Ito man ay walang kabuluhan at nauuwi sa wala."
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Mangangaral 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Mangangaral 3:1",
              "text": "Sa bawa't bagay ay may kapanahunan, at panahon sa bawa't panukala sa silong ng langit:"
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Mangangaral 3:2",
              "text": "Panahon ng kapanganakan, at panahon ng kamatayan; panahon ng pagtatanim, at panahon ng pagbunot ng itinanim;"
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Mangangaral 3:3",
              "text": "Panahon ng pagpatay, at panahon ng pagpapagaling; panahon ng paggiba, at panahon ng pagtatayo;"
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Mangangaral 3:4",
              "text": "Panahon ng pagiyak, at panahon ng pagtawa; panahon ng pagtangis, at panahon ng pagsayaw;"
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Mangangaral 3:5",
              "text": "Panahon ng paghahagis ng mga bato, at panahon ng pagpipisan ng mga bato; panahon ng pagyakap, at panahon ng pagpipigil sa pagyakap;"
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Mangangaral 3:6",
              "text": "Panahon ng paghanap, at panahon ng pagkawala: panahon ng pagiingat, at panahon ng pagtatapon;"
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Mangangaral 3:7",
              "text": "Panahon ng pagpunit, at panahon ng pananahi; panahon ng pagtahimik, at panahon ng pagsasalita;"
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Mangangaral 3:8",
              "text": "Panahon ng pagibig, at panahon ng pagtatanim; panahon ng digma, at panahon ng kapayapaan."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Mangangaral 3:9",
              "text": "Anong pakinabang ang tinatamo niya, na gumagawa sa kaniyang pinagpapagalan?"
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Mangangaral 3:10",
              "text": "Aking nakita ang sakit na ibinigay ng Dios sa mga anak ng mga tao upang pagsanayan."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Mangangaral 3:11",
              "text": "Ginawa niya ang bawa't bagay na maganda sa kapanahunan niyaon: inilagay rin niya ang sanglibutan sa kanilang puso, na anopa't hindi matalos ng tao ang gawa na ginawa ng Dios mula sa pasimula hanggang sa wakas."
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Mangangaral 3:12",
              "text": "Nalalaman ko, na walang maigi sa kanila, kay sa magalak, at gumawa ng mabuti habang sila'y nabubuhay."
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Mangangaral 3:13",
              "text": "At ang bawa't tao rin naman ay marapat kumain at uminom, at magalak sa kabutihan sa lahat niyang gawa, siyang kaloob ng Dios."
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Mangangaral 3:14",
              "text": "Nalalaman ko, na anomang ginagawa ng Dios, magiging magpakailan pa man: walang bagay na maidadagdag, o anomang bagay na maaalis: at ginawa ng Dios, upang ang tao ay matakot sa harap niya."
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Mangangaral 3:15",
              "text": "Ang nangyari sa nagdaan ay nangyari na; at ang mangyayari pa ay nangyari na rin; at hinahanap uli ng Dios ang nakaraan na."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Mangangaral 3:16",
              "text": "At bukod dito'y aking nakita sa ilalim ng araw, sa dako ng kahatulan, na nandoon ang kasamaan; at sa dako ng katuwiran, na nandoon ang kasamaan."
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Mangangaral 3:17",
              "text": "Sinabi ko sa puso ko, Hahatulan ng Dios ang matuwid at ang masama: sapagka't may panahon doon sa bawa't panukala at sa bawa't gawa."
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "Mangangaral 3:18",
              "text": "Sinabi ko sa puso ko, Dahil sa mga anak ng mga tao, upang subukin sila ng Dios, at upang kanilang makita na sila'y mga hayop lamang."
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "Mangangaral 3:19",
              "text": "Sapagka't ang nangyayari sa mga anak ng mga tao ay nangyayari sa mga hayop: sa makatuwid baga'y isang bagay ang nangyari sa kanila: kung paanong namamatay ang hayop, gayon namamatay ang tao; oo, silang lahat ay may isang hininga; at ang tao ay wala ng karangalang higit sa hayop: sapagka't lahat ay walang kabuluhan."
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "Mangangaral 3:20",
              "text": "Lahat ay nagsisiyaon sa isang dako; lahat ay buhat sa alabok, at lahat ay nangauuwi sa alabok uli."
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Mangangaral 3:21",
              "text": "Sinong nakakaalam ng diwa ng tao kung napaiilanglang, at ng diwa ng hayop kung napaiibaba sa lupa?"
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Mangangaral 3:22",
              "text": "Kaya't aking nakita, na walang bagay na maigi, kundi ang tao ay magalak sa kaniyang mga gawa; sapagka't siyang kaniyang bahagi: sapagka't sinong magbabalik sa kaniya upang makita ang mangyayari pagkamatay niya?"
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Mangangaral 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Mangangaral 4:1",
              "text": "Nang magkagayo'y pumihit ako, at aking nakita ang lahat na kapighatian na nagawa sa ilalim ng araw: at, narito, ang mga luha ng mga yaon, na napipighati, at wala silang mangaaliw: at sa siping ng mga mamimighati sa kanila ay may kapangyarihan, nguni't wala silang mangaaliw."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Mangangaral 4:2",
              "text": "Kaya't aking pinuri ang patay na namatay na, ng higit kay sa may buhay na nabubuhay pa;"
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Mangangaral 4:3",
              "text": "Oo, maigi kay sa kanila kapuwa ang hindi ipinanganganak, na hindi nakakita ng masamang gawa na nagawa sa ilalim ng araw."
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Mangangaral 4:4",
              "text": "Nang magkagayo'y nakita ko ang lahat na gawa, at bawa't gawang mainam na dahil dito ay pinananaghilian ang tao ng kaniyang kapuwa. Ito man ay walang kabuluhan at nauuwi sa wala."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Mangangaral 4:5",
              "text": "Inihahalukipkip ng mangmang ang kaniyang mga kamay, at kumakain ng kaniyang sariling laman."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Mangangaral 4:6",
              "text": "Maigi ang isang dakot na may katahimikan, kay sa dalawang dakot na may kahirapan at walang kabuluhan."
            },
            {
              "chapter": 4,
              "verse": 7,
              "name": "Mangangaral 4:7",
              "text": "Nang magkagayo'y bumalik ako at aking nakita ang walang kabuluhan sa ilalim ng araw."
            },
            {
              "chapter": 4,
              "verse": 8,
              "name": "Mangangaral 4:8",
              "text": "May isa na nagiisa, at siya'y walang pangalawa; oo, siya'y walang anak o kapatid man; gayon ma'y walang wakas sa lahat niyang gawa, ni nasisiyahan man ang kaniyang mga mata sa mga kayamanan. Dahil kanino nga, sabi niya, nagpapagal ako, at binabawahan ko ang aking kaluluwa ng mabuti? Ito man ay walang kabuluhan, oo, mahirap na damdam."
            },
            {
              "chapter": 4,
              "verse": 9,
              "name": "Mangangaral 4:9",
              "text": "Dalawa ay maigi kay sa isa; sapagka't sila'y may mabuting kagantihan sa kanilang gawa."
            },
            {
              "chapter": 4,
              "verse": 10,
              "name": "Mangangaral 4:10",
              "text": "Sapagka't kung sila'y mabuwal, ibabangon ng isa ang kaniyang kasama; nguni't sa aba niya, na nagiisa pagka siya'y nabuwal, at walang iba na magbangon sa kaniya."
            },
            {
              "chapter": 4,
              "verse": 11,
              "name": "Mangangaral 4:11",
              "text": "Muli, kung ang dalawa ay mahigang magkasama, may init nga sila: nguni't paanong makapagpapainit ang isa na nagiisa?"
            },
            {
              "chapter": 4,
              "verse": 12,
              "name": "Mangangaral 4:12",
              "text": "At kung ang isang tao ay manaig laban sa kaniya na nagiisa, ang dalawa ay makalalaban sa kaniya; at ang panaling tatlong ikid ay hindi napapatid na madali."
            },
            {
              "chapter": 4,
              "verse": 13,
              "name": "Mangangaral 4:13",
              "text": "Maigi ang dukha at pantas na bata kay sa matanda at mangmang na hari, na hindi nakakaalam ng pagtanggap ng payo pa."
            },
            {
              "chapter": 4,
              "verse": 14,
              "name": "Mangangaral 4:14",
              "text": "Sapagka't mula sa bilangguan ay lumabas siya upang maghari; oo, sa kaniyang kaharian nga ay ipinanganak siyang dukha."
            },
            {
              "chapter": 4,
              "verse": 15,
              "name": "Mangangaral 4:15",
              "text": "Aking nakita ang lahat na may buhay, na nagsisilakad sa ilalim ng araw, na sila'y kasama ng bata, ng ikalawa, na tumatayo na kahalili niya."
            },
            {
              "chapter": 4,
              "verse": 16,
              "name": "Mangangaral 4:16",
              "text": "Walang wakas sa lahat ng bayan, sa makatuwid baga'y sa lahat na pinaghaharian niya: gayon ma'y silang darating pagkatapos ay hindi mangagagalak sa kaniya.Tunay na ito man ay walang kabuluhan at nauuwi sa wala."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Mangangaral 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Mangangaral 5:1",
              "text": "Ingatan mo ang iyong paa pagka ikaw ay napasasa bahay ng Dios; sapagka't ang paglapit upang makinig ay maigi kay sa magbigay ng hain ng mga mangmang: sapagka't hindi nila nalalaman na sila'y nagsisigawa ng kasamaan."
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Mangangaral 5:2",
              "text": "Huwag kang pakabigla ng iyong bibig, at huwag magmadali ang iyong puso na magsalita ng anomang bagay sa harap ng Dios; sapagka't ang Dios ay nasa langit, at ikaw ay nasa lupa: kaya't pakauntiin mo ang iyong mga salita."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Mangangaral 5:3",
              "text": "Sapagka't ang panaginip ay dumarating sa karamihan ng gawain; at ang tinig ng mangmang sa karamihan ng mga salita."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Mangangaral 5:4",
              "text": "Pagka ikaw ay nananata ng panata sa Dios, huwag kang magliban ng pagtupad; sapagka't siya'y walang kaligayahan sa mga mangmang: tuparin mo ang iyong ipinanata."
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Mangangaral 5:5",
              "text": "Maigi nga ang ikaw ay huwag manata, kay sa ikaw ay manata at hindi tumupad."
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Mangangaral 5:6",
              "text": "Huwag bayaan ang iyong bibig, na papagkasalanin ang iyong laman; at huwag ka mang magsabi sa harap ng anghel, na isang kamalian: bakit nga magagalit ang Dios sa iyong tinig, at sisirain ang gawa ng iyong mga kamay?"
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Mangangaral 5:7",
              "text": "Sapagka't sa karamihan ng mga panaginip ay may kawalangkabuluhan, at sa maraming mga salita: nguni't matakot ka sa Dios."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Mangangaral 5:8",
              "text": "Kung iyong nakikita ang kapighatian ng dukha, at ang karahasang pagaalis ng kahatulan at kaganapan sa isang lalawigan, huwag mong kamanghaan ang bagay: sapagka't ang lalong mataas kay sa mataas ay nagmamasid; at may lalong mataas kay sa kanila."
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Mangangaral 5:9",
              "text": "Bukod dito, ay sa lahat ang pakinabang sa lupa: ang hari man ay pinaglilingkuran ng bukid."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Mangangaral 5:10",
              "text": "Siyang umiibig sa pilak ay hindi masisiyahan sa pilak; o siya mang umiibig sa kasaganaan ng pakinabang: ito man ay walang kabuluhan."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Mangangaral 5:11",
              "text": "Pagka ang mga pag-aari ay nagsisidami, ay nagsisidami silang nagsisikain ng mga yaon: at anong pakinabang mayroon ang may-ari niyaon, kundi ang mamasdan ng kaniyang mga mata?"
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Mangangaral 5:12",
              "text": "Ang tulog ng manggagawang tao ay mahimbing, maging siya'y kumain ng kaunti o marami: nguni't ang kasaganaan ng yaman ay hindi magpapatulog sa kaniya."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Mangangaral 5:13",
              "text": "May malubhang kasamaan na aking nakita sa ilalim ng araw, ito nga, ang mga yamang iningatan ng may-ari niyaon sa kapahamakan niya."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Mangangaral 5:14",
              "text": "At ang mga yamang yaon ay nawawala ng masamang pangyayari; at kung siya'y magkaanak ng lalake, walang maiiwan sa kaniyang kamay."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Mangangaral 5:15",
              "text": "Kung paanong siya'y lumabas sa bahay-bata ng kaniyang ina, hubad na yayaon siya uli na gaya ng siya'y dumating, at hindi magdadala ng anoman sa kaniyang nagawa, na kaniyang madadala sa kaniyang kamay."
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Mangangaral 5:16",
              "text": "At ito man ay malubhang kasamaan, na kung paano siya dumating ay gayon siya yayaon: at anong pakinabang mayroon siya, na gumagawa sa hangin?"
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Mangangaral 5:17",
              "text": "Lahat ng mga araw naman niya ay ikinakain niya sa kadiliman, at siya'y totoong nayayamot, at may sakit at pag-iinit."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Mangangaral 5:18",
              "text": "Narito, na aking nakita na mabuti at ukol sa isa ang kumain at uminom, at magalak sa kabutihan sa lahat niyang gawa na kaniyang ginawa sa ilalim ng araw lahat ng mga kaarawan ng kaniyang buhay na ibinigay sa kaniya ng Dios: sapagka't ito'y kaniyang bahagi."
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Mangangaral 5:19",
              "text": "Bawa't tao rin naman na binigyan ng Dios ng mga kayamanan at mga pag-aari, at binigyan ng kapangyarihan na kumain niyaon, at kumuha ng kaniyang bahagi, at magalak sa kaniyang gawa, ito'y kaloob ng Dios."
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Mangangaral 5:20",
              "text": "Sapagka't hindi niya aalalahaning lubha ang mga kaarawan ng kaniyang buhay; sapagka't sinasagot siya ng Dios sa kagalakan ng kaniyang puso."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Mangangaral 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Mangangaral 6:1",
              "text": "May kasamaan na nakita ako sa ilalim ng araw, at mabigat sa mga tao:"
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Mangangaral 6:2",
              "text": "Ang tao na binibigyan ng Dios ng mga kayamanan, pag-aari, at karangalan, na anopa't walang kulang sa kaniyang kaluluwa sa lahat niyang ninanasa, gayon ma'y hindi binibigyan siya ng Dios ng kapangyarihan na kumain niyaon, kundi iba ang kumakain niyaon; ito'y walang kabuluhan, at masamang sakit."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Mangangaral 6:3",
              "text": "Kung ang isang tao ay magkaanak ng isang daan, at mabuhay na maraming taon, na anopa't ang mga kaarawan ng kaniyang mga taon ay dumami, nguni't ang kaniyang kaluluwa ay hindi mabusog ng mabuti, at bukod dito ay wala siyang pangpalibing; aking sinasabing maigi ang isang naagas kay sa kaniya:"
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Mangangaral 6:4",
              "text": "Sapagka't dumarating na walang kabuluhan, at yumayaon sa kadiliman, at ang pangalan niyaon ay natatakpan ng kadiliman;"
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Mangangaral 6:5",
              "text": "Bukod dito ay hindi nakita ang araw o nakilala man; ito'y may kapahingahang maigi kay sa isa;"
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Mangangaral 6:6",
              "text": "Oo, bagaman siya'y mabuhay na isang libong taon na makalawang masaysay, at hindi man nagalak na mabuti: hindi ba nagsisiyaon ang lahat sa iisang dako?"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Mangangaral 6:7",
              "text": "Lahat ng gawa ng tao ay para sa kaniyang bibig, at gayon ma'y ang panglasa ay hindi nasisiyahan."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Mangangaral 6:8",
              "text": "Sapagka't anong pakinabang mayroon ang pantas na higit sa mangmang? o anong pakinabang mayroon ang dukha na maalam lumakad sa harap ng mga buhay?"
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Mangangaral 6:9",
              "text": "Maigi ang paningin ng mga mata kay sa pagdidilidili; ito man ay walang kabuluhan at nauuwi sa wala."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Mangangaral 6:10",
              "text": "Anomang nangyari, ang pangalan niyaon ay natawag nang malaon, at kilala na siya'y tao: ni hindi maaaring makipagtalo siya sa lalong makapangyarihan kay sa kaniya."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Mangangaral 6:11",
              "text": "Yamang maraming bagay na nangagdaragdag ng walang kabuluhan, ano ang lalong ikinaigi ng tao?"
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Mangangaral 6:12",
              "text": "Sapagka't sinong nakakaalam kung ano ang mabuti sa tao sa kaniyang buhay, lahat ng mga kaarawan ng kaniyang walang kabuluhang buhay na kaniyang ginugol na gaya ng anino? sapagka't sinong makapagsasaysay sa tao kung ano ang mangyayari pagkamatay niya sa ilalim ng araw?"
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Mangangaral 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Mangangaral 7:1",
              "text": "Ang mabuting pangalan ay maigi kay sa mahalagang unguento; at ang kaarawan ng kamatayan kay sa kaarawan ng kapanganakan."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Mangangaral 7:2",
              "text": "Maigi ang pasa bahay ng tangisan, kay sa bahay ng pistahan: sapagka't siyang wakas ng lahat ng mga tao; at ilalagak ng may buhay sa kaniyang puso."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Mangangaral 7:3",
              "text": "Kapanglawan ay maigi kay sa pagtawa: sapagka't sa kapanglawan ng mukha ay sumasaya ang puso."
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Mangangaral 7:4",
              "text": "Ang puso ng pantas ay nasa bahay ng tangisan; nguni't ang puso ng mangmang ay nasa bahay ng kasayahan."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Mangangaral 7:5",
              "text": "Maigi ang makinig ng saway ng pantas kay sa isang tao'y makinig ng awit ng mga mangmang."
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Mangangaral 7:6",
              "text": "Sapagka't kung paano ang lagitik ng mga tinik sa ilalim ng palyok, gayon ang tawa ng mangmang: ito ma'y walang kabuluhan."
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Mangangaral 7:7",
              "text": "Tunay na nagpapamangmang sa pantas ang pagkapighati; at ang suhol ay sumisira ng unawa."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Mangangaral 7:8",
              "text": "Maigi ang wakas ng isang bagay kay sa pasimula niyaon: at ang matiising loob ay maigi kay sa palalong loob."
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Mangangaral 7:9",
              "text": "Huwag kang magagalitin sa iyong kalooban: sapagka't ang galit ay nagpapahinga sa sinapupunan ng mga mangmang."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Mangangaral 7:10",
              "text": "Huwag mong sabihin, Ano ang kadahilanan na ang mga unang araw ay maigi kay sa mga ito? sapagka't hindi ka naguusisang may katalinuhan tungkol dito."
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Mangangaral 7:11",
              "text": "Karunungan ay mabuting gaya ng mana: oo, lalong marilag sa ganang kanila na nakakakita ng araw."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Mangangaral 7:12",
              "text": "Sapagka't ang karunungan ay sanggalang, sa makatuwid baga'y gaya ng salapi na sanggalang: nguni't ang karilagan ng kaalaman, ay iniingatan ng karunungan ang buhay niya na nagtatangkilik niyaon."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Mangangaral 7:13",
              "text": "Gunitain mo ang gawa ng Dios: sapagka't sinong makapagtutuwid ng ginawa niyang baluktot?"
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Mangangaral 7:14",
              "text": "Sa kaarawan ng kaginhawahan ay magalak ka, at sa kaarawan ng kahirapan ay gumunita ka: oo, ginawa ng Dios ang isa sa siping ng isa, upang ang tao ay huwag makasumpong ng anomang bagay na mangyayari pagkamatay niya."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Mangangaral 7:15",
              "text": "Lahat ng ito ay nakita ko sa mga kaarawan ng aking walang kabuluhan: may matuwid na namamatay sa kaniyang katuwiran, at may masama na humahaba ang buhay sa kaniyang masamang gawa."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Mangangaral 7:16",
              "text": "Huwag kang lubhang magpakamatuwid; ni huwag ka mang lubhang magpakapantas: bakit sisirain mo ang iyong sarili?"
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Mangangaral 7:17",
              "text": "Huwag kang magpakasamang lubha, ni magpakamangmang man: bakit ka mamamatay bago dumating ang iyong kapanahunan?"
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Mangangaral 7:18",
              "text": "Mabuti na ikaw ay manghawak dito; oo, doon man ay huwag mong iurong ang iyong kamay: sapagka't siyang natatakot sa Dios ay lalayo sa lahat na yaon."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Mangangaral 7:19",
              "text": "Karunungan ay kalakasan sa pantas, na higit kay sa sangpung pinuno na nangasa bayan."
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Mangangaral 7:20",
              "text": "Tunay na walang matuwid sa lupa, na gumagawa ng mabuti, at hindi nagkakasala."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Mangangaral 7:21",
              "text": "Huwag ka rin namang makinig sa lahat ng mga salita na sinasalita, baka marinig mong sinusumpa ka ng iyong alipin:"
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Mangangaral 7:22",
              "text": "Sapagka't madalas ding nalalaman ng iyong sariling puso, na ikaw ay sumumpa rin sa mga iba."
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Mangangaral 7:23",
              "text": "Lahat ng ito ay tinikman ko sa karunungan: aking sinabi, Ako'y magiging pantas: nguni't malayo sa akin."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Mangangaral 7:24",
              "text": "Ang nilikha ay malayo at totoong malalim; sinong makaaabot?"
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "Mangangaral 7:25",
              "text": "Ako'y pumihit at inilagak ang aking puso na umalam, at sumiyasat, at humanap ng karunungan, at ng kadahilanan ng mga bagay, at umalam na ang kasamaan ay kamangmangan, at ang kamangmangan ay kaululan:"
            },
            {
              "chapter": 7,
              "verse": 26,
              "name": "Mangangaral 7:26",
              "text": "At nakasumpong ako ng bagay na lalong mapait kay sa kamatayan, sa makatuwid baga'y ang babae na ang puso ay mga silo at mga bitag, at ang kaniyang mga kamay ay gaya ng mga panali: ang nalulugod sa Dios ay tatakas sa kaniya; nguni't ang makasalanan ay makukuha niya."
            },
            {
              "chapter": 7,
              "verse": 27,
              "name": "Mangangaral 7:27",
              "text": "Narito, ito'y aking nasumpungan, sabi ng Mangangaral, na iniaagapay ang isang bagay sa iba, upang matagpuan ang kadahilanan:"
            },
            {
              "chapter": 7,
              "verse": 28,
              "name": "Mangangaral 7:28",
              "text": "Na hinahanap pa ng aking kaluluwa, nguni't hindi ko nasumpungan: isang tao sa isang libo ang aking nasumpungan; nguni't isang babae sa lahat ng mga yaon ay hindi ko nasumpungan."
            },
            {
              "chapter": 7,
              "verse": 29,
              "name": "Mangangaral 7:29",
              "text": "Narito, ito lamang ang aking nasumpungan, na ginawang matuwid ng Dios ang tao; nguni't nagsihanap sila ng maraming katha."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Mangangaral 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Mangangaral 8:1",
              "text": "Sino ang gaya ng pantas na lalake? at sinong nakakaalam ng kahulugan ng isang bagay? Ang karunungan ng tao ay nagpapasilang ng kaniyang mukha, at ang katigasan ng kaniyang mukha ay nababago."
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Mangangaral 8:2",
              "text": "Ipinapayo ko sa iyo, ingatan mo ang utos ng hari, at siya'y dahil sa sumpa ng Dios."
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Mangangaral 8:3",
              "text": "Huwag kang magmadaling umalis sa kaniyang harapan; huwag kang mamalagi sa masamang bagay: sapagka't kaniyang ginagawa ang anomang kaniyang kalugdan."
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Mangangaral 8:4",
              "text": "Sapagka't ang salita ng hari ay may kapangyarihan; at sinong makapagsasabi sa kaniya, Anong ginagawa mo?"
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Mangangaral 8:5",
              "text": "Ang nagiingat ng utos ay hindi makakaalam ng masamang bagay; at ang puso ng pantas ay nagbubulay ng panahon at kahatulan:"
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Mangangaral 8:6",
              "text": "Sapagka't sa bawa't panukala ay may kapanahunan at kahatulan; sapagka't ang karalitaan ng tao ay malaki sa kaniya:"
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Mangangaral 8:7",
              "text": "Sapagka't hindi niya nalalaman ang mangyayari; sapagka't sinong makapagsasaysay sa kaniya, kung paanong mangyayari?"
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Mangangaral 8:8",
              "text": "Walang tao na may kapangyarihan sa diwa upang pumigil ng diwa; ni walang kapangyarihan siya sa kaarawan ng kamatayan; at walang dahilan sa pakikipagpunyaging yaon: ni maililigtas siya ng kasamaan, na taglay niya."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Mangangaral 8:9",
              "text": "Lahat ng ito ay nakita ko, at inihilig ko ang aking puso sa bawa't gawa, na nagawa sa ilalim ng araw: may panahon na ang isa ay may kapangyarihan sa isa sa kaniyang kapahamakan."
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Mangangaral 8:10",
              "text": "At gayon din nakita ko ang masama na nakalibing, at nagsidating sa hukay; at silang nagsigawa ng matuwid ay nagsialis sa dakong banal, at nalimutan sa bayan: ito man ay walang kabuluhan."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Mangangaral 8:11",
              "text": "Sapagka't ang hatol laban sa masamang gawa ay hindi isinasagawa agad, kaya't ang puso ng mga anak ng mga tao ay lubos na nangalalagak sa paggawa ng kasamaan."
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Mangangaral 8:12",
              "text": "Bagaman ang makasalanan ay gumawa ng kasamaan na makaisang daan, at humaba ang kaniyang buhay, gayon ma'y tunay, na talastas ko, na ikabubuti nilang nangatatakot sa Dios, na nangatatakot sa harap niya:"
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Mangangaral 8:13",
              "text": "Nguni't hindi ikabubuti ng masama, ni hahaba man ang kaniyang buhay na parang isang anino; sapagka't siya'y hindi natatakot sa harap ng Dios."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Mangangaral 8:14",
              "text": "May walang kabuluhan na nangyayari sa lupa; na may mga matuwid na tao na kinapapangyarihan ng ayon sa gawa ng masama; muli, may mga masamang tao na kinapapangyarihan ng ayon sa gawa ng matuwid; aking sinabi, na ito man ay walang kabuluhan."
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Mangangaral 8:15",
              "text": "Nang magkagayo'y pinuri ko ang kalayawan, sapagka't ang tao ay walang maiging bagay sa ilalim ng araw, kundi ang kumain, at uminom, at magsaya: sapagka't tatahang kasama niya sa kaniyang gawa lahat ng mga kaarawan ng kaniyang buhay na ibinigay ng Dios sa kaniya sa ilalim ng araw."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Mangangaral 8:16",
              "text": "Nang aking ikiling ang aking puso upang makaalam ng karunungan, at upang makakita ng gawain na ginagawa sa lupa: (sapagka't may hindi nakakakita ng tulog ng kahit araw o gabi man ng kaniyang mga mata:)"
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Mangangaral 8:17",
              "text": "Namasdan ko nga ang lahat ng gawa ng Dios, na hindi matalastas ng tao ang gawa na ginagawa sa ilalim ng araw: sapagka't sikaping mainam man ng tao na hanapin, ay hindi rin masusumpungan; oo, bukod dito, bagaman isipin ng pantas na maalaman hindi rin niya masusumpungan."
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Mangangaral 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Mangangaral 9:1",
              "text": "Sapagka't lahat ng ito ay inilagak ko sa aking puso, upang siyasatin ang lahat ng ito; na ang matuwid, at ang pantas, at ang kanilang mga gawa, ay nangasa kamay ng Dios: maging pagibig o pagtatanim hindi nalalaman ng tao; lahat ay nangasa harap nila."
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Mangangaral 9:2",
              "text": "Lahat ng mga bagay ay nagsisidating na parapara sa lahat: may isang pangyayari sa matuwid at sa masama; sa mabuti, at sa malinis, at sa marumi; sa kaniyang naghahain at sa kaniyang hindi naghahain: kung paano ang mabuti, gayon ang makasalanan; at ang sumusumpa, gaya ng natatakot sa sumpa."
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Mangangaral 9:3",
              "text": "Ito'y isang kasamaan sa lahat na nalikha sa ilalim ng araw, na may isang pangyayari sa lahat: oo, gayon din, ang puso ng mga anak ng mga tao ay puspos ng kasamaan, at kaululan ang nasa kanilang puso habang sila'y nangabubuhay, at pagkatapos niyaon ay napatutungo sa pagkamatay."
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Mangangaral 9:4",
              "text": "Sapagka't sa kaniya, na napisan sa lahat na may buhay ay may pagasa: sapagka't ang buhay na aso ay maigi kay sa patay na leon."
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Mangangaral 9:5",
              "text": "Sapagka't nalalaman ng mga buhay, na sila'y mangamamatay: nguni't hindi nalalaman ng patay ang anomang bagay ni mayroon pa man silang kagantihan; sapagka't ang alaala sa kanila ay nakalimutan."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Mangangaral 9:6",
              "text": "Maging ang kanilang pagibig, gaya ng kanilang pagtatanim at ng kanilang pananaghili ay nawala ngayon; na wala man silang anomang bahagi pa na magpakailan man sa anomang bagay na nagawa sa ilalim ng araw."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Mangangaral 9:7",
              "text": "Yumaon ka ng iyong lakad, kumain ka ng iyong tinapay na may kagalakan, at uminom ka ng iyong alak na may masayang puso; sapagka't tinanggap na ng Dios ang iyong mga gawa."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Mangangaral 9:8",
              "text": "Maging maputing lagi ang iyong mga suot; at huwag magkulang ng unguento ang iyong ulo."
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Mangangaral 9:9",
              "text": "Ikaw ay mabuhay na masaya na kalakip ng asawa na iyong iniibig sa lahat ng mga kaarawan ng buhay ng iyong walang kabuluhan, na kaniyang ibinigay sa iyo sa ilalim ng araw, lahat ng mga kaarawan ng iyong walang kabuluhan: sapagka't iyan ang iyong bahagi sa buhay, at sa iyong gawa na iyong ginagawa sa ilalim ng araw."
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Mangangaral 9:10",
              "text": "Anomang masumpungang gawain ng iyong kamay, gawin mo ng iyong kapangyarihan; sapagka't walang gawa, ni katha man, ni kaalaman man, ni karunungan man, sa Sheol, na iyong pinaparunan."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Mangangaral 9:11",
              "text": "Ako'y bumalik, at nakita ko sa ilalim ng araw, na ang paguunahan ay hindi sa mga matulin, ni ang pagbabaka man ay sa mga malakas, ni sa mga pantas man ang tinapay, ni ang mga kayamanan man ay sa mga taong naguunawa, ni ang kaloob man ay sa taong matalino; kundi ang panahon at kapalaran ay mangyayari sa kanilang lahat."
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Mangangaral 9:12",
              "text": "Sapagka't hindi rin nalalaman ng tao ang kaniyang kapanahunan: kung paano ang mga isda na nahuhuli sa masamang lambat, at kung paano ang mga ibon na nahuhuli sa bitag, gayon ang mga anak ng mga tao, ay nasisilo sa masamang kapanahunan, pagka biglang nahuhulog sa kanila."
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Mangangaral 9:13",
              "text": "Nakita ko rin ang karunungan sa ilalim ng araw, sa ganitong anyo, at naging tila dakila sa akin:"
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Mangangaral 9:14",
              "text": "Nagkaroon ng maliit na bayan, at iilan ang tao sa loob niyaon; at may dumating na dakilang hari laban doon, at kumubkob, at nagtayo ng mga malaking tanggulan laban doon:"
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Mangangaral 9:15",
              "text": "May nasumpungan nga roong isang dukhang pantas na lalake, at iniligtas niya ng kaniyang karunungan ang bayan; gayon ma'y walang umalaala sa dukhang lalaking yaon."
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Mangangaral 9:16",
              "text": "Nang magkagayo'y sinabi ko, Karunungan ay maigi kay sa kalakasan: gayon ma'y karunungan ng dukhang taong yaon ay hinamak, at ang kaniyang mga salita ay hindi dinidinig."
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Mangangaral 9:17",
              "text": "Ang mga salita ng pantas na sinalitang marahan ay narinig na higit kay sa hiyaw ng nagpupuno sa mga mangmang."
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Mangangaral 9:18",
              "text": "Karunungan ay maigi kay sa mga sandata sa pakikipagdigma: nguni't ang isang makasalanan ay sumisira ng maraming mabuti."
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Mangangaral 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Mangangaral 10:1",
              "text": "Ang mga patay na langaw ay nagpapabaho sa unguento ng manggagawa ng pabango: gayon ang munting kamangmangan ay sumisira ng karunungan at karangalan."
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Mangangaral 10:2",
              "text": "Ang puso ng pantas na tao ay nasa kaniyang kanang kamay; nguni't ang puso ng mangmang ay sa kaniyang kaliwa."
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Mangangaral 10:3",
              "text": "Oo gayon din, pagka ang mangmang ay lumalakad sa daan, ay nawawalan siya ng bait, at kaniyang sinasabi sa bawa't isa, na siya'y isang ulol."
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Mangangaral 10:4",
              "text": "Kung ang diwa ng pinuno ay bumangon laban sa iyo, huwag kang umalis: sapagka't ang pagpapakalumanay ay nagpapalikat ng mga malaking pagkagalit."
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Mangangaral 10:5",
              "text": "May isang kasamaan, na nakita ko sa ilalim ng araw na tila kamalian na nanggagaling sa pinuno:"
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Mangangaral 10:6",
              "text": "Ang mangmang ay nauupo sa malaking karangalan, at ang mayaman ay nauupo sa mababang dako."
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Mangangaral 10:7",
              "text": "Nakakita ako ng mga alipin na nakasakay sa mga kabayo, at ng mga pangulo na nagsisilakad sa lupa na gaya ng mga alipin."
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Mangangaral 10:8",
              "text": "Siyang humuhukay ng lungaw ay mahuhulog doon: at ang sumisira sa pader, ay kakagatin siya ng ahas."
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Mangangaral 10:9",
              "text": "Ang tumatabas ng mga bato ay masasaktan niyaon; at ang pumapalakol ng kahoy ay napapanganib doon."
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Mangangaral 10:10",
              "text": "Kung ang bakal ay pumurol, at hindi ihasa ninoman ang talim, marapat nga niyang gamitan ng lalong kalakasan: nguni't ang karunungan ay pinakikinabangang magturo."
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Mangangaral 10:11",
              "text": "Kung ang ahas ay kumagat bago maenkanto, wala ngang kapakinabangan sa mangeenkanto."
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Mangangaral 10:12",
              "text": "Ang mga salita ng bibig ng pantas ay mapagbiyaya; nguni't ang mga labi ng mangmang ay lalamon sa kaniyang sarili."
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Mangangaral 10:13",
              "text": "Ang pasimula ng mga salita ng kaniyang bibig ay kamangmangan: at ang wakas ng kaniyang salita ay makamandag na kaululan."
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Mangangaral 10:14",
              "text": "Ang mangmang din naman ay nagpaparami ng mga salita: gayon ma'y hindi nalalaman ng tao kung ano ang mangyayari; at ang mangyayari pagkamatay niya, sinong makapagsasaysay sa kaniya?"
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Mangangaral 10:15",
              "text": "Ang gawa ng mga mangmang ay nagpapayamot sa bawa't isa sa kanila; sapagka't hindi niya nalalaman kung paanong pagparoon sa bayan."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Mangangaral 10:16",
              "text": "Sa aba mo, Oh lupain, kung ang iyong hari ay isang bata, at ang iyong mga pangulo ay nagsisikain sa umaga!"
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Mangangaral 10:17",
              "text": "Mapalad ka, Oh lupain, kung ang iyong hari ay anak ng mga mahal na tao, at ang iyong mga pangulo ay nagsisikain sa kaukulang panahon, sa ikalalakas, at hindi sa paglalasing!"
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Mangangaral 10:18",
              "text": "Sa katamaran ay gumuguho ang bubungan; at di sa pagkilos ng mga kamay ay tumutulo ang bahay."
            },
            {
              "chapter": 10,
              "verse": 19,
              "name": "Mangangaral 10:19",
              "text": "Ang kapistahan ay ginagawa sa ikapagtatawa, at ang alak ay nagpapasaya sa buhay: at ang salapi ay sumasagot sa lahat ng mga bagay."
            },
            {
              "chapter": 10,
              "verse": 20,
              "name": "Mangangaral 10:20",
              "text": "Huwag mong sumpain ang hari, huwag, huwag sa iyong pagiisip; at huwag mong sumpain ang mayaman sa iyong silid na tulugan: sapagka't isang ibon sa himpapawid ay magdadala ng tinig, at ang may mga pakpak ay magsasaysay ng bagay."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Mangangaral 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Mangangaral 11:1",
              "text": "Ihasik mo ang iyong tinapay sa tubigan: sapagka't iyong masusumpungan pagkaraan ng maraming araw."
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Mangangaral 11:2",
              "text": "Magbigay ka ng bahagi sa pito, oo, sa walo; sapagka't hindi mo nalalaman kung anong kasamaan ang mangyayari sa lupa."
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Mangangaral 11:3",
              "text": "Kung ang mga alapaap ay mapuno ng ulan, ay tumutulo sa lupa: at kung ang punong kahoy ay mabuwal sa dakong timugan, o sa dakong hilagaan sa dakong kabuwalan ng kahoy, ay doon ito mamamalagi."
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Mangangaral 11:4",
              "text": "Ang nagmamalas sa hangin ay hindi maghahasik; at ang tumitingin sa mga alapaap ay hindi aani."
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Mangangaral 11:5",
              "text": "Kung paanong hindi mo nalalaman kung ano ang daan ng hangin o kung paano mang lumalaki ang mga buto sa bahay-bata ng buntis; gayon hindi mo nalalaman ang gawa ng Dios na gumagawa sa lahat."
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Mangangaral 11:6",
              "text": "Ihasik mo sa umaga ang iyong binhi, at huwag mong iurong ang iyong kamay sa hapon; sapagka't hindi mo nalalaman kung alin ang tutubo, kung ito o yaon, o kung kapuwa magiging mabuti."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Mangangaral 11:7",
              "text": "Tunay na ang liwanag ay mainam, at masayang bagay sa mga mata na magsitingin sa araw."
            },
            {
              "chapter": 11,
              "verse": 8,
              "name": "Mangangaral 11:8",
              "text": "Oo, kung ang tao ay mabuhay ng maraming taon, magalak siya sa lahat ng yaon; nguni't alalahanin niya ang mga kaarawan ng kadiliman, sapagka't magiging marami. Lahat ng dumarating ay walang kabuluhan."
            },
            {
              "chapter": 11,
              "verse": 9,
              "name": "Mangangaral 11:9",
              "text": "Ikaw ay magalak, Oh binata, sa iyong kabataan: at pasayahin ka ng iyong puso sa mga kaarawan ng iyong kabataan, at lumakad ka ng mga lakad ng iyong kalooban, at sa paningin ng iyong mga mata: nguni't talastasin mo na dahil sa lahat ng mga bagay na ito ay dadalhin ka ng Dios sa kahatulan."
            },
            {
              "chapter": 11,
              "verse": 10,
              "name": "Mangangaral 11:10",
              "text": "Kaya't ilayo mo ang kapanglawan sa iyong puso, at alisin mo ang kasamaan sa iyong katawan: sapagka't ang kabataan at ang kasariwaan ng buhay ay walang kabuluhan."
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Mangangaral 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Mangangaral 12:1",
              "text": "Alalahanin mo rin naman ang Maylalang sa iyo sa mga kaarawan ng iyong kabataan, bago dumating ang mga masamang araw, at ang mga taon ay lumapit, pagka iyong sasabihin, Wala akong kaluguran sa mga yaon;"
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Mangangaral 12:2",
              "text": "Bago ang araw, at ang liwanag, at ang buwan, at ang mga bituin ay magdilim, at ang mga alapaap ay magsibalik pagkatapos ng ulan."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Mangangaral 12:3",
              "text": "Sa kaarawan na ang mga tagapagingat ng bahay ay manganginginig, at ang mga malakas na lalake ay mapapayukod, at ang mga manggigiling ay mangaglilikat sapagka't sila'y kaunti, at yaong nagsisidungaw sa mga dungawan ay mangasisilaw,"
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Mangangaral 12:4",
              "text": "At ang mga pintuan ay sasarhan sa mga lansangan; pagka ang tunog ng giling ay humina, at ang isa'y babangon sa tinig ng ibon, at lahat ng mga anak na babae ng tugtugin ay mabababa;"
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Mangangaral 12:5",
              "text": "Oo, sila'y mangatatakot sa mataas, at ang mga kakilabutan ay mapapasa daan; at ang puno ng almendro ay mamumulaklak; at ang balang ay magiging pasan, at ang pita ay manglulupaypay: sapagka't ang tao ay pumapanaw sa kaniyang malaong tahanan, at ang mga tagapanangis ay nagsisigala sa mga lansangan:"
            },
            {
              "chapter": 12,
              "verse": 6,
              "name": "Mangangaral 12:6",
              "text": "Bago ang panaling pilak ay mapatid, o ang mangkok na ginto ay mabasag, o ang banga ay mabasag sa bukal, o ang gulong ay masira sa balon;"
            },
            {
              "chapter": 12,
              "verse": 7,
              "name": "Mangangaral 12:7",
              "text": "At ang alabok ay mauuwi sa lupa gaya ng una, at ang diwa ay mababalik sa Dios na nagbigay sa kaniya."
            },
            {
              "chapter": 12,
              "verse": 8,
              "name": "Mangangaral 12:8",
              "text": "Walang kabuluhan ng mga walang kabuluhan, sabi ng Mangangaral; lahat ay walang kabuluhan."
            },
            {
              "chapter": 12,
              "verse": 9,
              "name": "Mangangaral 12:9",
              "text": "At bukod dito, sapagka't ang Mangangaral ay pantas, ay nagpatuloy siya ng pagtuturo ng kaalaman sa bayan; oo, siya'y nagaral, at sumiyasat, at umayos ng maraming kawikaan."
            },
            {
              "chapter": 12,
              "verse": 10,
              "name": "Mangangaral 12:10",
              "text": "Humanap ang Mangangaral ng mga nakalulugod na salita, at ng nasusulat na matuwid, na mga salita ng katotohanan."
            },
            {
              "chapter": 12,
              "verse": 11,
              "name": "Mangangaral 12:11",
              "text": "Ang mga salita ng pantas ay gaya ng mga tulis; at gaya ng mga pako na nakakapit na mabuti, ang mga salita ng mga pangulo ng mga kapulungan, na nabigay mula sa isang pastor."
            },
            {
              "chapter": 12,
              "verse": 12,
              "name": "Mangangaral 12:12",
              "text": "At bukod dito, anak ko, maaralan ka: tungkol sa paggawa ng maraming aklat ay walang wakas; at ang maraming pagaaral ay kapaguran ng katawan."
            },
            {
              "chapter": 12,
              "verse": 13,
              "name": "Mangangaral 12:13",
              "text": "Ito ang wakas ng bagay; lahat ay narinig: ikaw ay matakot sa Dios, at sundin mo ang kaniyang mga utos; sapagka't ito ang buong katungkulan ng tao."
            },
            {
              "chapter": 12,
              "verse": 14,
              "name": "Mangangaral 12:14",
              "text": "Sapagka't dadalhin ng Dios ang bawa't gawa sa kahatulan, pati ng bawa't kubling bagay, maging ito'y mabuti o maging ito'y masama."
            }
          ]
        }
