            {
              "chapter": 6,
              "verse": 4,
              "name": "2 Samuel 6:4",
              "text": "At kanilang inilabas sa bahay ni Abinadab, na nasa burol, pati ng kaban ng Dios: at si Ahio ay nagpauna sa kaban."
