    {
      "nr": 23,
      "name": "Isaias",
      "chapters": [
        {
          "chapter": 1,
          "name": "Isaias 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "Isaias 1:1",
              "text": "Ang pangitain ni Isaias na anak ni Amoz, na nakita tungkol sa Juda at Jerusalem, sa mga kaarawan ni Uzias, ni Jotham, ni Ahaz, at ni Ezechias, na mga hari sa Juda."
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "Isaias 1:2",
              "text": "Dinggin mo, Oh langit, at pakinggan mo, Oh lupa, sapagka't sinalita ng Panginoon: Ako'y nagalaga at nagpalaki ng mga bata, at sila'y nanganghimagsik laban sa akin."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "Isaias 1:3",
              "text": "Nakikilala ng baka ang kaniyang panginoon, at ng asno ang pasabsaban ng kaniyang panginoon: nguni't ang Israel ay hindi nakakakilala, ang bayan ko ay hindi gumugunita."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "Isaias 1:4",
              "text": "Ah bansang salarin, bayang napapasanan ng kasamaan, lahi ng mga manggagawa ng kasamaan, mga anak na nagsisigawa ng kalikuan: pinabayaan nila ang Panginoon, hinamak nila ang Banal ng Israel, sila'y nangapalayo na nagsiurong."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "Isaias 1:5",
              "text": "Bakit kayo'y hahampasin pa, na kayo'y manganghimagsik ng higit at higit? ang buong ulo ay masakit, at ang buong puso ay nanglulupaypay."
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "Isaias 1:6",
              "text": "Mula sa talampakan ng paa hanggang sa ulo ay walang kagalingan; kundi mga sugat, at mga pasa, at nangagnananang sugat: hindi nangatikom, o nangatalian man, o nangapahiran man ng langis."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "Isaias 1:7",
              "text": "Ang inyong lupain ay giba; ang inyong mga bayan ay sunog ng apoy; ang inyong lupain ay nilalamon ng mga taga ibang lupa sa inyong harapan, at giba, na gaya ng iniwasak ng mga taga ibang lupa."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "Isaias 1:8",
              "text": "At ang anak na babae ng Sion ay naiwang parang balag sa isang ubasan, parang pahingahan sa halamanan ng mga pepino, parang bayang nakukubkob."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "Isaias 1:9",
              "text": "Kung hindi nagiwan sa atin ng napakakaunting labi ang Panginoon ng mga hukbo, naging gaya sana tayo ng Sodoma, naging gaya sana tayo ng Gomorra."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "Isaias 1:10",
              "text": "Pakinggan ninyo ang salita ng Panginoon, ninyong mga pinuno ng Sodoma; mangakinig kayo sa kautusan ng ating Dios, kayong bayan ng Gomorra."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "Isaias 1:11",
              "text": "Sa anong kapararakan ang karamihan ng inyong mga hain sa akin? sabi ng Panginoon: ako'y puno ng mga handog na susunugin na mga lalaking tupa, at ng mataba sa mga hayop na pinataba; at ako'y hindi nalulugod sa dugo ng mga toro, o ng mga kordero o ng mga kambing na lalake."
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "Isaias 1:12",
              "text": "Nang kayo'y magsidating na pakita sa harap ko, sinong humingi nito sa inyong kamay, upang inyong yapakan ang aking mga looban?"
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "Isaias 1:13",
              "text": "Huwag na kayong magdala ng mga walang kabuluhang alay; kamangyan ay karumaldumal sa akin; ang bagong buwan, at ang sabbath, ang tawag ng mga kapulungan, hindi ako makapagtitiis ng kasamaan at ng takdang pulong."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "Isaias 1:14",
              "text": "Ipinagdaramdam ng aking puso ang inyong mga bagong buwan at ang inyong mga takdang kapistahan: mga kabagabagan sa akin; ako'y pata ng pagdadala ng mga yaon."
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "Isaias 1:15",
              "text": "At pagka inyong iginagawad ang inyong mga kamay, aking ikukubli ang aking mga mata sa inyo: oo, pagka kayo'y nagsisidalangin ng marami, hindi ko kayo didinggin: ang inyong mga kamay ay puno ng dugo."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "Isaias 1:16",
              "text": "Mangaghugas kayo, mangaglinis kayo; alisin ninyo ang kasamaan ng inyong mga gawa sa harap ng aking mga mata; mangaglikat kayo ng paggawa ng kasamaan:"
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "Isaias 1:17",
              "text": "Mangatuto kayong magsigawa ng mabuti; inyong hanapin ang kahatulan, inyong saklolohan ang napipighati, inyong hatulan ang ulila, ipagsanggalang ninyo ang babaing bao."
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "Isaias 1:18",
              "text": "Magsiparito kayo ngayon, at tayo'y magkatuwiranan, sabi ng Panginoon: bagaman ang inyong mga kasalanan ay maging tila mapula, ay magiging mapuputi na parang niebe; bagaman maging mapulang gaya ng matingkad na pula, ay magiging parang balahibo ng bagong paligong tupa,"
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "Isaias 1:19",
              "text": "Kung kayo'y magkusa at mangagmasunurin, kayo'y magsisikain ng buti ng lupain:"
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "Isaias 1:20",
              "text": "Nguni't kung kayo'y magsitanggi at manganghimagsik, kayo'y lilipulin ng tabak: sapagka't sinalita ng bibig ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "Isaias 1:21",
              "text": "Ano't ang tapat na bayan ay naging tila patutot! noong una siya'y puspos ng kahatulan! katuwiran ay tumatahan sa kaniya, nguni't ngayo'y mga mamamatay tao."
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "Isaias 1:22",
              "text": "Ang iyong pilak ay naging dumi, ang iyong alak ay nahaluan ng tubig."
            },
            {
              "chapter": 1,
              "verse": 23,
              "name": "Isaias 1:23",
              "text": "Ang iyong mga pangulo ay mapanghimagsik, at mga kasama ng mga tulisan; bawa't isa'y umiibig ng mga suhol, at naghahangad ng mga kabayaran: hindi nila hinahatulan ang ulila, o pinararating man sa kanila ang usap ng babaing bao."
            },
            {
              "chapter": 1,
              "verse": 24,
              "name": "Isaias 1:24",
              "text": "Kaya't sabi ng Panginoon, ng Panginoon ng mga hukbo, ng Makapangyarihan ng Israel, Ah kukuhang sulit ako sa aking mga kaalit, at manghihiganti ako sa aking mga kaaway."
            },
            {
              "chapter": 1,
              "verse": 25,
              "name": "Isaias 1:25",
              "text": "At aking ibabalik ang aking kamay sa iyo, at aking lilinising lubos ang naging dumi mo, at aalisin ko ang iyong lahat na tingga:"
            },
            {
              "chapter": 1,
              "verse": 26,
              "name": "Isaias 1:26",
              "text": "At aking papananauliin ang iyong mga hukom na gaya ng una, at ang iyong mga kasangguni na gaya ng pasimula: pagkatapos ay tatawagin ka, Ang bayan ng katuwiran, ang tapat na bayan."
            },
            {
              "chapter": 1,
              "verse": 27,
              "name": "Isaias 1:27",
              "text": "Ang Sion ay tutubusin ng kahatulan, at ng katuwiran ang kaniyang mga nahikayat."
            },
            {
              "chapter": 1,
              "verse": 28,
              "name": "Isaias 1:28",
              "text": "Nguni't ang pagkalipol ng mga mananalangsang at ng mga makasalanan ay magkakapisan, at silang nagtatakuwil sa Panginoon ay mangalilipol."
            },
            {
              "chapter": 1,
              "verse": 29,
              "name": "Isaias 1:29",
              "text": "Sapagka't kanilang ikahihiya ang mga encina na inyong ninasa, at kayo'y mangalilito dahil sa mga halamanan na inyong pinili."
            },
            {
              "chapter": 1,
              "verse": 30,
              "name": "Isaias 1:30",
              "text": "Sapagka't kayo'y magiging parang encina na ang dahon ay nalalanta, at parang halamanan na walang tubig."
            },
            {
              "chapter": 1,
              "verse": 31,
              "name": "Isaias 1:31",
              "text": "At ang malakas ay magiging parang taling estopa, at ang kaniyang gawa ay parang alipato; at kapuwa sila magliliyab, at walang papatay sa apoy."
            }
          ]
        },
        {
          "chapter": 2,
          "name": "Isaias 2",
          "verses": [
            {
              "chapter": 2,
              "verse": 1,
              "name": "Isaias 2:1",
              "text": "Ang salita na naalaman ni Isaias na anak ni Amoz tungkol sa Juda at Jerusalem."
            },
            {
              "chapter": 2,
              "verse": 2,
              "name": "Isaias 2:2",
              "text": "At mangyayari sa mga huling araw, na ang bundok ng bahay ng Panginoon ay matatatag sa taluktok ng mga bundok, at magiging mataas sa mga burol; at lahat ng bansa ay magsisiparoon doon."
            },
            {
              "chapter": 2,
              "verse": 3,
              "name": "Isaias 2:3",
              "text": "At maraming bayan ay magsisiyaon at mangagsasabi, Halina kayo, at tayo'y magsiahon sa bundok ng Panginoon, sa bahay ng Dios ni Jacob; at tuturuan niya tayo ng kaniyang mga daan, at tayo'y magsisilakad sa kaniyang mga landas: sapagka't mula sa Sion ay lalabas ang kautusan, at ang salita ng Panginoon ay mula sa Jerusalem."
            },
            {
              "chapter": 2,
              "verse": 4,
              "name": "Isaias 2:4",
              "text": "At siya'y hahatol sa gitna ng mga bansa, at sasaway sa maraming tao: at kanilang pupukpukin ang kanilang mga tabak upang maging mga sudsod, at ang kanilang mga sibat ay maging mga karit: ang bansa ay hindi magtataas ng tabak laban sa bansa, o mangagaaral pa man sila ng pakikipagdigma."
            },
            {
              "chapter": 2,
              "verse": 5,
              "name": "Isaias 2:5",
              "text": "Oh sangbahayan ni Jacob, halikayo, at tayo'y magsilakad sa liwanag ng Panginoon."
            },
            {
              "chapter": 2,
              "verse": 6,
              "name": "Isaias 2:6",
              "text": "Sapagka't iyong binayaan ang iyong bayan na sangbahayan ni Jacob, sapagka't sila'y puspos ng mga kaugaliang mula sa silanganan, at mga enkantador gaya ng mga Filisteo, at sila'y nangakikipagkamay sa mga anak ng mga taga ibang lupa."
            },
            {
              "chapter": 2,
              "verse": 7,
              "name": "Isaias 2:7",
              "text": "Ang kanilang lupain naman ay puno ng pilak at ginto, ni walang wakas ang kanilang mga kayamanan; ang kanila namang lupain ay puno ng mga kabayo, ni walang katapusang bilang ang kanilang mga karo."
            },
            {
              "chapter": 2,
              "verse": 8,
              "name": "Isaias 2:8",
              "text": "Ang kanila namang lupain ay puno ng mga diosdiosan; kanilang sinasamba ang gawa ng kanilang sariling mga kamay, na ginawa ng kanilang sariling mga daliri."
            },
            {
              "chapter": 2,
              "verse": 9,
              "name": "Isaias 2:9",
              "text": "At ang taong hamak ay yumuyuko, at ang mataas na tao ay nabababa: kaya't huwag mong patawarin sila."
            },
            {
              "chapter": 2,
              "verse": 10,
              "name": "Isaias 2:10",
              "text": "Pumasok ka sa malaking bato, at magkubli ka sa alabok, sa kakilabutan sa Panginoon, at sa kaluwalhatian ng kaniyang kamahalan."
            },
            {
              "chapter": 2,
              "verse": 11,
              "name": "Isaias 2:11",
              "text": "Ang mga tinging mapagmataas ng tao ay mabababa, at ang mga pagmamataas ng mga tao ay mahuhutok, at ang Panginoon magisa ay mabubunyi sa kaarawang yaon."
            },
            {
              "chapter": 2,
              "verse": 12,
              "name": "Isaias 2:12",
              "text": "Sapagka't magkakaroon ng isang kaarawan ang Panginoon ng mga hukbo sa lahat na palalo at mapagmataas, at sa lahat na nagmamataas; at yao'y mabababa:"
            },
            {
              "chapter": 2,
              "verse": 13,
              "name": "Isaias 2:13",
              "text": "At sa lahat ng cedro ng Libano, na matayog at mataas, at sa lahat ng encina ng Basan;"
            },
            {
              "chapter": 2,
              "verse": 14,
              "name": "Isaias 2:14",
              "text": "At sa lahat ng matataas na bundok, at sa lahat ng mga burol na nangataas;"
            },
            {
              "chapter": 2,
              "verse": 15,
              "name": "Isaias 2:15",
              "text": "At sa bawa't matayog na moog, at sa bawa't kutang nababakod:"
            },
            {
              "chapter": 2,
              "verse": 16,
              "name": "Isaias 2:16",
              "text": "At sa lahat ng mga sasakyang dagat ng Tarsis, at sa lahat ng maligayang bagay."
            },
            {
              "chapter": 2,
              "verse": 17,
              "name": "Isaias 2:17",
              "text": "At ang kahambugan ng tao ay huhutukin, at ang mga pagmamataas ng mga tao ay mabababa: at ang Panginoon magisa ay mabubunyi sa kaarawang yaon."
            },
            {
              "chapter": 2,
              "verse": 18,
              "name": "Isaias 2:18",
              "text": "At ang mga diosdiosan ay mapapawing lubos."
            },
            {
              "chapter": 2,
              "verse": 19,
              "name": "Isaias 2:19",
              "text": "At ang mga tao ay magsisipasok sa mga yungib ng malalaking bato, at sa mga puwang ng lupa, sa harap ng kakilabutan sa Panginoon, at sa kaluwalhatian ng kaniyang kamahalan, pagka siya'y bumangon upang yaniging may kapangyarihan ang lupa."
            },
            {
              "chapter": 2,
              "verse": 20,
              "name": "Isaias 2:20",
              "text": "Sa kaarawang yaon ay ihahagis ng mga tao ang kanilang mga diosdiosang pilak, at ang kanilang mga diosdiosang ginto, na kanilang ginawa upang sambahin, sa yungib ng mga bilig at ng mga paniki;"
            },
            {
              "chapter": 2,
              "verse": 21,
              "name": "Isaias 2:21",
              "text": "Upang pumasok sa mga puwang ng malalaking bato, at sa mga bitak ng mga malaking bato, sa harap ng kakilabutan sa Panginoon, at sa kaluwalhatian ng kaniyang kamahalan, pagka siya'y bumangon upang yaniging may kapangyarihan ang lupa."
            },
            {
              "chapter": 2,
              "verse": 22,
              "name": "Isaias 2:22",
              "text": "Layuan ninyo ang tao, na ang hinga ay nasa kaniyang mga butas ng ilong: sapagka't sa ano pahahalagahan siya?"
            }
          ]
        },
        {
          "chapter": 3,
          "name": "Isaias 3",
          "verses": [
            {
              "chapter": 3,
              "verse": 1,
              "name": "Isaias 3:1",
              "text": "Sapagka't, narito, ang Panginoon, ang Panginoon ng mga hukbo, ay nagaalis sa Jerusalem at sa Juda ng alalay at tungkod, ng buong alalay na tinapay at ng buong alalay na tubig;"
            },
            {
              "chapter": 3,
              "verse": 2,
              "name": "Isaias 3:2",
              "text": "Ng makapangyarihang lalake, at ng lalaking mangdidigma; ng hukom, at ng propeta, at ng manghuhula, at ng matanda;"
            },
            {
              "chapter": 3,
              "verse": 3,
              "name": "Isaias 3:3",
              "text": "Ng kapitan ng lilimang puin, at ng marangal na tao, at ng tagapayo, at ng bihasang manggagawa, at ng matalinong mangeenkanto."
            },
            {
              "chapter": 3,
              "verse": 4,
              "name": "Isaias 3:4",
              "text": "At mga bata ang ilalagay kong maging kanilang mga pangulo, at mga sanggol ang magpupuno sa kanila."
            },
            {
              "chapter": 3,
              "verse": 5,
              "name": "Isaias 3:5",
              "text": "At ang bayan ay mapipighati, bawa't isa'y ng iba, at bawa't isa'y ng kaniyang kapuwa: ang bata ay magpapalalo laban sa matanda at ang hamak laban sa marangal."
            },
            {
              "chapter": 3,
              "verse": 6,
              "name": "Isaias 3:6",
              "text": "Pagka ang lalake ay hahawak sa kaniyang kapatid sa bahay ng kaniyang ama, na magsasabi: Ikaw ay may damit, ikaw ay maging aming pinuno, at ang pagkabagsak ito ay mapasa ilalim ng iyong kamay:"
            },
            {
              "chapter": 3,
              "verse": 7,
              "name": "Isaias 3:7",
              "text": "Sa araw na yaon ay manglalakas siya ng kaniyang tinig, na magsasabi, Hindi ako magiging tagapagpagaling; sapagka't sa aking bahay ay wala kahit tinapay o damit man; huwag ninyo akong gawing pinuno ng bayan."
            },
            {
              "chapter": 3,
              "verse": 8,
              "name": "Isaias 3:8",
              "text": "Sapagka't ang Jerusalem ay giba, at ang Juda ay bagsak: sapagka't ang kanilang dila at ang kanilang mga gawa ay laban sa Panginoon, upang mungkahiin ang mga mata niyang maluwalhati."
            },
            {
              "chapter": 3,
              "verse": 9,
              "name": "Isaias 3:9",
              "text": "Ang kanilang pagtatangi ng mga tao ay sumasaksi laban sa kanila; at kanilang ipinahahayag ang kanilang mga kasalanan na gaya ng Sodoma, hindi nila ikinukubli. Sa aba ng kanilang kaluluwa! sapagka't sila'y nagsiganti ng kasamaan sa kanilang sarili."
            },
            {
              "chapter": 3,
              "verse": 10,
              "name": "Isaias 3:10",
              "text": "Sabihin ninyo sa matuwid, na ikabubuti niya: sapagka't sila'y magsisikain ng bunga ng kanilang mga gawa."
            },
            {
              "chapter": 3,
              "verse": 11,
              "name": "Isaias 3:11",
              "text": "Sa aba ng masama! ikasasama niya: sapagka't ang kagantihan sa kaniyang mga kamay ay mabibigay sa kaniya."
            },
            {
              "chapter": 3,
              "verse": 12,
              "name": "Isaias 3:12",
              "text": "Tungkol sa aking bayan, mga bata ang mga mamimighati sa kanila, at mga babae ang mangagpupuno sa kanila. Oh bayan ko, silang nagsisipatnubay sa iyo, mangagliligaw sa iyo, at sisira ng daan ng iyong mga landas."
            },
            {
              "chapter": 3,
              "verse": 13,
              "name": "Isaias 3:13",
              "text": "Ang Panginoon ay tumayo upang magsanggalang, at tumayo upang humatol sa mga bayan."
            },
            {
              "chapter": 3,
              "verse": 14,
              "name": "Isaias 3:14",
              "text": "Ang Panginoon ay hahatol sa mga matanda ng kaniyang bayan, at sa mga pangulo niyaon; Kayo ang nagkainan sa ubasan: ang samsam sa dukha ay nasa inyong mga bahay;"
            },
            {
              "chapter": 3,
              "verse": 15,
              "name": "Isaias 3:15",
              "text": "Anong ibig ninyong sabihin na inyong dinidikdik ang aking bayan, at inyong ginigiling ang mukha ng dukha? sabi ng Panginoon, ng Panginoon ng mga hukbo."
            },
            {
              "chapter": 3,
              "verse": 16,
              "name": "Isaias 3:16",
              "text": "Bukod dito'y sinabi ng Panginoon, Sapagka't ang mga anak na babae ng Sion ay mga mapagmataas, at nagsisilakad na mga may kapalaluan at mga matang nakairap, na nagsisilakad at nagsisikendeng habang nagsisiyaon, at nagpapakalatis ng kanilang mga paa:"
            },
            {
              "chapter": 3,
              "verse": 17,
              "name": "Isaias 3:17",
              "text": "Kaya't papaglalangibin ng Panginoon ang bao ng ulo ng mga anak na babae ng Sion, at huhubdan ng Panginoon ang kanilang mga lihim na bahagi."
            },
            {
              "chapter": 3,
              "verse": 18,
              "name": "Isaias 3:18",
              "text": "Sa araw na yaon ay aalisin ng Panginoon ang kagayakan ng kanilang mga hiyas ng paa, at ang mga hiyas ng ulo, at ang mga pahiyas na may anyong kalahating buwan;"
            },
            {
              "chapter": 3,
              "verse": 19,
              "name": "Isaias 3:19",
              "text": "Ang mga hikaw, at ang mga pulsera, at ang mga lambong na pangmukha;"
            },
            {
              "chapter": 3,
              "verse": 20,
              "name": "Isaias 3:20",
              "text": "Ang mga laso ng buhok, at ang mga kuwintas sa bukong-bukong, at ang mga pamigkis, at ang mga sisidlan ng pabango, at ang mga amuleto;"
            },
            {
              "chapter": 3,
              "verse": 21,
              "name": "Isaias 3:21",
              "text": "Ang mga singsing, at ang mga hiyas na pang-ilong;"
            },
            {
              "chapter": 3,
              "verse": 22,
              "name": "Isaias 3:22",
              "text": "Ang mga damit na pamista, at ang mga balabal, at ang mga panleeg, at ang mga supot;"
            },
            {
              "chapter": 3,
              "verse": 23,
              "name": "Isaias 3:23",
              "text": "Ang mga maliit na salamin, at ang mainam na kayong lino, at ang mga turbante, at ang mga lambong."
            },
            {
              "chapter": 3,
              "verse": 24,
              "name": "Isaias 3:24",
              "text": "At mangyayari na sa halip na mga mainam na especia ay kabulukan; at sa halip na pamigkis ay panali; at sa halip na buhok na ayos ay kakalbuhan; at sa halip na pamigkis na mainam ay pamigkis na kayong magaspang; hero sa halip ng kagandahan."
            },
            {
              "chapter": 3,
              "verse": 25,
              "name": "Isaias 3:25",
              "text": "Ang iyong mga lalake ay mangabubuwal sa pamamagitan ng tabak, at ang iyong mga makapangyarihan ay sa pakikipagdigma."
            },
            {
              "chapter": 3,
              "verse": 26,
              "name": "Isaias 3:26",
              "text": "At ang kaniyang mga pintuang-bayan ay tataghoy at magsisitangis; at siya'y magiging giba at guho sa lupa."
            }
          ]
        },
        {
          "chapter": 4,
          "name": "Isaias 4",
          "verses": [
            {
              "chapter": 4,
              "verse": 1,
              "name": "Isaias 4:1",
              "text": "At pitong babae ay magsisihawak sa isang lalake sa araw na yaon, na mangagsasabi, Kami ay magsisikain ng aming sariling tinapay, at mangagsusuot ng aming sariling kasuutan: tawagin lamang kami sa iyong pangalan; alisin mo ang aming kadustaan."
            },
            {
              "chapter": 4,
              "verse": 2,
              "name": "Isaias 4:2",
              "text": "Sa araw na yaon ay magiging maganda at maluwalhati ang sanga ng Panginoon, at ang bunga ng lupain ay magiging magaling at mainam sa kanilang mga taga Israel na nangakatanan."
            },
            {
              "chapter": 4,
              "verse": 3,
              "name": "Isaias 4:3",
              "text": "At mangyayari, na siyang naiwan sa Sion, at siyang nalabi sa Jerusalem, tatawaging banal, sa makatuwid baga'y bawa't nasusulat sa mga nabubuhay sa Jerusalem:"
            },
            {
              "chapter": 4,
              "verse": 4,
              "name": "Isaias 4:4",
              "text": "Pagka huhugasan ng Panginoon ang karumhan ng mga anak na babae ng Sion, at lilinisin ang dugo ng Jerusalem sa gitna ng bayan sa pamamagitan ng bisa ng kahatulan, at sa pamamagitan ng bisa ng pagniningas."
            },
            {
              "chapter": 4,
              "verse": 5,
              "name": "Isaias 4:5",
              "text": "At ang Panginoon ay lilikha sa itaas ng buong tahanan ng bundok ng Sion, at sa itaas ng kaniyang mga kapulungan ng isang ulap at usok sa araw, at ng liwanag ng nagniningas na apoy sa gabi: sapagka't sa itaas ng lahat ng kaluwalhatian ay magkakaroon ng isang kubong na kayo."
            },
            {
              "chapter": 4,
              "verse": 6,
              "name": "Isaias 4:6",
              "text": "At magkakaroon ng kanlungan upang maging lilim sa kaarawan laban sa init, at upang maging kanlungan at kublihan sa bagyo at sa ulan."
            }
          ]
        },
        {
          "chapter": 5,
          "name": "Isaias 5",
          "verses": [
            {
              "chapter": 5,
              "verse": 1,
              "name": "Isaias 5:1",
              "text": "Paawitin ninyo ako sa aking pinakamamahal, ng awit ng aking minamahal tungkol sa kaniyang ubasan. Ang aking pinakamamahal ay may ubasan sa isang mainam na burol:"
            },
            {
              "chapter": 5,
              "verse": 2,
              "name": "Isaias 5:2",
              "text": "At kaniyang binangbangan ang palibot at inalis ang mga bato, at tinamnan ng piling puno ng ubas, at nagtayo ng isang moog sa gitna niyaon, at tinabasan din naman ng isang pisaan ng ubas: at kaniyang hinintay na magbunga ng ubas, at nagbunga ng ubas gubat."
            },
            {
              "chapter": 5,
              "verse": 3,
              "name": "Isaias 5:3",
              "text": "At ngayon, Oh mga nananahan sa Jerusalem at mga tao sa Juda, hatulan ninyo, isinasamo ko sa inyo, ako at ang aking ubasan."
            },
            {
              "chapter": 5,
              "verse": 4,
              "name": "Isaias 5:4",
              "text": "Ano pa ang magagawa ko sa aking ubasan na hindi ko nagawa? ano't nang aking hinihintay na magbubunga ng mga ubas, nagbunga ng ubas gubat?"
            },
            {
              "chapter": 5,
              "verse": 5,
              "name": "Isaias 5:5",
              "text": "At ngayo'y aking sasaysayin sa inyo ang gagawin ko sa aking ubasan: aking aalisin ang bakod na siit niyaon, at sasalantain; aking ibabagsak ang bakod niyaon at mayayapakan:"
            },
            {
              "chapter": 5,
              "verse": 6,
              "name": "Isaias 5:6",
              "text": "At aking pababayaang sira; hindi kakapunin o bubukirin man; kundi magsisitubo ay mga dawag at mga tinik: akin ding iuutos sa mga alapaap, na huwag nilang ulanan."
            },
            {
              "chapter": 5,
              "verse": 7,
              "name": "Isaias 5:7",
              "text": "Sapagka't ang ubasan ng Panginoon ng mga hukbo ay ang sangbahayan ng Israel, at ang mga tao sa Juda ay ang kaniyang maligayang pananim: at siya'y naghihintay ng kahatulan, nguni't narito, kapighatian; ng katuwiran, nguni't narito, daing."
            },
            {
              "chapter": 5,
              "verse": 8,
              "name": "Isaias 5:8",
              "text": "Sa aba nila, na nangaguugpong ng bahay sa bahay, na nangaglalagay ng bukid sa bukid hanggang sa mawalan ng pagitan, at kayo'y magsisitahang magisa sa gitna ng lupain!"
            },
            {
              "chapter": 5,
              "verse": 9,
              "name": "Isaias 5:9",
              "text": "Sa aking mga pakinig ay sinasabi ng Panginoon ng mga hukbo, Sa katotohana'y maraming bahay ang magigiba, malalaki at magaganda, na walang mananahan."
            },
            {
              "chapter": 5,
              "verse": 10,
              "name": "Isaias 5:10",
              "text": "Sapagka't sangpung acre ng ubasan ay mangagbubunga ng isang bath, at isang homer na binhi ay magbubunga ng isang epa."
            },
            {
              "chapter": 5,
              "verse": 11,
              "name": "Isaias 5:11",
              "text": "Sa aba nila na nagsisibangong maaga sa umaga, upang sila'y makasunod sa nakalalasing na inumin; na nagtatagal hanggang sa kalaliman ng gabi, hanggang sa magalab ang alak sa kanila!"
            },
            {
              "chapter": 5,
              "verse": 12,
              "name": "Isaias 5:12",
              "text": "At ang alpa at ang viola, ang pandareta at ang plauta, at ang alak, ay nangasa kanilang mga kapistahan: nguni't hindi nila pinakundanganan ang gawa ng Panginoon, o ginunita man nila ang gawa ng kaniyang mga kamay."
            },
            {
              "chapter": 5,
              "verse": 13,
              "name": "Isaias 5:13",
              "text": "Kaya't ang aking bayan ay nasok sa pagkabihag, sa kasalatan sa kaalaman: at ang kanilang mararangal na tao ay nangagugutom, at ang kanilang karamihan ay nangahahandusay sa uhaw."
            },
            {
              "chapter": 5,
              "verse": 14,
              "name": "Isaias 5:14",
              "text": "Kaya't pinalaki ng Sheol ang kaniyang nasa, at ibinuka ang kaniyang bibig ng walang sukat: at ang kanilang kaluwalhatian, at ang kanilang karamihan, at ang kanilang kahambugan, at ang nagagalak sa gitna nila ay bumaba roon."
            },
            {
              "chapter": 5,
              "verse": 15,
              "name": "Isaias 5:15",
              "text": "At ang taong hamak ay pinayuyukod, at ang makapangyarihang tao ay pinapagpapakumbaba, at ang mga mata ng nagmamataas ay pinapagpapakumbaba:"
            },
            {
              "chapter": 5,
              "verse": 16,
              "name": "Isaias 5:16",
              "text": "Nguni't ang Panginoon ng mga hukbo ay nabunyi sa kahatulan, at ang Dios na Banal ay inaring banal sa katuwiran."
            },
            {
              "chapter": 5,
              "verse": 17,
              "name": "Isaias 5:17",
              "text": "Kung magkagayo'y sasabsab ang mga kordero na gaya sa kanilang sabsaban, at ang mga sirang dako ng matataba ay kakanin ng mga palaboy."
            },
            {
              "chapter": 5,
              "verse": 18,
              "name": "Isaias 5:18",
              "text": "Sa aba nila na nagsisihila ng kasamaan sa pamamagitan ng mga panali ng walang kabuluhan, at ng kasalanan na tila panali ng kariton:"
            },
            {
              "chapter": 5,
              "verse": 19,
              "name": "Isaias 5:19",
              "text": "Na nagsasabi, Magmaliksi siya, madaliin niya ang kaniyang gawa upang aming makita: at lumapit at dumating nawa ang payo ng Banal ng Israel upang aming maalaman!"
            },
            {
              "chapter": 5,
              "verse": 20,
              "name": "Isaias 5:20",
              "text": "Sa aba nila na nagsisitawag ng mabuti ay masama, at ng masama ay mabuti; na inaaring dilim ang liwanag, at liwanag ang dilim; na inaaring mapait ang matamis, at matamis ang mapait!"
            },
            {
              "chapter": 5,
              "verse": 21,
              "name": "Isaias 5:21",
              "text": "Sa aba nila na pantas sa kanilang sariling mga mata, at mabait sa kanilang sariling paningin!"
            },
            {
              "chapter": 5,
              "verse": 22,
              "name": "Isaias 5:22",
              "text": "Sa aba nila na malakas uminom ng alak, at mga taong malakas sa paghahalo ng matapang na inumin:"
            },
            {
              "chapter": 5,
              "verse": 23,
              "name": "Isaias 5:23",
              "text": "Na nagsisiaring ganap sa masama dahil sa suhol, at inaalis ang katuwiran sa matuwid!"
            },
            {
              "chapter": 5,
              "verse": 24,
              "name": "Isaias 5:24",
              "text": "Kaya't kung paanong ang liyab ng apoy ay pumupugnaw ng pinagputulan ng trigo, at kung paanong ang tuyong damo ay nasusupok sa alab, gayon magiging gaya ng kabulukan ang kanilang ugat, at ang kanilang bulaklak ay iilanglang na gaya ng alabok: sapagka't kanilang itinakuwil ang kautusan ng Panginoon ng mga hukbo, at hinamak ang salita ng Banal ng Israel."
            },
            {
              "chapter": 5,
              "verse": 25,
              "name": "Isaias 5:25",
              "text": "Kaya't nagalab ang galit ng Panginoon laban sa kaniyang bayan, at iniunat niya ang kaniyang kamay laban sa kanila, at sinaktan sila, at ang mga burol ay nanginig, at ang kanilang mga bangkay ay naging dumi sa gitna ng mga lansangan. Sa lahat ng ito ay hindi napawi ang kaniyang galit, kundi laging nakaunat ang kaniyang kamay."
            },
            {
              "chapter": 5,
              "verse": 26,
              "name": "Isaias 5:26",
              "text": "At siya'y magtataas ng watawat sa mga bansa mula sa malayo, at susutsutan sila mula sa wakas ng lupa: at, narito, sila'y darating na lubhang nagmamadali:"
            },
            {
              "chapter": 5,
              "verse": 27,
              "name": "Isaias 5:27",
              "text": "Walang mapapagod o matitisod man sa kanila; walang iidlip o matutulog man; ni hindi man kakalagin ang pamigkis ng kanilang mga balakang, o mapapatid man ang mga panali ng kanilang mga panyapak:"
            },
            {
              "chapter": 5,
              "verse": 28,
              "name": "Isaias 5:28",
              "text": "Na ang kanilang mga pana ay hasa, at lahat nilang busog ay nangakaakma; ang mga kuko ng kanilang mga kabayo ay maibibilang na parang pingkiang bato, at ang kanilang mga gulong ay parang ipoipo:"
            },
            {
              "chapter": 5,
              "verse": 29,
              "name": "Isaias 5:29",
              "text": "Ang kanilang angal ay magiging gaya ng sa leon, sila'y magsisiangal na gaya ng mga batang leon: oo, sila'y magsisiangal, at magsisipangal ng huli, at tatangayin, at walang magliligtas."
            },
            {
              "chapter": 5,
              "verse": 30,
              "name": "Isaias 5:30",
              "text": "At ang mga yao'y magsisiangal laban sa kanila sa araw na yaon na gaya ng hugong ng dagat: at kung tingnan ang lupain, narito, kadiliman at kahirapan, at ang liwanag ay magdidilim sa mga ulap niyaon."
            }
          ]
        },
        {
          "chapter": 6,
          "name": "Isaias 6",
          "verses": [
            {
              "chapter": 6,
              "verse": 1,
              "name": "Isaias 6:1",
              "text": "Noong taong mamatay ang haring Uzzias ay nakita ko ang Panginoon na nakaupo sa isang luklukan, matayog at mataas; at pinuno ang templo ng kaniyang kaluwalhatian."
            },
            {
              "chapter": 6,
              "verse": 2,
              "name": "Isaias 6:2",
              "text": "Sa itaas niya ay nangakatayo ang mga serapin: bawa't isa'y may anim na pakpak: na may dalawa na nagsisitakip ng kaniyang mukha, at may dalawa na nagsisitakip ng kaniyang mga paa, at may dalawa na naglilipad sa kaniya."
            },
            {
              "chapter": 6,
              "verse": 3,
              "name": "Isaias 6:3",
              "text": "At nagsisigawang isa't isa, at nagsasabi, Banal, banal, banal ang Panginoon ng mga hukbo: ang buong lupa ay napuno ng kaniyang kaluwalhatian."
            },
            {
              "chapter": 6,
              "verse": 4,
              "name": "Isaias 6:4",
              "text": "At ang mga patibayan ng mga pintuan ay nakilos sa tinig ng sumisigaw, at ang bahay ay napuno ng usok."
            },
            {
              "chapter": 6,
              "verse": 5,
              "name": "Isaias 6:5",
              "text": "Nang magkagayo'y sinabi ko, Sa aba ko! sapagka't ako'y napahamak; sapagka't ako'y lalaking may maruming mga labi, at ako'y tumatahan sa gitna ng bayan na may maruming mga labi: sapagka't nakita ng aking mga mata ang Hari, ang Panginoon ng mga hukbo."
            },
            {
              "chapter": 6,
              "verse": 6,
              "name": "Isaias 6:6",
              "text": "Nang magkagayo'y nilipad ako ng isa sa mga serapin, na may baga sa kaniyang kamay, na kaniyang kinuha ng mga pangipit mula sa dambana:"
            },
            {
              "chapter": 6,
              "verse": 7,
              "name": "Isaias 6:7",
              "text": "At hinipo niya niyaon ang aking bibig, at nagsabi, Narito, hinipo nito ang iyong mga labi; at ang iyong kasamaan ay naalis, at ang iyong kasalanan ay naalis."
            },
            {
              "chapter": 6,
              "verse": 8,
              "name": "Isaias 6:8",
              "text": "At narinig ko ang tinig ng Panginoon, na nagsasabi, Sinong susuguin ko, at sinong yayaon sa ganang amin? Nang magkagayo'y sinabi ko: Narito ako; suguin mo ako."
            },
            {
              "chapter": 6,
              "verse": 9,
              "name": "Isaias 6:9",
              "text": "At sinabi niya, Ikaw ay yumaon, at saysayin mo sa bayang ito, inyong naririnig nga, nguni't hindi ninyo nauunawa; at nakikita nga ninyo, nguni't hindi ninyo namamalas."
            },
            {
              "chapter": 6,
              "verse": 10,
              "name": "Isaias 6:10",
              "text": "Patabain mo ang puso ng bayang ito, at iyong pabigatin ang kanilang mga pakinig, at iyong ipikit ang kanilang mga mata; baka sila'y mangakakita ng kanilang mga mata; at mangakarinig ng kanilang mga pakinig, at mangakaunawa ng kanilang puso, at mangagbalik loob, at magsigaling."
            },
            {
              "chapter": 6,
              "verse": 11,
              "name": "Isaias 6:11",
              "text": "Nang magkagayo'y sinabi ko, Panginoon, hanggang kailan? At siya'y sumagot, Hanggang sa ang mga bayan ay mangagiba na walang tumahan, at ang mga bahay ay mangawalan ng tao, at ang lupain ay maging lubos na giba,"
            },
            {
              "chapter": 6,
              "verse": 12,
              "name": "Isaias 6:12",
              "text": "At ilayo ng Panginoon ang mga tao, at ang mga nilimot na dako ay magsidami sa gitna ng lupain."
            },
            {
              "chapter": 6,
              "verse": 13,
              "name": "Isaias 6:13",
              "text": "At kung magkaroon ng ikasangpung bahagi roon, mapupugnaw uli: gaya ng isang roble, at gaya ng isang encina, na ang puno ay naiiwan, pagka pinuputol; gayon ang banal na lahi ay siyang puno niyaon."
            }
          ]
        },
        {
          "chapter": 7,
          "name": "Isaias 7",
          "verses": [
            {
              "chapter": 7,
              "verse": 1,
              "name": "Isaias 7:1",
              "text": "At nangyari, nang mga kaarawan ni Achaz na anak ni Jotham, anak ni Uzzias, na hari sa Juda, na si Rezin na hari sa Siria, at si Peca na anak ni Remalias, hari sa Israel, ay nagsiahon sa Jerusalem upang makipagdigma laban doon; nguni't hindi nanganaig laban doon."
            },
            {
              "chapter": 7,
              "verse": 2,
              "name": "Isaias 7:2",
              "text": "At nasaysay sa sangbahayan ni David, na sinasabi, Ang Siria ay nalakip sa Ephraim. At ang puso niya'y nakilos, at ang puso ng kaniyang bayan na gaya ng mga punong kahoy sa gubat na kinilos ng hangin."
            },
            {
              "chapter": 7,
              "verse": 3,
              "name": "Isaias 7:3",
              "text": "Nang magkagayo'y sinabi ng Panginoon kay Isaias, Lumabas ka na iyong salubungin si Achaz, ikaw, at si Sear-jasub na iyong anak, sa dulo ng padaluyan ng tipunan ng tubig sa itaas, sa lansangan ng parang ng nagpapaputi ng kayo;"
            },
            {
              "chapter": 7,
              "verse": 4,
              "name": "Isaias 7:4",
              "text": "At sabihin mo sa kaniya, Ikaw ay magingat, at tumahimik ka; huwag kang matakot, o manglupaypay man ang iyong puso ng dahil sa dalawang buntot na apoy na ito na umuusok, ng dahil sa mabangis na galit ng Rezin at Siria, at ng anak ni Remalias."
            },
            {
              "chapter": 7,
              "verse": 5,
              "name": "Isaias 7:5",
              "text": "Dahil sa ang Siria ay pumayo ng masama laban sa iyo, ang Ephraim din naman, at ang anak ni Remalias, na nagsasabi,"
            },
            {
              "chapter": 7,
              "verse": 6,
              "name": "Isaias 7:6",
              "text": "Magsiahon tayo laban sa Juda, at ating bagabagin, at ating papasukin sila, at tayo'y maglagay ng hari sa gitna niyaon, sa makatuwid baga'y ang anak ni Tabeel:"
            },
            {
              "chapter": 7,
              "verse": 7,
              "name": "Isaias 7:7",
              "text": "Ganito ang sabi ng Panginoong Dios, Hindi matatayo o mangyayari man."
            },
            {
              "chapter": 7,
              "verse": 8,
              "name": "Isaias 7:8",
              "text": "Sapagka't ang pangulo ng Siria ay ang Damasco, at ang pangulo ng Damasco ay ang Rezin: at sa loob ng anim na pu't limang taon ay magkakawatakwatak ang Ephraim, upang huwag maging bayan:"
            },
            {
              "chapter": 7,
              "verse": 9,
              "name": "Isaias 7:9",
              "text": "At ang pangulo ng Ephraim ay ang Samaria, at ang pangulo ng Samaria ay ang anak ni Remalias. Kung kayo'y hindi maniniwala, tunay na hindi kayo mangatatatag."
            },
            {
              "chapter": 7,
              "verse": 10,
              "name": "Isaias 7:10",
              "text": "At ang Panginoon ay nagsalita uli kay Achaz, na nagsasabi,"
            },
            {
              "chapter": 7,
              "verse": 11,
              "name": "Isaias 7:11",
              "text": "Humingi ka sa ganang iyo ng tanda na mula sa Panginoon mong Dios; humingi ka maging sa kalaliman, o sa kaitaasan sa itaas."
            },
            {
              "chapter": 7,
              "verse": 12,
              "name": "Isaias 7:12",
              "text": "Nguni't sinabi ni Achaz, Hindi ako hihingi, ni tutuksuhin ko man ang Panginoon."
            },
            {
              "chapter": 7,
              "verse": 13,
              "name": "Isaias 7:13",
              "text": "At kaniyang sinabi, Dinggin ninyo ngayon, Oh sangbahayan ni David; maliit na bagay ba sa inyo ang mamagod sa mga tao na inyong papagurin rin ang aking Dios?"
            },
            {
              "chapter": 7,
              "verse": 14,
              "name": "Isaias 7:14",
              "text": "Kaya't ang Panginoon nga ay magbibigay sa inyo ng tanda; narito, isang dalaga ay maglilihi, at manganganak ng isang lalake, at tatawagin ang kaniyang pangalan na Emmanuel."
            },
            {
              "chapter": 7,
              "verse": 15,
              "name": "Isaias 7:15",
              "text": "Siya'y kakain ng mantekilla at pulot, pagka siya'y natutong tumanggi sa kasamaan, at pumili ng mabuti."
            },
            {
              "chapter": 7,
              "verse": 16,
              "name": "Isaias 7:16",
              "text": "Sapagka't bago maalaman ng bata na tumanggi sa kasamaan, at pumili ng mabuti, pababayaan ang lupain ng dalawang haring iyong kinayayamutan."
            },
            {
              "chapter": 7,
              "verse": 17,
              "name": "Isaias 7:17",
              "text": "Ang Panginoon ay magpapasapit sa iyo, at sa iyong bayan, at sa sangbahayan ng iyong magulang ng mga araw na hindi nangyari mula ng araw na humiwalay ang Ephraim sa Juda; sa makatuwid baga'y ang hari sa Asiria."
            },
            {
              "chapter": 7,
              "verse": 18,
              "name": "Isaias 7:18",
              "text": "At mangyayari sa araw na yaon, na susutsutan ng Panginoon ang langaw na nasa kahulihulihang bahagi ng mga ilog ng Egipto, at ang pukyutan na nasa lupain ng Asiria."
            },
            {
              "chapter": 7,
              "verse": 19,
              "name": "Isaias 7:19",
              "text": "At sila'y magsisidating, at silang lahat ay mangagpapahinga sa mga gibang libis, at sa mga bitak ng malalaking bato, at sa lahat ng mga tinikan, at sa lahat ng mga sukal."
            },
            {
              "chapter": 7,
              "verse": 20,
              "name": "Isaias 7:20",
              "text": "Sa araw na yaon ay aahitin ng Panginoon ang ulo at ang balahibo ng mga paa, ng pangahit na inupahan, ang nangasa bahagi ng dako roon ng Ilog, ang hari sa Asiria: at aalisin din ang balbas."
            },
            {
              "chapter": 7,
              "verse": 21,
              "name": "Isaias 7:21",
              "text": "At mangyayari sa araw na yaon, na ang isang tao ay magaalaga ng guyang baka, at ng dalawang tupa;"
            },
            {
              "chapter": 7,
              "verse": 22,
              "name": "Isaias 7:22",
              "text": "At mangyayari, na dahil sa kasaganaan ng gatas na kanilang ibibigay ay kakain siya ng mantekilla: sapagka't ang bawa't isa na naiwan sa gitna ng lupain ay kakain ng mantekilla at pulot."
            },
            {
              "chapter": 7,
              "verse": 23,
              "name": "Isaias 7:23",
              "text": "At mangyayari sa araw na yaon, na ang bawa't dakong kinaroroonan ng libong puno ng ubas na nagkakahalaga ng isang libong siklong pilak, ay magiging dawagan at tinikan."
            },
            {
              "chapter": 7,
              "verse": 24,
              "name": "Isaias 7:24",
              "text": "Paroroon ang isa na may mga pana at may busog; sapagka't ang buong lupain ay magiging mga dawag at mga tinikan."
            },
            {
              "chapter": 7,
              "verse": 25,
              "name": "Isaias 7:25",
              "text": "At ang lahat ng burol na hinukay ng azarol, hindi mo paroroonan dahil sa takot sa mga dawag at sa mga tinikan; kundi magiging pagalaan sa mga baka, at yurakan ng mga tupa."
            }
          ]
        },
        {
          "chapter": 8,
          "name": "Isaias 8",
          "verses": [
            {
              "chapter": 8,
              "verse": 1,
              "name": "Isaias 8:1",
              "text": "At sinabi ng Panginoon sa akin, Kumuha ka ng malapad na tabla, at sulatan mo ng panulat ng tao, Kay Maher-salalhash-baz;"
            },
            {
              "chapter": 8,
              "verse": 2,
              "name": "Isaias 8:2",
              "text": "At magdadala ako ng mga tapat na saksi upang mangagpaalaala, si Urias na saserdote, at si Zacarias na anak ni Jeberechias."
            },
            {
              "chapter": 8,
              "verse": 3,
              "name": "Isaias 8:3",
              "text": "At ako'y naparoon sa propetisa; at siya'y naglihi, at nanganak ng isang lalake. Nang magkagayo'y sinabi ng Panginoon sa akin, Tawagin mo ang kaniyang pangalan na Maher-salalhash-baz."
            },
            {
              "chapter": 8,
              "verse": 4,
              "name": "Isaias 8:4",
              "text": "Sapagka't bago ang anak ay matutong dumaing ng, Ama ko, at: Ina ko, ang mga kayamanan ng Damasco at ang samsam sa Samaria ay dadalahin sa harap ng hari ng Asiria."
            },
            {
              "chapter": 8,
              "verse": 5,
              "name": "Isaias 8:5",
              "text": "At nagsalita pa ang Panginoon uli sa akin, na nagsasabi,"
            },
            {
              "chapter": 8,
              "verse": 6,
              "name": "Isaias 8:6",
              "text": "Yamang tinanggihan ng bayang ito ang tubig ng Siloe na nagsisiagos na marahan, at siya'y nagagalak kay Rezin at sa anak ni Remalias;"
            },
            {
              "chapter": 8,
              "verse": 7,
              "name": "Isaias 8:7",
              "text": "Ngayon nga, narito, iniaahon ng Panginoon sa kanila ang tubig ng Ilog, malakas at marami, sa makatuwid baga'y ang hari sa Asiria at ang buo niyang kaluwalhatian: at siya'y aahon sa lahat niyang bangbang, at aapaw sa buo niyang baybayin:"
            },
            {
              "chapter": 8,
              "verse": 8,
              "name": "Isaias 8:8",
              "text": "At magpapatuloy sa dako ng loob ng Juda; aapaw at lalampas; aabot hanggang sa leeg; at ang laganap ng kaniyang mga pakpak ay siyang magpupuno ng kaluwangan ng iyong lupain, Oh Emmanuel."
            },
            {
              "chapter": 8,
              "verse": 9,
              "name": "Isaias 8:9",
              "text": "Kayo'y magsamasama, Oh mga bayan, at kayo'y mangagkakawatakwatak; at kayo'y mangakinig, kayong lahat na taga malayong lupain: mangagbigkis kayo, at kayo'y mangagkakawatakwatak; kayo'y mangagbigkis, at kayo'y mangagkakawatakwatak."
            },
            {
              "chapter": 8,
              "verse": 10,
              "name": "Isaias 8:10",
              "text": "Mangagsanggunian kayo, at yao'y mauuwi sa wala; mangagsalita kayo ng salita at hindi matatayo: sapagka't ang Dios ay sumasaamin."
            },
            {
              "chapter": 8,
              "verse": 11,
              "name": "Isaias 8:11",
              "text": "Sapagka't ang Panginoon ay nagsalitang ganito sa akin na may malakas na kamay, at tinuruan ako na huwag lumakad ng lakad ng bayang ito, na sinasabi,"
            },
            {
              "chapter": 8,
              "verse": 12,
              "name": "Isaias 8:12",
              "text": "Huwag ninyong sabihin, Pagbabanta; tungkol sa lahat na sasabihin ng bayang ito, Pagbabanta, o huwag mang mangatakot kayo ng kanilang takot, o mangilabot man doon."
            },
            {
              "chapter": 8,
              "verse": 13,
              "name": "Isaias 8:13",
              "text": "Ang Panginoon ng mga hukbo, siya ang inyong aariing banal; at sumakaniya ang inyong takot, at sumakaniya ang inyong pangingilabot."
            },
            {
              "chapter": 8,
              "verse": 14,
              "name": "Isaias 8:14",
              "text": "At siya'y magiging pinakasantuario; nguni't pinakabatong katitisuran at pinaka malaking batong pangbuwal sa dalawang sangbahayan ng Israel, na pinakabitag at pinakasilo sa mga nananahan sa Jerusalem."
            },
            {
              "chapter": 8,
              "verse": 15,
              "name": "Isaias 8:15",
              "text": "At marami ang mangatitisod doon, at mangabubuwal, at mangababalian, at mangasisilo, at mangahuhuli."
            },
            {
              "chapter": 8,
              "verse": 16,
              "name": "Isaias 8:16",
              "text": "Talian mo ang patotoo, tatakan mo ang kautusan sa gitna ng aking mga alagad."
            },
            {
              "chapter": 8,
              "verse": 17,
              "name": "Isaias 8:17",
              "text": "At aking hihintayin ang Panginoon na nagkukubli ng kaniyang mukha sa sangbahayan ni Jacob, at aking hahanapin siya."
            },
            {
              "chapter": 8,
              "verse": 18,
              "name": "Isaias 8:18",
              "text": "Narito, ako at ang mga anak na ibinigay ng Panginoon sa akin ay mga pinakatanda at pinaka kababalaghan sa Israel na mula sa Panginoon ng mga hukbo, na tumatahan sa bundok ng Sion."
            },
            {
              "chapter": 8,
              "verse": 19,
              "name": "Isaias 8:19",
              "text": "At pagka kanilang sasabihin sa inyo, Hanapin ninyo silang nakikipagsanggunian sa masamang espiritu at mga manghuhula, na nagsisihuni at nagsisibulong; hindi ba marapat na sanggunian ng bayan ang kanilang Dios? dahil baga sa mga buhay ay sasangguni sila sa mga patay?"
            },
            {
              "chapter": 8,
              "verse": 20,
              "name": "Isaias 8:20",
              "text": "Sa kautusan at sa patotoo! kung hindi sila magsalita ng ayon sa salitang ito, tunay na walang umaga sa kanila."
            },
            {
              "chapter": 8,
              "verse": 21,
              "name": "Isaias 8:21",
              "text": "At sila'y magsisidaan doon, na nahihirapan at gutom: at mangyayari, na pagka sila'y mangagugutom, sila'y mangagagalit, at magsisisumpa alangalang sa kanilang hari at sa kanilang Dios, at ititingala nila ang kanilang mga mukha:"
            },
            {
              "chapter": 8,
              "verse": 22,
              "name": "Isaias 8:22",
              "text": "At sila'y titingin sa lupa, at, narito, kahirapan at kadiliman, ulap ng kahapisan, at sa salimuot na kadiliman ay itataboy sila."
            }
          ]
        },
        {
          "chapter": 9,
          "name": "Isaias 9",
          "verses": [
            {
              "chapter": 9,
              "verse": 1,
              "name": "Isaias 9:1",
              "text": "Gayon man ay hindi magkakaroon ng paguulap sa kaniya na nasa kahapisan. Nang unang panahon ay dinala niya sa pagkawalang kabuluhan ang lupain ng Zabulon at ang lupain ng Nephtali, nguni't sa huling panahon ay ginawa niyang maluwalhati, sa daang patungo sa dagat, sa dako roon ng Jordan, ng Galilea ng mga bansa."
            },
            {
              "chapter": 9,
              "verse": 2,
              "name": "Isaias 9:2",
              "text": "Ang bayan na lumalakad sa kadiliman ay nakakita ng dakilang liwanag: silang nagsisitahan sa lupain ng lilim ng kamatayan, sa kanila sumilang ang liwanag."
            },
            {
              "chapter": 9,
              "verse": 3,
              "name": "Isaias 9:3",
              "text": "Iyong pinarami ang bansa, iyong pinalago ang kanilang kagalakan: sila'y nangagagalak sa harap mo ayon sa kagalakan sa pagaani, gaya ng mga tao na nangagagalak pagka nangagbabahagi ng samsam."
            },
            {
              "chapter": 9,
              "verse": 4,
              "name": "Isaias 9:4",
              "text": "Sapagka't ang pamatok na kaniyang pasan, at ang pingga sa kaniyang balikat, ang panghampas ng mamimighati sa kaniya, ay iyong sinira na gaya sa kaarawan ng Madian."
            },
            {
              "chapter": 9,
              "verse": 5,
              "name": "Isaias 9:5",
              "text": "Sapagka't ang lahat na sakbat ng nasasakbatang tao sa kaguluhan, at ang mga kasuutang puno ng dugo ay magiging para sa pagkasunog, para sa mitsa ng apoy."
            },
            {
              "chapter": 9,
              "verse": 6,
              "name": "Isaias 9:6",
              "text": "Sapagka't sa atin ay ipinanganak ang isang bata, sa atin ay ibinigay ang isang anak na lalake; at ang pamamahala ay maaatang sa kaniyang balikat: at ang kaniyang pangalan ay tatawaging Kamanghamangha, Tagapayo, Makapangyarihang Dios, Walang hanggang Ama, Pangulo ng Kapayapaan."
            },
            {
              "chapter": 9,
              "verse": 7,
              "name": "Isaias 9:7",
              "text": "Ang paglago ng kaniyang pamamahala at ng kapayapaan ay hindi magkakaroon ng wakas, sa luklukan ni David, at sa kaniyang kaharian, upang itatag, at upang alalayan ng kahatulan at ng katuwiran mula ngayon hanggang sa magpakailan man. Isasagawa ito ng sikap ng Panginoon ng mga hukbo."
            },
            {
              "chapter": 9,
              "verse": 8,
              "name": "Isaias 9:8",
              "text": "Nagpasabi ang Panginoon sa Jacob, at naliliwanagan ang Israel,"
            },
            {
              "chapter": 9,
              "verse": 9,
              "name": "Isaias 9:9",
              "text": "At malalaman ng buong bayan ng Ephraim, at ng nananahan sa Samaria, na nagsasabi sa kapalaluan at sa pagmamatigas ng ulo,"
            },
            {
              "chapter": 9,
              "verse": 10,
              "name": "Isaias 9:10",
              "text": "Ang mga laryo ay nangahulog, nguni't aming itatayo ng tinabas na bato: ang mga sikomoro ay nangaputol, nguni't aming papalitan ng mga cedro."
            },
            {
              "chapter": 9,
              "verse": 11,
              "name": "Isaias 9:11",
              "text": "Kaya't itataas ng Panginoon laban sa kaniya ang mga kaaway ng Rezin, at manghihikayat ng kaniyang mga kaalit;"
            },
            {
              "chapter": 9,
              "verse": 12,
              "name": "Isaias 9:12",
              "text": "Ang mga taga Siria sa unahan, at ang mga Filisteo sa likuran; at kanilang lalamunin ang Israel ng bukang bibig. Sa lahat na ito ang kaniyang galit ay hindi napawi, kundi ang kaniyang kamay ay laging nakaunat."
            },
            {
              "chapter": 9,
              "verse": 13,
              "name": "Isaias 9:13",
              "text": "Gayon ma'y ang bayan ay hindi nagbalik-loob sa kaniya na sumakit sa kanila, o hinanap man nila ang Panginoon ng mga hukbo."
            },
            {
              "chapter": 9,
              "verse": 14,
              "name": "Isaias 9:14",
              "text": "Kaya't puputulin ng Panginoon sa Israel ang ulo't buntot, ang sanga ng palma at ang tambo, sa isang araw."
            },
            {
              "chapter": 9,
              "verse": 15,
              "name": "Isaias 9:15",
              "text": "Ang matanda at ang marangal na tao, siyang ulo; at ang propeta na nagtuturo ng mga kabulaanan, siyang buntot."
            },
            {
              "chapter": 9,
              "verse": 16,
              "name": "Isaias 9:16",
              "text": "Sapagka't silang nagsisipatnubay ng bayang ito ay siyang nangagliligaw; at silang pinapatnubayan ay nangapapahamak."
            },
            {
              "chapter": 9,
              "verse": 17,
              "name": "Isaias 9:17",
              "text": "Kaya't ang Panginoon ay hindi magagalak sa kanilang mga binata, ni mahahabag man sa kanilang mga ulila at mga babaing bao: sapagka't bawa't isa ay marumi at manggagawa ng kasamaan, at bawa't bibig ay nagsasalita ng kamangmangan. Sa lahat na ito ang galit niya ay hindi napawi, kundi ang kaniyang kamay ay laging nakaunat."
            },
            {
              "chapter": 9,
              "verse": 18,
              "name": "Isaias 9:18",
              "text": "Sapagka't ang kasamaan ay sumusunog na gaya ng apoy; pumupugnaw ng mga dawag at mga tinikan: oo, nagaalab na sa siitan sa gubat, at umiilanglang na paitaas sa mga masinsing ulap na usok."
            },
            {
              "chapter": 9,
              "verse": 19,
              "name": "Isaias 9:19",
              "text": "Sa poot ng Panginoon ng mga hukbo ay nasusunog ang lupain: ang bayan naman ay gaya ng panggatong sa apoy; walang taong mahahabag sa kaniyang kapatid."
            },
            {
              "chapter": 9,
              "verse": 20,
              "name": "Isaias 9:20",
              "text": "At isa'y susunggab ng kanang kamay, at magugutom; at kakain ng kaliwa, at hindi sila mabubusog: sila'y magsisikain bawa't isa ng laman ng kaniyang sariling bisig:"
            },
            {
              "chapter": 9,
              "verse": 21,
              "name": "Isaias 9:21",
              "text": "Ang Manases, ay kakanin ang Ephraim; at ang Ephraim, ay ang Manases: at sila kapuwa ay magiging laban sa Juda. Sa lahat na ito ang galit niya ay hindi napawi, kundi ang kaniyang kamay ay laging nakaunat."
            }
          ]
        },
        {
          "chapter": 10,
          "name": "Isaias 10",
          "verses": [
            {
              "chapter": 10,
              "verse": 1,
              "name": "Isaias 10:1",
              "text": "Sa aba nila na nagpapasiya ng mga likong pasiya, at ng mga manunulat na sumusulat ng mga kasuwailan:"
            },
            {
              "chapter": 10,
              "verse": 2,
              "name": "Isaias 10:2",
              "text": "Upang iligaw sa kahatulan ang mapagkailangan, at upang alisin ang katuwiran ng dukha ng aking bayan, upang ang mga babaing bao ay maging kanilang samsam, at upang kanilang gawing kanilang huli ang mga ulila!"
            },
            {
              "chapter": 10,
              "verse": 3,
              "name": "Isaias 10:3",
              "text": "At ano ang inyong gagawin sa araw ng pagdalaw, at sa kagibaan na manggagaling sa malayo? sa kanino kayo magsisitakas upang kayo'y tulungan? at saan ninyo iiwan ang inyong kaluwalhatian?"
            },
            {
              "chapter": 10,
              "verse": 4,
              "name": "Isaias 10:4",
              "text": "Sila'y magsisiyukod na gaya ng mga bilanggo, at mangabubuwal sa bunton ng mga patay. Sa lahat ng ito ang galit niya ay hindi napawi, kundi ang kaniyang kamay ay laging nakaunat."
            },
            {
              "chapter": 10,
              "verse": 5,
              "name": "Isaias 10:5",
              "text": "Hoy, taga Asiria, na pamalo ng aking galit, siyang tungkod na kasangkapan ng aking pag-iinit."
            },
            {
              "chapter": 10,
              "verse": 6,
              "name": "Isaias 10:6",
              "text": "Aking susuguin siya laban sa maruming bansa, at laban sa bayan na aking kinapopootan ay pagbibilinan ko siya, upang manamsam, at upang manunggab, at yapakan sila na parang putik ng mga lansangan."
            },
            {
              "chapter": 10,
              "verse": 7,
              "name": "Isaias 10:7",
              "text": "Gayon ma'y hindi niya inaakalang gayon, o iniisip mang gayon ng kaniyang puso; kundi ang nasa kaniyang puso ay manggiba, at manglipol ng mga bansa na hindi kakaunti."
            },
            {
              "chapter": 10,
              "verse": 8,
              "name": "Isaias 10:8",
              "text": "Sapagka't kaniyang sinasabi, Hindi baga ang aking mga pangulo ay hari silang lahat?"
            },
            {
              "chapter": 10,
              "verse": 9,
              "name": "Isaias 10:9",
              "text": "Hindi baga ang calno ay gaya ng Carchemis? hindi ba ang Hamath ay gaya ng Arphad? hindi ba ang Samaria ay gaya ng Damasco?"
            },
            {
              "chapter": 10,
              "verse": 10,
              "name": "Isaias 10:10",
              "text": "Kung paanong nakasumpong ang aking kamay ng mga kaharian ng mga diosdiosan, na ang mga larawan nilang inanyuan ay mga higit ng dami kay sa Jerusalem at sa Samaria;"
            },
            {
              "chapter": 10,
              "verse": 11,
              "name": "Isaias 10:11",
              "text": "Hindi ko baga gagawing gayon sa Jerusalem at sa kaniyang mga diosdiosan, ang gaya ng ginawa ko sa Samaria at sa kaniyang mga diosdiosan?"
            },
            {
              "chapter": 10,
              "verse": 12,
              "name": "Isaias 10:12",
              "text": "Kaya't mangyayari, na pagka naisagawa ng Panginoon ang buo niyang gawain sa bundok ng Sion at sa Jerusalem, aking parurusahan ang kagagawan ng mapagmalaking loob na hari sa Asiria, at ang kaluwalhatian ng kaniyang mga mapagmataas na tingin."
            },
            {
              "chapter": 10,
              "verse": 13,
              "name": "Isaias 10:13",
              "text": "Sapagka't kaniyang sinabi, Aking ginawa ito sa kalakasan ng aking kamay at sa aking karunungan; sapagka't ako'y mabait: at aking binago ang mga hangganan ng mga tao, at ninakaw ko ang kanilang mga kayamanan, at parang matapang na lalake na ibinaba ko silang nangakaupo sa mga luklukan:"
            },
            {
              "chapter": 10,
              "verse": 14,
              "name": "Isaias 10:14",
              "text": "At nasumpungan ng aking kamay na parang pugad ang mga kayamanan ng mga tao; at ako'y namulot sa buong lupa na parang namumulot ng mga itlog na napabayaan: at walang magkilos ng pakpak, o magbuka ng bibig o sumiyap."
            },
            {
              "chapter": 10,
              "verse": 15,
              "name": "Isaias 10:15",
              "text": "Magmamapuri ba ang palakol laban sa nagpuputol niyaon? Nakapagmamalaki ba ang lagari laban sa humahawak niyaon? gaya ng kung ang pamalo ay makapagpapanginig sa kanila na nagtataas niyaon, o gaya ng kung ang tungkod ay magtataas sa tao na hindi kahoy."
            },
            {
              "chapter": 10,
              "verse": 16,
              "name": "Isaias 10:16",
              "text": "Kaya't pangangayayatin ng Panginoon, ng Panginoon ng mga hukbo, ang kaniyang mga mataba; at sa ilalim ng kaniyang kaluwalhatian ay magkakaroon ng pagniningas na gaya ng ningas na apoy."
            },
            {
              "chapter": 10,
              "verse": 17,
              "name": "Isaias 10:17",
              "text": "At ang liwanag ng Israel ay magiging pinakaapoy, at ang kaniyang Banal ay pinakaliyab: at magniningas at susupukin ang kaniyang mga tinikan at mga dawag sa isang araw."
            },
            {
              "chapter": 10,
              "verse": 18,
              "name": "Isaias 10:18",
              "text": "At kaniyang pupugnawin ang kaluwalhatian ng kaniyang gubat, at ng kaniyang pinakikinabangang bukid, ang kaluluwa at gayon din ang katawan: at magiging gaya ng kung nanglulupaypay ang may dala ng watawat."
            },
            {
              "chapter": 10,
              "verse": 19,
              "name": "Isaias 10:19",
              "text": "At ang nalabi sa mga punong kahoy ng kaniyang gubat ay mangangaunti, na anopat mabibilang ng bata."
            },
            {
              "chapter": 10,
              "verse": 20,
              "name": "Isaias 10:20",
              "text": "At mangyayari sa araw na yaon, na ang nalabi sa Israel, at ang nangakatanan sa sangbahayan ni Jacob, hindi na titiwala pa uli sa kaniya na sumakit sa kanila; kundi titiwala sa Panginoon, sa Banal ng Israel, sa katotohanan."
            },
            {
              "chapter": 10,
              "verse": 21,
              "name": "Isaias 10:21",
              "text": "Isang nalabi ay manunumbalik, sa makatuwid baga'y ang nalabi sa Jacob, sa makapangyarihang Dios."
            },
            {
              "chapter": 10,
              "verse": 22,
              "name": "Isaias 10:22",
              "text": "Sapagka't bagaman ang iyong bayang Israel ay magiging parang buhangin sa dagat, ang isang nalabi lamang sa kanila ang manunumbalik: ang pagkalipol ay naipasiya, na magtataglay ng katuwiran."
            },
            {
              "chapter": 10,
              "verse": 23,
              "name": "Isaias 10:23",
              "text": "Sapagka't ang kagibaan, at ang ipinasiya, gagawin ng Panginoon, ng Panginoon ng mga hukbo, sa gitna ng buong lupa."
            },
            {
              "chapter": 10,
              "verse": 24,
              "name": "Isaias 10:24",
              "text": "Kaya't ganito ang sabi ng Panginoon, ng Panginoon ng mga hukbo, Oh bayan kong tumatahan sa Sion, huwag kang matakot sa taga Asiria: bagaman ikaw ay sinaktan niya ng pamalo at nagtaas ng kaniyang tungkod laban sa iyo, ayon sa paraan ng Egipto."
            },
            {
              "chapter": 10,
              "verse": 25,
              "name": "Isaias 10:25",
              "text": "Sapagka't sangdali pa, at ang pagkagalit ay magaganap, at ang aking galit, sa kanilang ikamamatay."
            },
            {
              "chapter": 10,
              "verse": 26,
              "name": "Isaias 10:26",
              "text": "At ibabangon ng Panginoon ng mga hukbo, ang kasakunaan laban sa kaniya, na gaya ng pagpatay sa Madian sa bato ng Oreb: at ang kaniyang panghampas ay malalagay sa dagat, at kaniyang itataas ng ayon sa paraan ng Egipto."
            },
            {
              "chapter": 10,
              "verse": 27,
              "name": "Isaias 10:27",
              "text": "At mangyayari sa araw na yaon, na ang atang niya ay mahihiwalay sa iyong balikat, at ang kaniyang ipinasan sa iyong leeg, at ang ipinasan ay malalagpak dahil sa pinahiran."
            },
            {
              "chapter": 10,
              "verse": 28,
              "name": "Isaias 10:28",
              "text": "Siya'y dumating sa Ajad, siya'y nagdaan sa Migron; sa Michmas inilalapag niya ang kaniyang mga daladalahan:"
            },
            {
              "chapter": 10,
              "verse": 29,
              "name": "Isaias 10:29",
              "text": "Sila'y nangagdaraan sa landas; sila'y nagsituloy na nangagpahinga sa Geba: ang Rama ay nanginginig; ang Gabaa ni Saul ay tumakas."
            },
            {
              "chapter": 10,
              "verse": 30,
              "name": "Isaias 10:30",
              "text": "Humiyaw kang malakas ng iyong tinig, Oh anak na babae ng Galim! duminig ka, Oh Lais! Oh ikaw na kaawaawang Anathoth!"
            },
            {
              "chapter": 10,
              "verse": 31,
              "name": "Isaias 10:31",
              "text": "Madmena ay palaboy; ang mga nananahan sa Gebim ay nagtitipon upang magsitakas."
            },
            {
              "chapter": 10,
              "verse": 32,
              "name": "Isaias 10:32",
              "text": "Sa araw ding ito ay titigil siya sa Nob: kaniyang iniuunat ang kaniyang kamay sa bundok ng anak na babae ng Sion, na burol ng Jerusalem."
            },
            {
              "chapter": 10,
              "verse": 33,
              "name": "Isaias 10:33",
              "text": "Narito, puputulin ng Panginoon, ng Panginoon ng mga hukbo, na kakilakilabot ang mga sanga: at ang mga mataas sa anyo ay ibubuwal, at ang mapagmataas ay ibababa."
            },
            {
              "chapter": 10,
              "verse": 34,
              "name": "Isaias 10:34",
              "text": "At kaniyang puputulin ang mga siitan ng gubat sa pamamagitan ng bakal, at ang Libano ay mawawasak sa pamamagitan ng isang makapangyarihan."
            }
          ]
        },
        {
          "chapter": 11,
          "name": "Isaias 11",
          "verses": [
            {
              "chapter": 11,
              "verse": 1,
              "name": "Isaias 11:1",
              "text": "At may lalabas na usbong sa puno ni Isai, at isang sanga mula sa kaniyang mga ugat ay magbubunga:"
            },
            {
              "chapter": 11,
              "verse": 2,
              "name": "Isaias 11:2",
              "text": "At ang Espiritu ng Panginoon ay sasa kaniya, ang diwa ng karunungan at ng kaunawaan, ang diwa ng payo at ng katibayan, ang diwa ng kaalaman at ng takot sa Panginoon;"
            },
            {
              "chapter": 11,
              "verse": 3,
              "name": "Isaias 11:3",
              "text": "At ang kaniyang kaluguran ay magiging sa pagkatakot sa Panginoon: at hindi siya hahatol ng ayon sa paningin ng kaniyang mga mata, ni sasaway man ng ayon sa pakinig ng kaniyang mga tainga:"
            },
            {
              "chapter": 11,
              "verse": 4,
              "name": "Isaias 11:4",
              "text": "Kundi hahatol siya ng katuwiran sa dukha, at sasaway na may karampatan dahil sa mga maamo sa lupa: at sasaktan niya ang lupa ng pamalo ng kaniyang bibig, at ng hinga ng kaniyang mga labi ay kaniyang papatayin ang masama."
            },
            {
              "chapter": 11,
              "verse": 5,
              "name": "Isaias 11:5",
              "text": "At katuwiran ang magiging bigkis ng kaniyang baywang, at pagtatapat ang pamigkis ng kaniyang mga balakang."
            },
            {
              "chapter": 11,
              "verse": 6,
              "name": "Isaias 11:6",
              "text": "At ang lobo ay tatahang kasama ng kordero, at ang leopardo ay mahihigang kasiping ng batang kambing; at ang guya, at ang batang leon, at ang patabain na magkakasama; at papatnubayan sila ng munting bata."
            },
            {
              "chapter": 11,
              "verse": 7,
              "name": "Isaias 11:7",
              "text": "At ang baka at ang oso ay manginginain; ang kanilang mga anak ay mahihigang magkakasiping: at ang leon ay kakain ng dayami na gaya ng baka."
            },
            {
              "chapter": 11,
              "verse": 8,
              "name": "Isaias 11:8",
              "text": "At ang batang pasusuhin ay maglalaro sa lungga ng ahas, at isusuot ng batang kahihiwalay sa suso ang kaniyang kamay sa lungga ng ulupong."
            },
            {
              "chapter": 11,
              "verse": 9,
              "name": "Isaias 11:9",
              "text": "Hindi sila magsisipanakit o magsisipanira man sa aking buong banal na bundok: sapagka't ang lupa ay mapupuno ng kaalaman ng Panginoon, gaya ng tubig na tumatakip sa dagat."
            },
            {
              "chapter": 11,
              "verse": 10,
              "name": "Isaias 11:10",
              "text": "At mangyayari, sa araw na yaon na ang angkan ni Isai, na tumatayong pinakawatawat ng mga bayan, hahanapin ng mga bansa; at ang kaniyang pahingahang dako ay magiging maluwalhati."
            },
            {
              "chapter": 11,
              "verse": 11,
              "name": "Isaias 11:11",
              "text": "At mangyayari, sa araw na yaon, na ilalapag ng Panginoon uli ang kaniyang kamay na ikalawa upang mabawi ang nalabi sa kaniyang bayan na malalabi, mula sa Asiria, at mula sa Egipto, at mula sa Patros, at mula sa Cus, at mula sa Elam, at mula sa Sinar, at mula sa Amath, at mula sa mga pulo ng dagat."
            },
            {
              "chapter": 11,
              "verse": 12,
              "name": "Isaias 11:12",
              "text": "At siya'y maglalagay ng pinakawatawat sa mga bansa, at titipunin niya ang mga tapon ng Israel, at pipisanin ang mga nangalat ng Juda mula sa apat na sulok ng lupa."
            },
            {
              "chapter": 11,
              "verse": 13,
              "name": "Isaias 11:13",
              "text": "Ang inggit naman ng Ephraim ay maaalis, at ang mga lumiligalig ng Juda ay mahihiwalay: ang Ephraim ay hindi maiinggit sa Juda, at ang Juda ay hindi liligalig sa Ephraim."
            },
            {
              "chapter": 11,
              "verse": 14,
              "name": "Isaias 11:14",
              "text": "At sila'y lulusob sa mga Filisteo sa kalunuran; magkasamang sasamsam sila sa mga anak ng silanganan: kanilang iuunat ang kanilang kamay sa Edom at sa Moab; at susundin sila ng mga anak ni Ammon."
            },
            {
              "chapter": 11,
              "verse": 15,
              "name": "Isaias 11:15",
              "text": "At lubos na sisirain ng Panginoon ang look ng dagat ng Egipto; at iwawaswas ang kaniyang kamay sa Ilog ng kaniyang malakas na hangin, at papagpipituhing batis, at palalakarin ang mga tao na hindi basa ang mga paa."
            },
            {
              "chapter": 11,
              "verse": 16,
              "name": "Isaias 11:16",
              "text": "At magkakaroon ng isang lansangan sa nalabi sa kaniyang bayan, na malalabi, mula sa Asiria; gaya ng nagkaroon sa Israel ng araw na siya'y umahon mula sa lupain ng Egipto."
            }
          ]
        },
        {
          "chapter": 12,
          "name": "Isaias 12",
          "verses": [
            {
              "chapter": 12,
              "verse": 1,
              "name": "Isaias 12:1",
              "text": "At sa araw na yaon ay iyong sasabihin, Ako'y pasasalamat sa iyo, Oh Panginoon; sapagka't bagaman ikaw ay nagalit sa akin ang iyong galit ay napawi, at iyong inaaliw ako."
            },
            {
              "chapter": 12,
              "verse": 2,
              "name": "Isaias 12:2",
              "text": "Narito, Dios ay aking kaligtasan; ako'y titiwala, at hindi ako matatakot: sapagka't ang Panginoon si Jehova ay aking kalakasan at awit; at siya'y naging aking kaligtasan."
            },
            {
              "chapter": 12,
              "verse": 3,
              "name": "Isaias 12:3",
              "text": "Kaya't kayo'y iigib ng tubig na may kagalakan sa mga balon ng kaligtasan."
            },
            {
              "chapter": 12,
              "verse": 4,
              "name": "Isaias 12:4",
              "text": "At sa araw na yao'y inyong sasabihin, Mangagpasalamat kayo sa Panginoon, kayo'y magsitawag sa kaniyang pangalan, ipahayag ninyo ang kaniyang mga gawa sa mga bayan, sabihin ninyo na ang kaniyang pangalan ay marangal."
            },
            {
              "chapter": 12,
              "verse": 5,
              "name": "Isaias 12:5",
              "text": "Magsiawit kayo sa Panginoon; sapagka't siya'y gumawa ng mga marilag na bagay: ipaalam ito sa buong lupa."
