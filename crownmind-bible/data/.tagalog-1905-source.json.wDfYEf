    {
      "nr": 10,
      "name": "2 Samuel",
      "chapters": [
        {
          "chapter": 1,
          "name": "2 Samuel 1",
          "verses": [
            {
              "chapter": 1,
              "verse": 1,
              "name": "2 Samuel 1:1",
              "text": "At nangyari, pagkamatay ni Saul, nang magbalik si David na mula sa pagpatay sa mga Amalecita, at tumahan si David na dalawang araw sa Siclag;"
            },
            {
              "chapter": 1,
              "verse": 2,
              "name": "2 Samuel 1:2",
              "text": "Ay nangyari, sa ikatlong araw, na narito, ang isang lalake ay lumabas sa kampamento na mula kay Saul na hapak ang kaniyang suot, at may lupa ang kaniyang ulo: at nagkagayon, na nang dumating siya kay David, ay nagpatirapa at nagbigay galang."
            },
            {
              "chapter": 1,
              "verse": 3,
              "name": "2 Samuel 1:3",
              "text": "At sinabi ni David sa kaniya, Saan ka nanggaling? At kaniyang sinabi sa kaniya, Sa kampamento ng Israel ay tumakas ako."
            },
            {
              "chapter": 1,
              "verse": 4,
              "name": "2 Samuel 1:4",
              "text": "At sinabi ni David sa kaniya, Ano ang nangyari? isinasamo ko sa iyo na iyong saysayin sa akin. At siya'y sumagot: Ang bayan ay tumakas sa pakikipagbaka, at karamihan sa bayan naman ay nangabuwal at nangamatay; at si Saul at si Jonathan na kaniyang anak ay nangamatay rin."
            },
            {
              "chapter": 1,
              "verse": 5,
              "name": "2 Samuel 1:5",
              "text": "At sinabi ni David sa binata na nagsaysay sa kaniya: Paanong nalalaman mo na si Saul at si Jonathan na kaniyang anak ay patay?"
            },
            {
              "chapter": 1,
              "verse": 6,
              "name": "2 Samuel 1:6",
              "text": "At sinabi sa kaniya ng binatang nagsaysay, Sa isang pagkakataon ay napasa bundok ako ng Gilboa, narito, si Saul ay nagpakabuwal sa kaniyang sibat; at, narito, hinahabol siyang mainam ng mga karo at ng mga mangangabayo."
            },
            {
              "chapter": 1,
              "verse": 7,
              "name": "2 Samuel 1:7",
              "text": "At nang siya'y lumingon, kaniyang nakita ako, at tinawag niya ako, at ako'y sumagot: Narito ako."
            },
            {
              "chapter": 1,
              "verse": 8,
              "name": "2 Samuel 1:8",
              "text": "At sinabi niya sa akin, Sino ka? At ako'y sumagot sa kaniya, Ako'y isang Amalecita."
            },
            {
              "chapter": 1,
              "verse": 9,
              "name": "2 Samuel 1:9",
              "text": "At kaniyang sinabi uli sa akin, Tumayo ka sa siping ko, isinasamo ko sa iyo, at patayin mo ako, dahil sa dinatnan ako ng panglulumo; sapagka't ang aking buhay ay lubos ko pang taglay."
            },
            {
              "chapter": 1,
              "verse": 10,
              "name": "2 Samuel 1:10",
              "text": "Sa gayo'y tumayo ako sa siping niya, at aking pinatay siya, sapagka't talastas ko na siya'y hindi mabubuhay pagkatapos na siya'y nabuwal: at aking kinuha ang putong na nasa kaniyang ulo, at ang pulsera na nasa kaniyang kamay, at aking dinala rito sa aking panginoon."
            },
            {
              "chapter": 1,
              "verse": 11,
              "name": "2 Samuel 1:11",
              "text": "Nang magkagayo'y tinangnan ni David ang kaniyang mga suot at pinaghapak; at gayon din ang ginawa ng lahat na lalake na kasama niya:"
            },
            {
              "chapter": 1,
              "verse": 12,
              "name": "2 Samuel 1:12",
              "text": "At sila'y tumangis, at umiyak, at nagayuno hanggang sa paglubog ng araw, dahil kay Saul, at dahil kay Jonathan na kaniyang anak, at dahil sa bayan ng Panginoon, at dahil sa sangbahayan ng Israel; sapagka't sila'y nangabuwal sa pamamagitan ng tabak."
            },
            {
              "chapter": 1,
              "verse": 13,
              "name": "2 Samuel 1:13",
              "text": "At sinabi ni David sa binata na nagsaysay sa kaniya, Taga saan ka? At siya'y sumagot: Ako'y anak ng isang taga ibang lupa, na Amalecita."
            },
            {
              "chapter": 1,
              "verse": 14,
              "name": "2 Samuel 1:14",
              "text": "At sinabi ni David sa kaniya, Bakit hindi ka natakot na iunat mo ang iyong kamay na patayin ang pinahiran ng langis ng Panginoon?"
            },
            {
              "chapter": 1,
              "verse": 15,
              "name": "2 Samuel 1:15",
              "text": "At tinawag ni David ang isa sa mga bataan, at sinabi, Lumapit ka, at daluhungin mo siya. At kaniyang sinaktan siya, na anopa't namatay."
            },
            {
              "chapter": 1,
              "verse": 16,
              "name": "2 Samuel 1:16",
              "text": "At sinabi ni David sa kaniya, Ang iyong dugo ay sumaiyong ulo; sapagka't ang iyong bibig ang sumaksi laban sa iyo, na nagsasabi, Aking pinatay ang pinahiran ng langis ng Panginoon."
            },
            {
              "chapter": 1,
              "verse": 17,
              "name": "2 Samuel 1:17",
              "text": "At tinaghuyan ni David ng ganitong panaghoy si Saul at si Jonathan na kaniyang anak:"
            },
            {
              "chapter": 1,
              "verse": 18,
              "name": "2 Samuel 1:18",
              "text": "(At kaniyang ipinaturo sa mga anak ni Juda ang awit sa pamamana narito, nasusulat sa aklat ni Jaser):"
            },
            {
              "chapter": 1,
              "verse": 19,
              "name": "2 Samuel 1:19",
              "text": "Ang iyong kaluwalhatian, Oh Israel, ay napatay sa iyong matataas na dako! Ano't nangabuwal ang mga makapangyarihan!"
            },
            {
              "chapter": 1,
              "verse": 20,
              "name": "2 Samuel 1:20",
              "text": "Huwag ninyong saysayin sa Gath, Huwag ninyong ihayag sa mga lansangan ng Ascalon; Baka ang mga anak na babae ng mga Filisteo ay mangagalak, Baka ang mga anak na babae ng mga hindi tuli ay magtagumpay."
            },
            {
              "chapter": 1,
              "verse": 21,
              "name": "2 Samuel 1:21",
              "text": "Kayong mga bundok ng Gilboa, Huwag magkaroon ng hamog, o ulan man sa inyo, kahit mga bukid na mga handog: Sapagka't diyan ang kalasag ng makapangyarihan ay nahagis ng kahalayhalay. Ang kalasag ni Saul, na parang isa, na hindi pinahiran ng langis."
            },
            {
              "chapter": 1,
              "verse": 22,
              "name": "2 Samuel 1:22",
              "text": "Sa dugo ng pinatay, sa taba ng makapangyarihan, Ang busog ni Jonathan ay hindi umurong, At ang tabak ni Saul ay hindi nagbalik na walang dala."
            },
            {
              "chapter": 1,
              "verse": 23,
              "name": "2 Samuel 1:23",
