            },
            {
              "chapter": 46,
              "verse": 16,
              "name": "Genesis 46:16",
              "text": "At ang mga anak ni Gad; si Ziphion, at si Aggi, si Suni, at si Ezbon, si Heri, at si Arodi, at si Areli."
