            {
              "chapter": 34,
              "verse": 28,
              "name": "Genesis 34:28",
              "text": "Kinuha nila ang kanilang mga kawan at ang kanilang mga bakahan, at ang kanilang mga asno, at ang nasa bayan, at ang nasa parang;"
