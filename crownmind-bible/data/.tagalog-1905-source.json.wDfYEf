            {
              "chapter": 39,
              "verse": 8,
              "name": "Genesis 39:8",
              "text": "Datapuwa't siya'y tumanggi at sinabi niya sa asawa ng kaniyang panginoon, Narito, ang aking panginoon ay hindi nakikialam sa akin tungkol sa nasa bahay, at lahat ng kaniyang tinatangkilik ay ipinamahala sa aking kamay;"
