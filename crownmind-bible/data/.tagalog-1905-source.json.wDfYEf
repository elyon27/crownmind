          "verses": [
            {
              "chapter": 37,
              "verse": 1,
              "name": "Jeremias 37:1",
              "text": "At si Sedechias na anak ni Josias ay naghari na gaya ng hari, na humalili kay Conias na anak ni Joacim, na ginawang hari sa lupain ng Juda ni Nabucodonosor na hari sa Babilonia."
            },
            {
              "chapter": 37,
              "verse": 2,
              "name": "Jeremias 37:2",
              "text": "Nguni't maging siya, o ang kaniyang mga lingkod man, o ang bayan man ng lupain, hindi nakinig sa mga salita ng Panginoon na kaniyang sinalita sa pamamagitan ng propeta Jeremias."
            },
            {
              "chapter": 37,
              "verse": 3,
              "name": "Jeremias 37:3",
              "text": "At sinugo ni Sedechias na hari si Jucal na anak ni Selemias, at si Sephanias na anak ni Maasias na saserdote, sa propeta Jeremias, na sinabi, Idalangin mo kami ngayon sa Panginoon nating Dios."
            },
            {
              "chapter": 37,
              "verse": 4,
              "name": "Jeremias 37:4",
              "text": "Si Jeremias nga ay naglalabas pumasok sa gitna ng bayan: sapagka't hindi nila inilagay siya sa bilangguan."
            },
            {
              "chapter": 37,
              "verse": 5,
              "name": "Jeremias 37:5",
              "text": "At ang hukbo ni Faraon ay lumabas sa Egipto: at nang mabalitaan sila ng mga Caldeo na nagsisikubkob ng Jerusalem, ay nagsialis sa Jerusalem."
            },
            {
              "chapter": 37,
              "verse": 6,
              "name": "Jeremias 37:6",
              "text": "Nang magkagayo'y dumating ang salita ng Panginoon sa propeta Jeremias, na nagsasabi,"
            },
            {
              "chapter": 37,
              "verse": 7,
              "name": "Jeremias 37:7",
              "text": "Ganito ang sabi ng Panginoon, ng Dios ng Israel, Ganito ang inyong sasabihin sa hari sa Juda, na nagsugo sa inyo sa akin upang magsiyasat sa akin: Narito, ang hukbo ni Faraon, na lumabas upang tulungan kayo, ay babalik sa Egipto sa kanilang sariling lupain."
            },
            {
              "chapter": 37,
              "verse": 8,
              "name": "Jeremias 37:8",
              "text": "At ang mga Caldeo ay magsisiparito uli, at magsisilaban sa bayang ito; at kanilang sasakupin, at susunugin ng apoy."
            },
            {
              "chapter": 37,
              "verse": 9,
              "name": "Jeremias 37:9",
              "text": "Ganito ang sabi ng Panginoon, Huwag ninyong dayain ang inyong sarili, na magsabi, Tunay na magsisialis sa atin ang mga Caldeo: sapagka't hindi magsisialis."
            },
            {
              "chapter": 37,
              "verse": 10,
              "name": "Jeremias 37:10",
              "text": "Sapagka't bagaman inyong sasaktan ang buong hukbo ng mga Caldeo na lumalaban sa inyo, at ang naiwan lamang doon ay mga lalaking sugatan sa gitna nila, gayon ma'y babangon sila, ang bawa't isa sa kaniyang tolda, at susunugin ng apoy ang bayang ito."
            },
            {
              "chapter": 37,
              "verse": 11,
              "name": "Jeremias 37:11",
              "text": "At nangyari, na nang umurong sa Jerusalem ang hukbo ng mga Caldeo dahil sa takot sa hukbo ni Faraon,"
            },
            {
              "chapter": 37,
              "verse": 12,
              "name": "Jeremias 37:12",
              "text": "Lumabas nga si Jeremias sa Jerusalem upang pumasok sa lupain ng Benjamin, upang tumanggap ng kaniyang bahagi roon, sa gitna ng bayan."
            },
            {
              "chapter": 37,
              "verse": 13,
              "name": "Jeremias 37:13",
              "text": "At nang siya'y nasa pintuang-bayan ng Benjamin, isang kapitan ng bantay ay nandoon na ang pangalan ay Irias, na anak ni Selemias, na anak ni Hananias; at kaniyang dinakip si Jeremias, na propeta, na sinasabi, Ikaw ay kumakampi sa mga Caldeo."
            },
            {
              "chapter": 37,
              "verse": 14,
              "name": "Jeremias 37:14",
              "text": "Nang magkagayo'y sinabi ni Jeremias; Kasinungalingan, hindi ako kumakampi sa mga Caldeo. Nguni't hindi niya dininig siya: sa gayo'y dinakip ni Irias si Jeremias, at dinala sa mga prinsipe."
            },
            {
              "chapter": 37,
              "verse": 15,
              "name": "Jeremias 37:15",
              "text": "At ang mga prinsipe ay napoot kay Jeremias at sinaktan nila siya, at isinilid sa bilangguan sa bahay ni Jonathan na kalihim: sapagka't kanilang ginawang bilangguan yaon."
            },
            {
              "chapter": 37,
              "verse": 16,
              "name": "Jeremias 37:16",
              "text": "Nang si Jeremias ay makapasok sa bilangguang nasa ilalim ng lupa, at sa loob ng mga silid, at nang mabilanggo si Jeremias doon na maraming araw;"
            },
            {
              "chapter": 37,
              "verse": 17,
              "name": "Jeremias 37:17",
              "text": "Nagsugo nga si Sedechias na hari at ipinasundo siya: at tinanong siyang lihim ng hari sa kaniyang bahay, at nagsabi, May anoman bagang salitang mula sa Panginoon? At sinabi ni Jeremias: Mayroon. Sinabi rin niya, Ikaw ay mabibigay sa kamay ng hari sa Babilonia."
            },
            {
              "chapter": 37,
              "verse": 18,
              "name": "Jeremias 37:18",
              "text": "Bukod dito'y sinabi ni Jeremias sa haring Sedechias, Sa ano ako nagkasala laban sa iyo, o laban sa iyong mga lingkod, o laban sa bayang ito upang ilagay ninyo ako sa bilangguan?"
            },
            {
              "chapter": 37,
              "verse": 19,
              "name": "Jeremias 37:19",
              "text": "Saan nandoon ngayon ang inyong mga propeta na nanganghula sa inyo, na nangagsasabi, Ang hari sa Babilonia ay hindi paririto laban sa inyo, o laban man sa lupaing ito?"
            },
            {
              "chapter": 37,
              "verse": 20,
